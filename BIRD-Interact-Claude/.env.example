# BIRD-Interact-ADK Configuration
# Copy this to .env and fill in your values

# ── Authentication ──
# Run `claude`, then `/login`, and authenticate with the Claude subscription.
# Do NOT set ANTHROPIC_API_KEY: Claude Code prioritizes it and incurs API fees.

# ── Models ──
# Claude Code subscription model aliases
SYSTEM_AGENT_MODEL=sonnet
USER_SIM_MODEL=haiku

# ── Dataset ──
# Options: "lite" (300 tasks, 18 DBs) or "full" (600 tasks, 26 DBs)
DATASET=lite

# ── PostgreSQL ──
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=root
PG_PASSWORD=123123

# ── Service Ports ──
SYSTEM_AGENT_PORT=6000
USER_SIM_PORT=6001
DB_ENV_PORT=6002

# ── Budget / Turns ──
# a-interact: budget = 6 + 2*ambiguities + 2*patience (per task)
# c-interact: max_turns = ambiguities + patience (per task)
PATIENCE=3

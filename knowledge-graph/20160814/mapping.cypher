MERGE (n:Knowledge:SemanticSearch {id: "insider:69"}) SET n = {id: "insider:69", name: "Costly High-Frequency Risk Enforcement", type: "domain_knowledge", description: "Identifies enforcement cases with significant financial impact against traders previously identified as high-frequency, high-risk.", definition: "An enforcement case identified as Financially Impactful  targeting a trader previously flagged as a High-Frequency High-Risk Trader .", source_file: "insider_kb.jsonl", source_line: 70, source_id: 69, search_text: "Costly High-Frequency Risk Enforcement domain_knowledge Identifies enforcement cases with significant financial impact against traders previously identified as high-frequency, high-risk. An enforcement case identified as Financially Impactful  targeting a trader previously flagged as a High-Frequency High-Risk Trader ."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:70"}) SET n = {id: "insider:70", name: "High SDLR Transaction", type: "domain_knowledge", description: "Identifies transactions deemed high-risk based on their Sentiment-Driven Leakage Risk score exceeding a specific threshold.", definition: "A transaction where the calculated Sentiment-Driven Leakage Risk (SDLR) > 1000.", source_file: "insider_kb.jsonl", source_line: 71, source_id: 70, search_text: "High SDLR Transaction domain_knowledge Identifies transactions deemed high-risk based on their Sentiment-Driven Leakage Risk score exceeding a specific threshold. A transaction where the calculated Sentiment-Driven Leakage Risk (SDLR) > 1000."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:71"}) SET n = {id: "insider:71", name: "Compliance Rating Grade", type: "value_illustration", description: "Explains the overall compliance assessment grade assigned in compliance cases.", definition: "`comprate`: The compliance rating grade. 'A' represents excellent compliance. 'B' indicates good compliance with minor issues. 'C' suggests significant compliance deficiencies needing attention. 'D' signifies serious or repeated compliance failures requiring immediate action.", source_file: "insider_kb.jsonl", source_line: 72, source_id: 71, search_text: "Compliance Rating Grade value_illustration Explains the overall compliance assessment grade assigned in compliance cases. `comprate`: The compliance rating grade. 'A' represents excellent compliance. 'B' indicates good compliance with minor issues. 'C' suggests significant compliance deficiencies needing attention. 'D' signifies serious or repeated compliance failures requiring immediate action."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:72"}) SET n = {id: "insider:72", name: "Premature Resolution Block", type: "domain_knowledge", description: "A business rule preventing an enforcement action from being marked as 'Resolved' if associated risk metrics (like III) exceed a predefined threshold, ensuring high-risk cases receive sufficient review.", definition: "Block UPDATE of enforcementactions.resstat to 'Resolved' IF linked investigationdetails yield an Investigation Intensity Index > 75", source_file: "insider_kb.jsonl", source_line: 73, source_id: 72, search_text: "Premature Resolution Block domain_knowledge A business rule preventing an enforcement action from being marked as 'Resolved' if associated risk metrics (like III) exceed a predefined threshold, ensuring high-risk cases receive sufficient review. Block UPDATE of enforcementactions.resstat to 'Resolved' IF linked investigationdetails yield an Investigation Intensity Index > 75"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:73"}) SET n = {id: "insider:73", name: "Peer Correlation Z-Score", type: "calculation_knowledge", description: "A normalized score indicating how many standard deviations an individual record's peer correlation ('peercorr') is away from the average peer correlation of all traders within the same trader kind ('tradekind'). Used for standardized comparison across different peer groups.", definition: "Z = (peercorr - AVG(peercorr) OVER (PARTITION BY tradekind)) / STDDEV_SAMP(peercorr) OVER (PARTITION BY tradekind), with Z=0 if STDDEV_SAMP is 0 or NULL.", source_file: "insider_kb.jsonl", source_line: 74, source_id: 73, search_text: "Peer Correlation Z-Score calculation_knowledge A normalized score indicating how many standard deviations an individual record's peer correlation ('peercorr') is away from the average peer correlation of all traders within the same trader kind ('tradekind'). Used for standardized comparison across different peer groups. Z = (peercorr - AVG(peercorr) OVER (PARTITION BY tradekind)) / STDDEV_SAMP(peercorr) OVER (PARTITION BY tradekind), with Z=0 if STDDEV_SAMP is 0 or NULL."};
MATCH (d:Database {id: "mental"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "mental:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "mental:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "mental:" AND NOT stale.id IN ["mental:0", "mental:1", "mental:2", "mental:3", "mental:4", "mental:5", "mental:6", "mental:7", "mental:8", "mental:9", "mental:10", "mental:11", "mental:12", "mental:13", "mental:14", "mental:15", "mental:16", "mental:17", "mental:18", "mental:19", "mental:20", "mental:21", "mental:22", "mental:23", "mental:24", "mental:25", "mental:26", "mental:27", "mental:28", "mental:29", "mental:30", "mental:31", "mental:32", "mental:33", "mental:34", "mental:35", "mental:36", "mental:37", "mental:38", "mental:39", "mental:40", "mental:41", "mental:42", "mental:43", "mental:44", "mental:45", "mental:46", "mental:47", "mental:48", "mental:49", "mental:50", "mental:51", "mental:52", "mental:53", "mental:54", "mental:55", "mental:56", "mental:57", "mental:58", "mental:59", "mental:60", "mental:61", "mental:62"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "mental:0"}) SET n = {id: "mental:0", name: "Average PHQ-9 Score by Facility (APSF)", type: "calculation_knowledge", description: "Calculates the average PHQ-9 depression score for patients assessed at a specific facility.", definition: "APSF = \\frac{\\sum_{i \\in assessmentsymptomsandrisk} (mental\\_health\\_scores_i['depression']['phq9\\_score'])} {|assessmentsymptomsandrisk|}", source_file: "mental_kb.jsonl", source_line: 1, source_id: 0, search_text: "Average PHQ-9 Score by Facility (APSF) calculation_knowledge Calculates the average PHQ-9 depression score for patients assessed at a specific facility. APSF = \\frac{\\sum_{i \\in assessmentsymptomsandrisk} (mental\\_health\\_scores_i['depression']['phq9\\_score'])} {|assessmentsymptomsandrisk|}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:1"}) SET n = {id: "mental:1", name: "Average GAD-7 Score by Facility (AGSF)", type: "calculation_knowledge", description: "Calculates the average GAD-7 anxiety score for patients assessed at a specific facility.", definition: "AGSF = \\frac{\\sum_{i \\in assessmentsymptomsandrisk} (mental\\_health\\_scores_i['anxiety']['gad7\\_score'])} {|assessmentsymptomsandrisk|}, \\text{where } mental\\_health\\_scores_i['anxiety']['gad7\\_score'] \\text{ is the GAD-7 score for each assessment in the assessmentsymptomsandrisk table, linked to a facility via encounters.facid}", source_file: "mental_kb.jsonl", source_line: 2, source_id: 1, search_text: "Average GAD-7 Score by Facility (AGSF) calculation_knowledge Calculates the average GAD-7 anxiety score for patients assessed at a specific facility. AGSF = \\frac{\\sum_{i \\in assessmentsymptomsandrisk} (mental\\_health\\_scores_i['anxiety']['gad7\\_score'])} {|assessmentsymptomsandrisk|}, \\text{where } mental\\_health\\_scores_i['anxiety']['gad7\\_score'] \\text{ is the GAD-7 score for each assessment in the assessmentsymptomsandrisk table, linked to a facility via encounters.facid}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:2"}) SET n = {id: "mental:2", name: "Treatment Adherence Rate (TAR)", type: "calculation_knowledge", description: "Measures the proportion of patients with high or medium treatment adherence at a facility.", definition: "TAR = \\frac{|treatmentoutcomes \\text{ with } txadh \\in \\{High, Medium\\}|} {|treatmentoutcomes|}", source_file: "mental_kb.jsonl", source_line: 3, source_id: 2, search_text: "Treatment Adherence Rate (TAR) calculation_knowledge Measures the proportion of patients with high or medium treatment adherence at a facility. TAR = \\frac{|treatmentoutcomes \\text{ with } txadh \\in \\{High, Medium\\}|} {|treatmentoutcomes|}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:3"}) SET n = {id: "mental:3", name: "Suicide Risk Prevalence (SRP)", type: "calculation_knowledge", description: "Calculates the percentage of assessments indicating high or severe suicide risk at a facility.", definition: "SRP = \\frac{|assessmentsymptomsandrisk \\text{ with } suicrisk \\in \\{High, Severe\\}|} {|assessmentsymptomsandrisk|} \\times 100", source_file: "mental_kb.jsonl", source_line: 4, source_id: 3, search_text: "Suicide Risk Prevalence (SRP) calculation_knowledge Calculates the percentage of assessments indicating high or severe suicide risk at a facility. SRP = \\frac{|assessmentsymptomsandrisk \\text{ with } suicrisk \\in \\{High, Severe\\}|} {|assessmentsymptomsandrisk|} \\times 100"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:4"}) SET n = {id: "mental:4", name: "Therapy Engagement Score (TES)", type: "calculation_knowledge", description: "Computes an average engagement score across therapy sessions.", definition: "TES = \\frac{\\sum_{i \\in treatmentbasics} (therapy\\_details_i['engagement\\_score'])} {|treatmentbasics|}, \\text{where } engagement\\_score = \\begin{cases} 3 & \\text{if } therapy\\_details['engagement'] = High \\\\ 2 & \\text{if } therapy\\_details['engagement'] = Medium \\\\ 1 & \\text{if } therapy\\_details['engagement'] = Low \\\\ 0 & \\text{if } therapy\\_details['engagement'] = Non-compliant \\end{cases}, \\text{and } therapy\\_details \\text{ is the JSONB column in the treatmentbasics table}", source_file: "mental_kb.jsonl", source_line: 5, source_id: 4, search_text: "Therapy Engagement Score (TES) calculation_knowledge Computes an average engagement score across therapy sessions. TES = \\frac{\\sum_{i \\in treatmentbasics} (therapy\\_details_i['engagement\\_score'])} {|treatmentbasics|}, \\text{where } engagement\\_score = \\begin{cases} 3 & \\text{if } therapy\\_details['engagement'] = High \\\\ 2 & \\text{if } therapy\\_details['engagement'] = Medium \\\\ 1 & \\text{if } therapy\\_details['engagement'] = Low \\\\ 0 & \\text{if } therapy\\_details['engagement'] = Non-compliant \\end{cases}, \\text{and } therapy\\_details \\text{ is the JSONB column in the treatmentbasics table}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:5"}) SET n = {id: "mental:5", name: "Facility Resource Adequacy Index (FRAI)", type: "calculation_knowledge", description: "Quantifies the adequacy of community resources available at a facility.", definition: "FRAI = \\frac{\\sum_{i \\in facilities} resource\\_score_i} {|facilities|}, \\text{where } resource\\_score = \\begin{cases} 3 & \\text{if } support\\_and\\_resources['community\\_resources'] = Comprehensive \\\\ 2 & \\text{if } support\\_and\\_resources['community\\_resources'] = Adequate \\\\ 1 & \\text{if } support\\_and\\_resources['community\\_resources'] = Limited \\end{cases}, \\text{and } support\\_and\\_resources \\text{ is the JSONB column in the facilities table}", source_file: "mental_kb.jsonl", source_line: 6, source_id: 5, search_text: "Facility Resource Adequacy Index (FRAI) calculation_knowledge Quantifies the adequacy of community resources available at a facility. FRAI = \\frac{\\sum_{i \\in facilities} resource\\_score_i} {|facilities|}, \\text{where } resource\\_score = \\begin{cases} 3 & \\text{if } support\\_and\\_resources['community\\_resources'] = Comprehensive \\\\ 2 & \\text{if } support\\_and\\_resources['community\\_resources'] = Adequate \\\\ 1 & \\text{if } support\\_and\\_resources['community\\_resources'] = Limited \\end{cases}, \\text{and } support\\_and\\_resources \\text{ is the JSONB column in the facilities table}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:6"}) SET n = {id: "mental:6", name: "Patient Functional Impairment Score (PFIS)", type: "calculation_knowledge", description: "Calculates an average functional impairment score across patients.", definition: "PFIS = \\frac{\\sum_{i \\in assessmentsocialanddiagnosis} funcimp\\_score_i} {|assessmentsocialanddiagnosis|}, \\text{where } funcimp\\_score = \\begin{cases} 3 & \\text{if } funcimp = Severe \\\\ 2 & \\text{if } funcimp = Moderate \\\\ 1 & \\text{if } funcimp = Mild \\end{cases}", source_file: "mental_kb.jsonl", source_line: 7, source_id: 6, search_text: "Patient Functional Impairment Score (PFIS) calculation_knowledge Calculates an average functional impairment score across patients. PFIS = \\frac{\\sum_{i \\in assessmentsocialanddiagnosis} funcimp\\_score_i} {|assessmentsocialanddiagnosis|}, \\text{where } funcimp\\_score = \\begin{cases} 3 & \\text{if } funcimp = Severe \\\\ 2 & \\text{if } funcimp = Moderate \\\\ 1 & \\text{if } funcimp = Mild \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:7"}) SET n = {id: "mental:7", name: "Crisis Intervention Frequency (CIF)", type: "calculation_knowledge", description: "Measures the average number of crisis interventions per patient at a facility.", definition: "CIF = \\frac{\\sum_{i \\in treatmentbasics} crisisint_i} {|patients|}", source_file: "mental_kb.jsonl", source_line: 8, source_id: 7, search_text: "Crisis Intervention Frequency (CIF) calculation_knowledge Measures the average number of crisis interventions per patient at a facility. CIF = \\frac{\\sum_{i \\in treatmentbasics} crisisint_i} {|patients|}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:8"}) SET n = {id: "mental:8", name: "Social Support Effectiveness (SSE)", type: "calculation_knowledge", description: "Evaluates the effectiveness of social support based on social support level and relationship quality.", definition: "SSE = \\frac{\\sum_{i \\in assessmentsocialanddiagnosis} (socsup\\_score_i + relqual\\_score_i)} {|assessmentsocialanddiagnosis|}, \\text{where } socsup\\_score = \\begin{cases} 3 & \\text{if } socsup = Strong \\\\ 2 & \\text{if } socsup = Moderate \\\\ 1 & \\text{if } socsup = Limited \\end{cases}, \\text{and } relqual\\_score = \\begin{cases} 3 & \\text{if } relqual = Good \\\\ 2 & \\text{if } relqual = Fair \\\\ 1 & \\text{if } relqual = Poor \\\\ 0 & \\text{if } relqual = Conflicted \\end{cases}", source_file: "mental_kb.jsonl", source_line: 9, source_id: 8, search_text: "Social Support Effectiveness (SSE) calculation_knowledge Evaluates the effectiveness of social support based on social support level and relationship quality. SSE = \\frac{\\sum_{i \\in assessmentsocialanddiagnosis} (socsup\\_score_i + relqual\\_score_i)} {|assessmentsocialanddiagnosis|}, \\text{where } socsup\\_score = \\begin{cases} 3 & \\text{if } socsup = Strong \\\\ 2 & \\text{if } socsup = Moderate \\\\ 1 & \\text{if } socsup = Limited \\end{cases}, \\text{and } relqual\\_score = \\begin{cases} 3 & \\text{if } relqual = Good \\\\ 2 & \\text{if } relqual = Fair \\\\ 1 & \\text{if } relqual = Poor \\\\ 0 & \\text{if } relqual = Conflicted \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:9"}) SET n = {id: "mental:9", name: "Missed Appointment Rate (MAR)", type: "calculation_knowledge", description: "Calculates the average number of missed appointments per patient at a facility.", definition: "MAR = \\frac{\\sum_{i \\in encounters} missappt_i} {|patients|}", source_file: "mental_kb.jsonl", source_line: 10, source_id: 9, search_text: "Missed Appointment Rate (MAR) calculation_knowledge Calculates the average number of missed appointments per patient at a facility. MAR = \\frac{\\sum_{i \\in encounters} missappt_i} {|patients|}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:10"}) SET n = {id: "mental:10", name: "High-Risk Patient", type: "domain_knowledge", description: "Identifies patients with elevated suicide risk or severe symptoms.", definition: "A patient with suicrisk \\in \\{High, Severe\\} or mental\\_health\\_scores['depression']['phq9\\_score'] > 15 or mental\\_health\\_scores['anxiety']['gad7\\_score'] > 15,", source_file: "mental_kb.jsonl", source_line: 11, source_id: 10, search_text: "High-Risk Patient domain_knowledge Identifies patients with elevated suicide risk or severe symptoms. A patient with suicrisk \\in \\{High, Severe\\} or mental\\_health\\_scores['depression']['phq9\\_score'] > 15 or mental\\_health\\_scores['anxiety']['gad7\\_score'] > 15,"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:11"}) SET n = {id: "mental:11", name: "Treatment-Resistant Patient", type: "domain_knowledge", description: "Identifies patients with poor treatment response despite adherence.", definition: "A patient with txresp = Poor and txadh \\in \\{Medium, High\\}", source_file: "mental_kb.jsonl", source_line: 12, source_id: 11, search_text: "Treatment-Resistant Patient domain_knowledge Identifies patients with poor treatment response despite adherence. A patient with txresp = Poor and txadh \\in \\{Medium, High\\}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:12"}) SET n = {id: "mental:12", name: "Complex Care Needs", type: "domain_knowledge", description: "Identifies patients requiring intensive care coordination due to multiple risk factors.", definition: "A patient with SRP > 20\\% and PFIS > 2.5 and subuse \\in \\{Opioids, Multiple\\}", source_file: "mental_kb.jsonl", source_line: 13, source_id: 12, search_text: "Complex Care Needs domain_knowledge Identifies patients requiring intensive care coordination due to multiple risk factors. A patient with SRP > 20\\% and PFIS > 2.5 and subuse \\in \\{Opioids, Multiple\\}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:13"}) SET n = {id: "mental:13", name: "Stable Recovery Patient", type: "domain_knowledge", description: "Identifies patients showing stable recovery with good functional outcomes.", definition: "A patient with recstatus = Stable and funcimpv \\in \\{Moderate, Significant\\}", source_file: "mental_kb.jsonl", source_line: 14, source_id: 13, search_text: "Stable Recovery Patient domain_knowledge Identifies patients showing stable recovery with good functional outcomes. A patient with recstatus = Stable and funcimpv \\in \\{Moderate, Significant\\}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:14"}) SET n = {id: "mental:14", name: "Low Engagement Risk", type: "domain_knowledge", description: "Identifies patients at risk of disengagement from therapy.", definition: "A patient with TES < 1.5 and txeng \\in \\{Low, Non-compliant\\}", source_file: "mental_kb.jsonl", source_line: 15, source_id: 14, search_text: "Low Engagement Risk domain_knowledge Identifies patients at risk of disengagement from therapy. A patient with TES < 1.5 and txeng \\in \\{Low, Non-compliant\\}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:15"}) SET n = {id: "mental:15", name: "Resource-Supported Facility", type: "domain_knowledge", description: "Identifies facilities with adequate or comprehensive community resources.", definition: "A facility with resource_score \\geq 2 \\text{where } resource_score = \\begin{cases} 3 & \\text{if } support\\_and\\_resources['community\\_resources'] = Comprehensive \\\\ 2 & \\text{if } support\\_and\\_resources['community\\_resources'] = Adequate \\\\ 1 & \\text{if } support\\_and\\_resources['community\\_resources'] = Limited \\end{cases}.", source_file: "mental_kb.jsonl", source_line: 16, source_id: 15, search_text: "Resource-Supported Facility domain_knowledge Identifies facilities with adequate or comprehensive community resources. A facility with resource_score \\geq 2 \\text{where } resource_score = \\begin{cases} 3 & \\text{if } support\\_and\\_resources['community\\_resources'] = Comprehensive \\\\ 2 & \\text{if } support\\_and\\_resources['community\\_resources'] = Adequate \\\\ 1 & \\text{if } support\\_and\\_resources['community\\_resources'] = Limited \\end{cases}."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:16"}) SET n = {id: "mental:16", name: "High Social Support Patient", type: "domain_knowledge", description: "Identifies patients with strong social support and good relationship quality.", definition: "A patient with SSE \\geq 5", source_file: "mental_kb.jsonl", source_line: 17, source_id: 16, search_text: "High Social Support Patient domain_knowledge Identifies patients with strong social support and good relationship quality. A patient with SSE \\geq 5"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:17"}) SET n = {id: "mental:17", name: "Frequent Crisis Patient", type: "domain_knowledge", description: "Identifies patients with frequent crisis interventions.", definition: "A patient with CIF > 2", source_file: "mental_kb.jsonl", source_line: 18, source_id: 17, search_text: "Frequent Crisis Patient domain_knowledge Identifies patients with frequent crisis interventions. A patient with CIF > 2"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:18"}) SET n = {id: "mental:18", name: "Non-Compliant Patient", type: "domain_knowledge", description: "Identifies patients with consistent non-compliance in treatment.", definition: "A patient with txadh = Non-compliant and medadh = Non-compliant", source_file: "mental_kb.jsonl", source_line: 19, source_id: 18, search_text: "Non-Compliant Patient domain_knowledge Identifies patients with consistent non-compliance in treatment. A patient with txadh = Non-compliant and medadh = Non-compliant"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:19"}) SET n = {id: "mental:19", name: "High Appointment Adherence", type: "domain_knowledge", description: "Identifies patients with low missed appointment rates.", definition: "A patient with MAR < 1", source_file: "mental_kb.jsonl", source_line: 20, source_id: 19, search_text: "High Appointment Adherence domain_knowledge Identifies patients with low missed appointment rates. A patient with MAR < 1"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:20"}) SET n = {id: "mental:20", name: "PHQ-9 Score (Depression)", type: "value_illustration", description: "Illustrates the value of the PHQ-9 score for depression severity.", definition: "Ranges from 0 to 27. A score of 0–4 indicates minimal depression, 5–9 mild, 10–14 moderate, 15–19 moderately severe, and 20–27 severe.", source_file: "mental_kb.jsonl", source_line: 21, source_id: 20, search_text: "PHQ-9 Score (Depression) value_illustration Illustrates the value of the PHQ-9 score for depression severity. Ranges from 0 to 27. A score of 0–4 indicates minimal depression, 5–9 mild, 10–14 moderate, 15–19 moderately severe, and 20–27 severe."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:21"}) SET n = {id: "mental:21", name: "GAD-7 Score (Anxiety)", type: "value_illustration", description: "Illustrates the value of the GAD-7 score for anxiety severity.", definition: "Ranges from 0 to 21. A score of 0–4 indicates minimal anxiety, 5–9 mild, 10–14 moderate, and 15–21 severe.", source_file: "mental_kb.jsonl", source_line: 22, source_id: 21, search_text: "GAD-7 Score (Anxiety) value_illustration Illustrates the value of the GAD-7 score for anxiety severity. Ranges from 0 to 21. A score of 0–4 indicates minimal anxiety, 5–9 mild, 10–14 moderate, and 15–21 severe."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:22"}) SET n = {id: "mental:22", name: "Suicide Risk Level", type: "value_illustration", description: "Illustrates the value of the suicide risk level.", definition: "Ranges from Low to Severe. Low indicates minimal risk, Medium indicates some concern, High indicates immediate concern, and Severe indicates urgent intervention needed.", source_file: "mental_kb.jsonl", source_line: 23, source_id: 22, search_text: "Suicide Risk Level value_illustration Illustrates the value of the suicide risk level. Ranges from Low to Severe. Low indicates minimal risk, Medium indicates some concern, High indicates immediate concern, and Severe indicates urgent intervention needed."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:23"}) SET n = {id: "mental:23", name: "Therapy Engagement", type: "value_illustration", description: "Illustrates the value of therapy engagement levels.", definition: "Ranges from Non-compliant to High. Non-compliant indicates no participation, Low indicates minimal participation, Medium indicates regular participation, and High indicates active engagement.", source_file: "mental_kb.jsonl", source_line: 24, source_id: 23, search_text: "Therapy Engagement value_illustration Illustrates the value of therapy engagement levels. Ranges from Non-compliant to High. Non-compliant indicates no participation, Low indicates minimal participation, Medium indicates regular participation, and High indicates active engagement."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:24"}) SET n = {id: "mental:24", name: "Community Resources", type: "value_illustration", description: "Illustrates the value of community resource availability.", definition: "Ranges from Limited to Comprehensive. Limited indicates few or no resources, Adequate indicates sufficient resources, and Comprehensive indicates extensive resources.", source_file: "mental_kb.jsonl", source_line: 25, source_id: 24, search_text: "Community Resources value_illustration Illustrates the value of community resource availability. Ranges from Limited to Comprehensive. Limited indicates few or no resources, Adequate indicates sufficient resources, and Comprehensive indicates extensive resources."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:25"}) SET n = {id: "mental:25", name: "Functional Impairment", type: "value_illustration", description: "Illustrates the value of functional impairment levels.", definition: "Ranges from Mild to Severe. Mild indicates minimal impact on daily life, Moderate indicates noticeable impact, and Severe indicates significant disruption.", source_file: "mental_kb.jsonl", source_line: 26, source_id: 25, search_text: "Functional Impairment value_illustration Illustrates the value of functional impairment levels. Ranges from Mild to Severe. Mild indicates minimal impact on daily life, Moderate indicates noticeable impact, and Severe indicates significant disruption."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:26"}) SET n = {id: "mental:26", name: "Treatment Adherence", type: "value_illustration", description: "Illustrates the value of treatment adherence levels.", definition: "Ranges from Non-compliant to High. Non-compliant indicates no adherence, Low indicates occasional adherence, Medium indicates regular adherence, and High indicates consistent adherence.", source_file: "mental_kb.jsonl", source_line: 27, source_id: 26, search_text: "Treatment Adherence value_illustration Illustrates the value of treatment adherence levels. Ranges from Non-compliant to High. Non-compliant indicates no adherence, Low indicates occasional adherence, Medium indicates regular adherence, and High indicates consistent adherence."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:27"}) SET n = {id: "mental:27", name: "Crisis Intervention Count", type: "value_illustration", description: "Illustrates the value of the crisis intervention count.", definition: "A numeric value indicating the number of crisis interventions. A value of 0 indicates no interventions, while higher values (e.g., 3) indicate frequent interventions.", source_file: "mental_kb.jsonl", source_line: 28, source_id: 27, search_text: "Crisis Intervention Count value_illustration Illustrates the value of the crisis intervention count. A numeric value indicating the number of crisis interventions. A value of 0 indicates no interventions, while higher values (e.g., 3) indicate frequent interventions."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:28"}) SET n = {id: "mental:28", name: "Social Support Level", type: "value_illustration", description: "Illustrates the value of social support levels.", definition: "Ranges from Limited to Strong. Limited indicates minimal support, Moderate indicates some support, and Strong indicates robust support.", source_file: "mental_kb.jsonl", source_line: 29, source_id: 28, search_text: "Social Support Level value_illustration Illustrates the value of social support levels. Ranges from Limited to Strong. Limited indicates minimal support, Moderate indicates some support, and Strong indicates robust support."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:29"}) SET n = {id: "mental:29", name: "Missed Appointment Count", type: "value_illustration", description: "Illustrates the value of the missed appointment count.", definition: "A numeric value indicating the number of missed appointments. A value of 0 indicates perfect attendance, while higher values (e.g., 5) indicate frequent absences.", source_file: "mental_kb.jsonl", source_line: 30, source_id: 29, search_text: "Missed Appointment Count value_illustration Illustrates the value of the missed appointment count. A numeric value indicating the number of missed appointments. A value of 0 indicates perfect attendance, while higher values (e.g., 5) indicate frequent absences."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:30"}) SET n = {id: "mental:30", name: "Symptom Severity Index (SSI)", type: "calculation_knowledge", description: "Calculates a combined average symptom severity score for a facility, based on depression and anxiety.", definition: "SSI = \\frac{APSF + AGSF}{2}, \\text{using Average PHQ-9 Score (APSF) and Average GAD-7 Score (AGSF)}", source_file: "mental_kb.jsonl", source_line: 31, source_id: 30, search_text: "Symptom Severity Index (SSI) calculation_knowledge Calculates a combined average symptom severity score for a facility, based on depression and anxiety. SSI = \\frac{APSF + AGSF}{2}, \\text{using Average PHQ-9 Score (APSF) and Average GAD-7 Score (AGSF)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:31"}) SET n = {id: "mental:31", name: "Engagement-Adherence Score (EAS)", type: "calculation_knowledge", description: "Computes a composite score reflecting patient participation and adherence to treatment plans at a facility.", definition: "EAS = \\frac{TES + (TAR \\times 3)}{2}, \\text{normalizing Treatment Adherence Rate (TAR) to the Therapy Engagement Score (TES) scale (0-3)}", source_file: "mental_kb.jsonl", source_line: 32, source_id: 31, search_text: "Engagement-Adherence Score (EAS) calculation_knowledge Computes a composite score reflecting patient participation and adherence to treatment plans at a facility. EAS = \\frac{TES + (TAR \\times 3)}{2}, \\text{normalizing Treatment Adherence Rate (TAR) to the Therapy Engagement Score (TES) scale (0-3)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:32"}) SET n = {id: "mental:32", name: "Facility Risk Profile Index (FRPI)", type: "calculation_knowledge", description: "Generates an index indicating the overall risk level associated with the patient population at a facility.", definition: "FRPI = (\\frac{SRP}{100} \\times 5) + PFIS, \\text{weighting Suicide Risk Prevalence (SRP) and combining with Patient Functional Impairment Score (PFIS)}", source_file: "mental_kb.jsonl", source_line: 33, source_id: 32, search_text: "Facility Risk Profile Index (FRPI) calculation_knowledge Generates an index indicating the overall risk level associated with the patient population at a facility. FRPI = (\\frac{SRP}{100} \\times 5) + PFIS, \\text{weighting Suicide Risk Prevalence (SRP) and combining with Patient Functional Impairment Score (PFIS)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:33"}) SET n = {id: "mental:33", name: "Patient Stability Metric (PSM)", type: "calculation_knowledge", description: "Calculates an index reflecting patient stability, inversely related to crisis frequency and missed appointments.", definition: "PSM = \\frac{1}{1 + CIF + MAR}, \\text{where higher values indicate greater stability based on Crisis Intervention Frequency (CIF) and Missed Appointment Rate (MAR)}", source_file: "mental_kb.jsonl", source_line: 34, source_id: 33, search_text: "Patient Stability Metric (PSM) calculation_knowledge Calculates an index reflecting patient stability, inversely related to crisis frequency and missed appointments. PSM = \\frac{1}{1 + CIF + MAR}, \\text{where higher values indicate greater stability based on Crisis Intervention Frequency (CIF) and Missed Appointment Rate (MAR)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:34"}) SET n = {id: "mental:34", name: "Resource-Demand Differential (RDD)", type: "calculation_knowledge", description: "Measures the potential gap between average patient functional needs and available facility resources.", definition: "RDD = PFIS - FRAI, \\text{comparing Patient Functional Impairment Score (PFIS) to Facility Resource Adequacy Index (FRAI)}", source_file: "mental_kb.jsonl", source_line: 35, source_id: 34, search_text: "Resource-Demand Differential (RDD) calculation_knowledge Measures the potential gap between average patient functional needs and available facility resources. RDD = PFIS - FRAI, \\text{comparing Patient Functional Impairment Score (PFIS) to Facility Resource Adequacy Index (FRAI)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:35"}) SET n = {id: "mental:35", name: "Socio-Environmental Support Index (SESI)", type: "calculation_knowledge", description: "Computes a composite index reflecting the quality of the patient's social environment and the facility's resource context.", definition: "SESI = \\frac{SSE_{avg} + FRAI}{2}, \\text{combining average Social Support Effectiveness (SSE) across patients with Facility Resource Adequacy Index (FRAI)}", source_file: "mental_kb.jsonl", source_line: 36, source_id: 35, search_text: "Socio-Environmental Support Index (SESI) calculation_knowledge Computes a composite index reflecting the quality of the patient's social environment and the facility's resource context. SESI = \\frac{SSE_{avg} + FRAI}{2}, \\text{combining average Social Support Effectiveness (SSE) across patients with Facility Resource Adequacy Index (FRAI)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:36"}) SET n = {id: "mental:36", name: "Adherence Effectiveness Ratio (AER)", type: "calculation_knowledge", description: "Calculates a ratio comparing treatment adherence rate to the average functional impairment, suggesting potential treatment impact relative to need.", definition: "AER = \\frac{TAR}{PFIS}, \\text{using Treatment Adherence Rate (TAR) and Patient Functional Impairment Score (PFIS) (handle PFIS=0)}", source_file: "mental_kb.jsonl", source_line: 37, source_id: 36, search_text: "Adherence Effectiveness Ratio (AER) calculation_knowledge Calculates a ratio comparing treatment adherence rate to the average functional impairment, suggesting potential treatment impact relative to need. AER = \\frac{TAR}{PFIS}, \\text{using Treatment Adherence Rate (TAR) and Patient Functional Impairment Score (PFIS) (handle PFIS=0)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:37"}) SET n = {id: "mental:37", name: "Engagement Deficit Index (EDI)", type: "calculation_knowledge", description: "Quantifies the degree of patient disengagement, considering both therapy engagement scores and appointment attendance.", definition: "EDI = (3 - TES) \\times (1 + MAR), \\text{calculating the gap from maximum Therapy Engagement Score (TES) weighted by Missed Appointment Rate (MAR)}", source_file: "mental_kb.jsonl", source_line: 38, source_id: 37, search_text: "Engagement Deficit Index (EDI) calculation_knowledge Quantifies the degree of patient disengagement, considering both therapy engagement scores and appointment attendance. EDI = (3 - TES) \\times (1 + MAR), \\text{calculating the gap from maximum Therapy Engagement Score (TES) weighted by Missed Appointment Rate (MAR)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:38"}) SET n = {id: "mental:38", name: "Comprehensive Facility Risk Score (CFRS)", type: "calculation_knowledge", description: "A normalized index assessing overall facility risk based on combined depression severity, suicide risk prevalence, and functional impairment.", definition: "CFRS = \\frac{APSF}{27} + \\frac{SRP}{100} + \\frac{PFIS}{3}, \\text{normalizing Average PHQ-9 Score (APSF), Suicide Risk Prevalence (SRP), and Patient Functional Impairment Score (PFIS) to a 0-1 scale and summing}", source_file: "mental_kb.jsonl", source_line: 39, source_id: 38, search_text: "Comprehensive Facility Risk Score (CFRS) calculation_knowledge A normalized index assessing overall facility risk based on combined depression severity, suicide risk prevalence, and functional impairment. CFRS = \\frac{APSF}{27} + \\frac{SRP}{100} + \\frac{PFIS}{3}, \\text{normalizing Average PHQ-9 Score (APSF), Suicide Risk Prevalence (SRP), and Patient Functional Impairment Score (PFIS) to a 0-1 scale and summing}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:39"}) SET n = {id: "mental:39", name: "Support System Pressure Index (SSPI)", type: "calculation_knowledge", description: "Index assessing the pressure on support systems based on crisis frequency relative to social support effectiveness.", definition: "SSPI = \\frac{CIF}{SSE_{avg} + 1}, \\text{calculating Crisis Intervention Frequency (CIF) relative to average Social Support Effectiveness (SSE) (adding 1 to avoid division by zero)}", source_file: "mental_kb.jsonl", source_line: 40, source_id: 39, search_text: "Support System Pressure Index (SSPI) calculation_knowledge Index assessing the pressure on support systems based on crisis frequency relative to social support effectiveness. SSPI = \\frac{CIF}{SSE_{avg} + 1}, \\text{calculating Crisis Intervention Frequency (CIF) relative to average Social Support Effectiveness (SSE) (adding 1 to avoid division by zero)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:40"}) SET n = {id: "mental:40", name: "High-Need, Under-Resourced Facility", type: "domain_knowledge", description: "Identifies facilities facing significant aggregate patient risk without adequate community resources.", definition: "A facility where FRPI > 4.5 and FRAI < 1.5, \\text{indicating high Facility Risk Profile Index (FRPI) and low Facility Resource Adequacy Index (FRAI)}", source_file: "mental_kb.jsonl", source_line: 41, source_id: 40, search_text: "High-Need, Under-Resourced Facility domain_knowledge Identifies facilities facing significant aggregate patient risk without adequate community resources. A facility where FRPI > 4.5 and FRAI < 1.5, \\text{indicating high Facility Risk Profile Index (FRPI) and low Facility Resource Adequacy Index (FRAI)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:41"}) SET n = {id: "mental:41", name: "Facility with Engaged but High-Impairment Population", type: "domain_knowledge", description: "Identifies facilities where the patient population is generally engaged and adherent but continues to struggle with high functional impairment.", definition: "A facility where EAS > 2.0 and PFIS > 2.0, \\text{showing high Engagement-Adherence Score (EAS) alongside high Patient Functional Impairment Score (PFIS)}", source_file: "mental_kb.jsonl", source_line: 42, source_id: 41, search_text: "Facility with Engaged but High-Impairment Population domain_knowledge Identifies facilities where the patient population is generally engaged and adherent but continues to struggle with high functional impairment. A facility where EAS > 2.0 and PFIS > 2.0, \\text{showing high Engagement-Adherence Score (EAS) alongside high Patient Functional Impairment Score (PFIS)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:42"}) SET n = {id: "mental:42", name: "Patient with Strong Recovery Capital", type: "domain_knowledge", description: "Identifies patients demonstrating high social support effectiveness coupled with low functional impairment.", definition: "A patient where SSE \\geq 5 and their funcimp value corresponds to a score of 1 (Mild), potentially indicating strong basis for sustained recovery. Relates to concepts measured by SSE and PFIS.", source_file: "mental_kb.jsonl", source_line: 43, source_id: 42, search_text: "Patient with Strong Recovery Capital domain_knowledge Identifies patients demonstrating high social support effectiveness coupled with low functional impairment. A patient where SSE \\geq 5 and their funcimp value corresponds to a score of 1 (Mild), potentially indicating strong basis for sustained recovery. Relates to concepts measured by SSE and PFIS."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:43"}) SET n = {id: "mental:43", name: "Facility Attrition Risk Indicator", type: "domain_knowledge", description: "Identifies facilities potentially experiencing high patient dropout, characterized by low engagement/adherence and high missed appointment rates.", definition: "A facility where EAS < 1.5 and MAR > 2.5, \\text{based on low Engagement-Adherence Score (EAS) and high Missed Appointment Rate (MAR)}", source_file: "mental_kb.jsonl", source_line: 44, source_id: 43, search_text: "Facility Attrition Risk Indicator domain_knowledge Identifies facilities potentially experiencing high patient dropout, characterized by low engagement/adherence and high missed appointment rates. A facility where EAS < 1.5 and MAR > 2.5, \\text{based on low Engagement-Adherence Score (EAS) and high Missed Appointment Rate (MAR)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:44"}) SET n = {id: "mental:44", name: "Well-Resourced High-Support Environment", type: "domain_knowledge", description: "Identifies facilities that are well-resourced and serve a patient population with generally high levels of social support effectiveness.", definition: "A facility where FRAI \\geq 2.0 and the average SSE \\geq 4.5, \\text{indicating high Facility Resource Adequacy Index (FRAI) and high average Social Support Effectiveness (SSE)}", source_file: "mental_kb.jsonl", source_line: 45, source_id: 44, search_text: "Well-Resourced High-Support Environment domain_knowledge Identifies facilities that are well-resourced and serve a patient population with generally high levels of social support effectiveness. A facility where FRAI \\geq 2.0 and the average SSE \\geq 4.5, \\text{indicating high Facility Resource Adequacy Index (FRAI) and high average Social Support Effectiveness (SSE)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:45"}) SET n = {id: "mental:45", name: "Patient with Severe Comorbid Distress Profile", type: "domain_knowledge", description: "Identifies patients experiencing significant simultaneous distress across depression, anxiety, and functional domains.", definition: "A patient where mental_health_scores['depression']['phq9_score'] \\geq 15 AND mental_health_scores['anxiety']['gad7_score'] \\geq 15 AND funcimp = 'Severe'. \\text{This profile relates to high individual contributions to APSF, AGSF, and PFIS}.", source_file: "mental_kb.jsonl", source_line: 46, source_id: 45, search_text: "Patient with Severe Comorbid Distress Profile domain_knowledge Identifies patients experiencing significant simultaneous distress across depression, anxiety, and functional domains. A patient where mental_health_scores['depression']['phq9_score'] \\geq 15 AND mental_health_scores['anxiety']['gad7_score'] \\geq 15 AND funcimp = 'Severe'. \\text{This profile relates to high individual contributions to APSF, AGSF, and PFIS}."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:46"}) SET n = {id: "mental:46", name: "Facility with Potential Treatment Inertia", type: "domain_knowledge", description: "Identifies facilities where patients seem engaged in therapy (high TES) but struggle with overall treatment adherence (low TAR), suggesting potential systemic barriers or resistance.", definition: "A facility where TES > 2.2 and TAR < 0.6, \\text{based on Therapy Engagement Score (TES) and Treatment Adherence Rate (TAR)}", source_file: "mental_kb.jsonl", source_line: 47, source_id: 46, search_text: "Facility with Potential Treatment Inertia domain_knowledge Identifies facilities where patients seem engaged in therapy (high TES) but struggle with overall treatment adherence (low TAR), suggesting potential systemic barriers or resistance. A facility where TES > 2.2 and TAR < 0.6, \\text{based on Therapy Engagement Score (TES) and Treatment Adherence Rate (TAR)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:47"}) SET n = {id: "mental:47", name: "Patient with High Crisis & Low Support Profile", type: "domain_knowledge", description: "Identifies patients characterized by frequent crisis interventions and weak social support systems.", definition: "A patient where their individual crisisint count (from treatmentbasics table) > 2 AND their individual SSE score (calculated from assessmentsocialanddiagnosis) < 3. \\text{This profile relates to high contribution to CIF and low individual SSE}.", source_file: "mental_kb.jsonl", source_line: 48, source_id: 47, search_text: "Patient with High Crisis & Low Support Profile domain_knowledge Identifies patients characterized by frequent crisis interventions and weak social support systems. A patient where their individual crisisint count (from treatmentbasics table) > 2 AND their individual SSE score (calculated from assessmentsocialanddiagnosis) < 3. \\text{This profile relates to high contribution to CIF and low individual SSE}."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:48"}) SET n = {id: "mental:48", name: "Facility Demonstrating Strong Patient Retention", type: "domain_knowledge", description: "Identifies facilities showing positive performance indicators related to high patient adherence and low missed appointment rates.", definition: "A facility where TAR > 0.75 and MAR < 1.0, \\text{based on Treatment Adherence Rate (TAR) and Missed Appointment Rate (MAR)}", source_file: "mental_kb.jsonl", source_line: 49, source_id: 48, search_text: "Facility Demonstrating Strong Patient Retention domain_knowledge Identifies facilities showing positive performance indicators related to high patient adherence and low missed appointment rates. A facility where TAR > 0.75 and MAR < 1.0, \\text{based on Treatment Adherence Rate (TAR) and Missed Appointment Rate (MAR)}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:49"}) SET n = {id: "mental:49", name: "High Severity, High Risk Patient Group", type: "domain_knowledge", description: "Identifies patients presenting with both high symptom severity (depression/anxiety) and elevated suicide risk.", definition: "A patient where (mental_health_scores['depression']['phq9_score'] > 19 OR mental_health_scores['anxiety']['gad7_score'] > 14) AND suicrisk IN {'High', 'Severe'}.", source_file: "mental_kb.jsonl", source_line: 50, source_id: 49, search_text: "High Severity, High Risk Patient Group domain_knowledge Identifies patients presenting with both high symptom severity (depression/anxiety) and elevated suicide risk. A patient where (mental_health_scores['depression']['phq9_score'] > 19 OR mental_health_scores['anxiety']['gad7_score'] > 14) AND suicrisk IN {'High', 'Severe'}."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:50"}) SET n = {id: "mental:50", name: "Clinical Improvement Potential Index (CIPI)", type: "calculation_knowledge", description: "Calculates a ratio comparing patient engagement/adherence to overall symptom severity at a facility, suggesting potential responsiveness to intervention.", definition: "CIPI = \\frac{EAS}{SSI + 1}, \\text{using Engagement-Adherence Score (EAS) and Symptom Severity Index (SSI). Higher values suggest higher engagement relative to current symptom burden.}", source_file: "mental_kb.jsonl", source_line: 51, source_id: 50, search_text: "Clinical Improvement Potential Index (CIPI) calculation_knowledge Calculates a ratio comparing patient engagement/adherence to overall symptom severity at a facility, suggesting potential responsiveness to intervention. CIPI = \\frac{EAS}{SSI + 1}, \\text{using Engagement-Adherence Score (EAS) and Symptom Severity Index (SSI). Higher values suggest higher engagement relative to current symptom burden.}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:51"}) SET n = {id: "mental:51", name: "Facility Efficiency Index (FEI)", type: "calculation_knowledge", description: "Estimates facility efficiency by relating the achieved patient stability metric to the available facility resource adequacy.", definition: "FEI = PSM \\times FRAI, \\text{multiplying Patient Stability Metric (PSM) by Facility Resource Adequacy Index (FRAI). Higher scores suggest better stability achieved per resource level.}", source_file: "mental_kb.jsonl", source_line: 52, source_id: 51, search_text: "Facility Efficiency Index (FEI) calculation_knowledge Estimates facility efficiency by relating the achieved patient stability metric to the available facility resource adequacy. FEI = PSM \\times FRAI, \\text{multiplying Patient Stability Metric (PSM) by Facility Resource Adequacy Index (FRAI). Higher scores suggest better stability achieved per resource level.}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:52"}) SET n = {id: "mental:52", name: "Therapeutic Alliance & Engagement Score (TAES)", type: "calculation_knowledge", description: "Computes a combined score reflecting both the average clinician-reported therapeutic alliance and the calculated therapy engagement score for a facility.", definition: "TAES = \\frac{Average(theralliance\\_score) + TES}{2}, \\text{where } theralliance\\_score = \\begin{cases} 3 & \\text{if } theralliance = Strong \\\\ 2 & \\text{if } theralliance = Moderate \\\\ 1 & \\text{if } theralliance = Weak \\\\ 0 & \\text{if } theralliance = Poor \\end{cases}, \\text{averaged across treatmentoutcomes, combined with Therapy Engagement Score (TES)}.", source_file: "mental_kb.jsonl", source_line: 53, source_id: 52, search_text: "Therapeutic Alliance & Engagement Score (TAES) calculation_knowledge Computes a combined score reflecting both the average clinician-reported therapeutic alliance and the calculated therapy engagement score for a facility. TAES = \\frac{Average(theralliance\\_score) + TES}{2}, \\text{where } theralliance\\_score = \\begin{cases} 3 & \\text{if } theralliance = Strong \\\\ 2 & \\text{if } theralliance = Moderate \\\\ 1 & \\text{if } theralliance = Weak \\\\ 0 & \\text{if } theralliance = Poor \\end{cases}, \\text{averaged across treatmentoutcomes, combined with Therapy Engagement Score (TES)}."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:53"}) SET n = {id: "mental:53", name: "Recovery Trajectory Index (RTI)", type: "calculation_knowledge", description: "Estimates the effectiveness of treatment adherence in achieving functional improvement at a facility.", definition: "RTI = \\frac{\\sum_{i \\in treatmentoutcomes} (funcimpv\\_score_i)}{|treatmentoutcomes|} \\times TAR, \\text{where } funcimpv\\_score = \\begin{cases} 3 & \\text{if } funcimpv = Significant \\\\ 2 & \\text{if } funcimpv = Moderate \\\\ 1 & \\text{if } funcimpv = Minimal \\end{cases}", source_file: "mental_kb.jsonl", source_line: 54, source_id: 53, search_text: "Recovery Trajectory Index (RTI) calculation_knowledge Estimates the effectiveness of treatment adherence in achieving functional improvement at a facility. RTI = \\frac{\\sum_{i \\in treatmentoutcomes} (funcimpv\\_score_i)}{|treatmentoutcomes|} \\times TAR, \\text{where } funcimpv\\_score = \\begin{cases} 3 & \\text{if } funcimpv = Significant \\\\ 2 & \\text{if } funcimpv = Moderate \\\\ 1 & \\text{if } funcimpv = Minimal \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:54"}) SET n = {id: "mental:54", name: "Crisis Adherence Ratio (CAR)", type: "calculation_knowledge", description: "Calculates the ratio of crisis intervention frequency to the treatment adherence rate, indicating crises occurring per unit of adherence.", definition: "CAR = \\frac{CIF}{TAR + 0.01}, \\text{dividing Crisis Intervention Frequency (CIF) by Treatment Adherence Rate (TAR) (adjusted to prevent division by zero). Higher values indicate more crises relative to adherence levels.}", source_file: "mental_kb.jsonl", source_line: 55, source_id: 54, search_text: "Crisis Adherence Ratio (CAR) calculation_knowledge Calculates the ratio of crisis intervention frequency to the treatment adherence rate, indicating crises occurring per unit of adherence. CAR = \\frac{CIF}{TAR + 0.01}, \\text{dividing Crisis Intervention Frequency (CIF) by Treatment Adherence Rate (TAR) (adjusted to prevent division by zero). Higher values indicate more crises relative to adherence levels.}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:55"}) SET n = {id: "mental:55", name: "Facility with High Clinical Leverage Potential", type: "domain_knowledge", description: "Identifies facilities with a highly engaged and adherent patient population that still experiences significant symptom severity, suggesting readiness for potentially more intensive or alternative interventions.", definition: "A facility where EAS > 2.5 AND SSI > 15, \\text{indicating high Engagement-Adherence Score (EAS) alongside a high Symptom Severity Index (SSI).}", source_file: "mental_kb.jsonl", source_line: 56, source_id: 55, search_text: "Facility with High Clinical Leverage Potential domain_knowledge Identifies facilities with a highly engaged and adherent patient population that still experiences significant symptom severity, suggesting readiness for potentially more intensive or alternative interventions. A facility where EAS > 2.5 AND SSI > 15, \\text{indicating high Engagement-Adherence Score (EAS) alongside a high Symptom Severity Index (SSI).}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:56"}) SET n = {id: "mental:56", name: "Patient Exhibiting Fragile Stability", type: "domain_knowledge", description: "Identifies patients currently classified as 'Stable Recovery' but who exhibit risk factors like frequent missed appointments or low social support, suggesting potential for destabilization.", definition: "A patient meeting Stable Recovery Patient criteria BUT having an average missappt > 2 across their encounters OR an individual SSE score < 3. \\text{Combines Stable Recovery Patient status with risk factors related to MAR and SSE}.", source_file: "mental_kb.jsonl", source_line: 57, source_id: 56, search_text: "Patient Exhibiting Fragile Stability domain_knowledge Identifies patients currently classified as 'Stable Recovery' but who exhibit risk factors like frequent missed appointments or low social support, suggesting potential for destabilization. A patient meeting Stable Recovery Patient criteria BUT having an average missappt > 2 across their encounters OR an individual SSE score < 3. \\text{Combines Stable Recovery Patient status with risk factors related to MAR and SSE}."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:57"}) SET n = {id: "mental:57", name: "Resource-Intensive High-Risk Patient Cohort", type: "domain_knowledge", description: "Identifies patients requiring significant care coordination and intervention due to possessing characteristics of both Complex Care Needs and Frequent Crisis Patterns.", definition: "A patient meeting criteria for both Complex Care Needs AND Frequent Crisis Patient (17).", source_file: "mental_kb.jsonl", source_line: 58, source_id: 57, search_text: "Resource-Intensive High-Risk Patient Cohort domain_knowledge Identifies patients requiring significant care coordination and intervention due to possessing characteristics of both Complex Care Needs and Frequent Crisis Patterns. A patient meeting criteria for both Complex Care Needs AND Frequent Crisis Patient (17)."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:58"}) SET n = {id: "mental:58", name: "Facility with Potential Engagement-Outcome Disconnect", type: "domain_knowledge", description: "Identifies facilities where high therapy engagement scores do not seem to translate into expected functional improvements or recovery progression.", definition: "A facility where TES > 2.0 AND RTI < 0.8, \\text{indicating high Therapy Engagement Score (TES) but a low Recovery Trajectory Index (RTI).}", source_file: "mental_kb.jsonl", source_line: 59, source_id: 58, search_text: "Facility with Potential Engagement-Outcome Disconnect domain_knowledge Identifies facilities where high therapy engagement scores do not seem to translate into expected functional improvements or recovery progression. A facility where TES > 2.0 AND RTI < 0.8, \\text{indicating high Therapy Engagement Score (TES) but a low Recovery Trajectory Index (RTI).}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:59"}) SET n = {id: "mental:59", name: "Systemically Stressed Facility Environment", type: "domain_knowledge", description: "Identifies facilities potentially facing overwhelming systemic stress, characterized by a significant gap between patient needs and resources, compounded by high patient attrition risk.", definition: "A facility where RDD > 1.0 AND meeting criteria for Facility Attrition Risk Indicator. \\text{Combines a high Resource-Demand Differential (RDD) with indicators of high attrition risk.}", source_file: "mental_kb.jsonl", source_line: 60, source_id: 59, search_text: "Systemically Stressed Facility Environment domain_knowledge Identifies facilities potentially facing overwhelming systemic stress, characterized by a significant gap between patient needs and resources, compounded by high patient attrition risk. A facility where RDD > 1.0 AND meeting criteria for Facility Attrition Risk Indicator. \\text{Combines a high Resource-Demand Differential (RDD) with indicators of high attrition risk.}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:60"}) SET n = {id: "mental:60", name: "Correlation Between Resource Adequacy and Adherence (CRAA)", type: "calculation_knowledge", description: "Measures the correlation between individual facility resource adequacy scores and treatment adherence rates.", definition: "CRAA = \\text{CORR}(resource\\_score, tar), \\text{where } resource\\_score \\text{ is the facility's resource adequacy score, and } tar \\text{ is the treatment adherence rate for the facility.}", source_file: "mental_kb.jsonl", source_line: 61, source_id: 60, search_text: "Correlation Between Resource Adequacy and Adherence (CRAA) calculation_knowledge Measures the correlation between individual facility resource adequacy scores and treatment adherence rates. CRAA = \\text{CORR}(resource\\_score, tar), \\text{where } resource\\_score \\text{ is the facility's resource adequacy score, and } tar \\text{ is the treatment adherence rate for the facility.}"};
MERGE (n:Knowledge:SemanticSearch {id: "mental:61"}) SET n = {id: "mental:61", name: "Facility Performance Quadrant (FPQ)", type: "domain_knowledge", description: "Categorizes facilities into performance quadrants based on their Treatment Adherence Rate and Patient Stability Metric relative to median thresholds.", definition: "A facility is assigned to one of four quadrants: 'High Adherence, High Stability' if TAR ≥ median_tar and PSM ≥ median_psm; 'High Adherence, Low Stability' if TAR ≥ median_tar and PSM < median_psm; 'Low Adherence, High Stability' if TAR < median_tar and PSM ≥ median_psm; 'Low Adherence, Low Stability' if TAR < median_tar and PSM < median_psm.", source_file: "mental_kb.jsonl", source_line: 62, source_id: 61, search_text: "Facility Performance Quadrant (FPQ) domain_knowledge Categorizes facilities into performance quadrants based on their Treatment Adherence Rate and Patient Stability Metric relative to median thresholds. A facility is assigned to one of four quadrants: 'High Adherence, High Stability' if TAR ≥ median_tar and PSM ≥ median_psm; 'High Adherence, Low Stability' if TAR ≥ median_tar and PSM < median_psm; 'Low Adherence, High Stability' if TAR < median_tar and PSM ≥ median_psm; 'Low Adherence, Low Stability' if TAR < median_tar and PSM < median_psm."};
MERGE (n:Knowledge:SemanticSearch {id: "mental:62"}) SET n = {id: "mental:62", name: "Stale Treatment Outcome Records", type: "domain_knowledge", description: "Treatment outcome records associated with encounters that occurred before a specific time threshold (e.g., older than 60 days).", definition: "Records in the `treatmentoutcomes` table where the `timemark` of the linked encounter in the `encounters` table is older than a defined interval (e.g., 60 days).", source_file: "mental_kb.jsonl", source_line: 63, source_id: 62, search_text: "Stale Treatment Outcome Records domain_knowledge Treatment outcome records associated with encounters that occurred before a specific time threshold (e.g., older than 60 days). Records in the `treatmentoutcomes` table where the `timemark` of the linked encounter in the `encounters` table is older than a defined interval (e.g., 60 days)."};
MATCH (d:Database {id: "museum"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "museum:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "museum:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "museum:" AND NOT stale.id IN ["museum:0", "museum:1", "museum:2", "museum:3", "museum:4", "museum:5", "museum:6", "museum:7", "museum:8", "museum:9", "museum:10", "museum:11", "museum:12", "museum:13", "museum:14", "museum:15", "museum:16", "museum:17", "museum:18", "museum:19", "museum:20", "museum:21", "museum:22", "museum:23", "museum:24", "museum:25", "museum:26", "museum:27", "museum:28", "museum:29", "museum:30", "museum:31", "museum:32", "museum:33", "museum:34", "museum:35", "museum:36", "museum:37", "museum:38", "museum:39", "museum:40", "museum:41", "museum:42", "museum:43", "museum:44", "museum:45", "museum:46", "museum:47", "museum:48", "museum:49", "museum:50", "museum:51", "museum:52", "museum:53", "museum:54", "museum:55", "museum:56"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "museum:0"}) SET n = {id: "museum:0", name: "Conservation Priority Index (CPI)", type: "calculation_knowledge", description: "Calculates the overall conservation priority for an artifact based on multiple factors.", definition: "CPI = \\frac{(HistSignRating + ResearchValRating + CultScore) \\times (10 - ConserveStatus)}{30}, \\text{where ConserveStatus is numerically mapped: Excellent=1, Good=3, Fair=5, Poor=7, Critical=10}", source_file: "museum_kb.jsonl", source_line: 1, source_id: 0, search_text: "Conservation Priority Index (CPI) calculation_knowledge Calculates the overall conservation priority for an artifact based on multiple factors. CPI = \\frac{(HistSignRating + ResearchValRating + CultScore) \\times (10 - ConserveStatus)}{30}, \\text{where ConserveStatus is numerically mapped: Excellent=1, Good=3, Fair=5, Poor=7, Critical=10}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:1"}) SET n = {id: "museum:1", name: "Sensitivity Weight Values", type: "value_illustration", description: "Numerical weights for sensitivity calculations", definition: "EnvSensitivity: Low=1, Medium=5, High=10; LightSensitivity: Low=1, Medium=5, High=10; TempSensitivity: Low=1, Medium=5, High=10; HumiditySensitivity: Low=1, Medium=5, High=10", source_file: "museum_kb.jsonl", source_line: 2, source_id: 1, search_text: "Sensitivity Weight Values value_illustration Numerical weights for sensitivity calculations EnvSensitivity: Low=1, Medium=5, High=10; LightSensitivity: Low=1, Medium=5, High=10; TempSensitivity: Low=1, Medium=5, High=10; HumiditySensitivity: Low=1, Medium=5, High=10"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:2"}) SET n = {id: "museum:2", name: "Environmental Risk Factor (ERF)", type: "calculation_knowledge", description: "Quantifies the overall environmental risk to an artifact based on its sensitivities.", definition: "ERF = \\frac{\\sum_{i \\in sensitivities} SensWeight_i}{|sensitivities|}, \\text{where sensitivities includes EnvSensitivity, LightSensitivity, TempSensitivity, etc, with value mapping based on Sensitivity Weight Values.}", source_file: "museum_kb.jsonl", source_line: 3, source_id: 2, search_text: "Environmental Risk Factor (ERF) calculation_knowledge Quantifies the overall environmental risk to an artifact based on its sensitivities. ERF = \\frac{\\sum_{i \\in sensitivities} SensWeight_i}{|sensitivities|}, \\text{where sensitivities includes EnvSensitivity, LightSensitivity, TempSensitivity, etc, with value mapping based on Sensitivity Weight Values.}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:3"}) SET n = {id: "museum:3", name: "Artifact Vulnerability Score (AVS)", type: "calculation_knowledge", description: "Comprehensive score indicating how vulnerable an artifact is based on its conservation priority and environmental sensitivities.", definition: "AVS = CPI \\times ERF, \\text{where higher scores indicate artifacts requiring more urgent attention}", source_file: "museum_kb.jsonl", source_line: 4, source_id: 3, search_text: "Artifact Vulnerability Score (AVS) calculation_knowledge Comprehensive score indicating how vulnerable an artifact is based on its conservation priority and environmental sensitivities. AVS = CPI \\times ERF, \\text{where higher scores indicate artifacts requiring more urgent attention}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:4"}) SET n = {id: "museum:4", name: "Display Safety Duration (DSD)", type: "calculation_knowledge", description: "Calculates the recommended maximum display duration for an artifact based on its sensitivities.", definition: "DSD = \\frac{BaseDuration \\times (10 - LightSensWeight) \\times (10 - TempSensWeight) \\times (10 - HumidSensWeight)}{1000}, \\text{where BaseDuration=36 months, and SensWeight uses Sensitivity Weight Values.}", source_file: "museum_kb.jsonl", source_line: 5, source_id: 4, search_text: "Display Safety Duration (DSD) calculation_knowledge Calculates the recommended maximum display duration for an artifact based on its sensitivities. DSD = \\frac{BaseDuration \\times (10 - LightSensWeight) \\times (10 - TempSensWeight) \\times (10 - HumidSensWeight)}{1000}, \\text{where BaseDuration=36 months, and SensWeight uses Sensitivity Weight Values.}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:5"}) SET n = {id: "museum:5", name: "Showcase Environmental Stability Rating (SESR)", type: "calculation_knowledge", description: "Measures how well a showcase maintains stable environmental conditions.", definition: "SESR = 10 - \\frac{(TempVar24h + \\frac{HumVar24h}{5} + LeakRate)}{3}, \\text{where higher scores indicate more stable showcases}", source_file: "museum_kb.jsonl", source_line: 6, source_id: 5, search_text: "Showcase Environmental Stability Rating (SESR) calculation_knowledge Measures how well a showcase maintains stable environmental conditions. SESR = 10 - \\frac{(TempVar24h + \\frac{HumVar24h}{5} + LeakRate)}{3}, \\text{where higher scores indicate more stable showcases}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:6"}) SET n = {id: "museum:6", name: "Artifact Exhibition Compatibility (AEC)", type: "calculation_knowledge", description: "Determines how compatible an artifact is with its current showcase environment.", definition: "AEC = 10 - |ERF - SESR|, \\text{where a score closer to 10 indicates better compatibility}", source_file: "museum_kb.jsonl", source_line: 7, source_id: 6, search_text: "Artifact Exhibition Compatibility (AEC) calculation_knowledge Determines how compatible an artifact is with its current showcase environment. AEC = 10 - |ERF - SESR|, \\text{where a score closer to 10 indicates better compatibility}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:7"}) SET n = {id: "museum:7", name: "Material Deterioration Rate (MDR)", type: "calculation_knowledge", description: "Estimates the rate of material deterioration based on environmental factors.", definition: "MDR = \\frac{ArtAgeYears \\times ERF \\times (RelHumidity - 50)^2 \\times TempC}{100000}, \\text{where higher values indicate faster deterioration}", source_file: "museum_kb.jsonl", source_line: 8, source_id: 7, search_text: "Material Deterioration Rate (MDR) calculation_knowledge Estimates the rate of material deterioration based on environmental factors. MDR = \\frac{ArtAgeYears \\times ERF \\times (RelHumidity - 50)^2 \\times TempC}{100000}, \\text{where higher values indicate faster deterioration}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:8"}) SET n = {id: "museum:8", name: "Light Exposure Risk (LER)", type: "calculation_knowledge", description: "Quantifies the risk from light exposure based on artifact sensitivity and current light levels.", definition: "LER = \\frac{LightLux \\times LightSensWeight \\times VisibleExpLxh}{1000}, \\text{where LightSensWeight uses Sensitivity Weight Values}", source_file: "museum_kb.jsonl", source_line: 9, source_id: 8, search_text: "Light Exposure Risk (LER) calculation_knowledge Quantifies the risk from light exposure based on artifact sensitivity and current light levels. LER = \\frac{LightLux \\times LightSensWeight \\times VisibleExpLxh}{1000}, \\text{where LightSensWeight uses Sensitivity Weight Values}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:9"}) SET n = {id: "museum:9", name: "Conservation Budget Efficiency (CBE)", type: "calculation_knowledge", description: "Measures the efficiency of conservation budget allocation relative to artifact importance.", definition: "CBE = \\frac{\\sum_{i \\in artifacts} (CPI_i \\times BudgetRatio_i)}{|artifacts|}, \\text{where BudgetRatio is the proportion of total conservation budget allocated to each artifact}", source_file: "museum_kb.jsonl", source_line: 10, source_id: 9, search_text: "Conservation Budget Efficiency (CBE) calculation_knowledge Measures the efficiency of conservation budget allocation relative to artifact importance. CBE = \\frac{\\sum_{i \\in artifacts} (CPI_i \\times BudgetRatio_i)}{|artifacts|}, \\text{where BudgetRatio is the proportion of total conservation budget allocated to each artifact}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:10"}) SET n = {id: "museum:10", name: "Visitor Impact Risk (VIR)", type: "calculation_knowledge", description: "Assesses the risk posed by visitor traffic to artifacts in exhibition halls.", definition: "VIR = \\frac{VisitorCountDaily \\times VisitorFlowRate \\times VisitorDwellMin}{1000}, \\text{where VisitorFlowRate is numerically mapped: Low=1, Medium=3, High=5}", source_file: "museum_kb.jsonl", source_line: 11, source_id: 10, search_text: "Visitor Impact Risk (VIR) calculation_knowledge Assesses the risk posed by visitor traffic to artifacts in exhibition halls. VIR = \\frac{VisitorCountDaily \\times VisitorFlowRate \\times VisitorDwellMin}{1000}, \\text{where VisitorFlowRate is numerically mapped: Low=1, Medium=3, High=5}"};
MERGE (n:Knowledge:SemanticSearch {id: "museum:11"}) SET n = {id: "museum:11", name: "High-Value Artifact", type: "domain_knowledge", description: "Identifies artifacts with exceptional historical, cultural, or monetary value requiring special attention.", definition: "An artifact is considered high-value when its InsValueUSD exceeds $1,000,000 OR when both HistSignRating and CultScore are in the top 10% of all artifacts.", source_file: "museum_kb.jsonl", source_line: 12, source_id: 11, search_text: "High-Value Artifact domain_knowledge Identifies artifacts with exceptional historical, cultural, or monetary value requiring special attention. An artifact is considered high-value when its InsValueUSD exceeds $1,000,000 OR when both HistSignRating and CultScore are in the top 10% of all artifacts."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:12"}) SET n = {id: "museum:12", name: "Conservation Emergency", type: "domain_knowledge", description: "Identifies artifacts requiring immediate conservation intervention.", definition: "A situation where an artifact has ConserveStatus='Critical' AND a TreatPriority='Urgent'.", source_file: "museum_kb.jsonl", source_line: 13, source_id: 12, search_text: "Conservation Emergency domain_knowledge Identifies artifacts requiring immediate conservation intervention. A situation where an artifact has ConserveStatus='Critical' AND a TreatPriority='Urgent'."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:13"}) SET n = {id: "museum:13", name: "Environmental Instability Event", type: "domain_knowledge", description: "Identifies periods when showcase environmental conditions fluctuate beyond acceptable parameters.", definition: "Occurs when TempVar24h > 1°C OR HumVar24h > 3 within a 24-hour period.", source_file: "museum_kb.jsonl", source_line: 14, source_id: 13, search_text: "Environmental Instability Event domain_knowledge Identifies periods when showcase environmental conditions fluctuate beyond acceptable parameters. Occurs when TempVar24h > 1°C OR HumVar24h > 3 within a 24-hour period."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:14"}) SET n = {id: "museum:14", name: "Accelerated Deterioration Scenario", type: "domain_knowledge", description: "Identifies conditions that could lead to rapid artifact deterioration.", definition: "Occurs when MDR > 5 AND at least two SensitivityData values are 'High'.", source_file: "museum_kb.jsonl", source_line: 15, source_id: 14, search_text: "Accelerated Deterioration Scenario domain_knowledge Identifies conditions that could lead to rapid artifact deterioration. Occurs when MDR > 5 AND at least two SensitivityData values are 'High'."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:15"}) SET n = {id: "museum:15", name: "Exhibition Rotation Candidate", type: "domain_knowledge", description: "Identifies artifacts that should be considered for rotation out of display.", definition: "An artifact is a rotation candidate when its current display duration exceeds 75% of its DSD OR LER > 7.", source_file: "museum_kb.jsonl", source_line: 16, source_id: 15, search_text: "Exhibition Rotation Candidate domain_knowledge Identifies artifacts that should be considered for rotation out of display. An artifact is a rotation candidate when its current display duration exceeds 75% of its DSD OR LER > 7."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:16"}) SET n = {id: "museum:16", name: "Showcase Failure Risk", type: "domain_knowledge", description: "Identifies showcases at risk of failing to maintain proper environmental conditions.", definition: "Occurs when SESR < 4 OR at least three of the following are true: SealCondition='Poor', MaintStatus='Overdue', FilterStatus='Replace Now', SilicaGelStatus='Replace Now'.", source_file: "museum_kb.jsonl", source_line: 17, source_id: 16, search_text: "Showcase Failure Risk domain_knowledge Identifies showcases at risk of failing to maintain proper environmental conditions. Occurs when SESR < 4 OR at least three of the following are true: SealCondition='Poor', MaintStatus='Overdue', FilterStatus='Replace Now', SilicaGelStatus='Replace Now'."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:17"}) SET n = {id: "museum:17", name: "Conservation Budget Crisis", type: "domain_knowledge", description: "Identifies when conservation budget allocation is insufficient for high-priority artifacts.", definition: "Occurs when CBE < 0.5 AND at least one artifact has ConserveStatus='Critical' and BudgetAllocStatus='Insufficient'.", source_file: "museum_kb.jsonl", source_line: 18, source_id: 17, search_text: "Conservation Budget Crisis domain_knowledge Identifies when conservation budget allocation is insufficient for high-priority artifacts. Occurs when CBE < 0.5 AND at least one artifact has ConserveStatus='Critical' and BudgetAllocStatus='Insufficient'."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:18"}) SET n = {id: "museum:18", name: "Dynasty Value Artifact", type: "domain_knowledge", description: "Identifies artifacts from historically significant dynasties with higher research and cultural value.", definition: "Artifacts from 'Ming', 'Han', or 'Tang' dynasties that also have ResearchValRating > 8.", source_file: "museum_kb.jsonl", source_line: 19, source_id: 18, search_text: "Dynasty Value Artifact domain_knowledge Identifies artifacts from historically significant dynasties with higher research and cultural value. Artifacts from 'Ming', 'Han', or 'Tang' dynasties that also have ResearchValRating > 8."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:19"}) SET n = {id: "museum:19", name: "Visitor Crowd Risk", type: "domain_knowledge", description: "Identifies exhibition halls where high visitor numbers pose risks to artifact safety.", definition: "Occurs when VIR > 5 AND SecLevel='Level 1' for any artifact in the hall.", source_file: "museum_kb.jsonl", source_line: 20, source_id: 19, search_text: "Visitor Crowd Risk domain_knowledge Identifies exhibition halls where high visitor numbers pose risks to artifact safety. Occurs when VIR > 5 AND SecLevel='Level 1' for any artifact in the hall."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:20"}) SET n = {id: "museum:20", name: "Organic Material Vulnerability", type: "domain_knowledge", description: "Identifies organic materials requiring special environmental conditions.", definition: "Artifacts with MatType='Wood', 'Textile', or 'Paper' AND EnvSensitivity='High' require specialized environmental controls with narrower humidity and temperature ranges than inorganic materials.", source_file: "museum_kb.jsonl", source_line: 21, source_id: 20, search_text: "Organic Material Vulnerability domain_knowledge Identifies organic materials requiring special environmental conditions. Artifacts with MatType='Wood', 'Textile', or 'Paper' AND EnvSensitivity='High' require specialized environmental controls with narrower humidity and temperature ranges than inorganic materials."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:21"}) SET n = {id: "museum:21", name: "ArtifactsCore.ConserveStatus", type: "value_illustration", description: "Illustrates the conservation status values and their meanings.", definition: "Values range from 'Excellent' (recently conserved, no issues), 'Good' (stable with minor issues), 'Fair' (stable but with noticeable issues), 'Poor' (active deterioration), to 'Critical' (severe deterioration requiring immediate intervention).", source_file: "museum_kb.jsonl", source_line: 22, source_id: 21, search_text: "ArtifactsCore.ConserveStatus value_illustration Illustrates the conservation status values and their meanings. Values range from 'Excellent' (recently conserved, no issues), 'Good' (stable with minor issues), 'Fair' (stable but with noticeable issues), 'Poor' (active deterioration), to 'Critical' (severe deterioration requiring immediate intervention)."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:22"}) SET n = {id: "museum:22", name: "ArtifactRatings.HistSignRating", type: "value_illustration", description: "Illustrates the historical significance rating scale.", definition: "A SMALLINT typically ranging from 1-10, where 1-3 indicates minor historical significance, 4-7 indicates moderate significance, and 8-10 indicates exceptional historical importance that fundamentally contributes to our understanding of past cultures or events.", source_file: "museum_kb.jsonl", source_line: 23, source_id: 22, search_text: "ArtifactRatings.HistSignRating value_illustration Illustrates the historical significance rating scale. A SMALLINT typically ranging from 1-10, where 1-3 indicates minor historical significance, 4-7 indicates moderate significance, and 8-10 indicates exceptional historical importance that fundamentally contributes to our understanding of past cultures or events."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:23"}) SET n = {id: "museum:23", name: "SensitivityData.LightSensitivity", type: "value_illustration", description: "Illustrates light sensitivity classifications and their implications.", definition: "Values include 'Low' (can tolerate up to 300 lux, like stone artifacts), 'Medium' (should be limited to 150-200 lux, like oil paintings), and 'High' (restricted to 50 lux or less, like textiles and works on paper).", source_file: "museum_kb.jsonl", source_line: 24, source_id: 23, search_text: "SensitivityData.LightSensitivity value_illustration Illustrates light sensitivity classifications and their implications. Values include 'Low' (can tolerate up to 300 lux, like stone artifacts), 'Medium' (should be limited to 150-200 lux, like oil paintings), and 'High' (restricted to 50 lux or less, like textiles and works on paper)."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:24"}) SET n = {id: "museum:24", name: "SensitivityData.HumiditySensitivity", type: "value_illustration", description: "Illustrates humidity sensitivity classifications and their implications.", definition: "Values include 'Low' (can tolerate 30-65% RH, like stone artifacts), 'Medium' (requires 40-60% RH, like wood), and 'High' (requires 45-55% RH with minimal fluctuation, like lacquer work).", source_file: "museum_kb.jsonl", source_line: 25, source_id: 24, search_text: "SensitivityData.HumiditySensitivity value_illustration Illustrates humidity sensitivity classifications and their implications. Values include 'Low' (can tolerate 30-65% RH, like stone artifacts), 'Medium' (requires 40-60% RH, like wood), and 'High' (requires 45-55% RH with minimal fluctuation, like lacquer work)."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:25"}) SET n = {id: "museum:25", name: "ExhibitionHalls.CCTVCoverage", type: "value_illustration", description: "Illustrates CCTV coverage classifications.", definition: "'Full' indicates 100% exhibition space coverage with overlapping cameras, 'Partial' indicates 60-90% coverage with possible blind spots, and 'Limited' indicates less than 60% coverage focusing only on high-value areas.", source_file: "museum_kb.jsonl", source_line: 26, source_id: 25, search_text: "ExhibitionHalls.CCTVCoverage value_illustration Illustrates CCTV coverage classifications. 'Full' indicates 100% exhibition space coverage with overlapping cameras, 'Partial' indicates 60-90% coverage with possible blind spots, and 'Limited' indicates less than 60% coverage focusing only on high-value areas."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:26"}) SET n = {id: "museum:26", name: "Showcases.Airtightness", type: "value_illustration", description: "Illustrates showcase airtightness measurement.", definition: "A REAL value typically ranging from 0.01 (extremely airtight, less than 0.01 air changes per day) to 5.0 (poor airtightness, multiple air changes per day). Museum-grade showcases typically maintain values below 0.1.", source_file: "museum_kb.jsonl", source_line: 27, source_id: 26, search_text: "Showcases.Airtightness value_illustration Illustrates showcase airtightness measurement. A REAL value typically ranging from 0.01 (extremely airtight, less than 0.01 air changes per day) to 5.0 (poor airtightness, multiple air changes per day). Museum-grade showcases typically maintain values below 0.1."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:27"}) SET n = {id: "museum:27", name: "EnvironmentalReadingsCore.TempC", type: "value_illustration", description: "Illustrates temperature readings and their conservation implications.", definition: "Values typically range from 15-25°C, with 18-22°C being ideal for most collections. Fluctuations greater than 2°C within 24 hours can stress materials. Values outside 10-30°C indicate environmental control failure requiring immediate attention.", source_file: "museum_kb.jsonl", source_line: 28, source_id: 27, search_text: "EnvironmentalReadingsCore.TempC value_illustration Illustrates temperature readings and their conservation implications. Values typically range from 15-25°C, with 18-22°C being ideal for most collections. Fluctuations greater than 2°C within 24 hours can stress materials. Values outside 10-30°C indicate environmental control failure requiring immediate attention."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:28"}) SET n = {id: "museum:28", name: "EnvironmentalReadingsCore.RelHumidity", type: "value_illustration", description: "Illustrates relative humidity readings and their conservation implications.", definition: "Values typically range from 30-65%, with 45-55% being ideal for mixed collections. Fluctuations greater than 5% within 24 hours can cause dimensional changes in organic materials. Values below 30% risk embrittlement, while above 65% risk mold growth.", source_file: "museum_kb.jsonl", source_line: 29, source_id: 28, search_text: "EnvironmentalReadingsCore.RelHumidity value_illustration Illustrates relative humidity readings and their conservation implications. Values typically range from 30-65%, with 45-55% being ideal for mixed collections. Fluctuations greater than 5% within 24 hours can cause dimensional changes in organic materials. Values below 30% risk embrittlement, while above 65% risk mold growth."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:29"}) SET n = {id: "museum:29", name: "LightAndRadiationReadings.LightLux", type: "value_illustration", description: "Illustrates light intensity measurements and their conservation implications.", definition: "Values in lux range from near-dark (5-10 lux) to typical indoor lighting (300-500 lux). Conservation standards recommend 50 lux for highly sensitive materials, 150-200 lux for paintings and wood, and up to 300 lux for stone and metal. Daylight can exceed 10,000 lux and should be filtered.", source_file: "museum_kb.jsonl", source_line: 30, source_id: 29, search_text: "LightAndRadiationReadings.LightLux value_illustration Illustrates light intensity measurements and their conservation implications. Values in lux range from near-dark (5-10 lux) to typical indoor lighting (300-500 lux). Conservation standards recommend 50 lux for highly sensitive materials, 150-200 lux for paintings and wood, and up to 300 lux for stone and metal. Daylight can exceed 10,000 lux and should be filtered."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:30"}) SET n = {id: "museum:30", name: "AirQualityReadings.PM25Conc", type: "value_illustration", description: "Illustrates fine particulate matter measurements and their conservation implications.", definition: "Values represent PM2.5 concentration in µg/m³. Clean museum air should measure below 5 µg/m³. Values of 5-15 indicate acceptable conditions, 15-30 indicate potential risk to sensitive materials, and above 30 represent hazardous conditions requiring immediate air filtration review.", source_file: "museum_kb.jsonl", source_line: 31, source_id: 30, search_text: "AirQualityReadings.PM25Conc value_illustration Illustrates fine particulate matter measurements and their conservation implications. Values represent PM2.5 concentration in µg/m³. Clean museum air should measure below 5 µg/m³. Values of 5-15 indicate acceptable conditions, 15-30 indicate potential risk to sensitive materials, and above 30 represent hazardous conditions requiring immediate air filtration review."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:31"}) SET n = {id: "museum:31", name: "Total Environmental Threat Level (TETL)", type: "calculation_knowledge", description: "Comprehensive measurement of all environmental threats to an artifact based on multiple risk factors.", definition: "TETL = ERF + LER + (MDR × 2), where ERF is the Environmental Risk Factor, LER is the Light Exposure Risk, and MDR is the Material Deterioration Rat.", source_file: "museum_kb.jsonl", source_line: 32, source_id: 31, search_text: "Total Environmental Threat Level (TETL) calculation_knowledge Comprehensive measurement of all environmental threats to an artifact based on multiple risk factors. TETL = ERF + LER + (MDR × 2), where ERF is the Environmental Risk Factor, LER is the Light Exposure Risk, and MDR is the Material Deterioration Rat."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:32"}) SET n = {id: "museum:32", name: "Showcase Protection Adequacy (SPA)", type: "calculation_knowledge", description: "Measures how well a showcase protects its artifacts based on its stability and the artifacts' requirements.", definition: "SPA = SESR - (ERF × 0.5), where SESR is the Showcase Environmental Stability Rating and ERF is the Environmental Risk Factor. Positive values indicate adequate protection.", source_file: "museum_kb.jsonl", source_line: 33, source_id: 32, search_text: "Showcase Protection Adequacy (SPA) calculation_knowledge Measures how well a showcase protects its artifacts based on its stability and the artifacts' requirements. SPA = SESR - (ERF × 0.5), where SESR is the Showcase Environmental Stability Rating and ERF is the Environmental Risk Factor. Positive values indicate adequate protection."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:33"}) SET n = {id: "museum:33", name: "Conservation Backlog Risk (CBR)", type: "calculation_knowledge", description: "Quantifies the risk associated with delayed conservation treatments.", definition: "CBR = (CPI × (Days since LastCleaningDate - CleanIntervalDays)) ÷ 100, where CPI is the Conservation Priority Index. Higher values indicate higher risk from delayed conservation.", source_file: "museum_kb.jsonl", source_line: 34, source_id: 33, search_text: "Conservation Backlog Risk (CBR) calculation_knowledge Quantifies the risk associated with delayed conservation treatments. CBR = (CPI × (Days since LastCleaningDate - CleanIntervalDays)) ÷ 100, where CPI is the Conservation Priority Index. Higher values indicate higher risk from delayed conservation."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:34"}) SET n = {id: "museum:34", name: "Visitor Capacity Safety Factor (VCSF)", type: "calculation_knowledge", description: "Determines the safe visitor capacity for exhibition halls containing sensitive artifacts.", definition: "VCSF = VIR ÷ (AVS × 0.1), where VIR is the Visitor Impact Risk and AVS is the Artifact Vulnerability Score. Lower values indicate safer visitor capacities.", source_file: "museum_kb.jsonl", source_line: 35, source_id: 34, search_text: "Visitor Capacity Safety Factor (VCSF) calculation_knowledge Determines the safe visitor capacity for exhibition halls containing sensitive artifacts. VCSF = VIR ÷ (AVS × 0.1), where VIR is the Visitor Impact Risk and AVS is the Artifact Vulnerability Score. Lower values indicate safer visitor capacities."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:35"}) SET n = {id: "museum:35", name: "Exhibition Safety Quotient (ESQ)", type: "calculation_knowledge", description: "Comprehensive safety rating for an exhibition based on artifacts, showcases, and visitor factors.", definition: "ESQ = ((10 - AVS) + AEC + (10 - VIR)) ÷ 3, where AVS is the Artifact Vulnerability Score, AEC is the Artifact Exhibition Compatibility, and VIR is the Visitor Impact Risk. Higher values indicate safer exhibitions.", source_file: "museum_kb.jsonl", source_line: 36, source_id: 35, search_text: "Exhibition Safety Quotient (ESQ) calculation_knowledge Comprehensive safety rating for an exhibition based on artifacts, showcases, and visitor factors. ESQ = ((10 - AVS) + AEC + (10 - VIR)) ÷ 3, where AVS is the Artifact Vulnerability Score, AEC is the Artifact Exhibition Compatibility, and VIR is the Visitor Impact Risk. Higher values indicate safer exhibitions."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:36"}) SET n = {id: "museum:36", name: "Conservation Resource Allocation Efficiency (CRAE)", type: "calculation_knowledge", description: "Measures how efficiently conservation resources are allocated based on priorities and budget.", definition: "CRAE = CBE × (1 - (CBR ÷ 10)), where CBE is the Conservation Budget Efficiency and CBR is the Conservation Backlog Risk. Higher values indicate more efficient resource allocation.", source_file: "museum_kb.jsonl", source_line: 37, source_id: 36, search_text: "Conservation Resource Allocation Efficiency (CRAE) calculation_knowledge Measures how efficiently conservation resources are allocated based on priorities and budget. CRAE = CBE × (1 - (CBR ÷ 10)), where CBE is the Conservation Budget Efficiency and CBR is the Conservation Backlog Risk. Higher values indicate more efficient resource allocation."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:37"}) SET n = {id: "museum:37", name: "Material Aging Projection (MAP)", type: "calculation_knowledge", description: "Projects the rate of artifact aging based on material type and environmental conditions.", definition: "MAP = MDR × (1 + (TETL ÷ 20)), where MDR is the Material Deterioration Rate and TETL is the Total Environmental Threat Level. Higher values indicate faster projected aging.", source_file: "museum_kb.jsonl", source_line: 38, source_id: 37, search_text: "Material Aging Projection (MAP) calculation_knowledge Projects the rate of artifact aging based on material type and environmental conditions. MAP = MDR × (1 + (TETL ÷ 20)), where MDR is the Material Deterioration Rate and TETL is the Total Environmental Threat Level. Higher values indicate faster projected aging."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:38"}) SET n = {id: "museum:38", name: "Exhibition Rotation Priority Score (ERPS)", type: "calculation_knowledge", description: "Calculates priority for rotating artifacts in and out of exhibition based on multiple factors.", definition: "ERPS = (DSD - DisplayDurMonths) × (LER + 1) × (CPI + 1) ÷ 100, where DSD is the Display Safety Duration, LER is the Light Exposure Risk, and CPI is the Conservation Priority Index. Lower values indicate higher rotation priority.", source_file: "museum_kb.jsonl", source_line: 39, source_id: 38, search_text: "Exhibition Rotation Priority Score (ERPS) calculation_knowledge Calculates priority for rotating artifacts in and out of exhibition based on multiple factors. ERPS = (DSD - DisplayDurMonths) × (LER + 1) × (CPI + 1) ÷ 100, where DSD is the Display Safety Duration, LER is the Light Exposure Risk, and CPI is the Conservation Priority Index. Lower values indicate higher rotation priority."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:39"}) SET n = {id: "museum:39", name: "Environmental Compliance Index (ECI)", type: "calculation_knowledge", description: "Measures how well current environmental conditions meet the requirements for an artifact.", definition: "ECI = 10 - (|(TempC - IdealTemp)| + |(RelHumidity - IdealHumidity)| ÷ 5 + ERF ÷ 2), where ERF is the Environmental Risk Factor. Higher values indicate better compliance with requirements.", source_file: "museum_kb.jsonl", source_line: 40, source_id: 39, search_text: "Environmental Compliance Index (ECI) calculation_knowledge Measures how well current environmental conditions meet the requirements for an artifact. ECI = 10 - (|(TempC - IdealTemp)| + |(RelHumidity - IdealHumidity)| ÷ 5 + ERF ÷ 2), where ERF is the Environmental Risk Factor. Higher values indicate better compliance with requirements."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:40"}) SET n = {id: "museum:40", name: "Security Risk Exposure (SRE)", type: "calculation_knowledge", description: "Quantifies an artifact's exposure to security risks based on value and security measures.", definition: "SRE = (InsValueUSD ÷ 100000) × (10 - VIR) ÷ 10, where VIR is the Visitor Impact Risk. Higher values indicate greater security risk exposure.", source_file: "museum_kb.jsonl", source_line: 41, source_id: 40, search_text: "Security Risk Exposure (SRE) calculation_knowledge Quantifies an artifact's exposure to security risks based on value and security measures. SRE = (InsValueUSD ÷ 100000) × (10 - VIR) ÷ 10, where VIR is the Visitor Impact Risk. Higher values indicate greater security risk exposure."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:41"}) SET n = {id: "museum:41", name: "Critical Conservation Alert", type: "domain_knowledge", description: "Identifies artifacts in critical condition requiring immediate intervention.", definition: "An artifact that meets both the Conservation Emergency criteria AND has an AVS > 8.", source_file: "museum_kb.jsonl", source_line: 42, source_id: 41, search_text: "Critical Conservation Alert domain_knowledge Identifies artifacts in critical condition requiring immediate intervention. An artifact that meets both the Conservation Emergency criteria AND has an AVS > 8."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:42"}) SET n = {id: "museum:42", name: "High Deterioration Risk Artifact", type: "domain_knowledge", description: "Identifies artifacts at high risk of rapid deterioration due to environmental factors.", definition: "An artifact that has TETL > 15 AND falls under the Accelerated Deterioration Scenario.", source_file: "museum_kb.jsonl", source_line: 43, source_id: 42, search_text: "High Deterioration Risk Artifact domain_knowledge Identifies artifacts at high risk of rapid deterioration due to environmental factors. An artifact that has TETL > 15 AND falls under the Accelerated Deterioration Scenario."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:43"}) SET n = {id: "museum:43", name: "Exhibition Rotation Urgency", type: "domain_knowledge", description: "Identifies artifacts that should be immediately removed from exhibition.", definition: "Occurs when an artifact is an Exhibition Rotation Candidate AND has an ERPS < 0.", source_file: "museum_kb.jsonl", source_line: 44, source_id: 43, search_text: "Exhibition Rotation Urgency domain_knowledge Identifies artifacts that should be immediately removed from exhibition. Occurs when an artifact is an Exhibition Rotation Candidate AND has an ERPS < 0."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:44"}) SET n = {id: "museum:44", name: "Showcase Compatibility Issue", type: "domain_knowledge", description: "Identifies incompatible artifact-showcase pairings requiring adjustment.", definition: "Occurs when SPA < 0 AND the artifact is classified as having High-Value.", source_file: "museum_kb.jsonl", source_line: 45, source_id: 44, search_text: "Showcase Compatibility Issue domain_knowledge Identifies incompatible artifact-showcase pairings requiring adjustment. Occurs when SPA < 0 AND the artifact is classified as having High-Value."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:45"}) SET n = {id: "museum:45", name: "Conservation Resource Crisis", type: "domain_knowledge", description: "Identifies serious conservation resource allocation problems.", definition: "Occurs when CRAE < 0.3 AND there is a Conservation Budget Crisis.", source_file: "museum_kb.jsonl", source_line: 46, source_id: 45, search_text: "Conservation Resource Crisis domain_knowledge Identifies serious conservation resource allocation problems. Occurs when CRAE < 0.3 AND there is a Conservation Budget Crisis."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:46"}) SET n = {id: "museum:46", name: "Dynasty Artifact at Risk", type: "domain_knowledge", description: "Identifies historically significant dynasty artifacts at conservation risk.", definition: "An artifact that qualifies as a Dynasty Value Artifact AND has a MAP > 3.", source_file: "museum_kb.jsonl", source_line: 47, source_id: 46, search_text: "Dynasty Artifact at Risk domain_knowledge Identifies historically significant dynasty artifacts at conservation risk. An artifact that qualifies as a Dynasty Value Artifact AND has a MAP > 3."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:47"}) SET n = {id: "museum:47", name: "Environmental Control Failure", type: "domain_knowledge", description: "Identifies situations where environmental controls are failing to protect artifacts.", definition: "Occurs when ECI < 4 AND there is an Environmental Instability Event.", source_file: "museum_kb.jsonl", source_line: 48, source_id: 47, search_text: "Environmental Control Failure domain_knowledge Identifies situations where environmental controls are failing to protect artifacts. Occurs when ECI < 4 AND there is an Environmental Instability Event."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:48"}) SET n = {id: "museum:48", name: "High Security Priority Artifact", type: "domain_knowledge", description: "Identifies artifacts requiring enhanced security measures.", definition: "An artifact that is classified as High-Value AND has an SRE > 5.", source_file: "museum_kb.jsonl", source_line: 49, source_id: 48, search_text: "High Security Priority Artifact domain_knowledge Identifies artifacts requiring enhanced security measures. An artifact that is classified as High-Value AND has an SRE > 5."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:49"}) SET n = {id: "museum:49", name: "Visitor Traffic Safety Concern", type: "domain_knowledge", description: "Identifies situations where visitor traffic poses safety concerns for exhibitions.", definition: "Occurs when VCSF > 2 AND there is a Visitor Crowd Risk situation.", source_file: "museum_kb.jsonl", source_line: 50, source_id: 49, search_text: "Visitor Traffic Safety Concern domain_knowledge Identifies situations where visitor traffic poses safety concerns for exhibitions. Occurs when VCSF > 2 AND there is a Visitor Crowd Risk situation."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:50"}) SET n = {id: "museum:50", name: "Organic Material Emergency", type: "domain_knowledge", description: "Identifies emergency situations for organic materials.", definition: "Occurs when an artifact falls under the Organic Material Vulnerability classification AND has a TETL > 12.", source_file: "museum_kb.jsonl", source_line: 51, source_id: 50, search_text: "Organic Material Emergency domain_knowledge Identifies emergency situations for organic materials. Occurs when an artifact falls under the Organic Material Vulnerability classification AND has a TETL > 12."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:51"}) SET n = {id: "museum:51", name: "High-Value Category", type: "domain_knowledge", description: "Classification system for categorizing high-value artifacts based on their monetary or cultural/historical significance.", definition: "An artifact falls into 'Monetary High-Value' category when its InsValueUSD exceeds $1,000,000. It qualifies as 'Cultural/Historical High-Value' when both its HistSignRating and CultScore are in the top 10% of all artifacts (percentile rank = 1). Otherwise 'Other'.", source_file: "museum_kb.jsonl", source_line: 52, source_id: 51, search_text: "High-Value Category domain_knowledge Classification system for categorizing high-value artifacts based on their monetary or cultural/historical significance. An artifact falls into 'Monetary High-Value' category when its InsValueUSD exceeds $1,000,000. It qualifies as 'Cultural/Historical High-Value' when both its HistSignRating and CultScore are in the top 10% of all artifacts (percentile rank = 1). Otherwise 'Other'."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:52"}) SET n = {id: "museum:52", name: "ERPS Decision Threshold", type: "domain_knowledge", description: "Converts ERPS scores into conservation actions", definition: "When ERPS < 0, trigger 'Immediate Rotation'; otherwise 'Monitor'.", source_file: "museum_kb.jsonl", source_line: 53, source_id: 52, search_text: "ERPS Decision Threshold domain_knowledge Converts ERPS scores into conservation actions When ERPS < 0, trigger 'Immediate Rotation'; otherwise 'Monitor'."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:53"}) SET n = {id: "museum:53", name: "Light Exposure Thresholds", type: "domain_knowledge", description: "Defines maximum safe light exposure levels for artifacts based on material sensitivity", definition: "High sensitivity artifacts (textiles, paper) must not exceed 50 lux; Medium sensitivity (paintings, wood) must not exceed 200 lux. Based on conservation research about light-induced deterioration rates.", source_file: "museum_kb.jsonl", source_line: 54, source_id: 53, search_text: "Light Exposure Thresholds domain_knowledge Defines maximum safe light exposure levels for artifacts based on material sensitivity High sensitivity artifacts (textiles, paper) must not exceed 50 lux; Medium sensitivity (paintings, wood) must not exceed 200 lux. Based on conservation research about light-induced deterioration rates."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:54"}) SET n = {id: "museum:54", name: "Conservation Environment Chronology (CEC)", type: "domain_knowledge", description: "A methodological approach used in museum conservation to segment environmental monitoring data into chronological intervals. This approach enables curators to identify seasonal trends, long-term shifts, and anomalies in environmental conditions that can affect artifact stability and preservation.", definition: "CEC involves grouping readings (e.g., temperature, humidity, air pressure) by fixed time intervals (such as by year) to discern patterns and inform conservation strategies.", source_file: "museum_kb.jsonl", source_line: 55, source_id: 54, search_text: "Conservation Environment Chronology (CEC) domain_knowledge A methodological approach used in museum conservation to segment environmental monitoring data into chronological intervals. This approach enables curators to identify seasonal trends, long-term shifts, and anomalies in environmental conditions that can affect artifact stability and preservation. CEC involves grouping readings (e.g., temperature, humidity, air pressure) by fixed time intervals (such as by year) to discern patterns and inform conservation strategies."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:55"}) SET n = {id: "museum:55", name: "Artifact Rarity & Valuation (ARV)", type: "domain_knowledge", description: "Establishes criteria for identifying artifacts of exceptional rarity and valuation that demand heightened preservation measures and limited public access.", definition: "Artifacts are categorized as ARV if their insurance value exceed $1,000,000.", source_file: "museum_kb.jsonl", source_line: 56, source_id: 55, search_text: "Artifact Rarity & Valuation (ARV) domain_knowledge Establishes criteria for identifying artifacts of exceptional rarity and valuation that demand heightened preservation measures and limited public access. Artifacts are categorized as ARV if their insurance value exceed $1,000,000."};
MERGE (n:Knowledge:SemanticSearch {id: "museum:56"}) SET n = {id: "museum:56", name: "Conservation Priority Level", type: "domain_knowledge", description: "Classifies artifacts into priority levels based on their CPI scores", definition: "'High Priority': CPI > 7 (Artifacts requiring immediate conservation attention); 'Medium Priority': 4 < CPI ≤ 7 (Artifacts needing monitoring and planned conservation); 'Low Priority': CPI ≤ 4 (Artifacts in stable condition).", source_file: "museum_kb.jsonl", source_line: 57, source_id: 56, search_text: "Conservation Priority Level domain_knowledge Classifies artifacts into priority levels based on their CPI scores 'High Priority': CPI > 7 (Artifacts requiring immediate conservation attention); 'Medium Priority': 4 < CPI ≤ 7 (Artifacts needing monitoring and planned conservation); 'Low Priority': CPI ≤ 4 (Artifacts in stable condition)."};
MATCH (d:Database {id: "news"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "news:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "news:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "news:" AND NOT stale.id IN ["news:0", "news:1", "news:2", "news:3", "news:4", "news:5", "news:6", "news:7", "news:8", "news:9", "news:10", "news:11", "news:12", "news:13", "news:14", "news:15", "news:16", "news:17", "news:18", "news:19", "news:20", "news:21", "news:22", "news:23", "news:24", "news:25", "news:26", "news:27", "news:28", "news:29", "news:30", "news:31", "news:32", "news:33", "news:34", "news:35", "news:36", "news:37", "news:38", "news:39", "news:40", "news:41", "news:42", "news:43", "news:44", "news:45", "news:46", "news:47", "news:48", "news:49", "news:50", "news:51", "news:52", "news:53", "news:54", "news:55", "news:56", "news:57", "news:58", "news:59", "news:60"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "news:0"}) SET n = {id: "news:0", name: "User Engagement Rate (UER)", type: "calculation_knowledge", description: "Calculates the engagement rate of a user during a session by combining engagement score, page views, and session duration.", definition: "UER = \\frac{\\text{seshviews} \\times \\text{engscore}}{\\text{seshdur}}, \\text{ where seshviews is the number of articles viewed and seshdur is the duration in seconds.}", source_file: "news_kb.jsonl", source_line: 1, source_id: 0, search_text: "User Engagement Rate (UER) calculation_knowledge Calculates the engagement rate of a user during a session by combining engagement score, page views, and session duration. UER = \\frac{\\text{seshviews} \\times \\text{engscore}}{\\text{seshdur}}, \\text{ where seshviews is the number of articles viewed and seshdur is the duration in seconds.}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:1"}) SET n = {id: "news:1", name: "Article Quality Index (AQI)", type: "calculation_knowledge", description: "Determines the quality index of an article by integrating quality score, freshness, sentiment, and controversy factors.", definition: "AQI = \\frac{(qualscore + freshscore + sentscore - contrscore)}{3}, \\text{ where each score is normalized on a uniform scale.}", source_file: "news_kb.jsonl", source_line: 2, source_id: 1, search_text: "Article Quality Index (AQI) calculation_knowledge Determines the quality index of an article by integrating quality score, freshness, sentiment, and controversy factors. AQI = \\frac{(qualscore + freshscore + sentscore - contrscore)}{3}, \\text{ where each score is normalized on a uniform scale.}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:2"}) SET n = {id: "news:2", name: "Recommendation Relevance Score (RRS)", type: "calculation_knowledge", description: "Computes the overall relevance of a recommendation by averaging recommendation score, algorithm confidence, and utility.", definition: "RRS = \\frac{(recscore + confval + recutil)}{3}, \\text{ where the contributing factors capture recommendation performance.}", source_file: "news_kb.jsonl", source_line: 3, source_id: 2, search_text: "Recommendation Relevance Score (RRS) calculation_knowledge Computes the overall relevance of a recommendation by averaging recommendation score, algorithm confidence, and utility. RRS = \\frac{(recscore + confval + recutil)}{3}, \\text{ where the contributing factors capture recommendation performance.}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:3"}) SET n = {id: "news:3", name: "Session Bounce Rate Adjustment (SBRA)", type: "calculation_knowledge", description: "Adjusts the raw session bounce rate by factoring in the click-through rate to better understand session quality.", definition: "SBRA = bncrate \\times \\left(1 - \\frac{ctrval}{100}\\right), \\text{ where bncrate is the bounce rate and ctrval is the click-through rate percentage.}", source_file: "news_kb.jsonl", source_line: 4, source_id: 3, search_text: "Session Bounce Rate Adjustment (SBRA) calculation_knowledge Adjusts the raw session bounce rate by factoring in the click-through rate to better understand session quality. SBRA = bncrate \\times \\left(1 - \\frac{ctrval}{100}\\right), \\text{ where bncrate is the bounce rate and ctrval is the click-through rate percentage.}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:4"}) SET n = {id: "news:4", name: "System Performance Index (SPI)", type: "calculation_knowledge", description: "Measures overall system performance by considering response time, load, and performance scores.", definition: "SPI = \\frac{(perfscore - loadscore) \\times 100}{resptime}, \\text{ where resptime is measured in milliseconds.}", source_file: "news_kb.jsonl", source_line: 5, source_id: 4, search_text: "System Performance Index (SPI) calculation_knowledge Measures overall system performance by considering response time, load, and performance scores. SPI = \\frac{(perfscore - loadscore) \\times 100}{resptime}, \\text{ where resptime is measured in milliseconds.}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:5"}) SET n = {id: "news:5", name: "Article Readability Score (ARS)", type: "calculation_knowledge", description: "Calculates the readability of an article by correlating estimated reading time with word count and difficulty factor.", definition: "ARS = \\frac{readsec \\times \\log(wordlen)}{w}, \\text{ where w is a weight factor assigned according to the article difficulty level (e.g., 1 for Basic, 1.5 for Intermediate, 2 for Advanced, 1.2 for others).}", source_file: "news_kb.jsonl", source_line: 6, source_id: 5, search_text: "Article Readability Score (ARS) calculation_knowledge Calculates the readability of an article by correlating estimated reading time with word count and difficulty factor. ARS = \\frac{readsec \\times \\log(wordlen)}{w}, \\text{ where w is a weight factor assigned according to the article difficulty level (e.g., 1 for Basic, 1.5 for Intermediate, 2 for Advanced, 1.2 for others).}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:6"}) SET n = {id: "news:6", name: "statusWeight", type: "value_illustration", description: "A weight assigned to different subscription tiers to reflect their business value.", definition: "'Premium' = 2.0, 'Enterprise' = 3.0, 'Basic' = 1.0, and others = 0.5. It reflects the assumed revenue or importance of the subscription tier.", source_file: "news_kb.jsonl", source_line: 7, source_id: 6, search_text: "statusWeight value_illustration A weight assigned to different subscription tiers to reflect their business value. 'Premium' = 2.0, 'Enterprise' = 3.0, 'Basic' = 1.0, and others = 0.5. It reflects the assumed revenue or importance of the subscription tier."};
MERGE (n:Knowledge:SemanticSearch {id: "news:7"}) SET n = {id: "news:7", name: "genderFactor", type: "value_illustration", description: "A weighting value used to balance gender representation in demographic scoring.", definition: "Assigned as 1.0 for Male, Female, and 0.8 otherwise. It standardizes the gender effect on demographic impact.", source_file: "news_kb.jsonl", source_line: 8, source_id: 7, search_text: "genderFactor value_illustration A weighting value used to balance gender representation in demographic scoring. Assigned as 1.0 for Male, Female, and 0.8 otherwise. It standardizes the gender effect on demographic impact."};
MERGE (n:Knowledge:SemanticSearch {id: "news:8"}) SET n = {id: "news:8", name: "occupationFactor", type: "value_illustration", description: "A multiplier that reflects how user occupation contributes to their demographic value.", definition: "'Professional' = 1.5, 'Retired' = 1.2, 'Student' = 0.7, 'Other' = 1.0. These values are based on segmentation assumptions or business rules.", source_file: "news_kb.jsonl", source_line: 9, source_id: 8, search_text: "occupationFactor value_illustration A multiplier that reflects how user occupation contributes to their demographic value. 'Professional' = 1.5, 'Retired' = 1.2, 'Student' = 0.7, 'Other' = 1.0. These values are based on segmentation assumptions or business rules."};
MERGE (n:Knowledge:SemanticSearch {id: "news:9"}) SET n = {id: "news:9", name: "Content Interaction Efficiency (CIE)", type: "calculation_knowledge", description: "Measures how efficiently a user interacts with content inside a session by looking at the average relative order in which events occur (their sequence values)", definition: "CIE = AVG(seqval)\n\nHere `seqval` is the event’s sequence/position within a session (e.g., 1, 2, 3…).  Average it across all interactions in a session.", source_file: "news_kb.jsonl", source_line: 10, source_id: 9, search_text: "Content Interaction Efficiency (CIE) calculation_knowledge Measures how efficiently a user interacts with content inside a session by looking at the average relative order in which events occur (their sequence values) CIE = AVG(seqval)\n\nHere `seqval` is the event’s sequence/position within a session (e.g., 1, 2, 3…).  Average it across all interactions in a session."};
MERGE (n:Knowledge:SemanticSearch {id: "news:10"}) SET n = {id: "news:10", name: "Premium Content Rule (PCR)", type: "domain_knowledge", description: "Specifies that articles marked as Premium must meet higher quality and engagement benchmarks.", definition: "Premium articles are required to satisfy a defined quality threshold and demonstrate superior engagement metrics to enhance user satisfaction.", source_file: "news_kb.jsonl", source_line: 11, source_id: 10, search_text: "Premium Content Rule (PCR) domain_knowledge Specifies that articles marked as Premium must meet higher quality and engagement benchmarks. Premium articles are required to satisfy a defined quality threshold and demonstrate superior engagement metrics to enhance user satisfaction."};
MERGE (n:Knowledge:SemanticSearch {id: "news:11"}) SET n = {id: "news:11", name: "Personalization Priority (PP)", type: "domain_knowledge", description: "Establishes criteria for prioritizing content that aligns closely with individual user preferences based on prior interactions.", definition: "Content that strongly matches user preferences and exhibits high interaction rates is prioritized in personalized recommendations.", source_file: "news_kb.jsonl", source_line: 12, source_id: 11, search_text: "Personalization Priority (PP) domain_knowledge Establishes criteria for prioritizing content that aligns closely with individual user preferences based on prior interactions. Content that strongly matches user preferences and exhibits high interaction rates is prioritized in personalized recommendations."};
MERGE (n:Knowledge:SemanticSearch {id: "news:12"}) SET n = {id: "news:12", name: "AB Testing Cohort Analysis (ABTCA)", type: "domain_knowledge", description: "Defines segmentation criteria for splitting users into cohorts for A/B testing experiments.", definition: "Users are assigned to predetermined groups to facilitate controlled comparisons of experimental feature performance across cohorts.", source_file: "news_kb.jsonl", source_line: 13, source_id: 12, search_text: "AB Testing Cohort Analysis (ABTCA) domain_knowledge Defines segmentation criteria for splitting users into cohorts for A/B testing experiments. Users are assigned to predetermined groups to facilitate controlled comparisons of experimental feature performance across cohorts."};
MERGE (n:Knowledge:SemanticSearch {id: "news:13"}) SET n = {id: "news:13", name: "Engagement Consistency Principle (ECP)", type: "domain_knowledge", description: "States that consistent engagement across multiple sessions is a key indicator of long-term user loyalty.", definition: "Users exhibiting steady engagement metrics over a series of sessions, irrespective of content type, are likely to display higher lifetime value.", source_file: "news_kb.jsonl", source_line: 14, source_id: 13, search_text: "Engagement Consistency Principle (ECP) domain_knowledge States that consistent engagement across multiple sessions is a key indicator of long-term user loyalty. Users exhibiting steady engagement metrics over a series of sessions, irrespective of content type, are likely to display higher lifetime value."};
MERGE (n:Knowledge:SemanticSearch {id: "news:14"}) SET n = {id: "news:14", name: "Network Connection Quality Standard (NCQS)", type: "domain_knowledge", description: "Defines the benchmark criteria for acceptable network performance to ensure reliable content delivery.", definition: "A device connection meets optimal standards if it delivers network speed and connection quality above preset thresholds, facilitating smooth content consumption.", source_file: "news_kb.jsonl", source_line: 15, source_id: 14, search_text: "Network Connection Quality Standard (NCQS) domain_knowledge Defines the benchmark criteria for acceptable network performance to ensure reliable content delivery. A device connection meets optimal standards if it delivers network speed and connection quality above preset thresholds, facilitating smooth content consumption."};
MERGE (n:Knowledge:SemanticSearch {id: "news:15"}) SET n = {id: "news:15", name: "Content Recommendation Strategy (CRS)", type: "domain_knowledge", description: "Outlines the strategic framework used to select and rank recommended articles.", definition: "Recommendation strategies are developed by jointly considering content relevance, user behavior analytics, and system performance metrics.", source_file: "news_kb.jsonl", source_line: 16, source_id: 15, search_text: "Content Recommendation Strategy (CRS) domain_knowledge Outlines the strategic framework used to select and rank recommended articles. Recommendation strategies are developed by jointly considering content relevance, user behavior analytics, and system performance metrics."};
MERGE (n:Knowledge:SemanticSearch {id: "news:16"}) SET n = {id: "news:16", name: "User Behavior Paradigm (UBP)", type: "domain_knowledge", description: "Describes typical patterns observed in user interactions within the platform.", definition: "By analyzing metrics such as session duration, bounce rates, and interaction sequences, common behavioral patterns are identified which inform future personalization efforts.", source_file: "news_kb.jsonl", source_line: 17, source_id: 16, search_text: "User Behavior Paradigm (UBP) domain_knowledge Describes typical patterns observed in user interactions within the platform. By analyzing metrics such as session duration, bounce rates, and interaction sequences, common behavioral patterns are identified which inform future personalization efforts."};
MERGE (n:Knowledge:SemanticSearch {id: "news:17"}) SET n = {id: "news:17", name: "User Subscription Value (USV)", type: "calculation_knowledge", description: "Evaluates the relative value of a user's subscription based on subscription duration and status.", definition: "USV = subdays \\times statusWeight, \\text{ where statusWeight is a multiplier defined by the subscription status (for example, Premium, Enterprise, or Basic).}", source_file: "news_kb.jsonl", source_line: 18, source_id: 17, search_text: "User Subscription Value (USV) calculation_knowledge Evaluates the relative value of a user's subscription based on subscription duration and status. USV = subdays \\times statusWeight, \\text{ where statusWeight is a multiplier defined by the subscription status (for example, Premium, Enterprise, or Basic).}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:18"}) SET n = {id: "news:18", name: "Short Session Anomaly Detection (SSAD)", type: "domain_knowledge", description: "Identifies sessions with unusually short durations that may signal disengagement or testing anomalies.", definition: "Sessions with a duration significantly below the average, accompanied by low engagement and minimal page views, are flagged as anomalies.", source_file: "news_kb.jsonl", source_line: 19, source_id: 18, search_text: "Short Session Anomaly Detection (SSAD) domain_knowledge Identifies sessions with unusually short durations that may signal disengagement or testing anomalies. Sessions with a duration significantly below the average, accompanied by low engagement and minimal page views, are flagged as anomalies."};
MERGE (n:Knowledge:SemanticSearch {id: "news:19"}) SET n = {id: "news:19", name: "Interaction Timeliness Indicator (ITI)", type: "domain_knowledge", description: "Evaluates the promptness of user interactions after content presentation.", definition: "A minimal delay between content exposure and user interaction indicates high interest, thereby enhancing content performance metrics.", source_file: "news_kb.jsonl", source_line: 20, source_id: 19, search_text: "Interaction Timeliness Indicator (ITI) domain_knowledge Evaluates the promptness of user interactions after content presentation. A minimal delay between content exposure and user interaction indicates high interest, thereby enhancing content performance metrics."};
MERGE (n:Knowledge:SemanticSearch {id: "news:20"}) SET n = {id: "news:20", name: "Screen Resolution Illustration", type: "value_illustration", description: "Illustrates the significance of device screen resolution on overall user experience.", definition: "Screen resolution values such as '1920x1080' indicate the clarity and detail of the display, impacting readability and visual appeal.", source_file: "news_kb.jsonl", source_line: 21, source_id: 20, search_text: "Screen Resolution Illustration value_illustration Illustrates the significance of device screen resolution on overall user experience. Screen resolution values such as '1920x1080' indicate the clarity and detail of the display, impacting readability and visual appeal."};
MERGE (n:Knowledge:SemanticSearch {id: "news:21"}) SET n = {id: "news:21", name: "Device OS Version Illustration", type: "value_illustration", description: "Depicts the relevance of the operating system version in assessing device performance and compatibility.", definition: "OS version details like 'Windows10.0.19042' provide insights into potential compatibility issues and performance benchmarks.", source_file: "news_kb.jsonl", source_line: 22, source_id: 21, search_text: "Device OS Version Illustration value_illustration Depicts the relevance of the operating system version in assessing device performance and compatibility. OS version details like 'Windows10.0.19042' provide insights into potential compatibility issues and performance benchmarks."};
MERGE (n:Knowledge:SemanticSearch {id: "news:22"}) SET n = {id: "news:22", name: "Article Word Count Illustration", type: "value_illustration", description: "Demonstrates how the number of words in an article influences reading time and engagement.", definition: "Higher word counts, such as 1200 words, generally correlate with longer estimated reading times and may affect reader retention.", source_file: "news_kb.jsonl", source_line: 23, source_id: 22, search_text: "Article Word Count Illustration value_illustration Demonstrates how the number of words in an article influences reading time and engagement. Higher word counts, such as 1200 words, generally correlate with longer estimated reading times and may affect reader retention."};
MERGE (n:Knowledge:SemanticSearch {id: "news:23"}) SET n = {id: "news:23", name: "Network Speed Illustration", type: "value_illustration", description: "Shows the impact of network speed on the quality of content delivery.", definition: "Network speeds measured in Mbps (for example, 25.75 Mbps) help assess potential buffering, latency issues, and overall user experience during content consumption.", source_file: "news_kb.jsonl", source_line: 24, source_id: 23, search_text: "Network Speed Illustration value_illustration Shows the impact of network speed on the quality of content delivery. Network speeds measured in Mbps (for example, 25.75 Mbps) help assess potential buffering, latency issues, and overall user experience during content consumption."};
MERGE (n:Knowledge:SemanticSearch {id: "news:24"}) SET n = {id: "news:24", name: "Accessibility Score Illustration", type: "value_illustration", description: "Explains how accessibility scores reflect the ease-of-use and inclusivity of content.", definition: "An accessibility score like 90.00 demonstrates a high level of compliance with usability standards, ensuring that content is accessible to a wide range of users.", source_file: "news_kb.jsonl", source_line: 25, source_id: 24, search_text: "Accessibility Score Illustration value_illustration Explains how accessibility scores reflect the ease-of-use and inclusivity of content. An accessibility score like 90.00 demonstrates a high level of compliance with usability standards, ensuring that content is accessible to a wide range of users."};
MERGE (n:Knowledge:SemanticSearch {id: "news:25"}) SET n = {id: "news:25", name: "App Version Quality Illustration", type: "value_illustration", description: "Assesses the importance of keeping app versions updated to improve interface quality and functionality.", definition: "Versions such as 'v3.1.2' suggest iterative improvements that enhance user interface performance and overall application stability.", source_file: "news_kb.jsonl", source_line: 26, source_id: 25, search_text: "App Version Quality Illustration value_illustration Assesses the importance of keeping app versions updated to improve interface quality and functionality. Versions such as 'v3.1.2' suggest iterative improvements that enhance user interface performance and overall application stability."};
MERGE (n:Knowledge:SemanticSearch {id: "news:26"}) SET n = {id: "news:26", name: "Geo-Location Data Illustration", type: "value_illustration", description: "Illustrates how geographical data aids in localizing content and understanding regional behavior patterns.", definition: "Geo-location indicators like 'San Francisco' or 'USA' provide context for regional content consumption and market-specific performance trends.", source_file: "news_kb.jsonl", source_line: 27, source_id: 26, search_text: "Geo-Location Data Illustration value_illustration Illustrates how geographical data aids in localizing content and understanding regional behavior patterns. Geo-location indicators like 'San Francisco' or 'USA' provide context for regional content consumption and market-specific performance trends."};
MERGE (n:Knowledge:SemanticSearch {id: "news:27"}) SET n = {id: "news:27", name: "Error Count Illustration", type: "value_illustration", description: "Demonstrates the importance of monitoring error counts to evaluate system reliability.", definition: "Error counts, typically ranging from 0 to 5, serve as essential indicators of system health and operational robustness.", source_file: "news_kb.jsonl", source_line: 28, source_id: 27, search_text: "Error Count Illustration value_illustration Demonstrates the importance of monitoring error counts to evaluate system reliability. Error counts, typically ranging from 0 to 5, serve as essential indicators of system health and operational robustness."};
MERGE (n:Knowledge:SemanticSearch {id: "news:28"}) SET n = {id: "news:28", name: "Recommendation Position Illustration", type: "value_illustration", description: "Depicts the effect of recommendation placement on user visibility and engagement.", definition: "A recommendation placed in position 3, for example, may benefit from higher prominence compared to lower-ranked placements.", source_file: "news_kb.jsonl", source_line: 29, source_id: 28, search_text: "Recommendation Position Illustration value_illustration Depicts the effect of recommendation placement on user visibility and engagement. A recommendation placed in position 3, for example, may benefit from higher prominence compared to lower-ranked placements."};
MERGE (n:Knowledge:SemanticSearch {id: "news:29"}) SET n = {id: "news:29", name: "Content Format Variation Illustration", type: "value_illustration", description: "Highlights how different content formats influence user consumption and engagement.", definition: "Variations such as 'Mobile', 'Text', 'HTML', or 'AMP' show how display adjustments cater to diverse user contexts and device capabilities.", source_file: "news_kb.jsonl", source_line: 30, source_id: 29, search_text: "Content Format Variation Illustration value_illustration Highlights how different content formats influence user consumption and engagement. Variations such as 'Mobile', 'Text', 'HTML', or 'AMP' show how display adjustments cater to diverse user contexts and device capabilities."};
MERGE (n:Knowledge:SemanticSearch {id: "news:30"}) SET n = {id: "news:30", name: "User Demographic Score (UDS)", type: "calculation_knowledge", description: "Measures the impact of user demographics by combining age with factors related to gender and occupation.", definition: "UDS = ageval \\times genderFactor \\times occupationFactor, \\text{ where genderFactor and occupationFactor are weights derived from segmentation studies.}", source_file: "news_kb.jsonl", source_line: 31, source_id: 30, search_text: "User Demographic Score (UDS) calculation_knowledge Measures the impact of user demographics by combining age with factors related to gender and occupation. UDS = ageval \\times genderFactor \\times occupationFactor, \\text{ where genderFactor and occupationFactor are weights derived from segmentation studies.}"};
MERGE (n:Knowledge:SemanticSearch {id: "news:31"}) SET n = {id: "news:31", name: "Real-Time Session Efficiency (RTSE)", type: "calculation_knowledge", description: "Evaluates session efficiency by balancing interaction outcomes against bounce adjustments.", definition: "RTSE = \\frac{CIE}{SBRA}, where CIE denotes the Content Interaction Efficiency and SBRA is the Session Bounce Rate Adjustment.", source_file: "news_kb.jsonl", source_line: 32, source_id: 31, search_text: "Real-Time Session Efficiency (RTSE) calculation_knowledge Evaluates session efficiency by balancing interaction outcomes against bounce adjustments. RTSE = \\frac{CIE}{SBRA}, where CIE denotes the Content Interaction Efficiency and SBRA is the Session Bounce Rate Adjustment."};
MERGE (n:Knowledge:SemanticSearch {id: "news:32"}) SET n = {id: "news:32", name: "Dynamic Content Value (DCV)", type: "calculation_knowledge", description: "Measures an article's overall value by combining quality, recommendation relevance, and readability factors.", definition: "DCV = \\frac{AQI + RRS + (100 - ARS)}{3}, where AQI is the Article Quality Index, RRS the Recommendation Relevance Score, and ARS the Article Readability Score.", source_file: "news_kb.jsonl", source_line: 33, source_id: 32, search_text: "Dynamic Content Value (DCV) calculation_knowledge Measures an article's overall value by combining quality, recommendation relevance, and readability factors. DCV = \\frac{AQI + RRS + (100 - ARS)}{3}, where AQI is the Article Quality Index, RRS the Recommendation Relevance Score, and ARS the Article Readability Score."};
MERGE (n:Knowledge:SemanticSearch {id: "news:33"}) SET n = {id: "news:33", name: "Optimized Recommendation Score (ORS)", type: "calculation_knowledge", description: "Adjusts recommendation quality by incorporating system performance metrics.", definition: "ORS = \\frac{RRS \\times SPI}{k}, where RRS reflects recommendation quality and SPI represents the System Performance Index, with k as a normalization constant.", source_file: "news_kb.jsonl", source_line: 34, source_id: 33, search_text: "Optimized Recommendation Score (ORS) calculation_knowledge Adjusts recommendation quality by incorporating system performance metrics. ORS = \\frac{RRS \\times SPI}{k}, where RRS reflects recommendation quality and SPI represents the System Performance Index, with k as a normalization constant."};
MERGE (n:Knowledge:SemanticSearch {id: "news:34"}) SET n = {id: "news:34", name: "Adjusted Read Time Estimator (ARTE)", type: "calculation_knowledge", description: "Provides an estimation of effective reading time by adjusting raw reading seconds.", definition: "ARTE = readsec \\times \\frac{ARS}{UER}, where ARS is the Article Readability Score and UER is the User Engagement Rate.", source_file: "news_kb.jsonl", source_line: 35, source_id: 34, search_text: "Adjusted Read Time Estimator (ARTE) calculation_knowledge Provides an estimation of effective reading time by adjusting raw reading seconds. ARTE = readsec \\times \\frac{ARS}{UER}, where ARS is the Article Readability Score and UER is the User Engagement Rate."};
MERGE (n:Knowledge:SemanticSearch {id: "news:35"}) SET n = {id: "news:35", name: "Personalization Accuracy Metric (PAM)", type: "calculation_knowledge", description: "Computes the accuracy of personalization by balancing recommendation performance and priority assignment.", definition: "PAM = \\frac{RRS + PP}{2}, where RRS offers recommendation effectiveness and PP defines the Personalization Priority.", source_file: "news_kb.jsonl", source_line: 36, source_id: 35, search_text: "Personalization Accuracy Metric (PAM) calculation_knowledge Computes the accuracy of personalization by balancing recommendation performance and priority assignment. PAM = \\frac{RRS + PP}{2}, where RRS offers recommendation effectiveness and PP defines the Personalization Priority."};
MERGE (n:Knowledge:SemanticSearch {id: "news:36"}) SET n = {id: "news:36", name: "Conversion Impact Factor (CIF)", type: "calculation_knowledge", description: "Assesses the potential impact on conversions by linking engagement with prompt interaction.", definition: "CIF = \\frac{UER}{ITI}, where UER indicates user engagement and ITI measures the Interaction Timeliness Indicator.", source_file: "news_kb.jsonl", source_line: 37, source_id: 36, search_text: "Conversion Impact Factor (CIF) calculation_knowledge Assesses the potential impact on conversions by linking engagement with prompt interaction. CIF = \\frac{UER}{ITI}, where UER indicates user engagement and ITI measures the Interaction Timeliness Indicator."};
MERGE (n:Knowledge:SemanticSearch {id: "news:37"}) SET n = {id: "news:37", name: "Adjusted Bounce Ratio (ABR)", type: "calculation_knowledge", description: "Modifies the raw bounce metric by integrating real-time efficiency factors.", definition: "ABR = SBRA \\times (RTSE \\; factor), with SBRA representing the Session Bounce Rate Adjustment and RTSE signifying Real-Time Session Efficiency.", source_file: "news_kb.jsonl", source_line: 38, source_id: 37, search_text: "Adjusted Bounce Ratio (ABR) calculation_knowledge Modifies the raw bounce metric by integrating real-time efficiency factors. ABR = SBRA \\times (RTSE \\; factor), with SBRA representing the Session Bounce Rate Adjustment and RTSE signifying Real-Time Session Efficiency."};
MERGE (n:Knowledge:SemanticSearch {id: "news:38"}) SET n = {id: "news:38", name: "Composite System Stability (CSS)", type: "calculation_knowledge", description: "Combines system and device performance to yield an overall stability measure.", definition: "CSS = \\sqrt{SPI \\times DPM}, where SPI is the System Performance Index and DPM is the Device Performance Metric.", source_file: "news_kb.jsonl", source_line: 39, source_id: 38, search_text: "Composite System Stability (CSS) calculation_knowledge Combines system and device performance to yield an overall stability measure. CSS = \\sqrt{SPI \\times DPM}, where SPI is the System Performance Index and DPM is the Device Performance Metric."};
MERGE (n:Knowledge:SemanticSearch {id: "news:39"}) SET n = {id: "news:39", name: "Interactive Content Amplifier (ICA)", type: "calculation_knowledge", description: "Enhances content value by factoring in user interactions and recommendation quality.", definition: "ICA = CIE + (\\alpha \\times RRS), where CIE captures Content Interaction Efficiency and RRS contributes the Recommendation Relevance Score.", source_file: "news_kb.jsonl", source_line: 40, source_id: 39, search_text: "Interactive Content Amplifier (ICA) calculation_knowledge Enhances content value by factoring in user interactions and recommendation quality. ICA = CIE + (\\alpha \\times RRS), where CIE captures Content Interaction Efficiency and RRS contributes the Recommendation Relevance Score."};
MERGE (n:Knowledge:SemanticSearch {id: "news:40"}) SET n = {id: "news:40", name: "High Engagement Indicator (HEI)", type: "domain_knowledge", description: "Determines if a session or article demonstrates outstanding user engagement.", definition: "An item is marked as high engagement when the User Engagement Rate is above the threshold and the Content Interaction Efficiency is high.", source_file: "news_kb.jsonl", source_line: 41, source_id: 40, search_text: "High Engagement Indicator (HEI) domain_knowledge Determines if a session or article demonstrates outstanding user engagement. An item is marked as high engagement when the User Engagement Rate is above the threshold and the Content Interaction Efficiency is high."};
MERGE (n:Knowledge:SemanticSearch {id: "news:41"}) SET n = {id: "news:41", name: "Premium Article Distinction (PAD)", type: "domain_knowledge", description: "Classifies articles as premium based on quality and content policy adherence.", definition: "An article qualifies as premium when it surpasses the Article Quality Index threshold and complies with the Premium Content Rule.", source_file: "news_kb.jsonl", source_line: 42, source_id: 41, search_text: "Premium Article Distinction (PAD) domain_knowledge Classifies articles as premium based on quality and content policy adherence. An article qualifies as premium when it surpasses the Article Quality Index threshold and complies with the Premium Content Rule."};
MERGE (n:Knowledge:SemanticSearch {id: "news:42"}) SET n = {id: "news:42", name: "Targeted Personalization Benchmark (TPB)", type: "domain_knowledge", description: "Establishes a benchmark for assessing the effectiveness of personalized content.", definition: "Content meets the targeted personalization benchmark when it aligns with the criteria set by Personalization Priority and is corroborated by a high Personalization Accuracy Metric.", source_file: "news_kb.jsonl", source_line: 43, source_id: 42, search_text: "Targeted Personalization Benchmark (TPB) domain_knowledge Establishes a benchmark for assessing the effectiveness of personalized content. Content meets the targeted personalization benchmark when it aligns with the criteria set by Personalization Priority and is corroborated by a high Personalization Accuracy Metric."};
MERGE (n:Knowledge:SemanticSearch {id: "news:43"}) SET n = {id: "news:43", name: "User Churn Predictor (UCP)", type: "domain_knowledge", description: "Identifies users at risk of churning through behavior pattern analysis.", definition: "Churn risk is flagged when inconsistent engagement per the Engagement Consistency Principle combines with anomalies detected by Short Session Anomaly Detection.", source_file: "news_kb.jsonl", source_line: 44, source_id: 43, search_text: "User Churn Predictor (UCP) domain_knowledge Identifies users at risk of churning through behavior pattern analysis. Churn risk is flagged when inconsistent engagement per the Engagement Consistency Principle combines with anomalies detected by Short Session Anomaly Detection."};
MERGE (n:Knowledge:SemanticSearch {id: "news:44"}) SET n = {id: "news:44", name: "Content Virality Threshold (CVT)", type: "domain_knowledge", description: "Defines the performance level at which content is likely to go viral.", definition: "Content is considered viral when its Dynamic Content Value and Interactive Content Amplifier both exceed the established virality thresholds.", source_file: "news_kb.jsonl", source_line: 45, source_id: 44, search_text: "Content Virality Threshold (CVT) domain_knowledge Defines the performance level at which content is likely to go viral. Content is considered viral when its Dynamic Content Value and Interactive Content Amplifier both exceed the established virality thresholds."};
MERGE (n:Knowledge:SemanticSearch {id: "news:45"}) SET n = {id: "news:45", name: "System Resilience Factor (SRF)", type: "domain_knowledge", description: "Assesses the robustness and fault tolerance of the system.", definition: "A system demonstrates resilience when the Composite System Stability and the System Performance Index both indicate strong performance.", source_file: "news_kb.jsonl", source_line: 46, source_id: 45, search_text: "System Resilience Factor (SRF) domain_knowledge Assesses the robustness and fault tolerance of the system. A system demonstrates resilience when the Composite System Stability and the System Performance Index both indicate strong performance."};
MERGE (n:Knowledge:SemanticSearch {id: "news:46"}) SET n = {id: "news:46", name: "Session Drop-off Risk (SDR)", type: "domain_knowledge", description: "Determines the likelihood of a session ending abruptly.", definition: "A session is at high drop-off risk when low Real-Time Session Efficiency coincides with an elevated Adjusted Bounce Ratio.", source_file: "news_kb.jsonl", source_line: 47, source_id: 46, search_text: "Session Drop-off Risk (SDR) domain_knowledge Determines the likelihood of a session ending abruptly. A session is at high drop-off risk when low Real-Time Session Efficiency coincides with an elevated Adjusted Bounce Ratio."};
MERGE (n:Knowledge:SemanticSearch {id: "news:47"}) SET n = {id: "news:47", name: "Conversion Potential Indicator (CPI)", type: "domain_knowledge", description: "Evaluates the potential of converting user interactions into conversions.", definition: "High conversion potential is indicated when the Conversion Impact Factor and the Interactive Content Amplifier are both optimized.", source_file: "news_kb.jsonl", source_line: 48, source_id: 47, search_text: "Conversion Potential Indicator (CPI) domain_knowledge Evaluates the potential of converting user interactions into conversions. High conversion potential is indicated when the Conversion Impact Factor and the Interactive Content Amplifier are both optimized."};
MERGE (n:Knowledge:SemanticSearch {id: "news:48"}) SET n = {id: "news:48", name: "Content Consumption Consistency (CCC)", type: "domain_knowledge", description: "Indicates uniformity in user content consumption behavior.", definition: "Consistent content consumption is achieved when the Article Readability Score, User Engagement Rate, and Personalization Priority together display steady patterns.", source_file: "news_kb.jsonl", source_line: 49, source_id: 48, search_text: "Content Consumption Consistency (CCC) domain_knowledge Indicates uniformity in user content consumption behavior. Consistent content consumption is achieved when the Article Readability Score, User Engagement Rate, and Personalization Priority together display steady patterns."};
MERGE (n:Knowledge:SemanticSearch {id: "news:49"}) SET n = {id: "news:49", name: "Subscription Valuation Rule (SVR)", type: "domain_knowledge", description: "Determines the business value of a user by integrating subscription details with demographic and engagement factors.", definition: "A comprehensive user valuation is achieved by weighting subscription duration, engagement performance, and demographic indicators.", source_file: "news_kb.jsonl", source_line: 50, source_id: 49, search_text: "Subscription Valuation Rule (SVR) domain_knowledge Determines the business value of a user by integrating subscription details with demographic and engagement factors. A comprehensive user valuation is achieved by weighting subscription duration, engagement performance, and demographic indicators."};
MERGE (n:Knowledge:SemanticSearch {id: "news:50"}) SET n = {id: "news:50", name: "Composite User Activity Score (CUAS)", type: "calculation_knowledge", description: "Integrates multiple user activity metrics into one composite score.", definition: "CUAS = \\frac{UER + UDS + USV}{3}, where UER is the User Engagement Rate, UDS is the User Demographic Score, and USV is the User Subscription Value.", source_file: "news_kb.jsonl", source_line: 51, source_id: 50, search_text: "Composite User Activity Score (CUAS) calculation_knowledge Integrates multiple user activity metrics into one composite score. CUAS = \\frac{UER + UDS + USV}{3}, where UER is the User Engagement Rate, UDS is the User Demographic Score, and USV is the User Subscription Value."};
MERGE (n:Knowledge:SemanticSearch {id: "news:51"}) SET n = {id: "news:51", name: "Performance Status", type: "domain_knowledge", description: "Categorizes system records based on response time into Critical, Warning, or Normal bands.", definition: "A CASE-based classification where resptime > 200 is 'Critical', >150 is 'Warning', and others are 'Normal'.", source_file: "news_kb.jsonl", source_line: 52, source_id: 51, search_text: "Performance Status domain_knowledge Categorizes system records based on response time into Critical, Warning, or Normal bands. A CASE-based classification where resptime > 200 is 'Critical', >150 is 'Warning', and others are 'Normal'."};
MERGE (n:Knowledge:SemanticSearch {id: "news:52"}) SET n = {id: "news:52", name: "Bounce Percentile", type: "calculation_knowledge", description: "Ranks sessions by their adjusted bounce rate relative to all other sessions.", definition: "A percentile ranking computed using PERCENT_RANK() over all sessions ordered by adjusted_bounce_rate.", source_file: "news_kb.jsonl", source_line: 53, source_id: 52, search_text: "Bounce Percentile calculation_knowledge Ranks sessions by their adjusted bounce rate relative to all other sessions. A percentile ranking computed using PERCENT_RANK() over all sessions ordered by adjusted_bounce_rate."};
MERGE (n:Knowledge:SemanticSearch {id: "news:53"}) SET n = {id: "news:53", name: "CTR Percentile", type: "calculation_knowledge", description: "Ranks sessions by their click-through rate relative to all other sessions.", definition: "A percentile ranking computed using PERCENT_RANK() over all sessions ordered by ctrval in descending order.", source_file: "news_kb.jsonl", source_line: 54, source_id: 53, search_text: "CTR Percentile calculation_knowledge Ranks sessions by their click-through rate relative to all other sessions. A percentile ranking computed using PERCENT_RANK() over all sessions ordered by ctrval in descending order."};
MERGE (n:Knowledge:SemanticSearch {id: "news:54"}) SET n = {id: "news:54", name: "Performance Segment", type: "domain_knowledge", description: "Categorizes sessions based on their relative bounce rate and CTR performance using percentile rankings.", definition: "A classification of sessions into performance categories based on specific percentile criteria: 'High Bounce, Low CTR' (bounce_percentile < 0.25, ctr_percentile < 0.25), 'High Bounce, High CTR' (bounce_percentile < 0.25, ctr_percentile >= 0.75), 'Low Bounce, Low CTR' (bounce_percentile >= 0.75, ctr_percentile < 0.25), 'Low Bounce, High CTR' (bounce_percentile >= 0.75, ctr_percentile >= 0.75), or 'Average Performance' for all other combinations.", source_file: "news_kb.jsonl", source_line: 55, source_id: 54, search_text: "Performance Segment domain_knowledge Categorizes sessions based on their relative bounce rate and CTR performance using percentile rankings. A classification of sessions into performance categories based on specific percentile criteria: 'High Bounce, Low CTR' (bounce_percentile < 0.25, ctr_percentile < 0.25), 'High Bounce, High CTR' (bounce_percentile < 0.25, ctr_percentile >= 0.75), 'Low Bounce, Low CTR' (bounce_percentile >= 0.75, ctr_percentile < 0.25), 'Low Bounce, High CTR' (bounce_percentile >= 0.75, ctr_percentile >= 0.75), or 'Average Performance' for all other combinations."};
MERGE (n:Knowledge:SemanticSearch {id: "news:55"}) SET n = {id: "news:55", name: "Cohort Percentage", type: "calculation_knowledge", description: "Calculates the proportional representation of each test group within monthly registration cohorts", definition: "(Group registrations / Total monthly registrations) * 100", source_file: "news_kb.jsonl", source_line: 56, source_id: 55, search_text: "Cohort Percentage calculation_knowledge Calculates the proportional representation of each test group within monthly registration cohorts (Group registrations / Total monthly registrations) * 100"};
MERGE (n:Knowledge:SemanticSearch {id: "news:56"}) SET n = {id: "news:56", name: "Readability Weight Mapping", type: "domain_knowledge", description: "Defines difficulty-based weighting for readability calculations.", definition: "Difficulty levels are assigned weights: Basic = 1, Intermediate = 1.5, Advanced = 2, Others = 1.2.", source_file: "news_kb.jsonl", source_line: 57, source_id: 56, search_text: "Readability Weight Mapping domain_knowledge Defines difficulty-based weighting for readability calculations. Difficulty levels are assigned weights: Basic = 1, Intermediate = 1.5, Advanced = 2, Others = 1.2."};
MERGE (n:Knowledge:SemanticSearch {id: "news:57"}) SET n = {id: "news:57", name: "Readability Segmentation", type: "domain_knowledge", description: "Classifies articles into readability categories based on calculated readability scores.", definition: "Low readability: ARS < 50, Medium readability: 50 ≤ ARS ≤ 100, High readability: ARS > 100.", source_file: "news_kb.jsonl", source_line: 58, source_id: 57, search_text: "Readability Segmentation domain_knowledge Classifies articles into readability categories based on calculated readability scores. Low readability: ARS < 50, Medium readability: 50 ≤ ARS ≤ 100, High readability: ARS > 100."};
MERGE (n:Knowledge:SemanticSearch {id: "news:58"}) SET n = {id: "news:58", name: "Recommendation Click-Through Rate (RCTR)", type: "calculation_knowledge", description: "Defines RCTR as the ratio of clicks to total recommendations.", definition: "RCTR = (clicks / recommendations) when recommendations are greater than zero.", source_file: "news_kb.jsonl", source_line: 59, source_id: 58, search_text: "Recommendation Click-Through Rate (RCTR) calculation_knowledge Defines RCTR as the ratio of clicks to total recommendations. RCTR = (clicks / recommendations) when recommendations are greater than zero."};
MERGE (n:Knowledge:SemanticSearch {id: "news:59"}) SET n = {id: "news:59", name: "Elite User Interaction Metric (EUIM)", type: "calculation_knowledge", description: "A newly defined metric to identify elite user interactions by combining session clicks, views, and engagement score.", definition: "EUIM = (seshclicks + seshviews) * (engscore / 100), where a higher value indicates more elite or intense user interaction.", source_file: "news_kb.jsonl", source_line: 60, source_id: 59, search_text: "Elite User Interaction Metric (EUIM) calculation_knowledge A newly defined metric to identify elite user interactions by combining session clicks, views, and engagement score. EUIM = (seshclicks + seshviews) * (engscore / 100), where a higher value indicates more elite or intense user interaction."};
MERGE (n:Knowledge:SemanticSearch {id: "news:60"}) SET n = {id: "news:60", name: "Interaction Default Values", type: "value_illustration", description: "A standardized set of initial values assigned to interaction behavior metrics when a new interaction record is created.", definition: "A JSON structure: jsonb_build_object('scroll', jsonb_build_object('depth', 0, 'speed', 0.0, 'percentage', 0), 'exit_type', 'Natural', 'conversion', jsonb_build_object('value', 0, 'status', 'None'), 'time_spent', jsonb_build_object('viewport_time', 0, 'attention_time', 0, 'reading_seconds', 0, 'duration_seconds', 0), 'next_action', 'None', 'bounce_status', 'No', 'click_seconds', 0)", source_file: "news_kb.jsonl", source_line: 61, source_id: 60, search_text: "Interaction Default Values value_illustration A standardized set of initial values assigned to interaction behavior metrics when a new interaction record is created. A JSON structure: jsonb_build_object('scroll', jsonb_build_object('depth', 0, 'speed', 0.0, 'percentage', 0), 'exit_type', 'Natural', 'conversion', jsonb_build_object('value', 0, 'status', 'None'), 'time_spent', jsonb_build_object('viewport_time', 0, 'attention_time', 0, 'reading_seconds', 0, 'duration_seconds', 0), 'next_action', 'None', 'bounce_status', 'No', 'click_seconds', 0)"};
MATCH (d:Database {id: "polar"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "polar:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "polar:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "polar:" AND NOT stale.id IN ["polar:0", "polar:1", "polar:2", "polar:3", "polar:4", "polar:5", "polar:6", "polar:7", "polar:8", "polar:9", "polar:10", "polar:11", "polar:12", "polar:13", "polar:14", "polar:15", "polar:16", "polar:17", "polar:18", "polar:19", "polar:20", "polar:21", "polar:22", "polar:23", "polar:24", "polar:25", "polar:26", "polar:27", "polar:28", "polar:29", "polar:30", "polar:31", "polar:32", "polar:33", "polar:34", "polar:35", "polar:36", "polar:37", "polar:38", "polar:39", "polar:40", "polar:41", "polar:42", "polar:43", "polar:44", "polar:45", "polar:46", "polar:47", "polar:48", "polar:49", "polar:50", "polar:51", "polar:52", "polar:53"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "polar:0"}) SET n = {id: "polar:0", name: "Equipment Efficiency Rating (EER)", type: "calculation_knowledge", description: "A composite metric that evaluates the overall efficiency of equipment based on performance, reliability, and environmental impact.", definition: "EER = \\frac{performanceindex + reliabilityindex}{2} \\times (1 - \\frac{environmentalimpactindex}{10}), \\text{ where higher values indicate more efficient equipment with better performance and lower environmental impact.}", source_file: "polar_kb.jsonl", source_line: 1, source_id: 0, search_text: "Equipment Efficiency Rating (EER) calculation_knowledge A composite metric that evaluates the overall efficiency of equipment based on performance, reliability, and environmental impact. EER = \\frac{performanceindex + reliabilityindex}{2} \\times (1 - \\frac{environmentalimpactindex}{10}), \\text{ where higher values indicate more efficient equipment with better performance and lower environmental impact.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:1"}) SET n = {id: "polar:1", name: "Operational Readiness Score (ORS)", type: "calculation_knowledge", description: "Quantifies how ready equipment is for immediate deployment based on operational status and maintenance schedule.", definition: "ORS = \\begin{cases} 10 \\times (1 - \\frac{operationhours}{maintenancecyclehours}) & \\text{if operationalstatus = 'Active'} \\\\ 5 \\times (1 - \\frac{operationhours}{maintenancecyclehours}) & \\text{if operationalstatus = 'Standby'} \\\\ 0 & \\text{otherwise} \\end{cases}", source_file: "polar_kb.jsonl", source_line: 2, source_id: 1, search_text: "Operational Readiness Score (ORS) calculation_knowledge Quantifies how ready equipment is for immediate deployment based on operational status and maintenance schedule. ORS = \\begin{cases} 10 \\times (1 - \\frac{operationhours}{maintenancecyclehours}) & \\text{if operationalstatus = 'Active'} \\\\ 5 \\times (1 - \\frac{operationhours}{maintenancecyclehours}) & \\text{if operationalstatus = 'Standby'} \\\\ 0 & \\text{otherwise} \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:2"}) SET n = {id: "polar:2", name: "Energy Sustainability Index (ESI)", type: "calculation_knowledge", description: "Measures the sustainability of an equipment's energy usage by evaluating energy efficiency and renewable sources.", definition: "ESI = energyefficiencypercent \\times \\begin{cases} 1.5 & \\text{if powersource IN ('Solar', 'Wind')} \\\\ 1.2 & \\text{if powersource = 'Hybrid'} \\\\ 1.0 & \\text{if powersource = 'Battery'} \\\\ 0.7 & \\text{if powersource = 'Diesel'} \\\\ 0 & \\text{otherwise} \\end{cases}, \\text{ providing higher ratings for renewable energy and lower ratings for fossil fuels.}", source_file: "polar_kb.jsonl", source_line: 3, source_id: 2, search_text: "Energy Sustainability Index (ESI) calculation_knowledge Measures the sustainability of an equipment's energy usage by evaluating energy efficiency and renewable sources. ESI = energyefficiencypercent \\times \\begin{cases} 1.5 & \\text{if powersource IN ('Solar', 'Wind')} \\\\ 1.2 & \\text{if powersource = 'Hybrid'} \\\\ 1.0 & \\text{if powersource = 'Battery'} \\\\ 0.7 & \\text{if powersource = 'Diesel'} \\\\ 0 & \\text{otherwise} \\end{cases}, \\text{ providing higher ratings for renewable energy and lower ratings for fossil fuels.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:3"}) SET n = {id: "polar:3", name: "Structural Safety Factor (SSF)", type: "calculation_knowledge", description: "Evaluates the safety margin of structures under extreme weather conditions.", definition: "SSF = \\frac{100 - structuralloadpercent}{100} \\times \\begin{cases} 0.5 & \\text{if snowloadkgm2 > 100 or windspeedms > 20} \\\\ 0.8 & \\text{if snowloadkgm2 > 50 or windspeedms > 10} \\\\ 1.0 & \\text{otherwise} \\end{cases}", source_file: "polar_kb.jsonl", source_line: 4, source_id: 3, search_text: "Structural Safety Factor (SSF) calculation_knowledge Evaluates the safety margin of structures under extreme weather conditions. SSF = \\frac{100 - structuralloadpercent}{100} \\times \\begin{cases} 0.5 & \\text{if snowloadkgm2 > 100 or windspeedms > 20} \\\\ 0.8 & \\text{if snowloadkgm2 > 50 or windspeedms > 10} \\\\ 1.0 & \\text{otherwise} \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:4"}) SET n = {id: "polar:4", name: "Communication Reliability Index (CRI)", type: "calculation_knowledge", description: "Assesses the reliability of communication systems based on signal metrics and antenna status.", definition: "CRI = \\begin{cases} 0 & \\text{if antennastatus = 'Error'} \\\\ 5 & \\text{if antennastatus = 'Warning'} \\\\ 10 & \\text{if antennastatus = 'Normal'} \\\\ 0 & \\text{otherwise} \\end{cases} \\times (1 - \\frac{signalmetrics.latency\\_ms}{1000}), \\text{ where lower latency and better antenna status result in higher reliability.}", source_file: "polar_kb.jsonl", source_line: 5, source_id: 4, search_text: "Communication Reliability Index (CRI) calculation_knowledge Assesses the reliability of communication systems based on signal metrics and antenna status. CRI = \\begin{cases} 0 & \\text{if antennastatus = 'Error'} \\\\ 5 & \\text{if antennastatus = 'Warning'} \\\\ 10 & \\text{if antennastatus = 'Normal'} \\\\ 0 & \\text{otherwise} \\end{cases} \\times (1 - \\frac{signalmetrics.latency\\_ms}{1000}), \\text{ where lower latency and better antenna status result in higher reliability.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:5"}) SET n = {id: "polar:5", name: "Vehicle Performance Coefficient (VPC)", type: "calculation_knowledge", description: "A metric that evaluates vehicle performance based on mechanical condition and operational efficiency.", definition: "VPC = (1 - \\frac{brakepadwearpercent + trackwearpercent}{200}) \\times \\frac{vehiclespeedkmh}{50} \\times \\frac{engineloadpercent}{100}, \\text{ where lower wear percentages and optimal engine load contribute to better performance.}", source_file: "polar_kb.jsonl", source_line: 6, source_id: 5, search_text: "Vehicle Performance Coefficient (VPC) calculation_knowledge A metric that evaluates vehicle performance based on mechanical condition and operational efficiency. VPC = (1 - \\frac{brakepadwearpercent + trackwearpercent}{200}) \\times \\frac{vehiclespeedkmh}{50} \\times \\frac{engineloadpercent}{100}, \\text{ where lower wear percentages and optimal engine load contribute to better performance.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:6"}) SET n = {id: "polar:6", name: "Thermal Insulation Efficiency (TIE)", type: "calculation_knowledge", description: "Measures how effectively a structure retains heat based on insulation status and heat loss rate.", definition: "TIE = \\begin{cases} 0.9 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = 'Good'} \\\\ 0.6 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = 'Fair'} \\\\ 0.3 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = 'Poor'} \\end{cases}, \\text{ where lower heat loss and better insulation result in higher efficiency.}", source_file: "polar_kb.jsonl", source_line: 7, source_id: 6, search_text: "Thermal Insulation Efficiency (TIE) calculation_knowledge Measures how effectively a structure retains heat based on insulation status and heat loss rate. TIE = \\begin{cases} 0.9 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = 'Good'} \\\\ 0.6 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = 'Fair'} \\\\ 0.3 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = 'Poor'} \\end{cases}, \\text{ where lower heat loss and better insulation result in higher efficiency.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:7"}) SET n = {id: "polar:7", name: "Water Resource Management Index (WRMI)", type: "calculation_knowledge", description: "Evaluates the efficiency of water resource management based on water levels, quality, and waste levels.", definition: "WRMI = waterlevelpercent \\times \\frac{waterqualityindex}{100} \\times (1 - \\frac{wastetanklevelpercent}{100}), \\text{ where higher water quality and appropriate water/waste levels indicate better management.}", source_file: "polar_kb.jsonl", source_line: 8, source_id: 7, search_text: "Water Resource Management Index (WRMI) calculation_knowledge Evaluates the efficiency of water resource management based on water levels, quality, and waste levels. WRMI = waterlevelpercent \\times \\frac{waterqualityindex}{100} \\times (1 - \\frac{wastetanklevelpercent}{100}), \\text{ where higher water quality and appropriate water/waste levels indicate better management.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:8"}) SET n = {id: "polar:8", name: "Scientific Equipment Reliability (SER)", type: "calculation_knowledge", description: "Quantifies the reliability of scientific equipment based on calibration status and measurement accuracy.", definition: "SER = measurementaccuracypercent \\times \\begin{cases} 1.0 & \\text{if calibrationstatus = 'Valid'} \\\\ 0.7 & \\text{if calibrationstatus = 'Due'} \\\\ 0.3 & \\text{if calibrationstatus = 'Expired'} \\end{cases}, \\text{ where valid calibration and high accuracy result in more reliable scientific data.}", source_file: "polar_kb.jsonl", source_line: 9, source_id: 8, search_text: "Scientific Equipment Reliability (SER) calculation_knowledge Quantifies the reliability of scientific equipment based on calibration status and measurement accuracy. SER = measurementaccuracypercent \\times \\begin{cases} 1.0 & \\text{if calibrationstatus = 'Valid'} \\\\ 0.7 & \\text{if calibrationstatus = 'Due'} \\\\ 0.3 & \\text{if calibrationstatus = 'Expired'} \\end{cases}, \\text{ where valid calibration and high accuracy result in more reliable scientific data.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:9"}) SET n = {id: "polar:9", name: "Renewable Energy Contribution (REC)", type: "calculation_knowledge", description: "Calculates the percentage contribution of renewable energy sources to the total power generation.", definition: "REC = \\frac{renewablemetrics.solar.output\\_w + renewablemetrics.wind.output\\_w}{fuelcelloutputw + renewablemetrics.solar.output\\_w + renewablemetrics.wind.output\\_w} \\times 100, \\text{ where higher values indicate greater reliance on renewable energy.}", source_file: "polar_kb.jsonl", source_line: 10, source_id: 9, search_text: "Renewable Energy Contribution (REC) calculation_knowledge Calculates the percentage contribution of renewable energy sources to the total power generation. REC = \\frac{renewablemetrics.solar.output\\_w + renewablemetrics.wind.output\\_w}{fuelcelloutputw + renewablemetrics.solar.output\\_w + renewablemetrics.wind.output\\_w} \\times 100, \\text{ where higher values indicate greater reliance on renewable energy.}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:10"}) SET n = {id: "polar:10", name: "Extreme Weather Readiness (EWR)", type: "domain_knowledge", description: "Evaluates how prepared equipment and structures are for extreme weather conditions.", definition: "A composite rating where equipment is considered 'Extreme Weather Ready' if it maintains an SSF > 0.7 and has operational heating systems (heaterstatus not 'Off'), proper insulation (insulationstatus not 'Poor'), and functional emergency systems (emergencylightstatus = 'On' or 'Testing').", source_file: "polar_kb.jsonl", source_line: 11, source_id: 10, search_text: "Extreme Weather Readiness (EWR) domain_knowledge Evaluates how prepared equipment and structures are for extreme weather conditions. A composite rating where equipment is considered 'Extreme Weather Ready' if it maintains an SSF > 0.7 and has operational heating systems (heaterstatus not 'Off'), proper insulation (insulationstatus not 'Poor'), and functional emergency systems (emergencylightstatus = 'On' or 'Testing')."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:11"}) SET n = {id: "polar:11", name: "Critical Equipment", type: "domain_knowledge", description: "Identifies equipment that is essential for life support and safety in polar environments.", definition: "Equipment is designated as 'Critical' if it belongs to the 'Safety' equipment type, has a safety index > 0.8, and is associated with any of these life-critical systems: lifesupportstatus, oxygensupplystatus, or heater systems where temperatures are below freezing (externaltemperaturec < 0).", source_file: "polar_kb.jsonl", source_line: 12, source_id: 11, search_text: "Critical Equipment domain_knowledge Identifies equipment that is essential for life support and safety in polar environments. Equipment is designated as 'Critical' if it belongs to the 'Safety' equipment type, has a safety index > 0.8, and is associated with any of these life-critical systems: lifesupportstatus, oxygensupplystatus, or heater systems where temperatures are below freezing (externaltemperaturec < 0)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:12"}) SET n = {id: "polar:12", name: "Maintenance Priority Level", type: "domain_knowledge", description: "Classifies equipment based on the urgency of required maintenance.", definition: "Equipment is categorized into maintenance priority levels: 'Immediate Attention' (operationhours > maintenancecyclehours OR operationalstatus = 'Repair'), 'Scheduled Service' (operationhours > 0.8 * maintenancecyclehours), and 'Routine Maintenance' (all other cases), helping prioritize resource allocation.", source_file: "polar_kb.jsonl", source_line: 13, source_id: 12, search_text: "Maintenance Priority Level domain_knowledge Classifies equipment based on the urgency of required maintenance. Equipment is categorized into maintenance priority levels: 'Immediate Attention' (operationhours > maintenancecyclehours OR operationalstatus = 'Repair'), 'Scheduled Service' (operationhours > 0.8 * maintenancecyclehours), and 'Routine Maintenance' (all other cases), helping prioritize resource allocation."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:13"}) SET n = {id: "polar:13", name: "Energy Sustainability Classification", type: "domain_knowledge", description: "Categories equipment based on their energy sustainability index for environmental impact assessment.", definition: "Equipment is classified as 'Green' (ESI > 0.8), 'Intermediate' (ESI between 0.4 and 0.8), or 'High Impact' (ESI < 0.4), with Green indicating environmentally sustainable operations.", source_file: "polar_kb.jsonl", source_line: 14, source_id: 13, search_text: "Energy Sustainability Classification domain_knowledge Categories equipment based on their energy sustainability index for environmental impact assessment. Equipment is classified as 'Green' (ESI > 0.8), 'Intermediate' (ESI between 0.4 and 0.8), or 'High Impact' (ESI < 0.4), with Green indicating environmentally sustainable operations."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:14"}) SET n = {id: "polar:14", name: "Communication Zone Status", type: "domain_knowledge", description: "Evaluates the communication coverage and reliability in different operational zones.", definition: "A zone is classified as having 'Reliable Coverage' when equipment within it maintains a CRI > 7, has active satellite connections (signalmetrics.satellite_status = 'Connected'), and supports emergency beacon functionality (emergencybeaconstatus != 'Inactive').", source_file: "polar_kb.jsonl", source_line: 15, source_id: 14, search_text: "Communication Zone Status domain_knowledge Evaluates the communication coverage and reliability in different operational zones. A zone is classified as having 'Reliable Coverage' when equipment within it maintains a CRI > 7, has active satellite connections (signalmetrics.satellite_status = 'Connected'), and supports emergency beacon functionality (emergencybeaconstatus != 'Inactive')."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:15"}) SET n = {id: "polar:15", name: "Vehicle Operational Safety Threshold", type: "domain_knowledge", description: "Defines the safety threshold for vehicle operations based on multiple safety factors.", definition: "A vehicle is considered 'Safe for Operation' when it maintains a VPC > 0.6, has brake fluid levels above 50%, brake pad wear below 70%, adequate tire pressure (tiremetrics.pressure_kpa > 200), and is operated within recommended load limits (vehicleloadkg within manufacturer specifications).", source_file: "polar_kb.jsonl", source_line: 16, source_id: 15, search_text: "Vehicle Operational Safety Threshold domain_knowledge Defines the safety threshold for vehicle operations based on multiple safety factors. A vehicle is considered 'Safe for Operation' when it maintains a VPC > 0.6, has brake fluid levels above 50%, brake pad wear below 70%, adequate tire pressure (tiremetrics.pressure_kpa > 200), and is operated within recommended load limits (vehicleloadkg within manufacturer specifications)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:16"}) SET n = {id: "polar:16", name: "Scientific Data Reliability Classification", type: "domain_knowledge", description: "Classifies scientific data based on equipment reliability and calibration status.", definition: "Scientific data is classified as 'Research Grade' when collected by equipment with SER > 0.9, with valid calibration status, and under appropriate environmental conditions for the equipment type.", source_file: "polar_kb.jsonl", source_line: 17, source_id: 16, search_text: "Scientific Data Reliability Classification domain_knowledge Classifies scientific data based on equipment reliability and calibration status. Scientific data is classified as 'Research Grade' when collected by equipment with SER > 0.9, with valid calibration status, and under appropriate environmental conditions for the equipment type."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:17"}) SET n = {id: "polar:17", name: "Cabin Habitability Standard", type: "domain_knowledge", description: "Defines the minimum standards for habitable cabin conditions in polar environments.", definition: "A cabin meets 'Habitability Standards' when it maintains internal temperature (cabinclimate.temperature_c) between 18-24°C, oxygen levels (cabinclimate.o2_percent) above 19.5%, CO2 levels (cabinclimate.co2_ppm) below 1000 ppm, functioning ventilation systems, and operational heating systems.", source_file: "polar_kb.jsonl", source_line: 18, source_id: 17, search_text: "Cabin Habitability Standard domain_knowledge Defines the minimum standards for habitable cabin conditions in polar environments. A cabin meets 'Habitability Standards' when it maintains internal temperature (cabinclimate.temperature_c) between 18-24°C, oxygen levels (cabinclimate.o2_percent) above 19.5%, CO2 levels (cabinclimate.co2_ppm) below 1000 ppm, functioning ventilation systems, and operational heating systems."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:18"}) SET n = {id: "polar:18", name: "Water Conservation Requirement", type: "domain_knowledge", description: "Specifies the conditions under which water conservation measures must be implemented.", definition: "Water conservation measures must be implemented when the WRMI falls below 0.5, indicating either low water levels, poor water quality, or high waste tank levels that require immediate attention to maintain sustainable water usage.", source_file: "polar_kb.jsonl", source_line: 19, source_id: 18, search_text: "Water Conservation Requirement domain_knowledge Specifies the conditions under which water conservation measures must be implemented. Water conservation measures must be implemented when the WRMI falls below 0.5, indicating either low water levels, poor water quality, or high waste tank levels that require immediate attention to maintain sustainable water usage."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:19"}) SET n = {id: "polar:19", name: "Sustainable Energy Operation", type: "domain_knowledge", description: "Defines the conditions for energy-sustainable operations in polar environments.", definition: "An operation is considered 'Energy-Sustainable' when it maintains a REC above 70% (meaning more than 70% of energy comes from renewable sources) while maintaining full operational capability and adequate power reserves for at least 48 hours in case of emergency.", source_file: "polar_kb.jsonl", source_line: 20, source_id: 19, search_text: "Sustainable Energy Operation domain_knowledge Defines the conditions for energy-sustainable operations in polar environments. An operation is considered 'Energy-Sustainable' when it maintains a REC above 70% (meaning more than 70% of energy comes from renewable sources) while maintaining full operational capability and adequate power reserves for at least 48 hours in case of emergency."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:20"}) SET n = {id: "polar:20", name: "reliabilityindex", type: "value_illustration", description: "Illustrates the significance of reliability index measurements in equipment durability.", definition: "The reliability index typically ranges from 0 to 1, where values below 0.5 indicate equipment that fails frequently and requires constant maintenance, values between 0.5-0.8 represent equipment with occasional failures that require regular maintenance, and values above 0.8 indicate highly reliable equipment with minimal downtime.", source_file: "polar_kb.jsonl", source_line: 21, source_id: 20, search_text: "reliabilityindex value_illustration Illustrates the significance of reliability index measurements in equipment durability. The reliability index typically ranges from 0 to 1, where values below 0.5 indicate equipment that fails frequently and requires constant maintenance, values between 0.5-0.8 represent equipment with occasional failures that require regular maintenance, and values above 0.8 indicate highly reliable equipment with minimal downtime."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:21"}) SET n = {id: "polar:21", name: "operationhours", type: "value_illustration", description: "Illustrates the meaning and importance of equipment operation hours.", definition: "Operation hours represent the cumulative time an equipment has been in active use. New equipment typically has low hours (0-100), mid-life equipment shows moderate hours (100-1000), while equipment approaching maintenance or replacement typically exceeds 1000 hours. The ratio of operation hours to maintenance cycle hours is critical for preventative maintenance scheduling.", source_file: "polar_kb.jsonl", source_line: 22, source_id: 21, search_text: "operationhours value_illustration Illustrates the meaning and importance of equipment operation hours. Operation hours represent the cumulative time an equipment has been in active use. New equipment typically has low hours (0-100), mid-life equipment shows moderate hours (100-1000), while equipment approaching maintenance or replacement typically exceeds 1000 hours. The ratio of operation hours to maintenance cycle hours is critical for preventative maintenance scheduling."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:22"}) SET n = {id: "polar:22", name: "externaltemperaturec", type: "value_illustration", description: "Illustrates the significance of external temperature readings in polar environments.", definition: "External temperature in polar regions typically ranges from -70°C to 10°C. Temperatures below -40°C represent extreme cold requiring special equipment protection measures, -20°C to -40°C require standard cold weather protocols, while temperatures above -20°C are considered relatively mild for polar operations but still require normal cold weather precautions.", source_file: "polar_kb.jsonl", source_line: 23, source_id: 22, search_text: "externaltemperaturec value_illustration Illustrates the significance of external temperature readings in polar environments. External temperature in polar regions typically ranges from -70°C to 10°C. Temperatures below -40°C represent extreme cold requiring special equipment protection measures, -20°C to -40°C require standard cold weather protocols, while temperatures above -20°C are considered relatively mild for polar operations but still require normal cold weather precautions."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:23"}) SET n = {id: "polar:23", name: "windspeedms", type: "value_illustration", description: "Illustrates the impact of wind speed measurements on operations and safety.", definition: "Wind speeds in polar environments typically range from 0 to 60 m/s. Speeds below 5 m/s represent calm conditions, 5-15 m/s indicate moderate winds with minor operational impact, 15-25 m/s represent strong winds requiring additional safety measures, and speeds above 25 m/s indicate dangerous conditions that may require suspension of outdoor activities and securing of equipment.", source_file: "polar_kb.jsonl", source_line: 24, source_id: 23, search_text: "windspeedms value_illustration Illustrates the impact of wind speed measurements on operations and safety. Wind speeds in polar environments typically range from 0 to 60 m/s. Speeds below 5 m/s represent calm conditions, 5-15 m/s indicate moderate winds with minor operational impact, 15-25 m/s represent strong winds requiring additional safety measures, and speeds above 25 m/s indicate dangerous conditions that may require suspension of outdoor activities and securing of equipment."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:24"}) SET n = {id: "polar:24", name: "powerconsumptionw", type: "value_illustration", description: "Illustrates the significance of power consumption measurements in energy management.", definition: "Power consumption measured in watts varies by equipment type. Small scientific instruments typically consume 5-50W, communication equipment 20-200W, heating systems 500-5000W, and vehicle systems 1000-10000W. Understanding consumption patterns is crucial for power budgeting and determining appropriate power source sizing in isolated polar environments.", source_file: "polar_kb.jsonl", source_line: 25, source_id: 24, search_text: "powerconsumptionw value_illustration Illustrates the significance of power consumption measurements in energy management. Power consumption measured in watts varies by equipment type. Small scientific instruments typically consume 5-50W, communication equipment 20-200W, heating systems 500-5000W, and vehicle systems 1000-10000W. Understanding consumption patterns is crucial for power budgeting and determining appropriate power source sizing in isolated polar environments."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:25"}) SET n = {id: "polar:25", name: "Water Quality Classification System (WQCS)", type: "domain_knowledge", description: "A standardized system that categorizes water quality for health, safety, and operational purposes in polar environments.", definition: "Water is classified into five quality categories based on its quality index: 'High-Quality' WHEN (waterqualityindex >= 91), suitable for all purposes including direct consumption; 'Good' WHEN (waterqualityindex >= 71 AND waterqualityindex < 91), safe for consumption after standard treatment; 'Moderate' WHEN (waterqualityindex >= 51 AND waterqualityindex < 71), acceptable for washing but not consumption; 'Poor' WHEN (waterqualityindex >= 26 AND waterqualityindex < 51), suitable only for limited non-contact uses; 'Unsafe' WHEN (waterqualityindex < 26), unsuitable for any use and requiring immediate remediation.", source_file: "polar_kb.jsonl", source_line: 26, source_id: 25, search_text: "Water Quality Classification System (WQCS) domain_knowledge A standardized system that categorizes water quality for health, safety, and operational purposes in polar environments. Water is classified into five quality categories based on its quality index: 'High-Quality' WHEN (waterqualityindex >= 91), suitable for all purposes including direct consumption; 'Good' WHEN (waterqualityindex >= 71 AND waterqualityindex < 91), safe for consumption after standard treatment; 'Moderate' WHEN (waterqualityindex >= 51 AND waterqualityindex < 71), acceptable for washing but not consumption; 'Poor' WHEN (waterqualityindex >= 26 AND waterqualityindex < 51), suitable only for limited non-contact uses; 'Unsafe' WHEN (waterqualityindex < 26), unsuitable for any use and requiring immediate remediation."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:26"}) SET n = {id: "polar:26", name: "cabinclimate.co2_ppm", type: "value_illustration", description: "Illustrates the health and cognitive implications of carbon dioxide levels in enclosed environments.", definition: "CO2 levels in enclosed spaces like cabins are measured in parts per million (ppm). Levels below 600 ppm indicate excellent ventilation, 600-1000 ppm represent good air quality, 1000-2500 ppm indicate poor ventilation that may cause drowsiness and reduced cognitive function, while levels above 2500 ppm may cause headaches, sleepiness, and significantly impaired cognitive performance.", source_file: "polar_kb.jsonl", source_line: 27, source_id: 26, search_text: "cabinclimate.co2_ppm value_illustration Illustrates the health and cognitive implications of carbon dioxide levels in enclosed environments. CO2 levels in enclosed spaces like cabins are measured in parts per million (ppm). Levels below 600 ppm indicate excellent ventilation, 600-1000 ppm represent good air quality, 1000-2500 ppm indicate poor ventilation that may cause drowsiness and reduced cognitive function, while levels above 2500 ppm may cause headaches, sleepiness, and significantly impaired cognitive performance."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:27"}) SET n = {id: "polar:27", name: "energyefficiencypercent", type: "value_illustration", description: "Illustrates the meaning and importance of energy efficiency percentages.", definition: "Energy efficiency percentage typically ranges from 10% to 99%. Values below 30% indicate inefficient systems typical of older equipment, 30-60% represent standard efficiency for conventional equipment, 60-80% indicate high-efficiency modern systems, while values above 80% represent cutting-edge technology with optimal efficiency that minimizes energy waste and operational costs.", source_file: "polar_kb.jsonl", source_line: 28, source_id: 27, search_text: "energyefficiencypercent value_illustration Illustrates the meaning and importance of energy efficiency percentages. Energy efficiency percentage typically ranges from 10% to 99%. Values below 30% indicate inefficient systems typical of older equipment, 30-60% represent standard efficiency for conventional equipment, 60-80% indicate high-efficiency modern systems, while values above 80% represent cutting-edge technology with optimal efficiency that minimizes energy waste and operational costs."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:28"}) SET n = {id: "polar:28", name: "safetyindex", type: "value_illustration", description: "Illustrates the significance of safety index ratings for operational risk assessment.", definition: "Safety index typically ranges from 0 to 1, where values below 0.5 indicate equipment with significant safety concerns requiring immediate attention or limited operation, values between 0.5-0.7 represent equipment with acceptable safety for normal operations with appropriate precautions, and values above 0.7 indicate equipment with excellent safety features suitable for all operational conditions including those with elevated risks.", source_file: "polar_kb.jsonl", source_line: 29, source_id: 28, search_text: "safetyindex value_illustration Illustrates the significance of safety index ratings for operational risk assessment. Safety index typically ranges from 0 to 1, where values below 0.5 indicate equipment with significant safety concerns requiring immediate attention or limited operation, values between 0.5-0.7 represent equipment with acceptable safety for normal operations with appropriate precautions, and values above 0.7 indicate equipment with excellent safety features suitable for all operational conditions including those with elevated risks."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:29"}) SET n = {id: "polar:29", name: "fuelcellefficiencypercent", type: "value_illustration", description: "Illustrates the technical significance of fuel cell efficiency ratings.", definition: "Fuel cell efficiency percentages typically range from 40% to 90%. Values below 50% represent older or degraded fuel cell technology, 50-70% indicate standard efficiency modern fuel cells suitable for general applications, and values above 70% represent high-performance fuel cells with optimal conversion of chemical energy to electrical power with minimal waste heat generation.", source_file: "polar_kb.jsonl", source_line: 30, source_id: 29, search_text: "fuelcellefficiencypercent value_illustration Illustrates the technical significance of fuel cell efficiency ratings. Fuel cell efficiency percentages typically range from 40% to 90%. Values below 50% represent older or degraded fuel cell technology, 50-70% indicate standard efficiency modern fuel cells suitable for general applications, and values above 70% represent high-performance fuel cells with optimal conversion of chemical energy to electrical power with minimal waste heat generation."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:30"}) SET n = {id: "polar:30", name: "Overall Safety Performance Index (OSPI)", type: "calculation_knowledge", description: "Comprehensively evaluates equipment's overall safety performance based on safety index and equipment efficiency rating", definition: "OSPI = safetyindex × EER × 0.8", source_file: "polar_kb.jsonl", source_line: 31, source_id: 30, search_text: "Overall Safety Performance Index (OSPI) calculation_knowledge Comprehensively evaluates equipment's overall safety performance based on safety index and equipment efficiency rating OSPI = safetyindex × EER × 0.8"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:31"}) SET n = {id: "polar:31", name: "Polar Transportation Efficiency Coefficient (PTEC)", type: "calculation_knowledge", description: "Measures vehicle transportation efficiency in polar conditions, considering vehicle performance and energy sustainability", definition: "PTEC = VPC × (0.6 + 0.4 × ESI ÷ 100)", source_file: "polar_kb.jsonl", source_line: 32, source_id: 31, search_text: "Polar Transportation Efficiency Coefficient (PTEC) calculation_knowledge Measures vehicle transportation efficiency in polar conditions, considering vehicle performance and energy sustainability PTEC = VPC × (0.6 + 0.4 × ESI ÷ 100)"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:32"}) SET n = {id: "polar:32", name: "Base Station Communication Stability Index (BSCSI)", type: "calculation_knowledge", description: "Evaluates the stability and reliability of polar base station communication systems", definition: "BSCSI = CRI × (1 + 0.2 × signalmetrics.radio_strength_dbm ÷ 100) × (1 - 0.01 × (1000 - signalmetrics.latency_ms))", source_file: "polar_kb.jsonl", source_line: 33, source_id: 32, search_text: "Base Station Communication Stability Index (BSCSI) calculation_knowledge Evaluates the stability and reliability of polar base station communication systems BSCSI = CRI × (1 + 0.2 × signalmetrics.radio_strength_dbm ÷ 100) × (1 - 0.01 × (1000 - signalmetrics.latency_ms))"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:33"}) SET n = {id: "polar:33", name: "Life Support System Reliability (LSSR)", type: "calculation_knowledge", description: "Evaluates the reliability of life support systems under polar conditions", definition: "LSSR = 0.7 × ORS + 0.3 × TIE", source_file: "polar_kb.jsonl", source_line: 34, source_id: 33, search_text: "Life Support System Reliability (LSSR) calculation_knowledge Evaluates the reliability of life support systems under polar conditions LSSR = 0.7 × ORS + 0.3 × TIE"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:34"}) SET n = {id: "polar:34", name: "Scientific Mission Success Probability (SMSP)", type: "calculation_knowledge", description: "Predicts the probability of successful completion of scientific missions", definition: "SMSP = SER × (0.8 + 0.2 × CRI ÷ 10)", source_file: "polar_kb.jsonl", source_line: 35, source_id: 34, search_text: "Scientific Mission Success Probability (SMSP) calculation_knowledge Predicts the probability of successful completion of scientific missions SMSP = SER × (0.8 + 0.2 × CRI ÷ 10)"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:35"}) SET n = {id: "polar:35", name: "Resource Self-Sufficiency Index (RSSI)", type: "calculation_knowledge", description: "Measures a polar site's self-sufficiency in terms of resources", definition: "RSSI = 0.6 × REC + 0.4 × WRMI", source_file: "polar_kb.jsonl", source_line: 36, source_id: 35, search_text: "Resource Self-Sufficiency Index (RSSI) calculation_knowledge Measures a polar site's self-sufficiency in terms of resources RSSI = 0.6 × REC + 0.4 × WRMI"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:36"}) SET n = {id: "polar:36", name: "Extreme Climate Adaptation Coefficient (ECAC)", type: "calculation_knowledge", description: "Evaluates equipment adaptation capability under extreme climate conditions", definition: "ECAC = SSF × (1 + TIE × 0.5) × \\begin{cases} 0.7 & \\text{if externaltemperaturec < -30} \\\\ 0.85 & \\text{if externaltemperaturec < -15} \\\\ 1.0 & \\text{otherwise} \\end{cases}", source_file: "polar_kb.jsonl", source_line: 37, source_id: 36, search_text: "Extreme Climate Adaptation Coefficient (ECAC) calculation_knowledge Evaluates equipment adaptation capability under extreme climate conditions ECAC = SSF × (1 + TIE × 0.5) × \\begin{cases} 0.7 & \\text{if externaltemperaturec < -30} \\\\ 0.85 & \\text{if externaltemperaturec < -15} \\\\ 1.0 & \\text{otherwise} \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:37"}) SET n = {id: "polar:37", name: "Long-term Operational Stability Score (LOSS)", type: "calculation_knowledge", description: "Evaluates the stability of equipment during long-term operation", definition: "LOSS = 0.5 × EER + 0.5 × ORS × (1 - \\frac{operationhours}{20000})", source_file: "polar_kb.jsonl", source_line: 38, source_id: 37, search_text: "Long-term Operational Stability Score (LOSS) calculation_knowledge Evaluates the stability of equipment during long-term operation LOSS = 0.5 × EER + 0.5 × ORS × (1 - \\frac{operationhours}{20000})"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:38"}) SET n = {id: "polar:38", name: "Energy-Water Resource Integration Index (EWRII)", type: "calculation_knowledge", description: "Evaluates the integration efficiency of energy and water resource management", definition: "EWRII = 0.5 × ESI + 0.5 × WRMI × (1 - \\frac{heatertemperaturec}{100})", source_file: "polar_kb.jsonl", source_line: 39, source_id: 38, search_text: "Energy-Water Resource Integration Index (EWRII) calculation_knowledge Evaluates the integration efficiency of energy and water resource management EWRII = 0.5 × ESI + 0.5 × WRMI × (1 - \\frac{heatertemperaturec}{100})"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:39"}) SET n = {id: "polar:39", name: "Comprehensive Operational Reliability Indicator (CORI)", type: "calculation_knowledge", description: "Comprehensively assesses the overall reliability of polar equipment operations", definition: "CORI = 0.4 × EER + 0.4 × ORS + 0.2 × CRI", source_file: "polar_kb.jsonl", source_line: 40, source_id: 39, search_text: "Comprehensive Operational Reliability Indicator (CORI) calculation_knowledge Comprehensively assesses the overall reliability of polar equipment operations CORI = 0.4 × EER + 0.4 × ORS + 0.2 × CRI"};
MERGE (n:Knowledge:SemanticSearch {id: "polar:40"}) SET n = {id: "polar:40", name: "Extreme Operating Conditions (EOC)", type: "domain_knowledge", description: "Defines the extreme environmental conditions under which equipment can safely operate", definition: "Equipment is considered to 'operate safely under extreme conditions' when its SSF > 0.65 and ECAC > 0.8.", source_file: "polar_kb.jsonl", source_line: 41, source_id: 40, search_text: "Extreme Operating Conditions (EOC) domain_knowledge Defines the extreme environmental conditions under which equipment can safely operate Equipment is considered to 'operate safely under extreme conditions' when its SSF > 0.65 and ECAC > 0.8."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:41"}) SET n = {id: "polar:41", name: "Emergency Response Readiness Status (ERRS)", type: "domain_knowledge", description: "Assesses a polar site's preparedness to respond to emergency situations", definition: "A polar site is rated as 'emergency response ready' when its critical equipment maintains OSPI > 0.75 and LSSR > 0.8, with emergencycommunicationstatus = 'Operational' and backuppowerstatus = 'Active' and batterystatus.level_percent > 85.", source_file: "polar_kb.jsonl", source_line: 42, source_id: 41, search_text: "Emergency Response Readiness Status (ERRS) domain_knowledge Assesses a polar site's preparedness to respond to emergency situations A polar site is rated as 'emergency response ready' when its critical equipment maintains OSPI > 0.75 and LSSR > 0.8, with emergencycommunicationstatus = 'Operational' and backuppowerstatus = 'Active' and batterystatus.level_percent > 85."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:42"}) SET n = {id: "polar:42", name: "Sustainable Polar Operations (SPO)", type: "domain_knowledge", description: "Defines sustainability standards for polar operations", definition: "Polar operations are defined as 'sustainable' when the site maintains RSSI > 0.7 and EWRII > 0.65, with wastemanagementstatus = 'Normal' and environmentalimpactindex < 6.0.", source_file: "polar_kb.jsonl", source_line: 43, source_id: 42, search_text: "Sustainable Polar Operations (SPO) domain_knowledge Defines sustainability standards for polar operations Polar operations are defined as 'sustainable' when the site maintains RSSI > 0.7 and EWRII > 0.65, with wastemanagementstatus = 'Normal' and environmentalimpactindex < 6.0."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:43"}) SET n = {id: "polar:43", name: "Critical Scientific Equipment Status (CSES)", type: "domain_knowledge", description: "Determines the operational status and reliability of critical scientific equipment", definition: "Scientific equipment is classified as 'Fully Operational' (SER > 0.9 and SMSP > 0.85), 'Degraded Operation' (SER > 0.7 and SMSP > 0.6), or 'Needs Repair' (other cases).", source_file: "polar_kb.jsonl", source_line: 44, source_id: 43, search_text: "Critical Scientific Equipment Status (CSES) domain_knowledge Determines the operational status and reliability of critical scientific equipment Scientific equipment is classified as 'Fully Operational' (SER > 0.9 and SMSP > 0.85), 'Degraded Operation' (SER > 0.7 and SMSP > 0.6), or 'Needs Repair' (other cases)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:44"}) SET n = {id: "polar:44", name: "Polar Vehicle Safe Operation Conditions (PVSOC)", type: "domain_knowledge", description: "Determines the conditions for safe operation of polar vehicles", definition: "Polar vehicles are considered 'suitable for polar missions' when they maintain PTEC > 0.7 and VPC > 0.75, with operationalstatus = 'Active' and safetyindex ≥ 0.8.", source_file: "polar_kb.jsonl", source_line: 45, source_id: 44, search_text: "Polar Vehicle Safe Operation Conditions (PVSOC) domain_knowledge Determines the conditions for safe operation of polar vehicles Polar vehicles are considered 'suitable for polar missions' when they maintain PTEC > 0.7 and VPC > 0.75, with operationalstatus = 'Active' and safetyindex ≥ 0.8."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:45"}) SET n = {id: "polar:45", name: "Communication Network Resilience Assessment (CNRA)", type: "domain_knowledge", description: "Assesses the resilience and interference resistance of polar communication networks", definition: "Communication networks are assessed as having 'High Resilience' (CRI > 0.8 and BSCSI > 0.85), 'Medium Resilience' (CRI > 0.6 and BSCSI > 0.7), or 'Low Resilience' (other cases).", source_file: "polar_kb.jsonl", source_line: 46, source_id: 45, search_text: "Communication Network Resilience Assessment (CNRA) domain_knowledge Assesses the resilience and interference resistance of polar communication networks Communication networks are assessed as having 'High Resilience' (CRI > 0.8 and BSCSI > 0.85), 'Medium Resilience' (CRI > 0.6 and BSCSI > 0.7), or 'Low Resilience' (other cases)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:46"}) SET n = {id: "polar:46", name: "Critical Infrastructure Protection Level (CIPL)", type: "domain_knowledge", description: "Determines the protection level for polar critical infrastructure", definition: "Infrastructure is assigned protection level 'A' (SSF > 0.8, LOSS > 0.85, and OSPI > 0.9), 'B' (SSF > 0.7, LOSS > 0.75, and OSPI > 0.8), or 'C' (other cases).", source_file: "polar_kb.jsonl", source_line: 47, source_id: 46, search_text: "Critical Infrastructure Protection Level (CIPL) domain_knowledge Determines the protection level for polar critical infrastructure Infrastructure is assigned protection level 'A' (SSF > 0.8, LOSS > 0.85, and OSPI > 0.9), 'B' (SSF > 0.7, LOSS > 0.75, and OSPI > 0.8), or 'C' (other cases)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:47"}) SET n = {id: "polar:47", name: "Long-term Scientific Mission Viability (LSMV)", type: "domain_knowledge", description: "Assesses the viability of long-term scientific missions under polar conditions", definition: "Scientific missions are assessed as 'long-term viable' when all involved scientific equipment maintains SMSP > 0.8 and overall site operations maintain CORI > 0.75, with calibrationstatus = 'Valid' and dataloggingstatus = 'Active'.", source_file: "polar_kb.jsonl", source_line: 48, source_id: 47, search_text: "Long-term Scientific Mission Viability (LSMV) domain_knowledge Assesses the viability of long-term scientific missions under polar conditions Scientific missions are assessed as 'long-term viable' when all involved scientific equipment maintains SMSP > 0.8 and overall site operations maintain CORI > 0.75, with calibrationstatus = 'Valid' and dataloggingstatus = 'Active'."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:48"}) SET n = {id: "polar:48", name: "Polar Base Energy Security Status (PBESS)", type: "domain_knowledge", description: "Determines the security status of energy supply for polar bases", definition: "A polar base is assessed as being in an 'energy secure' state when it maintains REC > 65%, ESI > 0.7, and RSSI > 0.75, with batterystatus.level_percent > 75 and hydrogenlevelpercent > 70.", source_file: "polar_kb.jsonl", source_line: 49, source_id: 48, search_text: "Polar Base Energy Security Status (PBESS) domain_knowledge Determines the security status of energy supply for polar bases A polar base is assessed as being in an 'energy secure' state when it maintains REC > 65%, ESI > 0.7, and RSSI > 0.75, with batterystatus.level_percent > 75 and hydrogenlevelpercent > 70."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:49"}) SET n = {id: "polar:49", name: "Comprehensive Environmental Adaptability Rating (CEAR)", type: "domain_knowledge", description: "Assesses the overall adaptability of equipment and systems to the polar environment", definition: "Equipment and systems are rated as having 'Excellent Adaptability' (ECAC > 0.85 and SSF > 0.8 and thermalsolarwindandgrid.insulationstatus = 'Good'), 'Good Adaptability' (ECAC > 0.7 and SSF > 0.65 and thermalsolarwindandgrid.insulationstatus != 'Poor'), or 'Limited Adaptability' (other cases).", source_file: "polar_kb.jsonl", source_line: 50, source_id: 49, search_text: "Comprehensive Environmental Adaptability Rating (CEAR) domain_knowledge Assesses the overall adaptability of equipment and systems to the polar environment Equipment and systems are rated as having 'Excellent Adaptability' (ECAC > 0.85 and SSF > 0.8 and thermalsolarwindandgrid.insulationstatus = 'Good'), 'Good Adaptability' (ECAC > 0.7 and SSF > 0.65 and thermalsolarwindandgrid.insulationstatus != 'Poor'), or 'Limited Adaptability' (other cases)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:50"}) SET n = {id: "polar:50", name: "Extreme Weather Readiness Status (EWRS)", type: "domain_knowledge", description: "A binary classification system that determines if equipment has met all necessary conditions to safely operate during extreme weather events.", definition: "Equipment is classified as 'Extreme Weather Ready' WHEN (SSF > 0.7) AND (heaterstatus != 'Off') AND (insulationstatus != 'Poor') AND (emergencylightstatus IN ('On', 'Testing')); OTHERWISE equipment is classified as 'Not Ready'. This evaluation combines structural integrity checks with essential operational systems status to determine immediate readiness for extreme weather exposure.", source_file: "polar_kb.jsonl", source_line: 51, source_id: 50, search_text: "Extreme Weather Readiness Status (EWRS) domain_knowledge A binary classification system that determines if equipment has met all necessary conditions to safely operate during extreme weather events. Equipment is classified as 'Extreme Weather Ready' WHEN (SSF > 0.7) AND (heaterstatus != 'Off') AND (insulationstatus != 'Poor') AND (emergencylightstatus IN ('On', 'Testing')); OTHERWISE equipment is classified as 'Not Ready'. This evaluation combines structural integrity checks with essential operational systems status to determine immediate readiness for extreme weather exposure."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:51"}) SET n = {id: "polar:51", name: "Life Support Reliability Classification (LSRC)", type: "domain_knowledge", description: "Categorizes life support systems into reliability classes based on their LSSR score for operational decision-making.", definition: "Life support systems are classified into three reliability categories: 'High Reliability' WHEN (LSSR >= 0.8), 'Moderate Reliability' WHEN (LSSR >= 0.6 AND LSSR < 0.8), and 'Low Reliability' WHEN (LSSR < 0.6).", source_file: "polar_kb.jsonl", source_line: 52, source_id: 51, search_text: "Life Support Reliability Classification (LSRC) domain_knowledge Categorizes life support systems into reliability classes based on their LSSR score for operational decision-making. Life support systems are classified into three reliability categories: 'High Reliability' WHEN (LSSR >= 0.8), 'Moderate Reliability' WHEN (LSSR >= 0.6 AND LSSR < 0.8), and 'Low Reliability' WHEN (LSSR < 0.6)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:52"}) SET n = {id: "polar:52", name: "Energy Sustainability Classification System (ESCS)", type: "domain_knowledge", description: "A comprehensive classification system that categorizes operational energy sustainability based on renewable energy contribution percentages.", definition: "Operations are classified into three sustainability levels: 'Energy-Sustainable' WHEN (REC > 70); 'Moderately Sustainable' WHEN (REC > 50 AND REC <= 70); 'Low Sustainability' WHEN (REC <= 50).", source_file: "polar_kb.jsonl", source_line: 53, source_id: 52, search_text: "Energy Sustainability Classification System (ESCS) domain_knowledge A comprehensive classification system that categorizes operational energy sustainability based on renewable energy contribution percentages. Operations are classified into three sustainability levels: 'Energy-Sustainable' WHEN (REC > 70); 'Moderately Sustainable' WHEN (REC > 50 AND REC <= 70); 'Low Sustainability' WHEN (REC <= 50)."};
MERGE (n:Knowledge:SemanticSearch {id: "polar:53"}) SET n = {id: "polar:53", name: "Water Resource Management Status Classification (WRMSC)", type: "domain_knowledge", description: "A comprehensive classification system that categorizes water resource management status based on WRMI values to guide operational decisions.", definition: "Water management operations are classified into three status levels: 'Conservation Needed' WHEN (WRMI < 0.5), indicating critical resource limitations requiring immediate conservation measures; 'Monitoring Advised' WHEN (WRMI >= 0.5 AND WRMI < 0.7), representing adequate but vigilant management requiring regular system monitoring; 'Sustainable Management' WHEN (WRMI >= 0.7), indicating optimal water resource utilization suitable for unrestricted operations.", source_file: "polar_kb.jsonl", source_line: 54, source_id: 53, search_text: "Water Resource Management Status Classification (WRMSC) domain_knowledge A comprehensive classification system that categorizes water resource management status based on WRMI values to guide operational decisions. Water management operations are classified into three status levels: 'Conservation Needed' WHEN (WRMI < 0.5), indicating critical resource limitations requiring immediate conservation measures; 'Monitoring Advised' WHEN (WRMI >= 0.5 AND WRMI < 0.7), representing adequate but vigilant management requiring regular system monitoring; 'Sustainable Management' WHEN (WRMI >= 0.7), indicating optimal water resource utilization suitable for unrestricted operations."};
MATCH (d:Database {id: "robot"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "robot:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "robot:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "robot:" AND NOT stale.id IN ["robot:0", "robot:1", "robot:2", "robot:3", "robot:4", "robot:5", "robot:6", "robot:7", "robot:8", "robot:9", "robot:10", "robot:11", "robot:12", "robot:13", "robot:14", "robot:15", "robot:16", "robot:17", "robot:18", "robot:19", "robot:20", "robot:21", "robot:22", "robot:23", "robot:24", "robot:25", "robot:26", "robot:27", "robot:28", "robot:29", "robot:30", "robot:31", "robot:32", "robot:33", "robot:34", "robot:35", "robot:36", "robot:37", "robot:38", "robot:39", "robot:40", "robot:41", "robot:42", "robot:43", "robot:44", "robot:45", "robot:46", "robot:47", "robot:48", "robot:49", "robot:50", "robot:51", "robot:52", "robot:53", "robot:54", "robot:55", "robot:56", "robot:57", "robot:58", "robot:59"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "robot:0"}) SET n = {id: "robot:0", name: "Robot Age in Years (RAY)", type: "calculation_knowledge", description: "Calculates the age of the robot in years based on installation date and record timestamp.", definition: "For a given robot R, let D be the instdateval from robot_details where botdetreg = R, and T be the rects from robot_record where recreg = R. Then, RAY = \\frac{(T - D).days}{365.25}", source_file: "robot_kb.jsonl", source_line: 1, source_id: 0, search_text: "Robot Age in Years (RAY) calculation_knowledge Calculates the age of the robot in years based on installation date and record timestamp. For a given robot R, let D be the instdateval from robot_details where botdetreg = R, and T be the rects from robot_record where recreg = R. Then, RAY = \\frac{(T - D).days}{365.25}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:1"}) SET n = {id: "robot:1", name: "Average Joint 1 Temperature (AJ1T)", type: "calculation_knowledge", description: "Calculates the average temperature of Joint 1 across all operations for a specific robot.", definition: "For a given robot R, AJ1T = \\frac{\\sum_{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}} j1tempval}{|\\{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}\\}|}", source_file: "robot_kb.jsonl", source_line: 2, source_id: 1, search_text: "Average Joint 1 Temperature (AJ1T) calculation_knowledge Calculates the average temperature of Joint 1 across all operations for a specific robot. For a given robot R, AJ1T = \\frac{\\sum_{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}} j1tempval}{|\\{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}\\}|}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:2"}) SET n = {id: "robot:2", name: "Maximum Joint Temperature (MJT)", type: "calculation_knowledge", description: "Finds the maximum temperature recorded for any joint across all operations for a specific robot.", definition: "For a given robot R, MJT = \\max_{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}} \\max(jc.j1tempval, jc.j2tempval, jc.j3tempval, jc.j4tempval, jc.j5tempval, jc.j6tempval)", source_file: "robot_kb.jsonl", source_line: 3, source_id: 2, search_text: "Maximum Joint Temperature (MJT) calculation_knowledge Finds the maximum temperature recorded for any joint across all operations for a specific robot. For a given robot R, MJT = \\max_{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}} \\max(jc.j1tempval, jc.j2tempval, jc.j3tempval, jc.j4tempval, jc.j5tempval, jc.j6tempval)"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:3"}) SET n = {id: "robot:3", name: "Average Position Error (APE)", type: "calculation_knowledge", description: "Calculates the average position error across all actuations for a specific robot.", definition: "For a given robot R, APE = \\frac{\\sum_{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}} poserrmmval}{|\\{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}\\}|}", source_file: "robot_kb.jsonl", source_line: 4, source_id: 3, search_text: "Average Position Error (APE) calculation_knowledge Calculates the average position error across all actuations for a specific robot. For a given robot R, APE = \\frac{\\sum_{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}} poserrmmval}{|\\{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}\\}|}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:4"}) SET n = {id: "robot:4", name: "Average TCP Speed (ATCS)", type: "calculation_knowledge", description: "Calculates the average speed of the Tool Center Point across all actuations for a specific robot.", definition: "For a given robot R, ATCS = \\frac{\\sum_{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}} tcpspeedval}{|\\{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}\\}|}", source_file: "robot_kb.jsonl", source_line: 5, source_id: 4, search_text: "Average TCP Speed (ATCS) calculation_knowledge Calculates the average speed of the Tool Center Point across all actuations for a specific robot. For a given robot R, ATCS = \\frac{\\sum_{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}} tcpspeedval}{|\\{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}\\}|}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:5"}) SET n = {id: "robot:5", name: "Recent Fault Prediction Score (RFPS)", type: "calculation_knowledge", description: "The fault prediction score from the most recent maintenance record for a robot.", definition: "For a given robot R, \\text{faultpredscore}(mf) \\text{ where } mf \\in \\text{maintenance_and_fault}, \\text{upkeeprobot} = R, \\text{and } \\text{upkeepduedays}(mf) = \\min_{mf' \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot} = R} \\text{upkeepduedays}(mf').", source_file: "robot_kb.jsonl", source_line: 6, source_id: 5, search_text: "Recent Fault Prediction Score (RFPS) calculation_knowledge The fault prediction score from the most recent maintenance record for a robot. For a given robot R, \\text{faultpredscore}(mf) \\text{ where } mf \\in \\text{maintenance_and_fault}, \\text{upkeeprobot} = R, \\text{and } \\text{upkeepduedays}(mf) = \\min_{mf' \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot} = R} \\text{upkeepduedays}(mf')."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:6"}) SET n = {id: "robot:6", name: "Minimum Remaining Useful Life (MRUL)", type: "calculation_knowledge", description: "Finds the minimum Remaining Useful Life across all maintenance records for a specific robot.", definition: "For a given robot R, MRUL = \\min_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} rulhours", source_file: "robot_kb.jsonl", source_line: 7, source_id: 6, search_text: "Minimum Remaining Useful Life (MRUL) calculation_knowledge Finds the minimum Remaining Useful Life across all maintenance records for a specific robot. For a given robot R, MRUL = \\min_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} rulhours"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:7"}) SET n = {id: "robot:7", name: "Total Operating Hours (TOH)", type: "calculation_knowledge", description: "The maximum total operating hours recorded for the robot across all operations.", definition: "For a given robot R, TOH = \\max_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} totopshrval", source_file: "robot_kb.jsonl", source_line: 8, source_id: 7, search_text: "Total Operating Hours (TOH) calculation_knowledge The maximum total operating hours recorded for the robot across all operations. For a given robot R, TOH = \\max_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} totopshrval"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:8"}) SET n = {id: "robot:8", name: "Number of Operations (NO)", type: "calculation_knowledge", description: "Counts the number of operation records for a specific robot.", definition: "For a given robot R, NO = |\\{o \\in \\text{operation} \\mid \\text{operbotdetref = R}\\}|", source_file: "robot_kb.jsonl", source_line: 9, source_id: 8, search_text: "Number of Operations (NO) calculation_knowledge Counts the number of operation records for a specific robot. For a given robot R, NO = |\\{o \\in \\text{operation} \\mid \\text{operbotdetref = R}\\}|"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:9"}) SET n = {id: "robot:9", name: "Total Program Cycles (TPC)", type: "calculation_knowledge", description: "Sums the program cycle counts across all operations for a specific robot.", definition: "For a given robot R, TPC = \\sum_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} progcyclecount", source_file: "robot_kb.jsonl", source_line: 10, source_id: 9, search_text: "Total Program Cycles (TPC) calculation_knowledge Sums the program cycle counts across all operations for a specific robot. For a given robot R, TPC = \\sum_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} progcyclecount"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:10"}) SET n = {id: "robot:10", name: "Old Robot", type: "domain_knowledge", description: "Indicates if a robot is old based on its age.", definition: "A robot is considered old if RAY >= 2.", source_file: "robot_kb.jsonl", source_line: 11, source_id: 10, search_text: "Old Robot domain_knowledge Indicates if a robot is old based on its age. A robot is considered old if RAY >= 2."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:11"}) SET n = {id: "robot:11", name: "High Temperature Joint 1", type: "domain_knowledge", description: "Indicates if Joint 1 has a high average temperature.", definition: "Joint 1 has high temperature if AJ1T > 50.", source_file: "robot_kb.jsonl", source_line: 12, source_id: 11, search_text: "High Temperature Joint 1 domain_knowledge Indicates if Joint 1 has a high average temperature. Joint 1 has high temperature if AJ1T > 50."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:12"}) SET n = {id: "robot:12", name: "Overheating Risk", type: "domain_knowledge", description: "Indicates if there is a risk of overheating based on maximum joint temperature.", definition: "There is an overheating risk if MJT > 70.", source_file: "robot_kb.jsonl", source_line: 13, source_id: 12, search_text: "Overheating Risk domain_knowledge Indicates if there is a risk of overheating based on maximum joint temperature. There is an overheating risk if MJT > 70."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:13"}) SET n = {id: "robot:13", name: "Precision Category", type: "domain_knowledge", description: "Categorizes the precision of the robot based on average position error.", definition: "If APE < 0.1, 'High Precision'; else if APE < 0.5, 'Medium Precision'; else 'Low Precision'.", source_file: "robot_kb.jsonl", source_line: 14, source_id: 13, search_text: "Precision Category domain_knowledge Categorizes the precision of the robot based on average position error. If APE < 0.1, 'High Precision'; else if APE < 0.5, 'Medium Precision'; else 'Low Precision'."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:14"}) SET n = {id: "robot:14", name: "Fast Robot", type: "domain_knowledge", description: "Indicates if the robot operates at high speed based on average TCP speed.", definition: "The robot is fast if ATCS > 1000.", source_file: "robot_kb.jsonl", source_line: 15, source_id: 14, search_text: "Fast Robot domain_knowledge Indicates if the robot operates at high speed based on average TCP speed. The robot is fast if ATCS > 1000."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:15"}) SET n = {id: "robot:15", name: "High Fault Risk", type: "domain_knowledge", description: "Indicates if the robot has a high risk of fault based on average fault prediction score.", definition: "The robot has high fault risk if RFPS > 0.5.", source_file: "robot_kb.jsonl", source_line: 16, source_id: 15, search_text: "High Fault Risk domain_knowledge Indicates if the robot has a high risk of fault based on average fault prediction score. The robot has high fault risk if RFPS > 0.5."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:16"}) SET n = {id: "robot:16", name: "Urgent Maintenance Needed", type: "domain_knowledge", description: "Indicates if urgent maintenance is needed based on minimum Remaining Useful Life.", definition: "Urgent maintenance is needed if MRUL < 100.", source_file: "robot_kb.jsonl", source_line: 17, source_id: 16, search_text: "Urgent Maintenance Needed domain_knowledge Indicates if urgent maintenance is needed based on minimum Remaining Useful Life. Urgent maintenance is needed if MRUL < 100."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:17"}) SET n = {id: "robot:17", name: "Heavily Used Robot", type: "domain_knowledge", description: "Indicates if the robot has been heavily used based on total operating hours.", definition: "The robot is heavily used if TOH > 10000.", source_file: "robot_kb.jsonl", source_line: 18, source_id: 17, search_text: "Heavily Used Robot domain_knowledge Indicates if the robot has been heavily used based on total operating hours. The robot is heavily used if TOH > 10000."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:18"}) SET n = {id: "robot:18", name: "Multi-Operation Robot", type: "domain_knowledge", description: "Indicates if the robot has performed multiple operations.", definition: "The robot has performed multiple operations if NO > 1.", source_file: "robot_kb.jsonl", source_line: 19, source_id: 18, search_text: "Multi-Operation Robot domain_knowledge Indicates if the robot has performed multiple operations. The robot has performed multiple operations if NO > 1."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:19"}) SET n = {id: "robot:19", name: "High Cycle Count Robot", type: "domain_knowledge", description: "Indicates if the robot has a high total program cycle count.", definition: "The robot has a high cycle count if TPC > 1000000.", source_file: "robot_kb.jsonl", source_line: 20, source_id: 19, search_text: "High Cycle Count Robot domain_knowledge Indicates if the robot has a high total program cycle count. The robot has a high cycle count if TPC > 1000000."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:20"}) SET n = {id: "robot:20", name: "Joint Temperature", type: "value_illustration", description: "Illustrates the temperature values of robot joints.", definition: "Joint temperatures are measured in degrees Celsius. Typical operating temperatures range from 20°C to 60°C. Temperatures above 60°C may indicate potential issues.", source_file: "robot_kb.jsonl", source_line: 21, source_id: 20, search_text: "Joint Temperature value_illustration Illustrates the temperature values of robot joints. Joint temperatures are measured in degrees Celsius. Typical operating temperatures range from 20°C to 60°C. Temperatures above 60°C may indicate potential issues."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:21"}) SET n = {id: "robot:21", name: "Vibration Level", type: "value_illustration", description: "Illustrates the vibration levels of robot joints.", definition: "Vibration levels are measured in units such as mm/s. Higher values may indicate wear or misalignment.", source_file: "robot_kb.jsonl", source_line: 22, source_id: 21, search_text: "Vibration Level value_illustration Illustrates the vibration levels of robot joints. Vibration levels are measured in units such as mm/s. Higher values may indicate wear or misalignment."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:22"}) SET n = {id: "robot:22", name: "Position Error", type: "value_illustration", description: "Illustrates the position error in robot actuations.", definition: "Position error is measured in millimeters. Lower values indicate higher precision.", source_file: "robot_kb.jsonl", source_line: 23, source_id: 22, search_text: "Position Error value_illustration Illustrates the position error in robot actuations. Position error is measured in millimeters. Lower values indicate higher precision."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:23"}) SET n = {id: "robot:23", name: "TCP Speed", type: "value_illustration", description: "Illustrates the speed of the Tool Center Point.", definition: "TCP speed is measured in mm/s. Higher speeds may be required for certain applications but can affect precision.", source_file: "robot_kb.jsonl", source_line: 24, source_id: 23, search_text: "TCP Speed value_illustration Illustrates the speed of the Tool Center Point. TCP speed is measured in mm/s. Higher speeds may be required for certain applications but can affect precision."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:24"}) SET n = {id: "robot:24", name: "Fault Prediction Score", type: "value_illustration", description: "Illustrates the fault prediction score in maintenance records.", definition: "The score ranges from 0 to 1, with higher values indicating a higher likelihood of an impending fault.", source_file: "robot_kb.jsonl", source_line: 25, source_id: 24, search_text: "Fault Prediction Score value_illustration Illustrates the fault prediction score in maintenance records. The score ranges from 0 to 1, with higher values indicating a higher likelihood of an impending fault."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:25"}) SET n = {id: "robot:25", name: "Remaining Useful Life (RUL)", type: "value_illustration", description: "Illustrates the Remaining Useful Life in maintenance records.", definition: "RUL is measured in hours and indicates the estimated time until the next maintenance is required.", source_file: "robot_kb.jsonl", source_line: 26, source_id: 25, search_text: "Remaining Useful Life (RUL) value_illustration Illustrates the Remaining Useful Life in maintenance records. RUL is measured in hours and indicates the estimated time until the next maintenance is required."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:26"}) SET n = {id: "robot:26", name: "Safety State", type: "value_illustration", description: "Illustrates the safety state of the robot.", definition: "Possible states include 'Normal', 'Warning', and 'Emergency', indicating the current safety condition.", source_file: "robot_kb.jsonl", source_line: 27, source_id: 26, search_text: "Safety State value_illustration Illustrates the safety state of the robot. Possible states include 'Normal', 'Warning', and 'Emergency', indicating the current safety condition."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:27"}) SET n = {id: "robot:27", name: "Emergency Stops", type: "value_illustration", description: "Illustrates the number of emergency stops recorded.", definition: "A higher number of emergency stops may indicate operational issues or safety concerns.", source_file: "robot_kb.jsonl", source_line: 28, source_id: 27, search_text: "Emergency Stops value_illustration Illustrates the number of emergency stops recorded. A higher number of emergency stops may indicate operational issues or safety concerns."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:28"}) SET n = {id: "robot:28", name: "Tool Wear Percentage", type: "value_illustration", description: "Illustrates the tool wear percentage.", definition: "Tool wear is expressed as a percentage, with 100% indicating the tool needs replacement.", source_file: "robot_kb.jsonl", source_line: 29, source_id: 28, search_text: "Tool Wear Percentage value_illustration Illustrates the tool wear percentage. Tool wear is expressed as a percentage, with 100% indicating the tool needs replacement."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:29"}) SET n = {id: "robot:29", name: "Controller Load", type: "value_illustration", description: "Illustrates the load value of the system controller.", definition: "Controller load is a measure of CPU or system load, typically ranging from 0 to 100%.", source_file: "robot_kb.jsonl", source_line: 30, source_id: 29, search_text: "Controller Load value_illustration Illustrates the load value of the system controller. Controller load is a measure of CPU or system load, typically ranging from 0 to 100%."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:30"}) SET n = {id: "robot:30", name: "Weighted Fault Prediction Score (WFPS)", type: "calculation_knowledge", description: "Calculates a weighted average fault prediction score, prioritizing recent records.", definition: "For a given robot R, WFPS = \\frac{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} (faultpredscore \\cdot w(mf))}{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} w(mf)}, \\text{where } w(mf) = 1 / (1 + \\text{upkeepduedays})", source_file: "robot_kb.jsonl", source_line: 31, source_id: 30, search_text: "Weighted Fault Prediction Score (WFPS) calculation_knowledge Calculates a weighted average fault prediction score, prioritizing recent records. For a given robot R, WFPS = \\frac{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} (faultpredscore \\cdot w(mf))}{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} w(mf)}, \\text{where } w(mf) = 1 / (1 + \\text{upkeepduedays})"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:31"}) SET n = {id: "robot:31", name: "Energy Efficiency Ratio (EER)", type: "calculation_knowledge", description: "Measures energy efficiency by comparing energy usage to operating hours.", definition: "For a given robot R, EER = \\frac{\\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} energyusekwhval}{\\text{TOH}}, \\text{where TOH is used to normalize energy consumption.}", source_file: "robot_kb.jsonl", source_line: 32, source_id: 31, search_text: "Energy Efficiency Ratio (EER) calculation_knowledge Measures energy efficiency by comparing energy usage to operating hours. For a given robot R, EER = \\frac{\\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} energyusekwhval}{\\text{TOH}}, \\text{where TOH is used to normalize energy consumption.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:32"}) SET n = {id: "robot:32", name: "Joint Degradation Index (JDI)", type: "calculation_knowledge", description: "Computes a composite index of joint health based on temperature and vibration.", definition: "For a given robot R, JDI = \\frac{\\sum_{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}} \\sum_{i=1}^6 (jitempval_i / \\text{MJT} + jivibval_i)}{\\text{|}\\{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}\\}| \\cdot 6}, \\text{where MJT normalizes temperatures, and jitempval_i, jivibval_i are joint i's temperature and vibration.}", source_file: "robot_kb.jsonl", source_line: 33, source_id: 32, search_text: "Joint Degradation Index (JDI) calculation_knowledge Computes a composite index of joint health based on temperature and vibration. For a given robot R, JDI = \\frac{\\sum_{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}} \\sum_{i=1}^6 (jitempval_i / \\text{MJT} + jivibval_i)}{\\text{|}\\{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}\\}| \\cdot 6}, \\text{where MJT normalizes temperatures, and jitempval_i, jivibval_i are joint i's temperature and vibration.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:33"}) SET n = {id: "robot:33", name: "Operation Cycle Efficiency (OCE)", type: "calculation_knowledge", description: "Calculates the efficiency of program cycles relative to cycle time.", definition: "For a given robot R, OCE = \\frac{\\text{TPC}}{\\sum_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} cycletimesecval}", source_file: "robot_kb.jsonl", source_line: 34, source_id: 33, search_text: "Operation Cycle Efficiency (OCE) calculation_knowledge Calculates the efficiency of program cycles relative to cycle time. For a given robot R, OCE = \\frac{\\text{TPC}}{\\sum_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} cycletimesecval}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:34"}) SET n = {id: "robot:34", name: "Safety Incident Score (SIS)", type: "calculation_knowledge", description: "Aggregates safety incidents from JSONB safety_metrics.", definition: "For a given robot R, SIS = \\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} (safety_metrics->>'overloads'::int + safety_metrics->>'collisions'::int + safety_metrics->>'emergency_stops'::int + safety_metrics->>'speed_violations'::int), \\text{where JSONB fields are extracted and summed.}", source_file: "robot_kb.jsonl", source_line: 35, source_id: 34, search_text: "Safety Incident Score (SIS) calculation_knowledge Aggregates safety incidents from JSONB safety_metrics. For a given robot R, SIS = \\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} (safety_metrics->>'overloads'::int + safety_metrics->>'collisions'::int + safety_metrics->>'emergency_stops'::int + safety_metrics->>'speed_violations'::int), \\text{where JSONB fields are extracted and summed.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:35"}) SET n = {id: "robot:35", name: "Maintenance Cost Trend (MCT)", type: "calculation_knowledge", description: "Estimates the trend in maintenance costs over time.", definition: "For a given robot R, MCT = \\frac{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} \\text{upkeepcostest} \\cdot w(mf)}{\\text{|}\\{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}\\}|}, \\text{where } w(mf) = \\frac{1}{1 + \\text{upkeepduedays}}", source_file: "robot_kb.jsonl", source_line: 36, source_id: 35, search_text: "Maintenance Cost Trend (MCT) calculation_knowledge Estimates the trend in maintenance costs over time. For a given robot R, MCT = \\frac{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} \\text{upkeepcostest} \\cdot w(mf)}{\\text{|}\\{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}\\}|}, \\text{where } w(mf) = \\frac{1}{1 + \\text{upkeepduedays}}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:36"}) SET n = {id: "robot:36", name: "Controller Stress Index (CSI)", type: "calculation_knowledge", description: "Measures controller stress based on load and thermal metrics.", definition: "For a given robot R, CSI = \\frac{\\sum_{sc \\in \\text{system_controller} \\mid \\text{systemoverseerrobot = R}} (controller_metrics->>'load_value'::float + controller_metrics->>'thermal_level'::float)}{\\text{|}\\{sc \\in \\text{system_controller} \\mid \\text{systemoverseerrobot = R}\\}|}, \\text{where JSONB fields load_value and thermal_level are averaged.}", source_file: "robot_kb.jsonl", source_line: 37, source_id: 36, search_text: "Controller Stress Index (CSI) calculation_knowledge Measures controller stress based on load and thermal metrics. For a given robot R, CSI = \\frac{\\sum_{sc \\in \\text{system_controller} \\mid \\text{systemoverseerrobot = R}} (controller_metrics->>'load_value'::float + controller_metrics->>'thermal_level'::float)}{\\text{|}\\{sc \\in \\text{system_controller} \\mid \\text{systemoverseerrobot = R}\\}|}, \\text{where JSONB fields load_value and thermal_level are averaged.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:37"}) SET n = {id: "robot:37", name: "Tool Wear Rate (TWR)", type: "calculation_knowledge", description: "Estimates the rate of tool wear relative to program cycles.", definition: "For a given robot R, TWR = \\frac{\\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} toolwearpct}{\\text{TPC}}, \\text{where TPC normalizes tool wear percentage.}", source_file: "robot_kb.jsonl", source_line: 38, source_id: 37, search_text: "Tool Wear Rate (TWR) calculation_knowledge Estimates the rate of tool wear relative to program cycles. For a given robot R, TWR = \\frac{\\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} toolwearpct}{\\text{TPC}}, \\text{where TPC normalizes tool wear percentage.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:38"}) SET n = {id: "robot:38", name: "Joint Torque Variance (JTV)", type: "calculation_knowledge", description: "Calculates the variance of joint torques to assess operational stability.", definition: "For a given robot R, JTV = \\frac{\\sum_{jp \\in \\text{joint_performance} \\mid \\text{jperfdetref = R}} \\sum_{i=1}^6 ((joint_metrics->>'jointi'->>'torque'::float - \\mu_i)^2)}{\\text{|}\\{jp \\in \\text{joint_performance} \\mid \\text{jperfdetref = R}\\}| \\cdot 6}, \\text{where } \\mu_i = \\frac{\\sum_{jp} joint_metrics->>'jointi'->>'torque'::float}{\\text{|}\\{jp\\}|}, \\text{and jointi is joint i's metrics.}", source_file: "robot_kb.jsonl", source_line: 39, source_id: 38, search_text: "Joint Torque Variance (JTV) calculation_knowledge Calculates the variance of joint torques to assess operational stability. For a given robot R, JTV = \\frac{\\sum_{jp \\in \\text{joint_performance} \\mid \\text{jperfdetref = R}} \\sum_{i=1}^6 ((joint_metrics->>'jointi'->>'torque'::float - \\mu_i)^2)}{\\text{|}\\{jp \\in \\text{joint_performance} \\mid \\text{jperfdetref = R}\\}| \\cdot 6}, \\text{where } \\mu_i = \\frac{\\sum_{jp} joint_metrics->>'jointi'->>'torque'::float}{\\text{|}\\{jp\\}|}, \\text{and jointi is joint i's metrics.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:39"}) SET n = {id: "robot:39", name: "Payload Utilization Ratio (PUR)", type: "calculation_knowledge", description: "Measures how close the robot operates to its payload capacity.", definition: "For a given robot R, PUR = \\frac{\\sum_{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}} payloadwval}{\\text{(robot_details.payloadcapkg where botdetref = R)} \\cdot \\text{|}\\{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}\\}|}, \\text{where RAY adjusts for age-related capacity changes if applicable.}", source_file: "robot_kb.jsonl", source_line: 40, source_id: 39, search_text: "Payload Utilization Ratio (PUR) calculation_knowledge Measures how close the robot operates to its payload capacity. For a given robot R, PUR = \\frac{\\sum_{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}} payloadwval}{\\text{(robot_details.payloadcapkg where botdetref = R)} \\cdot \\text{|}\\{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}\\}|}, \\text{where RAY adjusts for age-related capacity changes if applicable.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:40"}) SET n = {id: "robot:40", name: "Maintenance Priority Level", type: "domain_knowledge", description: "Classifies robots into maintenance priority categories based on fault prediction scores and remaining useful life", definition: "For a robot R, the Maintenance Priority Level is:\n- 'CRITICAL' if WFPS > 0.6 AND MRUL < 500\n- 'WARNING' if WFPS > 0.4 OR MRUL < 500\n- 'NORMAL' otherwise", source_file: "robot_kb.jsonl", source_line: 41, source_id: 40, search_text: "Maintenance Priority Level domain_knowledge Classifies robots into maintenance priority categories based on fault prediction scores and remaining useful life For a robot R, the Maintenance Priority Level is:\n- 'CRITICAL' if WFPS > 0.6 AND MRUL < 500\n- 'WARNING' if WFPS > 0.4 OR MRUL < 500\n- 'NORMAL' otherwise"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:41"}) SET n = {id: "robot:41", name: "Energy Inefficient Robot", type: "domain_knowledge", description: "Flags robots with poor energy efficiency.", definition: "A robot R is Energy Inefficient if EER > 0.01 and TOH > 1000.", source_file: "robot_kb.jsonl", source_line: 42, source_id: 41, search_text: "Energy Inefficient Robot domain_knowledge Flags robots with poor energy efficiency. A robot R is Energy Inefficient if EER > 0.01 and TOH > 1000."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:42"}) SET n = {id: "robot:42", name: "Joint Health Risk", type: "domain_knowledge", description: "Indicates robots at risk of joint failure.", definition: "A robot R has Joint Health Risk if JDI > 1.5 and MJT > 65.", source_file: "robot_kb.jsonl", source_line: 43, source_id: 42, search_text: "Joint Health Risk domain_knowledge Indicates robots at risk of joint failure. A robot R has Joint Health Risk if JDI > 1.5 and MJT > 65."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:43"}) SET n = {id: "robot:43", name: "Cycle Efficiency Category", type: "domain_knowledge", description: "Categorizes robots based on their program cycle efficiency performance", definition: "For a robot R, the Cycle Efficiency Category is:\n- 'Low Efficiency' if OCE < 100 AND TPC > 500000\n- 'Medium Efficiency' if OCE < 150 OR TPC > 300000\n- 'High Efficiency' otherwise", source_file: "robot_kb.jsonl", source_line: 44, source_id: 43, search_text: "Cycle Efficiency Category domain_knowledge Categorizes robots based on their program cycle efficiency performance For a robot R, the Cycle Efficiency Category is:\n- 'Low Efficiency' if OCE < 100 AND TPC > 500000\n- 'Medium Efficiency' if OCE < 150 OR TPC > 300000\n- 'High Efficiency' otherwise"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:44"}) SET n = {id: "robot:44", name: "High Safety Concern", type: "domain_knowledge", description: "Flags robots with significant safety incidents.", definition: "A robot R has High Safety Concern if SIS > 20.", source_file: "robot_kb.jsonl", source_line: 45, source_id: 44, search_text: "High Safety Concern domain_knowledge Flags robots with significant safety incidents. A robot R has High Safety Concern if SIS > 20."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:45"}) SET n = {id: "robot:45", name: "Escalating Maintenance Costs", type: "domain_knowledge", description: "Identifies robots with rising maintenance costs.", definition: "A robot R has Escalating Maintenance Costs if MCT > 500 and RAY > 2.", source_file: "robot_kb.jsonl", source_line: 46, source_id: 45, search_text: "Escalating Maintenance Costs domain_knowledge Identifies robots with rising maintenance costs. A robot R has Escalating Maintenance Costs if MCT > 500 and RAY > 2."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:46"}) SET n = {id: "robot:46", name: "Controller Overload Risk", type: "domain_knowledge", description: "Indicates robots with stressed controllers.", definition: "A robot R has Controller Overload Risk if CSI > 100 and NO > 2.", source_file: "robot_kb.jsonl", source_line: 47, source_id: 46, search_text: "Controller Overload Risk domain_knowledge Indicates robots with stressed controllers. A robot R has Controller Overload Risk if CSI > 100 and NO > 2."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:47"}) SET n = {id: "robot:47", name: "Tool Replacement Status", type: "domain_knowledge", description: "Classifies robots into tool replacement priority categories based on tool wear rate and program cycles", definition: "For a robot R, the Tool Replacement Status is:\n- 'URGENT' if TWR > 0.001 AND TPC > 10000\n- 'WARNING' if TWR > 0.0005 OR average tool wear percentage > 75\n- 'NORMAL' otherwise", source_file: "robot_kb.jsonl", source_line: 48, source_id: 47, search_text: "Tool Replacement Status domain_knowledge Classifies robots into tool replacement priority categories based on tool wear rate and program cycles For a robot R, the Tool Replacement Status is:\n- 'URGENT' if TWR > 0.001 AND TPC > 10000\n- 'WARNING' if TWR > 0.0005 OR average tool wear percentage > 75\n- 'NORMAL' otherwise"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:48"}) SET n = {id: "robot:48", name: "Operational Instability", type: "domain_knowledge", description: "Identifies robots with unstable joint performance.", definition: "A robot R has Operational Instability if JTV > 50 and MJT > 60.", source_file: "robot_kb.jsonl", source_line: 49, source_id: 48, search_text: "Operational Instability domain_knowledge Identifies robots with unstable joint performance. A robot R has Operational Instability if JTV > 50 and MJT > 60."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:49"}) SET n = {id: "robot:49", name: "Overloaded Robot", type: "domain_knowledge", description: "Flags robots operating near or beyond payload capacity.", definition: "A robot R is Overloaded if PUR > 0.9 and RAY > 1.", source_file: "robot_kb.jsonl", source_line: 50, source_id: 49, search_text: "Overloaded Robot domain_knowledge Flags robots operating near or beyond payload capacity. A robot R is Overloaded if PUR > 0.9 and RAY > 1."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:50"}) SET n = {id: "robot:50", name: "JDI-TOH Regression Slope", type: "calculation_knowledge", description: "Measures the linear relationship between Joint Degradation Index and Total Operating Hours using regression.", definition: "For a set of robots meeting JDI > 1.5, MJT > 65, and TOH > 5000, the JDI-TOH Regression Slope is given by \\[ \\text{slope} = \\frac{n \\sum (x_i y_i) - \\sum x_i \\sum y_i}{n \\sum x_i^2 - (\\sum x_i)^2} \\] where \\( y_i = \\text{JDI} \\) (Joint Degradation Index for robot \\( i \\)), \\( x_i = \\text{TOH} \\) (Total Operating Hours for robot \\( i \\)), \\( n \\) is the number of qualifying robots, and sums are over all qualifying robots.", source_file: "robot_kb.jsonl", source_line: 51, source_id: 50, search_text: "JDI-TOH Regression Slope calculation_knowledge Measures the linear relationship between Joint Degradation Index and Total Operating Hours using regression. For a set of robots meeting JDI > 1.5, MJT > 65, and TOH > 5000, the JDI-TOH Regression Slope is given by \\[ \\text{slope} = \\frac{n \\sum (x_i y_i) - \\sum x_i \\sum y_i}{n \\sum x_i^2 - (\\sum x_i)^2} \\] where \\( y_i = \\text{JDI} \\) (Joint Degradation Index for robot \\( i \\)), \\( x_i = \\text{TOH} \\) (Total Operating Hours for robot \\( i \\)), \\( n \\) is the number of qualifying robots, and sums are over all qualifying robots."};
MERGE (n:Knowledge:SemanticSearch {id: "robot:51"}) SET n = {id: "robot:51", name: "Average Cycle Time", type: "calculation_knowledge", description: "Calculates the average time in seconds for completing one program cycle", definition: "For a given robot R, Average Cycle Time = \\frac{\\sum_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} \\text{cycletimesecval}}{|\\{o \\in \\text{operation} \\mid \\text{operbotdetref = R}\\}|}", source_file: "robot_kb.jsonl", source_line: 52, source_id: 51, search_text: "Average Cycle Time calculation_knowledge Calculates the average time in seconds for completing one program cycle For a given robot R, Average Cycle Time = \\frac{\\sum_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} \\text{cycletimesecval}}{|\\{o \\in \\text{operation} \\mid \\text{operbotdetref = R}\\}|}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:52"}) SET n = {id: "robot:52", name: "EER Rank", type: "calculation_knowledge", description: "Ranks the Energy Efficiency Ratio within each application type to assess relative efficiency.", definition: "EER Rank = \\text{PERCENT_RANK}() \\text{ OVER } (\\text{PARTITION BY } apptypeval \\text{ ORDER BY } EER \\text{ DESC})}", source_file: "robot_kb.jsonl", source_line: 53, source_id: 52, search_text: "EER Rank calculation_knowledge Ranks the Energy Efficiency Ratio within each application type to assess relative efficiency. EER Rank = \\text{PERCENT_RANK}() \\text{ OVER } (\\text{PARTITION BY } apptypeval \\text{ ORDER BY } EER \\text{ DESC})}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:53"}) SET n = {id: "robot:53", name: "APE Rank", type: "calculation_knowledge", description: "Ranks the Average Position Error within each controller type to assess relative precision.", definition: "For a given robot R, APE Rank = \\text{PERCENT_RANK}() \\text{ OVER } (\\text{PARTITION BY } ctrltypeval \\text{ ORDER BY } APE \\text{ DESC})", source_file: "robot_kb.jsonl", source_line: 54, source_id: 53, search_text: "APE Rank calculation_knowledge Ranks the Average Position Error within each controller type to assess relative precision. For a given robot R, APE Rank = \\text{PERCENT_RANK}() \\text{ OVER } (\\text{PARTITION BY } ctrltypeval \\text{ ORDER BY } APE \\text{ DESC})"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:54"}) SET n = {id: "robot:54", name: "Program Efficiency Rank", type: "calculation_knowledge", description: "Ranks programs based on their average Operation Cycle Efficiency across robots.", definition: "For a program P, Program Efficiency Rank = \\text{DENSE_RANK}() \\text{ OVER } (\\text{ORDER BY } \\text{AVG(program_oce)} \\text{ DESC}), \\text{where program_oce is the Operation Cycle Efficiency for program P on each robot.}", source_file: "robot_kb.jsonl", source_line: 55, source_id: 54, search_text: "Program Efficiency Rank calculation_knowledge Ranks programs based on their average Operation Cycle Efficiency across robots. For a program P, Program Efficiency Rank = \\text{DENSE_RANK}() \\text{ OVER } (\\text{ORDER BY } \\text{AVG(program_oce)} \\text{ DESC}), \\text{where program_oce is the Operation Cycle Efficiency for program P on each robot.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:55"}) SET n = {id: "robot:55", name: "Efficiency Metrics", type: "calculation_knowledge", description: "Aggregates efficiency-related metrics, including the most efficient program and average program Operation Cycle Efficiency.", definition: "For a model series, Efficiency Metrics = \\text{jsonb_build_object}('most_efficient_program', \\text{currprogval with Program Efficiency Rank = 1}, 'avg_program_efficiency', \\text{AVG(avg_program_oce)}), \\text{where avg_program_oce is the average Operation Cycle Efficiency per program.}", source_file: "robot_kb.jsonl", source_line: 56, source_id: 55, search_text: "Efficiency Metrics calculation_knowledge Aggregates efficiency-related metrics, including the most efficient program and average program Operation Cycle Efficiency. For a model series, Efficiency Metrics = \\text{jsonb_build_object}('most_efficient_program', \\text{currprogval with Program Efficiency Rank = 1}, 'avg_program_efficiency', \\text{AVG(avg_program_oce)}), \\text{where avg_program_oce is the average Operation Cycle Efficiency per program.}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:56"}) SET n = {id: "robot:56", name: "Robot Count", type: "calculation_knowledge", description: "The number of distinct robots within a specific group (e.g., model series).", definition: "Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Robot Count = |\\mathcal{R}_M|", source_file: "robot_kb.jsonl", source_line: 57, source_id: 56, search_text: "Robot Count calculation_knowledge The number of distinct robots within a specific group (e.g., model series). Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Robot Count = |\\mathcal{R}_M|"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:57"}) SET n = {id: "robot:57", name: "Model Average Position Error", type: "calculation_knowledge", description: "The average of the Average Position Error values for all robots within a specific model series.", definition: "Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Model Avg Pos Error = \\frac{\\sum_{R \\in \\mathcal{R}_M} \\text{APE}(R)}{|\\mathcal{R}_M|}", source_file: "robot_kb.jsonl", source_line: 58, source_id: 57, search_text: "Model Average Position Error calculation_knowledge The average of the Average Position Error values for all robots within a specific model series. Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Model Avg Pos Error = \\frac{\\sum_{R \\in \\mathcal{R}_M} \\text{APE}(R)}{|\\mathcal{R}_M|}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:58"}) SET n = {id: "robot:58", name: "Model Average TCP Speed", type: "calculation_knowledge", description: "The average of the Average TCP Speed values for all robots within a specific model series.", definition: "Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Model Avg TCP Speed = \\frac{\\sum_{R \\in \\mathcal{R}_M} \\text{ATCS}(R)}{|\\mathcal{R}_M|}", source_file: "robot_kb.jsonl", source_line: 59, source_id: 58, search_text: "Model Average TCP Speed calculation_knowledge The average of the Average TCP Speed values for all robots within a specific model series. Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Model Avg TCP Speed = \\frac{\\sum_{R \\in \\mathcal{R}_M} \\text{ATCS}(R)}{|\\mathcal{R}_M|}"};
MERGE (n:Knowledge:SemanticSearch {id: "robot:59"}) SET n = {id: "robot:59", name: "Model Average Max Operating Hours", type: "calculation_knowledge", description: "The average of the maximum Total Operating Hours recorded for each robot within a specific model series.", definition: "Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Model Avg Max Ops Hours = \\frac{\\sum_{R \\in \\mathcal{R}_M} \\text{TOH}(R)}{|\\mathcal{R}_M|}", source_file: "robot_kb.jsonl", source_line: 60, source_id: 59, search_text: "Model Average Max Operating Hours calculation_knowledge The average of the maximum Total Operating Hours recorded for each robot within a specific model series. Let M be the model series, \\mathcal{R}_M be the set of unique robot identifiers in M. Then Model Avg Max Ops Hours = \\frac{\\sum_{R \\in \\mathcal{R}_M} \\text{TOH}(R)}{|\\mathcal{R}_M|}"};
MATCH (d:Database {id: "solar"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "solar:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "solar:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "solar:" AND NOT stale.id IN ["solar:0", "solar:1", "solar:2", "solar:3", "solar:4", "solar:5", "solar:6", "solar:7", "solar:8", "solar:9", "solar:10", "solar:11", "solar:13", "solar:14", "solar:15", "solar:16", "solar:17", "solar:18", "solar:19", "solar:20", "solar:21", "solar:22", "solar:23", "solar:24", "solar:25", "solar:26", "solar:27", "solar:28", "solar:29", "solar:30", "solar:31", "solar:32", "solar:33", "solar:34", "solar:35", "solar:36", "solar:37", "solar:38", "solar:39", "solar:40", "solar:41", "solar:42", "solar:43", "solar:44", "solar:45", "solar:46", "solar:47", "solar:48", "solar:49", "solar:50", "solar:51", "solar:52", "solar:53"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "solar:0"}) SET n = {id: "solar:0", name: "Panel Performance Ratio (PPR)", type: "calculation_knowledge", description: "Measures how well a solar panel is performing relative to its rated power.", definition: "PPR = \\frac{MeasuredPowerW}{PowerRatedW} \\times 100\\%, \\text{where MeasuredPowerW is the measured power output and PowerRatedW is the rated power of the panel.}", source_file: "solar_kb.jsonl", source_line: 1, source_id: 0, search_text: "Panel Performance Ratio (PPR) calculation_knowledge Measures how well a solar panel is performing relative to its rated power. PPR = \\frac{MeasuredPowerW}{PowerRatedW} \\times 100\\%, \\text{where MeasuredPowerW is the measured power output and PowerRatedW is the rated power of the panel.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:1"}) SET n = {id: "solar:1", name: "Panel Efficiency Loss Rate (PELR)", type: "calculation_knowledge", description: "Calculates the percentage of efficiency loss per year for a solar panel.", definition: "PELR = \\frac{CurrentEfficiencyPercent - InitialEfficiencyPercent}{Years\\_Since\\_Installation} \\times 100\\%, \\text{where CurrentEfficiencyPercent is obtained from efficiency_profile.current_efficiency.curreffpct.}", source_file: "solar_kb.jsonl", source_line: 2, source_id: 1, search_text: "Panel Efficiency Loss Rate (PELR) calculation_knowledge Calculates the percentage of efficiency loss per year for a solar panel. PELR = \\frac{CurrentEfficiencyPercent - InitialEfficiencyPercent}{Years\\_Since\\_Installation} \\times 100\\%, \\text{where CurrentEfficiencyPercent is obtained from efficiency_profile.current_efficiency.curreffpct.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:2"}) SET n = {id: "solar:2", name: "Temperature Performance Coefficient Impact (TPCI)", type: "calculation_knowledge", description: "Quantifies the impact of temperature on panel performance based on its temperature coefficient.", definition: "TPCI = PowerRatedW \\times TempCoef \\times (CellTempC - 25), \\text{where TempCoef is the temperature coefficient and 25°C is the standard test condition temperature.}", source_file: "solar_kb.jsonl", source_line: 3, source_id: 2, search_text: "Temperature Performance Coefficient Impact (TPCI) calculation_knowledge Quantifies the impact of temperature on panel performance based on its temperature coefficient. TPCI = PowerRatedW \\times TempCoef \\times (CellTempC - 25), \\text{where TempCoef is the temperature coefficient and 25°C is the standard test condition temperature.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:3"}) SET n = {id: "solar:3", name: "Energy Production Efficiency (EPE)", type: "calculation_knowledge", description: "Measures the overall energy production efficiency considering all losses.", definition: "EPE = PPR \\times (1 - SoilingLossPercent/100) \\times (1 - CumulativeDegradationPercent/100), \\text{where PPR is the Panel Performance Ratio.}", source_file: "solar_kb.jsonl", source_line: 4, source_id: 3, search_text: "Energy Production Efficiency (EPE) calculation_knowledge Measures the overall energy production efficiency considering all losses. EPE = PPR \\times (1 - SoilingLossPercent/100) \\times (1 - CumulativeDegradationPercent/100), \\text{where PPR is the Panel Performance Ratio.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:4"}) SET n = {id: "solar:4", name: "Inverter Efficiency Loss (IEL)", type: "calculation_knowledge", description: "Calculates the energy lost due to inverter inefficiency.", definition: "IEL = MeasuredPowerW \\times (1 - InverterEfficiencyPercent/100), \\text{where InverterEfficiencyPercent is from power_metrics.inverteffpct.}", source_file: "solar_kb.jsonl", source_line: 5, source_id: 4, search_text: "Inverter Efficiency Loss (IEL) calculation_knowledge Calculates the energy lost due to inverter inefficiency. IEL = MeasuredPowerW \\times (1 - InverterEfficiencyPercent/100), \\text{where InverterEfficiencyPercent is from power_metrics.inverteffpct.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:5"}) SET n = {id: "solar:5", name: "Fill Factor Degradation Rate (FFDR)", type: "calculation_knowledge", description: "Calculates the rate at which the fill factor of a panel is degrading over time.", definition: "FFDR = \\frac{FillFactorInitial - FillFactorCurrent}{Years\\_Since\\_Installation} \\times 100\\%, \\text{where FillFactorInitial and FillFactorCurrent are from the electrical table.}", source_file: "solar_kb.jsonl", source_line: 6, source_id: 5, search_text: "Fill Factor Degradation Rate (FFDR) calculation_knowledge Calculates the rate at which the fill factor of a panel is degrading over time. FFDR = \\frac{FillFactorInitial - FillFactorCurrent}{Years\\_Since\\_Installation} \\times 100\\%, \\text{where FillFactorInitial and FillFactorCurrent are from the electrical table.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:6"}) SET n = {id: "solar:6", name: "Soiling Impact Factor (SIF)", type: "calculation_knowledge", description: "Quantifies the impact of soiling on power production based on dust density.", definition: "SIF = SoilingLossPercent / DustDensityGM2, \\text{where higher values indicate greater sensitivity to dust accumulation.}", source_file: "solar_kb.jsonl", source_line: 7, source_id: 6, search_text: "Soiling Impact Factor (SIF) calculation_knowledge Quantifies the impact of soiling on power production based on dust density. SIF = SoilingLossPercent / DustDensityGM2, \\text{where higher values indicate greater sensitivity to dust accumulation.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:7"}) SET n = {id: "solar:7", name: "Maintenance Cost Efficiency (MCE)", type: "calculation_knowledge", description: "Evaluates the cost-effectiveness of maintenance relative to the plant's capacity.", definition: "MCE = \\frac{MaintenanceCostUSD + CleaningCostUSD + ReplacementCostUSD}{GenCapMW}, \\text{where lower values indicate more cost-effective maintenance.}", source_file: "solar_kb.jsonl", source_line: 8, source_id: 7, search_text: "Maintenance Cost Efficiency (MCE) calculation_knowledge Evaluates the cost-effectiveness of maintenance relative to the plant's capacity. MCE = \\frac{MaintenanceCostUSD + CleaningCostUSD + ReplacementCostUSD}{GenCapMW}, \\text{where lower values indicate more cost-effective maintenance.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:8"}) SET n = {id: "solar:8", name: "Revenue Loss Rate (RLR)", type: "calculation_knowledge", description: "Calculates the revenue loss per MW of capacity due to maintenance issues.", definition: "RLR = \\frac{RevenueLossUSD}{GenCapMW}, \\text{where higher values indicate greater financial impact from downtime.}", source_file: "solar_kb.jsonl", source_line: 9, source_id: 8, search_text: "Revenue Loss Rate (RLR) calculation_knowledge Calculates the revenue loss per MW of capacity due to maintenance issues. RLR = \\frac{RevenueLossUSD}{GenCapMW}, \\text{where higher values indicate greater financial impact from downtime.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:9"}) SET n = {id: "solar:9", name: "Irradiance Utilization Ratio (IUR)", type: "calculation_knowledge", description: "Measures how effectively the panel converts available solar irradiance to power.", definition: "IUR = \\frac{MeasuredPowerW / PanelAreaM2}{POAIrradianceWM2}, \\text{where POAIrradianceWM2 is from irradiance_conditions.irradiance_types[3] and PanelAreaM2 is the area of the panel.}", source_file: "solar_kb.jsonl", source_line: 10, source_id: 9, search_text: "Irradiance Utilization Ratio (IUR) calculation_knowledge Measures how effectively the panel converts available solar irradiance to power. IUR = \\frac{MeasuredPowerW / PanelAreaM2}{POAIrradianceWM2}, \\text{where POAIrradianceWM2 is from irradiance_conditions.irradiance_types[3] and PanelAreaM2 is the area of the panel.}"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:10"}) SET n = {id: "solar:10", name: "Critical Performance Threshold", type: "domain_knowledge", description: "Defines when a panel's performance has degraded to a level requiring attention.", definition: "A solar panel is considered below critical performance threshold when its Panel Performance Ratio (PPR) falls below 80% of the expected value for its age, accounting for normal degradation.", source_file: "solar_kb.jsonl", source_line: 11, source_id: 10, search_text: "Critical Performance Threshold domain_knowledge Defines when a panel's performance has degraded to a level requiring attention. A solar panel is considered below critical performance threshold when its Panel Performance Ratio (PPR) falls below 80% of the expected value for its age, accounting for normal degradation."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:11"}) SET n = {id: "solar:11", name: "Hot Spot Risk", type: "domain_knowledge", description: "Indicates conditions that suggest a panel may be developing hot spots.", definition: "A panel is at risk for hot spots when it shows irregular electrical parameters (Voc or Isc deviations >5% compared to other panels in the same string) combined with cell temperatures exceeding 20°C above ambient temperature.", source_file: "solar_kb.jsonl", source_line: 12, source_id: 11, search_text: "Hot Spot Risk domain_knowledge Indicates conditions that suggest a panel may be developing hot spots. A panel is at risk for hot spots when it shows irregular electrical parameters (Voc or Isc deviations >5% compared to other panels in the same string) combined with cell temperatures exceeding 20°C above ambient temperature."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:13"}) SET n = {id: "solar:13", name: "Soiling Cleaning Threshold", type: "domain_knowledge", description: "Defines when panel cleaning should be performed based on soiling conditions.", definition: "Cleaning should be performed when Soiling Loss Percentage exceeds 5% or when Dust Density exceeds 0.15 g/m², whichever occurs first.", source_file: "solar_kb.jsonl", source_line: 13, source_id: 13, search_text: "Soiling Cleaning Threshold domain_knowledge Defines when panel cleaning should be performed based on soiling conditions. Cleaning should be performed when Soiling Loss Percentage exceeds 5% or when Dust Density exceeds 0.15 g/m², whichever occurs first."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:14"}) SET n = {id: "solar:14", name: "End-of-Life Indicator", type: "domain_knowledge", description: "Defines criteria for determining when a panel should be considered for replacement.", definition: "A panel has reached effective end-of-life when its cumulative degradation exceeds 20% or when maintenance costs in a 12-month period exceed 30% of replacement value.", source_file: "solar_kb.jsonl", source_line: 14, source_id: 14, search_text: "End-of-Life Indicator domain_knowledge Defines criteria for determining when a panel should be considered for replacement. A panel has reached effective end-of-life when its cumulative degradation exceeds 20% or when maintenance costs in a 12-month period exceed 30% of replacement value."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:15"}) SET n = {id: "solar:15", name: "Optimal Performance Window", type: "domain_knowledge", description: "Defines the environmental conditions for optimal panel performance.", definition: "The optimal performance window occurs when cell temperature is between 25-45°C, POA irradiance exceeds 800 W/m², and soiling loss is less than 2%.", source_file: "solar_kb.jsonl", source_line: 15, source_id: 15, search_text: "Optimal Performance Window domain_knowledge Defines the environmental conditions for optimal panel performance. The optimal performance window occurs when cell temperature is between 25-45°C, POA irradiance exceeds 800 W/m², and soiling loss is less than 2%."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:16"}) SET n = {id: "solar:16", name: "Panel String Mismatch", type: "domain_knowledge", description: "Identifies when panels in a string have mismatched electrical characteristics.", definition: "A string has significant mismatch when the standard deviation of current measurements (Imp or Isc) across panels exceeds 3% of the mean value under the same irradiance conditions.", source_file: "solar_kb.jsonl", source_line: 16, source_id: 16, search_text: "Panel String Mismatch domain_knowledge Identifies when panels in a string have mismatched electrical characteristics. A string has significant mismatch when the standard deviation of current measurements (Imp or Isc) across panels exceeds 3% of the mean value under the same irradiance conditions."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:17"}) SET n = {id: "solar:17", name: "Warranty Claim Threshold", type: "domain_knowledge", description: "Criteria for when warranty claims should be initiated based on performance degradation.", definition: "A warranty claim should be considered when a panel's Energy Production Efficiency falls more than 10% below the manufacturer's warranty curve for its age, with at least three consecutive measurements confirming the underperformance.", source_file: "solar_kb.jsonl", source_line: 17, source_id: 17, search_text: "Warranty Claim Threshold domain_knowledge Criteria for when warranty claims should be initiated based on performance degradation. A warranty claim should be considered when a panel's Energy Production Efficiency falls more than 10% below the manufacturer's warranty curve for its age, with at least three consecutive measurements confirming the underperformance."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:18"}) SET n = {id: "solar:18", name: "Weather Severity Index", type: "domain_knowledge", description: "Classifies environmental conditions based on their potential impact on solar plant operations.", definition: "A composite index calculated from extreme values of temperature, humidity, wind speed, and precipitation, where higher values indicate more severe operating conditions and increased risk of performance issues.", source_file: "solar_kb.jsonl", source_line: 18, source_id: 18, search_text: "Weather Severity Index domain_knowledge Classifies environmental conditions based on their potential impact on solar plant operations. A composite index calculated from extreme values of temperature, humidity, wind speed, and precipitation, where higher values indicate more severe operating conditions and increased risk of performance issues."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:19"}) SET n = {id: "solar:19", name: "Grid Stability Factor", type: "domain_knowledge", description: "Measures the contribution of the inverter to grid stability.", definition: "A metric determined by the combination of Power Quality Index, Harmonic Distortion Percentage, and Power Factor, where values closer to 1.0 indicate better contribution to grid stability.", source_file: "solar_kb.jsonl", source_line: 19, source_id: 19, search_text: "Grid Stability Factor domain_knowledge Measures the contribution of the inverter to grid stability. A metric determined by the combination of Power Quality Index, Harmonic Distortion Percentage, and Power Factor, where values closer to 1.0 indicate better contribution to grid stability."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:20"}) SET n = {id: "solar:20", name: "PowerRatedW (Panel Rated Power)", type: "value_illustration", description: "Illustrates the rated power output of solar panels.", definition: "Measured in watts (W), representing the maximum power output a panel can produce under Standard Test Conditions (STC). Values typically range from 250W for older models to 650W for newer high-efficiency panels.", source_file: "solar_kb.jsonl", source_line: 20, source_id: 20, search_text: "PowerRatedW (Panel Rated Power) value_illustration Illustrates the rated power output of solar panels. Measured in watts (W), representing the maximum power output a panel can produce under Standard Test Conditions (STC). Values typically range from 250W for older models to 650W for newer high-efficiency panels."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:21"}) SET n = {id: "solar:21", name: "PaneEffPct (Panel Efficiency Percentage)", type: "value_illustration", description: "Illustrates the efficiency of solar panels in converting sunlight to electricity.", definition: "Expressed as a percentage, representing how much of the sun's energy hitting the panel is converted to electricity. Modern panels typically range from 15% to 23%, with premium models reaching up to 25%.", source_file: "solar_kb.jsonl", source_line: 21, source_id: 21, search_text: "PaneEffPct (Panel Efficiency Percentage) value_illustration Illustrates the efficiency of solar panels in converting sunlight to electricity. Expressed as a percentage, representing how much of the sun's energy hitting the panel is converted to electricity. Modern panels typically range from 15% to 23%, with premium models reaching up to 25%."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:22"}) SET n = {id: "solar:22", name: "TempCoef (Temperature Coefficient)", type: "value_illustration", description: "Illustrates how panel performance changes with temperature.", definition: "Expressed as a percentage per degree Celsius (usually negative), indicating how much a panel's power output decreases for each degree above 25°C. Typical values range from -0.25% to -0.50% per °C, with lower absolute values indicating better high-temperature performance.", source_file: "solar_kb.jsonl", source_line: 22, source_id: 22, search_text: "TempCoef (Temperature Coefficient) value_illustration Illustrates how panel performance changes with temperature. Expressed as a percentage per degree Celsius (usually negative), indicating how much a panel's power output decreases for each degree above 25°C. Typical values range from -0.25% to -0.50% per °C, with lower absolute values indicating better high-temperature performance."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:23"}) SET n = {id: "solar:23", name: "CellTempC (Cell Temperature)", type: "value_illustration", description: "Illustrates the operating temperature of solar cells.", definition: "Measured in degrees Celsius, representing the actual temperature of the solar cells during operation. Typically ranges from 40°C to 70°C depending on ambient conditions and panel design, with temperatures above 80°C potentially causing accelerated degradation.", source_file: "solar_kb.jsonl", source_line: 23, source_id: 23, search_text: "CellTempC (Cell Temperature) value_illustration Illustrates the operating temperature of solar cells. Measured in degrees Celsius, representing the actual temperature of the solar cells during operation. Typically ranges from 40°C to 70°C depending on ambient conditions and panel design, with temperatures above 80°C potentially causing accelerated degradation."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:24"}) SET n = {id: "solar:24", name: "FillFactor (Fill Factor)", type: "value_illustration", description: "Illustrates the ratio of actual maximum power to theoretical power.", definition: "A dimensionless value between 0 and 1 representing the ratio of maximum power point (Vmp × Imp) to open-circuit voltage times short-circuit current (Voc × Isc). High-quality commercial panels typically have fill factors between 0.75 and 0.85.", source_file: "solar_kb.jsonl", source_line: 24, source_id: 24, search_text: "FillFactor (Fill Factor) value_illustration Illustrates the ratio of actual maximum power to theoretical power. A dimensionless value between 0 and 1 representing the ratio of maximum power point (Vmp × Imp) to open-circuit voltage times short-circuit current (Voc × Isc). High-quality commercial panels typically have fill factors between 0.75 and 0.85."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:25"}) SET n = {id: "solar:25", name: "SoilingLossPct (Soiling Loss Percentage)", type: "value_illustration", description: "Illustrates the power loss due to dirt and dust accumulation.", definition: "Expressed as a percentage of power output lost due to soiling. Clean panels have values near 0%, while heavily soiled panels in dusty environments may experience losses exceeding 15%. Typical values in maintained systems range from 2% to 5%.", source_file: "solar_kb.jsonl", source_line: 25, source_id: 25, search_text: "SoilingLossPct (Soiling Loss Percentage) value_illustration Illustrates the power loss due to dirt and dust accumulation. Expressed as a percentage of power output lost due to soiling. Clean panels have values near 0%, while heavily soiled panels in dusty environments may experience losses exceeding 15%. Typical values in maintained systems range from 2% to 5%."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:26"}) SET n = {id: "solar:26", name: "AnnDegRate (Annual Degradation Rate)", type: "value_illustration", description: "Illustrates the yearly performance degradation of solar panels.", definition: "Expressed as a percentage, representing how much a panel's output decreases per year. Quality silicon panels typically degrade at 0.5% to 0.7% annually, while lower quality or certain thin-film technologies may degrade at rates above 1% annually.", source_file: "solar_kb.jsonl", source_line: 26, source_id: 26, search_text: "AnnDegRate (Annual Degradation Rate) value_illustration Illustrates the yearly performance degradation of solar panels. Expressed as a percentage, representing how much a panel's output decreases per year. Quality silicon panels typically degrade at 0.5% to 0.7% annually, while lower quality or certain thin-film technologies may degrade at rates above 1% annually."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:27"}) SET n = {id: "solar:27", name: "CumDegPct (Cumulative Degradation Percentage)", type: "value_illustration", description: "Illustrates the total performance loss over a panel's lifetime.", definition: "Expressed as a percentage, representing total performance degradation since installation. New panels start at 0%, while panels approaching end-of-life may have values of 15-20% or higher, with manufacturer warranties typically covering degradation up to 20% over 25 years.", source_file: "solar_kb.jsonl", source_line: 27, source_id: 27, search_text: "CumDegPct (Cumulative Degradation Percentage) value_illustration Illustrates the total performance loss over a panel's lifetime. Expressed as a percentage, representing total performance degradation since installation. New panels start at 0%, while panels approaching end-of-life may have values of 15-20% or higher, with manufacturer warranties typically covering degradation up to 20% over 25 years."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:28"}) SET n = {id: "solar:28", name: "POAIrradianceWM2 (Plane-of-Array Irradiance)", type: "value_illustration", description: "Illustrates the solar energy available to panels in their installed orientation.", definition: "Measured in watts per square meter (W/m²), representing the solar energy reaching the panel surface. Typical daytime values range from 200 W/m² on heavily overcast days to 1000+ W/m² under clear sky conditions at solar noon.", source_file: "solar_kb.jsonl", source_line: 28, source_id: 28, search_text: "POAIrradianceWM2 (Plane-of-Array Irradiance) value_illustration Illustrates the solar energy available to panels in their installed orientation. Measured in watts per square meter (W/m²), representing the solar energy reaching the panel surface. Typical daytime values range from 200 W/m² on heavily overcast days to 1000+ W/m² under clear sky conditions at solar noon."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:29"}) SET n = {id: "solar:29", name: "InvertEffPct (Inverter Efficiency Percentage)", type: "value_illustration", description: "Illustrates the efficiency of inverters in converting DC to AC power.", definition: "Expressed as a percentage, representing how much DC power from panels is successfully converted to AC power. Modern string inverters typically operate at 96-98% efficiency, while microinverters may range from 94-97% efficiency.", source_file: "solar_kb.jsonl", source_line: 29, source_id: 29, search_text: "InvertEffPct (Inverter Efficiency Percentage) value_illustration Illustrates the efficiency of inverters in converting DC to AC power. Expressed as a percentage, representing how much DC power from panels is successfully converted to AC power. Modern string inverters typically operate at 96-98% efficiency, while microinverters may range from 94-97% efficiency."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:30"}) SET n = {id: "solar:30", name: "Temperature Adjusted Performance Ratio (TAPR)", type: "calculation_knowledge", description: "Enhances the Panel Performance Ratio by accounting for temperature effects.", definition: "TAPR = PPR + (TPCI / PowerRatedW), where PPR is the Panel Performance Ratio and TPCI is the Temperature Performance Coefficient Impact.", source_file: "solar_kb.jsonl", source_line: 30, source_id: 30, search_text: "Temperature Adjusted Performance Ratio (TAPR) calculation_knowledge Enhances the Panel Performance Ratio by accounting for temperature effects. TAPR = PPR + (TPCI / PowerRatedW), where PPR is the Panel Performance Ratio and TPCI is the Temperature Performance Coefficient Impact."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:31"}) SET n = {id: "solar:31", name: "Total System Loss (TSL)", type: "calculation_knowledge", description: "Calculates the combined power losses from all major sources.", definition: "TSL = (PowerRatedW × CumDegPct/100) + (MeasuredPowerW × SoilingLossPct/100) + IEL, where IEL is the Inverter Efficiency Loss and CumDegPct is from efficiency_profile.degradation.cumdegpct.", source_file: "solar_kb.jsonl", source_line: 31, source_id: 31, search_text: "Total System Loss (TSL) calculation_knowledge Calculates the combined power losses from all major sources. TSL = (PowerRatedW × CumDegPct/100) + (MeasuredPowerW × SoilingLossPct/100) + IEL, where IEL is the Inverter Efficiency Loss and CumDegPct is from efficiency_profile.degradation.cumdegpct."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:32"}) SET n = {id: "solar:32", name: "Maintenance Return on Investment (MROI)", type: "calculation_knowledge", description: "Evaluates the financial return of maintenance activities.", definition: "MROI = RLR / MCE, where RLR is the Revenue Loss Rate and MCE is the Maintenance Cost Efficiency. Higher values indicate better return on maintenance investments.", source_file: "solar_kb.jsonl", source_line: 32, source_id: 32, search_text: "Maintenance Return on Investment (MROI) calculation_knowledge Evaluates the financial return of maintenance activities. MROI = RLR / MCE, where RLR is the Revenue Loss Rate and MCE is the Maintenance Cost Efficiency. Higher values indicate better return on maintenance investments."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:33"}) SET n = {id: "solar:33", name: "Effective Performance Index (EPI)", type: "calculation_knowledge", description: "Comprehensive metric that accounts for all factors affecting panel performance.", definition: "EPI = PPR × (1 - TSL/PowerRatedW) × (IUR/PaneEffPct), where PPR is the Panel Performance Ratio, TSL is the Total System Loss, and IUR is the Irradiance Utilization Ratio.", source_file: "solar_kb.jsonl", source_line: 33, source_id: 33, search_text: "Effective Performance Index (EPI) calculation_knowledge Comprehensive metric that accounts for all factors affecting panel performance. EPI = PPR × (1 - TSL/PowerRatedW) × (IUR/PaneEffPct), where PPR is the Panel Performance Ratio, TSL is the Total System Loss, and IUR is the Irradiance Utilization Ratio."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:34"}) SET n = {id: "solar:34", name: "Normalized Degradation Index (NDI)", type: "calculation_knowledge", description: "Compares panel degradation to expected rates based on panel type and age.", definition: "NDI = PELR / AnnDegRate, where PELR is the Panel Efficiency Loss Rate and AnnDegRate is from efficiency_profile.degradation.anndegrate. Values above 1.0 indicate faster than expected degradation.", source_file: "solar_kb.jsonl", source_line: 34, source_id: 34, search_text: "Normalized Degradation Index (NDI) calculation_knowledge Compares panel degradation to expected rates based on panel type and age. NDI = PELR / AnnDegRate, where PELR is the Panel Efficiency Loss Rate and AnnDegRate is from efficiency_profile.degradation.anndegrate. Values above 1.0 indicate faster than expected degradation."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:35"}) SET n = {id: "solar:35", name: "Weather Corrected Efficiency (WCE)", type: "calculation_knowledge", description: "Adjusts panel efficiency measurements to account for weather conditions.", definition: "WCE = CurrentEfficiencyPercent × (1 + TempCoef × (25 - CellTempC) / 100) × (1000 / POAIrradianceWM2), where CurrentEfficiencyPercent is from efficiency_profile.current_efficiency.curreffpct.", source_file: "solar_kb.jsonl", source_line: 35, source_id: 35, search_text: "Weather Corrected Efficiency (WCE) calculation_knowledge Adjusts panel efficiency measurements to account for weather conditions. WCE = CurrentEfficiencyPercent × (1 + TempCoef × (25 - CellTempC) / 100) × (1000 / POAIrradianceWM2), where CurrentEfficiencyPercent is from efficiency_profile.current_efficiency.curreffpct."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:36"}) SET n = {id: "solar:36", name: "Expected Energy Yield (EEY)", type: "calculation_knowledge", description: "Calculates the expected energy production considering current conditions.", definition: "EEY = PowerRatedW × EPE × SIF × POAIrradianceWM2 / 1000, where EPE is the Energy Production Efficiency and SIF is the Soiling Impact Factor.", source_file: "solar_kb.jsonl", source_line: 36, source_id: 36, search_text: "Expected Energy Yield (EEY) calculation_knowledge Calculates the expected energy production considering current conditions. EEY = PowerRatedW × EPE × SIF × POAIrradianceWM2 / 1000, where EPE is the Energy Production Efficiency and SIF is the Soiling Impact Factor."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:37"}) SET n = {id: "solar:37", name: "Grid Integration Quality (GIQ)", type: "calculation_knowledge", description: "Measures the overall quality of power delivered to the grid.", definition: "GIQ = PWRQualIDX × (1 - power_metrics.harmdistpct/100) × power_metrics.invertpowfac, using PWRQualIDX from the inverter table.", source_file: "solar_kb.jsonl", source_line: 37, source_id: 37, search_text: "Grid Integration Quality (GIQ) calculation_knowledge Measures the overall quality of power delivered to the grid. GIQ = PWRQualIDX × (1 - power_metrics.harmdistpct/100) × power_metrics.invertpowfac, using PWRQualIDX from the inverter table."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:38"}) SET n = {id: "solar:38", name: "Electrical Degradation Index (EDI)", type: "calculation_knowledge", description: "Measures the combined degradation of electrical parameters.", definition: "EDI = (FillFactorInitial - FillFactorCurrent)/FillFactorInitial + (VocInitialV - VocCurrV)/VocInitialV + (IscInitialA - IscCurrA)/IscInitialA, where higher values indicate more severe degradation.", source_file: "solar_kb.jsonl", source_line: 38, source_id: 38, search_text: "Electrical Degradation Index (EDI) calculation_knowledge Measures the combined degradation of electrical parameters. EDI = (FillFactorInitial - FillFactorCurrent)/FillFactorInitial + (VocInitialV - VocCurrV)/VocInitialV + (IscInitialA - IscCurrA)/IscInitialA, where higher values indicate more severe degradation."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:39"}) SET n = {id: "solar:39", name: "Financial Impact of Degradation (FID)", type: "calculation_knowledge", description: "Calculates the financial cost of degradation over time.", definition: "FID = GenCapMW × 1000 × NDI × PELR × ElectricityPricePerKWh × 24 × 365, where NDI is the Normalized Degradation Index and PELR is the Panel Efficiency Loss Rate.", source_file: "solar_kb.jsonl", source_line: 39, source_id: 39, search_text: "Financial Impact of Degradation (FID) calculation_knowledge Calculates the financial cost of degradation over time. FID = GenCapMW × 1000 × NDI × PELR × ElectricityPricePerKWh × 24 × 365, where NDI is the Normalized Degradation Index and PELR is the Panel Efficiency Loss Rate."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:40"}) SET n = {id: "solar:40", name: "Advanced Performance Degradation Alert", type: "domain_knowledge", description: "Identifies panels showing accelerated degradation requiring intervention.", definition: "A panel requires urgent attention when its Normalized Degradation Index exceeds 1.5 and its TAPR is below the Critical Performance Threshold.", source_file: "solar_kb.jsonl", source_line: 40, source_id: 40, search_text: "Advanced Performance Degradation Alert domain_knowledge Identifies panels showing accelerated degradation requiring intervention. A panel requires urgent attention when its Normalized Degradation Index exceeds 1.5 and its TAPR is below the Critical Performance Threshold."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:41"}) SET n = {id: "solar:41", name: "Premium Maintenance Candidate", type: "domain_knowledge", description: "Identifies panels that would benefit most from premium maintenance services.", definition: "A panel is considered a premium maintenance candidate when its Maintenance Return on Investment exceeds 2.0 and its Energy Production Efficiency is below 90% but above 75%.", source_file: "solar_kb.jsonl", source_line: 41, source_id: 41, search_text: "Premium Maintenance Candidate domain_knowledge Identifies panels that would benefit most from premium maintenance services. A panel is considered a premium maintenance candidate when its Maintenance Return on Investment exceeds 2.0 and its Energy Production Efficiency is below 90% but above 75%."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:42"}) SET n = {id: "solar:42", name: "Optimal Cleaning Schedule", type: "domain_knowledge", description: "Determines the ideal cleaning frequency based on environmental conditions and soiling rates.", definition: "Cleaning should be scheduled when SIF × DustDensityGM2 exceeds the Soiling Cleaning Threshold or when Expected Energy Yield is reduced by more than 3% due to soiling.", source_file: "solar_kb.jsonl", source_line: 42, source_id: 42, search_text: "Optimal Cleaning Schedule domain_knowledge Determines the ideal cleaning frequency based on environmental conditions and soiling rates. Cleaning should be scheduled when SIF × DustDensityGM2 exceeds the Soiling Cleaning Threshold or when Expected Energy Yield is reduced by more than 3% due to soiling."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:43"}) SET n = {id: "solar:43", name: "High-Risk Weather Condition", type: "domain_knowledge", description: "Identifies weather patterns that pose significant risk to panel performance or longevity.", definition: "Weather conditions are considered high-risk when the Weather Severity Index exceeds 7.0 and Cell Temperature exceeds the upper limit of the Optimal Performance Window.", source_file: "solar_kb.jsonl", source_line: 43, source_id: 43, search_text: "High-Risk Weather Condition domain_knowledge Identifies weather patterns that pose significant risk to panel performance or longevity. Weather conditions are considered high-risk when the Weather Severity Index exceeds 7.0 and Cell Temperature exceeds the upper limit of the Optimal Performance Window."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:44"}) SET n = {id: "solar:44", name: "End-of-Warranty Optimization", type: "domain_knowledge", description: "Strategy for optimizing panel replacements near warranty expiration.", definition: "Panels should be evaluated for warranty claims when approaching warranty expiration if their Normalized Degradation Index exceeds 0.9 or if they fail to meet the Warranty Claim Threshold criteria.", source_file: "solar_kb.jsonl", source_line: 44, source_id: 44, search_text: "End-of-Warranty Optimization domain_knowledge Strategy for optimizing panel replacements near warranty expiration. Panels should be evaluated for warranty claims when approaching warranty expiration if their Normalized Degradation Index exceeds 0.9 or if they fail to meet the Warranty Claim Threshold criteria."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:45"}) SET n = {id: "solar:45", name: "Grid Export Quality Classification", type: "domain_knowledge", description: "Classification system for the quality of power exported to the grid.", definition: "Power export quality is classified as 'Premium' when Grid Integration Quality exceeds 0.95, 'Standard' when between 0.90 and 0.95, and 'Substandard' when below 0.90, with substandard exports potentially subject to utility penalties.", source_file: "solar_kb.jsonl", source_line: 45, source_id: 45, search_text: "Grid Export Quality Classification domain_knowledge Classification system for the quality of power exported to the grid. Power export quality is classified as 'Premium' when Grid Integration Quality exceeds 0.95, 'Standard' when between 0.90 and 0.95, and 'Substandard' when below 0.90, with substandard exports potentially subject to utility penalties."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:46"}) SET n = {id: "solar:46", name: "System Upgrade Candidate", type: "domain_knowledge", description: "Identifies plants that would benefit most from component upgrades.", definition: "A plant qualifies as an upgrade candidate when the Financial Impact of Degradation exceeds 10% of replacement cost and Effective Performance Index is below 0.85 for three consecutive months.", source_file: "solar_kb.jsonl", source_line: 46, source_id: 46, search_text: "System Upgrade Candidate domain_knowledge Identifies plants that would benefit most from component upgrades. A plant qualifies as an upgrade candidate when the Financial Impact of Degradation exceeds 10% of replacement cost and Effective Performance Index is below 0.85 for three consecutive months."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:47"}) SET n = {id: "solar:47", name: "Inverter-Panel Compatibility Index", type: "domain_knowledge", description: "Assesses the compatibility between panels and their connected inverters.", definition: "An inverter-panel combination is considered optimally compatible when the panel's Weather Corrected Efficiency stays within 5% of the manufacturer's specifications and the inverter's Inverter Efficiency Percentage exceeds 97%.", source_file: "solar_kb.jsonl", source_line: 47, source_id: 47, search_text: "Inverter-Panel Compatibility Index domain_knowledge Assesses the compatibility between panels and their connected inverters. An inverter-panel combination is considered optimally compatible when the panel's Weather Corrected Efficiency stays within 5% of the manufacturer's specifications and the inverter's Inverter Efficiency Percentage exceeds 97%."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:48"}) SET n = {id: "solar:48", name: "Environmental Stress Classification", type: "domain_knowledge", description: "Categorizes the level of environmental stress a panel is experiencing.", definition: "Environmental stress is classified based on combining Weather Severity Index and exposure time outside the Optimal Performance Window, with high stress potentially accelerating the Panel Efficiency Loss Rate.", source_file: "solar_kb.jsonl", source_line: 48, source_id: 48, search_text: "Environmental Stress Classification domain_knowledge Categorizes the level of environmental stress a panel is experiencing. Environmental stress is classified based on combining Weather Severity Index and exposure time outside the Optimal Performance Window, with high stress potentially accelerating the Panel Efficiency Loss Rate."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:49"}) SET n = {id: "solar:49", name: "Total Economic Performance", type: "domain_knowledge", description: "Holistic economic assessment of a solar installation.", definition: "A comprehensive economic evaluation combining Maintenance Return on Investment, Financial Impact of Degradation, and revenue generation adjusted by the Effective Performance Index, providing a single metric for financial performance.", source_file: "solar_kb.jsonl", source_line: 49, source_id: 49, search_text: "Total Economic Performance domain_knowledge Holistic economic assessment of a solar installation. A comprehensive economic evaluation combining Maintenance Return on Investment, Financial Impact of Degradation, and revenue generation adjusted by the Effective Performance Index, providing a single metric for financial performance."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:50"}) SET n = {id: "solar:50", name: "Maintenance Urgency Classification", type: "domain_knowledge", description: "Four-tier system prioritizing maintenance actions based on combined financial and operational factors", definition: "URGENT: Having critical alerts AND MROI>2.0; HIGH: Having critical alerts; MEDIUM: MROI>2.0; LOW: All other cases", source_file: "solar_kb.jsonl", source_line: 50, source_id: 50, search_text: "Maintenance Urgency Classification domain_knowledge Four-tier system prioritizing maintenance actions based on combined financial and operational factors URGENT: Having critical alerts AND MROI>2.0; HIGH: Having critical alerts; MEDIUM: MROI>2.0; LOW: All other cases"};
MERGE (n:Knowledge:SemanticSearch {id: "solar:51"}) SET n = {id: "solar:51", name: "Cleaning Triggers", type: "domain_knowledge", description: "Combined conditions that determine when solar panel cleaning is economically justified.", definition: "A panel cleaning should be triggered when either: (1) meet Soiling Cleaning Threshold (2) >30 days since last cleaning—whichever occurs first.", source_file: "solar_kb.jsonl", source_line: 51, source_id: 51, search_text: "Cleaning Triggers domain_knowledge Combined conditions that determine when solar panel cleaning is economically justified. A panel cleaning should be triggered when either: (1) meet Soiling Cleaning Threshold (2) >30 days since last cleaning—whichever occurs first."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:52"}) SET n = {id: "solar:52", name: "Degradation Severity Classification", type: "domain_knowledge", description: "Defines thresholds for high, moderate, and normal degradation based on NDI value.", definition: "Panels are classified as 'High Degradation' if NDI exceeds 1.5, 'Moderate Degradation' if NDI is between 1.0 and 1.5, and 'Normal Degradation' if below 1.0.", source_file: "solar_kb.jsonl", source_line: 52, source_id: 52, search_text: "Degradation Severity Classification domain_knowledge Defines thresholds for high, moderate, and normal degradation based on NDI value. Panels are classified as 'High Degradation' if NDI exceeds 1.5, 'Moderate Degradation' if NDI is between 1.0 and 1.5, and 'Normal Degradation' if below 1.0."};
MERGE (n:Knowledge:SemanticSearch {id: "solar:53"}) SET n = {id: "solar:53", name: "Alert Specification Protocol", type: "domain_knowledge", description: "Comprehensive rules for generating performance alerts", definition: "Mandates that critical alerts must: (1) Reference the plant ID, panel ID and performance record; (2) Set status to 'Critical'; (3) Assign 'High' maintenance priority; (4) Set replacement priority to 'High' if performance <60% of expected, otherwise 'Medium'; (5) Mark optimization potential as 'High'; (6) Use 'ALERT_' prefix with random hash for IDs; (7) Update existing alerts within 30-day window rather than creating duplicates", source_file: "solar_kb.jsonl", source_line: 53, source_id: 53, search_text: "Alert Specification Protocol domain_knowledge Comprehensive rules for generating performance alerts Mandates that critical alerts must: (1) Reference the plant ID, panel ID and performance record; (2) Set status to 'Critical'; (3) Assign 'High' maintenance priority; (4) Set replacement priority to 'High' if performance <60% of expected, otherwise 'Medium'; (5) Mark optimization potential as 'High'; (6) Use 'ALERT_' prefix with random hash for IDs; (7) Update existing alerts within 30-day window rather than creating duplicates"};
MATCH (d:Database {id: "vaccine"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "vaccine:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "vaccine:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "vaccine:" AND NOT stale.id IN ["vaccine:0", "vaccine:1", "vaccine:2", "vaccine:3", "vaccine:4", "vaccine:5", "vaccine:6", "vaccine:7", "vaccine:8", "vaccine:9", "vaccine:10", "vaccine:11", "vaccine:12", "vaccine:13", "vaccine:14", "vaccine:15", "vaccine:16", "vaccine:17", "vaccine:18", "vaccine:19", "vaccine:20", "vaccine:21", "vaccine:22", "vaccine:23", "vaccine:24", "vaccine:25", "vaccine:26", "vaccine:27", "vaccine:28", "vaccine:29", "vaccine:30", "vaccine:31", "vaccine:32", "vaccine:33", "vaccine:34", "vaccine:35", "vaccine:36", "vaccine:37", "vaccine:38", "vaccine:39", "vaccine:40", "vaccine:41", "vaccine:42", "vaccine:43", "vaccine:44", "vaccine:45", "vaccine:46", "vaccine:47", "vaccine:48", "vaccine:49", "vaccine:50", "vaccine:51", "vaccine:52", "vaccine:53", "vaccine:54", "vaccine:55", "vaccine:56", "vaccine:57", "vaccine:58", "vaccine:59", "vaccine:60", "vaccine:61", "vaccine:62", "vaccine:63", "vaccine:64", "vaccine:65"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:0"}) SET n = {id: "vaccine:0", name: "Temperature Stability Score (TSS)", type: "calculation_knowledge", description: "Calculates the overall temperature stability of a container based on deviations and critical events.", definition: "TSS = (1 - \\frac{TempDevCount}{100}) \\times (1 - \\frac{CritEvents}{10}) \\times TempStabIdx", source_file: "vaccine_kb.jsonl", source_line: 1, source_id: 0, search_text: "Temperature Stability Score (TSS) calculation_knowledge Calculates the overall temperature stability of a container based on deviations and critical events. TSS = (1 - \\frac{TempDevCount}{100}) \\times (1 - \\frac{CritEvents}{10}) \\times TempStabIdx"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:1"}) SET n = {id: "vaccine:1", name: "Coolant Depletion Rate (CDR)", type: "calculation_knowledge", description: "Measures how quickly the coolant is being depleted.", definition: "CDR = \\frac{100 - CoolRemainPct}{(Current_Date - RefillLatest)}", source_file: "vaccine_kb.jsonl", source_line: 2, source_id: 1, search_text: "Coolant Depletion Rate (CDR) calculation_knowledge Measures how quickly the coolant is being depleted. CDR = \\frac{100 - CoolRemainPct}{(Current_Date - RefillLatest)}"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:2"}) SET n = {id: "vaccine:2", name: "Container Risk Index (CRI)", type: "calculation_knowledge", description: "Calculates overall risk level for a container based on temperature stability and coolant status.", definition: "CRI = (1 - TSS) \\times (1 - \\frac{CoolRemainPct}{100})", source_file: "vaccine_kb.jsonl", source_line: 3, source_id: 2, search_text: "Container Risk Index (CRI) calculation_knowledge Calculates overall risk level for a container based on temperature stability and coolant status. CRI = (1 - TSS) \\times (1 - \\frac{CoolRemainPct}{100})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:3"}) SET n = {id: "vaccine:3", name: "Vaccine Viability Period (VVP)", type: "calculation_knowledge", description: "Calculates remaining viable days for vaccines considering temperature deviations.", definition: "VVP = (ExpireDay - Current_Date) \\times TSS", source_file: "vaccine_kb.jsonl", source_line: 4, source_id: 3, search_text: "Vaccine Viability Period (VVP) calculation_knowledge Calculates remaining viable days for vaccines considering temperature deviations. VVP = (ExpireDay - Current_Date) \\times TSS"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:4"}) SET n = {id: "vaccine:4", name: "Route Completion Percentage (RCP)", type: "calculation_knowledge", description: "Calculates the percentage of route completed.", definition: "RCP = \\frac{DistDoneKm}{DistDoneKm + DistLeftKm} \\times 100", source_file: "vaccine_kb.jsonl", source_line: 5, source_id: 4, search_text: "Route Completion Percentage (RCP) calculation_knowledge Calculates the percentage of route completed. RCP = \\frac{DistDoneKm}{DistDoneKm + DistLeftKm} \\times 100"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:5"}) SET n = {id: "vaccine:5", name: "Storage Efficiency Ratio (SER)", type: "calculation_knowledge", description: "Measures how efficiently container volume is utilized.", definition: "SER = \\frac{VialTally \\times 10}{VolLiters}", source_file: "vaccine_kb.jsonl", source_line: 6, source_id: 5, search_text: "Storage Efficiency Ratio (SER) calculation_knowledge Measures how efficiently container volume is utilized. SER = \\frac{VialTally \\times 10}{VolLiters}"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:6"}) SET n = {id: "vaccine:6", name: "Logger Health Index (LHI)", type: "calculation_knowledge", description: "Overall health score for data logger.", definition: "LHI = \\frac{BatteryPct}{100} \\times (1 - \\frac{MemUsePct}{100}) \\times \\frac{DataPct}{100}", source_file: "vaccine_kb.jsonl", source_line: 7, source_id: 6, search_text: "Logger Health Index (LHI) calculation_knowledge Overall health score for data logger. LHI = \\frac{BatteryPct}{100} \\times (1 - \\frac{MemUsePct}{100}) \\times \\frac{DataPct}{100}"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:7"}) SET n = {id: "vaccine:7", name: "Maintenance Compliance Score (MCS)", type: "calculation_knowledge", description: "Calculates compliance with maintenance schedules.", definition: "MCS = CompScore \\times (1 - \\frac{Incidents}{10})", source_file: "vaccine_kb.jsonl", source_line: 8, source_id: 7, search_text: "Maintenance Compliance Score (MCS) calculation_knowledge Calculates compliance with maintenance schedules. MCS = CompScore \\times (1 - \\frac{Incidents}{10})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:8"}) SET n = {id: "vaccine:8", name: "Handling Quality Index (HQI)", type: "calculation_knowledge", description: "Measures quality of shipment handling.", definition: "HQI = (1 - \\frac{HandleEvents}{100}) \\times (1 - \\frac{CritEvents}{10})", source_file: "vaccine_kb.jsonl", source_line: 9, source_id: 8, search_text: "Handling Quality Index (HQI) calculation_knowledge Measures quality of shipment handling. HQI = (1 - \\frac{HandleEvents}{100}) \\times (1 - \\frac{CritEvents}{10})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:9"}) SET n = {id: "vaccine:9", name: "Temperature Breach Severity (TBS)", type: "calculation_knowledge", description: "Calculates severity of temperature breaches.", definition: "TBS = \\frac{|TempNowC - StoreTempC|}{TempTolC} \\times TempDevCount", source_file: "vaccine_kb.jsonl", source_line: 10, source_id: 9, search_text: "Temperature Breach Severity (TBS) calculation_knowledge Calculates severity of temperature breaches. TBS = \\frac{|TempNowC - StoreTempC|}{TempTolC} \\times TempDevCount"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:10"}) SET n = {id: "vaccine:10", name: "Container Health Status", type: "domain_knowledge", description: "Classifies containers based on overall risk and temperature stability to prioritize immediate action and monitor operational trends.", definition: "Four-level classification based on CRI, TSS, and TBS:\n- Critical: CRI > 0.6 OR current TSS < 0.4\n- Unstable: Average TSS < 0.4 OR maximum TBS > 1.5 over the past 1 year, and not Critical\n- Moderate: Average TSS >= 0.4 AND maximum TBS <= 1.5 over the past 1 year, and not Critical\n- Stable: Average TSS >= 0.7 AND maximum TBS <= 1.0 over the past 1 year, and not Critical", source_file: "vaccine_kb.jsonl", source_line: 11, source_id: 10, search_text: "Container Health Status domain_knowledge Classifies containers based on overall risk and temperature stability to prioritize immediate action and monitor operational trends. Four-level classification based on CRI, TSS, and TBS:\n- Critical: CRI > 0.6 OR current TSS < 0.4\n- Unstable: Average TSS < 0.4 OR maximum TBS > 1.5 over the past 1 year, and not Critical\n- Moderate: Average TSS >= 0.4 AND maximum TBS <= 1.5 over the past 1 year, and not Critical\n- Stable: Average TSS >= 0.7 AND maximum TBS <= 1.0 over the past 1 year, and not Critical"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:11"}) SET n = {id: "vaccine:11", name: "Compromised Shipment", type: "domain_knowledge", description: "Identifies shipments with serious integrity issues.", definition: "A shipment with IntegrityMark='Compromised' or SealFlag='Broken' or TamperSign='Confirmed'", source_file: "vaccine_kb.jsonl", source_line: 12, source_id: 11, search_text: "Compromised Shipment domain_knowledge Identifies shipments with serious integrity issues. A shipment with IntegrityMark='Compromised' or SealFlag='Broken' or TamperSign='Confirmed'"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:12"}) SET n = {id: "vaccine:12", name: "High-Risk Route", type: "domain_knowledge", description: "Identifies high-risk transportation routes.", definition: "A route where RCP < 50% and CRI > 0.4", source_file: "vaccine_kb.jsonl", source_line: 13, source_id: 12, search_text: "High-Risk Route domain_knowledge Identifies high-risk transportation routes. A route where RCP < 50% and CRI > 0.4"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:13"}) SET n = {id: "vaccine:13", name: "Maintenance Due", type: "domain_knowledge", description: "Identifies equipment requiring maintenance.", definition: "Equipment where MCS < 0.7 and (Current_Date > MaintDateNext or Current_Date > CalibDateNext)", source_file: "vaccine_kb.jsonl", source_line: 14, source_id: 13, search_text: "Maintenance Due domain_knowledge Identifies equipment requiring maintenance. Equipment where MCS < 0.7 and (Current_Date > MaintDateNext or Current_Date > CalibDateNext)"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:14"}) SET n = {id: "vaccine:14", name: "Stable Transport", type: "domain_knowledge", description: "Identifies stable transport conditions.", definition: "Transport where HQI > 0.9 and TSS > 0.8", source_file: "vaccine_kb.jsonl", source_line: 15, source_id: 14, search_text: "Stable Transport domain_knowledge Identifies stable transport conditions. Transport where HQI > 0.9 and TSS > 0.8"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:15"}) SET n = {id: "vaccine:15", name: "Logger Failure Risk", type: "domain_knowledge", description: "Identifies loggers at risk of failure.", definition: "A logger where LHI < 0.3 or (BatteryPct < 20 and PwrBackupFlag='Not Available')", source_file: "vaccine_kb.jsonl", source_line: 16, source_id: 15, search_text: "Logger Failure Risk domain_knowledge Identifies loggers at risk of failure. A logger where LHI < 0.3 or (BatteryPct < 20 and PwrBackupFlag='Not Available')"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:16"}) SET n = {id: "vaccine:16", name: "Temperature Alert", type: "domain_knowledge", description: "Identifies critical temperature conditions.", definition: "A condition where TBS > 2.0 and TempDevCount > 5", source_file: "vaccine_kb.jsonl", source_line: 17, source_id: 16, search_text: "Temperature Alert domain_knowledge Identifies critical temperature conditions. A condition where TBS > 2.0 and TempDevCount > 5"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:17"}) SET n = {id: "vaccine:17", name: "Coolant Critical", type: "domain_knowledge", description: "Identifies critical coolant conditions.", definition: "A condition where CDR > 1 and CoolRemainPct < 30", source_file: "vaccine_kb.jsonl", source_line: 18, source_id: 17, search_text: "Coolant Critical domain_knowledge Identifies critical coolant conditions. A condition where CDR > 1 and CoolRemainPct < 30"};

MERGE (n:Knowledge:SemanticSearch {id: "vaccine:63"}) SET n = {id: "vaccine:63", name: "Efficiency Rank", type: "domain_knowledge", description: "Ranks containers based on their storage efficiency.", definition: "Rank assigned to containers based on descending order of SER", source_file: "vaccine_kb.jsonl", source_line: 64, source_id: 63, search_text: "Efficiency Rank domain_knowledge Ranks containers based on their storage efficiency. Rank assigned to containers based on descending order of SER"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:64"}) SET n = {id: "vaccine:64", name: "Risk Rank", type: "domain_knowledge", description: "Ranks containers based on their risk level.", definition: "Rank assigned to containers based on descending order of CRI", source_file: "vaccine_kb.jsonl", source_line: 65, source_id: 64, search_text: "Risk Rank domain_knowledge Ranks containers based on their risk level. Rank assigned to containers based on descending order of CRI"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:65"}) SET n = {id: "vaccine:65", name: "Urgency Rank", type: "calculation_knowledge", description: "Ranks vehicles based on maintenance risk and overdue days.", definition: "\\text{Rank assigned to vehicles based on descending order of } \\text{CMR} + \\text{DaysOverdue} / 30", source_file: "vaccine_kb.jsonl", source_line: 66, source_id: 65, search_text: "Urgency Rank calculation_knowledge Ranks vehicles based on maintenance risk and overdue days. \\text{Rank assigned to vehicles based on descending order of } \\text{CMR} + \\text{DaysOverdue} / 30"};
MATCH (d:Database {id: "virtual"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "virtual:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "virtual:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "virtual:" AND NOT stale.id IN ["virtual:0", "virtual:1", "virtual:2", "virtual:3", "virtual:4", "virtual:5", "virtual:6", "virtual:7", "virtual:8", "virtual:9", "virtual:10", "virtual:11", "virtual:12", "virtual:13", "virtual:14", "virtual:15", "virtual:16", "virtual:17", "virtual:18", "virtual:19", "virtual:20", "virtual:21", "virtual:22", "virtual:23", "virtual:24", "virtual:25", "virtual:26", "virtual:27", "virtual:28", "virtual:29", "virtual:30", "virtual:31", "virtual:32", "virtual:33", "virtual:34", "virtual:35", "virtual:36", "virtual:37", "virtual:38", "virtual:39", "virtual:40", "virtual:41", "virtual:42", "virtual:43", "virtual:44", "virtual:45", "virtual:46", "virtual:47", "virtual:48", "virtual:49", "virtual:50", "virtual:51", "virtual:52", "virtual:53", "virtual:54"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "virtual:0"}) SET n = {id: "virtual:0", name: "fans.statustag", type: "value_illustration", description: "Explains the meaning of fan account status and its impact on platform interactions", definition: "Fan status typically falls into four categories: 'Active' indicates normal users with full access to all features; 'VIP' represents premium users with privileged services; 'Inactive' refers to dormant accounts with no login for over 30 days, with some features restricted; 'Blocked' means accounts temporarily or permanently banned due to violations, with no access to platform features.", source_file: "virtual_kb.jsonl", source_line: 1, source_id: 0, search_text: "fans.statustag value_illustration Explains the meaning of fan account status and its impact on platform interactions Fan status typically falls into four categories: 'Active' indicates normal users with full access to all features; 'VIP' represents premium users with privileged services; 'Inactive' refers to dormant accounts with no login for over 30 days, with some features restricted; 'Blocked' means accounts temporarily or permanently banned due to violations, with no access to platform features."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:1"}) SET n = {id: "virtual:1", name: "fans.tierstep", type: "value_illustration", description: "Explains the practical significance of fan tier levels", definition: "Fan tiers (tierstep) start at 1 and increase progressively, representing different loyalty levels and privileges: Tiers 1-3 are 'Entry-level' fans (newly joined), tiers 4-7 represent 'Mid-level' fans (stable supporters), tiers 8-10 are 'High-level fans (long-term loyal followers), and tiers above 10 are 'Core' fans (foundational idol supporters). Any accounts with missing or invalid tier values are classified as 'Undefined' and require administrative review. Each tier level grants new privileges and increases platform visibility.", source_file: "virtual_kb.jsonl", source_line: 2, source_id: 1, search_text: "fans.tierstep value_illustration Explains the practical significance of fan tier levels Fan tiers (tierstep) start at 1 and increase progressively, representing different loyalty levels and privileges: Tiers 1-3 are 'Entry-level' fans (newly joined), tiers 4-7 represent 'Mid-level' fans (stable supporters), tiers 8-10 are 'High-level fans (long-term loyal followers), and tiers above 10 are 'Core' fans (foundational idol supporters). Any accounts with missing or invalid tier values are classified as 'Undefined' and require administrative review. Each tier level grants new privileges and increases platform visibility."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:2"}) SET n = {id: "virtual:2", name: "virtualidols.kindtag", type: "value_illustration", description: "Explains technical and performance characteristics of different virtual idol types", definition: "'2D' represents two-dimensional animated characters, suitable for anime-style performances with limited interactivity; '3D' refers to three-dimensional modeled characters with more natural movements capable of complex performances; 'AI Generated' indicates characters created using AI technology with high uniqueness but requiring consistency monitoring; 'Mixed Reality' describes characters that can interact with real-world elements, requiring the highest technical threshold.", source_file: "virtual_kb.jsonl", source_line: 3, source_id: 2, search_text: "virtualidols.kindtag value_illustration Explains technical and performance characteristics of different virtual idol types '2D' represents two-dimensional animated characters, suitable for anime-style performances with limited interactivity; '3D' refers to three-dimensional modeled characters with more natural movements capable of complex performances; 'AI Generated' indicates characters created using AI technology with high uniqueness but requiring consistency monitoring; 'Mixed Reality' describes characters that can interact with real-world elements, requiring the highest technical threshold."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:3"}) SET n = {id: "virtual:3", name: "membershipandspending.membkind", type: "value_illustration", description: "Explains the benefit differences between membership types", definition: "'Free' users can access only basic content with approximately 10 hours of viewable content per month; 'Basic' members (about $5 monthly) receive reduced ads and access to additional content; 'Premium' members (about $10-15 monthly) get ad-free experience, exclusive content, and priority viewing; 'Diamond' members (above $25 monthly) receive all benefits plus 1-on-1 interaction opportunities and physical merchandise.", source_file: "virtual_kb.jsonl", source_line: 4, source_id: 3, search_text: "membershipandspending.membkind value_illustration Explains the benefit differences between membership types 'Free' users can access only basic content with approximately 10 hours of viewable content per month; 'Basic' members (about $5 monthly) receive reduced ads and access to additional content; 'Premium' members (about $10-15 monthly) get ad-free experience, exclusive content, and priority viewing; 'Diamond' members (above $25 monthly) receive all benefits plus 1-on-1 interaction opportunities and physical merchandise."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:4"}) SET n = {id: "virtual:4", name: "engagement.actfreq", type: "value_illustration", description: "Analyzes the significance of interaction frequency for fan classification", definition: "'Daily' users log into the platform at least once per day on average; 'Weekly' users log in 3-5 times per week; 'Monthly' users log in 1-2 times per month; 'Occasional' users have login intervals exceeding one month. Interaction frequency affects platform push priority, content recommendations, and event invitations, with Daily users considered the platform's core active group.", source_file: "virtual_kb.jsonl", source_line: 5, source_id: 4, search_text: "engagement.actfreq value_illustration Analyzes the significance of interaction frequency for fan classification 'Daily' users log into the platform at least once per day on average; 'Weekly' users log in 3-5 times per week; 'Monthly' users log in 1-2 times per month; 'Occasional' users have login intervals exceeding one month. Interaction frequency affects platform push priority, content recommendations, and event invitations, with Daily users considered the platform's core active group."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:5"}) SET n = {id: "virtual:5", name: "engagement.engrate", type: "value_illustration", description: "Explains the calculation basis and business significance of fan engagement rate", definition: "Engagement rate (engrate) typically ranges from 0 to 1.000, with higher values indicating more active fans. 0-0.200 represents low engagement (viewing only without participation), 0.201-0.500 indicates moderate engagement (occasional comments and likes), 0.501-0.800 shows high engagement (frequent comments and sharing), and 0.801-1.000 represents ultra-high engagement (comprehensive deep participation in content co-creation). Platforms generally consider rates above 0.500 as quality fans.", source_file: "virtual_kb.jsonl", source_line: 6, source_id: 5, search_text: "engagement.engrate value_illustration Explains the calculation basis and business significance of fan engagement rate Engagement rate (engrate) typically ranges from 0 to 1.000, with higher values indicating more active fans. 0-0.200 represents low engagement (viewing only without participation), 0.201-0.500 indicates moderate engagement (occasional comments and likes), 0.501-0.800 shows high engagement (frequent comments and sharing), and 0.801-1.000 represents ultra-high engagement (comprehensive deep participation in content co-creation). Platforms generally consider rates above 0.500 as quality fans."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:6"}) SET n = {id: "virtual:6", name: "socialcommunity.community_engagement.content_creation.contqualrate", type: "value_illustration", description: "Explains content quality rating standards and classification", definition: "Content quality rating (contqualrate) ranges from 0-10.0: 0-3.9 points indicate low-quality content (potentially violating rules or poor quality); 4.0-6.9 points represent medium-quality content (meeting basic platform standards); 7.0-8.9 points indicate high-quality content (well-produced and creative); 9.0-10.0 points represent premium content (platform recommendation level). Quality ratings affect content recommendations, exposure, and creator incentives.", source_file: "virtual_kb.jsonl", source_line: 7, source_id: 6, search_text: "socialcommunity.community_engagement.content_creation.contqualrate value_illustration Explains content quality rating standards and classification Content quality rating (contqualrate) ranges from 0-10.0: 0-3.9 points indicate low-quality content (potentially violating rules or poor quality); 4.0-6.9 points represent medium-quality content (meeting basic platform standards); 7.0-8.9 points indicate high-quality content (well-produced and creative); 9.0-10.0 points represent premium content (platform recommendation level). Quality ratings affect content recommendations, exposure, and creator incentives."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:7"}) SET n = {id: "virtual:7", name: "interactions.gifttot_interactions.giftvalusd", type: "value_illustration", description: "Explains the statistical significance of gift quantity and value", definition: "gifttot represents the total number of gifts sent by fans, typically classified as: fewer than 10 is considered minimal gifting, 10-50 represents moderate support, and above 50 indicates substantial support; giftvalusd represents the USD value of gifts, generally $1-5 for small support, $5-20 for moderate support, $20-100 for large support, and above $100 for super support. Both metrics combined assess a fan's economic support level.", source_file: "virtual_kb.jsonl", source_line: 8, source_id: 7, search_text: "interactions.gifttot_interactions.giftvalusd value_illustration Explains the statistical significance of gift quantity and value gifttot represents the total number of gifts sent by fans, typically classified as: fewer than 10 is considered minimal gifting, 10-50 represents moderate support, and above 50 indicates substantial support; giftvalusd represents the USD value of gifts, generally $1-5 for small support, $5-20 for moderate support, $20-100 for large support, and above $100 for super support. Both metrics combined assess a fan's economic support level."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:8"}) SET n = {id: "virtual:8", name: "retentionandinfluence.churnflag", type: "value_illustration", description: "Explains the judgment basis for churn risk rating", definition: "'None' indicates extremely low churn risk, with users maintaining high-frequency interaction and recent consumption; 'Low' represents slight churn risk with slightly decreased login frequency; 'Medium' indicates moderate churn risk with significantly decreased interaction and consumption frequency and increased login intervals; 'High' represents severe churn risk with no logins or interactions in the past 14-30 days, requiring immediate intervention.", source_file: "virtual_kb.jsonl", source_line: 9, source_id: 8, search_text: "retentionandinfluence.churnflag value_illustration Explains the judgment basis for churn risk rating 'None' indicates extremely low churn risk, with users maintaining high-frequency interaction and recent consumption; 'Low' represents slight churn risk with slightly decreased login frequency; 'Medium' indicates moderate churn risk with significantly decreased interaction and consumption frequency and increased login intervals; 'High' represents severe churn risk with no logins or interactions in the past 14-30 days, requiring immediate intervention."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:9"}) SET n = {id: "virtual:9", name: "loyaltyandachievements.reward_progress.loyalty.loypts", type: "value_illustration", description: "Explains the accumulation and application value of loyalty points", definition: "Loyalty points (loypts) are cumulative rewards for fan activities: 0-1000 points is entry-level (redeemable for basic digital items); 1001-5000 points is intermediate level (redeemable for limited-time privileges and mid-level digital items); 5001-20000 points is advanced level (redeemable for limited merchandise and activity priorities); above 20000 points is expert level (invitations to participate in platform decisions and idol development). Points are typically earned through logins, purchases, and activity participation.", source_file: "virtual_kb.jsonl", source_line: 10, source_id: 9, search_text: "loyaltyandachievements.reward_progress.loyalty.loypts value_illustration Explains the accumulation and application value of loyalty points Loyalty points (loypts) are cumulative rewards for fan activities: 0-1000 points is entry-level (redeemable for basic digital items); 1001-5000 points is intermediate level (redeemable for limited-time privileges and mid-level digital items); 5001-20000 points is advanced level (redeemable for limited merchandise and activity priorities); above 20000 points is expert level (invitations to participate in platform decisions and idol development). Points are typically earned through logins, purchases, and activity participation."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:10"}) SET n = {id: "virtual:10", name: "Fan Engagement Index (FEI)", type: "calculation_knowledge", description: "A comprehensive metric measuring fan activity level with platform and virtual idols", definition: "FEI = (engrate \\times 0.4) + (\\frac{socintscore}{100} \\times 0.3) + (\\frac{actdayswk}{7} \\times 0.2) + (\\frac{avgsesscount}{10} \\times 0.1), \\text{ where weights reflect each factor's different contribution to engagement, with results ranging from 0-1. Higher values indicate more engaged fans.}", source_file: "virtual_kb.jsonl", source_line: 11, source_id: 10, search_text: "Fan Engagement Index (FEI) calculation_knowledge A comprehensive metric measuring fan activity level with platform and virtual idols FEI = (engrate \\times 0.4) + (\\frac{socintscore}{100} \\times 0.3) + (\\frac{actdayswk}{7} \\times 0.2) + (\\frac{avgsesscount}{10} \\times 0.1), \\text{ where weights reflect each factor's different contribution to engagement, with results ranging from 0-1. Higher values indicate more engaged fans.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:11"}) SET n = {id: "virtual:11", name: "Monetization Value (MV)", type: "calculation_knowledge", description: "Calculates the monetary value a fan brings to the platform over time", definition: "MV = spendusd \\times \\left(1 + \\frac{membdays}{365} \\times 0.5\\right) \\times \\left(1 + \\frac{gifttot}{10} \\times 0.2\\right), \\text{ where the formula adjusts spending based on membership duration and gift activity to reflect long-term value.}", source_file: "virtual_kb.jsonl", source_line: 12, source_id: 11, search_text: "Monetization Value (MV) calculation_knowledge Calculates the monetary value a fan brings to the platform over time MV = spendusd \\times \\left(1 + \\frac{membdays}{365} \\times 0.5\\right) \\times \\left(1 + \\frac{gifttot}{10} \\times 0.2\\right), \\text{ where the formula adjusts spending based on membership duration and gift activity to reflect long-term value.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:12"}) SET n = {id: "virtual:12", name: "Content Creation Impact Score (CCIS)", type: "calculation_knowledge", description: "Measures the impact of fan-created content on the community", definition: "CCIS = contqualrate \\times \\left(\\frac{ugcval}{10}\\right) \\times \\left(1 + \\frac{follcount}{100} \\times 0.5\\right), \\text{ where content quality is multiplied by normalized content volume and amplified by follower reach.}", source_file: "virtual_kb.jsonl", source_line: 13, source_id: 12, search_text: "Content Creation Impact Score (CCIS) calculation_knowledge Measures the impact of fan-created content on the community CCIS = contqualrate \\times \\left(\\frac{ugcval}{10}\\right) \\times \\left(1 + \\frac{follcount}{100} \\times 0.5\\right), \\text{ where content quality is multiplied by normalized content volume and amplified by follower reach.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:13"}) SET n = {id: "virtual:13", name: "Retention Risk Factor (RRF)", type: "calculation_knowledge", description: "Quantifies the risk of fan churn based on multiple behavioral indicators", definition: "RRF = (1 - intconsist) \\times 2 + \\left(\\frac{CURRENT\\_DATE - lastlogdt}{30}\\right) \\times 0.5 + \\left(\\frac{churnflag\\_numeric}{3}\\right) \\times 2, \\text{ where churnflag\\_numeric maps churnflag enum: None=0, Low=1, Medium=2, High=3.}", source_file: "virtual_kb.jsonl", source_line: 14, source_id: 13, search_text: "Retention Risk Factor (RRF) calculation_knowledge Quantifies the risk of fan churn based on multiple behavioral indicators RRF = (1 - intconsist) \\times 2 + \\left(\\frac{CURRENT\\_DATE - lastlogdt}{30}\\right) \\times 0.5 + \\left(\\frac{churnflag\\_numeric}{3}\\right) \\times 2, \\text{ where churnflag\\_numeric maps churnflag enum: None=0, Low=1, Medium=2, High=3.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:14"}) SET n = {id: "virtual:14", name: "Social Influence Multiplier (SIM)", type: "calculation_knowledge", description: "Calculates how much a fan amplifies content through their social network", definition: "SIM = \\left(\\frac{follcount}{100}\\right) \\times (engrate \\times 2) \\times (viralcont + 1) \\times 0.5, \\text{ reflecting the fan's ability to spread content through their network based on their following, engagement level, and history of creating viral content.}", source_file: "virtual_kb.jsonl", source_line: 15, source_id: 14, search_text: "Social Influence Multiplier (SIM) calculation_knowledge Calculates how much a fan amplifies content through their social network SIM = \\left(\\frac{follcount}{100}\\right) \\times (engrate \\times 2) \\times (viralcont + 1) \\times 0.5, \\text{ reflecting the fan's ability to spread content through their network based on their following, engagement level, and history of creating viral content.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:15"}) SET n = {id: "virtual:15", name: "Loyalty Progression Rate (LPR)", type: "calculation_knowledge", description: "Measures how quickly a fan is accumulating loyalty within the system", definition: "LPR = \\left(\\frac{loypts}{membdays}\\right) \\times (1 + (engrate \\times 2)), \\text{ showing points earned per day adjusted by engagement level to identify rapidly advancing fans.}", source_file: "virtual_kb.jsonl", source_line: 16, source_id: 15, search_text: "Loyalty Progression Rate (LPR) calculation_knowledge Measures how quickly a fan is accumulating loyalty within the system LPR = \\left(\\frac{loypts}{membdays}\\right) \\times (1 + (engrate \\times 2)), \\text{ showing points earned per day adjusted by engagement level to identify rapidly advancing fans.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:16"}) SET n = {id: "virtual:16", name: "Fan Lifetime Value (FLV)", type: "calculation_knowledge", description: "Projects the total economic value of a fan throughout their relationship with the platform", definition: "FLV = MV \\times \\left(1 - \\frac{RRF}{10}\\right) \\times (1 + FEI) \\times 24, \\text{ estimating 24-month value adjusted by retention risk and engagement level.}", source_file: "virtual_kb.jsonl", source_line: 17, source_id: 16, search_text: "Fan Lifetime Value (FLV) calculation_knowledge Projects the total economic value of a fan throughout their relationship with the platform FLV = MV \\times \\left(1 - \\frac{RRF}{10}\\right) \\times (1 + FEI) \\times 24, \\text{ estimating 24-month value adjusted by retention risk and engagement level.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:17"}) SET n = {id: "virtual:17", name: "Community Contribution Index (CCI)", type: "calculation_knowledge", description: "Measures a fan's overall contribution to the virtual idol community", definition: "CCI = (CCIS \\times 0.4) + (SIM \\times 0.3) + (collabcount \\times 0.1) + (FEI \\times 0.2), \\text{ balancing content creation, social influence, collaboration activity, and general engagement.}", source_file: "virtual_kb.jsonl", source_line: 18, source_id: 17, search_text: "Community Contribution Index (CCI) calculation_knowledge Measures a fan's overall contribution to the virtual idol community CCI = (CCIS \\times 0.4) + (SIM \\times 0.3) + (collabcount \\times 0.1) + (FEI \\times 0.2), \\text{ balancing content creation, social influence, collaboration activity, and general engagement.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:18"}) SET n = {id: "virtual:18", name: "Event ROI Potential (ERP)", type: "calculation_knowledge", description: "Estimates the potential return on investment for inviting a fan to exclusive events", definition: "ERP = FLV \\times \\left(\\frac{evtpart\\_numeric}{3}\\right) \\times \\left(\\frac{tierstep}{5}\\right) \\times \\left(1 + \\frac{inflscore}{100}\\right), \\text{ where evtpart\\_numeric maps participation\\_summary.event\\_attendance.evtpart enum values: Never=0, Rare=1, Regular=2, Always=3. Higher scores indicate fans likely to generate more value when included in events.}", source_file: "virtual_kb.jsonl", source_line: 19, source_id: 18, search_text: "Event ROI Potential (ERP) calculation_knowledge Estimates the potential return on investment for inviting a fan to exclusive events ERP = FLV \\times \\left(\\frac{evtpart\\_numeric}{3}\\right) \\times \\left(\\frac{tierstep}{5}\\right) \\times \\left(1 + \\frac{inflscore}{100}\\right), \\text{ where evtpart\\_numeric maps participation\\_summary.event\\_attendance.evtpart enum values: Never=0, Rare=1, Regular=2, Always=3. Higher scores indicate fans likely to generate more value when included in events.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:19"}) SET n = {id: "virtual:19", name: "Support Efficiency Index (SEI)", type: "calculation_knowledge", description: "Measures the efficiency of platform resources spent on supporting a fan", definition: "SEI = \\frac{satrate}{(supptix + 1)} \\times \\left(1 + \\frac{FLV}{100}\\right), \\text{ where higher values indicate fans who provide good platform ratings with minimal support requirements, adjusted by their lifetime value.}", source_file: "virtual_kb.jsonl", source_line: 20, source_id: 19, search_text: "Support Efficiency Index (SEI) calculation_knowledge Measures the efficiency of platform resources spent on supporting a fan SEI = \\frac{satrate}{(supptix + 1)} \\times \\left(1 + \\frac{FLV}{100}\\right), \\text{ where higher values indicate fans who provide good platform ratings with minimal support requirements, adjusted by their lifetime value.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:20"}) SET n = {id: "virtual:20", name: "Superfan", type: "domain_knowledge", description: "Identifies fans with exceptional platform value and engagement", definition: "A fan with tierstep ≥ 8, FEI > 0.7, and MV > 200, representing the highest value segment providing substantial financial support while maintaining high engagement.", source_file: "virtual_kb.jsonl", source_line: 21, source_id: 20, search_text: "Superfan domain_knowledge Identifies fans with exceptional platform value and engagement A fan with tierstep ≥ 8, FEI > 0.7, and MV > 200, representing the highest value segment providing substantial financial support while maintaining high engagement."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:21"}) SET n = {id: "virtual:21", name: "Content Creator", type: "domain_knowledge", description: "Identifies fans who actively produce and share idol-related content", definition: "A fan with ugcval > 20, contqualrate > 7.0, and at least one of: artsubs > 3, ficsubs > 2, or coverperfcnt > 0. These fans contribute significantly to community content ecosystem.", source_file: "virtual_kb.jsonl", source_line: 22, source_id: 21, search_text: "Content Creator domain_knowledge Identifies fans who actively produce and share idol-related content A fan with ugcval > 20, contqualrate > 7.0, and at least one of: artsubs > 3, ficsubs > 2, or coverperfcnt > 0. These fans contribute significantly to community content ecosystem."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:22"}) SET n = {id: "virtual:22", name: "Social Amplifier", type: "domain_knowledge", description: "Identifies fans who significantly extend idol content reach", definition: "A fan with follcount > 500, SIM > 2.0, and viralcont ≥ 1, representing users who effectively spread idol content through their substantial social networks.", source_file: "virtual_kb.jsonl", source_line: 23, source_id: 22, search_text: "Social Amplifier domain_knowledge Identifies fans who significantly extend idol content reach A fan with follcount > 500, SIM > 2.0, and viralcont ≥ 1, representing users who effectively spread idol content through their substantial social networks."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:23"}) SET n = {id: "virtual:23", name: "Churn Candidate", type: "domain_knowledge", description: "Identifies fans at immediate risk of platform abandonment", definition: "A fan with RRF > 3.5, lastlogdt more than 20 days in the past, and engrate < 0.2, requiring immediate retention efforts.", source_file: "virtual_kb.jsonl", source_line: 24, source_id: 23, search_text: "Churn Candidate domain_knowledge Identifies fans at immediate risk of platform abandonment A fan with RRF > 3.5, lastlogdt more than 20 days in the past, and engrate < 0.2, requiring immediate retention efforts."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:24"}) SET n = {id: "virtual:24", name: "Silent Supporter", type: "domain_knowledge", description: "Identifies financially supportive fans with low social visibility", definition: "A fan with MV > 100, engrate < 0.3, and chatmsg/sesscount ratio < 0.5, representing valuable economic contributors who prefer to observe rather than actively participate in community activities.", source_file: "virtual_kb.jsonl", source_line: 25, source_id: 24, search_text: "Silent Supporter domain_knowledge Identifies financially supportive fans with low social visibility A fan with MV > 100, engrate < 0.3, and chatmsg/sesscount ratio < 0.5, representing valuable economic contributors who prefer to observe rather than actively participate in community activities."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:25"}) SET n = {id: "virtual:25", name: "Community Pillar", type: "domain_knowledge", description: "Identifies fans who form the foundation of the idol community", definition: "A fan with CCI > 7, actfreq = 'Daily', membdays > 180, and community_engagement.group_involvement.grprole = 'Moderator' or community_engagement.group_involvement.grprole = 'Leader'. These fans play essential roles in maintaining community structure and culture.", source_file: "virtual_kb.jsonl", source_line: 26, source_id: 25, search_text: "Community Pillar domain_knowledge Identifies fans who form the foundation of the idol community A fan with CCI > 7, actfreq = 'Daily', membdays > 180, and community_engagement.group_involvement.grprole = 'Moderator' or community_engagement.group_involvement.grprole = 'Leader'. These fans play essential roles in maintaining community structure and culture."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:26"}) SET n = {id: "virtual:26", name: "Potential Ambassador", type: "domain_knowledge", description: "Identifies fans with high potential to represent the idol brand", definition: "A fan with inflscore > 75, trustval > 8.5, FEI > 0.6, and contqualrate > 8.0, representing candidates for official ambassador programs who can authentically promote the idol.", source_file: "virtual_kb.jsonl", source_line: 27, source_id: 26, search_text: "Potential Ambassador domain_knowledge Identifies fans with high potential to represent the idol brand A fan with inflscore > 75, trustval > 8.5, FEI > 0.6, and contqualrate > 8.0, representing candidates for official ambassador programs who can authentically promote the idol."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:27"}) SET n = {id: "virtual:27", name: "Whale", type: "domain_knowledge", description: "Identifies fans who provide extraordinary financial support", definition: "A fan with giftvalusd > 500 or spendusd > 1000 within a 90-day period, regardless of other engagement metrics. These fans form the financial backbone of idol economic ecosystems.", source_file: "virtual_kb.jsonl", source_line: 28, source_id: 27, search_text: "Whale domain_knowledge Identifies fans who provide extraordinary financial support A fan with giftvalusd > 500 or spendusd > 1000 within a 90-day period, regardless of other engagement metrics. These fans form the financial backbone of idol economic ecosystems."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:28"}) SET n = {id: "virtual:28", name: "Event Champion", type: "domain_knowledge", description: "Identifies fans who excel at event participation and promotion", definition: "A fan with participation_summary.event_attendance.evtpart = 'Always', ERP > 50, and hashuse > 15, representing users who consistently attend events and actively promote them through social channels.", source_file: "virtual_kb.jsonl", source_line: 29, source_id: 28, search_text: "Event Champion domain_knowledge Identifies fans who excel at event participation and promotion A fan with participation_summary.event_attendance.evtpart = 'Always', ERP > 50, and hashuse > 15, representing users who consistently attend events and actively promote them through social channels."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:29"}) SET n = {id: "virtual:29", name: "Multi-Idol Supporter", type: "domain_knowledge", description: "Identifies fans who support multiple virtual idols on the platform", definition: "A fan who has interacted (interactfanpivot appears multiple times with different interactidolpivot values) with at least 2 different idols, with engrate > 0.4 for each. These fans spread their support across the platform ecosystem rather than focusing on a single idol.", source_file: "virtual_kb.jsonl", source_line: 30, source_id: 29, search_text: "Multi-Idol Supporter domain_knowledge Identifies fans who support multiple virtual idols on the platform A fan who has interacted (interactfanpivot appears multiple times with different interactidolpivot values) with at least 2 different idols, with engrate > 0.4 for each. These fans spread their support across the platform ecosystem rather than focusing on a single idol."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:30"}) SET n = {id: "virtual:30", name: "Premium Engagement Ratio (PER)", type: "calculation_knowledge", description: "Measures the relationship between fan spending and their engagement level", definition: "PER = \\frac{MV}{FEI \\times 100}, \\text{ where higher values indicate fans who spend more relative to their engagement level.}", source_file: "virtual_kb.jsonl", source_line: 31, source_id: 30, search_text: "Premium Engagement Ratio (PER) calculation_knowledge Measures the relationship between fan spending and their engagement level PER = \\frac{MV}{FEI \\times 100}, \\text{ where higher values indicate fans who spend more relative to their engagement level.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:31"}) SET n = {id: "virtual:31", name: "Content Quality to Engagement Ratio (CQER)", type: "calculation_knowledge", description: "Measures how a fan's content quality relates to their overall engagement", definition: "CQER = \\frac{contqualrate}{engrate \\times 10}, \\text{ where values above 1.0 indicate fans producing content of quality higher than their general engagement level would predict.}", source_file: "virtual_kb.jsonl", source_line: 32, source_id: 31, search_text: "Content Quality to Engagement Ratio (CQER) calculation_knowledge Measures how a fan's content quality relates to their overall engagement CQER = \\frac{contqualrate}{engrate \\times 10}, \\text{ where values above 1.0 indicate fans producing content of quality higher than their general engagement level would predict.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:32"}) SET n = {id: "virtual:32", name: "Investment Recovery Period (IRP)", type: "calculation_knowledge", description: "Estimates how many months it will take to recover platform investment in a fan", definition: "IRP = \\frac{supptix \\times 30}{MV \\times (1 - \\frac{RRF}{10})}, \\text{ where supptix represents support tickets as a proxy for platform resources invested in the fan.}", source_file: "virtual_kb.jsonl", source_line: 33, source_id: 32, search_text: "Investment Recovery Period (IRP) calculation_knowledge Estimates how many months it will take to recover platform investment in a fan IRP = \\frac{supptix \\times 30}{MV \\times (1 - \\frac{RRF}{10})}, \\text{ where supptix represents support tickets as a proxy for platform resources invested in the fan.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:33"}) SET n = {id: "virtual:33", name: "Tier Acceleration Factor (TAF)", type: "calculation_knowledge", description: "Measures how quickly a fan is advancing through tier levels relative to platform norms", definition: "TAF = \\frac{tierstep}{\\sqrt{membdays}} \\times \\frac{10}{\\sqrt{365}}, \\text{ normalized to annual scale for consistent comparison across fans with different membership durations.}", source_file: "virtual_kb.jsonl", source_line: 34, source_id: 33, search_text: "Tier Acceleration Factor (TAF) calculation_knowledge Measures how quickly a fan is advancing through tier levels relative to platform norms TAF = \\frac{tierstep}{\\sqrt{membdays}} \\times \\frac{10}{\\sqrt{365}}, \\text{ normalized to annual scale for consistent comparison across fans with different membership durations.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:34"}) SET n = {id: "virtual:34", name: "Gift Impact Quotient (GIQ)", type: "calculation_knowledge", description: "Evaluates the relative impact of a fan's gifting behavior considering both volume and value", definition: "GIQ = \\frac{giftvalusd \\times gifttot}{100}, \\text{ producing an amplified measure of gifting significance by combining both quantity and monetary value.}", source_file: "virtual_kb.jsonl", source_line: 35, source_id: 34, search_text: "Gift Impact Quotient (GIQ) calculation_knowledge Evaluates the relative impact of a fan's gifting behavior considering both volume and value GIQ = \\frac{giftvalusd \\times gifttot}{100}, \\text{ producing an amplified measure of gifting significance by combining both quantity and monetary value.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:35"}) SET n = {id: "virtual:35", name: "Social Conversion Rate (SCR)", type: "calculation_knowledge", description: "Measures a fan's ability to convert their social network into active platform participants", definition: "SCR = \\frac{refcount}{(socialcommunity.community\\_engagement->>'network.follcount')::int} \\times 100, \\text{ expressed as a percentage of followers successfully converted to platform users.}", source_file: "virtual_kb.jsonl", source_line: 36, source_id: 35, search_text: "Social Conversion Rate (SCR) calculation_knowledge Measures a fan's ability to convert their social network into active platform participants SCR = \\frac{refcount}{(socialcommunity.community\\_engagement->>'network.follcount')::int} \\times 100, \\text{ expressed as a percentage of followers successfully converted to platform users.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:36"}) SET n = {id: "virtual:36", name: "Content Quality Consistency (CQC)", type: "calculation_knowledge", description: "Measures the consistency of a fan's content quality relative to their engagement consistency", definition: "CQC = contqualrate \\times intconsist \\times \\frac{ugcval}{10}, \\text{ where intconsist measures interaction consistency on a scale of 0-1.}", source_file: "virtual_kb.jsonl", source_line: 37, source_id: 36, search_text: "Content Quality Consistency (CQC) calculation_knowledge Measures the consistency of a fan's content quality relative to their engagement consistency CQC = contqualrate \\times intconsist \\times \\frac{ugcval}{10}, \\text{ where intconsist measures interaction consistency on a scale of 0-1.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:37"}) SET n = {id: "virtual:37", name: "Loyalty Value Ratio (LVR)", type: "calculation_knowledge", description: "Evaluates the relationship between a fan's loyalty points and their economic value", definition: "LVR = \\frac{loypts}{MV \\times 10}, \\text{ where higher values indicate fans accumulating loyalty faster than their spending would predict.}", source_file: "virtual_kb.jsonl", source_line: 38, source_id: 37, search_text: "Loyalty Value Ratio (LVR) calculation_knowledge Evaluates the relationship between a fan's loyalty points and their economic value LVR = \\frac{loypts}{MV \\times 10}, \\text{ where higher values indicate fans accumulating loyalty faster than their spending would predict.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:38"}) SET n = {id: "virtual:38", name: "Event Response Factor (ERF)", type: "calculation_knowledge", description: "Measures a fan's response rate to official events and activities", definition: "ERF = \\frac{(eventsandclub.participation\\_summary->>'event\\_attendance.onevtatt')::int + (eventsandclub.participation\\_summary->>'event\\_attendance.offevtatt')::int}{10} \\times \\left(1 + \\frac{FEI}{2}\\right), \\text{ where onevtatt and offevtatt represent online and offline events attended.}", source_file: "virtual_kb.jsonl", source_line: 39, source_id: 38, search_text: "Event Response Factor (ERF) calculation_knowledge Measures a fan's response rate to official events and activities ERF = \\frac{(eventsandclub.participation\\_summary->>'event\\_attendance.onevtatt')::int + (eventsandclub.participation\\_summary->>'event\\_attendance.offevtatt')::int}{10} \\times \\left(1 + \\frac{FEI}{2}\\right), \\text{ where onevtatt and offevtatt represent online and offline events attended.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:39"}) SET n = {id: "virtual:39", name: "Churn Prevention Investment (CPI)", type: "calculation_knowledge", description: "Calculates the optimal investment for preventing churn based on fan value and risk", definition: "CPI = FLV \\times \\frac{RRF}{5} \\times 0.1, \\text{ suggesting investing up to 10\\% of at-risk value, scaled according to churn risk level.}", source_file: "virtual_kb.jsonl", source_line: 40, source_id: 39, search_text: "Churn Prevention Investment (CPI) calculation_knowledge Calculates the optimal investment for preventing churn based on fan value and risk CPI = FLV \\times \\frac{RRF}{5} \\times 0.1, \\text{ suggesting investing up to 10\\% of at-risk value, scaled according to churn risk level.}"};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:40"}) SET n = {id: "virtual:40", name: "High-Value Content Creator", type: "domain_knowledge", description: "Identifies fans who produce exceptional quality content with significant reach", definition: "A fan who produces content with contqualrate > 8.5, has follcount > 1000, and maintains ugcval > 20, representing the elite tier of community content producers.", source_file: "virtual_kb.jsonl", source_line: 41, source_id: 40, search_text: "High-Value Content Creator domain_knowledge Identifies fans who produce exceptional quality content with significant reach A fan who produces content with contqualrate > 8.5, has follcount > 1000, and maintains ugcval > 20, representing the elite tier of community content producers."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:41"}) SET n = {id: "virtual:41", name: "Engagement-Deficient Whale", type: "domain_knowledge", description: "Identifies high-spending fans with surprisingly low engagement", definition: "A fan with giftvalusd > 500 or spendusd > 1000, but with FEI < 0.3, indicating significant financial contribution despite limited platform participation.", source_file: "virtual_kb.jsonl", source_line: 42, source_id: 41, search_text: "Engagement-Deficient Whale domain_knowledge Identifies high-spending fans with surprisingly low engagement A fan with giftvalusd > 500 or spendusd > 1000, but with FEI < 0.3, indicating significant financial contribution despite limited platform participation."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:42"}) SET n = {id: "virtual:42", name: "Rapidly Ascending Fan", type: "domain_knowledge", description: "Identifies fans who are progressing through membership tiers at an accelerated rate", definition: "A fan with TAF > 1.5 and LPR > 20, demonstrating exceptional speed in advancing through tier levels and accumulating loyalty points.", source_file: "virtual_kb.jsonl", source_line: 43, source_id: 42, search_text: "Rapidly Ascending Fan domain_knowledge Identifies fans who are progressing through membership tiers at an accelerated rate A fan with TAF > 1.5 and LPR > 20, demonstrating exceptional speed in advancing through tier levels and accumulating loyalty points."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:43"}) SET n = {id: "virtual:43", name: "Quality Inconsistent Creator", type: "domain_knowledge", description: "Identifies fans who produce occasional high-quality content but lack consistency", definition: "A fan who has created at least one content piece with contqualrate > 8.5 but maintains an overall CQC < 5, indicating talent but inconsistent output.", source_file: "virtual_kb.jsonl", source_line: 44, source_id: 43, search_text: "Quality Inconsistent Creator domain_knowledge Identifies fans who produce occasional high-quality content but lack consistency A fan who has created at least one content piece with contqualrate > 8.5 but maintains an overall CQC < 5, indicating talent but inconsistent output."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:44"}) SET n = {id: "virtual:44", name: "Retention Risk Superfan", type: "domain_knowledge", description: "Identifies high-value fans showing early warning signs of potential churn", definition: "A fan with tierstep ≥ 8, FEI > 0.7, and MV > 200, but also showing RRF > 2.0, representing significant value at risk of being lost.", source_file: "virtual_kb.jsonl", source_line: 45, source_id: 44, search_text: "Retention Risk Superfan domain_knowledge Identifies high-value fans showing early warning signs of potential churn A fan with tierstep ≥ 8, FEI > 0.7, and MV > 200, but also showing RRF > 2.0, representing significant value at risk of being lost."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:45"}) SET n = {id: "virtual:45", name: "Loyalty Underperformer", type: "domain_knowledge", description: "Identifies fans with unusually low loyalty points relative to their spending", definition: "A fan with LVR < 0.5 and MV > 150, indicating a lower than expected loyalty point accumulation compared to their economic contribution.", source_file: "virtual_kb.jsonl", source_line: 46, source_id: 45, search_text: "Loyalty Underperformer domain_knowledge Identifies fans with unusually low loyalty points relative to their spending A fan with LVR < 0.5 and MV > 150, indicating a lower than expected loyalty point accumulation compared to their economic contribution."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:46"}) SET n = {id: "virtual:46", name: "Premium Service Candidate", type: "domain_knowledge", description: "Identifies fans who would benefit from and likely pay for enhanced support services", definition: "A fan with SEI < 0.8, MV > 300, and supptix > 5, representing users who require substantial support and have demonstrated significant economic value.", source_file: "virtual_kb.jsonl", source_line: 47, source_id: 46, search_text: "Premium Service Candidate domain_knowledge Identifies fans who would benefit from and likely pay for enhanced support services A fan with SEI < 0.8, MV > 300, and supptix > 5, representing users who require substantial support and have demonstrated significant economic value."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:47"}) SET n = {id: "virtual:47", name: "Social Network Underutilizer", type: "domain_knowledge", description: "Identifies fans with large social networks but low conversion to platform activity", definition: "A fan with follcount > 1000 but SCR < 0.5%, indicating a substantial but largely untapped potential for platform growth through their social connections.", source_file: "virtual_kb.jsonl", source_line: 48, source_id: 47, search_text: "Social Network Underutilizer domain_knowledge Identifies fans with large social networks but low conversion to platform activity A fan with follcount > 1000 but SCR < 0.5%, indicating a substantial but largely untapped potential for platform growth through their social connections."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:48"}) SET n = {id: "virtual:48", name: "Tier-Stuck Veteran", type: "domain_knowledge", description: "Identifies long-term fans who have stalled in tier progression", definition: "A fan with membdays > 365, engrate > 0.4, but TAF < 0.5, representing users who remain engaged but are advancing through tier levels more slowly than expected.", source_file: "virtual_kb.jsonl", source_line: 49, source_id: 48, search_text: "Tier-Stuck Veteran domain_knowledge Identifies long-term fans who have stalled in tier progression A fan with membdays > 365, engrate > 0.4, but TAF < 0.5, representing users who remain engaged but are advancing through tier levels more slowly than expected."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:49"}) SET n = {id: "virtual:49", name: "Gift-Focused Supporter", type: "domain_knowledge", description: "Identifies fans whose primary support comes through gifting rather than direct spending", definition: "A fan with GIQ > 50 but spendusd < 100, showing a preference for gift-based support mechanisms over traditional subscription or purchase options.", source_file: "virtual_kb.jsonl", source_line: 50, source_id: 49, search_text: "Gift-Focused Supporter domain_knowledge Identifies fans whose primary support comes through gifting rather than direct spending A fan with GIQ > 50 but spendusd < 100, showing a preference for gift-based support mechanisms over traditional subscription or purchase options."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:50"}) SET n = {id: "virtual:50", name: "Content Creator Classification", type: "domain_knowledge", description: "Categorizes fans based on their content creation quality, volume, and reach", definition: "Fans are classified into three categories based on content metrics: 'High-Value Content Creator' identifies fans with exceptional content quality (contqualrate > 8.5), significant reach (follcount > 1000), and substantial content volume (ugcval > 20); 'Content Creator' identifies fans who produce good quality content (contqualrate > 7.0) with substantial volume (ugcval > 20); 'Regular Fan' applies to all others who don't meet content creator thresholds, representing the standard user base who primarily consume rather than create content.", source_file: "virtual_kb.jsonl", source_line: 51, source_id: 50, search_text: "Content Creator Classification domain_knowledge Categorizes fans based on their content creation quality, volume, and reach Fans are classified into three categories based on content metrics: 'High-Value Content Creator' identifies fans with exceptional content quality (contqualrate > 8.5), significant reach (follcount > 1000), and substantial content volume (ugcval > 20); 'Content Creator' identifies fans who produce good quality content (contqualrate > 7.0) with substantial volume (ugcval > 20); 'Regular Fan' applies to all others who don't meet content creator thresholds, representing the standard user base who primarily consume rather than create content."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:51"}) SET n = {id: "virtual:51", name: "Content Preference Classification", type: "domain_knowledge", description: "Categorizes fans based on their primary content consumption preferences", definition: "Uses the contpref field to classify viewers: contpref = 'Music' maps to 'Content Consumer (Music)', contpref = 'Dance' maps to 'Content Consumer (Dance)', contpref = 'Gaming' maps to 'Content Consumer (Gaming)', and all other values map to 'General Content Consumer'. This classification enables targeted content delivery and personalized marketing.", source_file: "virtual_kb.jsonl", source_line: 52, source_id: 51, search_text: "Content Preference Classification domain_knowledge Categorizes fans based on their primary content consumption preferences Uses the contpref field to classify viewers: contpref = 'Music' maps to 'Content Consumer (Music)', contpref = 'Dance' maps to 'Content Consumer (Dance)', contpref = 'Gaming' maps to 'Content Consumer (Gaming)', and all other values map to 'General Content Consumer'. This classification enables targeted content delivery and personalized marketing."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:52"}) SET n = {id: "virtual:52", name: "Churn Risk Numeric Mapping", type: "value_illustration", description: "Converts the churn risk enum values to numeric form for analytical calculations", definition: "Transforms the churnflag enum values into numeric equivalents for use in calculations and risk models: 'None' maps to 0 (representing minimal risk), 'Low' maps to 1 (representing slight risk), 'Medium' maps to 2 (representing moderate risk), and 'High' maps to 3 (representing severe risk). This numeric mapping enables mathematical operations in retention analysis formulas, especially for the Retention Risk Factor (RRF) calculation.", source_file: "virtual_kb.jsonl", source_line: 53, source_id: 52, search_text: "Churn Risk Numeric Mapping value_illustration Converts the churn risk enum values to numeric form for analytical calculations Transforms the churnflag enum values into numeric equivalents for use in calculations and risk models: 'None' maps to 0 (representing minimal risk), 'Low' maps to 1 (representing slight risk), 'Medium' maps to 2 (representing moderate risk), and 'High' maps to 3 (representing severe risk). This numeric mapping enables mathematical operations in retention analysis formulas, especially for the Retention Risk Factor (RRF) calculation."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:53"}) SET n = {id: "virtual:53", name: "Fan Value Segmentation", type: "domain_knowledge", description: "Classifies fans into value tiers based on their Fan Lifetime Value (FLV) relative to platform-wide percentiles", definition: "Segments fans into four distinct value categories using percentile thresholds: 'Top Tier' identifies fans with FLV above the 90th percentile (p90), representing the platform's most valuable users; 'High Value' identifies fans with FLV between the 75th and 90th percentiles (p75 to p90); 'Medium Value' identifies fans with FLV between the 50th and 75th percentiles (median to p75); 'Low Value' applies to all fans with FLV below the median (p50). This segmentation enables targeted retention strategies, premium service offerings, and resource allocation based on projected economic contribution.", source_file: "virtual_kb.jsonl", source_line: 54, source_id: 53, search_text: "Fan Value Segmentation domain_knowledge Classifies fans into value tiers based on their Fan Lifetime Value (FLV) relative to platform-wide percentiles Segments fans into four distinct value categories using percentile thresholds: 'Top Tier' identifies fans with FLV above the 90th percentile (p90), representing the platform's most valuable users; 'High Value' identifies fans with FLV between the 75th and 90th percentiles (p75 to p90); 'Medium Value' identifies fans with FLV between the 50th and 75th percentiles (median to p75); 'Low Value' applies to all fans with FLV below the median (p50). This segmentation enables targeted retention strategies, premium service offerings, and resource allocation based on projected economic contribution."};
MERGE (n:Knowledge:SemanticSearch {id: "virtual:54"}) SET n = {id: "virtual:54", name: "Enhanced Churn Risk Severity Classification", type: "value_illustration", description: "Defines detailed categorization for high-risk churn candidates requiring intervention", definition: "Enhances the standard churn risk classification by adding a 'Severe' category for critically at-risk users. The classification uses precise RRF thresholds: 'Severe' identifies users with RRF > 4.5 requiring immediate intervention and executive attention; 'High' identifies users with RRF between 3.5-4.5 requiring prioritized retention campaigns; 'Medium' applies to users with RRF between 2.5-3.5 requiring standard monitoring. This refined classification enables more targeted allocation of retention resources based on urgency level and churn probability.", source_file: "virtual_kb.jsonl", source_line: 55, source_id: 54, search_text: "Enhanced Churn Risk Severity Classification value_illustration Defines detailed categorization for high-risk churn candidates requiring intervention Enhances the standard churn risk classification by adding a 'Severe' category for critically at-risk users. The classification uses precise RRF thresholds: 'Severe' identifies users with RRF > 4.5 requiring immediate intervention and executive attention; 'High' identifies users with RRF between 3.5-4.5 requiring prioritized retention campaigns; 'Medium' applies to users with RRF between 2.5-3.5 requiring standard monitoring. This refined classification enables more targeted allocation of retention resources based on urgency level and churn probability."};


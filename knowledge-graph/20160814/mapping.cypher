MERGE (n:Column:SemanticSearch {id: "news:interactionmetrics:interaction_behavior"}) SET n = {database_name: "news", table_name: "interactionmetrics", column_name: "interaction_behavior", ordinal: 2, column_type: "jsonb", nullable: true, is_primary_key: false, id: "news:interactionmetrics:interaction_behavior", raw_text: "{\"column_meaning\": \"JSONB column. Captures user interaction behavior metrics, including scroll depth, time spent, and conversion details.\", \"fields_meaning\": {\"bounce_status\": \"An enum (bouncestatus_enum) indicating if this was a bounce (Yes, No).\", \"click_seconds\": \"A NUMERIC(6,2) time to first click in seconds (e.g., 10.50).\", \"conversion\": {\"status\": \"An enum (conversionstatus_enum) describing a conversion event (Share, Newsletter, Subscription).\", \"value\": \"A NUMERIC(10,2) capturing any monetary or point value of the conversion (e.g., 5.00).\"}, \"exit_type\": \"An enum (exittype_enum) describing exit type (Timeout, Natural, Bounce, External).\", \"next_action\": \"An enum (nextaction_enum) referencing the next action the user took (Exit, Another Article, Share, Search).\", \"scroll\": {\"depth\": \"An INT measuring how deep the user scrolled or engaged (e.g., 2 screen lengths).\", \"percentage\": \"A NUMERIC(5,2) capturing scroll depth percentage (e.g., 75.50).\", \"speed\": \"A NUMERIC(6,2) measuring scroll speed in px/sec (e.g., 50.25).\"}, \"time_spent\": {\"attention_time\": \"A NUMERIC(6,2) capturing user’s attention time (e.g., 18.50).\", \"duration_seconds\": \"An INT measuring the total seconds spent in this interaction (e.g., 30).\", \"reading_seconds\": \"A NUMERIC(6,2) how many seconds the user spent actually reading (e.g., 15.00).\", \"viewport_time\": \"A NUMERIC(6,2) time the content was in the viewport (e.g., 20.00).\"}}}", description: "JSONB column. Captures user interaction behavior metrics, including scroll depth, time spent, and conversion details.", declared_type: "JSONB", examples: ["2 screen lengths", "75.50", "50.25", "30", "15.00", "20.00", "18.50", "10.50", "5.00"], search_text: "news interactionmetrics interaction_behavior jsonb {\"column_meaning\": \"JSONB column. Captures user interaction behavior metrics, including scroll depth, time spent, and conversion details.\", \"fields_meaning\": {\"bounce_status\": \"An enum (bouncestatus_enum) indicating if this was a bounce (Yes, No).\", \"click_seconds\": \"A NUMERIC(6,2) time to first click in seconds (e.g., 10.50).\", \"conversion\": {\"status\": \"An enum (conversionstatus_enum) describing a conversion event (Share, Newsletter, Subscription).\", \"value\": \"A NUMERIC(10,2) capturing any monetary or point value of the conversion (e.g., 5.00).\"}, \"exit_type\": \"An enum (exittype_enum) describing exit type (Timeout, Natural, Bounce, External).\", \"next_action\": \"An enum (nextaction_enum) referencing the next action the user took (Exit, Another Article, Share, Search).\", \"scroll\": {\"depth\": \"An INT measuring how deep the user scrolled or engaged (e.g., 2 screen lengths).\", \"percentage\": \"A NUMERIC(5,2) capturing scroll depth percentage (e.g., 75.50).\", \"speed\": \"A NUMERIC(6,2) measuring scroll speed in px/sec (e.g., 50.25).\"}, \"time_spent\": {\"attention_time\": \"A NUMERIC(6,2) capturing user’s attention time (e.g., 18.50).\", \"duration_seconds\": \"An INT measuring the total seconds spent in this interaction (e.g., 30).\", \"reading_seconds\": \"A NUMERIC(6,2) how many seconds the user spent actually reading (e.g., 15.00).\", \"viewport_time\": \"A NUMERIC(6,2) time the content was in the viewport (e.g., 20.00).\"}}} JSONB column. Captures user interaction behavior metrics, including scroll depth, time spent, and conversion details. JSONB 2 screen lengths 75.50 50.25 30 15.00 20.00 18.50 10.50 5.00"};

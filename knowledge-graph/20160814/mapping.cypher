CREATE (n:Column {database_name: "virtual", table_name: "fans", column_name: "statustag", ordinal: 6, data_type: "USER-DEFINED", nullable: true, is_primary_key: false, entity_key: "virtual:fans:statustag", raw_text: "An enum (FanStatus_enum) describing the fan’s current status (Inactive, VIP, Active, Blocked).", description: "An enum (FanStatus_enum) describing the fan’s current status (Inactive, VIP, Active, Blocked).", declared_type: "enum", examples: []});
CREATE (n:Column {database_name: "virtual", table_name: "fans", column_name: "personal_attributes", ordinal: 7, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "virtual:fans:personal_attributes", raw_text: "{\"column_meaning\": \"JSONB column. Groups personal demographic and interest-related attributes of the fan, including age, gender, location, language preference, occupation, and interests.\", \"fields_meaning\": {\"demographics\": {\"agecount\": \"A SMALLINT representing the fan’s age in years.\", \"gendertype\": \"An enum (FanGender_enum) indicating the fan’s gender (Other, Male, Undisclosed, Female).\", \"locnation\": \"A VARCHAR(100) for the fan’s country location (e.g., 'USA', 'Japan').\", \"loctown\": \"A VARCHAR(100) for the fan’s city or town location.\"}, \"preferences\": {\"interestset\": \"An enum (FanInterests_enum) indicating the fan's primary interest area (Technology, Anime, Art, Music, Gaming).\", \"langpref\": \"An enum (FanLang_enum) specifying the fan's main language (Multiple, Korean, English, Japanese, Chinese).\", \"occupath\": \"An enum (FanOccupation_enum) describing the fan’s occupation (Professional, Student, Other, Creative).\"}}}", description: "JSONB column. Groups personal demographic and interest-related attributes of the fan, including age, gender, location, language preference, occupation, and interests.", declared_type: "JSONB", examples: ["USA", "Japan"]});

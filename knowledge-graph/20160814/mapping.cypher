CREATE (n:Column {database_name: "virtual", table_name: "loyaltyandachievements", column_name: "reward_progress", ordinal: 8, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "virtual:loyaltyandachievements:reward_progress", raw_text: "{\"column_meaning\": \"JSONB column. Aggregates data related to the fan’s loyalty rewards and achievements, including points, tier, badges, and special titles.\", \"fields_meaning\": {\"achievements\": {\"achcount\": \"An INT number of achievements unlocked (e.g., 5).\", \"badgecoll\": \"An INT count of badges collected by the fan (e.g., 3).\", \"spectitles\": \"An INT how many special titles the fan holds (e.g., 1).\"}, \"loyalty\": {\"loypts\": \"An INT storing loyalty points earned (e.g., 2500).\", \"rewtier\": \"An enum (RewardTier_enum) for the reward tier (Bronze, Platinum, Gold, Silver).\"}}}", description: "JSONB column. Aggregates data related to the fan’s loyalty rewards and achievements, including points, tier, badges, and special titles.", declared_type: "JSONB", examples: ["2500", "5", "3", "1"]});

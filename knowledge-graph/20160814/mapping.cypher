CREATE (n:Column {database_name: "cybermarket", table_name: "riskanalysis", column_name: "network_behavior_analytics", ordinal: 16, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "cybermarket:riskanalysis:network_behavior_analytics", raw_text: "{\"column_meaning\": \"JSONB column. Stores scores derived from analyzing network structure, transaction patterns, temporal activity, geographic distribution, and behavioral consistency associated with the risk profile.\", \"fields_meaning\": {\"behavioral_analysis\": {\"behavior_consistency_score\": \"A NUMERIC(5,2) consistency of behavior across time (e.g., 70.90).\", \"geo_distribution_score\": \"A NUMERIC(5,1) geolocation distribution score (e.g., 45.3).\", \"temporal_pattern_score\": \"A NUMERIC(5,2) analyzing temporal patterns (e.g., 60.25).\"}, \"network_analysis\": {\"centrality_score\": \"A NUMERIC(6,3) (0–999.999) network centrality measure (e.g., 452.110).\", \"cluster_coefficient\": \"A NUMERIC(5,4) graph clustering coefficient (0.0000–0.9999) (e.g., 0.3421).\", \"connection_diversity\": \"A NUMERIC(6,2) measuring diversity of connections (e.g., 78.45).\"}, \"transaction_pattern_category\": \"An enum (TxPatternCat_enum) describing transaction patterns (High-risk, Suspicious, Normal).\"}}", description: "JSONB column. Stores scores derived from analyzing network structure, transaction patterns, temporal activity, geographic distribution, and behavioral consistency associated with the risk profile.", declared_type: "JSONB", examples: ["0.3421", "452.110", "78.45", "60.25", "45.3", "70.90"]});

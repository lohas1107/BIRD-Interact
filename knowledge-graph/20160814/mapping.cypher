MERGE (n:Knowledge:SemanticSearch {id: "fake:73"}) SET n = {id: "fake:73", name: "High-Impact Amplifier", type: "domain_knowledge", description: "Identifies accounts with substantial network influence and frequent posting activity, acting as key amplifiers in coordinated networks.", definition: "An account with netinflscore > 80 and postfreq > 30 posts per day.", source_file: "fake_kb.jsonl", source_line: 74, source_id: 73, search_text: "High-Impact Amplifier domain_knowledge Identifies accounts with substantial network influence and frequent posting activity, acting as key amplifiers in coordinated networks. An account with netinflscore > 80 and postfreq > 30 posts per day."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:74"}) SET n = {id: "fake:74", name: "High-Activity Account", type: "domain_knowledge", description: "Identifies accounts with elevated engagement levels based on the number of sessions or total posting frequency.", definition: "An account with session_count > 1000 or total_post_frequency > 50.", source_file: "fake_kb.jsonl", source_line: 75, source_id: 74, search_text: "High-Activity Account domain_knowledge Identifies accounts with elevated engagement levels based on the number of sessions or total posting frequency. An account with session_count > 1000 or total_post_frequency > 50."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:75"}) SET n = {id: "fake:75", name: "Session Count (SC)", type: "calculation_knowledge", description: "Measures the total number of session records associated with an account.", definition: "SC_a = \\left| \\{ \\text{sessref} \\in \\text{sessionbehavior} \\mid \\text{sessprofref} = \\text{profkey}, \\text{profaccref} = a \\} \\right|", source_file: "fake_kb.jsonl", source_line: 76, source_id: 75, search_text: "Session Count (SC) calculation_knowledge Measures the total number of session records associated with an account. SC_a = \\left| \\{ \\text{sessref} \\in \\text{sessionbehavior} \\mid \\text{sessprofref} = \\text{profkey}, \\text{profaccref} = a \\} \\right|"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:76"}) SET n = {id: "fake:76", name: "Total Post Frequency (TPF)", type: "calculation_knowledge", description: "Measures the total posting frequency across all sessions for an account.", definition: "TPF_a = \\sum_{\\text{cntref} \\in \\text{contentbehavior}} \\text{postfreq}, \\quad \\text{where } \\text{cntsessref} = \\text{sessref}, \\text{sessprofref} = \\text{profkey}, \\text{profaccref} = a", source_file: "fake_kb.jsonl", source_line: 77, source_id: 76, search_text: "Total Post Frequency (TPF) calculation_knowledge Measures the total posting frequency across all sessions for an account. TPF_a = \\sum_{\\text{cntref} \\in \\text{contentbehavior}} \\text{postfreq}, \\quad \\text{where } \\text{cntsessref} = \\text{sessref}, \\text{sessprofref} = \\text{profkey}, \\text{profaccref} = a"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:77"}) SET n = {id: "fake:77", name: "High-Activity Account", type: "domain_knowledge", description: "Identifies accounts with elevated engagement levels based on the number of sessions or total posting frequency.", definition: "An account with session_count > 1000 or total_post_frequency > 50.", source_file: "fake_kb.jsonl", source_line: 78, source_id: 77, search_text: "High-Activity Account domain_knowledge Identifies accounts with elevated engagement levels based on the number of sessions or total posting frequency. An account with session_count > 1000 or total_post_frequency > 50."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:78"}) SET n = {id: "fake:78", name: "influence ranking by NIC", type: "calculation_knowledge", description: "A ranking system that orders accounts based on their NIC scores from highest to lowest.", definition: "\\text{rank}_i = |\\{j : \\text{NIC}_j > \\text{NIC}_i\\}| + 1 where i is the current account and j iterates over all accounts", source_file: "fake_kb.jsonl", source_line: 79, source_id: 78, search_text: "influence ranking by NIC calculation_knowledge A ranking system that orders accounts based on their NIC scores from highest to lowest. \\text{rank}_i = |\\{j : \\text{NIC}_j > \\text{NIC}_i\\}| + 1 where i is the current account and j iterates over all accounts"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:79"}) SET n = {id: "fake:79", name: "TEI Risk Category", type: "domain_knowledge", description: "A categorical risk level assigned based on an account's TEI Quartile.", definition: "A category assigned as 'Low Risk' (Quartile 1), 'Moderate Risk' (Quartile 2), 'High Risk' (Quartile 3), or 'Very High Risk' (Quartile 4) based on the account's calculated TEI Quartile.", source_file: "fake_kb.jsonl", source_line: 80, source_id: 79, search_text: "TEI Risk Category domain_knowledge A categorical risk level assigned based on an account's TEI Quartile. A category assigned as 'Low Risk' (Quartile 1), 'Moderate Risk' (Quartile 2), 'High Risk' (Quartile 3), or 'Very High Risk' (Quartile 4) based on the account's calculated TEI Quartile."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:80"}) SET n = {id: "fake:80", name: "cluster identifier", type: "domain_knowledge", description: "A key used to group related accounts identified as part of the same network or cluster.", definition: "In this context, the platform identifier (`platident`) associated with the accounts in the potential Amplification Network is the cluster identifier.", source_file: "fake_kb.jsonl", source_line: 81, source_id: 80, search_text: "cluster identifier domain_knowledge A key used to group related accounts identified as part of the same network or cluster. In this context, the platform identifier (`platident`) associated with the accounts in the potential Amplification Network is the cluster identifier."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:81"}) SET n = {id: "fake:81", name: "member count", type: "calculation_knowledge", description: "The total number of unique accounts within an identified cluster.", definition: "Calculated using COUNT(DISTINCT account_index) for accounts grouped by the cluster identifier.", source_file: "fake_kb.jsonl", source_line: 82, source_id: 81, search_text: "member count calculation_knowledge The total number of unique accounts within an identified cluster. Calculated using COUNT(DISTINCT account_index) for accounts grouped by the cluster identifier."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:82"}) SET n = {id: "fake:82", name: "maximum coordination score", type: "calculation_knowledge", description: "The highest coordination score observed among the members of an identified cluster.", definition: "\\max_{a \\in cluster C} (\\text{coordscore}_a)", source_file: "fake_kb.jsonl", source_line: 83, source_id: 82, search_text: "maximum coordination score calculation_knowledge The highest coordination score observed among the members of an identified cluster. \\max_{a \\in cluster C} (\\text{coordscore}_a)"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:83"}) SET n = {id: "fake:83", name: "member account IDs", type: "calculation_knowledge", description: "A collection (array) of the unique account indexes belonging to an identified cluster.", definition: "\\{ \\text{accindex}_a \\mid a \\in cluster C \\}", source_file: "fake_kb.jsonl", source_line: 84, source_id: 83, search_text: "member account IDs calculation_knowledge A collection (array) of the unique account indexes belonging to an identified cluster. \\{ \\text{accindex}_a \\mid a \\in cluster C \\}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:84"}) SET n = {id: "fake:84", name: "last activity proxy time", type: "calculation_knowledge", description: "An estimated timestamp of the last known activity for an account, used when direct session timestamps are unavailable or insufficient.", definition: "Derived as \\max(\\text{detecttime}) from associated securitydetection records for an account.", source_file: "fake_kb.jsonl", source_line: 85, source_id: 84, search_text: "last activity proxy time calculation_knowledge An estimated timestamp of the last known activity for an account, used when direct session timestamps are unavailable or insufficient. Derived as \\max(\\text{detecttime}) from associated securitydetection records for an account."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:85"}) SET n = {id: "fake:85", name: "review priority", type: "value_illustration", description: "A flag or status assigned to an account to indicate the need or priority level for manual review.", definition: "A field in the `account` table set to a specific value like 'Review_Inactive_Trusted' to signal that an otherwise trusted account requires review due to prolonged inactivity.", source_file: "fake_kb.jsonl", source_line: 86, source_id: 85, search_text: "review priority value_illustration A flag or status assigned to an account to indicate the need or priority level for manual review. A field in the `account` table set to a specific value like 'Review_Inactive_Trusted' to signal that an otherwise trusted account requires review due to prolonged inactivity."};
MERGE (n:Knowledge:SemanticSearch {id: "fake:86"}) SET n = {id: "fake:86", name: "Account Inactivity", type: "domain_knowledge", description: "A condition indicating that an account has not demonstrated recent activity based on available data proxies.", definition: "Condition met when: \\text{last activity proxy time} < (\\text{CURRENT_DATE} - \\text{'90 days'})", source_file: "fake_kb.jsonl", source_line: 87, source_id: 86, search_text: "Account Inactivity domain_knowledge A condition indicating that an account has not demonstrated recent activity based on available data proxies. Condition met when: \\text{last activity proxy time} < (\\text{CURRENT_DATE} - \\text{'90 days'})"};
MATCH (d:Database {id: "gaming"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "gaming:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "gaming:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "gaming:" AND NOT stale.id IN ["gaming:0", "gaming:1", "gaming:2", "gaming:3", "gaming:4", "gaming:5", "gaming:6", "gaming:7", "gaming:8", "gaming:9", "gaming:10", "gaming:11", "gaming:12", "gaming:13", "gaming:14", "gaming:15", "gaming:16", "gaming:17", "gaming:18", "gaming:19", "gaming:20", "gaming:21", "gaming:22", "gaming:23", "gaming:24", "gaming:25", "gaming:26", "gaming:27", "gaming:28", "gaming:29", "gaming:30", "gaming:31", "gaming:32", "gaming:33", "gaming:34", "gaming:35", "gaming:36", "gaming:37", "gaming:38", "gaming:39", "gaming:40", "gaming:41", "gaming:42", "gaming:43", "gaming:44", "gaming:45", "gaming:46", "gaming:47", "gaming:48", "gaming:49", "gaming:50", "gaming:51", "gaming:52", "gaming:53"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "gaming:0"}) SET n = {id: "gaming:0", name: "Sensor Performance Index (SPI)", type: "calculation_knowledge", description: "A composite metric that evaluates overall sensor quality based on resolution, accuracy, and response time.", definition: "SPI = \\frac{DpiRes}{1000} \\times \\left(1 - \\frac{McRespTime}{10}\\right) \\times 10, \\text{ where higher values indicate better overall sensor performance with balanced resolution and responsiveness.}", source_file: "gaming_kb.jsonl", source_line: 1, source_id: 0, search_text: "Sensor Performance Index (SPI) calculation_knowledge A composite metric that evaluates overall sensor quality based on resolution, accuracy, and response time. SPI = \\frac{DpiRes}{1000} \\times \\left(1 - \\frac{McRespTime}{10}\\right) \\times 10, \\text{ where higher values indicate better overall sensor performance with balanced resolution and responsiveness.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:1"}) SET n = {id: "gaming:1", name: "Battery Efficiency Ratio (BER)", type: "calculation_knowledge", description: "Measures how efficiently a device uses its battery capacity relative to its power draw under active conditions.", definition: "BER = \\frac{BattLifeH \\times BattCapMah}{PwrActMw \\times 10}, \\text{ where higher values indicate more efficient power management and battery utilization.}", source_file: "gaming_kb.jsonl", source_line: 2, source_id: 1, search_text: "Battery Efficiency Ratio (BER) calculation_knowledge Measures how efficiently a device uses its battery capacity relative to its power draw under active conditions. BER = \\frac{BattLifeH \\times BattCapMah}{PwrActMw \\times 10}, \\text{ where higher values indicate more efficient power management and battery utilization.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:2"}) SET n = {id: "gaming:2", name: "Input Responsiveness Score (IRS)", type: "calculation_knowledge", description: "Quantifies the overall input responsiveness of a device considering polling rate, latency, and response time.", definition: "IRS = \\frac{PollRateHz}{100} \\times \\left(1 - \\frac{InpLagMs + RespTimeMs}{30}\\right) \\times 10, \\text{ where higher values indicate more responsive input with minimal lag.}", source_file: "gaming_kb.jsonl", source_line: 3, source_id: 2, search_text: "Input Responsiveness Score (IRS) calculation_knowledge Quantifies the overall input responsiveness of a device considering polling rate, latency, and response time. IRS = \\frac{PollRateHz}{100} \\times \\left(1 - \\frac{InpLagMs + RespTimeMs}{30}\\right) \\times 10, \\text{ where higher values indicate more responsive input with minimal lag.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:3"}) SET n = {id: "gaming:3", name: "Comfort Index (CI)", type: "calculation_knowledge", description: "Evaluates the ergonomic comfort of a device based on its physical design factors and ergonomic rating.", definition: "CI = \\frac{ErgoRate}{10} \\times \\left(1 + \\frac{(WristFlag ? 1 : 0)}{5}\\right) \\times \\left(1 - \\frac{|PalmAngle - 15|}{45}\\right) \\times 10", source_file: "gaming_kb.jsonl", source_line: 4, source_id: 3, search_text: "Comfort Index (CI) calculation_knowledge Evaluates the ergonomic comfort of a device based on its physical design factors and ergonomic rating. CI = \\frac{ErgoRate}{10} \\times \\left(1 + \\frac{(WristFlag ? 1 : 0)}{5}\\right) \\times \\left(1 - \\frac{|PalmAngle - 15|}{45}\\right) \\times 10"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:4"}) SET n = {id: "gaming:4", name: "Audio Quality Index (AQI)", type: "calculation_knowledge", description: "A comprehensive metric for evaluating audio device quality based on frequency response, distortion, and sensitivity.", definition: "AQI = \\left(1 - \\frac{ThdPct}{2}\\right) \\times \\frac{SpkSenseDb}{100} \\times \\left(1 - \\frac{AudLatMs}{100}\\right) \\times 10, \\text{ where higher values indicate better overall audio quality with minimal distortion.}", source_file: "gaming_kb.jsonl", source_line: 5, source_id: 4, search_text: "Audio Quality Index (AQI) calculation_knowledge A comprehensive metric for evaluating audio device quality based on frequency response, distortion, and sensitivity. AQI = \\left(1 - \\frac{ThdPct}{2}\\right) \\times \\frac{SpkSenseDb}{100} \\times \\left(1 - \\frac{AudLatMs}{100}\\right) \\times 10, \\text{ where higher values indicate better overall audio quality with minimal distortion.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:5"}) SET n = {id: "gaming:5", name: "Switch Performance Rating (SPR)", type: "calculation_knowledge", description: "Rates mechanical switch performance based on durability, consistency, and tactile feedback.", definition: "SPR = \\frac{\\log_{10}(SwtchDur)}{7} \\times SwtchCons \\times \\left(1 - \\frac{KeyChatter}{2}\\right), \\text{ where higher values indicate better switch quality with longer lifespan and consistent performance.}", source_file: "gaming_kb.jsonl", source_line: 6, source_id: 5, search_text: "Switch Performance Rating (SPR) calculation_knowledge Rates mechanical switch performance based on durability, consistency, and tactile feedback. SPR = \\frac{\\log_{10}(SwtchDur)}{7} \\times SwtchCons \\times \\left(1 - \\frac{KeyChatter}{2}\\right), \\text{ where higher values indicate better switch quality with longer lifespan and consistent performance.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:6"}) SET n = {id: "gaming:6", name: "RGB Implementation Quality (RIQ)", type: "calculation_knowledge", description: "Evaluates the quality of RGB implementation based on brightness, color accuracy, and lighting zones.", definition: "RIQ = \\frac{RgbBright}{100} \\times \\frac{RgbColorAcc}{10} \\times \\left(0.5 + \\frac{RgbZones}{20}\\right), \\text{ where higher values indicate premium RGB lighting with accurate colors and extensive customization options.}", source_file: "gaming_kb.jsonl", source_line: 7, source_id: 6, search_text: "RGB Implementation Quality (RIQ) calculation_knowledge Evaluates the quality of RGB implementation based on brightness, color accuracy, and lighting zones. RIQ = \\frac{RgbBright}{100} \\times \\frac{RgbColorAcc}{10} \\times \\left(0.5 + \\frac{RgbZones}{20}\\right), \\text{ where higher values indicate premium RGB lighting with accurate colors and extensive customization options.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:7"}) SET n = {id: "gaming:7", name: "Durability Score (DS)", type: "calculation_knowledge", description: "Quantifies overall device durability based on material quality, environmental resistance, and impact protection.", definition: "DS = \\left(\\frac{DropHtM}{2} + \\frac{BendForce}{100} + \\frac{TwistDeg}{90}\\right) \\times \\frac{UsbConnDur}{10000} \\times 10, \\text{ where higher values indicate more durable devices capable of withstanding physical stress.}", source_file: "gaming_kb.jsonl", source_line: 8, source_id: 7, search_text: "Durability Score (DS) calculation_knowledge Quantifies overall device durability based on material quality, environmental resistance, and impact protection. DS = \\left(\\frac{DropHtM}{2} + \\frac{BendForce}{100} + \\frac{TwistDeg}{90}\\right) \\times \\frac{UsbConnDur}{10000} \\times 10, \\text{ where higher values indicate more durable devices capable of withstanding physical stress.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:8"}) SET n = {id: "gaming:8", name: "Wireless Performance Rating (WPR)", type: "calculation_knowledge", description: "Rates the quality of wireless connectivity based on range, latency, and interference handling.", definition: "WPR = \\frac{WlRangeM}{10} \\times \\left(1 - \\frac{WlLatVar}{5}\\right) \\times \\left(1 + \\frac{WlChanHop}{2}\\right) \\times \\frac{WlSignal + 100}{100}, \\text{ where higher values indicate more reliable wireless performance with better range and stability.}", source_file: "gaming_kb.jsonl", source_line: 9, source_id: 8, search_text: "Wireless Performance Rating (WPR) calculation_knowledge Rates the quality of wireless connectivity based on range, latency, and interference handling. WPR = \\frac{WlRangeM}{10} \\times \\left(1 - \\frac{WlLatVar}{5}\\right) \\times \\left(1 + \\frac{WlChanHop}{2}\\right) \\times \\frac{WlSignal + 100}{100}, \\text{ where higher values indicate more reliable wireless performance with better range and stability.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:9"}) SET n = {id: "gaming:9", name: "Gaming Device Value Index (GDVI)", type: "calculation_knowledge", description: "A comprehensive metric evaluating overall gaming device value considering performance, durability, and comfort.", definition: "GDVI = \\left(SPI \\times 0.3\\right) + \\left(IRS \\times 0.3\\right) + \\left(DS \\times 0.2\\right) + \\left(CI \\times 0.2\\right), \\text{ where higher values indicate better overall device quality across multiple dimensions.}", source_file: "gaming_kb.jsonl", source_line: 10, source_id: 9, search_text: "Gaming Device Value Index (GDVI) calculation_knowledge A comprehensive metric evaluating overall gaming device value considering performance, durability, and comfort. GDVI = \\left(SPI \\times 0.3\\right) + \\left(IRS \\times 0.3\\right) + \\left(DS \\times 0.2\\right) + \\left(CI \\times 0.2\\right), \\text{ where higher values indicate better overall device quality across multiple dimensions.}"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:10"}) SET n = {id: "gaming:10", name: "Premium Gaming Mouse", type: "domain_knowledge", description: "Defines the criteria for a high-end gaming mouse based on sensor performance and ergonomics.", definition: "A mouse with SPI > 7.5, DpiRes ≥ 16000, PollRateHz ≥ 1000, and CI > 8.0, offering exceptional precision and comfort for competitive gaming scenarios.", source_file: "gaming_kb.jsonl", source_line: 11, source_id: 10, search_text: "Premium Gaming Mouse domain_knowledge Defines the criteria for a high-end gaming mouse based on sensor performance and ergonomics. A mouse with SPI > 7.5, DpiRes ≥ 16000, PollRateHz ≥ 1000, and CI > 8.0, offering exceptional precision and comfort for competitive gaming scenarios."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:11"}) SET n = {id: "gaming:11", name: "Tournament-Ready Keyboard", type: "domain_knowledge", description: "Defines what constitutes a keyboard suitable for competitive tournament play based on response time and switch quality.", definition: "A keyboard with IRS > 8.5, ClkLat < 1.0ms, PollRateHz ≥ 1000, and SPR > 8.0, ensuring minimal input latency and consistent actuation during high-pressure competitive scenarios.", source_file: "gaming_kb.jsonl", source_line: 12, source_id: 11, search_text: "Tournament-Ready Keyboard domain_knowledge Defines what constitutes a keyboard suitable for competitive tournament play based on response time and switch quality. A keyboard with IRS > 8.5, ClkLat < 1.0ms, PollRateHz ≥ 1000, and SPR > 8.0, ensuring minimal input latency and consistent actuation during high-pressure competitive scenarios."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:12"}) SET n = {id: "gaming:12", name: "Audiophile Gaming Headset", type: "domain_knowledge", description: "Defines the standards for premium audio quality in gaming headsets suitable for audiophiles.", definition: "A headset with AQI > 8.0, FreqResp covering at least '10Hz-22kHz', ThdPct < 0.5%, and NoiseIsoDb > 15, delivering exceptional sound clarity, detail, and isolation for immersive gaming experiences.", source_file: "gaming_kb.jsonl", source_line: 13, source_id: 12, search_text: "Audiophile Gaming Headset domain_knowledge Defines the standards for premium audio quality in gaming headsets suitable for audiophiles. A headset with AQI > 8.0, FreqResp covering at least '10Hz-22kHz', ThdPct < 0.5%, and NoiseIsoDb > 15, delivering exceptional sound clarity, detail, and isolation for immersive gaming experiences."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:13"}) SET n = {id: "gaming:13", name: "Extended Battery Life Device", type: "domain_knowledge", description: "Identifies devices with exceptionally efficient battery performance for extended gaming sessions.", definition: "A device with BER > 7.5, BattLifeH > 30, QChgFlag = true, and PwrIdleMw < 100, enabling marathon gaming sessions with minimal charging interruptions.", source_file: "gaming_kb.jsonl", source_line: 14, source_id: 13, search_text: "Extended Battery Life Device domain_knowledge Identifies devices with exceptionally efficient battery performance for extended gaming sessions. A device with BER > 7.5, BattLifeH > 30, QChgFlag = true, and PwrIdleMw < 100, enabling marathon gaming sessions with minimal charging interruptions."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:14"}) SET n = {id: "gaming:14", name: "Professional Esports Controller", type: "domain_knowledge", description: "Defines the quality standards for controllers used in professional esports competitions.", definition: "A controller with IRS > 8.0, JoyPrec > 9.0, DriftRes > 9.5, TrigRes ≥ 5, and HapStr > 8, offering precise inputs and reliable performance required for competitive play at the highest level.", source_file: "gaming_kb.jsonl", source_line: 15, source_id: 14, search_text: "Professional Esports Controller domain_knowledge Defines the quality standards for controllers used in professional esports competitions. A controller with IRS > 8.0, JoyPrec > 9.0, DriftRes > 9.5, TrigRes ≥ 5, and HapStr > 8, offering precise inputs and reliable performance required for competitive play at the highest level."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:15"}) SET n = {id: "gaming:15", name: "Streaming-Optimized Device", type: "domain_knowledge", description: "Identifies devices specifically designed for content creators and streamers with appropriate features.", definition: "A device with MicSenseDb < -45, MicFreqResp covering at least '50Hz-18kHz', McRespTime < 1.0, and ProfCount ≥ 5, allowing streamers to capture high-quality audio while maintaining flexible device configurations.", source_file: "gaming_kb.jsonl", source_line: 16, source_id: 15, search_text: "Streaming-Optimized Device domain_knowledge Identifies devices specifically designed for content creators and streamers with appropriate features. A device with MicSenseDb < -45, MicFreqResp covering at least '50Hz-18kHz', McRespTime < 1.0, and ProfCount ≥ 5, allowing streamers to capture high-quality audio while maintaining flexible device configurations."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:16"}) SET n = {id: "gaming:16", name: "Competitive-Grade Durability", type: "domain_knowledge", description: "Defines durability standards for devices intended for intensive competitive use.", definition: "A device with DS > 8.5, UsbConnDur > 15000, DropHtM > 1.5, and GripDur > 1000, designed to withstand the rigors of frequent transport and intensive use during tournament environments.", source_file: "gaming_kb.jsonl", source_line: 17, source_id: 16, search_text: "Competitive-Grade Durability domain_knowledge Defines durability standards for devices intended for intensive competitive use. A device with DS > 8.5, UsbConnDur > 15000, DropHtM > 1.5, and GripDur > 1000, designed to withstand the rigors of frequent transport and intensive use during tournament environments."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:17"}) SET n = {id: "gaming:17", name: "Minimal Input Latency", type: "domain_knowledge", description: "Identifies devices with exceptionally low input latency suitable for reaction-critical games.", definition: "A device with InpLagMs < 1.0, PollRateHz ≥ 1000, LatMs < 2.0, and ClkLat < 0.8, providing almost instantaneous input recognition critical for competitive FPS and fighting games.", source_file: "gaming_kb.jsonl", source_line: 18, source_id: 17, search_text: "Minimal Input Latency domain_knowledge Identifies devices with exceptionally low input latency suitable for reaction-critical games. A device with InpLagMs < 1.0, PollRateHz ≥ 1000, LatMs < 2.0, and ClkLat < 0.8, providing almost instantaneous input recognition critical for competitive FPS and fighting games."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:18"}) SET n = {id: "gaming:18", name: "Premium Wireless Solution", type: "domain_knowledge", description: "Defines high-end wireless gaming devices with performance comparable to wired alternatives.", definition: "A device with WPR > 9.0, ConnType = 'Wireless 2.4GHz', LatMs < 2.5, and BattLifeH > 24, eliminating common wireless drawbacks while maintaining the convenience of cable-free operation.", source_file: "gaming_kb.jsonl", source_line: 19, source_id: 18, search_text: "Premium Wireless Solution domain_knowledge Defines high-end wireless gaming devices with performance comparable to wired alternatives. A device with WPR > 9.0, ConnType = 'Wireless 2.4GHz', LatMs < 2.5, and BattLifeH > 24, eliminating common wireless drawbacks while maintaining the convenience of cable-free operation."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:19"}) SET n = {id: "gaming:19", name: "Full-Featured Gaming Setup", type: "domain_knowledge", description: "Identifies comprehensive gaming setups combining multiple high-quality devices with complementary features.", definition: "A collection of devices where the average GDVI > 8.5 across at least three different device categories (Mouse, Keyboard, Headset, etc.), providing a complete and cohesive premium gaming experience.", source_file: "gaming_kb.jsonl", source_line: 20, source_id: 19, search_text: "Full-Featured Gaming Setup domain_knowledge Identifies comprehensive gaming setups combining multiple high-quality devices with complementary features. A collection of devices where the average GDVI > 8.5 across at least three different device categories (Mouse, Keyboard, Headset, etc.), providing a complete and cohesive premium gaming experience."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:20"}) SET n = {id: "gaming:20", name: "LatMs (Latency)", type: "value_illustration", description: "Illustrates the significance of latency measurements in gaming peripherals for competitive play.", definition: "Measured in milliseconds, representing the delay between user input and system response. Values below 1.0ms enable split-second reactions in fast-paced competitive games, while values above 5.0ms can create noticeable input delay that impacts performance in timing-critical scenarios.", source_file: "gaming_kb.jsonl", source_line: 21, source_id: 20, search_text: "LatMs (Latency) value_illustration Illustrates the significance of latency measurements in gaming peripherals for competitive play. Measured in milliseconds, representing the delay between user input and system response. Values below 1.0ms enable split-second reactions in fast-paced competitive games, while values above 5.0ms can create noticeable input delay that impacts performance in timing-critical scenarios."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:21"}) SET n = {id: "gaming:21", name: "PollRateHz (Polling Rate)", type: "value_illustration", description: "Illustrates the importance of polling rate in gaming device responsiveness.", definition: "Measured in Hertz (times per second), representing how often the device reports its state to the computer. Values of 125Hz are standard for office peripherals, 500Hz is good for casual gaming, 1000Hz is preferred for competitive play, and 4000Hz+ represents cutting-edge technology offering ultra-responsive input for professional esports.", source_file: "gaming_kb.jsonl", source_line: 22, source_id: 21, search_text: "PollRateHz (Polling Rate) value_illustration Illustrates the importance of polling rate in gaming device responsiveness. Measured in Hertz (times per second), representing how often the device reports its state to the computer. Values of 125Hz are standard for office peripherals, 500Hz is good for casual gaming, 1000Hz is preferred for competitive play, and 4000Hz+ represents cutting-edge technology offering ultra-responsive input for professional esports."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:22"}) SET n = {id: "gaming:22", name: "DpiRes (DPI Resolution)", type: "value_illustration", description: "Illustrates the impact of DPI resolution settings on mouse sensitivity and precision.", definition: "Measured in dots per inch, representing sensor tracking precision. Values around 800-1600 are typically used by professional FPS players for precision, while 12000+ allows for extremely fast cursor movement with minimal physical motion, beneficial for MOBAs and strategy games that require covering large screen areas quickly.", source_file: "gaming_kb.jsonl", source_line: 23, source_id: 22, search_text: "DpiRes (DPI Resolution) value_illustration Illustrates the impact of DPI resolution settings on mouse sensitivity and precision. Measured in dots per inch, representing sensor tracking precision. Values around 800-1600 are typically used by professional FPS players for precision, while 12000+ allows for extremely fast cursor movement with minimal physical motion, beneficial for MOBAs and strategy games that require covering large screen areas quickly."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:23"}) SET n = {id: "gaming:23", name: "SwtchDur (Switch Durability)", type: "value_illustration", description: "Illustrates the significance of switch durability ratings in keyboard longevity.", definition: "Measured in actuation cycles before failure. Values around 20 million indicate consumer-grade mechanical switches, 50 million represent premium mechanical switches for enthusiasts, and 100+ million typically denote optical or magnetic switches designed for extended competitive use with minimal degradation over time.", source_file: "gaming_kb.jsonl", source_line: 24, source_id: 23, search_text: "SwtchDur (Switch Durability) value_illustration Illustrates the significance of switch durability ratings in keyboard longevity. Measured in actuation cycles before failure. Values around 20 million indicate consumer-grade mechanical switches, 50 million represent premium mechanical switches for enthusiasts, and 100+ million typically denote optical or magnetic switches designed for extended competitive use with minimal degradation over time."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:24"}) SET n = {id: "gaming:24", name: "ErgoRate (Ergonomic Rating)", type: "value_illustration", description: "Illustrates the significance of ergonomic ratings in gaming peripherals for comfort during extended use.", definition: "Rated on a scale of 1-10, where 1-3 indicates basic designs prioritizing aesthetics over comfort, 4-6 represents good ergonomics for average gaming sessions, 7-8 denotes devices designed for extended comfort, and 9-10 indicates specialized ergonomic designs preventing repetitive strain injuries during marathon sessions.", source_file: "gaming_kb.jsonl", source_line: 25, source_id: 24, search_text: "ErgoRate (Ergonomic Rating) value_illustration Illustrates the significance of ergonomic ratings in gaming peripherals for comfort during extended use. Rated on a scale of 1-10, where 1-3 indicates basic designs prioritizing aesthetics over comfort, 4-6 represents good ergonomics for average gaming sessions, 7-8 denotes devices designed for extended comfort, and 9-10 indicates specialized ergonomic designs preventing repetitive strain injuries during marathon sessions."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:25"}) SET n = {id: "gaming:25", name: "WlSignal (Wireless Signal Strength)", type: "value_illustration", description: "Illustrates the importance of wireless signal strength measurements for stable connectivity.", definition: "Typically measured in dBm, with values ranging from -30 (excellent) to -90 (poor). Signal strength above -50dBm indicates optimal performance with minimal interference, -50 to -70dBm represents good connectivity suitable for most gaming, while below -70dBm may experience occasional disconnections or increased latency in challenging environments.", source_file: "gaming_kb.jsonl", source_line: 26, source_id: 25, search_text: "WlSignal (Wireless Signal Strength) value_illustration Illustrates the importance of wireless signal strength measurements for stable connectivity. Typically measured in dBm, with values ranging from -30 (excellent) to -90 (poor). Signal strength above -50dBm indicates optimal performance with minimal interference, -50 to -70dBm represents good connectivity suitable for most gaming, while below -70dBm may experience occasional disconnections or increased latency in challenging environments."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:26"}) SET n = {id: "gaming:26", name: "ThdPct (Total Harmonic Distortion)", type: "value_illustration", description: "Illustrates the impact of harmonic distortion measurements on audio quality in gaming headsets.", definition: "Measured as a percentage, representing audio signal distortion at high volumes. Values below 0.1% indicate audiophile-grade reproduction with imperceptible distortion, 0.1-0.5% represents excellent gaming audio quality, 0.5-1.0% is acceptable for most gaming scenarios, while values above 1.0% may produce noticeable distortion during intense gaming sequences.", source_file: "gaming_kb.jsonl", source_line: 27, source_id: 26, search_text: "ThdPct (Total Harmonic Distortion) value_illustration Illustrates the impact of harmonic distortion measurements on audio quality in gaming headsets. Measured as a percentage, representing audio signal distortion at high volumes. Values below 0.1% indicate audiophile-grade reproduction with imperceptible distortion, 0.1-0.5% represents excellent gaming audio quality, 0.5-1.0% is acceptable for most gaming scenarios, while values above 1.0% may produce noticeable distortion during intense gaming sequences."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:27"}) SET n = {id: "gaming:27", name: "DriftRes (Drift Resistance)", type: "value_illustration", description: "Illustrates the significance of drift resistance in analog sticks for consistent gaming performance.", definition: "Rated on a scale of 1-10, where values below 5 indicate susceptibility to developing drift over time, 6-8 represents good resistance to drift under normal use conditions, and 9-10 indicates premium Hall Effect or magnetic sensing technologies specifically designed to eliminate drift entirely throughout the controller's lifespan.", source_file: "gaming_kb.jsonl", source_line: 28, source_id: 27, search_text: "DriftRes (Drift Resistance) value_illustration Illustrates the significance of drift resistance in analog sticks for consistent gaming performance. Rated on a scale of 1-10, where values below 5 indicate susceptibility to developing drift over time, 6-8 represents good resistance to drift under normal use conditions, and 9-10 indicates premium Hall Effect or magnetic sensing technologies specifically designed to eliminate drift entirely throughout the controller's lifespan."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:28"}) SET n = {id: "gaming:28", name: "RgbZones (RGB Lighting Zones)", type: "value_illustration", description: "Illustrates the customization potential of RGB lighting zones in gaming peripherals.", definition: "Measured as distinct independently controllable lighting areas. Single-zone devices offer basic lighting effects, 3-5 zones allow for moderate customization like directional effects, 10+ zones enable complex patterns and game-reactive lighting, while per-key RGB (often 100+ zones) provides maximum customization with unique effects for individual keys or areas.", source_file: "gaming_kb.jsonl", source_line: 29, source_id: 28, search_text: "RgbZones (RGB Lighting Zones) value_illustration Illustrates the customization potential of RGB lighting zones in gaming peripherals. Measured as distinct independently controllable lighting areas. Single-zone devices offer basic lighting effects, 3-5 zones allow for moderate customization like directional effects, 10+ zones enable complex patterns and game-reactive lighting, while per-key RGB (often 100+ zones) provides maximum customization with unique effects for individual keys or areas."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:29"}) SET n = {id: "gaming:29", name: "BrdMemMB (Onboard Memory)", type: "value_illustration", description: "Illustrates the significance of onboard memory capacity for storing gaming profiles and settings.", definition: "Measured in megabytes, representing storage for device configurations. Values of 1MB typically store 1-3 basic profiles with limited macros, 4-8MB allows for 5+ detailed profiles with complex macros and lighting effects, while 16MB+ enables tournament players to store numerous game-specific configurations with extensive customization independent of software.", source_file: "gaming_kb.jsonl", source_line: 30, source_id: 29, search_text: "BrdMemMB (Onboard Memory) value_illustration Illustrates the significance of onboard memory capacity for storing gaming profiles and settings. Measured in megabytes, representing storage for device configurations. Values of 1MB typically store 1-3 basic profiles with limited macros, 4-8MB allows for 5+ detailed profiles with complex macros and lighting effects, while 16MB+ enables tournament players to store numerous game-specific configurations with extensive customization independent of software."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:30"}) SET n = {id: "gaming:30", name: "Competitive Gaming Performance Index (CGPI)", type: "calculation_knowledge", description: "A comprehensive metric evaluating a device's suitability for competitive gaming based on response time, accuracy, and durability.", definition: "CGPI = \\left(IRS \\times 0.4\\right) + \\left(SPI \\times 0.3\\right) + \\left(SPR \\times 0.2\\right) + \\left(RAI \\times 0.1\\right)", source_file: "gaming_kb.jsonl", source_line: 31, source_id: 30, search_text: "Competitive Gaming Performance Index (CGPI) calculation_knowledge A comprehensive metric evaluating a device's suitability for competitive gaming based on response time, accuracy, and durability. CGPI = \\left(IRS \\times 0.4\\right) + \\left(SPI \\times 0.3\\right) + \\left(SPR \\times 0.2\\right) + \\left(RAI \\times 0.1\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:31"}) SET n = {id: "gaming:31", name: "Response Accuracy Index (RAI)", type: "calculation_knowledge", description: "Measures the accuracy and consistency of input response in gaming devices, accounting for both sensor precision and control stability.", definition: "RAI = \\left(\\frac{JoyPrec + DpadAcc}{20}\\right) \\times \\left(1 - \\frac{InpLagMs}{10}\\right) \\times 10", source_file: "gaming_kb.jsonl", source_line: 32, source_id: 31, search_text: "Response Accuracy Index (RAI) calculation_knowledge Measures the accuracy and consistency of input response in gaming devices, accounting for both sensor precision and control stability. RAI = \\left(\\frac{JoyPrec + DpadAcc}{20}\\right) \\times \\left(1 - \\frac{InpLagMs}{10}\\right) \\times 10"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:32"}) SET n = {id: "gaming:32", name: "Ergonomic Sustainability Factor (ESF)", type: "calculation_knowledge", description: "Evaluates how suitable a device is for extended gaming sessions based on ergonomic design and comfort metrics.", definition: "ESF = CI \\times \\left(1 + \\frac{ErgoRate - 5}{10}\\right) \\times \\left(1 - \\frac{|PalmAngle - 15|}{30}\\right) \\times \\left(1 + \\frac{ErgoRate \\times WristFlag}{50}\\right)", source_file: "gaming_kb.jsonl", source_line: 33, source_id: 32, search_text: "Ergonomic Sustainability Factor (ESF) calculation_knowledge Evaluates how suitable a device is for extended gaming sessions based on ergonomic design and comfort metrics. ESF = CI \\times \\left(1 + \\frac{ErgoRate - 5}{10}\\right) \\times \\left(1 - \\frac{|PalmAngle - 15|}{30}\\right) \\times \\left(1 + \\frac{ErgoRate \\times WristFlag}{50}\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:33"}) SET n = {id: "gaming:33", name: "Immersion Enhancement Coefficient (IEC)", type: "calculation_knowledge", description: "Quantifies how well a device contributes to gaming immersion through audio quality, haptic feedback, and visual elements.", definition: "IEC = \\left(AQI \\times 0.5\\right) + \\left(HFQ \\times 0.3\\right) + \\left(RIQ \\times 0.2\\right)", source_file: "gaming_kb.jsonl", source_line: 34, source_id: 33, search_text: "Immersion Enhancement Coefficient (IEC) calculation_knowledge Quantifies how well a device contributes to gaming immersion through audio quality, haptic feedback, and visual elements. IEC = \\left(AQI \\times 0.5\\right) + \\left(HFQ \\times 0.3\\right) + \\left(RIQ \\times 0.2\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:34"}) SET n = {id: "gaming:34", name: "Haptic Feedback Quality (HFQ)", type: "calculation_knowledge", description: "Measures the quality and effectiveness of haptic feedback systems in gaming controllers and devices.", definition: "HFQ = \\left(\\frac{HapStr}{10}\\right) \\times \\left(1 + \\frac{VibModes}{10}\\right) \\times \\left(1 + \\frac{ForceFeed\\_length}{20}\\right)", source_file: "gaming_kb.jsonl", source_line: 35, source_id: 34, search_text: "Haptic Feedback Quality (HFQ) calculation_knowledge Measures the quality and effectiveness of haptic feedback systems in gaming controllers and devices. HFQ = \\left(\\frac{HapStr}{10}\\right) \\times \\left(1 + \\frac{VibModes}{10}\\right) \\times \\left(1 + \\frac{ForceFeed\\_length}{20}\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:35"}) SET n = {id: "gaming:35", name: "Wireless Performance Efficiency (WPE)", type: "calculation_knowledge", description: "Evaluates the efficiency of wireless performance relative to battery consumption for untethered gaming devices.", definition: "WPE = WPR \\times \\sqrt{\\frac{BER}{5}} \\times \\left(1 - \\frac{WlLatVar}{3}\\right) \\times 2", source_file: "gaming_kb.jsonl", source_line: 36, source_id: 35, search_text: "Wireless Performance Efficiency (WPE) calculation_knowledge Evaluates the efficiency of wireless performance relative to battery consumption for untethered gaming devices. WPE = WPR \\times \\sqrt{\\frac{BER}{5}} \\times \\left(1 - \\frac{WlLatVar}{3}\\right) \\times 2"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:36"}) SET n = {id: "gaming:36", name: "Gaming Versatility Score (GVS)", type: "calculation_knowledge", description: "Assesses a device's versatility across different gaming genres and use cases based on adaptability and feature set.", definition: "GVS = \\frac{ProfCount + 1}{3} \\times \\left(CGPI \\times 0.6\\right) + \\left(IEC \\times 0.4\\right)", source_file: "gaming_kb.jsonl", source_line: 37, source_id: 36, search_text: "Gaming Versatility Score (GVS) calculation_knowledge Assesses a device's versatility across different gaming genres and use cases based on adaptability and feature set. GVS = \\frac{ProfCount + 1}{3} \\times \\left(CGPI \\times 0.6\\right) + \\left(IEC \\times 0.4\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:37"}) SET n = {id: "gaming:37", name: "Physical Endurance Rating (PER)", type: "calculation_knowledge", description: "Measures the physical endurance of a device under intense gaming conditions, combining durability with effective heat management. ", definition: "PER = DS \\times \\left(1 + \\frac{DustRes score + WaterRes score}{6}\\right) \\times \\left(1 - \\frac{100 - BendForce}{200}\\right), where DustRes and WaterRes are scored based on IP ratings (IPX0=0, IPX1=1, IPX2=2, IPX3=3).", source_file: "gaming_kb.jsonl", source_line: 38, source_id: 37, search_text: "Physical Endurance Rating (PER) calculation_knowledge Measures the physical endurance of a device under intense gaming conditions, combining durability with effective heat management. PER = DS \\times \\left(1 + \\frac{DustRes score + WaterRes score}{6}\\right) \\times \\left(1 - \\frac{100 - BendForce}{200}\\right), where DustRes and WaterRes are scored based on IP ratings (IPX0=0, IPX1=1, IPX2=2, IPX3=3)."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:38"}) SET n = {id: "gaming:38", name: "Professional Adoption Rating (PAR)", type: "calculation_knowledge", description: "Quantifies the level of professional gamer adoption and tournament presence of a device based on performance metrics and pro-level features.", definition: "PAR = \\frac{CGPI}{10} \\times \\left(1 + \\frac{ProfCount}{5}\\right) \\times \\left(\\frac{SPI + IRS}{15}\\right)", source_file: "gaming_kb.jsonl", source_line: 39, source_id: 38, search_text: "Professional Adoption Rating (PAR) calculation_knowledge Quantifies the level of professional gamer adoption and tournament presence of a device based on performance metrics and pro-level features. PAR = \\frac{CGPI}{10} \\times \\left(1 + \\frac{ProfCount}{5}\\right) \\times \\left(\\frac{SPI + IRS}{15}\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:39"}) SET n = {id: "gaming:39", name: "Value Proposition Index (VPI)", type: "calculation_knowledge", description: "A comprehensive metric evaluating a gaming device's overall value by balancing performance, durability, ergonomics, and professional adoption.", definition: "VPI = \\left(GDVI \\times 0.4\\right) + \\left(ESF \\times 0.3\\right) + \\left(PER \\times 0.2\\right) + \\left(PAR \\times 0.1\\right)", source_file: "gaming_kb.jsonl", source_line: 40, source_id: 39, search_text: "Value Proposition Index (VPI) calculation_knowledge A comprehensive metric evaluating a gaming device's overall value by balancing performance, durability, ergonomics, and professional adoption. VPI = \\left(GDVI \\times 0.4\\right) + \\left(ESF \\times 0.3\\right) + \\left(PER \\times 0.2\\right) + \\left(PAR \\times 0.1\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:40"}) SET n = {id: "gaming:40", name: "Tournament Standard Device", type: "domain_knowledge", description: "Defines the minimum requirements for devices used in formal esports tournaments and professional competitions.", definition: "A device that meets the CGPI > 8.0, LatMs < 2.0, PollRateHz ≥ 1000, and WlLatVar < 1.0 if wireless, supporting the precision and reliability demands of tournament play with consistent performance across extended match durations.", source_file: "gaming_kb.jsonl", source_line: 41, source_id: 40, search_text: "Tournament Standard Device domain_knowledge Defines the minimum requirements for devices used in formal esports tournaments and professional competitions. A device that meets the CGPI > 8.0, LatMs < 2.0, PollRateHz ≥ 1000, and WlLatVar < 1.0 if wireless, supporting the precision and reliability demands of tournament play with consistent performance across extended match durations."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:41"}) SET n = {id: "gaming:41", name: "Ergonomic Excellence Certification", type: "domain_knowledge", description: "Designates devices specifically designed to prevent repetitive strain injuries and support extended professional gaming sessions.", definition: "A device with ESF > 8.5, ErgoRate > 8, CI > 8.5, and at least one specialized ergonomic feature (WristFlag = true or PalmAngle between 10-20°), designed to maintain player comfort and prevent strain during marathon gaming sessions.", source_file: "gaming_kb.jsonl", source_line: 42, source_id: 41, search_text: "Ergonomic Excellence Certification domain_knowledge Designates devices specifically designed to prevent repetitive strain injuries and support extended professional gaming sessions. A device with ESF > 8.5, ErgoRate > 8, CI > 8.5, and at least one specialized ergonomic feature (WristFlag = true or PalmAngle between 10-20°), designed to maintain player comfort and prevent strain during marathon gaming sessions."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:42"}) SET n = {id: "gaming:42", name: "Professional Multi-Genre Setup", type: "domain_knowledge", description: "Identifies device configurations specifically optimized for players who compete across multiple game genres at a high level.", definition: "A device or device set with GVS > 8.5, ProfCount ≥ 4, and CGPI > 7.5, providing the adaptability and precision required by players who compete across FPS, MOBA, RTS, and other competitive genres.", source_file: "gaming_kb.jsonl", source_line: 43, source_id: 42, search_text: "Professional Multi-Genre Setup domain_knowledge Identifies device configurations specifically optimized for players who compete across multiple game genres at a high level. A device or device set with GVS > 8.5, ProfCount ≥ 4, and CGPI > 7.5, providing the adaptability and precision required by players who compete across FPS, MOBA, RTS, and other competitive genres."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:43"}) SET n = {id: "gaming:43", name: "Ultra-Responsive Gaming Device", type: "domain_knowledge", description: "Defines the elite tier of input devices with exceptional response characteristics for reaction-critical competitive games.", definition: "A device with IRS > 9.0, RAI > 8.5, LatMs < 1.0, and ClkLat < 0.5, delivering near-instantaneous input recognition essential for competitive gaming at the highest levels where milliseconds determine outcomes.", source_file: "gaming_kb.jsonl", source_line: 44, source_id: 43, search_text: "Ultra-Responsive Gaming Device domain_knowledge Defines the elite tier of input devices with exceptional response characteristics for reaction-critical competitive games. A device with IRS > 9.0, RAI > 8.5, LatMs < 1.0, and ClkLat < 0.5, delivering near-instantaneous input recognition essential for competitive gaming at the highest levels where milliseconds determine outcomes."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:44"}) SET n = {id: "gaming:44", name: "Premium Immersive Experience Device", type: "domain_knowledge", description: "Identifies devices specifically optimized to enhance gaming immersion through superior sensory feedback.", definition: "A device with IEC > 8.0, AQI > 7.5, HFQ > 8.0 if applicable, and RIQ > 7.0 if featuring lighting, designed to maximize player immersion in atmospheric and narrative-driven games.", source_file: "gaming_kb.jsonl", source_line: 45, source_id: 44, search_text: "Premium Immersive Experience Device domain_knowledge Identifies devices specifically optimized to enhance gaming immersion through superior sensory feedback. A device with IEC > 8.0, AQI > 7.5, HFQ > 8.0 if applicable, and RIQ > 7.0 if featuring lighting, designed to maximize player immersion in atmospheric and narrative-driven games."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:45"}) SET n = {id: "gaming:45", name: "Extended Tournament Ready Wireless", type: "domain_knowledge", description: "Defines wireless devices suitable for full-day tournament use without connectivity or battery concerns.", definition: "A wireless device with WPE > 8.5, BER > 7.0, BattLifeH > 40, and LatMs < 2.5, providing reliable, tournament-grade performance throughout extended competition days without requiring recharging or experiencing degraded responsiveness.", source_file: "gaming_kb.jsonl", source_line: 46, source_id: 45, search_text: "Extended Tournament Ready Wireless domain_knowledge Defines wireless devices suitable for full-day tournament use without connectivity or battery concerns. A wireless device with WPE > 8.5, BER > 7.0, BattLifeH > 40, and LatMs < 2.5, providing reliable, tournament-grade performance throughout extended competition days without requiring recharging or experiencing degraded responsiveness."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:46"}) SET n = {id: "gaming:46", name: "Professional-Grade Control Consistency", type: "domain_knowledge", description: "Identifies controllers and input devices with exceptionally consistent control characteristics required for high-level competitive play.", definition: "A device with RAI > 8.5, SwtchCons > 9.0, JoyPrec > 9.0 (if applicable), and DriftRes > 9.0 (if featuring analog sticks), delivering the precise, predictable input response professional players rely on for muscle memory development and consistent performance across practice and tournament environments.", source_file: "gaming_kb.jsonl", source_line: 47, source_id: 46, search_text: "Professional-Grade Control Consistency domain_knowledge Identifies controllers and input devices with exceptionally consistent control characteristics required for high-level competitive play. A device with RAI > 8.5, SwtchCons > 9.0, JoyPrec > 9.0 (if applicable), and DriftRes > 9.0 (if featuring analog sticks), delivering the precise, predictable input response professional players rely on for muscle memory development and consistent performance across practice and tournament environments."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:47"}) SET n = {id: "gaming:47", name: "Ultra-Durable Tournament Device", type: "domain_knowledge", description: "Defines devices with exceptional physical durability designed to withstand the rigors of frequent tournament travel and intensive competition use.", definition: "A device with PER > 9.0, DS > 8.5, UsbConnDur > 20000, and at least one premium durability feature (DropHtM > 2.0 or WaterRes containing 'IPX7' or higher), engineered to maintain performance integrity despite frequent transportation, setup/teardown cycles, and competition intensity.", source_file: "gaming_kb.jsonl", source_line: 48, source_id: 47, search_text: "Ultra-Durable Tournament Device domain_knowledge Defines devices with exceptional physical durability designed to withstand the rigors of frequent tournament travel and intensive competition use. A device with PER > 9.0, DS > 8.5, UsbConnDur > 20000, and at least one premium durability feature (DropHtM > 2.0 or WaterRes containing 'IPX7' or higher), engineered to maintain performance integrity despite frequent transportation, setup/teardown cycles, and competition intensity."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:48"}) SET n = {id: "gaming:48", name: "Pro-Player Performance Certified", type: "domain_knowledge", description: "Identifies devices that have been validated through professional player testing and competition use at the highest levels.", definition: "A device with PAR > 8.5, CGPI > 8.0, and specialized features matching competitive requirements for at least two major esports titles, representing equipment that has proven its performance capabilities in professional tournament environments.", source_file: "gaming_kb.jsonl", source_line: 49, source_id: 48, search_text: "Pro-Player Performance Certified domain_knowledge Identifies devices that have been validated through professional player testing and competition use at the highest levels. A device with PAR > 8.5, CGPI > 8.0, and specialized features matching competitive requirements for at least two major esports titles, representing equipment that has proven its performance capabilities in professional tournament environments."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:49"}) SET n = {id: "gaming:49", name: "Elite Gaming Ecosystem", type: "domain_knowledge", description: "Identifies comprehensive device ecosystems that deliver exceptional performance across all gaming interaction points for competitive players.", definition: "A multi-device setup where each component achieves VPI > 8.5, with an average GDVI > 9.0 across at least three different device categories, providing seamless integration and consistent high performance across all player-game interaction points to maximize competitive advantage.", source_file: "gaming_kb.jsonl", source_line: 50, source_id: 49, search_text: "Elite Gaming Ecosystem domain_knowledge Identifies comprehensive device ecosystems that deliver exceptional performance across all gaming interaction points for competitive players. A multi-device setup where each component achieves VPI > 8.5, with an average GDVI > 9.0 across at least three different device categories, providing seamless integration and consistent high performance across all player-game interaction points to maximize competitive advantage."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:50"}) SET n = {id: "gaming:50", name: "Battery Efficiency Classification", type: "domain_knowledge", description: "A categorical framework for evaluating and classifying the battery efficiency of gaming devices based on their Battery Efficiency Ratio (BER).", definition: "A classification system that segments wireless gaming devices into four efficiency categories: 'Excellent Efficiency' (BER > 7.5) indicating marathon gaming capability, 'Good Efficiency' (BER between 5.0 and 7.5) for extended gaming sessions, 'Average Efficiency' (BER between 2.5 and 4.9) suitable for regular gameplay, and 'Poor Efficiency' (BER < 2.5) requiring frequent recharging, providing standardized comparison metrics across different gaming peripherals.", source_file: "gaming_kb.jsonl", source_line: 51, source_id: 50, search_text: "Battery Efficiency Classification domain_knowledge A categorical framework for evaluating and classifying the battery efficiency of gaming devices based on their Battery Efficiency Ratio (BER). A classification system that segments wireless gaming devices into four efficiency categories: 'Excellent Efficiency' (BER > 7.5) indicating marathon gaming capability, 'Good Efficiency' (BER between 5.0 and 7.5) for extended gaming sessions, 'Average Efficiency' (BER between 2.5 and 4.9) suitable for regular gameplay, and 'Poor Efficiency' (BER < 2.5) requiring frequent recharging, providing standardized comparison metrics across different gaming peripherals."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:51"}) SET n = {id: "gaming:51", name: "RGB Quality Classification", type: "domain_knowledge", description: "A systematic framework for categorizing the quality of RGB lighting implementations in gaming peripherals based on the RGB Implementation Quality (RIQ) score.", definition: "A classification system that segments gaming devices into four RGB quality categories: 'Premium RGB Implementation' (RIQ > 8.0) indicating exceptional color accuracy and customization capabilities, 'High-Quality RGB' (RIQ between 6.0 and 8.0) for advanced lighting effects with good color reproduction, 'Standard RGB' (RIQ between 3.0 and 5.9) suitable for basic customization needs, and 'Basic RGB' (RIQ < 3.0) offering limited lighting features, providing standardized comparison metrics for RGB lighting quality across gaming peripherals.", source_file: "gaming_kb.jsonl", source_line: 52, source_id: 51, search_text: "RGB Quality Classification domain_knowledge A systematic framework for categorizing the quality of RGB lighting implementations in gaming peripherals based on the RGB Implementation Quality (RIQ) score. A classification system that segments gaming devices into four RGB quality categories: 'Premium RGB Implementation' (RIQ > 8.0) indicating exceptional color accuracy and customization capabilities, 'High-Quality RGB' (RIQ between 6.0 and 8.0) for advanced lighting effects with good color reproduction, 'Standard RGB' (RIQ between 3.0 and 5.9) suitable for basic customization needs, and 'Basic RGB' (RIQ < 3.0) offering limited lighting features, providing standardized comparison metrics for RGB lighting quality across gaming peripherals."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:52"}) SET n = {id: "gaming:52", name: "Subpar Audio Device Identification", type: "domain_knowledge", description: "Identifies audio devices that fail to meet audiophile gaming standards and need improvement or removal from premium product lines", definition: "Audio devices with one or more critical quality deficiencies: AQI score of 8.0 or lower, total harmonic distortion (ThdPct) of 0.5% or higher, noise isolation (NoiseIsoDb) of 15dB or lower, or frequency response not covering the full 10Hz-22kHz range required for immersive gaming audio experiences. These devices are candidates for improvement or reclassification to non-audiophile product categories.", source_file: "gaming_kb.jsonl", source_line: 53, source_id: 52, search_text: "Subpar Audio Device Identification domain_knowledge Identifies audio devices that fail to meet audiophile gaming standards and need improvement or removal from premium product lines Audio devices with one or more critical quality deficiencies: AQI score of 8.0 or lower, total harmonic distortion (ThdPct) of 0.5% or higher, noise isolation (NoiseIsoDb) of 15dB or lower, or frequency response not covering the full 10Hz-22kHz range required for immersive gaming audio experiences. These devices are candidates for improvement or reclassification to non-audiophile product categories."};
MERGE (n:Knowledge:SemanticSearch {id: "gaming:53"}) SET n = {id: "gaming:53", name: "Global Efficiency Percentile (GEP)", type: "calculation_knowledge", description: "Ranks a device’s Battery Efficiency Ratio (BER) relative to all other wireless gaming devices.", definition: "GEP = \\text{PERCENT\\_RANK}()_{BER} \\times 100, where PERCENT\\_RANK() is computed over all devices sorted by BER; 0\\% corresponds to the lowest BER and 100\\% to the highest.", source_file: "gaming_kb.jsonl", source_line: 54, source_id: 53, search_text: "Global Efficiency Percentile (GEP) calculation_knowledge Ranks a device’s Battery Efficiency Ratio (BER) relative to all other wireless gaming devices. GEP = \\text{PERCENT\\_RANK}()_{BER} \\times 100, where PERCENT\\_RANK() is computed over all devices sorted by BER; 0\\% corresponds to the lowest BER and 100\\% to the highest."};
MATCH (d:Database {id: "insider"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "insider:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "insider:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "insider:" AND NOT stale.id IN ["insider:0", "insider:1", "insider:2", "insider:3", "insider:4", "insider:5", "insider:6", "insider:7", "insider:8", "insider:9", "insider:10", "insider:11", "insider:12", "insider:13", "insider:14", "insider:15", "insider:16", "insider:17", "insider:18", "insider:19", "insider:20", "insider:21", "insider:22", "insider:23", "insider:24", "insider:25", "insider:26", "insider:27", "insider:28", "insider:29", "insider:30", "insider:31", "insider:32", "insider:33", "insider:34", "insider:35", "insider:36", "insider:37", "insider:38", "insider:39", "insider:40", "insider:41", "insider:42", "insider:43", "insider:44", "insider:45", "insider:46", "insider:47", "insider:48", "insider:49", "insider:50", "insider:51", "insider:52", "insider:53", "insider:54", "insider:55", "insider:56", "insider:57", "insider:58", "insider:59", "insider:60", "insider:61", "insider:62", "insider:63", "insider:64", "insider:65", "insider:66", "insider:67", "insider:68", "insider:69", "insider:70", "insider:71", "insider:72", "insider:73"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "insider:0"}) SET n = {id: "insider:0", name: "Daily Turnover Rate (DTR)", type: "calculation_knowledge", description: "Calculates the ratio of a trader's daily trading volume to their account balance, indicating capital velocity.", definition: "DTR = \\frac{\\text{voldaily}}{\\text{acctbal}}", source_file: "insider_kb.jsonl", source_line: 1, source_id: 0, search_text: "Daily Turnover Rate (DTR) calculation_knowledge Calculates the ratio of a trader's daily trading volume to their account balance, indicating capital velocity. DTR = \\frac{\\text{voldaily}}{\\text{acctbal}}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:1"}) SET n = {id: "insider:1", name: "Order Modification Intensity (OMI)", type: "calculation_knowledge", description: "Measures how frequently a trader modifies orders relative to their cancellation rate.", definition: "OMI = \\frac{\\text{modfreq}}{1 - \\text{cancelpct}} \\text{ (undefined if cancelpct = 1)}", source_file: "insider_kb.jsonl", source_line: 2, source_id: 1, search_text: "Order Modification Intensity (OMI) calculation_knowledge Measures how frequently a trader modifies orders relative to their cancellation rate. OMI = \\frac{\\text{modfreq}}{1 - \\text{cancelpct}} \\text{ (undefined if cancelpct = 1)}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:2"}) SET n = {id: "insider:2", name: "Trader Leverage Exposure (TLE)", type: "calculation_knowledge", description: "Extracts the leverage ratio from the trader's performance data.", definition: "TLE = \\text{trading_performance.risklevel.levratio}", source_file: "insider_kb.jsonl", source_line: 3, source_id: 2, search_text: "Trader Leverage Exposure (TLE) calculation_knowledge Extracts the leverage ratio from the trader's performance data. TLE = \\text{trading_performance.risklevel.levratio}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:3"}) SET n = {id: "insider:3", name: "Suspicious Activity Index (SAI)", type: "calculation_knowledge", description: "A composite index attempting to quantify overall suspicious trading behavior based on risk indicators.", definition: "SAI = (w_1 \\times \\text{SpoofProbNorm}) + (w_2 \\times \\text{FrontScoreNorm}) + (w_3 \\times \\text{QStuffNorm}) + (w_4 \\times \\text{WashSusNorm}) + (w_5 \\times \\text{LayerIndNorm}) \\\\ \\text{where } \\text{SpoofProbNorm} = \\frac{\\text{risk_indicators.spoofprob}}{100} \\\\ \\text{FrontScoreNorm} = \\frac{\\text{risk_indicators.frontscore}}{100} \\text{ (assuming max score is 100)} \\\\ \\text{QStuffNorm} = \\text{MinMaxScale}(\\text{risk_indicators.qstuffindex}) \\\\ \\text{WashSusNorm} = \\text{MapToNumeric}(\\text{risk_indicators.washsus}, {'Low': 0.1, 'Medium': 0.5, 'High': 1.0}) \\\\ \\text{LayerIndNorm} = \\text{MapToNumeric}(\\text{risk_indicators.layerind}, {'None': 0.0, 'Suspected': 0.5, 'Confirmed': 1.0}) \\\\ w_i \\text{ are weights assigned based on importance, summing to 1.}", source_file: "insider_kb.jsonl", source_line: 4, source_id: 3, search_text: "Suspicious Activity Index (SAI) calculation_knowledge A composite index attempting to quantify overall suspicious trading behavior based on risk indicators. SAI = (w_1 \\times \\text{SpoofProbNorm}) + (w_2 \\times \\text{FrontScoreNorm}) + (w_3 \\times \\text{QStuffNorm}) + (w_4 \\times \\text{WashSusNorm}) + (w_5 \\times \\text{LayerIndNorm}) \\\\ \\text{where } \\text{SpoofProbNorm} = \\frac{\\text{risk_indicators.spoofprob}}{100} \\\\ \\text{FrontScoreNorm} = \\frac{\\text{risk_indicators.frontscore}}{100} \\text{ (assuming max score is 100)} \\\\ \\text{QStuffNorm} = \\text{MinMaxScale}(\\text{risk_indicators.qstuffindex}) \\\\ \\text{WashSusNorm} = \\text{MapToNumeric}(\\text{risk_indicators.washsus}, {'Low': 0.1, 'Medium': 0.5, 'High': 1.0}) \\\\ \\text{LayerIndNorm} = \\text{MapToNumeric}(\\text{risk_indicators.layerind}, {'None': 0.0, 'Suspected': 0.5, 'Confirmed': 1.0}) \\\\ w_i \\text{ are weights assigned based on importance, summing to 1.}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:4"}) SET n = {id: "insider:4", name: "Pattern Anomaly Score (PAS)", type: "calculation_knowledge", description: "Measures the deviation of a trader's pattern similarity from their peer correlation, potentially indicating unique illicit behavior.", definition: "PAS = |\\text{patsim} - \\text{peercorr}|", source_file: "insider_kb.jsonl", source_line: 5, source_id: 4, search_text: "Pattern Anomaly Score (PAS) calculation_knowledge Measures the deviation of a trader's pattern similarity from their peer correlation, potentially indicating unique illicit behavior. PAS = |\\text{patsim} - \\text{peercorr}|"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:5"}) SET n = {id: "insider:5", name: "Compliance Recidivism Score (CRS)", type: "calculation_knowledge", description: "Calculates a score indicating the tendency for repeat compliance issues, adjusted for account age.", definition: "CRS = \\frac{\\text{prevviol}}{\\text{Max}(1, \\frac{\\text{acctdays}}{365})} \\text{ (joining compliancecase to trader via transactionrecord)}", source_file: "insider_kb.jsonl", source_line: 6, source_id: 5, search_text: "Compliance Recidivism Score (CRS) calculation_knowledge Calculates a score indicating the tendency for repeat compliance issues, adjusted for account age. CRS = \\frac{\\text{prevviol}}{\\text{Max}(1, \\frac{\\text{acctdays}}{365})} \\text{ (joining compliancecase to trader via transactionrecord)}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:6"}) SET n = {id: "insider:6", name: "Investigation Intensity Index (III)", type: "calculation_knowledge", description: "Combines behavioral and network analysis scores from an investigation.", definition: "III = (0.6 \\times \\text{behansc}) + (0.4 \\times \\text{netansc})", source_file: "insider_kb.jsonl", source_line: 7, source_id: 6, search_text: "Investigation Intensity Index (III) calculation_knowledge Combines behavioral and network analysis scores from an investigation. III = (0.6 \\times \\text{behansc}) + (0.4 \\times \\text{netansc})"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:7"}) SET n = {id: "insider:7", name: "Sentiment Divergence Factor (SDF)", type: "calculation_knowledge", description: "Measures the difference between news and social media sentiment scores.", definition: "SDF = |\\text{newsscore} - \\text{socscore}|", source_file: "insider_kb.jsonl", source_line: 8, source_id: 7, search_text: "Sentiment Divergence Factor (SDF) calculation_knowledge Measures the difference between news and social media sentiment scores. SDF = |\\text{newsscore} - \\text{socscore}|"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:8"}) SET n = {id: "insider:8", name: "Relative Short Interest (RSI)", type: "calculation_knowledge", description: "Calculates short interest ratio relative to institutional ownership.", definition: "RSI = \\frac{\\text{shortintrt}}{\\text{instownpct}} \\text{ (undefined if instownpct = 0)}", source_file: "insider_kb.jsonl", source_line: 9, source_id: 8, search_text: "Relative Short Interest (RSI) calculation_knowledge Calculates short interest ratio relative to institutional ownership. RSI = \\frac{\\text{shortintrt}}{\\text{instownpct}} \\text{ (undefined if instownpct = 0)}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:9"}) SET n = {id: "insider:9", name: "Enforcement Financial Impact Ratio (EFIR)", type: "calculation_knowledge", description: "Calculates the ratio of the penalty amount to the trader's account balance at the time of the related transaction.", definition: "EFIR = \\frac{\\text{penamt}}{\\text{acctbal}}", source_file: "insider_kb.jsonl", source_line: 10, source_id: 9, search_text: "Enforcement Financial Impact Ratio (EFIR) calculation_knowledge Calculates the ratio of the penalty amount to the trader's account balance at the time of the related transaction. EFIR = \\frac{\\text{penamt}}{\\text{acctbal}}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:10"}) SET n = {id: "insider:10", name: "High-Risk Trader Profile", type: "domain_knowledge", description: "Identifies traders exhibiting characteristics associated with high-risk trading strategies.", definition: "A trader is considered High-Risk if their TLE > 5.0 AND their `trading_performance.risklevel.risklevel` is 'Aggressive' OR their DTR > 0.5.", source_file: "insider_kb.jsonl", source_line: 11, source_id: 10, search_text: "High-Risk Trader Profile domain_knowledge Identifies traders exhibiting characteristics associated with high-risk trading strategies. A trader is considered High-Risk if their TLE > 5.0 AND their `trading_performance.risklevel.risklevel` is 'Aggressive' OR their DTR > 0.5."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:11"}) SET n = {id: "insider:11", name: "Potential Insider Trading Flag", type: "domain_knowledge", description: "Flags transactions potentially linked to insider knowledge based on timing and context.", definition: "A transaction is flagged if `infoleaksc` > 50.0 AND `corpeventprx` is NOT NULL AND `eventannotm` is 'Pre-market' or 'Intraday'.", source_file: "insider_kb.jsonl", source_line: 12, source_id: 11, search_text: "Potential Insider Trading Flag domain_knowledge Flags transactions potentially linked to insider knowledge based on timing and context. A transaction is flagged if `infoleaksc` > 50.0 AND `corpeventprx` is NOT NULL AND `eventannotm` is 'Pre-market' or 'Intraday'."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:12"}) SET n = {id: "insider:12", name: "Market Manipulation Pattern: Layering/Spoofing", type: "domain_knowledge", description: "Identifies trading sessions indicative of layering or spoofing tactics.", definition: "A transaction record suggests Layering/Spoofing if `risk_indicators.layerind` is 'Confirmed' OR (`risk_indicators.spoofprob` > 0.75 AND OMI > 1.0).", source_file: "insider_kb.jsonl", source_line: 13, source_id: 12, search_text: "Market Manipulation Pattern: Layering/Spoofing domain_knowledge Identifies trading sessions indicative of layering or spoofing tactics. A transaction record suggests Layering/Spoofing if `risk_indicators.layerind` is 'Confirmed' OR (`risk_indicators.spoofprob` > 0.75 AND OMI > 1.0)."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:13"}) SET n = {id: "insider:13", name: "Collusion Network Indicator", type: "domain_knowledge", description: "Suggests potential collusion based on investigation details.", definition: "A case indicates potential collusion if `tcirclesz` > 5 AND `grpbehsc` > 0.6 AND `commpat` is 'Regular'.", source_file: "insider_kb.jsonl", source_line: 14, source_id: 13, search_text: "Collusion Network Indicator domain_knowledge Suggests potential collusion based on investigation details. A case indicates potential collusion if `tcirclesz` > 5 AND `grpbehsc` > 0.6 AND `commpat` is 'Regular'."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:14"}) SET n = {id: "insider:14", name: "Elevated Regulatory Scrutiny", type: "domain_knowledge", description: "Identifies compliance cases under intense review or investigation.", definition: "A case is under Elevated Regulatory Scrutiny if `alertlvl` is 'High' or 'Critical' AND `invstprior` is 'High' AND `monitint` is 'Intensive'.", source_file: "insider_kb.jsonl", source_line: 15, source_id: 14, search_text: "Elevated Regulatory Scrutiny domain_knowledge Identifies compliance cases under intense review or investigation. A case is under Elevated Regulatory Scrutiny if `alertlvl` is 'High' or 'Critical' AND `invstprior` is 'High' AND `monitint` is 'Intensive'."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:15"}) SET n = {id: "insider:15", name: "Problematic Compliance History", type: "domain_knowledge", description: "Identifies traders with a poor track record of compliance.", definition: "A trader has a Problematic Compliance History if they have `prevviol` > 3 OR their `comprate` is 'C' or 'D' OR their CRS > 1.0.", source_file: "insider_kb.jsonl", source_line: 16, source_id: 15, search_text: "Problematic Compliance History domain_knowledge Identifies traders with a poor track record of compliance. A trader has a Problematic Compliance History if they have `prevviol` > 3 OR their `comprate` is 'C' or 'D' OR their CRS > 1.0."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:16"}) SET n = {id: "insider:16", name: "Wash Trading Alert", type: "domain_knowledge", description: "Flags transactions highly suspicious for wash trading.", definition: "A transaction triggers a Wash Trading Alert if `risk_indicators.washsus` is 'High'.", source_file: "insider_kb.jsonl", source_line: 17, source_id: 16, search_text: "Wash Trading Alert domain_knowledge Flags transactions highly suspicious for wash trading. A transaction triggers a Wash Trading Alert if `risk_indicators.washsus` is 'High'."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:17"}) SET n = {id: "insider:17", name: "Event-Driven Trader", type: "domain_knowledge", description: "Classifies traders whose activity appears strongly linked to corporate events.", definition: "A trader may be classified as Event-Driven if a significant portion (>30%) of their transactionrecord entries (linked via trdref) have a non-null corpeventprx (joined via transref).", source_file: "insider_kb.jsonl", source_line: 18, source_id: 17, search_text: "Event-Driven Trader domain_knowledge Classifies traders whose activity appears strongly linked to corporate events. A trader may be classified as Event-Driven if a significant portion (>30%) of their transactionrecord entries (linked via trdref) have a non-null corpeventprx (joined via transref)."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:18"}) SET n = {id: "insider:18", name: "High Cancellation/Modification Trader", type: "domain_knowledge", description: "Identifies traders who frequently cancel or modify orders, potentially indicating manipulative intent or poor execution strategy.", definition: "A trader is flagged if their average cancelpct > 0.5 OR their average OMI > 1.5 across their transactions.", source_file: "insider_kb.jsonl", source_line: 19, source_id: 18, search_text: "High Cancellation/Modification Trader domain_knowledge Identifies traders who frequently cancel or modify orders, potentially indicating manipulative intent or poor execution strategy. A trader is flagged if their average cancelpct > 0.5 OR their average OMI > 1.5 across their transactions."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:19"}) SET n = {id: "insider:19", name: "Significant Enforcement Action", type: "domain_knowledge", description: "Categorizes enforcement actions that represent substantial penalties or restrictions.", definition: "An action is considered a Significant Enforcement Action if `penimp` is 'Fine' or 'Ban' OR `acttake` is 'Suspension' OR `busrestr` is 'Full'.", source_file: "insider_kb.jsonl", source_line: 20, source_id: 19, search_text: "Significant Enforcement Action domain_knowledge Categorizes enforcement actions that represent substantial penalties or restrictions. An action is considered a Significant Enforcement Action if `penimp` is 'Fine' or 'Ban' OR `acttake` is 'Suspension' OR `busrestr` is 'Full'."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:20"}) SET n = {id: "insider:20", name: "Trader Position Holding Style", type: "value_illustration", description: "Illustrates the typical duration traders hold their positions, based on their strategy.", definition: "`posspan`: 'Intraday' implies positions are typically opened and closed within the same trading day. 'Swing' suggests holding for a few days to weeks, capturing short-term price moves. 'Position' implies holding for weeks to months, based on broader trends. 'Long-term' indicates holding for months or years, often based on fundamental analysis.", source_file: "insider_kb.jsonl", source_line: 21, source_id: 20, search_text: "Trader Position Holding Style value_illustration Illustrates the typical duration traders hold their positions, based on their strategy. `posspan`: 'Intraday' implies positions are typically opened and closed within the same trading day. 'Swing' suggests holding for a few days to weeks, capturing short-term price moves. 'Position' implies holding for weeks to months, based on broader trends. 'Long-term' indicates holding for months or years, often based on fundamental analysis."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:21"}) SET n = {id: "insider:21", name: "Dark Pool Usage Venues", type: "value_illustration", description: "Explains the nature of dark pool usage indicated in transaction records.", definition: "`darkusage`: This field lists Alternative Trading Systems (ATS) or other dark pools used. 'ATS-X', 'ATS-Y' are anonymized identifiers for specific dark pools, which are private exchanges where large orders can be executed without revealing intent to the public market, potentially reducing market impact. Usage patterns can be analyzed for regulatory compliance (e.g., ensuring best execution) or signs of avoiding market transparency.", source_file: "insider_kb.jsonl", source_line: 22, source_id: 21, search_text: "Dark Pool Usage Venues value_illustration Explains the nature of dark pool usage indicated in transaction records. `darkusage`: This field lists Alternative Trading Systems (ATS) or other dark pools used. 'ATS-X', 'ATS-Y' are anonymized identifiers for specific dark pools, which are private exchanges where large orders can be executed without revealing intent to the public market, potentially reducing market impact. Usage patterns can be analyzed for regulatory compliance (e.g., ensuring best execution) or signs of avoiding market transparency."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:22"}) SET n = {id: "insider:22", name: "Off-Market Trading Activity", type: "value_illustration", description: "Illustrates types of trading activity occurring outside public exchanges.", definition: "`offmkt`: Describes trades not executed on lit exchanges. 'Internal crosses' specifically refer to a broker matching buy and sell orders from their own clients internally, without routing them to a public exchange. This can be efficient but requires monitoring to ensure fairness and prevent potential conflicts of interest.", source_file: "insider_kb.jsonl", source_line: 23, source_id: 22, search_text: "Off-Market Trading Activity value_illustration Illustrates types of trading activity occurring outside public exchanges. `offmkt`: Describes trades not executed on lit exchanges. 'Internal crosses' specifically refer to a broker matching buy and sell orders from their own clients internally, without routing them to a public exchange. This can be efficient but requires monitoring to ensure fairness and prevent potential conflicts of interest."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:23"}) SET n = {id: "insider:23", name: "Order Type Distribution", type: "value_illustration", description: "Illustrates the mix of primary order types used by a trader.", definition: "`ordertypedist`: 'Market' indicates primarily using market orders (execute immediately at the best available price, prioritizing speed over price). 'Limit' indicates primarily using limit orders (execute only at a specified price or better, prioritizing price over speed). 'Mixed' suggests a combination of order types, reflecting varied trading strategies or objectives.", source_file: "insider_kb.jsonl", source_line: 24, source_id: 23, search_text: "Order Type Distribution value_illustration Illustrates the mix of primary order types used by a trader. `ordertypedist`: 'Market' indicates primarily using market orders (execute immediately at the best available price, prioritizing speed over price). 'Limit' indicates primarily using limit orders (execute only at a specified price or better, prioritizing price over speed). 'Mixed' suggests a combination of order types, reflecting varied trading strategies or objectives."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:24"}) SET n = {id: "insider:24", name: "Momentum Ignition Signals", type: "value_illustration", description: "Explains the signals related to attempting to artificially create price momentum.", definition: "`risk_indicators.momentignit`: 'Strong' indicates patterns consistent with attempts to trigger momentum algorithms or attract other traders by creating a false sense of rapid price movement (e.g., through rapid successive trades). 'Weak' suggests such patterns are less evident or absent. This is a potential indicator of manipulative behavior.", source_file: "insider_kb.jsonl", source_line: 25, source_id: 24, search_text: "Momentum Ignition Signals value_illustration Explains the signals related to attempting to artificially create price momentum. `risk_indicators.momentignit`: 'Strong' indicates patterns consistent with attempts to trigger momentum algorithms or attract other traders by creating a false sense of rapid price movement (e.g., through rapid successive trades). 'Weak' suggests such patterns are less evident or absent. This is a potential indicator of manipulative behavior."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:25"}) SET n = {id: "insider:25", name: "Marking the Close Patterns", type: "value_illustration", description: "Explains the patterns associated with influencing the closing price of a security.", definition: "`risk_indicators.markclosepat`: 'Frequent' indicates repeated trading activity near the market close, potentially intended to manipulate the closing price (e.g., to affect margin calls, NAV calculations, or settlement prices). 'Occasional' suggests such activity is infrequent or less patterned. Marking the close is a prohibited manipulative practice.", source_file: "insider_kb.jsonl", source_line: 26, source_id: 25, search_text: "Marking the Close Patterns value_illustration Explains the patterns associated with influencing the closing price of a security. `risk_indicators.markclosepat`: 'Frequent' indicates repeated trading activity near the market close, potentially intended to manipulate the closing price (e.g., to affect margin calls, NAV calculations, or settlement prices). 'Occasional' suggests such activity is infrequent or less patterned. Marking the close is a prohibited manipulative practice."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:26"}) SET n = {id: "insider:26", name: "Unusual Option Activity Level", type: "value_illustration", description: "Illustrates the degree of detected unusual options trading volume or types.", definition: "`unuoptact`: 'High' suggests significant deviations from normal option trading patterns in terms of volume, strike prices, or expiration dates, potentially indicating informed trading or speculation ahead of news. 'Moderate' indicates some unusual activity, but less pronounced. This can be a flag for investigating potential insider information.", source_file: "insider_kb.jsonl", source_line: 27, source_id: 26, search_text: "Unusual Option Activity Level value_illustration Illustrates the degree of detected unusual options trading volume or types. `unuoptact`: 'High' suggests significant deviations from normal option trading patterns in terms of volume, strike prices, or expiration dates, potentially indicating informed trading or speculation ahead of news. 'Moderate' indicates some unusual activity, but less pronounced. This can be a flag for investigating potential insider information."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:27"}) SET n = {id: "insider:27", name: "Information Leakage Score Interpretation", type: "value_illustration", description: "Provides context for the information leakage score, indicating potential trading on non-public information.", definition: "`infoleaksc`: A score typically from 0-100. Low scores (<20) suggest little evidence of trading activity ahead of significant news or events. Moderate scores (20-50) warrant attention and may correlate with known events. High scores (>50) strongly suggest potential trading based on material non-public information, requiring investigation.", source_file: "insider_kb.jsonl", source_line: 28, source_id: 27, search_text: "Information Leakage Score Interpretation value_illustration Provides context for the information leakage score, indicating potential trading on non-public information. `infoleaksc`: A score typically from 0-100. Low scores (<20) suggest little evidence of trading activity ahead of significant news or events. Moderate scores (20-50) warrant attention and may correlate with known events. High scores (>50) strongly suggest potential trading based on material non-public information, requiring investigation."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:28"}) SET n = {id: "insider:28", name: "Pattern Similarity Score Context", type: "value_illustration", description: "Provides context for the pattern similarity score, comparing trading to known illicit behaviors.", definition: "`patsim`: A score typically ranging from 0 to 1. Values close to 1 indicate a high similarity to known illicit trading patterns cataloged by the surveillance system (e.g., layering, spoofing, wash trading). Values close to 0 indicate the observed trading patterns do not strongly match known manipulative techniques.", source_file: "insider_kb.jsonl", source_line: 29, source_id: 28, search_text: "Pattern Similarity Score Context value_illustration Provides context for the pattern similarity score, comparing trading to known illicit behaviors. `patsim`: A score typically ranging from 0 to 1. Values close to 1 indicate a high similarity to known illicit trading patterns cataloged by the surveillance system (e.g., layering, spoofing, wash trading). Values close to 0 indicate the observed trading patterns do not strongly match known manipulative techniques."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:29"}) SET n = {id: "insider:29", name: "Trading Restriction Period Types", type: "value_illustration", description: "Explains the types of trading restrictions imposed as part of enforcement.", definition: "`traderestr`: 'Blackout' typically refers to a complete prohibition on trading specific securities or during certain periods (e.g., around earnings announcements). 'Special' indicates other, specific restrictions tailored to the case, which might include limits on order types, position sizes, or requiring pre-trade approvals.", source_file: "insider_kb.jsonl", source_line: 30, source_id: 29, search_text: "Trading Restriction Period Types value_illustration Explains the types of trading restrictions imposed as part of enforcement. `traderestr`: 'Blackout' typically refers to a complete prohibition on trading specific securities or during certain periods (e.g., around earnings announcements). 'Special' indicates other, specific restrictions tailored to the case, which might include limits on order types, position sizes, or requiring pre-trade approvals."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:30"}) SET n = {id: "insider:30", name: "Risk-Adjusted Turnover (RAT)", type: "calculation_knowledge", description: "Calculates trader turnover scaled by their leverage exposure.", definition: "RAT = \\text{DTR} \\times \\text{TLE} \\\\ \\text{where DTR is Daily Turnover Rate  and TLE is Trader Leverage Exposure .}", source_file: "insider_kb.jsonl", source_line: 31, source_id: 30, search_text: "Risk-Adjusted Turnover (RAT) calculation_knowledge Calculates trader turnover scaled by their leverage exposure. RAT = \\text{DTR} \\times \\text{TLE} \\\\ \\text{where DTR is Daily Turnover Rate  and TLE is Trader Leverage Exposure .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:31"}) SET n = {id: "insider:31", name: "Combined Manipulation Indicator (CMI)", type: "calculation_knowledge", description: "A combined score reflecting both general suspicious activity and specific pattern anomalies.", definition: "CMI = (\\text{SAI} + \\text{PAS}) / 2 \\\\ \\text{where SAI is Suspicious Activity Index  and PAS is Pattern Anomaly Score .}", source_file: "insider_kb.jsonl", source_line: 32, source_id: 31, search_text: "Combined Manipulation Indicator (CMI) calculation_knowledge A combined score reflecting both general suspicious activity and specific pattern anomalies. CMI = (\\text{SAI} + \\text{PAS}) / 2 \\\\ \\text{where SAI is Suspicious Activity Index  and PAS is Pattern Anomaly Score .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:32"}) SET n = {id: "insider:32", name: "Compliance Health Score (CHS)", type: "calculation_knowledge", description: "Inverse score reflecting compliance history severity, penalizing high recidivism and poor ratings.", definition: "CHS = \\frac{1}{1 + \\text{CRS} \\times \\text{ComplianceRatingValue}}", source_file: "insider_kb.jsonl", source_line: 33, source_id: 32, search_text: "Compliance Health Score (CHS) calculation_knowledge Inverse score reflecting compliance history severity, penalizing high recidivism and poor ratings. CHS = \\frac{1}{1 + \\text{CRS} \\times \\text{ComplianceRatingValue}}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:33"}) SET n = {id: "insider:33", name: "Weighted Investigation Score (WIS)", type: "calculation_knowledge", description: "Combines raw investigation scores with the current alert severity level.", definition: "WIS = \\text{III} \\times \\text{AlertLevelMultiplier} \\\\ \\text{where III is Investigation Intensity Index } \\\\ \\text{and AlertLevelMultiplier maps Alert Level Severity  to numeric: 'Low'=1, 'Medium'=2, 'High'=3, 'Critical'=4.}", source_file: "insider_kb.jsonl", source_line: 34, source_id: 33, search_text: "Weighted Investigation Score (WIS) calculation_knowledge Combines raw investigation scores with the current alert severity level. WIS = \\text{III} \\times \\text{AlertLevelMultiplier} \\\\ \\text{where III is Investigation Intensity Index } \\\\ \\text{and AlertLevelMultiplier maps Alert Level Severity  to numeric: 'Low'=1, 'Medium'=2, 'High'=3, 'Critical'=4.}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:34"}) SET n = {id: "insider:34", name: "Sentiment-Weighted Option Volume (SWOV)", type: "calculation_knowledge", description: "Adjusts the option volume ratio based on the divergence between news and social sentiment.", definition: "SWOV = \\text{optvolrt} \\times (1 + \\text{SDF}) \\\\ \\text{where SDF is the Sentiment Divergence Factor .}", source_file: "insider_kb.jsonl", source_line: 35, source_id: 34, search_text: "Sentiment-Weighted Option Volume (SWOV) calculation_knowledge Adjusts the option volume ratio based on the divergence between news and social sentiment. SWOV = \\text{optvolrt} \\times (1 + \\text{SDF}) \\\\ \\text{where SDF is the Sentiment Divergence Factor .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:35"}) SET n = {id: "insider:35", name: "Logarithmic Enforcement Fine Impact (LEFI)", type: "calculation_knowledge", description: "Calculates the log-scaled financial impact ratio of enforcement fines, emphasizing order of magnitude.", definition: "LEFI = \\text{EFIR} \\times \\log_{10}(\\text{Max}(10, \\text{penamt})) \\\\ \\text{where EFIR is the Enforcement Financial Impact Ratio .}", source_file: "insider_kb.jsonl", source_line: 36, source_id: 35, search_text: "Logarithmic Enforcement Fine Impact (LEFI) calculation_knowledge Calculates the log-scaled financial impact ratio of enforcement fines, emphasizing order of magnitude. LEFI = \\text{EFIR} \\times \\log_{10}(\\text{Max}(10, \\text{penamt})) \\\\ \\text{where EFIR is the Enforcement Financial Impact Ratio .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:36"}) SET n = {id: "insider:36", name: "Aggressive Trading Intensity (ATI)", type: "calculation_knowledge", description: "Measures intensity by combining high turnover, leverage, and order modification frequency.", definition: "ATI = \\text{DTR} \\times \\text{TLE} \\times \\text{OMI}.", source_file: "insider_kb.jsonl", source_line: 37, source_id: 36, search_text: "Aggressive Trading Intensity (ATI) calculation_knowledge Measures intensity by combining high turnover, leverage, and order modification frequency. ATI = \\text{DTR} \\times \\text{TLE} \\times \\text{OMI}."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:37"}) SET n = {id: "insider:37", name: "Suspicion-Weighted Turnover (SWT)", type: "calculation_knowledge", description: "Calculates daily turnover weighted by the Suspicious Activity Index.", definition: "SWT = \\text{SAI} \\times \\text{DTR} \\\\ \\text{where SAI is Suspicious Activity Index  and DTR is Daily Turnover Rate .}", source_file: "insider_kb.jsonl", source_line: 38, source_id: 37, search_text: "Suspicion-Weighted Turnover (SWT) calculation_knowledge Calculates daily turnover weighted by the Suspicious Activity Index. SWT = \\text{SAI} \\times \\text{DTR} \\\\ \\text{where SAI is Suspicious Activity Index  and DTR is Daily Turnover Rate .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:38"}) SET n = {id: "insider:38", name: "Boosted Insider Leakage Score (BILS)", type: "calculation_knowledge", description: "Increases the Information Leakage Score if a Potential Insider Trading Flag is also present.", definition: "BILS = \\text{InfoLeakageScoreValue} \\times (1.5 \\text{ if Potential Insider Trading Flag  is True else } 1.0) \\\\ \\text{where InfoLeakageScoreValue is from Information Leakage Score Interpretation .}", source_file: "insider_kb.jsonl", source_line: 39, source_id: 38, search_text: "Boosted Insider Leakage Score (BILS) calculation_knowledge Increases the Information Leakage Score if a Potential Insider Trading Flag is also present. BILS = \\text{InfoLeakageScoreValue} \\times (1.5 \\text{ if Potential Insider Trading Flag  is True else } 1.0) \\\\ \\text{where InfoLeakageScoreValue is from Information Leakage Score Interpretation .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:39"}) SET n = {id: "insider:39", name: "Market-Adjusted Pattern Anomaly (MAPA)", type: "calculation_knowledge", description: "Calculates pattern anomaly score adjusted for market correlation, highlighting non-market related deviations.", definition: "MAPA = \\text{PAS} \\times (1 - \\text{mktcorr}) \\\\ \\text{where PAS is Pattern Anomaly Score .}", source_file: "insider_kb.jsonl", source_line: 40, source_id: 39, search_text: "Market-Adjusted Pattern Anomaly (MAPA) calculation_knowledge Calculates pattern anomaly score adjusted for market correlation, highlighting non-market related deviations. MAPA = \\text{PAS} \\times (1 - \\text{mktcorr}) \\\\ \\text{where PAS is Pattern Anomaly Score .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:40"}) SET n = {id: "insider:40", name: "High-Frequency High-Risk Trader", type: "domain_knowledge", description: "Identifies traders classified as High-Risk who also operate at high frequency.", definition: "A trader matching the High-Risk Trader Profile  AND whose freqscope is 'High'.", source_file: "insider_kb.jsonl", source_line: 41, source_id: 40, search_text: "High-Frequency High-Risk Trader domain_knowledge Identifies traders classified as High-Risk who also operate at high frequency. A trader matching the High-Risk Trader Profile  AND whose freqscope is 'High'."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:41"}) SET n = {id: "insider:41", name: "Suspected Event-Driven Insider", type: "domain_knowledge", description: "Flags traders identified as event-driven who also trigger potential insider trading alerts.", definition: "A trader who meets the criteria for Event-Driven Trader  AND for whom the Potential Insider Trading Flag  is True.", source_file: "insider_kb.jsonl", source_line: 42, source_id: 41, search_text: "Suspected Event-Driven Insider domain_knowledge Flags traders identified as event-driven who also trigger potential insider trading alerts. A trader who meets the criteria for Event-Driven Trader  AND for whom the Potential Insider Trading Flag  is True."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:42"}) SET n = {id: "insider:42", name: "Confirmed Manipulator Under Scrutiny", type: "domain_knowledge", description: "Identifies traders with confirmed manipulative patterns whose cases are under high scrutiny.", definition: "A trader exhibiting a confirmed Market Manipulation Pattern: Layering/Spoofing  AND whose case status is Elevated Regulatory Scrutiny .", source_file: "insider_kb.jsonl", source_line: 43, source_id: 42, search_text: "Confirmed Manipulator Under Scrutiny domain_knowledge Identifies traders with confirmed manipulative patterns whose cases are under high scrutiny. A trader exhibiting a confirmed Market Manipulation Pattern: Layering/Spoofing  AND whose case status is Elevated Regulatory Scrutiny ."};

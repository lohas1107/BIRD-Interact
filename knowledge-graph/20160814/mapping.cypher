CREATE (n:Column {database_name: "virtual", table_name: "interactions", column_name: "engagement_metrics", ordinal: 14, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "virtual:interactions:engagement_metrics", raw_text: "{\"column_meaning\": \"JSONB column. Captures metrics related to fan engagement during interactions, such as session duration, live attendance, watch hours, and chat activity.\", \"fields_meaning\": {\"chat_activity\": {\"chatlang\": \"An enum (ChatLang_enum) describing chat language usage (Mixed, Translation, English, Native).\", \"chatmsg\": \"An INT tally of messages sent in chat (e.g., 30).\", \"emojicount\": \"An INT number of emoji used by the fan (e.g., 10).\", \"msgtone\": \"An enum (MessageSentiment_enum) indicating the sentiment (Negative, Positive, Neutral).\", \"stkcount\": \"An INT number of stickers used (e.g., 2).\"}, \"session\": {\"liveatt\": \"A SMALLINT counting how many live stream attendances happened in this session.\", \"sessdurmin\": \"A SMALLINT measuring session duration in minutes (e.g., 45).\", \"watchhrs\": \"A DECIMAL(6,1) specifying how many hours of content the fan watched (e.g., 2.5).\"}}}", description: "JSONB column. Captures metrics related to fan engagement during interactions, such as session duration, live attendance, watch hours, and chat activity.", declared_type: "JSONB", examples: ["45", "2.5", "30", "10", "2"]});

MERGE (n:Knowledge:SemanticSearch {id: "cross_db:48"}) SET n = {id: "cross_db:48", name: "Incident Resolution Efficiency (IRE)", type: "calculation_knowledge", description: "Measures how efficiently incidents are resolved relative to SLA compliance.", definition: "IRE = \\text{SLApct} / (\\text{AvgResolHrs} + 1), \\text{where SLApct and AvgResolHrs are from RiskManagement, adding 1 to avoid division by zero.}", source_file: "cross_db_kb.jsonl", source_line: 49, source_id: 48, search_text: "Incident Resolution Efficiency (IRE) calculation_knowledge Measures how efficiently incidents are resolved relative to SLA compliance. IRE = \\text{SLApct} / (\\text{AvgResolHrs} + 1), \\text{where SLApct and AvgResolHrs are from RiskManagement, adding 1 to avoid division by zero.}"};

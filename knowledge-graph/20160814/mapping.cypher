CREATE (n:Column {database_name: "cybermarket", table_name: "securitymonitoring", column_name: "threat_analysis_metrics", ordinal: 18, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "cybermarket:securitymonitoring:threat_analysis_metrics", raw_text: "{\"column_meaning\": \"JSONB column. A collection of scores related to threat intelligence integration, detection capabilities, anonymity assessment, and analytical pattern matching from security monitoring.\", \"fields_meaning\": {\"anomaly_detection_score\": \"A NUMERIC(5,3) anomaly detection rating (e.g., 423.101).\", \"anonymity_level\": \"An enum (AnonLevel_enum) describing anonymity (Low, Medium, High).\", \"behavioral_analysis_score\": \"A NUMERIC(5,2) rating behavior-based threat detection (e.g., 88.25).\", \"detection_evasion_score\": \"A NUMERIC(5,2) for how well the system evades detection (e.g., 60.15).\", \"event_correlation_strength\": \"A NUMERIC(5,3) measuring cross-event correlation (e.g., 123.456).\", \"ml_confidence_score\": \"A NUMERIC(5,3) ML detection confidence (0–999.999) (e.g., 567.842).\", \"pattern_matching_score\": \"A NUMERIC(4,2) (0–99.99) for pattern-matching adequacy (e.g., 75.30).\", \"threat_intelligence_score\": \"A NUMERIC(5,2) measuring usage of threat intel (e.g., 85.20).\", \"traceability_score\": \"A NUMERIC(5,3) (0–999.999) rating how traceable user actions are (e.g., 245.671).\"}}", description: "JSONB column. A collection of scores related to threat intelligence integration, detection capabilities, anonymity assessment, and analytical pattern matching from security monitoring.", declared_type: "JSONB", examples: ["85.20", "60.15", "245.671", "123.456", "75.30", "88.25", "567.842", "423.101"]});

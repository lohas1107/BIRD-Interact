CREATE (n:Table {database_name: "alien", table_name: "signalprobabilities", description: "", entity_key: "alien:signalprobabilities"});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "signalref", ordinal: 1, data_type: "character", nullable: false, is_primary_key: true, entity_key: "alien:signalprobabilities:signalref", raw_text: "Full name: 'Signal Registry Reference'. Explanation: Primary key referencing the main signal record. Data type: CHAR(36). Example: 'SIG-XYZ-9876'.", description: "Primary key referencing the main signal record.", declared_type: "CHAR(36)", examples: ["SIG-XYZ-9876"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "falseposprob", ordinal: 2, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:falseposprob", raw_text: "Full name: 'False Positive Probability'. Explanation: Probability that the signal is falsely detected. Data type: DECIMAL(5,4). Example: '0.0135'.", description: "Probability that the signal is falsely detected.", declared_type: "DECIMAL(5,4)", examples: ["0.0135"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "sigunique", ordinal: 3, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:sigunique", raw_text: "Full name: 'Signal Uniqueness'. Explanation: A measure of how unique the signal is compared to others. Data type: DECIMAL(7,4). Example: '99.1234'.", description: "A measure of how unique the signal is compared to others.", declared_type: "DECIMAL(7,4)", examples: ["99.1234"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "simindex", ordinal: 4, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:simindex", raw_text: "Full name: 'Similarity Index'. Explanation: Compares the signal to known references. Data type: NUMERIC(5,4). Example: '0.8222'.", description: "Compares the signal to known references.", declared_type: "NUMERIC(5,4)", examples: ["0.8222"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "corrscore", ordinal: 5, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:corrscore", raw_text: "Full name: 'Correlation Score'. Explanation: How well the signal aligns with expected patterns. Data type: DECIMAL(5,4). Example: '0.9950'.", description: "How well the signal aligns with expected patterns.", declared_type: "DECIMAL(5,4)", examples: ["0.9950"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "anomscore", ordinal: 6, data_type: "double precision", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:anomscore", raw_text: "Full name: 'Anomaly Score'. Explanation: How unusual or unexpected the signal is. Data type: FLOAT. Example: '1.23'.", description: "How unusual or unexpected the signal is.", declared_type: "FLOAT", examples: ["1.23"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "techsigprob", ordinal: 7, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:techsigprob", raw_text: "Full name: 'Technosignature Probability'. Explanation: Probability that the signal is of artificial technological origin. Data type: DECIMAL(5,4). Example: '0.6789'.", description: "Probability that the signal is of artificial technological origin.", declared_type: "DECIMAL(5,4)", examples: ["0.6789"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "biosigprob", ordinal: 8, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:biosigprob", raw_text: "Full name: 'Biosignature Probability'. Explanation: Probability that the signal indicates a biological origin. Data type: DECIMAL(6,2). Example: '45.21'.", description: "Probability that the signal indicates a biological origin.", declared_type: "DECIMAL(6,2)", examples: ["45.21"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "natsrcprob", ordinal: 9, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:natsrcprob", raw_text: "Full name: 'Natural Source Probability'. Explanation: Probability the signal is from a natural source. Data type: NUMERIC(7,3). Example: '98.761'.", description: "Probability the signal is from a natural source.", declared_type: "NUMERIC(7,3)", examples: ["98.761"]});
CREATE (n:Column {database_name: "alien", table_name: "signalprobabilities", column_name: "artsrcprob", ordinal: 10, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signalprobabilities:artsrcprob", raw_text: "Full name: 'Artificial Source Probability'. Explanation: Probability the signal is from an artificial source. Data type: NUMERIC(3,1). Example: '3.4'.", description: "Probability the signal is from an artificial source.", declared_type: "NUMERIC(3,1)", examples: ["3.4"]});

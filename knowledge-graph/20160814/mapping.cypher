MERGE (n:Knowledge:SemanticSearch {id: "insider:46"}) SET n = {id: "insider:46", name: "Aggressive Event Speculator", type: "domain_knowledge", description: "Classifies event-driven traders who employ an aggressive risk strategy.", definition: "A trader classified as an Event-Driven Trader  AND whose Trader Risk Appetite  is 'Aggressive'.", source_file: "insider_kb.jsonl", source_line: 47, source_id: 46, search_text: "Aggressive Event Speculator domain_knowledge Classifies event-driven traders who employ an aggressive risk strategy. A trader classified as an Event-Driven Trader  AND whose Trader Risk Appetite  is 'Aggressive'."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:47"}) SET n = {id: "insider:47", name: "Potentially Evasive Order Modifier", type: "domain_knowledge", description: "Flags high cancellation/modification traders who make significant use of dark pools.", definition: "A trader identified as a High Cancellation/Modification Trader  AND whose transaction records show Dark Pool Usage  in more than 50% of instances.", source_file: "insider_kb.jsonl", source_line: 48, source_id: 47, search_text: "Potentially Evasive Order Modifier domain_knowledge Flags high cancellation/modification traders who make significant use of dark pools. A trader identified as a High Cancellation/Modification Trader  AND whose transaction records show Dark Pool Usage  in more than 50% of instances."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:48"}) SET n = {id: "insider:48", name: "Financially Impactful Enforcement Case", type: "domain_knowledge", description: "Identifies traders who faced significant enforcement actions with a high financial impact relative to their account size.", definition: "A trader subject to a Significant Enforcement Action  AND whose Enforcement Financial Impact Ratio (EFIR)  is greater than 0.1.", source_file: "insider_kb.jsonl", source_line: 49, source_id: 48, search_text: "Financially Impactful Enforcement Case domain_knowledge Identifies traders who faced significant enforcement actions with a high financial impact relative to their account size. A trader subject to a Significant Enforcement Action  AND whose Enforcement Financial Impact Ratio (EFIR)  is greater than 0.1."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:49"}) SET n = {id: "insider:49", name: "Peer Mimicry Suspicion", type: "domain_knowledge", description: "Flags traders whose behavior closely matches peers but deviates little from known patterns, potentially mimicking a risky group.", definition: "A trader with a low Pattern Anomaly Score (PAS)  (e.g., < 0.1) BUT a high peercorr (e.g., > 0.7), suggesting potential mimicry rather than independent strategy, possibly following a group engaged in problematic behavior.", source_file: "insider_kb.jsonl", source_line: 50, source_id: 49, search_text: "Peer Mimicry Suspicion domain_knowledge Flags traders whose behavior closely matches peers but deviates little from known patterns, potentially mimicking a risky group. A trader with a low Pattern Anomaly Score (PAS)  (e.g., < 0.1) BUT a high peercorr (e.g., > 0.7), suggesting potential mimicry rather than independent strategy, possibly following a group engaged in problematic behavior."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:50"}) SET n = {id: "insider:50", name: "Investigation Compliance Risk Index (ICRI)", type: "calculation_knowledge", description: "Combines the weighted investigation score with the inverse compliance health score, highlighting cases that are both problematic and under intense investigation.", definition: "ICRI = \\text{WIS} \\times (1 - \\text{CHS}) \\\\ \\text{where WIS is Weighted Investigation Score  and CHS is Compliance Health Score .}", source_file: "insider_kb.jsonl", source_line: 51, source_id: 50, search_text: "Investigation Compliance Risk Index (ICRI) calculation_knowledge Combines the weighted investigation score with the inverse compliance health score, highlighting cases that are both problematic and under intense investigation. ICRI = \\text{WIS} \\times (1 - \\text{CHS}) \\\\ \\text{where WIS is Weighted Investigation Score  and CHS is Compliance Health Score .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:51"}) SET n = {id: "insider:51", name: "Sentiment-Driven Leakage Risk (SDLR)", type: "calculation_knowledge", description: "Calculates potential information leakage risk weighted by sentiment-driven unusual option volume.", definition: "SDLR = \\text{SWOV} \\times \\text{infoleaksc}.", source_file: "insider_kb.jsonl", source_line: 52, source_id: 51, search_text: "Sentiment-Driven Leakage Risk (SDLR) calculation_knowledge Calculates potential information leakage risk weighted by sentiment-driven unusual option volume. SDLR = \\text{SWOV} \\times \\text{infoleaksc}."};
MERGE (n:Knowledge:SemanticSearch {id: "insider:52"}) SET n = {id: "insider:52", name: "Unique Pattern Deviation Ratio (UPDR)", type: "calculation_knowledge", description: "Measures the ratio of unique pattern deviation (anomaly) to the similarity with known illicit patterns, indicating how unusual the potentially illicit behavior is.", definition: "UPDR = \\frac{\\text{PAS}}{\\text{Max}(0.01, \\text{patsim})}", source_file: "insider_kb.jsonl", source_line: 53, source_id: 52, search_text: "Unique Pattern Deviation Ratio (UPDR) calculation_knowledge Measures the ratio of unique pattern deviation (anomaly) to the similarity with known illicit patterns, indicating how unusual the potentially illicit behavior is. UPDR = \\frac{\\text{PAS}}{\\text{Max}(0.01, \\text{patsim})}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:53"}) SET n = {id: "insider:53", name: "Recidivism Enforcement Severity (RES)", type: "calculation_knowledge", description: "Multiplies the compliance recidivism score by the enforcement financial impact, highlighting costly repeat offenders.", definition: "RES = \\text{CRS} \\times \\text{EFIR} \\\\ \\text{where CRS is Compliance Recidivism Score  and EFIR is Enforcement Financial Impact Ratio .}", source_file: "insider_kb.jsonl", source_line: 54, source_id: 53, search_text: "Recidivism Enforcement Severity (RES) calculation_knowledge Multiplies the compliance recidivism score by the enforcement financial impact, highlighting costly repeat offenders. RES = \\text{CRS} \\times \\text{EFIR} \\\\ \\text{where CRS is Compliance Recidivism Score  and EFIR is Enforcement Financial Impact Ratio .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:54"}) SET n = {id: "insider:54", name: "Aggressive Suspicion Score (ASS)", type: "calculation_knowledge", description: "Combines overall suspicious activity index with aggressive trading intensity, identifying traders who are both suspicious and trade aggressively.", definition: "ASS = \\text{SAI} \\times \\text{ATI}", source_file: "insider_kb.jsonl", source_line: 55, source_id: 54, search_text: "Aggressive Suspicion Score (ASS) calculation_knowledge Combines overall suspicious activity index with aggressive trading intensity, identifying traders who are both suspicious and trade aggressively. ASS = \\text{SAI} \\times \\text{ATI}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:55"}) SET n = {id: "insider:55", name: "Capital-Adjusted Investigation Intensity (CAII)", type: "calculation_knowledge", description: "Normalizes the investigation intensity index by the trader's account balance, showing investigation focus relative to trader size.", definition: "CAII = \\frac{\\text{III}}{\\text{Max}(1000, \\text{acctbal})} \\\\ \\text{where III is Investigation Intensity Index .}", source_file: "insider_kb.jsonl", source_line: 56, source_id: 55, search_text: "Capital-Adjusted Investigation Intensity (CAII) calculation_knowledge Normalizes the investigation intensity index by the trader's account balance, showing investigation focus relative to trader size. CAII = \\frac{\\text{III}}{\\text{Max}(1000, \\text{acctbal})} \\\\ \\text{where III is Investigation Intensity Index .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:56"}) SET n = {id: "insider:56", name: "Market-Agnostic Suspicion Index (MASI)", type: "calculation_knowledge", description: "Combines the general suspicion index with market-adjusted pattern anomaly, focusing on suspicious activity independent of market moves.", definition: "MASI = (\\text{SAI} + \\text{MAPA}) / 2 \\\\ \\text{where SAI is Suspicious Activity Index  and MAPA is Market-Adjusted Pattern Anomaly .}", source_file: "insider_kb.jsonl", source_line: 57, source_id: 56, search_text: "Market-Agnostic Suspicion Index (MASI) calculation_knowledge Combines the general suspicion index with market-adjusted pattern anomaly, focusing on suspicious activity independent of market moves. MASI = (\\text{SAI} + \\text{MAPA}) / 2 \\\\ \\text{where SAI is Suspicious Activity Index  and MAPA is Market-Adjusted Pattern Anomaly .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:57"}) SET n = {id: "insider:57", name: "Cross-Modification Ratio (CMR)", type: "calculation_knowledge", description: "Calculates the ratio of cross-trade frequency to order modification intensity, potentially indicating coordinated or manipulative crossing activity.", definition: "CMR = \\frac{\\text{crossfreq}}{\\text{Max}(0.01, \\text{OMI})} \\\\ \\text{where OMI is Order Modification Intensity .}", source_file: "insider_kb.jsonl", source_line: 58, source_id: 57, search_text: "Cross-Modification Ratio (CMR) calculation_knowledge Calculates the ratio of cross-trade frequency to order modification intensity, potentially indicating coordinated or manipulative crossing activity. CMR = \\frac{\\text{crossfreq}}{\\text{Max}(0.01, \\text{OMI})} \\\\ \\text{where OMI is Order Modification Intensity .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:58"}) SET n = {id: "insider:58", name: "Insider Sentiment Short Ratio (ISSR)", type: "calculation_knowledge", description: "Combines boosted insider leakage score with relative short interest, identifying potential insider trading concurrent with high relative short interest.", definition: "ISSR = \\text{BILS} \\times \\text{RSI} \\\\ \\text{where BILS is Boosted Insider Leakage Score  and RSI is Relative Short Interest .}", source_file: "insider_kb.jsonl", source_line: 59, source_id: 58, search_text: "Insider Sentiment Short Ratio (ISSR) calculation_knowledge Combines boosted insider leakage score with relative short interest, identifying potential insider trading concurrent with high relative short interest. ISSR = \\text{BILS} \\times \\text{RSI} \\\\ \\text{where BILS is Boosted Insider Leakage Score  and RSI is Relative Short Interest .}"};
MERGE (n:Knowledge:SemanticSearch {id: "insider:59"}) SET n = {id: "insider:59", name: "Risk-Adjusted Win Rate (RAWR)", type: "calculation_knowledge", description: "Calculates the trader's historical win percentage adjusted for their leverage exposure.", definition: "RAWR = \\frac{\\text{trading_performance.winpct}}{\\text{Max}(1, \\text{TLE})}", source_file: "insider_kb.jsonl", source_line: 60, source_id: 59, search_text: "Risk-Adjusted Win Rate (RAWR) calculation_knowledge Calculates the trader's historical win percentage adjusted for their leverage exposure. RAWR = \\frac{\\text{trading_performance.winpct}}{\\text{Max}(1, \\text{TLE})}"};

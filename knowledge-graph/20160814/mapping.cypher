CREATE (n:Column {database_name: "polar", table_name: "powerbattery", column_name: "batterystatus", ordinal: 8, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "polar:powerbattery:batterystatus", raw_text: "{\"column_meaning\": \"JSONB column. Combines metrics describing battery performance, health, and charging status.\", \"fields_meaning\": {\"current_a\": \"A NUMERIC(7,3) specifying the current (in amperes) used during charging.\", \"cycles\": \"A SMALLINT counting the number of charge/discharge cycles for the battery.\", \"health_percent\": \"A NUMERIC(4,1) indicating the battery’s health status in percentage (e.g., 90.0%).\", \"level_percent\": \"A NUMERIC(5,2) representing the current battery level percentage.\", \"temperature_c\": \"A DOUBLE PRECISION value measuring the battery’s temperature in Celsius.\", \"voltage_v\": \"A NUMERIC(5,2) specifying the voltage (in volts) used during charging.\"}}", description: "JSONB column. Combines metrics describing battery performance, health, and charging status.", declared_type: "JSONB", examples: ["90.0%"]});

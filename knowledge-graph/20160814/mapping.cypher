CREATE (n:Column {database_name: "disaster", table_name: "humanresources", column_name: "staffingprofile", ordinal: 4, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "disaster:humanresources:staffingprofile", raw_text: "{\"column_meaning\": \"JSONB column. Consolidates staffing information, including personnel counts by specialty, volunteer resources, and operational readiness metrics.\", \"fields_meaning\": {\"personnel\": {\"logistics\": \"An INTEGER for logistics staff count (e.g., 8).\", \"medical\": \"An INT specifying how many medical personnel (e.g., 10).\", \"security\": \"An INT labeling security staff (e.g., 5).\", \"total\": \"An INTEGER counting total staff members (e.g., 50).\", \"volunteers\": \"An INT enumerating the number of volunteers (e.g., 20).\"}, \"readiness\": {\"availability_percent\": \"A DECIMAL(5,2) for percentage of staff availability (e.g., 85.50).\", \"comm_equipment\": \"An enum (CommEquipment_enum) for communication gear; values: 'Sufficient', 'Insufficient', 'Limited'.\", \"ppe_status\": \"An enum (PPEStatus_enum) indicating PPE availability; values: 'Limited', 'Critical', 'Adequate'.\", \"training_status\": \"An enum (TrainingState_enum) describing training progress; values: 'Complete', 'In Progress', 'Required'.\"}}}", description: "JSONB column. Consolidates staffing information, including personnel counts by specialty, volunteer resources, and operational readiness metrics.", declared_type: "JSONB", examples: ["50", "10", "8", "5", "20", "85.50"]});

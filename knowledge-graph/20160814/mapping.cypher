MERGE (n:Knowledge:SemanticSearch {id: "vaccine:50"}) SET n = {id: "vaccine:50", name: "Thermal Stability Coefficient (TSC)", type: "calculation_knowledge", description: "Advanced temperature stability metric incorporating thermal mass and ambient conditions.", definition: "TSC = \\text{TSS} \\cdot e^{-\\frac{|\\text{TempNowC} - \\text{StoreTempC}|}{5}} \\cdot \\left(1 - \\alpha \\cdot \\frac{\\text{TempNowC} - \\text{TempPrevC}}{\\text{ReadingInterval}}\\right)", source_file: "vaccine_kb.jsonl", source_line: 51, source_id: 50, search_text: "Thermal Stability Coefficient (TSC) calculation_knowledge Advanced temperature stability metric incorporating thermal mass and ambient conditions. TSC = \\text{TSS} \\cdot e^{-\\frac{|\\text{TempNowC} - \\text{StoreTempC}|}{5}} \\cdot \\left(1 - \\alpha \\cdot \\frac{\\text{TempNowC} - \\text{TempPrevC}}{\\text{ReadingInterval}}\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:51"}) SET n = {id: "vaccine:51", name: "Multi-Parameter Risk Assessment (MPRA)", type: "calculation_knowledge", description: "Comprehensive risk evaluation using multiple environmental parameters.", definition: "MPRA = \\sqrt{\\text{CRI}^2 + \\text{TBS}^2 + (1-\\text{HQI})^2} \\times (1 + \\frac{\\text{CDR}}{\\text{CDR}_{\\text{max}}})", source_file: "vaccine_kb.jsonl", source_line: 52, source_id: 51, search_text: "Multi-Parameter Risk Assessment (MPRA) calculation_knowledge Comprehensive risk evaluation using multiple environmental parameters. MPRA = \\sqrt{\\text{CRI}^2 + \\text{TBS}^2 + (1-\\text{HQI})^2} \\times (1 + \\frac{\\text{CDR}}{\\text{CDR}_{\\text{max}}})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:52"}) SET n = {id: "vaccine:52", name: "Time-Weighted Quality Decay (TWQD)", type: "calculation_knowledge", description: "Calculates quality deterioration rate considering time and environmental factors.", definition: "TWQD = -\\frac{d}{dt}(\\text{VVP}) \\times (1 + \\beta\\text{TBS}) \\times (1 + \\gamma(\\text{1-TSS}))", source_file: "vaccine_kb.jsonl", source_line: 53, source_id: 52, search_text: "Time-Weighted Quality Decay (TWQD) calculation_knowledge Calculates quality deterioration rate considering time and environmental factors. TWQD = -\\frac{d}{dt}(\\text{VVP}) \\times (1 + \\beta\\text{TBS}) \\times (1 + \\gamma(\\text{1-TSS}))"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:53"}) SET n = {id: "vaccine:53", name: "Environmental Stress Factor (ESF)", type: "calculation_knowledge", description: "Quantifies combined environmental stressors on vaccine stability.", definition: "ESF = \\text{TSS} \\cdot (1 + \\frac{\\text{TBS}}{5}) \\cdot \\text{CEI} \\cdot (1 + \\frac{|\\text{TempNowC} - \\text{StoreTempC}|}{\\text{TempTolC}})", source_file: "vaccine_kb.jsonl", source_line: 54, source_id: 53, search_text: "Environmental Stress Factor (ESF) calculation_knowledge Quantifies combined environmental stressors on vaccine stability. ESF = \\text{TSS} \\cdot (1 + \\frac{\\text{TBS}}{5}) \\cdot \\text{CEI} \\cdot (1 + \\frac{|\\text{TempNowC} - \\text{StoreTempC}|}{\\text{TempTolC}})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:54"}) SET n = {id: "vaccine:54", name: "Logistics Performance Metric (LPM)", type: "calculation_knowledge", description: "Evaluates overall logistics efficiency with temporal considerations.", definition: "LPM = \\text{RCP} \\cdot \\frac{\\text{HQI}}{\\sqrt{1 + \\text{TRS}}}", source_file: "vaccine_kb.jsonl", source_line: 55, source_id: 54, search_text: "Logistics Performance Metric (LPM) calculation_knowledge Evaluates overall logistics efficiency with temporal considerations. LPM = \\text{RCP} \\cdot \\frac{\\text{HQI}}{\\sqrt{1 + \\text{TRS}}}"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:55"}) SET n = {id: "vaccine:55", name: "Critical Cascade Condition", type: "domain_knowledge", description: "Identifies systemic failure patterns in the cold chain.", definition: "A condition where (MPRA > 0.8 AND TSC < 0.4) OR (TWQD > 0.6 AND ESF > 0.7)", source_file: "vaccine_kb.jsonl", source_line: 56, source_id: 55, search_text: "Critical Cascade Condition domain_knowledge Identifies systemic failure patterns in the cold chain. A condition where (MPRA > 0.8 AND TSC < 0.4) OR (TWQD > 0.6 AND ESF > 0.7)"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:56"}) SET n = {id: "vaccine:56", name: "Compound Quality Risk", type: "domain_knowledge", description: "Identifies complex quality degradation scenarios.", definition: "A status where VSI decreases over three consecutive readings AND LPM < 0.5 AND ESF > 0.6", source_file: "vaccine_kb.jsonl", source_line: 57, source_id: 56, search_text: "Compound Quality Risk domain_knowledge Identifies complex quality degradation scenarios. A status where VSI decreases over three consecutive readings AND LPM < 0.5 AND ESF > 0.6"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:57"}) SET n = {id: "vaccine:57", name: "Dynamic Stability Threshold", type: "domain_knowledge", description: "Evaluates stability under varying conditions.", definition: "A condition where average TSC over last 5 readings < 0.7 AND MPRA > 0.6", source_file: "vaccine_kb.jsonl", source_line: 58, source_id: 57, search_text: "Dynamic Stability Threshold domain_knowledge Evaluates stability under varying conditions. A condition where average TSC over last 5 readings < 0.7 AND MPRA > 0.6"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:58"}) SET n = {id: "vaccine:58", name: "Multi-System Failure Risk", type: "domain_knowledge", description: "Identifies concurrent failures across multiple subsystems.", definition: "A state where (CRI + TBS + (1-HQI))/3 > 0.7 AND all of (TSC, LPM, ESF) < 0.3", source_file: "vaccine_kb.jsonl", source_line: 59, source_id: 58, search_text: "Multi-System Failure Risk domain_knowledge Identifies concurrent failures across multiple subsystems. A state where (CRI + TBS + (1-HQI))/3 > 0.7 AND all of (TSC, LPM, ESF) < 0.3"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:59"}) SET n = {id: "vaccine:59", name: "Predictive Degradation Alert", type: "domain_knowledge", description: "Forecasts potential quality degradation based on current trends.", definition: "Alert when TWQD increases over 3 consecutive readings AND ESF > 0.5 AND TempDevCount > 3", source_file: "vaccine_kb.jsonl", source_line: 60, source_id: 59, search_text: "Predictive Degradation Alert domain_knowledge Forecasts potential quality degradation based on current trends. Alert when TWQD increases over 3 consecutive readings AND ESF > 0.5 AND TempDevCount > 3"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:60"}) SET n = {id: "vaccine:60", name: "ReadingInterval", type: "domain_knowledge", description: "Time denominator used for calculating rate of temperature change", definition: "Time interval in minutes between successive temperature readings, used to normalize temperature differences into rates of change. Standard value is 15 minutes with acceptable range 5-60 minutes depending on monitoring requirements", source_file: "vaccine_kb.jsonl", source_line: 61, source_id: 60, search_text: "ReadingInterval domain_knowledge Time denominator used for calculating rate of temperature change Time interval in minutes between successive temperature readings, used to normalize temperature differences into rates of change. Standard value is 15 minutes with acceptable range 5-60 minutes depending on monitoring requirements"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:61"}) SET n = {id: "vaccine:61", name: "Days Overdue", type: "calculation_knowledge", description: "Calculates the number of days past the scheduled maintenance or calibration date.", definition: "DaysOverdue = \\max\\left( (\\text{Current_Date} - \\text{MaintDateNext}), (\\text{Current_Date} - \\text{CalibDateNext}), 0 \\right)", source_file: "vaccine_kb.jsonl", source_line: 62, source_id: 61, search_text: "Days Overdue calculation_knowledge Calculates the number of days past the scheduled maintenance or calibration date. DaysOverdue = \\max\\left( (\\text{Current_Date} - \\text{MaintDateNext}), (\\text{Current_Date} - \\text{CalibDateNext}), 0 \\right)"};

MERGE (n:Knowledge:SemanticSearch {id: "cross_db:0"}) SET n = {id: "cross_db:0", name: "Data Transfer Efficiency (DTE)", type: "calculation_knowledge", description: "Measures the efficiency of data transfers based on success rate and error count.", definition: "DTE = \\frac{\\text{SuccessPct}}{\\text{ErrTally} + 1}", source_file: "cross_db_kb.jsonl", source_line: 1, source_id: 0, search_text: "Data Transfer Efficiency (DTE) calculation_knowledge Measures the efficiency of data transfers based on success rate and error count. DTE = \\frac{\\text{SuccessPct}}{\\text{ErrTally} + 1}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:1"}) SET n = {id: "cross_db:1", name: "Bandwidth Saturation Index (BSI)", type: "calculation_knowledge", description: "Quantifies how close a data flow is to saturating available bandwidth.", definition: "BSI = \\text{BwidthPct} \\times \\frac{\\text{DataSizeMB}}{\\text{DurMin}}", source_file: "cross_db_kb.jsonl", source_line: 2, source_id: 1, search_text: "Bandwidth Saturation Index (BSI) calculation_knowledge Quantifies how close a data flow is to saturating available bandwidth. BSI = \\text{BwidthPct} \\times \\frac{\\text{DataSizeMB}}{\\text{DurMin}}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:2"}) SET n = {id: "cross_db:2", name: "Risk Exposure Score (RES)", type: "calculation_knowledge", description: "Calculates the overall risk exposure by combining risk assessment and residual risk.", definition: "RES = \\text{RiskAssess} \\times \\text{CtrlEff}^{-1}", source_file: "cross_db_kb.jsonl", source_line: 3, source_id: 2, search_text: "Risk Exposure Score (RES) calculation_knowledge Calculates the overall risk exposure by combining risk assessment and residual risk. RES = \\text{RiskAssess} \\times \\text{CtrlEff}^{-1}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:3"}) SET n = {id: "cross_db:3", name: "Compliance Cost Ratio (CCR)", type: "calculation_knowledge", description: "Evaluates the cost of compliance relative to potential penalties.", definition: "CCR = \\frac{\\text{CostUSD}}{\\text{PenUSD} + 1}", source_file: "cross_db_kb.jsonl", source_line: 4, source_id: 3, search_text: "Compliance Cost Ratio (CCR) calculation_knowledge Evaluates the cost of compliance relative to potential penalties. CCR = \\frac{\\text{CostUSD}}{\\text{PenUSD} + 1}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:4"}) SET n = {id: "cross_db:4", name: "Data Sensitivity Index (DSI)", type: "calculation_knowledge", description: "Quantifies the sensitivity of data based on volume and sensitivity level.", definition: "DSI = \\text{VolGB} \\times \\begin{cases} 3 & \\text{if DataSense = 'High'} \\\\ 2 & \\text{if DataSense = 'Medium'} \\\\ 1 & \\text{if DataSense = 'Low'} \\end{cases}", source_file: "cross_db_kb.jsonl", source_line: 5, source_id: 4, search_text: "Data Sensitivity Index (DSI) calculation_knowledge Quantifies the sensitivity of data based on volume and sensitivity level. DSI = \\text{VolGB} \\times \\begin{cases} 3 & \\text{if DataSense = 'High'} \\\\ 2 & \\text{if DataSense = 'Medium'} \\\\ 1 & \\text{if DataSense = 'Low'} \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:5"}) SET n = {id: "cross_db:5", name: "Security Robustness Score (SRS)", type: "calculation_knowledge", description: "Measures the strength of security controls based on encryption and access controls.", definition: "SRS = \\begin{cases} 3 & \\text{if EncState = 'Full' and AclState = 'Strong'} \\\\ 2 & \\text{if EncState = 'Full' or AclState = 'Adequate'} \\\\ 1 & \\text{otherwise} \\end{cases}", source_file: "cross_db_kb.jsonl", source_line: 6, source_id: 5, search_text: "Security Robustness Score (SRS) calculation_knowledge Measures the strength of security controls based on encryption and access controls. SRS = \\begin{cases} 3 & \\text{if EncState = 'Full' and AclState = 'Strong'} \\\\ 2 & \\text{if EncState = 'Full' or AclState = 'Adequate'} \\\\ 1 & \\text{otherwise} \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:6"}) SET n = {id: "cross_db:6", name: "Vendor Reliability Index (VRI)", type: "calculation_knowledge", description: "Assesses vendor reliability based on security rating and contract status.", definition: "VRI = \\text{VendSecRate value} \\times \\begin{cases} 1 & \\text{if ContrState = 'Active'} \\\\ 0.5 & \\text{otherwise} \\end{cases}", source_file: "cross_db_kb.jsonl", source_line: 7, source_id: 6, search_text: "Vendor Reliability Index (VRI) calculation_knowledge Assesses vendor reliability based on security rating and contract status. VRI = \\text{VendSecRate value} \\times \\begin{cases} 1 & \\text{if ContrState = 'Active'} \\\\ 0.5 & \\text{otherwise} \\end{cases}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:7"}) SET n = {id: "cross_db:7", name: "Audit Finding Severity (AFS)", type: "calculation_knowledge", description: "Quantifies the severity of audit findings based on critical findings.", definition: "AFS = \\frac{\\text{CritFindNum}}{\\text{FindTally} + 1}", source_file: "cross_db_kb.jsonl", source_line: 8, source_id: 7, search_text: "Audit Finding Severity (AFS) calculation_knowledge Quantifies the severity of audit findings based on critical findings. AFS = \\frac{\\text{CritFindNum}}{\\text{FindTally} + 1}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:8"}) SET n = {id: "cross_db:8", name: "Data Subject Request Load (DSRL)", type: "calculation_knowledge", description: "Measures the workload from data subject requests.", definition: "DSRL = \\text{AccReqNum} + \\text{DelReqNum} + \\text{RectReqNum} + \\text{PortReqNum}", source_file: "cross_db_kb.jsonl", source_line: 9, source_id: 8, search_text: "Data Subject Request Load (DSRL) calculation_knowledge Measures the workload from data subject requests. DSRL = \\text{AccReqNum} + \\text{DelReqNum} + \\text{RectReqNum} + \\text{PortReqNum}"};
MERGE (n:Knowledge:SemanticSearch {id: "cross_db:9"}) SET n = {id: "cross_db:9", name: "Cross-Border Risk Factor (CBRF)", type: "calculation_knowledge", description: "Evaluates risk associated with cross-border data transfers.", definition: "CBRF = \\text{RES} \\times \\begin{cases} 2 & \\text{if OrigNation \\neq DestNation} \\\\ 1 & \\text{otherwise} \\end{cases}", source_file: "cross_db_kb.jsonl", source_line: 10, source_id: 9, search_text: "Cross-Border Risk Factor (CBRF) calculation_knowledge Evaluates risk associated with cross-border data transfers. CBRF = \\text{RES} \\times \\begin{cases} 2 & \\text{if OrigNation \\neq DestNation} \\\\ 1 & \\text{otherwise} \\end{cases}"};

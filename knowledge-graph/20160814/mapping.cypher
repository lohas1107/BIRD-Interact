MERGE (n:Column:SemanticSearch {id: "robot:system_controller:controller_metrics"}) SET n = {database_name: "robot", table_name: "system_controller", column_name: "controller_metrics", ordinal: 4, column_type: "jsonb", nullable: true, is_primary_key: false, id: "robot:system_controller:controller_metrics", raw_text: "{\"column_meaning\": \"JSONB column. Aggregates performance and environmental metrics of the system controller, including load, memory usage, thermal levels, and cabinet conditions.\", \"fields_meaning\": {\"cabinet_humidity\": \"NUMERIC(5,2) referencing cabinet humidity level as a percentage.\", \"cabinet_temperature\": \"DECIMAL(6,3) storing the temperature inside the controller cabinet, if applicable.\", \"load_value\": \"NUMERIC(4,2) measuring system or CPU load for the robot’s supervisory controller.\", \"memory_usage\": \"REAL capturing memory usage (in MB or as ratio) of the system controller.\", \"thermal_level\": \"FLOAT(5) approximate float for the controller’s internal temperature or thermal reading.\"}}", description: "JSONB column. Aggregates performance and environmental metrics of the system controller, including load, memory usage, thermal levels, and cabinet conditions.", declared_type: "JSONB", examples: [], search_text: "robot system_controller controller_metrics jsonb {\"column_meaning\": \"JSONB column. Aggregates performance and environmental metrics of the system controller, including load, memory usage, thermal levels, and cabinet conditions.\", \"fields_meaning\": {\"cabinet_humidity\": \"NUMERIC(5,2) referencing cabinet humidity level as a percentage.\", \"cabinet_temperature\": \"DECIMAL(6,3) storing the temperature inside the controller cabinet, if applicable.\", \"load_value\": \"NUMERIC(4,2) measuring system or CPU load for the robot’s supervisory controller.\", \"memory_usage\": \"REAL capturing memory usage (in MB or as ratio) of the system controller.\", \"thermal_level\": \"FLOAT(5) approximate float for the controller’s internal temperature or thermal reading.\"}} JSONB column. Aggregates performance and environmental metrics of the system controller, including load, memory usage, thermal levels, and cabinet conditions. JSONB"};

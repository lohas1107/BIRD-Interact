CREATE (n:Column {database_name: "mental", table_name: "facilities", column_name: "support_and_resources", ordinal: 8, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "mental:facilities:support_and_resources", raw_text: "{\"column_meaning\": \"JSONB column. Stores information about the facility's support services, community resources, emergency contacts, and plan statuses.\", \"fields_meaning\": {\"community_resources\": \"An enum (communityresources_enum) describing local resource availability (Limited, Comprehensive, Adequate).\", \"emergency_contact\": \"A VARCHAR(200) capturing emergency contact info or phone numbers (e.g., 'Hotline: 1-800-xxx').\", \"plans\": {\"crisis_plan_status\": \"An enum (crisisplanstatus_enum) for the crisis plan status (Not Needed, Needs Update, In Place).\", \"safety_plan_status\": \"An enum (safetyplanstatus_enum) for the safety plan status (Needs Update, In Place, Not Needed).\"}, \"support_services\": \"A VARCHAR(200) listing available or recommended support services (e.g., 'Peer support group, vocational rehab').\"}}", description: "JSONB column. Stores information about the facility's support services, community resources, emergency contacts, and plan statuses.", declared_type: "JSONB", examples: ["Peer support group, vocational rehab", "Hotline: 1-800-xxx"]});

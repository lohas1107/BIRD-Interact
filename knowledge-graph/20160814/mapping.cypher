CREATE (n:Column {database_name: "disaster", table_name: "humanresources", column_name: "hrdistref", ordinal: 2, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "disaster:humanresources:hrdistref", raw_text: "A VARCHAR(20) referencing DisasterEvents(DistRegistry), associating staff with an event (e.g., 'DIST0001').", description: "A VARCHAR(20) referencing DisasterEvents(DistRegistry), associating staff with an event (e.g., 'DIST0001').", declared_type: "VARCHAR(20)", examples: ["DIST0001"]});

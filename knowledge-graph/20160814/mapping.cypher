MERGE (n:Knowledge:SemanticSearch {id: "fake:67"}) SET n = {id: "fake:67", name: "Multi-Platform Threat Network", type: "domain_knowledge", description: "Identifies sophisticated cross-platform threats.", definition: "A Cross-Platform Threat where CPCS > 0.8 and all accounts are part of a Synchronized Behavior Cluster", source_file: "fake_kb.jsonl", source_line: 68, source_id: 67, search_text: "Multi-Platform Threat Network domain_knowledge Identifies sophisticated cross-platform threats. A Cross-Platform Threat where CPCS > 0.8 and all accounts are part of a Synchronized Behavior Cluster"};

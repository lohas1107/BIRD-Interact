CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "sourcedecdeg", ordinal: 3, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:sourcedecdeg", raw_text: "Full name: 'Declination (°)'. Explanation: Declination of the source in degrees (-90 to +90). Data type: DECIMAL(7,4). Example: '-20.4567'.", description: "Declination of the source in degrees (-90 to +90).", declared_type: "DECIMAL(7,4)", examples: ["-20.4567"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "sourcedistly", ordinal: 4, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:sourcedistly", raw_text: "Full name: 'Distance (ly)'. Explanation: Approximate distance to the source in light-years. Data type: NUMERIC(10,2). Example: '26000.45'.", description: "Approximate distance to the source in light-years.", declared_type: "NUMERIC(10,2)", examples: ["26000.45"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "gallong", ordinal: 5, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:gallong", raw_text: "Full name: 'Galactic Longitude (°)'. Explanation: Galactic longitude of the source. Data type: DECIMAL(6,2). Example: '12.34'.", description: "Galactic longitude of the source.", declared_type: "DECIMAL(6,2)", examples: ["12.34"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "gallat", ordinal: 6, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:gallat", raw_text: "Full name: 'Galactic Latitude (°)'. Explanation: Galactic latitude of the source. Data type: DECIMAL(6,2). Example: '-5.67'.", description: "Galactic latitude of the source.", declared_type: "DECIMAL(6,2)", examples: ["-5.67"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "celestobj", ordinal: 7, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:celestobj", raw_text: "Full name: 'Celestial Object'. Explanation: Broad classification of the object. Data type: VARCHAR(75). Possible categories: Galaxy, Planet, Star, Unknown.", description: "Broad classification of the object.", declared_type: "VARCHAR(75)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "objtype", ordinal: 8, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:objtype", raw_text: "Full name: 'Object Subtype'. Explanation: More specific object type. Data type: VARCHAR(50). Possible categories: Dwarf, Giant, Main Sequence, Unknown.", description: "More specific object type.", declared_type: "VARCHAR(50)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "objmag", ordinal: 9, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:objmag", raw_text: "Full name: 'Apparent Magnitude'. Explanation: Brightness of the object as seen from Earth. Data type: NUMERIC(5,2). Example: '7.35'.", description: "Brightness of the object as seen from Earth.", declared_type: "NUMERIC(5,2)", examples: ["7.35"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "objtempk", ordinal: 10, data_type: "integer", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:objtempk", raw_text: "Full name: 'Object Temperature (K)'. Explanation: Approximate surface temperature in Kelvin. Data type: INTEGER. Example: '5800'.", description: "Approximate surface temperature in Kelvin.", declared_type: "INTEGER", examples: ["5800"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "objmasssol", ordinal: 11, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:objmasssol", raw_text: "Full name: 'Object Mass (solar)'. Explanation: Mass relative to the Sun. Data type: DECIMAL(6,3). Example: '1.005'.", description: "Mass relative to the Sun.", declared_type: "DECIMAL(6,3)", examples: ["1.005"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "objagegyr", ordinal: 12, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:objagegyr", raw_text: "Full name: 'Object Age (Gyr)'. Explanation: Estimated age in billions of years. Data type: DECIMAL(6,3). Example: '4.500'.", description: "Estimated age in billions of years.", declared_type: "DECIMAL(6,3)", examples: ["4.500"]});
CREATE (n:Column {database_name: "alien", table_name: "sourceproperties", column_name: "objmetal", ordinal: 13, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:sourceproperties:objmetal", raw_text: "Full name: 'Metallicity'. Explanation: Ratio of elements heavier than helium in the object. Data type: NUMERIC(5,3). Example: '0.012'.", description: "Ratio of elements heavier than helium in the object.", declared_type: "NUMERIC(5,3)", examples: ["0.012"]});

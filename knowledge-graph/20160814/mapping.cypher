MERGE (n:Knowledge:SemanticSearch {id: "vaccine:30"}) SET n = {id: "vaccine:30", name: "Total Risk Score (TRS)", type: "calculation_knowledge", description: "Combines container risk and handling quality for overall risk assessment.", definition: "TRS = \\text{CRI} \\times (1 - \\text{HQI}) \\times (1 + \\text{TBS})", source_file: "vaccine_kb.jsonl", source_line: 31, source_id: 30, search_text: "Total Risk Score (TRS) calculation_knowledge Combines container risk and handling quality for overall risk assessment. TRS = \\text{CRI} \\times (1 - \\text{HQI}) \\times (1 + \\text{TBS})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:31"}) SET n = {id: "vaccine:31", name: "Coolant Efficiency Index (CEI)", type: "calculation_knowledge", description: "Measures how efficiently coolant is maintaining temperature stability.", definition: "CEI = \\text{TSS} \\times \\frac{\\text{CoolRemainPct}}{100} \\times (1 - \\frac{\\text{CDR}}{20})", source_file: "vaccine_kb.jsonl", source_line: 32, source_id: 31, search_text: "Coolant Efficiency Index (CEI) calculation_knowledge Measures how efficiently coolant is maintaining temperature stability. CEI = \\text{TSS} \\times \\frac{\\text{CoolRemainPct}}{100} \\times (1 - \\frac{\\text{CDR}}{20})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:32"}) SET n = {id: "vaccine:32", name: "Combined Maintenance Risk (CMR)", type: "calculation_knowledge", description: "Evaluates overall maintenance risk considering compliance and incidents.", definition: "CMR = (1 - \\text{MCS}) \\times (1 + \\frac{\\text{TBS}}{5}) \\times (1 - \\text{LHI})", source_file: "vaccine_kb.jsonl", source_line: 33, source_id: 32, search_text: "Combined Maintenance Risk (CMR) calculation_knowledge Evaluates overall maintenance risk considering compliance and incidents. CMR = (1 - \\text{MCS}) \\times (1 + \\frac{\\text{TBS}}{5}) \\times (1 - \\text{LHI})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:33"}) SET n = {id: "vaccine:33", name: "Shipment Quality Index (SQI)", type: "calculation_knowledge", description: "Overall quality score for shipment considering multiple factors.", definition: "SQI = \\frac{\\text{VVP}}{365} \\times \\text{HQI} \\times (1 - \\text{CRI})", source_file: "vaccine_kb.jsonl", source_line: 34, source_id: 33, search_text: "Shipment Quality Index (SQI) calculation_knowledge Overall quality score for shipment considering multiple factors. SQI = \\frac{\\text{VVP}}{365} \\times \\text{HQI} \\times (1 - \\text{CRI})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:34"}) SET n = {id: "vaccine:34", name: "Logger Reliability Score (LRS)", type: "calculation_knowledge", description: "Comprehensive score for logger reliability.", definition: "LRS = \text{LHI} \\times (1 - \\text{CMR}) \\times \\text{TSS}", source_file: "vaccine_kb.jsonl", source_line: 35, source_id: 34, search_text: "Logger Reliability Score (LRS) calculation_knowledge Comprehensive score for logger reliability. LRS = \text{LHI} \\times (1 - \\text{CMR}) \\times \\text{TSS}"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:35"}) SET n = {id: "vaccine:35", name: "Transport Safety Rating (TSR)", type: "calculation_knowledge", description: "Safety rating for transport considering multiple factors.", definition: "TSR = \\frac{\\text{RCP}}{100} \\times (1 - \\text{TRS}) \\times \\text{HQI}", source_file: "vaccine_kb.jsonl", source_line: 36, source_id: 35, search_text: "Transport Safety Rating (TSR) calculation_knowledge Safety rating for transport considering multiple factors. TSR = \\frac{\\text{RCP}}{100} \\times (1 - \\text{TRS}) \\times \\text{HQI}"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:36"}) SET n = {id: "vaccine:36", name: "Container Efficiency Score (CES)", type: "calculation_knowledge", description: "Overall container efficiency considering multiple metrics.", definition: "CES = \\text{SER} \\times \\text{CEI} \\times (1 - \\text{CRI})", source_file: "vaccine_kb.jsonl", source_line: 37, source_id: 36, search_text: "Container Efficiency Score (CES) calculation_knowledge Overall container efficiency considering multiple metrics. CES = \\text{SER} \\times \\text{CEI} \\times (1 - \\text{CRI})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:37"}) SET n = {id: "vaccine:37", name: "Quality Maintenance Index (QMI)", type: "calculation_knowledge", description: "Combined quality and maintenance metric.", definition: "QMI = \\text{MCS} \\times \\text{SQI} \\times (1 - \\frac{\\text{TBS}}{10})", source_file: "vaccine_kb.jsonl", source_line: 38, source_id: 37, search_text: "Quality Maintenance Index (QMI) calculation_knowledge Combined quality and maintenance metric. QMI = \\text{MCS} \\times \\text{SQI} \\times (1 - \\frac{\\text{TBS}}{10})"};
MERGE (n:Knowledge:SemanticSearch {id: "vaccine:38"}) SET n = {id: "vaccine:38", name: "Route Risk Factor (RRF)", type: "calculation_knowledge", description: "Comprehensive route risk assessment.", definition: "RRF = (1 - \\frac{\text{RCP}}{100}) \\times \\text{TRS} \\times (1 - \\text{CEI})", source_file: "vaccine_kb.jsonl", source_line: 39, source_id: 38, search_text: "Route Risk Factor (RRF) calculation_knowledge Comprehensive route risk assessment. RRF = (1 - \\frac{\text{RCP}}{100}) \\times \\text{TRS} \\times (1 - \\text{CEI})"};

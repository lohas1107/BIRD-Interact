MERGE (n:Knowledge:SemanticSearch {id: "alien:0"}) SET n = {id: "alien:0", name: "Signal-to-Noise Quality Indicator (SNQI)", type: "calculation_knowledge", description: "Combines SNR and noise floor to provide a unified signal quality metric.", definition: "$\\text{SNQI} = \\text{SnrRatio} - 0.1 \\times |\\text{NoiseFloorDbm}|$, where higher values indicate better detection quality. Positive values generally indicate analyzable signals.", source_file: "alien_kb.jsonl", source_line: 1, source_id: 0, search_text: "Signal-to-Noise Quality Indicator (SNQI) calculation_knowledge Combines SNR and noise floor to provide a unified signal quality metric. $\\text{SNQI} = \\text{SnrRatio} - 0.1 \\times |\\text{NoiseFloorDbm}|$, where higher values indicate better detection quality. Positive values generally indicate analyzable signals."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:1"}) SET n = {id: "alien:1", name: "Atmospheric Observability Index (AOI)", type: "calculation_knowledge", description: "Quantifies how conducive atmospheric conditions are for signal detection.", definition: "$\\text{AOI} = \\text{AtmosTransparency} \\times (1 - \\frac{\\text{HumidityRate}}{100}) \\times (1 - 0.02 \\times \\text{WindSpeedMs})$, where values closer to 1 indicate ideal observation conditions.", source_file: "alien_kb.jsonl", source_line: 2, source_id: 1, search_text: "Atmospheric Observability Index (AOI) calculation_knowledge Quantifies how conducive atmospheric conditions are for signal detection. $\\text{AOI} = \\text{AtmosTransparency} \\times (1 - \\frac{\\text{HumidityRate}}{100}) \\times (1 - 0.02 \\times \\text{WindSpeedMs})$, where values closer to 1 indicate ideal observation conditions."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:2"}) SET n = {id: "alien:2", name: "Signal Complexity Ratio (SCR)", type: "calculation_knowledge", description: "Measures the relationship between signal complexity and information density.", definition: "$\\text{SCR} = \\frac{\\text{ComplexIdx} \\times \\text{InfoDense}}{\\log(\\text{BwHz})}$, where higher values suggest potential artificial origin rather than natural phenomena.", source_file: "alien_kb.jsonl", source_line: 3, source_id: 2, search_text: "Signal Complexity Ratio (SCR) calculation_knowledge Measures the relationship between signal complexity and information density. $\\text{SCR} = \\frac{\\text{ComplexIdx} \\times \\text{InfoDense}}{\\log(\\text{BwHz})}$, where higher values suggest potential artificial origin rather than natural phenomena."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:3"}) SET n = {id: "alien:3", name: "Technological Origin Likelihood Score (TOLS)", type: "calculation_knowledge", description: "Combines multiple factors to estimate likelihood of technological origin.", definition: "$\\text{TOLS} = \\text{TechSigProb} \\times (1 - \\text{NatSrcProb}) \\times \\text{SigUnique} \\times (0.5 + \\frac{\\text{AnomScore}}{10})$, where values above 0.75 warrant further investigation as potential technosignatures.", source_file: "alien_kb.jsonl", source_line: 4, source_id: 3, search_text: "Technological Origin Likelihood Score (TOLS) calculation_knowledge Combines multiple factors to estimate likelihood of technological origin. $\\text{TOLS} = \\text{TechSigProb} \\times (1 - \\text{NatSrcProb}) \\times \\text{SigUnique} \\times (0.5 + \\frac{\\text{AnomScore}}{10})$, where values above 0.75 warrant further investigation as potential technosignatures."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:4"}) SET n = {id: "alien:4", name: "Bandwidth-Frequency Ratio (BFR)", type: "calculation_knowledge", description: "Measures the proportion of bandwidth to center frequency, helping identify signal type.", definition: "$\\text{BFR} = \\frac{\\text{BwHz}}{\\text{CenterFreqMhz} \\times 10^6}$, where narrow ratios ($<0.001$) often indicate technological signals while wider ratios suggest natural phenomena.", source_file: "alien_kb.jsonl", source_line: 5, source_id: 4, search_text: "Bandwidth-Frequency Ratio (BFR) calculation_knowledge Measures the proportion of bandwidth to center frequency, helping identify signal type. $\\text{BFR} = \\frac{\\text{BwHz}}{\\text{CenterFreqMhz} \\times 10^6}$, where narrow ratios ($<0.001$) often indicate technological signals while wider ratios suggest natural phenomena."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:5"}) SET n = {id: "alien:5", name: "Detection Instrument Sensitivity Factor (DISF)", type: "calculation_knowledge", description: "Calculates the effective sensitivity of the detection setup based on telescope and environmental factors.", definition: "$\\text{DISF} = (10 - \\frac{|\\text{AirTempC} - 15|}{10}) \\times \\text{AtmosTransparency} \\times (1 - \\frac{\\text{HumidityRate}}{200}) \\times \\frac{100 - \\text{LunarDistDeg}}{100}$, where values closer to 10 indicate optimal detection sensitivity.", source_file: "alien_kb.jsonl", source_line: 6, source_id: 5, search_text: "Detection Instrument Sensitivity Factor (DISF) calculation_knowledge Calculates the effective sensitivity of the detection setup based on telescope and environmental factors. $\\text{DISF} = (10 - \\frac{|\\text{AirTempC} - 15|}{10}) \\times \\text{AtmosTransparency} \\times (1 - \\frac{\\text{HumidityRate}}{200}) \\times \\frac{100 - \\text{LunarDistDeg}}{100}$, where values closer to 10 indicate optimal detection sensitivity."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:6"}) SET n = {id: "alien:6", name: "Encoding Complexity Index (ECI)", type: "calculation_knowledge", description: "Evaluates the sophistication of potential encoding in the signal.", definition: "$\\text{ECI} = \\frac{\\text{CompressRatio} \\times \\text{ComplexIdx} \\times \\text{EntropyVal}}{10}$, where values above 1.5 suggest deliberate information encoding rather than random patterns.", source_file: "alien_kb.jsonl", source_line: 7, source_id: 6, search_text: "Encoding Complexity Index (ECI) calculation_knowledge Evaluates the sophistication of potential encoding in the signal. $\\text{ECI} = \\frac{\\text{CompressRatio} \\times \\text{ComplexIdx} \\times \\text{EntropyVal}}{10}$, where values above 1.5 suggest deliberate information encoding rather than random patterns."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:7"}) SET n = {id: "alien:7", name: "Signal Stability Metric (SSM)", type: "calculation_knowledge", description: "Quantifies overall temporal and spectral stability of a signal.", definition: "$\\text{SSM} = (1 - \\frac{|\\text{FreqDriftHzs}|}{\\text{FreqMhz} \\times 1000}) \\times \\frac{\\text{SigDurSec}}{1 + \\frac{\\text{DoppShiftHz}}{1000}}$, where higher values indicate more stable signals typical of fixed transmitters.", source_file: "alien_kb.jsonl", source_line: 8, source_id: 7, search_text: "Signal Stability Metric (SSM) calculation_knowledge Quantifies overall temporal and spectral stability of a signal. $\\text{SSM} = (1 - \\frac{|\\text{FreqDriftHzs}|}{\\text{FreqMhz} \\times 1000}) \\times \\frac{\\text{SigDurSec}}{1 + \\frac{\\text{DoppShiftHz}}{1000}}$, where higher values indicate more stable signals typical of fixed transmitters."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:8"}) SET n = {id: "alien:8", name: "Research Priority Index (RPI)", type: "calculation_knowledge", description: "Helps researchers prioritize signals for follow-up based on multiple factors.", definition: "$\\text{RPI} = (\\text{TechSigProb} \\times 4 + \\frac{\\text{BioSigProb}}{100} + \\text{SigUnique} \\times 2 + \\frac{\\text{AnomScore}}{2}) \\times (1 - \\text{FalsePosProb})$, where values above 3 indicate high research priority.", source_file: "alien_kb.jsonl", source_line: 9, source_id: 8, search_text: "Research Priority Index (RPI) calculation_knowledge Helps researchers prioritize signals for follow-up based on multiple factors. $\\text{RPI} = (\\text{TechSigProb} \\times 4 + \\frac{\\text{BioSigProb}}{100} + \\text{SigUnique} \\times 2 + \\frac{\\text{AnomScore}}{2}) \\times (1 - \\text{FalsePosProb})$, where values above 3 indicate high research priority."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:9"}) SET n = {id: "alien:9", name: "Lunar Interference Factor (LIF)", type: "calculation_knowledge", description: "Calculates the potential interference from lunar illumination on observations.", definition: "$\\text{LIF} = (1 - \\frac{\\text{LunarDistDeg}}{180}) \\times (1 - \\text{AtmosTransparency})$, where higher values indicate more lunar interference. Values above 0.5 suggest significant lunar contamination in data.", source_file: "alien_kb.jsonl", source_line: 10, source_id: 9, search_text: "Lunar Interference Factor (LIF) calculation_knowledge Calculates the potential interference from lunar illumination on observations. $\\text{LIF} = (1 - \\frac{\\text{LunarDistDeg}}{180}) \\times (1 - \\text{AtmosTransparency})$, where higher values indicate more lunar interference. Values above 0.5 suggest significant lunar contamination in data."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:10"}) SET n = {id: "alien:10", name: "Technosignature", type: "domain_knowledge", description: "Defines the concept of signals that indicate technological activity.", definition: "A signal with $\\text{TechSigProb} > 0.7$, $\\text{NatSrcProb} < 0.3$, and $\\text{ArtSrcProb} < 50$ that exhibits narrow bandwidth ($\\text{BFR} < 0.001$) and high information density ($\\text{InfoDense} > 0.8$).", source_file: "alien_kb.jsonl", source_line: 11, source_id: 10, search_text: "Technosignature domain_knowledge Defines the concept of signals that indicate technological activity. A signal with $\\text{TechSigProb} > 0.7$, $\\text{NatSrcProb} < 0.3$, and $\\text{ArtSrcProb} < 50$ that exhibits narrow bandwidth ($\\text{BFR} < 0.001$) and high information density ($\\text{InfoDense} > 0.8$)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:11"}) SET n = {id: "alien:11", name: "Coherent Information Pattern (CIP)", type: "domain_knowledge", description: "Identifies signals showing patterns consistent with deliberate information transmission.", definition: "Signals characterized by high signal stability ($\\text{SSM} > 0.8$), organized information structure ($\\text{EntropyVal}$ between 0.4-0.8), and consistent modulation ($\\text{ModType}$ with $\\text{ModIndex} > 0.5$).", source_file: "alien_kb.jsonl", source_line: 12, source_id: 11, search_text: "Coherent Information Pattern (CIP) domain_knowledge Identifies signals showing patterns consistent with deliberate information transmission. Signals characterized by high signal stability ($\\text{SSM} > 0.8$), organized information structure ($\\text{EntropyVal}$ between 0.4-0.8), and consistent modulation ($\\text{ModType}$ with $\\text{ModIndex} > 0.5$)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:12"}) SET n = {id: "alien:12", name: "Target of Opportunity (TOO)", type: "domain_knowledge", description: "Identifies high-value signals requiring immediate follow-up observation.", definition: "Any signal with $\\text{RPI} > 3.5$, $\\text{TechSigProb} > 0.8$, and $\\text{AnomScore} > 5$ that has not been previously documented or explained by known phenomena.", source_file: "alien_kb.jsonl", source_line: 13, source_id: 12, search_text: "Target of Opportunity (TOO) domain_knowledge Identifies high-value signals requiring immediate follow-up observation. Any signal with $\\text{RPI} > 3.5$, $\\text{TechSigProb} > 0.8$, and $\\text{AnomScore} > 5$ that has not been previously documented or explained by known phenomena."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:13"}) SET n = {id: "alien:13", name: "Optimal Observing Window (OOW)", type: "domain_knowledge", description: "Defines conditions when observational quality is maximized.", definition: "Time periods when $\\text{AOI} > 0.85$, $\\text{LunarStage}$ is 'New' or 'First Quarter', $\\text{LunarDistDeg} > 45$, and $\\text{SolarStatus}$ is 'Low' or 'Moderate'.", source_file: "alien_kb.jsonl", source_line: 14, source_id: 13, search_text: "Optimal Observing Window (OOW) domain_knowledge Defines conditions when observational quality is maximized. Time periods when $\\text{AOI} > 0.85$, $\\text{LunarStage}$ is 'New' or 'First Quarter', $\\text{LunarDistDeg} > 45$, and $\\text{SolarStatus}$ is 'Low' or 'Moderate'."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:14"}) SET n = {id: "alien:14", name: "Signal Degradation Scenario (SDS)", type: "domain_knowledge", description: "Characterizes situations where signal quality is compromised by environmental factors.", definition: "Observation conditions where one or more of: $\\text{AtmosTransparency} < 0.7$, $\\text{HumidityRate} > 70$, $\\text{WindSpeedMs} > 8$, or $\\text{GeomagStatus}$ contains 'Storm', resulting in compromised data quality.", source_file: "alien_kb.jsonl", source_line: 15, source_id: 14, search_text: "Signal Degradation Scenario (SDS) domain_knowledge Characterizes situations where signal quality is compromised by environmental factors. Observation conditions where one or more of: $\\text{AtmosTransparency} < 0.7$, $\\text{HumidityRate} > 70$, $\\text{WindSpeedMs} > 8$, or $\\text{GeomagStatus}$ contains 'Storm', resulting in compromised data quality."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:15"}) SET n = {id: "alien:15", name: "Narrowband Technological Marker (NTM)", type: "domain_knowledge", description: "Identifies a specific signature associated with technological transmission.", definition: "Signals with extremely narrow bandwidth ($\\text{BFR} < 0.0001$), stable frequency ($\\text{FreqDriftHzs} < 0.1$).", source_file: "alien_kb.jsonl", source_line: 16, source_id: 15, search_text: "Narrowband Technological Marker (NTM) domain_knowledge Identifies a specific signature associated with technological transmission. Signals with extremely narrow bandwidth ($\\text{BFR} < 0.0001$), stable frequency ($\\text{FreqDriftHzs} < 0.1$)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:16"}) SET n = {id: "alien:16", name: "Observational Confidence Level (OCL)", type: "domain_knowledge", description: "Rates the reliability of observations based on conditions and equipment.", definition: "A classification system with three tiers: 'High' ($\\text{AOI} > 0.8$, $\\text{EquipStatus} = \\text{'Operational'}$, $\\text{CalibrStatus} = \\text{'Current'}$), 'Medium' ($\\text{AOI}$ 0.5-0.8, minor equipment issues), and 'Low' ($\\text{AOI} < 0.5$ or significant equipment problems).", source_file: "alien_kb.jsonl", source_line: 17, source_id: 16, search_text: "Observational Confidence Level (OCL) domain_knowledge Rates the reliability of observations based on conditions and equipment. A classification system with three tiers: 'High' ($\\text{AOI} > 0.8$, $\\text{EquipStatus} = \\text{'Operational'}$, $\\text{CalibrStatus} = \\text{'Current'}$), 'Medium' ($\\text{AOI}$ 0.5-0.8, minor equipment issues), and 'Low' ($\\text{AOI} < 0.5$ or significant equipment problems)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:17"}) SET n = {id: "alien:17", name: "Potential Biosignature", type: "domain_knowledge", description: "Defines characteristics of signals potentially associated with biological processes.", definition: "Signals with $\\text{BioSigProb} > 0.6$, $\\text{TechSigProb} < 0.4$, and spectral features that match known biological emission patterns, often associated with specific molecular transitions.", source_file: "alien_kb.jsonl", source_line: 18, source_id: 17, search_text: "Potential Biosignature domain_knowledge Defines characteristics of signals potentially associated with biological processes. Signals with $\\text{BioSigProb} > 0.6$, $\\text{TechSigProb} < 0.4$, and spectral features that match known biological emission patterns, often associated with specific molecular transitions."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:18"}) SET n = {id: "alien:18", name: "Encoded Information Transfer (EIT)", type: "domain_knowledge", description: "Characterizes signals that appear to contain deliberate information encoding.", definition: "Signals with $\\text{ECI} > 1.8$, $\\text{EntropyVal}$ between 0.3-0.7 (not random but structured), and consistent internal patterns that suggest language or data encoding schemes.", source_file: "alien_kb.jsonl", source_line: 19, source_id: 18, search_text: "Encoded Information Transfer (EIT) domain_knowledge Characterizes signals that appear to contain deliberate information encoding. Signals with $\\text{ECI} > 1.8$, $\\text{EntropyVal}$ between 0.3-0.7 (not random but structured), and consistent internal patterns that suggest language or data encoding schemes."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:19"}) SET n = {id: "alien:19", name: "Fast Radio Transient (FRT)", type: "domain_knowledge", description: "Defines a specific class of brief, high-energy radio emissions.", definition: "Signals with extremely short duration ($\\text{SigDurSec} < 0.1$), high signal strength ($\\text{SigStrDb} > 15$), broad bandwidth ($\\text{BwHz} > 1000000$), and no periodicity ($\\text{RepeatCount} = 1$).", source_file: "alien_kb.jsonl", source_line: 20, source_id: 19, search_text: "Fast Radio Transient (FRT) domain_knowledge Defines a specific class of brief, high-energy radio emissions. Signals with extremely short duration ($\\text{SigDurSec} < 0.1$), high signal strength ($\\text{SigStrDb} > 15$), broad bandwidth ($\\text{BwHz} > 1000000$), and no periodicity ($\\text{RepeatCount} = 1$)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:20"}) SET n = {id: "alien:20", name: "WeathProfile: Clear", type: "value_illustration", description: "Illustrates optimal weather conditions for signal detection.", definition: "Indicates pristine sky conditions with no clouds, usually associated with $\\text{AtmosTransparency} > 0.9$, low $\\text{HumidityRate} (< 40\\%)$, and minimal $\\text{WindSpeedMs} (< 3.0)$. Provides ideal visibility for optical observations and minimal atmospheric interference for radio observations.", source_file: "alien_kb.jsonl", source_line: 21, source_id: 20, search_text: "WeathProfile: Clear value_illustration Illustrates optimal weather conditions for signal detection. Indicates pristine sky conditions with no clouds, usually associated with $\\text{AtmosTransparency} > 0.9$, low $\\text{HumidityRate} (< 40\\%)$, and minimal $\\text{WindSpeedMs} (< 3.0)$. Provides ideal visibility for optical observations and minimal atmospheric interference for radio observations."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:21"}) SET n = {id: "alien:21", name: "SeeingProfile: Excellent", type: "value_illustration", description: "Illustrates superior atmospheric seeing conditions.", definition: "Describes atmospheric conditions with minimal turbulence, allowing for sharp, detailed observations. Typically corresponds to image stability better than 1 arcsecond and is often associated with stable temperature gradients and low wind speeds ($\\text{WindSpeedMs} < 2.5$).", source_file: "alien_kb.jsonl", source_line: 22, source_id: 21, search_text: "SeeingProfile: Excellent value_illustration Illustrates superior atmospheric seeing conditions. Describes atmospheric conditions with minimal turbulence, allowing for sharp, detailed observations. Typically corresponds to image stability better than 1 arcsecond and is often associated with stable temperature gradients and low wind speeds ($\\text{WindSpeedMs} < 2.5$)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:22"}) SET n = {id: "alien:22", name: "SignalClass: Narrowband", type: "value_illustration", description: "Illustrates characteristics of narrowband signal detections.", definition: "Describes signals occupying a very narrow portion of the spectrum (typically $\\text{BFR} < 0.0001$). Often associated with technological origins as natural sources rarely produce such spectrally confined emissions. These signals are particularly interesting in SETI research.", source_file: "alien_kb.jsonl", source_line: 23, source_id: 22, search_text: "SignalClass: Narrowband value_illustration Illustrates characteristics of narrowband signal detections. Describes signals occupying a very narrow portion of the spectrum (typically $\\text{BFR} < 0.0001$). Often associated with technological origins as natural sources rarely produce such spectrally confined emissions. These signals are particularly interesting in SETI research."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:23"}) SET n = {id: "alien:23", name: "GeomagStatus: Major Storm", type: "value_illustration", description: "Illustrates severe geomagnetic disturbance conditions.", definition: "Indicates intense solar-induced geomagnetic activity with Kp index ≥ 7. During such conditions, ionospheric perturbations significantly affect radio observations below 100 MHz, aurora may be visible at mid-latitudes, and satellite communications may experience disruptions.", source_file: "alien_kb.jsonl", source_line: 24, source_id: 23, search_text: "GeomagStatus: Major Storm value_illustration Illustrates severe geomagnetic disturbance conditions. Indicates intense solar-induced geomagnetic activity with Kp index ≥ 7. During such conditions, ionospheric perturbations significantly affect radio observations below 100 MHz, aurora may be visible at mid-latitudes, and satellite communications may experience disruptions."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:24"}) SET n = {id: "alien:24", name: "CIP Classification Label", type: "domain_knowledge", description: "Three-tier rating system for evaluating signal coherence against intelligent transmission criteria.", definition: "Classification labels: 'Coherent Information Pattern Detected' ($\\text{SSM} > 0.8$, $\\text{EntropyVal}$ between 0.4-0.8, and $\\text{ModIndex} > 0.5$), 'Potential Information Pattern' ($\\text{SSM} > 0.6$ and $\\text{EntropyVal}$ between 0.3-0.9$), or 'No Clear Pattern' (all other signals).", source_file: "alien_kb.jsonl", source_line: 25, source_id: 24, search_text: "CIP Classification Label domain_knowledge Three-tier rating system for evaluating signal coherence against intelligent transmission criteria. Classification labels: 'Coherent Information Pattern Detected' ($\\text{SSM} > 0.8$, $\\text{EntropyVal}$ between 0.4-0.8, and $\\text{ModIndex} > 0.5$), 'Potential Information Pattern' ($\\text{SSM} > 0.6$ and $\\text{EntropyVal}$ between 0.3-0.9$), or 'No Clear Pattern' (all other signals)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:25"}) SET n = {id: "alien:25", name: "SigClassType: Broadband Transient", type: "value_illustration", description: "Illustrates a class of brief signals covering wide frequency ranges.", definition: "Describes short-duration signals ($\\text{SigDurSec}$ typically $< 5$) that span a large portion of the spectrum ($\\text{BFR} > 0.1$). Examples include solar radio bursts, lightning discharges, and certain types of cosmic explosions like Fast Radio Bursts (FRBs).", source_file: "alien_kb.jsonl", source_line: 26, source_id: 25, search_text: "SigClassType: Broadband Transient value_illustration Illustrates a class of brief signals covering wide frequency ranges. Describes short-duration signals ($\\text{SigDurSec}$ typically $< 5$) that span a large portion of the spectrum ($\\text{BFR} > 0.1$). Examples include solar radio bursts, lightning discharges, and certain types of cosmic explosions like Fast Radio Bursts (FRBs)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:26"}) SET n = {id: "alien:26", name: "PolarMode: Circular", type: "value_illustration", description: "Illustrates circular polarization in detected signals.", definition: "Describes electromagnetic waves where the electric field vector rotates in a circular pattern as the wave propagates. Circular polarization maintaining high purity across frequency (indicated by $\\text{PolarAngleDeg}$ stability) is rare in natural sources and may indicate technological origin.", source_file: "alien_kb.jsonl", source_line: 27, source_id: 26, search_text: "PolarMode: Circular value_illustration Illustrates circular polarization in detected signals. Describes electromagnetic waves where the electric field vector rotates in a circular pattern as the wave propagates. Circular polarization maintaining high purity across frequency (indicated by $\\text{PolarAngleDeg}$ stability) is rare in natural sources and may indicate technological origin."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:27"}) SET n = {id: "alien:27", name: "EncryptEvid: Strong Pattern", type: "value_illustration", description: "Illustrates characteristics suggesting deliberate signal encoding.", definition: "Indicates detection of non-random, internally consistent patterns that resist simple decoding but show hallmarks of designed encryption or encoding. Characterized by high $\\text{EntropyVal} (> 0.7)$ combined with structural regularity that defies natural explanation.", source_file: "alien_kb.jsonl", source_line: 28, source_id: 27, search_text: "EncryptEvid: Strong Pattern value_illustration Illustrates characteristics suggesting deliberate signal encoding. Indicates detection of non-random, internally consistent patterns that resist simple decoding but show hallmarks of designed encryption or encoding. Characterized by high $\\text{EntropyVal} (> 0.7)$ combined with structural regularity that defies natural explanation."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:28"}) SET n = {id: "alien:28", name: "EncodeType: Frequency Hopping", type: "value_illustration", description: "Illustrates a sophisticated encoding method used in telecommunications.", definition: "Describes a transmission technique where the signal rapidly switches frequencies according to a predetermined sequence. Detection would be characterized by discontinuous spectral features that follow a pattern. This technique is used on Earth to secure communications and reduce interference.", source_file: "alien_kb.jsonl", source_line: 29, source_id: 28, search_text: "EncodeType: Frequency Hopping value_illustration Illustrates a sophisticated encoding method used in telecommunications. Describes a transmission technique where the signal rapidly switches frequencies according to a predetermined sequence. Detection would be characterized by discontinuous spectral features that follow a pattern. This technique is used on Earth to secure communications and reduce interference."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:29"}) SET n = {id: "alien:29", name: "FalsePosProb: <0.01", type: "value_illustration", description: "Illustrates extremely high confidence in signal detection.", definition: "Indicates less than 1% probability that the signal is a false detection or artifact. Such low false positive probability typically results from multiple independent confirmations, excellent signal strength (high $\\text{SnrRatio}$), and elimination of all known terrestrial and instrumental sources.", source_file: "alien_kb.jsonl", source_line: 30, source_id: 29, search_text: "FalsePosProb: <0.01 value_illustration Illustrates extremely high confidence in signal detection. Indicates less than 1% probability that the signal is a false detection or artifact. Such low false positive probability typically results from multiple independent confirmations, excellent signal strength (high $\\text{SnrRatio}$), and elimination of all known terrestrial and instrumental sources."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:30"}) SET n = {id: "alien:30", name: "Modulation Complexity Score (MCS)", type: "calculation_knowledge", description: "Quantifies the sophistication of signal modulation based on type and stability.", definition: "$\\text{MCS} = \\text{ModIndex} \\times (1 + \\text{SSM}) \\times M_{\\text{factor}}$, where $M_{\\text{factor}}$ is 2 for $\\text{ModType} = \\text{'AM'}$, 1.5 for 'FM', and 1 for other types. Incorporates Signal Stability Metric (SSM) to weight stable modulations higher.", source_file: "alien_kb.jsonl", source_line: 31, source_id: 30, search_text: "Modulation Complexity Score (MCS) calculation_knowledge Quantifies the sophistication of signal modulation based on type and stability. $\\text{MCS} = \\text{ModIndex} \\times (1 + \\text{SSM}) \\times M_{\\text{factor}}$, where $M_{\\text{factor}}$ is 2 for $\\text{ModType} = \\text{'AM'}$, 1.5 for 'FM', and 1 for other types. Incorporates Signal Stability Metric (SSM) to weight stable modulations higher."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:31"}) SET n = {id: "alien:31", name: "Artificial Intelligence Detection Probability (AIDP)", type: "calculation_knowledge", description: "Calculates likelihood of artificial intelligence origin based on encoding complexity and technosignature indicators.", definition: "$\\text{AIDP} = \\frac{\\text{ECI} \\times \\text{TOLS}}{1 + \\text{NatSrcProb}}$, where ECI (Encoding Complexity Index) and TOLS (Technological Origin Likelihood Score) are weighted against natural source probability.", source_file: "alien_kb.jsonl", source_line: 32, source_id: 31, search_text: "Artificial Intelligence Detection Probability (AIDP) calculation_knowledge Calculates likelihood of artificial intelligence origin based on encoding complexity and technosignature indicators. $\\text{AIDP} = \\frac{\\text{ECI} \\times \\text{TOLS}}{1 + \\text{NatSrcProb}}$, where ECI (Encoding Complexity Index) and TOLS (Technological Origin Likelihood Score) are weighted against natural source probability."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:32"}) SET n = {id: "alien:32", name: "Observation Quality Factor (OQF)", type: "calculation_knowledge", description: "Provides a comprehensive measure of observational conditions quality.", definition: "$\\text{OQF} = \\text{AOI} \\times (1 - \\text{LIF}) \\times (\\text{PointAccArc} < 2 ? 1 : \\frac{2}{\\text{PointAccArc}})$, where AOI (Atmospheric Observability Index) and LIF (Lunar Interference Factor) are combined with telescope pointing accuracy.", source_file: "alien_kb.jsonl", source_line: 33, source_id: 32, search_text: "Observation Quality Factor (OQF) calculation_knowledge Provides a comprehensive measure of observational conditions quality. $\\text{OQF} = \\text{AOI} \\times (1 - \\text{LIF}) \\times (\\text{PointAccArc} < 2 ? 1 : \\frac{2}{\\text{PointAccArc}})$, where AOI (Atmospheric Observability Index) and LIF (Lunar Interference Factor) are combined with telescope pointing accuracy."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:33"}) SET n = {id: "alien:33", name: "Information Entropy Ratio (IER)", type: "calculation_knowledge", description: "Compares signal entropy to expected natural background entropy.", definition: "$\\text{IER} = \\frac{\\text{EntropyVal}}{\\text{NatSrcProb} \\times 0.9 + 0.1}$, where values significantly greater than 1 suggest non-natural information content. Uses NatSrcProb as a baseline for expected natural entropy.", source_file: "alien_kb.jsonl", source_line: 34, source_id: 33, search_text: "Information Entropy Ratio (IER) calculation_knowledge Compares signal entropy to expected natural background entropy. $\\text{IER} = \\frac{\\text{EntropyVal}}{\\text{NatSrcProb} \\times 0.9 + 0.1}$, where values significantly greater than 1 suggest non-natural information content. Uses NatSrcProb as a baseline for expected natural entropy."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:34"}) SET n = {id: "alien:34", name: "Signal Processing Efficiency Index (SPEI)", type: "calculation_knowledge", description: "Evaluates the computational efficiency of signal processing relative to complexity.", definition: "$\\text{SPEI} = \\frac{\\text{DecodeIters} \\times \\text{ProcTimeHrs}}{\\text{ECI} \\times \\text{ComplexIdx}}$, where ECI (Encoding Complexity Index) provides the complexity component to normalize processing time and iterations.", source_file: "alien_kb.jsonl", source_line: 35, source_id: 34, search_text: "Signal Processing Efficiency Index (SPEI) calculation_knowledge Evaluates the computational efficiency of signal processing relative to complexity. $\\text{SPEI} = \\frac{\\text{DecodeIters} \\times \\text{ProcTimeHrs}}{\\text{ECI} \\times \\text{ComplexIdx}}$, where ECI (Encoding Complexity Index) provides the complexity component to normalize processing time and iterations."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:35"}) SET n = {id: "alien:35", name: "Celestial Location Significance Factor (CLSF)", type: "calculation_knowledge", description: "Calculates significance of signal source location based on astronomical targets of interest.", definition: "$\\text{CLSF} = (\\text{CelestObj} ? 2 : 1) \\times (\\text{ObjType} == \\text{'Giant'} \\&\\& \\text{ObjMassSol} \\text{ between } 0.8 \\text{ and } 1.2 ? 1.5 : 1) \\times (\\text{ObjMetal} > 0 ? \\text{ObjMetal} + 1 : 0.5)$, where higher values indicate source locations more likely to harbor intelligent life.", source_file: "alien_kb.jsonl", source_line: 36, source_id: 35, search_text: "Celestial Location Significance Factor (CLSF) calculation_knowledge Calculates significance of signal source location based on astronomical targets of interest. $\\text{CLSF} = (\\text{CelestObj} ? 2 : 1) \\times (\\text{ObjType} == \\text{'Giant'} \\&\\& \\text{ObjMassSol} \\text{ between } 0.8 \\text{ and } 1.2 ? 1.5 : 1) \\times (\\text{ObjMetal} > 0 ? \\text{ObjMetal} + 1 : 0.5)$, where higher values indicate source locations more likely to harbor intelligent life."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:36"}) SET n = {id: "alien:36", name: "Confirmation Confidence Score (CCS)", type: "calculation_knowledge", description: "Quantifies overall confidence in signal verification across multiple parameters.", definition: "$\\text{CCS} = (1 - \\text{FalsePosProb}) \\times \\text{DecodeConf} \\times \\text{ClassConf} \\times (\\text{SNQI} > 0 ? \\frac{\\text{SNQI}}{10} + 0.5 : 0.1)$, where SNQI (Signal-to-Noise Quality Indicator) provides a quality weighting factor.", source_file: "alien_kb.jsonl", source_line: 37, source_id: 36, search_text: "Confirmation Confidence Score (CCS) calculation_knowledge Quantifies overall confidence in signal verification across multiple parameters. $\\text{CCS} = (1 - \\text{FalsePosProb}) \\times \\text{DecodeConf} \\times \\text{ClassConf} \\times (\\text{SNQI} > 0 ? \\frac{\\text{SNQI}}{10} + 0.5 : 0.1)$, where SNQI (Signal-to-Noise Quality Indicator) provides a quality weighting factor."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:37"}) SET n = {id: "alien:37", name: "Habitable Zone Signal Relevance (HZSR)", type: "calculation_knowledge", description: "Assesses signal relevance based on source's position in habitable zone.", definition: "$\\text{HZSR} = \\text{TOLS} \\times (\\text{ObjType} == \\text{'Dwarf'} ? (0.7 \\leq \\text{ObjMassSol} \\leq 1.4 ? (0.8 \\leq \\frac{\\text{SourceDistLy}}{\\sqrt{\\text{ObjMassSol}}} \\leq 1.7 ? 2 : 0.5) : 0.3) : 0.1)$, where TOLS (Technological Origin Likelihood Score) is weighted by stellar habitability factors.", source_file: "alien_kb.jsonl", source_line: 38, source_id: 37, search_text: "Habitable Zone Signal Relevance (HZSR) calculation_knowledge Assesses signal relevance based on source's position in habitable zone. $\\text{HZSR} = \\text{TOLS} \\times (\\text{ObjType} == \\text{'Dwarf'} ? (0.7 \\leq \\text{ObjMassSol} \\leq 1.4 ? (0.8 \\leq \\frac{\\text{SourceDistLy}}{\\sqrt{\\text{ObjMassSol}}} \\leq 1.7 ? 2 : 0.5) : 0.3) : 0.1)$, where TOLS (Technological Origin Likelihood Score) is weighted by stellar habitability factors."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:38"}) SET n = {id: "alien:38", name: "Pattern Recognition Confidence (PRC)", type: "calculation_knowledge", description: "Measures confidence in identified signal patterns based on multiple factors.", definition: "$\\text{PRC} = (\\text{RepeatCount} > 1 ? 1 + \\log_{10}(\\text{RepeatCount}) : 0.5) \\times (\\text{EntropyVal} < 0.9 ? 1 : 0.3) \\times \\text{SCR}$, where SCR (Signal Complexity Ratio) provides complexity weighting.", source_file: "alien_kb.jsonl", source_line: 39, source_id: 38, search_text: "Pattern Recognition Confidence (PRC) calculation_knowledge Measures confidence in identified signal patterns based on multiple factors. $\\text{PRC} = (\\text{RepeatCount} > 1 ? 1 + \\log_{10}(\\text{RepeatCount}) : 0.5) \\times (\\text{EntropyVal} < 0.9 ? 1 : 0.3) \\times \\text{SCR}$, where SCR (Signal Complexity Ratio) provides complexity weighting."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:39"}) SET n = {id: "alien:39", name: "NTM Classification System", type: "domain_knowledge", description: "A tiered classification system for Narrowband Technological Markers based on signal characteristics.", definition: "Three-tier classification: 'Strong NTM' (BFR < 0.0001 AND FreqDriftHzs < 0.1 AND non-natural modulation), 'Moderate NTM' (BFR < 0.0005 AND FreqDriftHzs < 0.5 AND non-natural modulation), and 'Not NTM' (all other signals).", source_file: "alien_kb.jsonl", source_line: 40, source_id: 39, search_text: "NTM Classification System domain_knowledge A tiered classification system for Narrowband Technological Markers based on signal characteristics. Three-tier classification: 'Strong NTM' (BFR < 0.0001 AND FreqDriftHzs < 0.1 AND non-natural modulation), 'Moderate NTM' (BFR < 0.0005 AND FreqDriftHzs < 0.5 AND non-natural modulation), and 'Not NTM' (all other signals)."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:40"}) SET n = {id: "alien:40", name: "High-Confidence Technosignature", type: "domain_knowledge", description: "Defines signals with extremely high likelihood of technological origin.", definition: "A Technosignature with $\\text{CCS} > 0.9$, $\\text{MCS} > 1.5$, and $\\text{AIDP} > 0.8$, indicating a signal that meets the basic Technosignature criteria with additional confirmation through modulation complexity and artificial intelligence detection markers.", source_file: "alien_kb.jsonl", source_line: 41, source_id: 40, search_text: "High-Confidence Technosignature domain_knowledge Defines signals with extremely high likelihood of technological origin. A Technosignature with $\\text{CCS} > 0.9$, $\\text{MCS} > 1.5$, and $\\text{AIDP} > 0.8$, indicating a signal that meets the basic Technosignature criteria with additional confirmation through modulation complexity and artificial intelligence detection markers."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:41"}) SET n = {id: "alien:41", name: "Habitable Zone Transmission", type: "domain_knowledge", description: "Identifies signals originating from stellar habitable zones with technological characteristics.", definition: "A signal with $\\text{HZSR} > 1.5$ and Technosignature characteristics, originating from a star system with conditions potentially suitable for life, making it a priority candidate for SETI research.", source_file: "alien_kb.jsonl", source_line: 42, source_id: 41, search_text: "Habitable Zone Transmission domain_knowledge Identifies signals originating from stellar habitable zones with technological characteristics. A signal with $\\text{HZSR} > 1.5$ and Technosignature characteristics, originating from a star system with conditions potentially suitable for life, making it a priority candidate for SETI research."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:42"}) SET n = {id: "alien:42", name: "Multi-Channel Communication Protocol", type: "domain_knowledge", description: "Identifies signal patterns consistent with sophisticated communication protocols.", definition: "Signal exhibiting Coherent Information Pattern (CIP) characteristics across multiple frequency channels with coordinated timing ($\\text{RepeatCount} > 3$, $\\text{PeriodSec}$ consistent across observations) and $\\text{ECI} > 2.0$, suggesting a designed communication system.", source_file: "alien_kb.jsonl", source_line: 43, source_id: 42, search_text: "Multi-Channel Communication Protocol domain_knowledge Identifies signal patterns consistent with sophisticated communication protocols. Signal exhibiting Coherent Information Pattern (CIP) characteristics across multiple frequency channels with coordinated timing ($\\text{RepeatCount} > 3$, $\\text{PeriodSec}$ consistent across observations) and $\\text{ECI} > 2.0$, suggesting a designed communication system."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:43"}) SET n = {id: "alien:43", name: "Quantum-Coherent Transmission", type: "domain_knowledge", description: "Describes signals potentially employing quantum properties for communication.", definition: "Signals with $\\text{QuantEffects}$ containing 'Significant' or 'Observed' patterns, exhibiting unusually high information density ($\\text{InfoDense} > 1.5$) while maintaining an $\\text{ECI} > 2.5$, suggesting advanced transmission technologies beyond conventional radiofrequency methods.", source_file: "alien_kb.jsonl", source_line: 44, source_id: 43, search_text: "Quantum-Coherent Transmission domain_knowledge Describes signals potentially employing quantum properties for communication. Signals with $\\text{QuantEffects}$ containing 'Significant' or 'Observed' patterns, exhibiting unusually high information density ($\\text{InfoDense} > 1.5$) while maintaining an $\\text{ECI} > 2.5$, suggesting advanced transmission technologies beyond conventional radiofrequency methods."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:44"}) SET n = {id: "alien:44", name: "Research Critical Signal", type: "domain_knowledge", description: "Defines signals requiring immediate and extensive scientific resources.", definition: "Signals meeting Target of Opportunity (TOO) criteria with additional $\\text{PRC} > 0.8$ and $\\text{IMDF} < 0.5$, indicating high-quality, minimally distorted signals that show recognizable patterns warranting priority allocation of research resources.", source_file: "alien_kb.jsonl", source_line: 45, source_id: 44, search_text: "Research Critical Signal domain_knowledge Defines signals requiring immediate and extensive scientific resources. Signals meeting Target of Opportunity (TOO) criteria with additional $\\text{PRC} > 0.8$ and $\\text{IMDF} < 0.5$, indicating high-quality, minimally distorted signals that show recognizable patterns warranting priority allocation of research resources."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:45"}) SET n = {id: "alien:45", name: "Directed Transmission", type: "domain_knowledge", description: "Identifies signals that appear specifically directed rather than omnidirectional.", definition: "Signals with high spatial stability ($\\text{SpatStab} = \\text{'Moderate'}$), narrow beam characteristics ($\\text{PolarMode} = \\text{'Linear'}$ with stable $\\text{PolarAngleDeg}$), and high $\\text{TOLS} > 0.85$, suggesting intentional transmission toward our location.", source_file: "alien_kb.jsonl", source_line: 46, source_id: 45, search_text: "Directed Transmission domain_knowledge Identifies signals that appear specifically directed rather than omnidirectional. Signals with high spatial stability ($\\text{SpatStab} = \\text{'Moderate'}$), narrow beam characteristics ($\\text{PolarMode} = \\text{'Linear'}$ with stable $\\text{PolarAngleDeg}$), and high $\\text{TOLS} > 0.85$, suggesting intentional transmission toward our location."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:46"}) SET n = {id: "alien:46", name: "Signal of Galactic Significance", type: "domain_knowledge", description: "Classifies signals with potential importance to galactic civilization models.", definition: "Signals originating from regions of high $\\text{CLSF} (> 2.0)$ that display Technosignature characteristics and have $\\text{AIDP} > 0.7$, representing potential evidence of advanced civilizations at galactic-relevant locations.", source_file: "alien_kb.jsonl", source_line: 47, source_id: 46, search_text: "Signal of Galactic Significance domain_knowledge Classifies signals with potential importance to galactic civilization models. Signals originating from regions of high $\\text{CLSF} (> 2.0)$ that display Technosignature characteristics and have $\\text{AIDP} > 0.7$, representing potential evidence of advanced civilizations at galactic-relevant locations."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:47"}) SET n = {id: "alien:47", name: "CCS Approximation", type: "calculation_knowledge", description: "Simplified CCS calculation using direct signal-to-noise ratio values when full Signal-to-Noise Quality Indicator (SNQI) data is unavailable.", definition: "$(1 - \\text{FalsePosProb}) \\times \\text{DecodeConf} \\times (\\text{SNR} - 0.1 \\times |\\text{NoiseFloorDbm}| > 0 ? \\frac{\\text{SNR} - 0.1 \\times |\\text{NoiseFloorDbm}|}{10} + 0.5 : 0.1)$", source_file: "alien_kb.jsonl", source_line: 48, source_id: 47, search_text: "CCS Approximation calculation_knowledge Simplified CCS calculation using direct signal-to-noise ratio values when full Signal-to-Noise Quality Indicator (SNQI) data is unavailable. $(1 - \\text{FalsePosProb}) \\times \\text{DecodeConf} \\times (\\text{SNR} - 0.1 \\times |\\text{NoiseFloorDbm}| > 0 ? \\frac{\\text{SNR} - 0.1 \\times |\\text{NoiseFloorDbm}|}{10} + 0.5 : 0.1)$"};
MERGE (n:Knowledge:SemanticSearch {id: "alien:48"}) SET n = {id: "alien:48", name: "Observation-Verified Signal", type: "domain_knowledge", description: "Defines signals that have undergone rigorous verification processes.", definition: "Signals observed under Optimal Observing Window (OOW) conditions with $\\text{OQF} > 0.85$ and $\\text{CCS} > 0.8$, indicating high-quality observations with multiple verification methods applied.", source_file: "alien_kb.jsonl", source_line: 49, source_id: 48, search_text: "Observation-Verified Signal domain_knowledge Defines signals that have undergone rigorous verification processes. Signals observed under Optimal Observing Window (OOW) conditions with $\\text{OQF} > 0.85$ and $\\text{CCS} > 0.8$, indicating high-quality observations with multiple verification methods applied."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:49"}) SET n = {id: "alien:49", name: "Anomalous Quantum Signal", type: "domain_knowledge", description: "Describes signals exhibiting quantum properties inconsistent with current physics models.", definition: "Signals with $\\text{QuantEffects}$ indicating anomalous behavior, $\\text{AnomScore} > 8$, and unusually high $\\text{MCS} (> 2.0)$, suggesting either unknown natural quantum phenomena or extremely advanced transmission technologies beyond current human capabilities.", source_file: "alien_kb.jsonl", source_line: 50, source_id: 49, search_text: "Anomalous Quantum Signal domain_knowledge Describes signals exhibiting quantum properties inconsistent with current physics models. Signals with $\\text{QuantEffects}$ indicating anomalous behavior, $\\text{AnomScore} > 8$, and unusually high $\\text{MCS} (> 2.0)$, suggesting either unknown natural quantum phenomena or extremely advanced transmission technologies beyond current human capabilities."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:50"}) SET n = {id: "alien:50", name: "Analyzable Signals", type: "domain_knowledge", description: "Signals of sufficient quality to be considered useful for further analysis.", definition: "Signals with SNQI > 0 are considered analyzable.", source_file: "alien_kb.jsonl", source_line: 51, source_id: 50, search_text: "Analyzable Signals domain_knowledge Signals of sufficient quality to be considered useful for further analysis. Signals with SNQI > 0 are considered analyzable."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:51"}) SET n = {id: "alien:51", name: "Bandwidth-to-Frequency Ratio (BFR)", type: "calculation_knowledge", description: "Normalized signal width relative to its central frequency.", definition: "$\\text{BFR} = \\frac{\\text{BwHz}}{\\text{CenterFreqMhz} \\times 1{,}000{,}000}$, used to characterize signal spread relative to its frequency band.", source_file: "alien_kb.jsonl", source_line: 52, source_id: 51, search_text: "Bandwidth-to-Frequency Ratio (BFR) calculation_knowledge Normalized signal width relative to its central frequency. $\\text{BFR} = \\frac{\\text{BwHz}}{\\text{CenterFreqMhz} \\times 1{,}000{,}000}$, used to characterize signal spread relative to its frequency band."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:52"}) SET n = {id: "alien:52", name: "TOLS Category", type: "domain_knowledge", description: "Classification of signals based on TOLS thresholds.", definition: "Categorized as 'Low' if TOLS < 0.25, 'Medium' if TOLS < 0.75, and 'High' otherwise.", source_file: "alien_kb.jsonl", source_line: 53, source_id: 52, search_text: "TOLS Category domain_knowledge Classification of signals based on TOLS thresholds. Categorized as 'Low' if TOLS < 0.25, 'Medium' if TOLS < 0.75, and 'High' otherwise."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:53"}) SET n = {id: "alien:53", name: "High Lunar Interference Events", type: "domain_knowledge", description: "Observations with significant lunar interference.", definition: "Events where the calculated LIF is greater than 0.5, indicating strong lunar contamination in the data.", source_file: "alien_kb.jsonl", source_line: 54, source_id: 53, search_text: "High Lunar Interference Events domain_knowledge Observations with significant lunar interference. Events where the calculated LIF is greater than 0.5, indicating strong lunar contamination in the data."};
MERGE (n:Knowledge:SemanticSearch {id: "alien:54"}) SET n = {id: "alien:54", name: "High Confidence Signals", type: "domain_knowledge", description: "Signal with Confirmation Confidence Score (CCS) > 0.8, indicating high reliability.", definition: "Signals where $\\text{CCS} > 0.8$", source_file: "alien_kb.jsonl", source_line: 55, source_id: 54, search_text: "High Confidence Signals domain_knowledge Signal with Confirmation Confidence Score (CCS) > 0.8, indicating high reliability. Signals where $\\text{CCS} > 0.8$"};
MERGE (n:Knowledge:SemanticSearch {id: "alien:55"}) SET n = {id: "alien:55", name: "Equipment Problems", type: "domain_knowledge", description: "Defines what counts as an abnormal condition for a telescope’s subsystems.", definition: "A telescope is considered to have an equipment problem whenever **any** of its key subsystem states are not in their nominal condition: • Equipment status is not “Operational”; • Calibration status is not “Current”; • Cooling-system status is not “Normal”.", source_file: "alien_kb.jsonl", source_line: 56, source_id: 55, search_text: "Equipment Problems domain_knowledge Defines what counts as an abnormal condition for a telescope’s subsystems. A telescope is considered to have an equipment problem whenever **any** of its key subsystem states are not in their nominal condition: • Equipment status is not “Operational”; • Calibration status is not “Current”; • Cooling-system status is not “Normal”."};
MATCH (d:Database {id: "archeology"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "archeology:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "archeology:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "archeology:" AND NOT stale.id IN ["archeology:0", "archeology:1", "archeology:2", "archeology:3", "archeology:4", "archeology:5", "archeology:6", "archeology:7", "archeology:8", "archeology:9", "archeology:10", "archeology:11", "archeology:12", "archeology:13", "archeology:14", "archeology:15", "archeology:16", "archeology:17", "archeology:18", "archeology:19", "archeology:20", "archeology:21", "archeology:22", "archeology:23", "archeology:24", "archeology:25", "archeology:26", "archeology:27", "archeology:28", "archeology:29", "archeology:30", "archeology:31", "archeology:32", "archeology:33", "archeology:34", "archeology:35", "archeology:36", "archeology:37", "archeology:38", "archeology:39", "archeology:40", "archeology:41", "archeology:42", "archeology:43", "archeology:44", "archeology:45", "archeology:46", "archeology:47", "archeology:48", "archeology:49", "archeology:50", "archeology:51", "archeology:52", "archeology:53"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "archeology:0"}) SET n = {id: "archeology:0", name: "Scan Resolution Index (SRI)", type: "calculation_knowledge", description: "A sophisticated compound index measuring the overall resolution quality of a scan based on resolution and point density.", definition: "SRI = \\frac{\\log_{10}(ScanResolMm \\times 10^3)}{\\log_{10}(PointDense)} \\times 5, \\text{ where lower values indicate higher quality resolution and more balanced scanning parameters.}", source_file: "archeology_kb.jsonl", source_line: 1, source_id: 0, search_text: "Scan Resolution Index (SRI) calculation_knowledge A sophisticated compound index measuring the overall resolution quality of a scan based on resolution and point density. SRI = \\frac{\\log_{10}(ScanResolMm \\times 10^3)}{\\log_{10}(PointDense)} \\times 5, \\text{ where lower values indicate higher quality resolution and more balanced scanning parameters.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:1"}) SET n = {id: "archeology:1", name: "Scan Coverage Effectiveness (SCE)", type: "calculation_knowledge", description: "Measures how effectively a scan covers its target area considering both coverage percentage and overlap redundancy.", definition: "SCE = CoverPct \\times \\left(1 + \\frac{LapPct}{100} \\times \\left(1 - \\frac{CoverPct}{100}\\right)\\right), \\text{ where higher values indicate more effective coverage with appropriate overlap.}", source_file: "archeology_kb.jsonl", source_line: 2, source_id: 1, search_text: "Scan Coverage Effectiveness (SCE) calculation_knowledge Measures how effectively a scan covers its target area considering both coverage percentage and overlap redundancy. SCE = CoverPct \\times \\left(1 + \\frac{LapPct}{100} \\times \\left(1 - \\frac{CoverPct}{100}\\right)\\right), \\text{ where higher values indicate more effective coverage with appropriate overlap.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:2"}) SET n = {id: "archeology:2", name: "Point Cloud Density Ratio (PCDR)", type: "calculation_knowledge", description: "Evaluates the relationship between total points and cloud density, used to assess scan efficiency and data distribution.", definition: "PCDR = \\frac{TotalPts}{CloudDense \\times AreaM2}, \\text{ where higher values suggest more efficient and spatially consistent scanning techniques.}", source_file: "archeology_kb.jsonl", source_line: 3, source_id: 2, search_text: "Point Cloud Density Ratio (PCDR) calculation_knowledge Evaluates the relationship between total points and cloud density, used to assess scan efficiency and data distribution. PCDR = \\frac{TotalPts}{CloudDense \\times AreaM2}, \\text{ where higher values suggest more efficient and spatially consistent scanning techniques.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:3"}) SET n = {id: "archeology:3", name: "Scan Quality Score (SQS)", type: "calculation_knowledge", description: "Comprehensive quality metric combining resolution, coverage, and noise factors with weighted importance.", definition: "SQS = \\left(\\frac{10}{SRI}\\right)^{1.5} \\times \\left(\\frac{SCE}{100}\\right) \\times \\left(1 - \\frac{NoiseDb}{30}\\right)^2, \\text{ where higher values indicate exponentially better overall scan quality with emphasis on resolution.}", source_file: "archeology_kb.jsonl", source_line: 4, source_id: 3, search_text: "Scan Quality Score (SQS) calculation_knowledge Comprehensive quality metric combining resolution, coverage, and noise factors with weighted importance. SQS = \\left(\\frac{10}{SRI}\\right)^{1.5} \\times \\left(\\frac{SCE}{100}\\right) \\times \\left(1 - \\frac{NoiseDb}{30}\\right)^2, \\text{ where higher values indicate exponentially better overall scan quality with emphasis on resolution.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:4"}) SET n = {id: "archeology:4", name: "Mesh Complexity Ratio (MCR)", type: "calculation_knowledge", description: "Measures the topological complexity of a mesh relative to its resolution, helping identify overly complex or simplified archaeological models.", definition: "MCR = \\frac{FacetFaces}{FacetVerts \\times FacetResMm^2} \\times 10^3, \\text{ where higher values indicate more complex meshes for a given resolution, capturing finer archaeological details.}", source_file: "archeology_kb.jsonl", source_line: 5, source_id: 4, search_text: "Mesh Complexity Ratio (MCR) calculation_knowledge Measures the topological complexity of a mesh relative to its resolution, helping identify overly complex or simplified archaeological models. MCR = \\frac{FacetFaces}{FacetVerts \\times FacetResMm^2} \\times 10^3, \\text{ where higher values indicate more complex meshes for a given resolution, capturing finer archaeological details.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:5"}) SET n = {id: "archeology:5", name: "Texture Density Index (TDI)", type: "calculation_knowledge", description: "Evaluates the pixel density of textures relative to mesh resolution for assessing surface detail preservation.", definition: "TDI = \\frac{TexPix}{\\sqrt{FacetFaces} \\times FacetResMm} \\times 10^{-2}, \\text{ where higher values indicate more detailed textures relative to geometric complexity.}", source_file: "archeology_kb.jsonl", source_line: 6, source_id: 5, search_text: "Texture Density Index (TDI) calculation_knowledge Evaluates the pixel density of textures relative to mesh resolution for assessing surface detail preservation. TDI = \\frac{TexPix}{\\sqrt{FacetFaces} \\times FacetResMm} \\times 10^{-2}, \\text{ where higher values indicate more detailed textures relative to geometric complexity.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:6"}) SET n = {id: "archeology:6", name: "Model Fidelity Score (MFS)", type: "calculation_knowledge", description: "Combines mesh complexity, texture quality, and geometric accuracy to assess overall 3D model fidelity for archaeological analysis.", definition: "MFS = MCR \\times \\left(\\frac{TDI}{10}\\right) \\times \\left(1 + \\exp\\left(-GeomDeltaMm\\right)\\right), \\text{ where higher values indicate more accurate and detailed models with appropriate complexity.}", source_file: "archeology_kb.jsonl", source_line: 7, source_id: 6, search_text: "Model Fidelity Score (MFS) calculation_knowledge Combines mesh complexity, texture quality, and geometric accuracy to assess overall 3D model fidelity for archaeological analysis. MFS = MCR \\times \\left(\\frac{TDI}{10}\\right) \\times \\left(1 + \\exp\\left(-GeomDeltaMm\\right)\\right), \\text{ where higher values indicate more accurate and detailed models with appropriate complexity.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:7"}) SET n = {id: "archeology:7", name: "Environmental Suitability Index (ESI)", type: "calculation_knowledge", description: "Evaluates how suitable environmental conditions were for scanning operations using weighted parameters.", definition: "ESI = 100 - 2.5 \\times \\left|AmbicTemp - 20\\right| - \\left|\\frac{HumePct - 50}{2}\\right|^{1.5} - \\frac{600}{IllumeLux + 100}, \\text{ where higher values indicate more ideal scanning conditions adjusted for relative importance.}", source_file: "archeology_kb.jsonl", source_line: 8, source_id: 7, search_text: "Environmental Suitability Index (ESI) calculation_knowledge Evaluates how suitable environmental conditions were for scanning operations using weighted parameters. ESI = 100 - 2.5 \\times \\left|AmbicTemp - 20\\right| - \\left|\\frac{HumePct - 50}{2}\\right|^{1.5} - \\frac{600}{IllumeLux + 100}, \\text{ where higher values indicate more ideal scanning conditions adjusted for relative importance.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:8"}) SET n = {id: "archeology:8", name: "Processing Efficiency Ratio (PER)", type: "calculation_knowledge", description: "Measures the efficiency of scan processing by comparing processing time to data complexity and size.", definition: "PER = \\frac{GBSize \\times \\log_{10}(TotalPts)}{FlowHrs \\times (ProcCPU + ProcGPU)/200}, \\text{ where higher values indicate more efficient processing relative to data complexity.}", source_file: "archeology_kb.jsonl", source_line: 9, source_id: 8, search_text: "Processing Efficiency Ratio (PER) calculation_knowledge Measures the efficiency of scan processing by comparing processing time to data complexity and size. PER = \\frac{GBSize \\times \\log_{10}(TotalPts)}{FlowHrs \\times (ProcCPU + ProcGPU)/200}, \\text{ where higher values indicate more efficient processing relative to data complexity.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:9"}) SET n = {id: "archeology:9", name: "Archaeological Documentation Completeness (ADC)", type: "calculation_knowledge", description: "Comprehensive score for how completely a site has been documented through scanning with weighted importance factors.", definition: "ADC = \\left(SQS \\times 0.4\\right) + \\left(MFS \\times 0.4\\right) + \\left(SCE \\times 0.2\\right) - 5 \\times \\sqrt{\\frac{NoiseDb}{10}}, \\text{ where higher values indicate more complete documentation with multiple quality factors.}", source_file: "archeology_kb.jsonl", source_line: 10, source_id: 9, search_text: "Archaeological Documentation Completeness (ADC) calculation_knowledge Comprehensive score for how completely a site has been documented through scanning with weighted importance factors. ADC = \\left(SQS \\times 0.4\\right) + \\left(MFS \\times 0.4\\right) + \\left(SCE \\times 0.2\\right) - 5 \\times \\sqrt{\\frac{NoiseDb}{10}}, \\text{ where higher values indicate more complete documentation with multiple quality factors.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:10"}) SET n = {id: "archeology:10", name: "High Resolution Scan", type: "domain_knowledge", description: "Defines what constitutes a high-resolution archaeological scan based on quantitative parameters.", definition: "A scan with ScanResolMm \\leq 1.0 and PointDense \\geq 1000, allowing for sub-millimeter precision in archaeological documentation and feature detection.", source_file: "archeology_kb.jsonl", source_line: 11, source_id: 10, search_text: "High Resolution Scan domain_knowledge Defines what constitutes a high-resolution archaeological scan based on quantitative parameters. A scan with ScanResolMm \\leq 1.0 and PointDense \\geq 1000, allowing for sub-millimeter precision in archaeological documentation and feature detection."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:11"}) SET n = {id: "archeology:11", name: "Comprehensive Coverage", type: "domain_knowledge", description: "Defines the standard for comprehensive scan coverage of an archaeological site or artifact with statistical confidence.", definition: "A scan with CoverPct \\geq 95 and LapPct \\geq 30, ensuring minimal data gaps and sufficient overlap for accurate registration with 95% confidence interval for spatial measurements.", source_file: "archeology_kb.jsonl", source_line: 12, source_id: 11, search_text: "Comprehensive Coverage domain_knowledge Defines the standard for comprehensive scan coverage of an archaeological site or artifact with statistical confidence. A scan with CoverPct \\geq 95 and LapPct \\geq 30, ensuring minimal data gaps and sufficient overlap for accurate registration with 95% confidence interval for spatial measurements."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:12"}) SET n = {id: "archeology:12", name: "Premium Quality Scan", type: "domain_knowledge", description: "Defines the criteria for a premium quality archaeological scan suitable for conservation planning and scholarly publication.", definition: "A scan that is both a High Resolution Scan and has Comprehensive Coverage with SQS > 7.5, where SQS is the Scan Quality Score, producing data suitable for detailed analysis and conservation planning.", source_file: "archeology_kb.jsonl", source_line: 13, source_id: 12, search_text: "Premium Quality Scan domain_knowledge Defines the criteria for a premium quality archaeological scan suitable for conservation planning and scholarly publication. A scan that is both a High Resolution Scan and has Comprehensive Coverage with SQS > 7.5, where SQS is the Scan Quality Score, producing data suitable for detailed analysis and conservation planning."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:13"}) SET n = {id: "archeology:13", name: "High Fidelity Mesh", type: "domain_knowledge", description: "Defines criteria for high-fidelity 3D mesh models in archaeological documentation suitable for analytical studies.", definition: "A mesh with MCR > 5.0, FacetResMm < 1.0, and GeomDeltaMm < 0.5, where MCR is the Mesh Complexity Ratio, capable of representing fine archaeological details and surface morphology.", source_file: "archeology_kb.jsonl", source_line: 14, source_id: 13, search_text: "High Fidelity Mesh domain_knowledge Defines criteria for high-fidelity 3D mesh models in archaeological documentation suitable for analytical studies. A mesh with MCR > 5.0, FacetResMm < 1.0, and GeomDeltaMm < 0.5, where MCR is the Mesh Complexity Ratio, capable of representing fine archaeological details and surface morphology."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:14"}) SET n = {id: "archeology:14", name: "Degradation Risk Zone", type: "domain_knowledge", description: "Identifies archaeological sites at risk of degradation requiring urgent conservation intervention based on multiple factors.", definition: "A site with PresStat containing 'Poor' or 'Critical' and StructState not containing 'Stable', signaling immediate conservation needs due to active deterioration processes.", source_file: "archeology_kb.jsonl", source_line: 15, source_id: 14, search_text: "Degradation Risk Zone domain_knowledge Identifies archaeological sites at risk of degradation requiring urgent conservation intervention based on multiple factors. A site with PresStat containing 'Poor' or 'Critical' and StructState not containing 'Stable', signaling immediate conservation needs due to active deterioration processes."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:15"}) SET n = {id: "archeology:15", name: "Optimal Scanning Conditions", type: "domain_knowledge", description: "Defines the environmental conditions considered optimal for archaeological scanning based on instrument sensitivity profiles.", definition: "Conditions with ESI > 85, where ESI is the Environmental Suitability Index (knowledge #7), characterized by moderate temperature, humidity around 50%, and good illumination, minimizing environmental interference with scanning accuracy.", source_file: "archeology_kb.jsonl", source_line: 16, source_id: 15, search_text: "Optimal Scanning Conditions domain_knowledge Defines the environmental conditions considered optimal for archaeological scanning based on instrument sensitivity profiles. Conditions with ESI > 85, where ESI is the Environmental Suitability Index (knowledge #7), characterized by moderate temperature, humidity around 50%, and good illumination, minimizing environmental interference with scanning accuracy."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:16"}) SET n = {id: "archeology:16", name: "Digital Conservation Priority", type: "domain_knowledge", description: "Classification system for prioritizing digital conservation efforts based on site conditions, historical significance, and preservation status.", definition: "A scoring system where sites in Degradation Risk Zones with GuessDate older than 1000 BCE or with TypeSite = 'Rare' or 'Unique' receive highest priority for digital preservation through Premium Quality Scans, requiring immediate allocation of scanning resources.", source_file: "archeology_kb.jsonl", source_line: 17, source_id: 16, search_text: "Digital Conservation Priority domain_knowledge Classification system for prioritizing digital conservation efforts based on site conditions, historical significance, and preservation status. A scoring system where sites in Degradation Risk Zones with GuessDate older than 1000 BCE or with TypeSite = 'Rare' or 'Unique' receive highest priority for digital preservation through Premium Quality Scans, requiring immediate allocation of scanning resources."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:17"}) SET n = {id: "archeology:17", name: "Processing Bottleneck", type: "domain_knowledge", description: "Identifies processing workflows that are experiencing resource constraints using performance metrics.", definition: "A processing record with PER < 0.5, where PER is the Processing Efficiency Ratio, indicating potential hardware limitations affecting processing speed and output quality, requiring workflow optimization.", source_file: "archeology_kb.jsonl", source_line: 18, source_id: 17, search_text: "Processing Bottleneck domain_knowledge Identifies processing workflows that are experiencing resource constraints using performance metrics. A processing record with PER < 0.5, where PER is the Processing Efficiency Ratio, indicating potential hardware limitations affecting processing speed and output quality, requiring workflow optimization."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:18"}) SET n = {id: "archeology:18", name: "Registration Quality Threshold", type: "domain_knowledge", description: "Defines the quality threshold for scan registration in archaeological documentation based on error propagation analysis.", definition: "A registration with LogAccuMm < 1.0 and ErrValMm < 2.0, ensuring sufficient accuracy for reliable spatial analysis with maximum tolerable error below the significant feature size threshold.", source_file: "archeology_kb.jsonl", source_line: 19, source_id: 18, search_text: "Registration Quality Threshold domain_knowledge Defines the quality threshold for scan registration in archaeological documentation based on error propagation analysis. A registration with LogAccuMm < 1.0 and ErrValMm < 2.0, ensuring sufficient accuracy for reliable spatial analysis with maximum tolerable error below the significant feature size threshold."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:19"}) SET n = {id: "archeology:19", name: "Full Archaeological Digital Twin", type: "domain_knowledge", description: "Defines the comprehensive digital representation of an archaeological site meeting all quality standards for research and preservation.", definition: "A site with Premium Quality Scans, High Fidelity Mesh, Registration Quality Threshold met, and ADC > 85, where ADC is Archaeological Documentation Completeness, representing a complete digital twin suitable for research, conservation, and visualization purposes.", source_file: "archeology_kb.jsonl", source_line: 20, source_id: 19, search_text: "Full Archaeological Digital Twin domain_knowledge Defines the comprehensive digital representation of an archaeological site meeting all quality standards for research and preservation. A site with Premium Quality Scans, High Fidelity Mesh, Registration Quality Threshold met, and ADC > 85, where ADC is Archaeological Documentation Completeness, representing a complete digital twin suitable for research, conservation, and visualization purposes."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:20"}) SET n = {id: "archeology:20", name: "ScanResolMm (Scan Resolution)", type: "value_illustration", description: "Illustrates the significance of scan resolution measurements in archaeological scanning for feature detection.", definition: "Measured in millimeters, representing the smallest feature that can be distinguished in the scan. Values like 0.5mm enable documentation of fine tool marks on artifacts, while 2.0mm might only capture general shape and macroscopic features.", source_file: "archeology_kb.jsonl", source_line: 21, source_id: 20, search_text: "ScanResolMm (Scan Resolution) value_illustration Illustrates the significance of scan resolution measurements in archaeological scanning for feature detection. Measured in millimeters, representing the smallest feature that can be distinguished in the scan. Values like 0.5mm enable documentation of fine tool marks on artifacts, while 2.0mm might only capture general shape and macroscopic features."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:21"}) SET n = {id: "archeology:21", name: "PointDense (Point Density)", type: "value_illustration", description: "Illustrates the significance of point density in archaeological point clouds for information richness.", definition: "Measured as points per square meter. Values around 100 capture basic site topography, 1,000 can document structural details, while 10,000+ enables analysis of surface textures and fine engravings across multiple scales of inquiry.", source_file: "archeology_kb.jsonl", source_line: 22, source_id: 21, search_text: "PointDense (Point Density) value_illustration Illustrates the significance of point density in archaeological point clouds for information richness. Measured as points per square meter. Values around 100 capture basic site topography, 1,000 can document structural details, while 10,000+ enables analysis of surface textures and fine engravings across multiple scales of inquiry."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:22"}) SET n = {id: "archeology:22", name: "NoiseDb (Noise Level)", type: "value_illustration", description: "Illustrates the impact of noise levels in point cloud data on feature recognition accuracy.", definition: "Measured in decibels, representing signal-to-noise ratio in scan data. Values below 1.0 indicate clean data suitable for detailed analysis, while values above 3.0 suggest significant noise that may obscure small features and introduce measurement uncertainty.", source_file: "archeology_kb.jsonl", source_line: 23, source_id: 22, search_text: "NoiseDb (Noise Level) value_illustration Illustrates the impact of noise levels in point cloud data on feature recognition accuracy. Measured in decibels, representing signal-to-noise ratio in scan data. Values below 1.0 indicate clean data suitable for detailed analysis, while values above 3.0 suggest significant noise that may obscure small features and introduce measurement uncertainty."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:23"}) SET n = {id: "archeology:23", name: "CoverPct (Coverage Percentage)", type: "value_illustration", description: "Illustrates the significance of coverage percentage in archaeological scans for site completeness assessment.", definition: "Percentage of target area successfully captured in scan data. Values above 95% indicate near-complete documentation, while 80% might have significant gaps requiring additional scanning or interpolation methods for comprehensive site analysis.", source_file: "archeology_kb.jsonl", source_line: 24, source_id: 23, search_text: "CoverPct (Coverage Percentage) value_illustration Illustrates the significance of coverage percentage in archaeological scans for site completeness assessment. Percentage of target area successfully captured in scan data. Values above 95% indicate near-complete documentation, while 80% might have significant gaps requiring additional scanning or interpolation methods for comprehensive site analysis."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:24"}) SET n = {id: "archeology:24", name: "GeomDeltaMm (Geometric Accuracy)", type: "value_illustration", description: "Illustrates the significance of geometric accuracy in 3D models for measurement reliability.", definition: "Measured in millimeters, representing the average deviation between the scan data and final 3D model. Values below 0.1mm indicate museum-quality accuracy, while values around 1.0mm are suitable for general documentation but introduce uncertainty in fine feature analysis.", source_file: "archeology_kb.jsonl", source_line: 25, source_id: 24, search_text: "GeomDeltaMm (Geometric Accuracy) value_illustration Illustrates the significance of geometric accuracy in 3D models for measurement reliability. Measured in millimeters, representing the average deviation between the scan data and final 3D model. Values below 0.1mm indicate museum-quality accuracy, while values around 1.0mm are suitable for general documentation but introduce uncertainty in fine feature analysis."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:25"}) SET n = {id: "archeology:25", name: "PhaseFactor (Cultural Period)", type: "value_illustration", description: "Illustrates the significance of cultural period classification in archaeological sites.", definition: "Classifies archaeological sites into standardized chronological/cultural periods. Values like 'Neolithic' (10,000-4,500 BCE), 'Bronze Age' (3,300-1,200 BCE), 'Roman' (27 BCE-476 CE), or 'Medieval' (476-1453 CE) determine applicable research methodologies, conservation approaches, and contextual interpretation frameworks.", source_file: "archeology_kb.jsonl", source_line: 26, source_id: 25, search_text: "PhaseFactor (Cultural Period) value_illustration Illustrates the significance of cultural period classification in archaeological sites. Classifies archaeological sites into standardized chronological/cultural periods. Values like 'Neolithic' (10,000-4,500 BCE), 'Bronze Age' (3,300-1,200 BCE), 'Roman' (27 BCE-476 CE), or 'Medieval' (476-1453 CE) determine applicable research methodologies, conservation approaches, and contextual interpretation frameworks."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:26"}) SET n = {id: "archeology:26", name: "StructState (Structural State)", type: "value_illustration", description: "Illustrates structural state classifications in archaeological conservation.", definition: "A categorical assessment with specific values: 'Stable' indicates structures that maintain integrity under normal conditions, 'Unstable' indicates structures showing signs of deterioration requiring intervention, and 'Critical' indicates structures at imminent risk of collapse requiring emergency stabilization.", source_file: "archeology_kb.jsonl", source_line: 27, source_id: 26, search_text: "StructState (Structural State) value_illustration Illustrates structural state classifications in archaeological conservation. A categorical assessment with specific values: 'Stable' indicates structures that maintain integrity under normal conditions, 'Unstable' indicates structures showing signs of deterioration requiring intervention, and 'Critical' indicates structures at imminent risk of collapse requiring emergency stabilization."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:27"}) SET n = {id: "archeology:27", name: "FlowStage (Processing Stage)", type: "value_illustration", description: "Illustrates the progression of data processing in archaeological scanning workflows.", definition: "A sequential classification system with defined stages: 'Raw' (unprocessed scan data), 'Aligned' (multiple scans registered together), 'Cleaned' (noise and artifacts removed), 'Meshed' (point cloud converted to polygon mesh), and 'Textured' (surface textures applied to mesh). Each stage represents a discrete processing milestone.", source_file: "archeology_kb.jsonl", source_line: 28, source_id: 27, search_text: "FlowStage (Processing Stage) value_illustration Illustrates the progression of data processing in archaeological scanning workflows. A sequential classification system with defined stages: 'Raw' (unprocessed scan data), 'Aligned' (multiple scans registered together), 'Cleaned' (noise and artifacts removed), 'Meshed' (point cloud converted to polygon mesh), and 'Textured' (surface textures applied to mesh). Each stage represents a discrete processing milestone."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:28"}) SET n = {id: "archeology:28", name: "LogMethod (Registration Method)", type: "value_illustration", description: "Illustrates different scan registration methodologies in archaeological documentation.", definition: "A categorization of alignment techniques with specific methodologies: 'ICP' (Iterative Closest Point algorithm for point cloud alignment), 'Target-based' (alignment using physical reference markers), 'Hybrid' (combination of automatic and manual alignment), and 'SLAM' (Simultaneous Localization and Mapping for real-time registration). Each method has distinct accuracy characteristics and use cases.", source_file: "archeology_kb.jsonl", source_line: 29, source_id: 28, search_text: "LogMethod (Registration Method) value_illustration Illustrates different scan registration methodologies in archaeological documentation. A categorization of alignment techniques with specific methodologies: 'ICP' (Iterative Closest Point algorithm for point cloud alignment), 'Target-based' (alignment using physical reference markers), 'Hybrid' (combination of automatic and manual alignment), and 'SLAM' (Simultaneous Localization and Mapping for real-time registration). Each method has distinct accuracy characteristics and use cases."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:29"}) SET n = {id: "archeology:29", name: "GuessDate (Estimated Dating)", type: "value_illustration", description: "Illustrates dating conventions in archaeological classification for chronological placement.", definition: "Values like '3500-3000 BCE', '1st c. CE', or 'ca. 1450 CE' represent estimated chronological placement based on excavation findings. Precision varies from specific years to century-level estimates depending on available evidence and dating methodologies employed.", source_file: "archeology_kb.jsonl", source_line: 30, source_id: 29, search_text: "GuessDate (Estimated Dating) value_illustration Illustrates dating conventions in archaeological classification for chronological placement. Values like '3500-3000 BCE', '1st c. CE', or 'ca. 1450 CE' represent estimated chronological placement based on excavation findings. Precision varies from specific years to century-level estimates depending on available evidence and dating methodologies employed."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:30"}) SET n = {id: "archeology:30", name: "Scan Time Efficiency (STE)", type: "calculation_knowledge", description: "Measures how efficiently scanning time was used relative to data quality and completeness metrics.", definition: "STE = \\frac{SQS \\times \\sqrt{CoverPct}}{SpanMin \\times \\sqrt{ScanCount}}, \\text{ where SQS is the Scan Quality Score and higher STE values indicate more efficient use of scanning time relative to coverage achieved.}", source_file: "archeology_kb.jsonl", source_line: 31, source_id: 30, search_text: "Scan Time Efficiency (STE) calculation_knowledge Measures how efficiently scanning time was used relative to data quality and completeness metrics. STE = \\frac{SQS \\times \\sqrt{CoverPct}}{SpanMin \\times \\sqrt{ScanCount}}, \\text{ where SQS is the Scan Quality Score and higher STE values indicate more efficient use of scanning time relative to coverage achieved.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:31"}) SET n = {id: "archeology:31", name: "Environmental Impact Factor (EIF)", type: "calculation_knowledge", description: "Quantifies how environmental conditions affected scan quality using statistical correlation analysis.", definition: "EIF = \\frac{SQS}{\\text{ESI} + 10} \\times 100, \\text{ where SQS is the Scan Quality Score and ESI is the Environmental Suitability Index. Values closer to 100 indicate minimal environmental interference with data acquisition.}", source_file: "archeology_kb.jsonl", source_line: 32, source_id: 31, search_text: "Environmental Impact Factor (EIF) calculation_knowledge Quantifies how environmental conditions affected scan quality using statistical correlation analysis. EIF = \\frac{SQS}{\\text{ESI} + 10} \\times 100, \\text{ where SQS is the Scan Quality Score and ESI is the Environmental Suitability Index. Values closer to 100 indicate minimal environmental interference with data acquisition.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:32"}) SET n = {id: "archeology:32", name: "Feature Extraction Efficiency (FEE)", type: "calculation_knowledge", description: "Measures the efficiency of feature identification in scan data relative to point cloud density and complexity.", definition: "FEE = \\frac{TraitCount + ArtiCount}{PCDR \\times \\sqrt{CloudDense}} \\times 10^3, \\text{ where PCDR is the Point Cloud Density Ratio and higher values indicate more effective feature extraction from point cloud data relative to spatial distribution efficiency.}", source_file: "archeology_kb.jsonl", source_line: 33, source_id: 32, search_text: "Feature Extraction Efficiency (FEE) calculation_knowledge Measures the efficiency of feature identification in scan data relative to point cloud density and complexity. FEE = \\frac{TraitCount + ArtiCount}{PCDR \\times \\sqrt{CloudDense}} \\times 10^3, \\text{ where PCDR is the Point Cloud Density Ratio and higher values indicate more effective feature extraction from point cloud data relative to spatial distribution efficiency.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:33"}) SET n = {id: "archeology:33", name: "Registration Accuracy Ratio (RAR)", type: "calculation_knowledge", description: "Evaluates registration accuracy relative to scan resolution using propagation of uncertainty principles.", definition: "RAR = \\frac{ScanResolMm}{LogAccuMm \\times \\sqrt{1 + \\frac{ErrValMm}{LogAccuMm}}}, \\text{ where values > 1 indicate registration accuracy exceeds scan resolution, a desirable outcome for precise spatial analysis.}", source_file: "archeology_kb.jsonl", source_line: 34, source_id: 33, search_text: "Registration Accuracy Ratio (RAR) calculation_knowledge Evaluates registration accuracy relative to scan resolution using propagation of uncertainty principles. RAR = \\frac{ScanResolMm}{LogAccuMm \\times \\sqrt{1 + \\frac{ErrValMm}{LogAccuMm}}}, \\text{ where values > 1 indicate registration accuracy exceeds scan resolution, a desirable outcome for precise spatial analysis.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:34"}) SET n = {id: "archeology:34", name: "Spatial Density Index (SDI)", type: "calculation_knowledge", description: "Assesses point cloud density relative to site dimensions for spatial sampling adequacy.", definition: "SDI = \\frac{TotalPts}{AreaM2 \\times 10^4} \\times \\left(\\frac{PointDense}{CloudDense}\\right)^{0.5}", source_file: "archeology_kb.jsonl", source_line: 35, source_id: 34, search_text: "Spatial Density Index (SDI) calculation_knowledge Assesses point cloud density relative to site dimensions for spatial sampling adequacy. SDI = \\frac{TotalPts}{AreaM2 \\times 10^4} \\times \\left(\\frac{PointDense}{CloudDense}\\right)^{0.5}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:35"}) SET n = {id: "archeology:35", name: "Conservation Priority Index (CPI)", type: "calculation_knowledge", description: "Quantifies the urgency of conservation efforts based on site condition, historical significance and structural stability.", definition: "CPI = \\begin{cases} 100 - PS + AF \\times \\left(1 + \\frac{TS}{10}\\right), & \\text{if in a Degradation Risk Zone} \\\\ 50 - PS + AF \\times \\left(1 + \\frac{TS}{20}\\right), & \\text{otherwise} \\end{cases}, \\text{ where PS is 0-100 based on PresStat condition ('Excellent'=10, 'Good'=30, 'Fair'=50, 'Poor'=70, 'Critical'=90), AF is approximate age in millennia derived from GuessDate, and TS is 0-10 based on TypeSite rarity.}", source_file: "archeology_kb.jsonl", source_line: 36, source_id: 35, search_text: "Conservation Priority Index (CPI) calculation_knowledge Quantifies the urgency of conservation efforts based on site condition, historical significance and structural stability. CPI = \\begin{cases} 100 - PS + AF \\times \\left(1 + \\frac{TS}{10}\\right), & \\text{if in a Degradation Risk Zone} \\\\ 50 - PS + AF \\times \\left(1 + \\frac{TS}{20}\\right), & \\text{otherwise} \\end{cases}, \\text{ where PS is 0-100 based on PresStat condition ('Excellent'=10, 'Good'=30, 'Fair'=50, 'Poor'=70, 'Critical'=90), AF is approximate age in millennia derived from GuessDate, and TS is 0-10 based on TypeSite rarity.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:36"}) SET n = {id: "archeology:36", name: "Mesh-to-Point Ratio (MPR)", type: "calculation_knowledge", description: "Evaluates the efficiency of mesh generation from point cloud data for optimal decimation determination.", definition: "MPR = \\frac{FacetVerts}{TotalPts} \\times 100 \\times \\left(\\frac{MCR}{10}\\right)^{0.3}, \\text{ where MCR is the Mesh Complexity Ratio and values around 25-30 indicate optimal decimation for archaeological purposes with appropriate feature preservation.}", source_file: "archeology_kb.jsonl", source_line: 37, source_id: 36, search_text: "Mesh-to-Point Ratio (MPR) calculation_knowledge Evaluates the efficiency of mesh generation from point cloud data for optimal decimation determination. MPR = \\frac{FacetVerts}{TotalPts} \\times 100 \\times \\left(\\frac{MCR}{10}\\right)^{0.3}, \\text{ where MCR is the Mesh Complexity Ratio and values around 25-30 indicate optimal decimation for archaeological purposes with appropriate feature preservation.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:37"}) SET n = {id: "archeology:37", name: "Processing Resource Utilization (PRU)", type: "calculation_knowledge", description: "Measures the efficiency of computing resource utilization during scan processing relative to data complexity.", definition: "PRU = \\frac{FlowHrs \\times (ProcCPU + ProcGPU) / 2}{GBSize \\times 10 \\times \\log_{10}(FacetVerts + 10^4)}, \\text{ where lower values indicate more efficient use of computing resources relative to mesh complexity.}", source_file: "archeology_kb.jsonl", source_line: 38, source_id: 37, search_text: "Processing Resource Utilization (PRU) calculation_knowledge Measures the efficiency of computing resource utilization during scan processing relative to data complexity. PRU = \\frac{FlowHrs \\times (ProcCPU + ProcGPU) / 2}{GBSize \\times 10 \\times \\log_{10}(FacetVerts + 10^4)}, \\text{ where lower values indicate more efficient use of computing resources relative to mesh complexity.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:38"}) SET n = {id: "archeology:38", name: "Digital Preservation Quality (DPQ)", type: "calculation_knowledge", description: "Comprehensive metric for evaluating digital preservation quality for archaeological sites with weighted quality factors.", definition: "DPQ = (0.3 \\times ADC) + (0.3 \\times MFS) + (0.2 \\times RAR) + (0.2 \\times SCE) - 2 \\times \\sqrt{\\frac{ErrValMm}{ScanResolMm}}, \\text{ where ADC is Archaeological Documentation Completeness, MFS is Model Fidelity Score, RAR is Registration Accuracy Ratio, and SCE is Scan Coverage Effectiveness.}", source_file: "archeology_kb.jsonl", source_line: 39, source_id: 38, search_text: "Digital Preservation Quality (DPQ) calculation_knowledge Comprehensive metric for evaluating digital preservation quality for archaeological sites with weighted quality factors. DPQ = (0.3 \\times ADC) + (0.3 \\times MFS) + (0.2 \\times RAR) + (0.2 \\times SCE) - 2 \\times \\sqrt{\\frac{ErrValMm}{ScanResolMm}}, \\text{ where ADC is Archaeological Documentation Completeness, MFS is Model Fidelity Score, RAR is Registration Accuracy Ratio, and SCE is Scan Coverage Effectiveness.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:39"}) SET n = {id: "archeology:39", name: "Equipment Effectiveness Ratio (EER)", type: "calculation_knowledge", description: "Evaluates how effectively equipment was utilized based on power consumption and scan quality relative to equipment capability.", definition: "EER = \\frac{SQS \\times EquipStatus\\_value}{PowerLevel \\times (101 - EquipAge\\_days) / 365} \\times 25, \\text{ where SQS is the Scan Quality Score, EquipStatus_value is 1.0 for 'Excellent' to 0.2 for 'Poor', and EquipAge_days is days since EquipTune, with higher values indicating more efficient use of equipment relative to condition.}", source_file: "archeology_kb.jsonl", source_line: 40, source_id: 39, search_text: "Equipment Effectiveness Ratio (EER) calculation_knowledge Evaluates how effectively equipment was utilized based on power consumption and scan quality relative to equipment capability. EER = \\frac{SQS \\times EquipStatus\\_value}{PowerLevel \\times (101 - EquipAge\\_days) / 365} \\times 25, \\text{ where SQS is the Scan Quality Score, EquipStatus_value is 1.0 for 'Excellent' to 0.2 for 'Poor', and EquipAge_days is days since EquipTune, with higher values indicating more efficient use of equipment relative to condition.}"};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:40"}) SET n = {id: "archeology:40", name: "Spatially Complex Site", type: "domain_knowledge", description: "Defines sites with complex spatial characteristics requiring specialized scanning approaches based on dimensional analysis.", definition: "A site with AreaM2 > 100 and SDI > 50, where SDI is the Spatial Density Index, requiring strategic planning for comprehensive documentation with multiple scanning stations and methodologies to capture complex spatial relationships.", source_file: "archeology_kb.jsonl", source_line: 41, source_id: 40, search_text: "Spatially Complex Site domain_knowledge Defines sites with complex spatial characteristics requiring specialized scanning approaches based on dimensional analysis. A site with AreaM2 > 100 and SDI > 50, where SDI is the Spatial Density Index, requiring strategic planning for comprehensive documentation with multiple scanning stations and methodologies to capture complex spatial relationships."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:41"}) SET n = {id: "archeology:41", name: "Texture-Critical Artifact", type: "domain_knowledge", description: "Identifies artifacts where texture documentation is critical for analysis based on surface morphology characteristics.", definition: "Features with TextureStudy containing 'Detailed' or 'Critical' and TDI > 8.0, where TDI is the Texture Density Index, requiring specialized imaging techniques such as photometric stereo or multi-spectral imaging for complete surface characterization.", source_file: "archeology_kb.jsonl", source_line: 42, source_id: 41, search_text: "Texture-Critical Artifact domain_knowledge Identifies artifacts where texture documentation is critical for analysis based on surface morphology characteristics. Features with TextureStudy containing 'Detailed' or 'Critical' and TDI > 8.0, where TDI is the Texture Density Index, requiring specialized imaging techniques such as photometric stereo or multi-spectral imaging for complete surface characterization."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:42"}) SET n = {id: "archeology:42", name: "Conservation Emergency", type: "domain_knowledge", description: "Identifies sites requiring immediate conservation intervention based on multiple risk factors and structural assessment.", definition: "A site that is in a Degradation Risk Zone with CPI > 75, where CPI is the Conservation Priority Index, requiring immediate protective measures and priority documentation with at least Premium Quality Scans before any intervention to establish baseline condition.", source_file: "archeology_kb.jsonl", source_line: 43, source_id: 42, search_text: "Conservation Emergency domain_knowledge Identifies sites requiring immediate conservation intervention based on multiple risk factors and structural assessment. A site that is in a Degradation Risk Zone with CPI > 75, where CPI is the Conservation Priority Index, requiring immediate protective measures and priority documentation with at least Premium Quality Scans before any intervention to establish baseline condition."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:43"}) SET n = {id: "archeology:43", name: "Processing Optimized Workflow", type: "domain_knowledge", description: "Defines optimized processing workflows balancing quality and resource use through benchmarked performance metrics.", definition: "A processing workflow with PRU < 5.0 while maintaining MFS > 7.0, where PRU is Processing Resource Utilization and MFS is Model Fidelity Score, representing an efficient balance of resource use and output quality through optimized algorithm selection and hardware allocation.", source_file: "archeology_kb.jsonl", source_line: 44, source_id: 43, search_text: "Processing Optimized Workflow domain_knowledge Defines optimized processing workflows balancing quality and resource use through benchmarked performance metrics. A processing workflow with PRU < 5.0 while maintaining MFS > 7.0, where PRU is Processing Resource Utilization and MFS is Model Fidelity Score, representing an efficient balance of resource use and output quality through optimized algorithm selection and hardware allocation."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:44"}) SET n = {id: "archeology:44", name: "Registration Confidence Level", type: "domain_knowledge", description: "Classification system for registration confidence based on multiple factors and error propagation analysis.", definition: "A classification where 'High Confidence' registrations have RAR > 1.5 and LogMethod containing 'Target', where RAR is Registration Accuracy Ratio, 'Medium Confidence' have RAR between 1.0-1.5, and 'Low Confidence' have RAR < 1.0, determining appropriate use cases for spatial analysis and interpretive visualization.", source_file: "archeology_kb.jsonl", source_line: 45, source_id: 44, search_text: "Registration Confidence Level domain_knowledge Classification system for registration confidence based on multiple factors and error propagation analysis. A classification where 'High Confidence' registrations have RAR > 1.5 and LogMethod containing 'Target', where RAR is Registration Accuracy Ratio, 'Medium Confidence' have RAR between 1.0-1.5, and 'Low Confidence' have RAR < 1.0, determining appropriate use cases for spatial analysis and interpretive visualization."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:45"}) SET n = {id: "archeology:45", name: "Environmental Challenge Scan", type: "domain_knowledge", description: "Identifies scans conducted under challenging environmental conditions requiring expertise and specialized equipment adaptation.", definition: "A scan with EIF > 120, where EIF is Environmental Impact Factor, indicating successful data capture despite suboptimal environmental conditions through adaptive scanning methodologies and operator expertise in field condition compensation.", source_file: "archeology_kb.jsonl", source_line: 46, source_id: 45, search_text: "Environmental Challenge Scan domain_knowledge Identifies scans conducted under challenging environmental conditions requiring expertise and specialized equipment adaptation. A scan with EIF > 120, where EIF is Environmental Impact Factor, indicating successful data capture despite suboptimal environmental conditions through adaptive scanning methodologies and operator expertise in field condition compensation."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:46"}) SET n = {id: "archeology:46", name: "High Temporal Value Site", type: "domain_knowledge", description: "Identifies sites with exceptional historical significance based on age and context for prioritized research attention.", definition: "A site with GuessDate containing dates before 500 CE and CPI > 60, where CPI is Conservation Priority Index, representing locations of exceptional chronological significance requiring specialized documentation protocols to capture temporally significant features.", source_file: "archeology_kb.jsonl", source_line: 47, source_id: 46, search_text: "High Temporal Value Site domain_knowledge Identifies sites with exceptional historical significance based on age and context for prioritized research attention. A site with GuessDate containing dates before 500 CE and CPI > 60, where CPI is Conservation Priority Index, representing locations of exceptional chronological significance requiring specialized documentation protocols to capture temporally significant features."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:47"}) SET n = {id: "archeology:47", name: "Resource-Intensive Model", type: "domain_knowledge", description: "Identifies 3D models requiring substantial computing resources for visualization and analysis based on complexity metrics.", definition: "A model with FacetFaces > 2,000,000 and MPR < 15, where MPR is Mesh-to-Point Ratio, requiring specialized hardware for effective interaction and analytical software optimized for large-scale geometric processing with hierarchical level-of-detail implementation.", source_file: "archeology_kb.jsonl", source_line: 48, source_id: 47, search_text: "Resource-Intensive Model domain_knowledge Identifies 3D models requiring substantial computing resources for visualization and analysis based on complexity metrics. A model with FacetFaces > 2,000,000 and MPR < 15, where MPR is Mesh-to-Point Ratio, requiring specialized hardware for effective interaction and analytical software optimized for large-scale geometric processing with hierarchical level-of-detail implementation."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:48"}) SET n = {id: "archeology:48", name: "Multi-Phase Documentation Project", type: "domain_knowledge", description: "Defines complex archaeological projects requiring multiple scanning phases with integrated documentation strategy.", definition: "A project with multiple scans where the total ADC < 70 for individual scans but DPQ > 80 when combined, where ADC is Archaeological Documentation Completeness and DPQ is Digital Preservation Quality, indicating comprehensive documentation achieved through multiple phases with coherent registration strategy for holistic interpretation.", source_file: "archeology_kb.jsonl", source_line: 49, source_id: 48, search_text: "Multi-Phase Documentation Project domain_knowledge Defines complex archaeological projects requiring multiple scanning phases with integrated documentation strategy. A project with multiple scans where the total ADC < 70 for individual scans but DPQ > 80 when combined, where ADC is Archaeological Documentation Completeness and DPQ is Digital Preservation Quality, indicating comprehensive documentation achieved through multiple phases with coherent registration strategy for holistic interpretation."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:49"}) SET n = {id: "archeology:49", name: "Equipment Optimization Opportunity", type: "domain_knowledge", description: "Identifies scenarios where equipment settings could be optimized for better results based on performance analysis.", definition: "Scanning scenarios where EER < 30 but ESI > 80, where EER is Equipment Effectiveness Ratio and ESI is Environmental Suitability Index, indicating potential for improved equipment utilization in favorable conditions through calibration adjustment and scanning parameter optimization.", source_file: "archeology_kb.jsonl", source_line: 50, source_id: 49, search_text: "Equipment Optimization Opportunity domain_knowledge Identifies scenarios where equipment settings could be optimized for better results based on performance analysis. Scanning scenarios where EER < 30 but ESI > 80, where EER is Equipment Effectiveness Ratio and ESI is Environmental Suitability Index, indicating potential for improved equipment utilization in favorable conditions through calibration adjustment and scanning parameter optimization."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:50"}) SET n = {id: "archeology:50", name: "Environmental Condition Classification System (ECCS)", type: "domain_knowledge", description: "A comprehensive classification system for archaeological site environments based on their suitability for scanning operations.", definition: "A four-tier classification where 'Optimal Scanning Conditions' have ESI > 85, 'Good Scanning Conditions' have ESI between 70-85, 'Acceptable Scanning Conditions' have ESI between 50-70, and 'Challenging Scanning Conditions' have ESI < 50. This classification guides scanning schedule planning and equipment selection to maximize data quality.", source_file: "archeology_kb.jsonl", source_line: 51, source_id: 50, search_text: "Environmental Condition Classification System (ECCS) domain_knowledge A comprehensive classification system for archaeological site environments based on their suitability for scanning operations. A four-tier classification where 'Optimal Scanning Conditions' have ESI > 85, 'Good Scanning Conditions' have ESI between 70-85, 'Acceptable Scanning Conditions' have ESI between 50-70, and 'Challenging Scanning Conditions' have ESI < 50. This classification guides scanning schedule planning and equipment selection to maximize data quality."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:51"}) SET n = {id: "archeology:51", name: "Workflow Efficiency Classification", type: "domain_knowledge", description: "A standardized categorization system for assessing processing workflow efficiency based on Processing Resource Utilization (PRU) values.", definition: "A three-tier classification where 'Optimized' workflows have PRU < 5.0 (highly efficient resource usage), 'Acceptable' workflows have PRU between 5.0-10.0 (reasonable efficiency), and 'Needs Optimization' workflows have PRU > 10.0 (inefficient resource usage requiring intervention). This classification guides processing workflow improvements and resource allocation decisions.", source_file: "archeology_kb.jsonl", source_line: 52, source_id: 51, search_text: "Workflow Efficiency Classification domain_knowledge A standardized categorization system for assessing processing workflow efficiency based on Processing Resource Utilization (PRU) values. A three-tier classification where 'Optimized' workflows have PRU < 5.0 (highly efficient resource usage), 'Acceptable' workflows have PRU between 5.0-10.0 (reasonable efficiency), and 'Needs Optimization' workflows have PRU > 10.0 (inefficient resource usage requiring intervention). This classification guides processing workflow improvements and resource allocation decisions."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:52"}) SET n = {id: "archeology:52", name: "Risk Zone Category", type: "domain_knowledge", description: "Classification system that evaluates archaeological sites for degradation risk based on preservation status and structural condition.", definition: "Categorizes archaeological sites into two main groups: 'Degradation Risk Zone' and 'Not in Risk Zone'. 'Not in Risk Zone' means that the site is not in a Degradation Risk Zone.", source_file: "archeology_kb.jsonl", source_line: 53, source_id: 52, search_text: "Risk Zone Category domain_knowledge Classification system that evaluates archaeological sites for degradation risk based on preservation status and structural condition. Categorizes archaeological sites into two main groups: 'Degradation Risk Zone' and 'Not in Risk Zone'. 'Not in Risk Zone' means that the site is not in a Degradation Risk Zone."};
MERGE (n:Knowledge:SemanticSearch {id: "archeology:53"}) SET n = {id: "archeology:53", name: "Mesh Quality Classification", type: "domain_knowledge", description: "A standardized system for categorizing archaeological site documentation based on the presence and quality of 3D mesh models.", definition: "A three-tier classification where 'Has High-Fidelity Meshes' indicates sites with at least one mesh meeting high-fidelity criteria, 'Standard Mesh Quality' indicates sites with meshes that don't meet high-fidelity standards, and 'No Mesh Data' indicates sites lacking 3D mesh documentation entirely. This classification helps prioritize additional documentation efforts and determines appropriate analytical approaches for different sites.", source_file: "archeology_kb.jsonl", source_line: 54, source_id: 53, search_text: "Mesh Quality Classification domain_knowledge A standardized system for categorizing archaeological site documentation based on the presence and quality of 3D mesh models. A three-tier classification where 'Has High-Fidelity Meshes' indicates sites with at least one mesh meeting high-fidelity criteria, 'Standard Mesh Quality' indicates sites with meshes that don't meet high-fidelity standards, and 'No Mesh Data' indicates sites lacking 3D mesh documentation entirely. This classification helps prioritize additional documentation efforts and determines appropriate analytical approaches for different sites."};
MATCH (d:Database {id: "credit"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "credit:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "credit:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "credit:" AND NOT stale.id IN ["credit:0", "credit:1", "credit:2", "credit:3", "credit:4", "credit:5", "credit:6", "credit:7", "credit:8", "credit:9", "credit:10", "credit:11", "credit:12", "credit:13", "credit:14", "credit:15", "credit:16", "credit:17", "credit:18", "credit:19", "credit:20", "credit:21", "credit:22", "credit:23", "credit:24", "credit:25", "credit:26", "credit:27", "credit:28", "credit:29", "credit:30", "credit:31", "credit:32", "credit:33", "credit:34", "credit:35", "credit:36", "credit:37", "credit:38", "credit:39", "credit:40", "credit:41", "credit:42", "credit:43", "credit:44", "credit:45", "credit:46", "credit:47", "credit:48", "credit:49", "credit:50", "credit:51"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "credit:0"}) SET n = {id: "credit:0", name: "Debt-to-Income Ratio (DTI)", type: "calculation_knowledge", description: "Calculates the proportion of a customer's monthly income that goes toward debt payments.", definition: "DTI = \\frac{\\text{Total Monthly Debt Payments}}{\\text{Monthly Income}} = debincratio", source_file: "credit_kb.jsonl", source_line: 1, source_id: 0, search_text: "Debt-to-Income Ratio (DTI) calculation_knowledge Calculates the proportion of a customer's monthly income that goes toward debt payments. DTI = \\frac{\\text{Total Monthly Debt Payments}}{\\text{Monthly Income}} = debincratio"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:1"}) SET n = {id: "credit:1", name: "Credit Utilization Ratio (CUR)", type: "calculation_knowledge", description: "Measures how much of available credit a customer is currently using.", definition: "CUR = \\frac{\\text{Total Credit Used}}{\\text{Total Credit Limit}} = credutil", source_file: "credit_kb.jsonl", source_line: 2, source_id: 1, search_text: "Credit Utilization Ratio (CUR) calculation_knowledge Measures how much of available credit a customer is currently using. CUR = \\frac{\\text{Total Credit Used}}{\\text{Total Credit Limit}} = credutil"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:2"}) SET n = {id: "credit:2", name: "Loan-to-Value Ratio (LTV)", type: "calculation_knowledge", description: "Calculates the ratio of loan amount to the value of the asset securing the loan.", definition: "LTV = \\frac{\\text{Mortgage Balance}}{\\text{Property Value}} = \\frac{\\text{propfinancialdata.mortgagebits.mortbalance}}{\\text{propfinancialdata.propvalue}}", source_file: "credit_kb.jsonl", source_line: 3, source_id: 2, search_text: "Loan-to-Value Ratio (LTV) calculation_knowledge Calculates the ratio of loan amount to the value of the asset securing the loan. LTV = \\frac{\\text{Mortgage Balance}}{\\text{Property Value}} = \\frac{\\text{propfinancialdata.mortgagebits.mortbalance}}{\\text{propfinancialdata.propvalue}}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:3"}) SET n = {id: "credit:3", name: "Customer Lifetime Value (CLV)", type: "calculation_knowledge", description: "Measures the total worth of a customer to the financial institution over the entire relationship.", definition: "CLV = custlifeval, which factors in product usage, tenure, profitability, and expected future transactions.", source_file: "credit_kb.jsonl", source_line: 4, source_id: 3, search_text: "Customer Lifetime Value (CLV) calculation_knowledge Measures the total worth of a customer to the financial institution over the entire relationship. CLV = custlifeval, which factors in product usage, tenure, profitability, and expected future transactions."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:4"}) SET n = {id: "credit:4", name: "Net Worth", type: "calculation_knowledge", description: "Calculates the financial value of a customer by subtracting liabilities from assets.", definition: "Net Worth = \\text{Total Assets} - \\text{Total Liabilities} = totassets - totliabs = networth", source_file: "credit_kb.jsonl", source_line: 5, source_id: 4, search_text: "Net Worth calculation_knowledge Calculates the financial value of a customer by subtracting liabilities from assets. Net Worth = \\text{Total Assets} - \\text{Total Liabilities} = totassets - totliabs = networth"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:5"}) SET n = {id: "credit:5", name: "Credit Health Score (CHS)", type: "calculation_knowledge", description: "Composite score measuring overall credit wellness based on multiple factors.", definition: "CHS = 0.4 × \\frac{credscore}{850} + 0.2 × (1 - credutil) + 0.2 × (1 - debincratio) + 0.1 × \\frac{credageyrs}{20} + 0.1 × (1 - \\frac{delinqcount + latepaycount + choffs + bankr}{10}), \\text{where each component is capped at 1.0}", source_file: "credit_kb.jsonl", source_line: 6, source_id: 5, search_text: "Credit Health Score (CHS) calculation_knowledge Composite score measuring overall credit wellness based on multiple factors. CHS = 0.4 × \\frac{credscore}{850} + 0.2 × (1 - credutil) + 0.2 × (1 - debincratio) + 0.1 × \\frac{credageyrs}{20} + 0.1 × (1 - \\frac{delinqcount + latepaycount + choffs + bankr}{10}), \\text{where each component is capped at 1.0}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:6"}) SET n = {id: "credit:6", name: "Financial Stability Index (FSI)", type: "calculation_knowledge", description: "Measures a customer's overall financial stability combining income, savings, and debt factors.", definition: "FSI = 0.3 × (1 - debincratio) + 0.3 × \\frac{liqassets}{mthincome × 6} + 0.2 × \\frac{bankaccbal}{mthincome × 3} + 0.2 × \\frac{savamount}{mthincome × 12}, \\text{where each component is capped at 1.0}", source_file: "credit_kb.jsonl", source_line: 7, source_id: 6, search_text: "Financial Stability Index (FSI) calculation_knowledge Measures a customer's overall financial stability combining income, savings, and debt factors. FSI = 0.3 × (1 - debincratio) + 0.3 × \\frac{liqassets}{mthincome × 6} + 0.2 × \\frac{bankaccbal}{mthincome × 3} + 0.2 × \\frac{savamount}{mthincome × 12}, \\text{where each component is capped at 1.0}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:7"}) SET n = {id: "credit:7", name: "Customer Engagement Score (CES)", type: "calculation_knowledge", description: "Quantifies how actively a customer uses bank products and services.", definition: "CES = 0.4 × produsescore + 0.3 × chanusescore + 0.2 × bankrelscore + 0.1 × \\frac{custservint}{10}, \\text{where each component is capped at 1.0}", source_file: "credit_kb.jsonl", source_line: 8, source_id: 7, search_text: "Customer Engagement Score (CES) calculation_knowledge Quantifies how actively a customer uses bank products and services. CES = 0.4 × produsescore + 0.3 × chanusescore + 0.2 × bankrelscore + 0.1 × \\frac{custservint}{10}, \\text{where each component is capped at 1.0}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:8"}) SET n = {id: "credit:8", name: "Risk-Adjusted Return (RAR)", type: "calculation_knowledge", description: "Measures the profitability of a customer relationship adjusted for credit risk.", definition: "RAR = profitscore × (1 - \\frac{risklev}{4}), \\text{where risklev is converted to a numeric scale: Low=1, Medium=2, High=3, Very High=4}", source_file: "credit_kb.jsonl", source_line: 9, source_id: 8, search_text: "Risk-Adjusted Return (RAR) calculation_knowledge Measures the profitability of a customer relationship adjusted for credit risk. RAR = profitscore × (1 - \\frac{risklev}{4}), \\text{where risklev is converted to a numeric scale: Low=1, Medium=2, High=3, Very High=4}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:9"}) SET n = {id: "credit:9", name: "Account Health Index (AHI)", type: "calculation_knowledge", description: "Composite measure of account quality considering age, mix, and payment history.", definition: "AHI = 0.4 × \\frac{avgaccage}{10} + 0.3 × accmixscore + 0.3 × payconsist, \\text{where each component is capped at 1.0}", source_file: "credit_kb.jsonl", source_line: 10, source_id: 9, search_text: "Account Health Index (AHI) calculation_knowledge Composite measure of account quality considering age, mix, and payment history. AHI = 0.4 × \\frac{avgaccage}{10} + 0.3 × accmixscore + 0.3 × payconsist, \\text{where each component is capped at 1.0}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:10"}) SET n = {id: "credit:10", name: "Prime Customer", type: "domain_knowledge", description: "Identifies customers with excellent creditworthiness and financial stability.", definition: "A customer with credscore > 720, defhist of 'Excellent' or 'Good', and risklev of 'Low'.", source_file: "credit_kb.jsonl", source_line: 11, source_id: 10, search_text: "Prime Customer domain_knowledge Identifies customers with excellent creditworthiness and financial stability. A customer with credscore > 720, defhist of 'Excellent' or 'Good', and risklev of 'Low'."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:11"}) SET n = {id: "credit:11", name: "Financially Vulnerable", type: "domain_knowledge", description: "Identifies customers who may be financially stressed or at risk.", definition: "A customer with debincratio > 0.5, liqassets < mthincome × 3, and at least one of: delinqcount > 0, latepaycount > 1, or ovrfreq of 'Frequent'.", source_file: "credit_kb.jsonl", source_line: 12, source_id: 11, search_text: "Financially Vulnerable domain_knowledge Identifies customers who may be financially stressed or at risk. A customer with debincratio > 0.5, liqassets < mthincome × 3, and at least one of: delinqcount > 0, latepaycount > 1, or ovrfreq of 'Frequent'."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:12"}) SET n = {id: "credit:12", name: "High-Value Customer", type: "domain_knowledge", description: "Identifies customers with significant value to the institution.", definition: "A customer with custlifeval in the top quartile, tenureyrs > 5, and crossratio > 0.5.", source_file: "credit_kb.jsonl", source_line: 13, source_id: 12, search_text: "High-Value Customer domain_knowledge Identifies customers with significant value to the institution. A customer with custlifeval in the top quartile, tenureyrs > 5, and crossratio > 0.5."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:13"}) SET n = {id: "credit:13", name: "Credit Builder", type: "domain_knowledge", description: "Identifies customers actively working to establish or improve credit.", definition: "A customer with credageyrs < 3, credinq > 2 in the past year, and recentbeh of 'Improving'.", source_file: "credit_kb.jsonl", source_line: 14, source_id: 13, search_text: "Credit Builder domain_knowledge Identifies customers actively working to establish or improve credit. A customer with credageyrs < 3, credinq > 2 in the past year, and recentbeh of 'Improving'."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:14"}) SET n = {id: "credit:14", name: "Digital First Customer", type: "domain_knowledge", description: "Identifies customers who primarily engage through digital channels.", definition: "A customer with chaninvdatablock.onlineuse of 'High' or chaninvdatablock.mobileuse of 'High', and chaninvdatablock.autopay of 'Yes'.", source_file: "credit_kb.jsonl", source_line: 15, source_id: 14, search_text: "Digital First Customer domain_knowledge Identifies customers who primarily engage through digital channels. A customer with chaninvdatablock.onlineuse of 'High' or chaninvdatablock.mobileuse of 'High', and chaninvdatablock.autopay of 'Yes'."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:15"}) SET n = {id: "credit:15", name: "Investment Focused", type: "domain_knowledge", description: "Identifies customers with significant investment activity and sophistication.", definition: "A customer with chaninvdatablock.invcluster.investport of 'Moderate' or 'Aggressive', chaninvdatablock.invcluster.investexp of 'Extensive', and investamt > 0.3 × totassets.", source_file: "credit_kb.jsonl", source_line: 16, source_id: 15, search_text: "Investment Focused domain_knowledge Identifies customers with significant investment activity and sophistication. A customer with chaninvdatablock.invcluster.investport of 'Moderate' or 'Aggressive', chaninvdatablock.invcluster.investexp of 'Extensive', and investamt > 0.3 × totassets."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:16"}) SET n = {id: "credit:16", name: "Revolving Credit Dependent", type: "domain_knowledge", description: "Identifies customers who heavily rely on revolving credit.", definition: "A customer with credutil > 0.7, cardcount > 2, and cardpayhist of 'Fair' or 'Poor'.", source_file: "credit_kb.jsonl", source_line: 17, source_id: 16, search_text: "Revolving Credit Dependent domain_knowledge Identifies customers who heavily rely on revolving credit. A customer with credutil > 0.7, cardcount > 2, and cardpayhist of 'Fair' or 'Poor'."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:17"}) SET n = {id: "credit:17", name: "Property Risk Exposure", type: "domain_knowledge", description: "Assesses risk related to a customer's property investment.", definition: "A customer with propfinancialdata.propown of 'Own', LTV > 0.8, and propfinancialdata.mortgagebits.mortpayhist of 'Fair' or 'Poor'.", source_file: "credit_kb.jsonl", source_line: 18, source_id: 17, search_text: "Property Risk Exposure domain_knowledge Assesses risk related to a customer's property investment. A customer with propfinancialdata.propown of 'Own', LTV > 0.8, and propfinancialdata.mortgagebits.mortpayhist of 'Fair' or 'Poor'."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:18"}) SET n = {id: "credit:18", name: "Frequent Credit Seeker", type: "domain_knowledge", description: "Identifies customers frequently seeking new credit.", definition: "A customer with hardinq > 3 in the past six months, seekbeh of 'High', and newaccage < 1.", source_file: "credit_kb.jsonl", source_line: 19, source_id: 18, search_text: "Frequent Credit Seeker domain_knowledge Identifies customers frequently seeking new credit. A customer with hardinq > 3 in the past six months, seekbeh of 'High', and newaccage < 1."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:19"}) SET n = {id: "credit:19", name: "Over-Extended", type: "domain_knowledge", description: "Identifies customers who are financially over-extended.", definition: "A customer with DTI > 0.43, CUR > 0.8, and at least one of: ovrfreq of 'Frequent', bouncecount > 0 in the past three months.", source_file: "credit_kb.jsonl", source_line: 20, source_id: 19, search_text: "Over-Extended domain_knowledge Identifies customers who are financially over-extended. A customer with DTI > 0.43, CUR > 0.8, and at least one of: ovrfreq of 'Frequent', bouncecount > 0 in the past three months."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:20"}) SET n = {id: "credit:20", name: "Credit Score Categories", type: "value_illustration", description: "Illustrates the meaning of different credit score ranges.", definition: "Credit scores (credscore) typically range from 300-850. 300-579: Poor, 580-669: Fair, 670-739: Good, 740-799: Very Good, 800-850: Excellent, Otherwise: Unknown. Higher scores indicate lower credit risk.", source_file: "credit_kb.jsonl", source_line: 21, source_id: 20, search_text: "Credit Score Categories value_illustration Illustrates the meaning of different credit score ranges. Credit scores (credscore) typically range from 300-850. 300-579: Poor, 580-669: Fair, 670-739: Good, 740-799: Very Good, 800-850: Excellent, Otherwise: Unknown. Higher scores indicate lower credit risk."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:21"}) SET n = {id: "credit:21", name: "Income Stability Score", type: "value_illustration", description: "Illustrates the meaning of income stability scores.", definition: "Income stability (incstabscore) ranges from 0-10. Scores below 3 indicate highly variable income, 3-6 indicates moderate stability, and above 6 indicates highly stable income sources.", source_file: "credit_kb.jsonl", source_line: 22, source_id: 21, search_text: "Income Stability Score value_illustration Illustrates the meaning of income stability scores. Income stability (incstabscore) ranges from 0-10. Scores below 3 indicate highly variable income, 3-6 indicates moderate stability, and above 6 indicates highly stable income sources."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:22"}) SET n = {id: "credit:22", name: "Debt-to-Income Ratio Interpretation", type: "value_illustration", description: "Illustrates what different debt-to-income ratios mean for lending decisions.", definition: "Debt-to-Income ratio (debincratio) ranges from 0-1 (or above). Below 0.36 is typically considered excellent, 0.36-0.43 is good, 0.43-0.50 is concerning, and above 0.50 is risky for new credit approval.", source_file: "credit_kb.jsonl", source_line: 23, source_id: 22, search_text: "Debt-to-Income Ratio Interpretation value_illustration Illustrates what different debt-to-income ratios mean for lending decisions. Debt-to-Income ratio (debincratio) ranges from 0-1 (or above). Below 0.36 is typically considered excellent, 0.36-0.43 is good, 0.43-0.50 is concerning, and above 0.50 is risky for new credit approval."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:23"}) SET n = {id: "credit:23", name: "Credit Utilization Impact", type: "value_illustration", description: "Illustrates how credit utilization affects credit scores.", definition: "Credit Utilization (credutil) ranges from 0-1 (or above). Utilization under 0.30 is optimal for credit scores, 0.30-0.50 has moderate negative impact, 0.50-0.70 has significant negative impact, and above 0.70 severely impacts credit scores.", source_file: "credit_kb.jsonl", source_line: 24, source_id: 23, search_text: "Credit Utilization Impact value_illustration Illustrates how credit utilization affects credit scores. Credit Utilization (credutil) ranges from 0-1 (or above). Utilization under 0.30 is optimal for credit scores, 0.30-0.50 has moderate negative impact, 0.50-0.70 has significant negative impact, and above 0.70 severely impacts credit scores."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:24"}) SET n = {id: "credit:24", name: "Loan-to-Value Ratio Significance", type: "value_illustration", description: "Illustrates what different LTV ratios mean for mortgage lending.", definition: "Loan-to-Value ratio (LTV) typically ranges from 0-1 (or above). Below 0.80 generally avoids private mortgage insurance requirements, 0.80-0.95 typically requires PMI, and above 0.95 indicates high leverage and increased lending risk.", source_file: "credit_kb.jsonl", source_line: 25, source_id: 24, search_text: "Loan-to-Value Ratio Significance value_illustration Illustrates what different LTV ratios mean for mortgage lending. Loan-to-Value ratio (LTV) typically ranges from 0-1 (or above). Below 0.80 generally avoids private mortgage insurance requirements, 0.80-0.95 typically requires PMI, and above 0.95 indicates high leverage and increased lending risk."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:25"}) SET n = {id: "credit:25", name: "Risk Level Classifications", type: "value_illustration", description: "Illustrates what different risk level classifications mean.", definition: "Risk level (risklev) values indicate likelihood of default or financial difficulty. 'Low' indicates minimal risk, 'Medium' indicates moderate risk requiring standard monitoring, 'High' indicates significant risk requiring enhanced monitoring, and 'Very High' indicates severe risk requiring active intervention.", source_file: "credit_kb.jsonl", source_line: 26, source_id: 25, search_text: "Risk Level Classifications value_illustration Illustrates what different risk level classifications mean. Risk level (risklev) values indicate likelihood of default or financial difficulty. 'Low' indicates minimal risk, 'Medium' indicates moderate risk requiring standard monitoring, 'High' indicates significant risk requiring enhanced monitoring, and 'Very High' indicates severe risk requiring active intervention."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:26"}) SET n = {id: "credit:26", name: "Payment History Quality", type: "value_illustration", description: "Illustrates what different payment history classifications indicate.", definition: "Payment history (defhist, mortpayhist, rentpayhist, cardpayhist, loanpayhist) classifications indicate reliability. 'Excellent' indicates no late payments, 'Good' indicates minimal late payments, 'Fair' indicates occasional missed payments, 'Poor' indicates regular missed payments, 'Current' indicates being up to date, and 'Past' indicates historical data.", source_file: "credit_kb.jsonl", source_line: 27, source_id: 26, search_text: "Payment History Quality value_illustration Illustrates what different payment history classifications indicate. Payment history (defhist, mortpayhist, rentpayhist, cardpayhist, loanpayhist) classifications indicate reliability. 'Excellent' indicates no late payments, 'Good' indicates minimal late payments, 'Fair' indicates occasional missed payments, 'Poor' indicates regular missed payments, 'Current' indicates being up to date, and 'Past' indicates historical data."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:27"}) SET n = {id: "credit:27", name: "Cross-Sell Ratio Meaning", type: "value_illustration", description: "Illustrates what different cross-sell ratio values indicate.", definition: "Cross-sell ratio (crossratio) ranges from 0-1. Values below 0.2 indicate minimal product relationships, 0.2-0.5 indicates moderate opportunity, and above 0.5 indicates strong existing relationship with high additional sales potential.", source_file: "credit_kb.jsonl", source_line: 28, source_id: 27, search_text: "Cross-Sell Ratio Meaning value_illustration Illustrates what different cross-sell ratio values indicate. Cross-sell ratio (crossratio) ranges from 0-1. Values below 0.2 indicate minimal product relationships, 0.2-0.5 indicates moderate opportunity, and above 0.5 indicates strong existing relationship with high additional sales potential."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:28"}) SET n = {id: "credit:28", name: "Account Mix Score Interpretation", type: "value_illustration", description: "Illustrates what different account mix scores represent.", definition: "Account mix score (accmixscore) ranges from 0-1. Higher scores indicate a healthy diversity of account types (revolving, installment, mortgage, etc.), which positively impacts credit scores and indicates financial sophistication.", source_file: "credit_kb.jsonl", source_line: 29, source_id: 28, search_text: "Account Mix Score Interpretation value_illustration Illustrates what different account mix scores represent. Account mix score (accmixscore) ranges from 0-1. Higher scores indicate a healthy diversity of account types (revolving, installment, mortgage, etc.), which positively impacts credit scores and indicates financial sophistication."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:29"}) SET n = {id: "credit:29", name: "Churn Rate Significance", type: "value_illustration", description: "Illustrates what different churn rate values indicate about customer retention risk.", definition: "Churn rate (churnrate) ranges from 0-1. Values below 0.1 indicate low attrition risk, 0.1-0.2 indicates moderate risk, 0.2-0.3 indicates high risk, and above 0.3 indicates severe risk of customer loss requiring immediate relationship management intervention.", source_file: "credit_kb.jsonl", source_line: 30, source_id: 29, search_text: "Churn Rate Significance value_illustration Illustrates what different churn rate values indicate about customer retention risk. Churn rate (churnrate) ranges from 0-1. Values below 0.1 indicate low attrition risk, 0.1-0.2 indicates moderate risk, 0.2-0.3 indicates high risk, and above 0.3 indicates severe risk of customer loss requiring immediate relationship management intervention."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:30"}) SET n = {id: "credit:30", name: "Total Debt Service Ratio (TDSR)", type: "calculation_knowledge", description: "Extended debt ratio that accounts for all financial obligations including housing costs.", definition: "TDSR = DTI + \\frac{\\text{Housing Costs}}{\\text{Monthly Income}}, \\text{where Housing Costs are determined by propfinancialdata and DTI is the Debt-to-Income Ratio}", source_file: "credit_kb.jsonl", source_line: 31, source_id: 30, search_text: "Total Debt Service Ratio (TDSR) calculation_knowledge Extended debt ratio that accounts for all financial obligations including housing costs. TDSR = DTI + \\frac{\\text{Housing Costs}}{\\text{Monthly Income}}, \\text{where Housing Costs are determined by propfinancialdata and DTI is the Debt-to-Income Ratio}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:31"}) SET n = {id: "credit:31", name: "Credit Quality Index (CQI)", type: "calculation_knowledge", description: "Comprehensive measure of overall credit quality incorporating credit score and utilization.", definition: "CQI = 0.6 × \\frac{credscore}{850} + 0.4 × (1 - CUR), \\text{where CUR is the Credit Utilization Ratio}", source_file: "credit_kb.jsonl", source_line: 32, source_id: 31, search_text: "Credit Quality Index (CQI) calculation_knowledge Comprehensive measure of overall credit quality incorporating credit score and utilization. CQI = 0.6 × \\frac{credscore}{850} + 0.4 × (1 - CUR), \\text{where CUR is the Credit Utilization Ratio}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:32"}) SET n = {id: "credit:32", name: "Housing Affordability Ratio (HAR)", type: "calculation_knowledge", description: "Measures the affordability of housing costs relative to income.", definition: "HAR = \\frac{\\text{Monthly Housing Payment}}{\\text{Monthly Income}} × 100\\%, \\text{where Monthly Housing Payment is derived from propfinancialdata and LTV calculations}", source_file: "credit_kb.jsonl", source_line: 33, source_id: 32, search_text: "Housing Affordability Ratio (HAR) calculation_knowledge Measures the affordability of housing costs relative to income. HAR = \\frac{\\text{Monthly Housing Payment}}{\\text{Monthly Income}} × 100\\%, \\text{where Monthly Housing Payment is derived from propfinancialdata and LTV calculations}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:33"}) SET n = {id: "credit:33", name: "Financial Vulnerability Score (FVS)", type: "calculation_knowledge", description: "Quantifies financial fragility by combining debt burden and savings adequacy.", definition: "FVS = 0.5 × DTI + 0.5 × (1 - \\frac{liqassets}{mthincome × 6}), \\text{where DTI is the Debt-to-Income Ratio and the second term measures emergency fund adequacy}", source_file: "credit_kb.jsonl", source_line: 34, source_id: 33, search_text: "Financial Vulnerability Score (FVS) calculation_knowledge Quantifies financial fragility by combining debt burden and savings adequacy. FVS = 0.5 × DTI + 0.5 × (1 - \\frac{liqassets}{mthincome × 6}), \\text{where DTI is the Debt-to-Income Ratio and the second term measures emergency fund adequacy}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:34"}) SET n = {id: "credit:34", name: "Customer Retention Risk (CRR)", type: "calculation_knowledge", description: "Calculates risk of customer attrition based on engagement and satisfaction metrics.", definition: "CRR = 0.4 × churnrate + 0.3 × (1 - CES) + 0.3 × \\frac{complainthist}{3}, \\text{where CES is the Customer Engagement Score and complainthist is converted to numeric (Low=1, Medium=2, High=3)}", source_file: "credit_kb.jsonl", source_line: 35, source_id: 34, search_text: "Customer Retention Risk (CRR) calculation_knowledge Calculates risk of customer attrition based on engagement and satisfaction metrics. CRR = 0.4 × churnrate + 0.3 × (1 - CES) + 0.3 × \\frac{complainthist}{3}, \\text{where CES is the Customer Engagement Score and complainthist is converted to numeric (Low=1, Medium=2, High=3)}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:35"}) SET n = {id: "credit:35", name: "Asset Liquidity Ratio (ALR)", type: "calculation_knowledge", description: "Measures the proportion of customer assets that can be quickly converted to cash.", definition: "ALR = \\frac{liqassets}{totassets} = \\frac{liqassets}{Net Worth + totliabs}, \\text{where Net Worth is the difference between assets and liabilities}", source_file: "credit_kb.jsonl", source_line: 36, source_id: 35, search_text: "Asset Liquidity Ratio (ALR) calculation_knowledge Measures the proportion of customer assets that can be quickly converted to cash. ALR = \\frac{liqassets}{totassets} = \\frac{liqassets}{Net Worth + totliabs}, \\text{where Net Worth is the difference between assets and liabilities}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:36"}) SET n = {id: "credit:36", name: "Credit Risk Intensity (CRI)", type: "calculation_knowledge", description: "Advanced measure of credit risk that incorporates payment history and account diversity.", definition: "CRI = 0.5 × (1 - \\frac{credscore}{850}) + 0.3 × \\frac{delinqcount + latepaycount + choffs}{10} + 0.2 × (1 - AHI), \\text{where AHI is the Account Health Index}", source_file: "credit_kb.jsonl", source_line: 37, source_id: 36, search_text: "Credit Risk Intensity (CRI) calculation_knowledge Advanced measure of credit risk that incorporates payment history and account diversity. CRI = 0.5 × (1 - \\frac{credscore}{850}) + 0.3 × \\frac{delinqcount + latepaycount + choffs}{10} + 0.2 × (1 - AHI), \\text{where AHI is the Account Health Index}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:37"}) SET n = {id: "credit:37", name: "Investment Portfolio Quality (IPQ)", type: "calculation_knowledge", description: "Evaluates the quality and performance of customer's investment allocations.", definition: "IPQ = 0.4 × RAR + 0.4 × \\frac{investamt}{totassets} + 0.2 × \\frac{chaninvdatablock.invcluster.investexp}{3}, \\text{where RAR is the Risk-Adjusted Return and investexp is converted to numeric (Limited=1, Moderate=2, Extensive=3)}", source_file: "credit_kb.jsonl", source_line: 38, source_id: 37, search_text: "Investment Portfolio Quality (IPQ) calculation_knowledge Evaluates the quality and performance of customer's investment allocations. IPQ = 0.4 × RAR + 0.4 × \\frac{investamt}{totassets} + 0.2 × \\frac{chaninvdatablock.invcluster.investexp}{3}, \\text{where RAR is the Risk-Adjusted Return and investexp is converted to numeric (Limited=1, Moderate=2, Extensive=3)}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:38"}) SET n = {id: "credit:38", name: "Banking Relationship Strength (BRS)", type: "calculation_knowledge", description: "Quantifies the depth and quality of a customer's banking relationship.", definition: "BRS = 0.3 × bankrelscore + 0.3 × (1 - churnrate) + 0.4 × CES, \\text{where CES is the Customer Engagement Score}", source_file: "credit_kb.jsonl", source_line: 39, source_id: 38, search_text: "Banking Relationship Strength (BRS) calculation_knowledge Quantifies the depth and quality of a customer's banking relationship. BRS = 0.3 × bankrelscore + 0.3 × (1 - churnrate) + 0.4 × CES, \\text{where CES is the Customer Engagement Score}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:39"}) SET n = {id: "credit:39", name: "Credit Health Momentum (CHM)", type: "calculation_knowledge", description: "Measures the trajectory of a customer's credit health over time.", definition: "CHM = CHS × (1 + \\Delta_\\text{recentbeh}), \\text{where CHS is the Credit Health Score and } \\Delta_\\text{recentbeh} \\text{ is +0.1 for 'Improving', 0 for 'Stable', and -0.1 for 'Deteriorating'}", source_file: "credit_kb.jsonl", source_line: 40, source_id: 39, search_text: "Credit Health Momentum (CHM) calculation_knowledge Measures the trajectory of a customer's credit health over time. CHM = CHS × (1 + \\Delta_\\text{recentbeh}), \\text{where CHS is the Credit Health Score and } \\Delta_\\text{recentbeh} \\text{ is +0.1 for 'Improving', 0 for 'Stable', and -0.1 for 'Deteriorating'}"};
MERGE (n:Knowledge:SemanticSearch {id: "credit:40"}) SET n = {id: "credit:40", name: "Mortgage Risk Profile", type: "domain_knowledge", description: "Identifies customers with elevated mortgage-related risk factors.", definition: "A customer with high LTV (Loan-to-Value Ratio > 0.9), negative equity risk (LTV > 1.0), or payment stress (propfinancialdata.mortgagebits.mortpayhist of 'Fair' or 'Poor').", source_file: "credit_kb.jsonl", source_line: 41, source_id: 40, search_text: "Mortgage Risk Profile domain_knowledge Identifies customers with elevated mortgage-related risk factors. A customer with high LTV (Loan-to-Value Ratio > 0.9), negative equity risk (LTV > 1.0), or payment stress (propfinancialdata.mortgagebits.mortpayhist of 'Fair' or 'Poor')."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:41"}) SET n = {id: "credit:41", name: "Credit Utilization Alert", type: "domain_knowledge", description: "Identifies customers with problematic credit utilization patterns.", definition: "A customer with CUR (Credit Utilization Ratio) > 0.8, an increasing trend in utilization, and limited available credit (totcredlimit < mthincome × 2).", source_file: "credit_kb.jsonl", source_line: 42, source_id: 41, search_text: "Credit Utilization Alert domain_knowledge Identifies customers with problematic credit utilization patterns. A customer with CUR (Credit Utilization Ratio) > 0.8, an increasing trend in utilization, and limited available credit (totcredlimit < mthincome × 2)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:42"}) SET n = {id: "credit:42", name: "Financial Stress Indicator", type: "domain_knowledge", description: "Identifies customers showing multiple signs of financial difficulty.", definition: "A customer with FVS (Financial Vulnerability Score) > 0.7, recent payment issues (delinqcount > 0 or latepaycount > 0 in past six months), and negative Net Worth.", source_file: "credit_kb.jsonl", source_line: 43, source_id: 42, search_text: "Financial Stress Indicator domain_knowledge Identifies customers showing multiple signs of financial difficulty. A customer with FVS (Financial Vulnerability Score) > 0.7, recent payment issues (delinqcount > 0 or latepaycount > 0 in past six months), and negative Net Worth."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:43"}) SET n = {id: "credit:43", name: "Premium Banking Candidate", type: "domain_knowledge", description: "Identifies customers who are good candidates for premium banking services.", definition: "A customer with high CQI (Credit Quality Index > 0.8), strong FSI (Financial Stability Index > 0.7), and significant assets (totassets > $250,000).", source_file: "credit_kb.jsonl", source_line: 44, source_id: 43, search_text: "Premium Banking Candidate domain_knowledge Identifies customers who are good candidates for premium banking services. A customer with high CQI (Credit Quality Index > 0.8), strong FSI (Financial Stability Index > 0.7), and significant assets (totassets > $250,000)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:44"}) SET n = {id: "credit:44", name: "Digital Channel Opportunity", type: "domain_knowledge", description: "Identifies customers who would benefit from increased digital engagement.", definition: "A customer with low digital engagement (chaninvdatablock.onlineuse not 'High' and chaninvdatablock.mobileuse not 'High') but high BRS (Banking Relationship Strength > 0.7) and multiple products (produsescore > 0.5).", source_file: "credit_kb.jsonl", source_line: 45, source_id: 44, search_text: "Digital Channel Opportunity domain_knowledge Identifies customers who would benefit from increased digital engagement. A customer with low digital engagement (chaninvdatablock.onlineuse not 'High' and chaninvdatablock.mobileuse not 'High') but high BRS (Banking Relationship Strength > 0.7) and multiple products (produsescore > 0.5)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:45"}) SET n = {id: "credit:45", name: "Credit Building Opportunity", type: "domain_knowledge", description: "Identifies customers who would benefit from credit-building products.", definition: "A customer with limited credit history (credageyrs < 2), low CQI (Credit Quality Index < 0.6), but positive banking behavior (bouncecount = 0 and bankrelscore > 0.6).", source_file: "credit_kb.jsonl", source_line: 46, source_id: 45, search_text: "Credit Building Opportunity domain_knowledge Identifies customers who would benefit from credit-building products. A customer with limited credit history (credageyrs < 2), low CQI (Credit Quality Index < 0.6), but positive banking behavior (bouncecount = 0 and bankrelscore > 0.6)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:46"}) SET n = {id: "credit:46", name: "Investment Services Target", type: "domain_knowledge", description: "Identifies customers who are good candidates for investment services.", definition: "A customer with high ALR (Asset Liquidity Ratio > 0.3) and strong income (mthincome > $5,000).", source_file: "credit_kb.jsonl", source_line: 47, source_id: 46, search_text: "Investment Services Target domain_knowledge Identifies customers who are good candidates for investment services. A customer with high ALR (Asset Liquidity Ratio > 0.3) and strong income (mthincome > $5,000)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:47"}) SET n = {id: "credit:47", name: "Declining Credit Health", type: "domain_knowledge", description: "Identifies customers with deteriorating credit health requiring intervention.", definition: "A customer with negative CHM (Credit Health Momentum < 0), increasing CRI (Credit Risk Intensity growing by >10% in 6 months), and rising DTI (Debt-to-Income Ratio increasing by >5% in 6 months).", source_file: "credit_kb.jsonl", source_line: 48, source_id: 47, search_text: "Declining Credit Health domain_knowledge Identifies customers with deteriorating credit health requiring intervention. A customer with negative CHM (Credit Health Momentum < 0), increasing CRI (Credit Risk Intensity growing by >10% in 6 months), and rising DTI (Debt-to-Income Ratio increasing by >5% in 6 months)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:48"}) SET n = {id: "credit:48", name: "Relationship Attrition Risk", type: "domain_knowledge", description: "Identifies customers at high risk of ending their banking relationship.", definition: "A customer with high CRR (Customer Retention Risk > 0.7), declining product usage (decreasing produsescore), and competitive shopping behavior (hardinq > 2 in past 3 months).", source_file: "credit_kb.jsonl", source_line: 49, source_id: 48, search_text: "Relationship Attrition Risk domain_knowledge Identifies customers at high risk of ending their banking relationship. A customer with high CRR (Customer Retention Risk > 0.7), declining product usage (decreasing produsescore), and competitive shopping behavior (hardinq > 2 in past 3 months)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:49"}) SET n = {id: "credit:49", name: "Cross-Sell Priority", type: "domain_knowledge", description: "Identifies customers who should be prioritized for cross-selling efforts.", definition: "A customer with strong CES (Customer Engagement Score > 0.7), positive CQI (Credit Quality Index > 0.7), and unrealized product potential (crossratio > 0.5 but produsescore < 0.5).", source_file: "credit_kb.jsonl", source_line: 50, source_id: 49, search_text: "Cross-Sell Priority domain_knowledge Identifies customers who should be prioritized for cross-selling efforts. A customer with strong CES (Customer Engagement Score > 0.7), positive CQI (Credit Quality Index > 0.7), and unrealized product potential (crossratio > 0.5 but produsescore < 0.5)."};
MERGE (n:Knowledge:SemanticSearch {id: "credit:50"}) SET n = {id: "credit:50", name: "High Engagement Criteria", type: "domain_knowledge", description: "Defines customers with a high level of engagement with bank products and services.", definition: "A Customer Engagement Score (CES) greater than 0.7.", source_file: "credit_kb.jsonl", source_line: 51, source_id: 50, search_text: "High Engagement Criteria domain_knowledge Defines customers with a high level of engagement with bank products and services. A Customer Engagement Score (CES) greater than 0.7."};

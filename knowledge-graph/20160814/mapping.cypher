MATCH (d:Database {id: "crypto"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "crypto:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "crypto:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "crypto:" AND NOT stale.id IN ["crypto:0", "crypto:1", "crypto:2", "crypto:3", "crypto:4", "crypto:5", "crypto:6", "crypto:7", "crypto:8", "crypto:9", "crypto:10", "crypto:11", "crypto:12", "crypto:13", "crypto:14", "crypto:15", "crypto:16", "crypto:17", "crypto:18", "crypto:19", "crypto:20", "crypto:21", "crypto:22", "crypto:23", "crypto:24", "crypto:25", "crypto:26", "crypto:27", "crypto:28", "crypto:29", "crypto:30", "crypto:31", "crypto:32", "crypto:33", "crypto:34", "crypto:35", "crypto:36", "crypto:37", "crypto:38", "crypto:39", "crypto:40", "crypto:41", "crypto:42", "crypto:43", "crypto:44", "crypto:45", "crypto:46", "crypto:47", "crypto:48", "crypto:49", "crypto:50", "crypto:51", "crypto:52"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "crypto:0"}) SET n = {id: "crypto:0", name: "Spread Percentage", type: "calculation_knowledge", description: "Calculates the spread as a percentage of the midpoint price.", definition: "Spread Percentage = \\frac{askquote - bidquote}{midquote} \\times 100, \\text{where } askquote \\text{ is the best ask price, } bidquote \\text{ is the best bid price, and } midquote \\text{ is the midpoint price.}", source_file: "crypto_kb.jsonl", source_line: 1, source_id: 0, search_text: "Spread Percentage calculation_knowledge Calculates the spread as a percentage of the midpoint price. Spread Percentage = \\frac{askquote - bidquote}{midquote} \\times 100, \\text{where } askquote \\text{ is the best ask price, } bidquote \\text{ is the best bid price, and } midquote \\text{ is the midpoint price.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:1"}) SET n = {id: "crypto:1", name: "Slippage Impact", type: "calculation_knowledge", description: "Calculates the expected price slippage impact for a given order size.", definition: "Slippage Impact = \\frac{dealcount}{bidunits \\text{ or } askunits} \\times spreadband, \\text{where } dealcount \\text{ is the order quantity, } bidunits/askunits \\text{ is the quantity available at best bid/ask, and } spreadband \\text{ is the raw spread.}", source_file: "crypto_kb.jsonl", source_line: 2, source_id: 1, search_text: "Slippage Impact calculation_knowledge Calculates the expected price slippage impact for a given order size. Slippage Impact = \\frac{dealcount}{bidunits \\text{ or } askunits} \\times spreadband, \\text{where } dealcount \\text{ is the order quantity, } bidunits/askunits \\text{ is the quantity available at best bid/ask, and } spreadband \\text{ is the raw spread.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:2"}) SET n = {id: "crypto:2", name: "Position Value at Risk (PVaR)", type: "calculation_knowledge", description: "Calculates the value at risk for a position based on current market conditions.", definition: "PVaR = possum \\times volmeter \\times 0.01, \\text{where } possum \\text{ is the notional value of position and } volmeter \\text{ is the volatility or fluctuation rating.}", source_file: "crypto_kb.jsonl", source_line: 3, source_id: 2, search_text: "Position Value at Risk (PVaR) calculation_knowledge Calculates the value at risk for a position based on current market conditions. PVaR = possum \\times volmeter \\times 0.01, \\text{where } possum \\text{ is the notional value of position and } volmeter \\text{ is the volatility or fluctuation rating.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:3"}) SET n = {id: "crypto:3", name: "Arbitrage Opportunity Score (AOS)", type: "calculation_knowledge", description: "Quantifies the potential arbitrage opportunity considering multiple factors.", definition: "AOS = arbpotential + xexchband + (fundgap \\times 2) + basisgap, \\text{where these components represent different types of arbitrage opportunities.}", source_file: "crypto_kb.jsonl", source_line: 4, source_id: 3, search_text: "Arbitrage Opportunity Score (AOS) calculation_knowledge Quantifies the potential arbitrage opportunity considering multiple factors. AOS = arbpotential + xexchband + (fundgap \\times 2) + basisgap, \\text{where these components represent different types of arbitrage opportunities.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:4"}) SET n = {id: "crypto:4", name: "Market Impact Cost (MIC)", type: "calculation_knowledge", description: "Estimates the market impact cost of executing a large order.", definition: "MIC = dealcount \\times dealquote \\times mkteffect \\times 0.01, \\text{where } dealcount \\text{ is the order quantity, } dealquote \\text{ is the limit or stop price, and } mkteffect \\text{ is the approximating internal market impact.}", source_file: "crypto_kb.jsonl", source_line: 5, source_id: 4, search_text: "Market Impact Cost (MIC) calculation_knowledge Estimates the market impact cost of executing a large order. MIC = dealcount \\times dealquote \\times mkteffect \\times 0.01, \\text{where } dealcount \\text{ is the order quantity, } dealquote \\text{ is the limit or stop price, and } mkteffect \\text{ is the approximating internal market impact.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:5"}) SET n = {id: "crypto:5", name: "Liquidity Ratio", type: "calculation_knowledge", description: "Measures the ratio of available liquidity to total market volume.", definition: "Liquidity Ratio = \\frac{(bidunits + askunits) \\times midquote}{volday}, \\text{where } bidunits \\text{ and } askunits \\text{ are quantities at best bid and ask, } midquote \\text{ is the midpoint price, and } volday \\text{ is the 24h volume.}", source_file: "crypto_kb.jsonl", source_line: 6, source_id: 5, search_text: "Liquidity Ratio calculation_knowledge Measures the ratio of available liquidity to total market volume. Liquidity Ratio = \\frac{(bidunits + askunits) \\times midquote}{volday}, \\text{where } bidunits \\text{ and } askunits \\text{ are quantities at best bid and ask, } midquote \\text{ is the midpoint price, and } volday \\text{ is the 24h volume.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:6"}) SET n = {id: "crypto:6", name: "Realized Risk Ratio (RRR)", type: "calculation_knowledge", description: "Calculates the ratio of realized PnL to position value at risk.", definition: "RRR = \\frac{realline}{PVaR}, \\text{where } realline \\text{ is the realized PnL and } PVaR \\text{ is the Position Value at Risk.}", source_file: "crypto_kb.jsonl", source_line: 7, source_id: 6, search_text: "Realized Risk Ratio (RRR) calculation_knowledge Calculates the ratio of realized PnL to position value at risk. RRR = \\frac{realline}{PVaR}, \\text{where } realline \\text{ is the realized PnL and } PVaR \\text{ is the Position Value at Risk.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:7"}) SET n = {id: "crypto:7", name: "Margin Utilization", type: "calculation_knowledge", description: "Calculates the percentage of margin being utilized.", definition: "Margin Utilization = \\frac{inithold}{margsum} \\times 100, \\text{where } inithold \\text{ is the initial margin required and } margsum \\text{ is the margin account balance.}", source_file: "crypto_kb.jsonl", source_line: 8, source_id: 7, search_text: "Margin Utilization calculation_knowledge Calculates the percentage of margin being utilized. Margin Utilization = \\frac{inithold}{margsum} \\times 100, \\text{where } inithold \\text{ is the initial margin required and } margsum \\text{ is the margin account balance.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:8"}) SET n = {id: "crypto:8", name: "Order Fill Rate", type: "calculation_knowledge", description: "Calculates the percentage of an order that has been filled.", definition: "Order Fill Rate = \\frac{dealcount - remaincount}{dealcount} \\times 100, \\text{where } dealcount \\text{ is the order quantity and } remaincount \\text{ is how many units remain unfilled.}", source_file: "crypto_kb.jsonl", source_line: 9, source_id: 8, search_text: "Order Fill Rate calculation_knowledge Calculates the percentage of an order that has been filled. Order Fill Rate = \\frac{dealcount - remaincount}{dealcount} \\times 100, \\text{where } dealcount \\text{ is the order quantity and } remaincount \\text{ is how many units remain unfilled.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:9"}) SET n = {id: "crypto:9", name: "Market Efficiency Ratio (MER)", type: "calculation_knowledge", description: "Measures how efficiently orders are executed compared to expected slippage.", definition: "MER = \\frac{Slippage Impact}{slipratio}, \\text{where } Slippage Impact \\text{ is the calculated expected slippage and } slipratio \\text{ is the average slippage measure.}", source_file: "crypto_kb.jsonl", source_line: 10, source_id: 9, search_text: "Market Efficiency Ratio (MER) calculation_knowledge Measures how efficiently orders are executed compared to expected slippage. MER = \\frac{Slippage Impact}{slipratio}, \\text{where } Slippage Impact \\text{ is the calculated expected slippage and } slipratio \\text{ is the average slippage measure.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:10"}) SET n = {id: "crypto:10", name: "Whale Order", type: "domain_knowledge", description: "Identifies large orders that could significantly impact market prices.", definition: "An order where the dealcount exceeds 10% of the available liquidity (bidunits or askunits) at the current best bid or ask price.", source_file: "crypto_kb.jsonl", source_line: 11, source_id: 10, search_text: "Whale Order domain_knowledge Identifies large orders that could significantly impact market prices. An order where the dealcount exceeds 10% of the available liquidity (bidunits or askunits) at the current best bid or ask price."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:11"}) SET n = {id: "crypto:11", name: "Liquidation Risk Level", type: "domain_knowledge", description: "Categorizes positions based on their proximity to liquidation.", definition: "Positions are categorized as 'Safe', 'Moderate', or 'High Risk' based on how close the current market price is to the liqquote (liquidation price). A position is 'High Risk' when market price is within 5% of liqquote.", source_file: "crypto_kb.jsonl", source_line: 12, source_id: 11, search_text: "Liquidation Risk Level domain_knowledge Categorizes positions based on their proximity to liquidation. Positions are categorized as 'Safe', 'Moderate', or 'High Risk' based on how close the current market price is to the liqquote (liquidation price). A position is 'High Risk' when market price is within 5% of liqquote."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:12"}) SET n = {id: "crypto:12", name: "Arbitrage Window", type: "domain_knowledge", description: "Identifies time periods with significant arbitrage opportunities across markets.", definition: "A market condition where the Arbitrage Opportunity Score exceeds 0.05, indicating substantial price discrepancies that can be exploited.", source_file: "crypto_kb.jsonl", source_line: 13, source_id: 12, search_text: "Arbitrage Window domain_knowledge Identifies time periods with significant arbitrage opportunities across markets. A market condition where the Arbitrage Opportunity Score exceeds 0.05, indicating substantial price discrepancies that can be exploited."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:13"}) SET n = {id: "crypto:13", name: "Over-Leveraged Position", type: "domain_knowledge", description: "Identifies positions with excessive leverage relative to market volatility.", definition: "A position where the leverage (posmagn) multiplied by the volatility measure (volmeter) exceeds 500, indicating high risk exposure.", source_file: "crypto_kb.jsonl", source_line: 14, source_id: 13, search_text: "Over-Leveraged Position domain_knowledge Identifies positions with excessive leverage relative to market volatility. A position where the leverage (posmagn) multiplied by the volatility measure (volmeter) exceeds 500, indicating high risk exposure."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:14"}) SET n = {id: "crypto:14", name: "Market Maker Activity", type: "domain_knowledge", description: "Identifies periods of high market maker participation.", definition: "Market conditions where exectune is predominantly 'Maker' and makermotion is 'High', indicating strong liquidity provision by market makers.", source_file: "crypto_kb.jsonl", source_line: 15, source_id: 14, search_text: "Market Maker Activity domain_knowledge Identifies periods of high market maker participation. Market conditions where exectune is predominantly 'Maker' and makermotion is 'High', indicating strong liquidity provision by market makers."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:15"}) SET n = {id: "crypto:15", name: "Smart Money Flow", type: "domain_knowledge", description: "Identifies directional bias of sophisticated traders.", definition: "Market conditions where smartforce exceeds both retailflow and instflow by at least 20%, indicating strong directional bias from sophisticated traders.", source_file: "crypto_kb.jsonl", source_line: 16, source_id: 15, search_text: "Smart Money Flow domain_knowledge Identifies directional bias of sophisticated traders. Market conditions where smartforce exceeds both retailflow and instflow by at least 20%, indicating strong directional bias from sophisticated traders."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:16"}) SET n = {id: "crypto:16", name: "Liquidity Crisis", type: "domain_knowledge", description: "Identifies periods of severely reduced market liquidity.", definition: "Market conditions where the Liquidity Ratio falls below 0.01, indicating insufficient market depth relative to typical trading volume.", source_file: "crypto_kb.jsonl", source_line: 17, source_id: 16, search_text: "Liquidity Crisis domain_knowledge Identifies periods of severely reduced market liquidity. Market conditions where the Liquidity Ratio falls below 0.01, indicating insufficient market depth relative to typical trading volume."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:17"}) SET n = {id: "crypto:17", name: "Momentum Divergence", type: "domain_knowledge", description: "Identifies when price action diverges from momentum indicators.", definition: "Market condition where price makes new highs/lows while momentum indicators (buyforce, sellforce) move in the opposite direction.", source_file: "crypto_kb.jsonl", source_line: 18, source_id: 17, search_text: "Momentum Divergence domain_knowledge Identifies when price action diverges from momentum indicators. Market condition where price makes new highs/lows while momentum indicators (buyforce, sellforce) move in the opposite direction."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:18"}) SET n = {id: "crypto:18", name: "Margin Call Risk", type: "domain_knowledge", description: "Identifies accounts at risk of receiving a margin call.", definition: "Accounts where the Margin Utilization exceeds 80%, putting them at risk of margin calls if market prices move adversely.", source_file: "crypto_kb.jsonl", source_line: 19, source_id: 18, search_text: "Margin Call Risk domain_knowledge Identifies accounts at risk of receiving a margin call. Accounts where the Margin Utilization exceeds 80%, putting them at risk of margin calls if market prices move adversely."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:19"}) SET n = {id: "crypto:19", name: "Technical Breakout", type: "domain_knowledge", description: "Identifies when price breaks significant technical levels with volume.", definition: "Market condition where price exceeds the highspotday or falls below lowspotday with volume (volday) at least 50% above the 30-day average.", source_file: "crypto_kb.jsonl", source_line: 20, source_id: 19, search_text: "Technical Breakout domain_knowledge Identifies when price breaks significant technical levels with volume. Market condition where price exceeds the highspotday or falls below lowspotday with volume (volday) at least 50% above the 30-day average."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:20"}) SET n = {id: "crypto:20", name: "dealedge", type: "value_illustration", description: "Illustrates the meaning of different values for the dealedge enum.", definition: "An enum with values 'Buy' or 'Sell'. 'Buy' indicates the order is to purchase the base asset using the quote asset (e.g., buying BTC with USDT). 'Sell' indicates the order is to sell the base asset for the quote asset (e.g., selling BTC for USDT).", source_file: "crypto_kb.jsonl", source_line: 21, source_id: 20, search_text: "dealedge value_illustration Illustrates the meaning of different values for the dealedge enum. An enum with values 'Buy' or 'Sell'. 'Buy' indicates the order is to purchase the base asset using the quote asset (e.g., buying BTC with USDT). 'Sell' indicates the order is to sell the base asset for the quote asset (e.g., selling BTC for USDT)."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:21"}) SET n = {id: "crypto:21", name: "orderflow", type: "value_illustration", description: "Illustrates the meaning of different values for the orderflow enum.", definition: "An enum with values 'New', 'PartiallyFilled', 'Cancelled', or 'Filled'. 'New' indicates a newly placed order that hasn't been matched. 'PartiallyFilled' means some portion has been executed but not all. 'Cancelled' means the order was cancelled before full execution. 'Filled' means the order has been completely executed.", source_file: "crypto_kb.jsonl", source_line: 22, source_id: 21, search_text: "orderflow value_illustration Illustrates the meaning of different values for the orderflow enum. An enum with values 'New', 'PartiallyFilled', 'Cancelled', or 'Filled'. 'New' indicates a newly placed order that hasn't been matched. 'PartiallyFilled' means some portion has been executed but not all. 'Cancelled' means the order was cancelled before full execution. 'Filled' means the order has been completely executed."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:22"}) SET n = {id: "crypto:22", name: "timespan", type: "value_illustration", description: "Illustrates the meaning of different values for the timespan enum.", definition: "An enum with values 'IOC', 'GTC', 'GTD', or 'FOK'. 'IOC' (Immediate-or-Cancel) means execute immediately available portion or cancel. 'GTC' (Good-Till-Cancelled) means the order remains active until explicitly cancelled. 'GTD' (Good-Till-Date) means the order remains active until a specified date. 'FOK' (Fill-or-Kill) means execute completely immediately or cancel entirely.", source_file: "crypto_kb.jsonl", source_line: 23, source_id: 22, search_text: "timespan value_illustration Illustrates the meaning of different values for the timespan enum. An enum with values 'IOC', 'GTC', 'GTD', or 'FOK'. 'IOC' (Immediate-or-Cancel) means execute immediately available portion or cancel. 'GTC' (Good-Till-Cancelled) means the order remains active until explicitly cancelled. 'GTD' (Good-Till-Date) means the order remains active until a specified date. 'FOK' (Fill-or-Kill) means execute completely immediately or cancel entirely."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:23"}) SET n = {id: "crypto:23", name: "posedge", type: "value_illustration", description: "Illustrates the meaning of different values for the posedge enum.", definition: "An enum with values 'Long' or 'Short'. 'Long' indicates a position that profits from price increases of the underlying asset. 'Short' indicates a position that profits from price decreases of the underlying asset.", source_file: "crypto_kb.jsonl", source_line: 24, source_id: 23, search_text: "posedge value_illustration Illustrates the meaning of different values for the posedge enum. An enum with values 'Long' or 'Short'. 'Long' indicates a position that profits from price increases of the underlying asset. 'Short' indicates a position that profits from price decreases of the underlying asset."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:24"}) SET n = {id: "crypto:24", name: "posmagn", type: "value_illustration", description: "Illustrates the meaning of different values for the posmagn enum.", definition: "An enum with values '1', '2', '3', '5', '10', '20', '50', or '100', representing leverage multipliers. For example, '10' means the position uses 10x leverage, amplifying both potential profits and losses by a factor of 10 compared to an unleveraged position.", source_file: "crypto_kb.jsonl", source_line: 25, source_id: 24, search_text: "posmagn value_illustration Illustrates the meaning of different values for the posmagn enum. An enum with values '1', '2', '3', '5', '10', '20', '50', or '100', representing leverage multipliers. For example, '10' means the position uses 10x leverage, amplifying both potential profits and losses by a factor of 10 compared to an unleveraged position."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:25"}) SET n = {id: "crypto:25", name: "mktfeel", type: "value_illustration", description: "Illustrates the meaning of different values for the mktfeel enum.", definition: "An enum with values 'Bearish', 'Bullish', or 'Neutral'. 'Bearish' indicates negative market sentiment with expectations of price decreases. 'Bullish' indicates positive market sentiment with expectations of price increases. 'Neutral' indicates balanced market sentiment with no strong directional bias.", source_file: "crypto_kb.jsonl", source_line: 26, source_id: 25, search_text: "mktfeel value_illustration Illustrates the meaning of different values for the mktfeel enum. An enum with values 'Bearish', 'Bullish', or 'Neutral'. 'Bearish' indicates negative market sentiment with expectations of price decreases. 'Bullish' indicates positive market sentiment with expectations of price increases. 'Neutral' indicates balanced market sentiment with no strong directional bias."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:26"}) SET n = {id: "crypto:26", name: "techmeter", type: "value_illustration", description: "Illustrates the meaning of different values for the techmeter enum.", definition: "An enum with values 'Buy', 'Sell', or 'Hold'. 'Buy' indicates technical indicators suggest purchasing the asset. 'Sell' indicates technical indicators suggest selling the asset. 'Hold' indicates technical indicators suggest maintaining current positions without new trades.", source_file: "crypto_kb.jsonl", source_line: 27, source_id: 26, search_text: "techmeter value_illustration Illustrates the meaning of different values for the techmeter enum. An enum with values 'Buy', 'Sell', or 'Hold'. 'Buy' indicates technical indicators suggest purchasing the asset. 'Sell' indicates technical indicators suggest selling the asset. 'Hold' indicates technical indicators suggest maintaining current positions without new trades."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:27"}) SET n = {id: "crypto:27", name: "whalemotion", type: "value_illustration", description: "Illustrates the meaning of different values for the whalemotion enum.", definition: "An enum with values 'Low', 'Medium', or 'High'. 'Low' indicates minimal activity from large traders. 'Medium' indicates moderate activity from large traders. 'High' indicates significant activity from large traders, potentially signaling important market movements.", source_file: "crypto_kb.jsonl", source_line: 28, source_id: 27, search_text: "whalemotion value_illustration Illustrates the meaning of different values for the whalemotion enum. An enum with values 'Low', 'Medium', or 'High'. 'Low' indicates minimal activity from large traders. 'Medium' indicates moderate activity from large traders. 'High' indicates significant activity from large traders, potentially signaling important market movements."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:28"}) SET n = {id: "crypto:28", name: "makermotion", type: "value_illustration", description: "Illustrates the meaning of different values for the makermotion enum.", definition: "An enum with values 'Low', 'Medium', or 'High'. 'Low' indicates minimal market maker activity with potentially wider spreads. 'Medium' indicates normal market maker activity. 'High' indicates substantial market maker activity, typically resulting in tighter spreads and higher liquidity.", source_file: "crypto_kb.jsonl", source_line: 29, source_id: 28, search_text: "makermotion value_illustration Illustrates the meaning of different values for the makermotion enum. An enum with values 'Low', 'Medium', or 'High'. 'Low' indicates minimal market maker activity with potentially wider spreads. 'Medium' indicates normal market maker activity. 'High' indicates substantial market maker activity, typically resulting in tighter spreads and higher liquidity."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:29"}) SET n = {id: "crypto:29", name: "exectune", type: "value_illustration", description: "Illustrates the meaning of different values for the exectune enum.", definition: "An enum with values 'Maker' or 'Taker'. 'Maker' indicates the order added liquidity to the order book by not matching immediately. 'Taker' indicates the order removed liquidity from the order book by matching with existing orders immediately upon placement.", source_file: "crypto_kb.jsonl", source_line: 30, source_id: 29, search_text: "exectune value_illustration Illustrates the meaning of different values for the exectune enum. An enum with values 'Maker' or 'Taker'. 'Maker' indicates the order added liquidity to the order book by not matching immediately. 'Taker' indicates the order removed liquidity from the order book by matching with existing orders immediately upon placement."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:30"}) SET n = {id: "crypto:30", name: "Risk-Adjusted Return", type: "calculation_knowledge", description: "Calculates return on position adjusted for risk exposure.", definition: "Risk-Adjusted Return = \\frac{realline}{PVaR \\times posriskrate}, \\text{where } realline \\text{ is the realized PnL, } PVaR \\text{ is the Position Value at Risk, and } posriskrate \\text{ is the position risk ratio.}", source_file: "crypto_kb.jsonl", source_line: 31, source_id: 30, search_text: "Risk-Adjusted Return calculation_knowledge Calculates return on position adjusted for risk exposure. Risk-Adjusted Return = \\frac{realline}{PVaR \\times posriskrate}, \\text{where } realline \\text{ is the realized PnL, } PVaR \\text{ is the Position Value at Risk, and } posriskrate \\text{ is the position risk ratio.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:31"}) SET n = {id: "crypto:31", name: "True Cost of Execution", type: "calculation_knowledge", description: "Calculates the total cost of order execution including fees and slippage.", definition: "True Cost of Execution = feetotal + (dealcount \\times dealquote \\times Slippage Impact \\times 0.01), \\text{where } feetotal \\text{ is the total fee charged and } Slippage Impact \\text{ is the expected price slippage impact for the order size.}", source_file: "crypto_kb.jsonl", source_line: 32, source_id: 31, search_text: "True Cost of Execution calculation_knowledge Calculates the total cost of order execution including fees and slippage. True Cost of Execution = feetotal + (dealcount \\times dealquote \\times Slippage Impact \\times 0.01), \\text{where } feetotal \\text{ is the total fee charged and } Slippage Impact \\text{ is the expected price slippage impact for the order size.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:32"}) SET n = {id: "crypto:32", name: "Order Book Imbalance Ratio", type: "calculation_knowledge", description: "Quantifies the imbalance between bid and ask sides of the order book.", definition: "Order Book Imbalance Ratio = \\frac{biddepth - askdepth}{biddepth + askdepth}, \\text{where } biddepth \\text{ is the deeper bid liquidity and } askdepth \\text{ is the deeper ask liquidity. A positive Imbalance Ratio indicates stronger buying pressure, while negative indicates stronger selling pressure.", source_file: "crypto_kb.jsonl", source_line: 33, source_id: 32, search_text: "Order Book Imbalance Ratio calculation_knowledge Quantifies the imbalance between bid and ask sides of the order book. Order Book Imbalance Ratio = \\frac{biddepth - askdepth}{biddepth + askdepth}, \\text{where } biddepth \\text{ is the deeper bid liquidity and } askdepth \\text{ is the deeper ask liquidity. A positive Imbalance Ratio indicates stronger buying pressure, while negative indicates stronger selling pressure."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:33"}) SET n = {id: "crypto:33", name: "Effective Leverage", type: "calculation_knowledge", description: "Calculates the actual leverage considering both explicit leverage setting and position size relative to account balance.", definition: "Effective Leverage = posmagn \\times \\frac{possum}{walletsum}, \\text{where } posmagn \\text{ is the position leverage, } possum \\text{ is the notional value of position, and } walletsum \\text{ is the total wallet balance.}", source_file: "crypto_kb.jsonl", source_line: 34, source_id: 33, search_text: "Effective Leverage calculation_knowledge Calculates the actual leverage considering both explicit leverage setting and position size relative to account balance. Effective Leverage = posmagn \\times \\frac{possum}{walletsum}, \\text{where } posmagn \\text{ is the position leverage, } possum \\text{ is the notional value of position, and } walletsum \\text{ is the total wallet balance.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:34"}) SET n = {id: "crypto:34", name: "Profit Factor", type: "calculation_knowledge", description: "Measures the ratio of profitable trades to losing trades adjusted for their values.", definition: "Profit Factor = \\frac{\\sum positive\\ realline}{|\\sum negative\\ realline|}, \\text{where } realline \\text{ is the realized PnL, calculated separately for positive and negative values.}", source_file: "crypto_kb.jsonl", source_line: 35, source_id: 34, search_text: "Profit Factor calculation_knowledge Measures the ratio of profitable trades to losing trades adjusted for their values. Profit Factor = \\frac{\\sum positive\\ realline}{|\\sum negative\\ realline|}, \\text{where } realline \\text{ is the realized PnL, calculated separately for positive and negative values.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:35"}) SET n = {id: "crypto:35", name: "Arbitrage ROI", type: "calculation_knowledge", description: "Calculates the potential return on investment for an arbitrage opportunity.", definition: "Arbitrage ROI = \\frac{AOS \\times dealquote}{feetotal \\times 2}, \\text{where } AOS \\text{ is the Arbitrage Opportunity Score and } feetotal \\text{ is multiplied by 2 to account for fees on both transactions involved in arbitrage.}", source_file: "crypto_kb.jsonl", source_line: 36, source_id: 35, search_text: "Arbitrage ROI calculation_knowledge Calculates the potential return on investment for an arbitrage opportunity. Arbitrage ROI = \\frac{AOS \\times dealquote}{feetotal \\times 2}, \\text{where } AOS \\text{ is the Arbitrage Opportunity Score and } feetotal \\text{ is multiplied by 2 to account for fees on both transactions involved in arbitrage.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:36"}) SET n = {id: "crypto:36", name: "Market Depth Ratio", type: "calculation_knowledge", description: "Measures the ratio of order book depth to position size to assess market liquidity for position exit.", definition: "Market Depth Ratio = \\frac{biddepth \\text{ or } askdepth}{dealcount} \\times Liquidity Ratio, \\text{where } biddepth/askdepth \\text{ is used depending on position direction (posedge), } dealcount \\text{ is the order quantity, and } Liquidity Ratio \\text{ measures available liquidity to total market volume.}", source_file: "crypto_kb.jsonl", source_line: 37, source_id: 36, search_text: "Market Depth Ratio calculation_knowledge Measures the ratio of order book depth to position size to assess market liquidity for position exit. Market Depth Ratio = \\frac{biddepth \\text{ or } askdepth}{dealcount} \\times Liquidity Ratio, \\text{where } biddepth/askdepth \\text{ is used depending on position direction (posedge), } dealcount \\text{ is the order quantity, and } Liquidity Ratio \\text{ measures available liquidity to total market volume.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:37"}) SET n = {id: "crypto:37", name: "Volatility-Adjusted Spread", type: "calculation_knowledge", description: "Normalizes the spread by the market volatility to determine if spread is wide relative to expected price movement.", definition: "Volatility-Adjusted Spread = \\frac{Spread Percentage}{volmeter \\times 0.1}, \\text{where } Spread Percentage \\text{ is the spread as percentage of midpoint price and } volmeter \\text{ is the volatility or fluctuation rating.}", source_file: "crypto_kb.jsonl", source_line: 38, source_id: 37, search_text: "Volatility-Adjusted Spread calculation_knowledge Normalizes the spread by the market volatility to determine if spread is wide relative to expected price movement. Volatility-Adjusted Spread = \\frac{Spread Percentage}{volmeter \\times 0.1}, \\text{where } Spread Percentage \\text{ is the spread as percentage of midpoint price and } volmeter \\text{ is the volatility or fluctuation rating.}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:38"}) SET n = {id: "crypto:38", name: "Risk-to-Reward Ratio", type: "calculation_knowledge", description: "Calculates the ratio of potential risk to potential reward for a position.", definition: "Risk-to-Reward Ratio = \\frac{|entryquote - (posedge == 'Long' ? stopquote : trigquote)|}{|entryquote - (posedge == 'Long' ? trigquote : stopquote)|}, \\text{where } entryquote \\text{ is the entry price, } stopquote \\text{ is the stop price, } trigquote \\text{ is the advanced trigger price, and } posedge \\text{ determines position direction (Long or Short).}", source_file: "crypto_kb.jsonl", source_line: 39, source_id: 38, search_text: "Risk-to-Reward Ratio calculation_knowledge Calculates the ratio of potential risk to potential reward for a position. Risk-to-Reward Ratio = \\frac{|entryquote - (posedge == 'Long' ? stopquote : trigquote)|}{|entryquote - (posedge == 'Long' ? trigquote : stopquote)|}, \\text{where } entryquote \\text{ is the entry price, } stopquote \\text{ is the stop price, } trigquote \\text{ is the advanced trigger price, and } posedge \\text{ determines position direction (Long or Short).}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:39"}) SET n = {id: "crypto:39", name: "Technical Signal Strength", type: "calculation_knowledge", description: "Quantifies the strength of technical signals based on multiple indicators.", definition: "Technical Signal Strength = \\frac{|rsi14spot - 50| + |macdtrail| + (bbandspan \\times 0.01)}{3} \\times (techmeter == 'Buy' ? 1 : techmeter == 'Sell' ? -1 : 0), \\text{where } rsi14spot \\text{ is the RSI indicator, } macdtrail \\text{ is the MACD line, } bbandspan \\text{ is the Bollinger Band width, and } techmeter \\text{ determines direction (Buy, Sell, Hold).}", source_file: "crypto_kb.jsonl", source_line: 40, source_id: 39, search_text: "Technical Signal Strength calculation_knowledge Quantifies the strength of technical signals based on multiple indicators. Technical Signal Strength = \\frac{|rsi14spot - 50| + |macdtrail| + (bbandspan \\times 0.01)}{3} \\times (techmeter == 'Buy' ? 1 : techmeter == 'Sell' ? -1 : 0), \\text{where } rsi14spot \\text{ is the RSI indicator, } macdtrail \\text{ is the MACD line, } bbandspan \\text{ is the Bollinger Band width, and } techmeter \\text{ determines direction (Buy, Sell, Hold).}"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:40"}) SET n = {id: "crypto:40", name: "Critically Over-Leveraged Position", type: "domain_knowledge", description: "Identifies positions with extremely dangerous leverage levels requiring immediate risk management.", definition: "A position that qualifies as an Over-Leveraged Position where additionally the Effective Leverage exceeds 20 and the Margin Utilization exceeds 90%, creating extreme liquidation risk.", source_file: "crypto_kb.jsonl", source_line: 41, source_id: 40, search_text: "Critically Over-Leveraged Position domain_knowledge Identifies positions with extremely dangerous leverage levels requiring immediate risk management. A position that qualifies as an Over-Leveraged Position where additionally the Effective Leverage exceeds 20 and the Margin Utilization exceeds 90%, creating extreme liquidation risk."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:41"}) SET n = {id: "crypto:41", name: "High-Quality Arbitrage Opportunity", type: "domain_knowledge", description: "Identifies particularly favorable arbitrage opportunities with minimal execution risk.", definition: "An Arbitrage Window where the Arbitrage ROI exceeds 0.5% and the Market Efficiency Ratio is less than 1.2, indicating high potential return with low execution risk.", source_file: "crypto_kb.jsonl", source_line: 42, source_id: 41, search_text: "High-Quality Arbitrage Opportunity domain_knowledge Identifies particularly favorable arbitrage opportunities with minimal execution risk. An Arbitrage Window where the Arbitrage ROI exceeds 0.5% and the Market Efficiency Ratio is less than 1.2, indicating high potential return with low execution risk."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:42"}) SET n = {id: "crypto:42", name: "Technical Reversal Signal", type: "domain_knowledge", description: "Identifies strong indications of potential market direction reversal.", definition: "A market condition where Technical Signal Strength exceeds 8 in absolute value while simultaneously showing Momentum Divergence, providing reinforcing signals of a potential trend reversal.", source_file: "crypto_kb.jsonl", source_line: 43, source_id: 42, search_text: "Technical Reversal Signal domain_knowledge Identifies strong indications of potential market direction reversal. A market condition where Technical Signal Strength exceeds 8 in absolute value while simultaneously showing Momentum Divergence, providing reinforcing signals of a potential trend reversal."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:43"}) SET n = {id: "crypto:43", name: "Liquidity Constrained Position", type: "domain_knowledge", description: "Identifies positions that may be difficult to exit due to insufficient market liquidity.", definition: "A position where the Market Depth Ratio is less than 2.0, indicating that the position size is large relative to available market depth, potentially leading to significant slippage upon exit.", source_file: "crypto_kb.jsonl", source_line: 44, source_id: 43, search_text: "Liquidity Constrained Position domain_knowledge Identifies positions that may be difficult to exit due to insufficient market liquidity. A position where the Market Depth Ratio is less than 2.0, indicating that the position size is large relative to available market depth, potentially leading to significant slippage upon exit."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:44"}) SET n = {id: "crypto:44", name: "Optimal Trading Window", type: "domain_knowledge", description: "Identifies periods with ideal conditions for order execution.", definition: "Market conditions where the Volatility-Adjusted Spread is less than 1.0 and the Market Maker Activity indicates 'High', suggesting tight spreads relative to volatility and strong liquidity provision.", source_file: "crypto_kb.jsonl", source_line: 45, source_id: 44, search_text: "Optimal Trading Window domain_knowledge Identifies periods with ideal conditions for order execution. Market conditions where the Volatility-Adjusted Spread is less than 1.0 and the Market Maker Activity indicates 'High', suggesting tight spreads relative to volatility and strong liquidity provision."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:45"}) SET n = {id: "crypto:45", name: "Risk-Efficient Position", type: "domain_knowledge", description: "Identifies positions with favorable risk-adjusted characteristics.", definition: "A position where the Risk-Adjusted Return exceeds 1.5 and the Risk-to-Reward Ratio is less than 0.5, indicating strong returns relative to risk exposure and favorable potential profit compared to potential loss.", source_file: "crypto_kb.jsonl", source_line: 46, source_id: 45, search_text: "Risk-Efficient Position domain_knowledge Identifies positions with favorable risk-adjusted characteristics. A position where the Risk-Adjusted Return exceeds 1.5 and the Risk-to-Reward Ratio is less than 0.5, indicating strong returns relative to risk exposure and favorable potential profit compared to potential loss."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:46"}) SET n = {id: "crypto:46", name: "Whale-Driven Market", type: "domain_knowledge", description: "Identifies periods where large traders significantly influence price direction.", definition: "Market conditions where whalemotion is 'High' and there is at least one Whale Order in the same direction as the Smart Money Flow, indicating coordinated activity among large market participants.", source_file: "crypto_kb.jsonl", source_line: 47, source_id: 46, search_text: "Whale-Driven Market domain_knowledge Identifies periods where large traders significantly influence price direction. Market conditions where whalemotion is 'High' and there is at least one Whale Order in the same direction as the Smart Money Flow, indicating coordinated activity among large market participants."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:47"}) SET n = {id: "crypto:47", name: "Liquidation Cascade Risk", type: "domain_knowledge", description: "Identifies market conditions prone to cascading liquidations.", definition: "Market conditions where more than 15% of open positions are classified as Liquidation Risk Level 'High Risk' and the Order Book Imbalance Ratio exceeds 0.3 in absolute value, indicating concentrated risk and imbalanced liquidity.", source_file: "crypto_kb.jsonl", source_line: 48, source_id: 47, search_text: "Liquidation Cascade Risk domain_knowledge Identifies market conditions prone to cascading liquidations. Market conditions where more than 15% of open positions are classified as Liquidation Risk Level 'High Risk' and the Order Book Imbalance Ratio exceeds 0.3 in absolute value, indicating concentrated risk and imbalanced liquidity."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:48"}) SET n = {id: "crypto:48", name: "Perfect Technical Setup", type: "domain_knowledge", description: "Identifies ideal conditions for technical trading strategies.", definition: "Market conditions where Technical Signal Strength exceeds 7, the techmeter direction matches mktfeel sentiment direction, and no Momentum Divergence is present, indicating strong, consistent technical signals.", source_file: "crypto_kb.jsonl", source_line: 49, source_id: 48, search_text: "Perfect Technical Setup domain_knowledge Identifies ideal conditions for technical trading strategies. Market conditions where Technical Signal Strength exceeds 7, the techmeter direction matches mktfeel sentiment direction, and no Momentum Divergence is present, indicating strong, consistent technical signals."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:49"}) SET n = {id: "crypto:49", name: "Flash Crash Vulnerability", type: "domain_knowledge", description: "Identifies conditions where markets are susceptible to sudden, severe price drops.", definition: "Market conditions where Liquidation Cascade Risk is present, more than 30% of positions qualify as Over-Leveraged Position, and a Liquidity Crisis is developing, creating perfect conditions for a potential flash crash.", source_file: "crypto_kb.jsonl", source_line: 50, source_id: 49, search_text: "Flash Crash Vulnerability domain_knowledge Identifies conditions where markets are susceptible to sudden, severe price drops. Market conditions where Liquidation Cascade Risk is present, more than 30% of positions qualify as Over-Leveraged Position, and a Liquidity Crisis is developing, creating perfect conditions for a potential flash crash."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:50"}) SET n = {id: "crypto:50", name: "Flow Dominance", type: "domain_knowledge", description: "Categorizes market flow based on which group (smart money, retail, or institutional) has the highest trading volume.", definition: "Categorized as 'Smart Money Dominant' when smartforce > retail_flow * 1.2 AND smartforce > inst_flow * 1.2; 'Retail Dominant' when retail_flow > smartforce * 1.2 AND retail_flow > inst_flow * 1.2; 'Institutional Dominant' when inst_flow > smartforce * 1.2 AND inst_flow > retail_flow * 1.2; otherwise 'Mixed'.", source_file: "crypto_kb.jsonl", source_line: 51, source_id: 50, search_text: "Flow Dominance domain_knowledge Categorizes market flow based on which group (smart money, retail, or institutional) has the highest trading volume. Categorized as 'Smart Money Dominant' when smartforce > retail_flow * 1.2 AND smartforce > inst_flow * 1.2; 'Retail Dominant' when retail_flow > smartforce * 1.2 AND retail_flow > inst_flow * 1.2; 'Institutional Dominant' when inst_flow > smartforce * 1.2 AND inst_flow > retail_flow * 1.2; otherwise 'Mixed'."};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:51"}) SET n = {id: "crypto:51", name: "Smart Money Accuracy", type: "calculation_knowledge", description: "Measures the success rate of smart money flow in predicting the 4-hour price movement direction.", definition: "The proportion of times the Smart Money Flow direction matches the 4-hour price movement direction, calculated as: $$ \\frac{\\text{COUNT(CASE WHEN (smartforce > retailflow AND smartforce > instflow AND next\\_price\\_4h > mid\\_price) OR (smartforce < retailflow AND smartforce < instflow AND next\\_price\\_4h < mid\\_price) THEN 1 ELSE 0 END)}}{\\text{COUNT(*)}} $$", source_file: "crypto_kb.jsonl", source_line: 52, source_id: 51, search_text: "Smart Money Accuracy calculation_knowledge Measures the success rate of smart money flow in predicting the 4-hour price movement direction. The proportion of times the Smart Money Flow direction matches the 4-hour price movement direction, calculated as: $$ \\frac{\\text{COUNT(CASE WHEN (smartforce > retailflow AND smartforce > instflow AND next\\_price\\_4h > mid\\_price) OR (smartforce < retailflow AND smartforce < instflow AND next\\_price\\_4h < mid\\_price) THEN 1 ELSE 0 END)}}{\\text{COUNT(*)}} $$"};
MERGE (n:Knowledge:SemanticSearch {id: "crypto:52"}) SET n = {id: "crypto:52", name: "Effective Leverage Risk Classification", type: "domain_knowledge", description: "Categorizes positions based on their effective leverage to determine risk exposure.", definition: "A position is labeled as 'High Risk' if its Effective Leverage exceeds 20, otherwise as 'Normal'.", source_file: "crypto_kb.jsonl", source_line: 53, source_id: 52, search_text: "Effective Leverage Risk Classification domain_knowledge Categorizes positions based on their effective leverage to determine risk exposure. A position is labeled as 'High Risk' if its Effective Leverage exceeds 20, otherwise as 'Normal'."};
MATCH (d:Database {id: "cybermarket"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "cybermarket:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "cybermarket:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "cybermarket:" AND NOT stale.id IN ["cybermarket:0", "cybermarket:1", "cybermarket:2", "cybermarket:3", "cybermarket:4", "cybermarket:5", "cybermarket:6", "cybermarket:7", "cybermarket:8", "cybermarket:9", "cybermarket:10", "cybermarket:11", "cybermarket:12", "cybermarket:13", "cybermarket:14", "cybermarket:15", "cybermarket:16", "cybermarket:17", "cybermarket:18", "cybermarket:19", "cybermarket:20", "cybermarket:21", "cybermarket:22", "cybermarket:23", "cybermarket:24", "cybermarket:25", "cybermarket:26", "cybermarket:27", "cybermarket:28", "cybermarket:29", "cybermarket:30", "cybermarket:31", "cybermarket:32", "cybermarket:33", "cybermarket:34", "cybermarket:35", "cybermarket:36", "cybermarket:37", "cybermarket:38", "cybermarket:39", "cybermarket:40", "cybermarket:41", "cybermarket:42", "cybermarket:43", "cybermarket:44", "cybermarket:45", "cybermarket:46", "cybermarket:47", "cybermarket:48", "cybermarket:49"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:0"}) SET n = {id: "cybermarket:0", name: "cybermarket|markets|mktclass", type: "value_illustration", description: "Explains the market classification system and its business implications", definition: "Market classes define the primary business model: 'Forum' platforms focus on information exchange and community interactions with minimal direct transactions; 'Service' markets specialize in offering digital services rather than goods; 'Marketplace' denotes traditional product-focused platforms with diverse inventory; 'Exchange' indicates financial transaction services predominantly featuring cryptocurrency trading.", source_file: "cybermarket_kb.jsonl", source_line: 1, source_id: 0, search_text: "cybermarket|markets|mktclass value_illustration Explains the market classification system and its business implications Market classes define the primary business model: 'Forum' platforms focus on information exchange and community interactions with minimal direct transactions; 'Service' markets specialize in offering digital services rather than goods; 'Marketplace' denotes traditional product-focused platforms with diverse inventory; 'Exchange' indicates financial transaction services predominantly featuring cryptocurrency trading."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:1"}) SET n = {id: "cybermarket:1", name: "cybermarket|markets|sizecluster", type: "value_illustration", description: "Illustrates the significance of market size classification", definition: "Size clusters represent market scale and reach: 'Small' markets typically have under 10,000 monthly users and limited vendor presence; 'Medium' markets host 10,000-50,000 monthly users with moderate vendor diversity; 'Large' markets serve 50,000-100,000 users with extensive product catalogs; 'Mega' markets exceed 100,000 monthly users with comprehensive vendor networks and represent the highest-risk monitoring targets.", source_file: "cybermarket_kb.jsonl", source_line: 2, source_id: 1, search_text: "cybermarket|markets|sizecluster value_illustration Illustrates the significance of market size classification Size clusters represent market scale and reach: 'Small' markets typically have under 10,000 monthly users and limited vendor presence; 'Medium' markets host 10,000-50,000 monthly users with moderate vendor diversity; 'Large' markets serve 50,000-100,000 users with extensive product catalogs; 'Mega' markets exceed 100,000 monthly users with comprehensive vendor networks and represent the highest-risk monitoring targets."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:2"}) SET n = {id: "cybermarket:2", name: "cybermarket|transactions|paymethod", type: "value_illustration", description: "Explains the significance of different payment methods", definition: "Payment methods represent varying degrees of anonymity and traceability: 'Crypto_A' typically refers to Bitcoin, offering pseudonymous transactions with public ledgers; 'Crypto_B' often indicates Monero or similar privacy coins with enhanced transaction obfuscation; 'Crypto_C' represents emerging or niche cryptocurrencies; 'Token' indicates platform-specific value exchange systems that operate outside traditional blockchain networks.", source_file: "cybermarket_kb.jsonl", source_line: 3, source_id: 2, search_text: "cybermarket|transactions|paymethod value_illustration Explains the significance of different payment methods Payment methods represent varying degrees of anonymity and traceability: 'Crypto_A' typically refers to Bitcoin, offering pseudonymous transactions with public ledgers; 'Crypto_B' often indicates Monero or similar privacy coins with enhanced transaction obfuscation; 'Crypto_C' represents emerging or niche cryptocurrencies; 'Token' indicates platform-specific value exchange systems that operate outside traditional blockchain networks."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:3"}) SET n = {id: "cybermarket:3", name: "cybermarket|transactions|txstatus", type: "value_illustration", description: "Explains the transaction lifecycle stages and their implications", definition: "'Pending' represents initiated but incomplete transactions awaiting verification or escrow conditions; 'Completed' indicates successfully executed transactions with all parties satisfied; 'Cancelled' denotes transactions terminated before completion, often requiring refund processing; 'Disputed' represents contested transactions requiring arbitration, indicating potential fraud or service failure.", source_file: "cybermarket_kb.jsonl", source_line: 4, source_id: 3, search_text: "cybermarket|transactions|txstatus value_illustration Explains the transaction lifecycle stages and their implications 'Pending' represents initiated but incomplete transactions awaiting verification or escrow conditions; 'Completed' indicates successfully executed transactions with all parties satisfied; 'Cancelled' denotes transactions terminated before completion, often requiring refund processing; 'Disputed' represents contested transactions requiring arbitration, indicating potential fraud or service failure."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:4"}) SET n = {id: "cybermarket:4", name: "cybermarket|products|prodtheme", type: "value_illustration", description: "Clarifies product theme classifications and their enforcement implications", definition: "'Digital' products include software, account credentials, and virtual goods requiring no physical shipping; 'Data' encompasses information packages like databases, personal information, and intellectual property; 'Service' refers to activities rather than tangible products, including hacking, documentation, or technical assistance; 'Physical' indicates tangible goods requiring actual shipment through delivery networks, representing the highest exposure risk category.", source_file: "cybermarket_kb.jsonl", source_line: 5, source_id: 4, search_text: "cybermarket|products|prodtheme value_illustration Clarifies product theme classifications and their enforcement implications 'Digital' products include software, account credentials, and virtual goods requiring no physical shipping; 'Data' encompasses information packages like databases, personal information, and intellectual property; 'Service' refers to activities rather than tangible products, including hacking, documentation, or technical assistance; 'Physical' indicates tangible goods requiring actual shipment through delivery networks, representing the highest exposure risk category."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:5"}) SET n = {id: "cybermarket:5", name: "cybermarket|communication|vpnflag", type: "value_illustration", description: "Explains the significance of VPN detection in communication analysis", definition: "'Yes' indicates confirmed VPN usage, demonstrating deliberate attempts to mask true location and identity; 'No' suggests direct connections potentially revealing actual user locations; 'Suspected' indicates communication patterns consistent with VPN usage but lacking definitive confirmation, requiring further investigation to determine the true level of identity obfuscation.", source_file: "cybermarket_kb.jsonl", source_line: 6, source_id: 5, search_text: "cybermarket|communication|vpnflag value_illustration Explains the significance of VPN detection in communication analysis 'Yes' indicates confirmed VPN usage, demonstrating deliberate attempts to mask true location and identity; 'No' suggests direct connections potentially revealing actual user locations; 'Suspected' indicates communication patterns consistent with VPN usage but lacking definitive confirmation, requiring further investigation to determine the true level of identity obfuscation."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:6"}) SET n = {id: "cybermarket:6", name: "cybermarket|communication|langpattern", type: "value_illustration", description: "Explains the significance of language pattern classification", definition: "'Consistent' indicates uniform linguistic patterns suggesting single-user accounts with established communication habits; 'Variable' indicates significant linguistic variations that may signal multiple users sharing an account or automated translation tools; 'Suspicious' denotes deliberate attempts to mask writing style through syntax switching or unnatural language patterns often associated with deception attempts.", source_file: "cybermarket_kb.jsonl", source_line: 7, source_id: 6, search_text: "cybermarket|communication|langpattern value_illustration Explains the significance of language pattern classification 'Consistent' indicates uniform linguistic patterns suggesting single-user accounts with established communication habits; 'Variable' indicates significant linguistic variations that may signal multiple users sharing an account or automated translation tools; 'Suspicious' denotes deliberate attempts to mask writing style through syntax switching or unnatural language patterns often associated with deception attempts."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:7"}) SET n = {id: "cybermarket:7", name: "cybermarket|vendors|vendchecklvl", type: "value_illustration", description: "Illustrates the vendor verification system and trustworthiness indicators", definition: "'Basic' vendors have completed minimal verification steps, typically only email and captcha verification with limited platform history; 'Advanced' vendors have undergone additional verification including identification consistency checks and longer positive platform history; 'Premium' vendors represent the highest verification tier, having submitted verifiable identity elements and maintained extended positive transaction records with minimal disputes.", source_file: "cybermarket_kb.jsonl", source_line: 8, source_id: 7, search_text: "cybermarket|vendors|vendchecklvl value_illustration Illustrates the vendor verification system and trustworthiness indicators 'Basic' vendors have completed minimal verification steps, typically only email and captcha verification with limited platform history; 'Advanced' vendors have undergone additional verification including identification consistency checks and longer positive platform history; 'Premium' vendors represent the highest verification tier, having submitted verifiable identity elements and maintained extended positive transaction records with minimal disputes."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:8"}) SET n = {id: "cybermarket:8", name: "cybermarket|riskanalysis|moneyrisk", type: "value_illustration", description: "Explains the significance of money laundering risk classification", definition: "'Low' indicates minimal risk patterns with transparent transaction flows and consistent monetary behavior; 'Medium' suggests some unusual patterns warranting monitoring but insufficient evidence for immediate action; 'High' represents significant red flags such as rapid fund transfers, unusual transaction chains, or known high-risk wallet associations; 'Unknown' indicates insufficient data to properly assess risk, itself often considered a risk indicator due to potential deliberate obfuscation.", source_file: "cybermarket_kb.jsonl", source_line: 9, source_id: 8, search_text: "cybermarket|riskanalysis|moneyrisk value_illustration Explains the significance of money laundering risk classification 'Low' indicates minimal risk patterns with transparent transaction flows and consistent monetary behavior; 'Medium' suggests some unusual patterns warranting monitoring but insufficient evidence for immediate action; 'High' represents significant red flags such as rapid fund transfers, unusual transaction chains, or known high-risk wallet associations; 'Unknown' indicates insufficient data to properly assess risk, itself often considered a risk indicator due to potential deliberate obfuscation."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:9"}) SET n = {id: "cybermarket:9", name: "cybermarket|securitymonitoring|alertsev", type: "value_illustration", description: "Explains the alert severity classification system", definition: "'Low' alerts indicate minor anomalies requiring minimal attention and posing limited security risk; 'Medium' alerts signal notable deviations from baseline behavior requiring investigation within standard timeframes; 'High' alerts denote significant security concerns demanding prompt attention and intervention; 'Critical' alerts represent severe and immediate security threats requiring urgent action and potential emergency response protocols.", source_file: "cybermarket_kb.jsonl", source_line: 10, source_id: 9, search_text: "cybermarket|securitymonitoring|alertsev value_illustration Explains the alert severity classification system 'Low' alerts indicate minor anomalies requiring minimal attention and posing limited security risk; 'Medium' alerts signal notable deviations from baseline behavior requiring investigation within standard timeframes; 'High' alerts denote significant security concerns demanding prompt attention and intervention; 'Critical' alerts represent severe and immediate security threats requiring urgent action and potential emergency response protocols."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:10"}) SET n = {id: "cybermarket:10", name: "Market Risk Score (MRS)", type: "calculation_knowledge", description: "Calculates overall risk level of a market based on multiple factors", definition: "MRS = \\frac{dlyflow}{1000} + (esccomprate \\times 0.2) + (interscore \\times 0.3) + (vendcount \\times 0.1) - \\frac{mktspan}{100}, \\text{where higher scores indicate greater risk exposure requiring enhanced monitoring.}", source_file: "cybermarket_kb.jsonl", source_line: 11, source_id: 10, search_text: "Market Risk Score (MRS) calculation_knowledge Calculates overall risk level of a market based on multiple factors MRS = \\frac{dlyflow}{1000} + (esccomprate \\times 0.2) + (interscore \\times 0.3) + (vendcount \\times 0.1) - \\frac{mktspan}{100}, \\text{where higher scores indicate greater risk exposure requiring enhanced monitoring.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:11"}) SET n = {id: "cybermarket:11", name: "Vendor Trust Index (VTI)", type: "calculation_knowledge", description: "Measures vendor reliability based on transaction history", definition: "VTI = \\frac{vendsucccount}{vendtxcount} \\times 100 - \\frac{venddisputecount}{vendtxcount} \\times 50 + (vendrate \\times 5), \\text{where higher scores indicate more trustworthy vendors.}", source_file: "cybermarket_kb.jsonl", source_line: 12, source_id: 11, search_text: "Vendor Trust Index (VTI) calculation_knowledge Measures vendor reliability based on transaction history VTI = \\frac{vendsucccount}{vendtxcount} \\times 100 - \\frac{venddisputecount}{vendtxcount} \\times 50 + (vendrate \\times 5), \\text{where higher scores indicate more trustworthy vendors.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:12"}) SET n = {id: "cybermarket:12", name: "Transaction Anomaly Score (TAS)", type: "calculation_knowledge", description: "Detects unusual transactions based on multiple variables", definition: "TAS = \\frac{payamtusd}{1000} \\times \\frac{txfinishhrs}{24} \\times \\left(1 + \\frac{escrowhrs}{100}\\right) \\times \\left(1 - \\frac{esccomprate}{100}\\right), \\text{where esccomprate is from the associated market, and higher scores indicate more suspicious transactions.}", source_file: "cybermarket_kb.jsonl", source_line: 13, source_id: 12, search_text: "Transaction Anomaly Score (TAS) calculation_knowledge Detects unusual transactions based on multiple variables TAS = \\frac{payamtusd}{1000} \\times \\frac{txfinishhrs}{24} \\times \\left(1 + \\frac{escrowhrs}{100}\\right) \\times \\left(1 - \\frac{esccomprate}{100}\\right), \\text{where esccomprate is from the associated market, and higher scores indicate more suspicious transactions.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:13"}) SET n = {id: "cybermarket:13", name: "Communication Security Risk (CSR)", type: "calculation_knowledge", description: "Evaluates the security risk of a communication channel", definition: "CSR = (iptally \\times 5) + (tornodecount \\times 2) + (vpnflag\\_numeric \\times 30) + \\frac{brwsrunique}{10} + (susppatscore \\times 3) + (riskindiccount \\times 4), \\text{where vpnflag\\_numeric maps Yes=1, Suspected=0.5, No=0, and higher scores indicate greater security concerns.}", source_file: "cybermarket_kb.jsonl", source_line: 14, source_id: 13, search_text: "Communication Security Risk (CSR) calculation_knowledge Evaluates the security risk of a communication channel CSR = (iptally \\times 5) + (tornodecount \\times 2) + (vpnflag\\_numeric \\times 30) + \\frac{brwsrunique}{10} + (susppatscore \\times 3) + (riskindiccount \\times 4), \\text{where vpnflag\\_numeric maps Yes=1, Suspected=0.5, No=0, and higher scores indicate greater security concerns.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:14"}) SET n = {id: "cybermarket:14", name: "Wallet Risk Index (WRI)", type: "calculation_knowledge", description: "Assesses the risk level of cryptocurrency wallets", definition: "WRI = (fraudprob \\times 100) + (wallrisksc \\times 0.5) - \\frac{wallage}{30} + (wallturnrt \\times 10) + \\frac{txvel}{10}, \\text{where higher scores indicate potentially suspicious wallet activity.}", source_file: "cybermarket_kb.jsonl", source_line: 15, source_id: 14, search_text: "Wallet Risk Index (WRI) calculation_knowledge Assesses the risk level of cryptocurrency wallets WRI = (fraudprob \\times 100) + (wallrisksc \\times 0.5) - \\frac{wallage}{30} + (wallturnrt \\times 10) + \\frac{txvel}{10}, \\text{where higher scores indicate potentially suspicious wallet activity.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:15"}) SET n = {id: "cybermarket:15", name: "Market Stability Index (MSI)", type: "calculation_knowledge", description: "Measures the operational stability of a market", definition: "MSI = \\frac{mktspan}{365} \\times \\frac{esccomprate}{100} \\times \\left(1 - \\frac{\\sum venddisputecount}{\\sum vendtxcount} \\right) \\times 100, \\text{where higher scores indicate more stable markets less likely to disappear suddenly.}", source_file: "cybermarket_kb.jsonl", source_line: 16, source_id: 15, search_text: "Market Stability Index (MSI) calculation_knowledge Measures the operational stability of a market MSI = \\frac{mktspan}{365} \\times \\frac{esccomprate}{100} \\times \\left(1 - \\frac{\\sum venddisputecount}{\\sum vendtxcount} \\right) \\times 100, \\text{where higher scores indicate more stable markets less likely to disappear suddenly.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:16"}) SET n = {id: "cybermarket:16", name: "Transaction Chain Risk (TCR)", type: "calculation_knowledge", description: "Evaluates the risk level of a transaction chain", definition: "TCR = (txchainlen \\times 10) + (linkedtxcount \\times 5) + (fraudprob \\times 100) - (profilecomplete \\times 0.5) - (idverifyscore \\times 0.5), \\text{where higher scores indicate higher risk transaction chains.}", source_file: "cybermarket_kb.jsonl", source_line: 17, source_id: 16, search_text: "Transaction Chain Risk (TCR) calculation_knowledge Evaluates the risk level of a transaction chain TCR = (txchainlen \\times 10) + (linkedtxcount \\times 5) + (fraudprob \\times 100) - (profilecomplete \\times 0.5) - (idverifyscore \\times 0.5), \\text{where higher scores indicate higher risk transaction chains.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:17"}) SET n = {id: "cybermarket:17", name: "Security Posture Score (SPS)", type: "calculation_knowledge", description: "Evaluates the overall security posture of an entity", definition: "SPS = (100 - (vulntally \\times 5)) + (securitymeasurecount \\times 2) + (sessionsecurityscore \\times 0.5) + (privprotscore \\times 0.3) - (fpprob \\times 100), \\text{where higher scores indicate stronger security postures.}", source_file: "cybermarket_kb.jsonl", source_line: 18, source_id: 17, search_text: "Security Posture Score (SPS) calculation_knowledge Evaluates the overall security posture of an entity SPS = (100 - (vulntally \\times 5)) + (securitymeasurecount \\times 2) + (sessionsecurityscore \\times 0.5) + (privprotscore \\times 0.3) - (fpprob \\times 100), \\text{where higher scores indicate stronger security postures.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:18"}) SET n = {id: "cybermarket:18", name: "Investigation Priority Score (IPS)", type: "calculation_knowledge", description: "Determines how urgently an investigation should be handled", definition: "IPS = (lawinterest\\_numeric \\times 30) + (regrisklvl\\_numeric \\times 20) + (fraudprob \\times 100) - (compliancescore \\times 0.5) + (notescount \\times 2), \\text{where lawinterest\\_numeric and regrisklvl\\_numeric map Low=1, Medium=2, High=3, Unknown=2, and higher scores indicate higher priority.}", source_file: "cybermarket_kb.jsonl", source_line: 19, source_id: 18, search_text: "Investigation Priority Score (IPS) calculation_knowledge Determines how urgently an investigation should be handled IPS = (lawinterest\\_numeric \\times 30) + (regrisklvl\\_numeric \\times 20) + (fraudprob \\times 100) - (compliancescore \\times 0.5) + (notescount \\times 2), \\text{where lawinterest\\_numeric and regrisklvl\\_numeric map Low=1, Medium=2, High=3, Unknown=2, and higher scores indicate higher priority.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:19"}) SET n = {id: "cybermarket:19", name: "Anonymity Protection Level (APL)", type: "calculation_knowledge", description: "Measures how well a user's identity is protected", definition: "APL = (vpnflag\\_numeric \\times 30) + (tornodecount \\times 2) + (encryptmethod\\_numeric \\times 15) + (connpatscore \\times 0.2) + \\frac{brwsrunique}{20}, \\text{where vpnflag\\_numeric maps Yes=1, Suspected=0.5, No=0, encryptmethod\\_numeric maps Standard=1, Enhanced=2, Custom=3, else=0 and higher scores indicate stronger anonymity protections.}", source_file: "cybermarket_kb.jsonl", source_line: 20, source_id: 19, search_text: "Anonymity Protection Level (APL) calculation_knowledge Measures how well a user's identity is protected APL = (vpnflag\\_numeric \\times 30) + (tornodecount \\times 2) + (encryptmethod\\_numeric \\times 15) + (connpatscore \\times 0.2) + \\frac{brwsrunique}{20}, \\text{where vpnflag\\_numeric maps Yes=1, Suspected=0.5, No=0, encryptmethod\\_numeric maps Standard=1, Enhanced=2, Custom=3, else=0 and higher scores indicate stronger anonymity protections.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:20"}) SET n = {id: "cybermarket:20", name: "High-Risk Market", type: "domain_knowledge", description: "Identifies markets with significant operational risk factors", definition: "A market with MRS > 500, having more than 100 vendors, a daily flow exceeding 5000 transactions, and at least one 'High' security alert. These markets typically have the highest potential for illicit activity and represent priority monitoring targets for investigators.", source_file: "cybermarket_kb.jsonl", source_line: 21, source_id: 20, search_text: "High-Risk Market domain_knowledge Identifies markets with significant operational risk factors A market with MRS > 500, having more than 100 vendors, a daily flow exceeding 5000 transactions, and at least one 'High' security alert. These markets typically have the highest potential for illicit activity and represent priority monitoring targets for investigators."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:21"}) SET n = {id: "cybermarket:21", name: "Trusted Vendor", type: "domain_knowledge", description: "Identifies vendors with established positive reputation", definition: "A vendor with VTI > 80, vendchecklvl of 'Advanced' or 'Premium', a dispute rate below 5% of total transactions, and an active history exceeding 90 days. These vendors represent stabilizing forces within markets and typically pose lower immediate enforcement priorities.", source_file: "cybermarket_kb.jsonl", source_line: 22, source_id: 21, search_text: "Trusted Vendor domain_knowledge Identifies vendors with established positive reputation A vendor with VTI > 80, vendchecklvl of 'Advanced' or 'Premium', a dispute rate below 5% of total transactions, and an active history exceeding 90 days. These vendors represent stabilizing forces within markets and typically pose lower immediate enforcement priorities."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:22"}) SET n = {id: "cybermarket:22", name: "Suspicious Transaction Pattern", type: "domain_knowledge", description: "Identifies transactions with characteristics suggesting potential illegal activity", definition: "A transaction with TAS > 75, payment in privacy-focused cryptocurrencies (Crypto_B), escrow disabled or minimized (escrowused = 'No' or escrowhrs < 24), and unusual routing complexity (routecomplexity = 'Complex'). These transactions often represent high-risk activities requiring further investigation.", source_file: "cybermarket_kb.jsonl", source_line: 23, source_id: 22, search_text: "Suspicious Transaction Pattern domain_knowledge Identifies transactions with characteristics suggesting potential illegal activity A transaction with TAS > 75, payment in privacy-focused cryptocurrencies (Crypto_B), escrow disabled or minimized (escrowused = 'No' or escrowhrs < 24), and unusual routing complexity (routecomplexity = 'Complex'). These transactions often represent high-risk activities requiring further investigation."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:23"}) SET n = {id: "cybermarket:23", name: "Money Laundering Indicator", type: "domain_knowledge", description: "Identifies transaction patterns consistent with money laundering", definition: "A transaction chain with TCR > 150, involving wallets less than 30 days old (wallage < 30), high turnover rates (wallturnrt > 5), and at least 3 linked transactions (linkedtxcount >= 3). These patterns often indicate attempts to obscure the source or destination of funds.", source_file: "cybermarket_kb.jsonl", source_line: 24, source_id: 23, search_text: "Money Laundering Indicator domain_knowledge Identifies transaction patterns consistent with money laundering A transaction chain with TCR > 150, involving wallets less than 30 days old (wallage < 30), high turnover rates (wallturnrt > 5), and at least 3 linked transactions (linkedtxcount >= 3). These patterns often indicate attempts to obscure the source or destination of funds."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:24"}) SET n = {id: "cybermarket:24", name: "High-Security Entity", type: "domain_knowledge", description: "Identifies entities with strong security practices", definition: "An entity with SPS > 80, using military-grade encryption, implementing 2FA or multi-factor authentication, and maintaining fewer than 5 vulnerabilities (vulntally < 5). These entities represent lower security breach risks but may indicate sophisticated operators requiring specialized investigation approaches.", source_file: "cybermarket_kb.jsonl", source_line: 25, source_id: 24, search_text: "High-Security Entity domain_knowledge Identifies entities with strong security practices An entity with SPS > 80, using military-grade encryption, implementing 2FA or multi-factor authentication, and maintaining fewer than 5 vulnerabilities (vulntally < 5). These entities represent lower security breach risks but may indicate sophisticated operators requiring specialized investigation approaches."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:25"}) SET n = {id: "cybermarket:25", name: "Priority Investigation Target", type: "domain_knowledge", description: "Identifies cases requiring immediate investigative attention", definition: "An investigation with IPS > 200, high law enforcement interest (lawinterest = 'High'), involving a suspicious transaction pattern, and connected to a high-risk market. These cases represent the highest priority for resource allocation and immediate intervention.", source_file: "cybermarket_kb.jsonl", source_line: 26, source_id: 25, search_text: "Priority Investigation Target domain_knowledge Identifies cases requiring immediate investigative attention An investigation with IPS > 200, high law enforcement interest (lawinterest = 'High'), involving a suspicious transaction pattern, and connected to a high-risk market. These cases represent the highest priority for resource allocation and immediate intervention."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:26"}) SET n = {id: "cybermarket:26", name: "Identity-Protected User", type: "domain_knowledge", description: "Identifies users with robust anonymity protections", definition: "A user with APL > 100, consistently using TOR (tornodecount > 20), employing VPN protection (vpnflag = 'Yes'), and utilizing custom encryption methods. These users demonstrate sophisticated operational security requiring specialized investigation techniques.", source_file: "cybermarket_kb.jsonl", source_line: 27, source_id: 26, search_text: "Identity-Protected User domain_knowledge Identifies users with robust anonymity protections A user with APL > 100, consistently using TOR (tornodecount > 20), employing VPN protection (vpnflag = 'Yes'), and utilizing custom encryption methods. These users demonstrate sophisticated operational security requiring specialized investigation techniques."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:27"}) SET n = {id: "cybermarket:27", name: "Market Migration Indicator", type: "domain_knowledge", description: "Identifies signs of users migrating between markets", definition: "A pattern where multiple vendors (vendregistry) and buyers (buyregistry) associated with one market (mktregistry) begin appearing on another market within a short timeframe (less than 30 days), often following security incidents or market instability. These migrations typically indicate market disruption events requiring adjustments to monitoring priorities.", source_file: "cybermarket_kb.jsonl", source_line: 28, source_id: 27, search_text: "Market Migration Indicator domain_knowledge Identifies signs of users migrating between markets A pattern where multiple vendors (vendregistry) and buyers (buyregistry) associated with one market (mktregistry) begin appearing on another market within a short timeframe (less than 30 days), often following security incidents or market instability. These migrations typically indicate market disruption events requiring adjustments to monitoring priorities."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:28"}) SET n = {id: "cybermarket:28", name: "Sophisticated Operational Security", type: "domain_knowledge", description: "Identifies entities employing advanced security practices", definition: "An entity demonstrating APL > 120, consistently using variable language patterns (langpattern = 'Variable'), maintaining minimal communication (msgtally < 10), and employing multiple transaction chains (txchainlen > 5). These patterns indicate professional-level operational security possibly linking to organized criminal activity.", source_file: "cybermarket_kb.jsonl", source_line: 29, source_id: 28, search_text: "Sophisticated Operational Security domain_knowledge Identifies entities employing advanced security practices An entity demonstrating APL > 120, consistently using variable language patterns (langpattern = 'Variable'), maintaining minimal communication (msgtally < 10), and employing multiple transaction chains (txchainlen > 5). These patterns indicate professional-level operational security possibly linking to organized criminal activity."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:29"}) SET n = {id: "cybermarket:29", name: "Cross-Platform Operator", type: "domain_knowledge", description: "Identifies entities operating across multiple cybermarket platforms", definition: "An entity identified through matching cryptographic or communication fingerprints (keymatchcount > 30) operating on three or more markets simultaneously, maintaining consistent security practices, and exhibiting similar transaction patterns across platforms. These operators represent higher-value intelligence targets due to their broader cybermarket ecosystem involvement.", source_file: "cybermarket_kb.jsonl", source_line: 30, source_id: 29, search_text: "Cross-Platform Operator domain_knowledge Identifies entities operating across multiple cybermarket platforms An entity identified through matching cryptographic or communication fingerprints (keymatchcount > 30) operating on three or more markets simultaneously, maintaining consistent security practices, and exhibiting similar transaction patterns across platforms. These operators represent higher-value intelligence targets due to their broader cybermarket ecosystem involvement."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:30"}) SET n = {id: "cybermarket:30", name: "Market Vulnerability Index (MVI)", type: "calculation_knowledge", description: "Evaluates a market's susceptibility to disruption or shutdown", definition: "MVI = (100 - MSI) + (COUNT(CASE WHEN alertsev IS NOT NULL THEN 1 END) / 10) \\times (alertsev_numeric \\times 2) - (vendcount \\times 0.05) + (COUNT(CASE WHEN lawinterest = 'High' THEN 1 END) / 5), \\text{where alertsev_numeric maps Low=1, Medium=2, High=3, Critical=4 as defined in the alert severity system, and higher scores indicate greater vulnerability to disruption.}", source_file: "cybermarket_kb.jsonl", source_line: 31, source_id: 30, search_text: "Market Vulnerability Index (MVI) calculation_knowledge Evaluates a market's susceptibility to disruption or shutdown MVI = (100 - MSI) + (COUNT(CASE WHEN alertsev IS NOT NULL THEN 1 END) / 10) \\times (alertsev_numeric \\times 2) - (vendcount \\times 0.05) + (COUNT(CASE WHEN lawinterest = 'High' THEN 1 END) / 5), \\text{where alertsev_numeric maps Low=1, Medium=2, High=3, Critical=4 as defined in the alert severity system, and higher scores indicate greater vulnerability to disruption.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:31"}) SET n = {id: "cybermarket:31", name: "Vendor Network Centrality (VNC)", type: "calculation_knowledge", description: "Measures a vendor's connectedness within the market ecosystem", definition: "VNC = (COUNT(DISTINCT mktref) \\times 5) + \\frac{vendtxcount}{50} + (VTI \\times 0.1) - (1 - sizecluster_numeric) \\times 10, \\text{where sizecluster_numeric maps Small=1, Medium=2, Large=3, Mega=4 as described in the market size classification, and higher scores indicate more central market positioning.}", source_file: "cybermarket_kb.jsonl", source_line: 32, source_id: 31, search_text: "Vendor Network Centrality (VNC) calculation_knowledge Measures a vendor's connectedness within the market ecosystem VNC = (COUNT(DISTINCT mktref) \\times 5) + \\frac{vendtxcount}{50} + (VTI \\times 0.1) - (1 - sizecluster_numeric) \\times 10, \\text{where sizecluster_numeric maps Small=1, Medium=2, Large=3, Mega=4 as described in the market size classification, and higher scores indicate more central market positioning.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:32"}) SET n = {id: "cybermarket:32", name: "Product Risk Exposure (PRE)", type: "calculation_knowledge", description: "Quantifies the regulatory exposure risk associated with product listings", definition: "PRE = prodtheme_weight + (escrowused_numeric \\times 10) - \\frac{escrowhrs}{24} + \\frac{payamtusd}{500}, \\text{where prodtheme_weight assigns Digital=10, Data=20, Service=30, Physical=50 based on the product theme classification, and escrowused_numeric is 0 if escrow is used and 1 if not.}", source_file: "cybermarket_kb.jsonl", source_line: 33, source_id: 32, search_text: "Product Risk Exposure (PRE) calculation_knowledge Quantifies the regulatory exposure risk associated with product listings PRE = prodtheme_weight + (escrowused_numeric \\times 10) - \\frac{escrowhrs}{24} + \\frac{payamtusd}{500}, \\text{where prodtheme_weight assigns Digital=10, Data=20, Service=30, Physical=50 based on the product theme classification, and escrowused_numeric is 0 if escrow is used and 1 if not.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:33"}) SET n = {id: "cybermarket:33", name: "Communication Pattern Risk (CPR)", type: "calculation_knowledge", description: "Evaluates how suspicious a communication pattern is based on multiple factors", definition: "CPR = (langpattern_numeric \\times 15) + (CSR \\times 0.2) + (msgtally \\times 0.5) - (1 - vpnflag_numeric) \\times 20, \\text{where langpattern_numeric maps Consistent=1, Variable=2, Suspicious=3 as explained in the language pattern classification, and higher scores represent more suspicious communication behavior.}", source_file: "cybermarket_kb.jsonl", source_line: 34, source_id: 33, search_text: "Communication Pattern Risk (CPR) calculation_knowledge Evaluates how suspicious a communication pattern is based on multiple factors CPR = (langpattern_numeric \\times 15) + (CSR \\times 0.2) + (msgtally \\times 0.5) - (1 - vpnflag_numeric) \\times 20, \\text{where langpattern_numeric maps Consistent=1, Variable=2, Suspicious=3 as explained in the language pattern classification, and higher scores represent more suspicious communication behavior.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:34"}) SET n = {id: "cybermarket:34", name: "Transaction Velocity Metric (TVM)", type: "calculation_knowledge", description: "Measures the rapidity and volume of transactions from a single source", definition: "TVM = \\frac{COUNT(txregistry)}{(MAX(eventstamp) - MIN(eventstamp))} \\times \\frac{payamtusd}{500} \\times (1 + (paymethod\\_weight \\times 0.1)), \\text{where paymethod\\_weight assigns Crypto\\_A=1, Crypto\\_B=3, Crypto\\_C=2, Token=2 based on the payment method classifications defined in cybermarket|transactions|paymethod, and higher values indicate potentially suspicious transaction velocity.}", source_file: "cybermarket_kb.jsonl", source_line: 35, source_id: 34, search_text: "Transaction Velocity Metric (TVM) calculation_knowledge Measures the rapidity and volume of transactions from a single source TVM = \\frac{COUNT(txregistry)}{(MAX(eventstamp) - MIN(eventstamp))} \\times \\frac{payamtusd}{500} \\times (1 + (paymethod\\_weight \\times 0.1)), \\text{where paymethod\\_weight assigns Crypto\\_A=1, Crypto\\_B=3, Crypto\\_C=2, Token=2 based on the payment method classifications defined in cybermarket|transactions|paymethod, and higher values indicate potentially suspicious transaction velocity.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:35"}) SET n = {id: "cybermarket:35", name: "Market Diversification Score (MDS)", type: "calculation_knowledge", description: "Evaluates the diversity of products and vendors within a market", definition: "MDS = \\frac{COUNT(DISTINCT prodsubcat)}{5} + \\frac{vendcount}{50} + \\frac{COUNT(txregistry)}{vendcount} \\times 0.5 - \\frac{mktclass\\_weight}{10}, \\text{where mktclass\\_weight assigns Forum=1, Service=2, Marketplace=4, Exchange=3 as per the market classification system defined in cybermarket|markets|mktclass, and higher scores represent greater market diversification.}", source_file: "cybermarket_kb.jsonl", source_line: 36, source_id: 35, search_text: "Market Diversification Score (MDS) calculation_knowledge Evaluates the diversity of products and vendors within a market MDS = \\frac{COUNT(DISTINCT prodsubcat)}{5} + \\frac{vendcount}{50} + \\frac{COUNT(txregistry)}{vendcount} \\times 0.5 - \\frac{mktclass\\_weight}{10}, \\text{where mktclass\\_weight assigns Forum=1, Service=2, Marketplace=4, Exchange=3 as per the market classification system defined in cybermarket|markets|mktclass, and higher scores represent greater market diversification.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:36"}) SET n = {id: "cybermarket:36", name: "Operational Security Index (OSI)", type: "calculation_knowledge", description: "Quantifies an entity's operational security practices", definition: "OSI = (APL \\times 0.5) + (SPS \\times 0.2) + (tornodecount \\times 2) + (CASE WHEN encryptmethod = 'Standard' THEN 1 WHEN encryptmethod = 'Enhanced' THEN 2 WHEN encryptmethod = 'Custom' THEN 3 ELSE 0 END \\times 5) - (iptally \\times 0.5), \\text{where APL and SPS are defined by the Anonymity Protection Level and Security Posture Score respectively, and higher scores indicate stronger operational security.}", source_file: "cybermarket_kb.jsonl", source_line: 37, source_id: 36, search_text: "Operational Security Index (OSI) calculation_knowledge Quantifies an entity's operational security practices OSI = (APL \\times 0.5) + (SPS \\times 0.2) + (tornodecount \\times 2) + (CASE WHEN encryptmethod = 'Standard' THEN 1 WHEN encryptmethod = 'Enhanced' THEN 2 WHEN encryptmethod = 'Custom' THEN 3 ELSE 0 END \\times 5) - (iptally \\times 0.5), \\text{where APL and SPS are defined by the Anonymity Protection Level and Security Posture Score respectively, and higher scores indicate stronger operational security.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:37"}) SET n = {id: "cybermarket:37", name: "Vendor Relationship Strength (VRS)", type: "calculation_knowledge", description: "Measures the strength of relationships between a vendor and their customers", definition: "VRS = (vendrate \\times 10) + \\frac{vendsucccount}{vendtxcount} \\times 50 + (vendchecklvl_numeric \\times 15) - \\frac{venddisputecount}{vendtxcount} \\times 100, \\text{where vendchecklvl_numeric maps Basic=1, Advanced=2, Premium=3, else=0 according to the vendor verification system, and higher scores represent stronger vendor-customer relationships.}", source_file: "cybermarket_kb.jsonl", source_line: 38, source_id: 37, search_text: "Vendor Relationship Strength (VRS) calculation_knowledge Measures the strength of relationships between a vendor and their customers VRS = (vendrate \\times 10) + \\frac{vendsucccount}{vendtxcount} \\times 50 + (vendchecklvl_numeric \\times 15) - \\frac{venddisputecount}{vendtxcount} \\times 100, \\text{where vendchecklvl_numeric maps Basic=1, Advanced=2, Premium=3, else=0 according to the vendor verification system, and higher scores represent stronger vendor-customer relationships.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:38"}) SET n = {id: "cybermarket:38", name: "Cross-Platform Risk Amplification (CPRA)", type: "calculation_knowledge", description: "Measures how risk increases when an entity operates across multiple platforms", definition: "CPRA = (keymatchcount \\times 3) + (COUNT(DISTINCT mktref) \\times 10) + (WRI \\times 0.2) + (\\frac{mktspan}{365} \\times 5) - (\\frac{compliancescore}{20}), \\text{where WRI is defined by the Wallet Risk Index, platformcount is the count of distinct markets an entity operates on, and higher values indicate greater cross-platform risk.}", source_file: "cybermarket_kb.jsonl", source_line: 39, source_id: 38, search_text: "Cross-Platform Risk Amplification (CPRA) calculation_knowledge Measures how risk increases when an entity operates across multiple platforms CPRA = (keymatchcount \\times 3) + (COUNT(DISTINCT mktref) \\times 10) + (WRI \\times 0.2) + (\\frac{mktspan}{365} \\times 5) - (\\frac{compliancescore}{20}), \\text{where WRI is defined by the Wallet Risk Index, platformcount is the count of distinct markets an entity operates on, and higher values indicate greater cross-platform risk.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:39"}) SET n = {id: "cybermarket:39", name: "Money Flow Complexity (MFC)", type: "calculation_knowledge", description: "Quantifies the complexity of money flows in transaction chains", definition: "MFC = (txchainlen \\times 5) + (linkedtxcount \\times 3) + (moneyrisk_numeric \\times 15) + (TCR \\times 0.2) - (profilecomplete \\times 10), \\text{where moneyrisk_numeric maps Low=1, Medium=2, High=3, Unknown=2 according to the money laundering risk classification, and higher scores indicate more complex money flows.}", source_file: "cybermarket_kb.jsonl", source_line: 40, source_id: 39, search_text: "Money Flow Complexity (MFC) calculation_knowledge Quantifies the complexity of money flows in transaction chains MFC = (txchainlen \\times 5) + (linkedtxcount \\times 3) + (moneyrisk_numeric \\times 15) + (TCR \\times 0.2) - (profilecomplete \\times 10), \\text{where moneyrisk_numeric maps Low=1, Medium=2, High=3, Unknown=2 according to the money laundering risk classification, and higher scores indicate more complex money flows.}"};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:40"}) SET n = {id: "cybermarket:40", name: "Unstable Market", type: "domain_knowledge", description: "Identifies markets at high risk of imminent shutdown or disruption", definition: "A market with MVI > 75, MSI < 40, and at least one 'Critical' security alert (alertsev = 'Critical'). These markets typically show signs of administrative instability, declining transaction volumes, and may suggest potential exit scam preparation or law enforcement attention.", source_file: "cybermarket_kb.jsonl", source_line: 41, source_id: 40, search_text: "Unstable Market domain_knowledge Identifies markets at high risk of imminent shutdown or disruption A market with MVI > 75, MSI < 40, and at least one 'Critical' security alert (alertsev = 'Critical'). These markets typically show signs of administrative instability, declining transaction volumes, and may suggest potential exit scam preparation or law enforcement attention."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:41"}) SET n = {id: "cybermarket:41", name: "Market Kingpin", type: "domain_knowledge", description: "Identifies vendors with exceptional influence and reach across multiple markets", definition: "A vendor with VNC > 85, operating on at least 3 different markets (COUNT(DISTINCT mktref) >= 3), with 'Premium' verification level (vendchecklvl = 'Premium'), and displaying the characteristics of a Trusted Vendor. These operators represent significant intelligence targets due to their wide-reaching influence.", source_file: "cybermarket_kb.jsonl", source_line: 42, source_id: 41, search_text: "Market Kingpin domain_knowledge Identifies vendors with exceptional influence and reach across multiple markets A vendor with VNC > 85, operating on at least 3 different markets (COUNT(DISTINCT mktref) >= 3), with 'Premium' verification level (vendchecklvl = 'Premium'), and displaying the characteristics of a Trusted Vendor. These operators represent significant intelligence targets due to their wide-reaching influence."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:42"}) SET n = {id: "cybermarket:42", name: "High-Exposure Product", type: "domain_knowledge", description: "Identifies products with elevated regulatory risk factors", definition: "A product with PRE > 60, in the 'Physical' theme category as defined in the product theme classification, without escrow protection (escrowused = 'No'), and transacted with privacy-focused cryptocurrency (paymethod = 'Crypto_B'). These products require immediate monitoring due to their heightened risk profile.", source_file: "cybermarket_kb.jsonl", source_line: 43, source_id: 42, search_text: "High-Exposure Product domain_knowledge Identifies products with elevated regulatory risk factors A product with PRE > 60, in the 'Physical' theme category as defined in the product theme classification, without escrow protection (escrowused = 'No'), and transacted with privacy-focused cryptocurrency (paymethod = 'Crypto_B'). These products require immediate monitoring due to their heightened risk profile."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:43"}) SET n = {id: "cybermarket:43", name: "Deceptive Communication Pattern", type: "domain_knowledge", description: "Identifies communication exhibiting signs of deliberate deception", definition: "A communication with CPR > 70, 'Suspicious' language patterns as defined in the language pattern classification, high CSR values (CSR > 80), and frequently changing connection parameters. These patterns suggest deliberate attempts to obfuscate identity and intentions.", source_file: "cybermarket_kb.jsonl", source_line: 44, source_id: 43, search_text: "Deceptive Communication Pattern domain_knowledge Identifies communication exhibiting signs of deliberate deception A communication with CPR > 70, 'Suspicious' language patterns as defined in the language pattern classification, high CSR values (CSR > 80), and frequently changing connection parameters. These patterns suggest deliberate attempts to obfuscate identity and intentions."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:44"}) SET n = {id: "cybermarket:44", name: "Flash Transaction Cluster", type: "domain_knowledge", description: "Identifies unusually rapid transaction sequences potentially indicating coordinated activity", definition: "A group of transactions with TVM > 50 from related sources, using privacy-focused cryptocurrencies (paymethod = 'Crypto_B') as defined in the payment method classification, completed within a short timeframe (MAX(eventstamp) - MIN(eventstamp) < 24 hours), and involving minimal escrow time (escrowhrs < 12). Such clusters often indicate coordinated market manipulation or 'smurfing' behavior.", source_file: "cybermarket_kb.jsonl", source_line: 45, source_id: 44, search_text: "Flash Transaction Cluster domain_knowledge Identifies unusually rapid transaction sequences potentially indicating coordinated activity A group of transactions with TVM > 50 from related sources, using privacy-focused cryptocurrencies (paymethod = 'Crypto_B') as defined in the payment method classification, completed within a short timeframe (MAX(eventstamp) - MIN(eventstamp) < 24 hours), and involving minimal escrow time (escrowhrs < 12). Such clusters often indicate coordinated market manipulation or 'smurfing' behavior."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:45"}) SET n = {id: "cybermarket:45", name: "Diversified Marketplace", type: "domain_knowledge", description: "Identifies markets with exceptional product and vendor diversity", definition: "A market with MDS > 65, at least 15 distinct product categories (COUNT(DISTINCT prodsubcat) >= 15), high vendor count (vendcount > 200), and 'Marketplace' classification (mktclass = 'Marketplace') as defined in the market classification system. These markets typically present challenging enforcement targets due to their diversified nature.", source_file: "cybermarket_kb.jsonl", source_line: 46, source_id: 45, search_text: "Diversified Marketplace domain_knowledge Identifies markets with exceptional product and vendor diversity A market with MDS > 65, at least 15 distinct product categories (COUNT(DISTINCT prodsubcat) >= 15), high vendor count (vendcount > 200), and 'Marketplace' classification (mktclass = 'Marketplace') as defined in the market classification system. These markets typically present challenging enforcement targets due to their diversified nature."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:46"}) SET n = {id: "cybermarket:46", name: "OpSec Specialist", type: "domain_knowledge", description: "Identifies entities employing exceptionally sophisticated operational security", definition: "An entity with OSI > 85, demonstrating Sophisticated Operational Security characteristics, with exceptionally high APL scores (APL > 120), and using either 'Enhanced' or 'Custom' encryption methods (encryptmethod IN ('Enhanced', 'Custom')). These entities represent high-value intelligence targets requiring specialized investigation techniques.", source_file: "cybermarket_kb.jsonl", source_line: 47, source_id: 46, search_text: "OpSec Specialist domain_knowledge Identifies entities employing exceptionally sophisticated operational security An entity with OSI > 85, demonstrating Sophisticated Operational Security characteristics, with exceptionally high APL scores (APL > 120), and using either 'Enhanced' or 'Custom' encryption methods (encryptmethod IN ('Enhanced', 'Custom')). These entities represent high-value intelligence targets requiring specialized investigation techniques."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:47"}) SET n = {id: "cybermarket:47", name: "Customer Loyalty Network", type: "domain_knowledge", description: "Identifies vendor-customer networks with unusual loyalty patterns", definition: "A network centered on a vendor with VRS > 90, having repeated transactions with the same buyers (> 5 transactions per buyer), receiving exceptionally high ratings (vendrate > 4.8), and 'Advanced' or 'Premium' verification level as defined in the vendor verification system. These networks often indicate established trust circles warranting deeper investigation.", source_file: "cybermarket_kb.jsonl", source_line: 48, source_id: 47, search_text: "Customer Loyalty Network domain_knowledge Identifies vendor-customer networks with unusual loyalty patterns A network centered on a vendor with VRS > 90, having repeated transactions with the same buyers (> 5 transactions per buyer), receiving exceptionally high ratings (vendrate > 4.8), and 'Advanced' or 'Premium' verification level as defined in the vendor verification system. These networks often indicate established trust circles warranting deeper investigation."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:48"}) SET n = {id: "cybermarket:48", name: "Multi-Platform Threat Entity", type: "domain_knowledge", description: "Identifies high-risk entities operating across multiple cybermarket platforms", definition: "An entity with CPRA > 80, displaying Cross-Platform Operator characteristics, with high Wallet Risk Index scores (WRI > 70), and consistently employing the same operational security tactics across platforms. These entities represent priority targets for coordinated investigation efforts due to their expanded reach.", source_file: "cybermarket_kb.jsonl", source_line: 49, source_id: 48, search_text: "Multi-Platform Threat Entity domain_knowledge Identifies high-risk entities operating across multiple cybermarket platforms An entity with CPRA > 80, displaying Cross-Platform Operator characteristics, with high Wallet Risk Index scores (WRI > 70), and consistently employing the same operational security tactics across platforms. These entities represent priority targets for coordinated investigation efforts due to their expanded reach."};
MERGE (n:Knowledge:SemanticSearch {id: "cybermarket:49"}) SET n = {id: "cybermarket:49", name: "Complex Money Laundering Operation", type: "domain_knowledge", description: "Identifies sophisticated financial obfuscation schemes", definition: "A transaction network with MFC > 90, displaying Money Laundering Indicator characteristics, high TCR scores (TCR > 180), and 'High' money laundering risk classification as defined in the money laundering risk system. These operations represent the most sophisticated financial obfuscation attempts requiring specialized financial investigation approaches.", source_file: "cybermarket_kb.jsonl", source_line: 50, source_id: 49, search_text: "Complex Money Laundering Operation domain_knowledge Identifies sophisticated financial obfuscation schemes A transaction network with MFC > 90, displaying Money Laundering Indicator characteristics, high TCR scores (TCR > 180), and 'High' money laundering risk classification as defined in the money laundering risk system. These operations represent the most sophisticated financial obfuscation attempts requiring specialized financial investigation approaches."};
MATCH (d:Database {id: "disaster"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "disaster:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "disaster:" DELETE r;
MATCH (stale:Knowledge) WHERE stale.id STARTS WITH "disaster:" AND NOT stale.id IN ["disaster:0", "disaster:1", "disaster:2", "disaster:3", "disaster:4", "disaster:5", "disaster:6", "disaster:7", "disaster:8", "disaster:9", "disaster:10", "disaster:11", "disaster:12", "disaster:13", "disaster:14", "disaster:15", "disaster:16", "disaster:17", "disaster:18", "disaster:19", "disaster:20", "disaster:21", "disaster:22", "disaster:23", "disaster:24", "disaster:25", "disaster:26", "disaster:27", "disaster:28", "disaster:29", "disaster:30", "disaster:31", "disaster:32", "disaster:33", "disaster:34", "disaster:35", "disaster:36", "disaster:37", "disaster:38", "disaster:39", "disaster:40", "disaster:41", "disaster:42", "disaster:43", "disaster:44", "disaster:45", "disaster:46", "disaster:47", "disaster:48", "disaster:49", "disaster:50", "disaster:51", "disaster:52", "disaster:53"] DETACH DELETE stale;
MERGE (n:Knowledge:SemanticSearch {id: "disaster:0"}) SET n = {id: "disaster:0", name: "hazlevel", type: "value_illustration", description: "Illustrates the severity classification of disaster events", definition: "Level 1 represents minimal threat, Level 2 indicates moderate danger, Level 3 shows significant hazard, Level 4 denotes severe emergency situation, and Level 5 signifies catastrophic conditions requiring maximum response", source_file: "disaster_kb.jsonl", source_line: 1, source_id: 0, search_text: "hazlevel value_illustration Illustrates the severity classification of disaster events Level 1 represents minimal threat, Level 2 indicates moderate danger, Level 3 shows significant hazard, Level 4 denotes severe emergency situation, and Level 5 signifies catastrophic conditions requiring maximum response"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:1"}) SET n = {id: "disaster:1", name: "emerglevel", type: "value_illustration", description: "Illustrates the color-coded emergency classification system", definition: "Yellow indicates monitoring phase with minimal activation, Orange represents partial activation with elevated alert, Red signifies full activation for serious emergencies, and Black denotes critical emergency situations requiring all available resources", source_file: "disaster_kb.jsonl", source_line: 2, source_id: 1, search_text: "emerglevel value_illustration Illustrates the color-coded emergency classification system Yellow indicates monitoring phase with minimal activation, Orange represents partial activation with elevated alert, Red signifies full activation for serious emergencies, and Black denotes critical emergency situations requiring all available resources"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:2"}) SET n = {id: "disaster:2", name: "respphase", type: "value_illustration", description: "Illustrates the progression of disaster response operations", definition: "Initial phase focuses on immediate life-saving actions, Emergency phase addresses critical needs and stabilization, Recovery phase works on restoring basic services and infrastructure, and Reconstruction phase involves long-term rebuilding efforts", source_file: "disaster_kb.jsonl", source_line: 3, source_id: 2, search_text: "respphase value_illustration Illustrates the progression of disaster response operations Initial phase focuses on immediate life-saving actions, Emergency phase addresses critical needs and stabilization, Recovery phase works on restoring basic services and infrastructure, and Reconstruction phase involves long-term rebuilding efforts"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:3"}) SET n = {id: "disaster:3", name: "lastmilestatus", type: "value_illustration", description: "Illustrates the state of final delivery operations to affected populations", definition: "On Track indicates deliveries proceeding as scheduled, Delayed shows deliveries facing non-critical setbacks, and Suspended means deliveries have temporarily halted due to severe constraints", source_file: "disaster_kb.jsonl", source_line: 4, source_id: 3, search_text: "lastmilestatus value_illustration Illustrates the state of final delivery operations to affected populations On Track indicates deliveries proceeding as scheduled, Delayed shows deliveries facing non-critical setbacks, and Suspended means deliveries have temporarily halted due to severe constraints"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:4"}) SET n = {id: "disaster:4", name: "fundingstate", type: "value_illustration", description: "Illustrates the financial resource condition for operations", definition: "Adequate means sufficient funds available for current operations, Limited indicates funding constraints affecting some activities, and Critical represents severe funding shortages threatening essential operations", source_file: "disaster_kb.jsonl", source_line: 5, source_id: 4, search_text: "fundingstate value_illustration Illustrates the financial resource condition for operations Adequate means sufficient funds available for current operations, Limited indicates funding constraints affecting some activities, and Critical represents severe funding shortages threatening essential operations"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:5"}) SET n = {id: "disaster:5", name: "impactMetrics.communication", type: "value_illustration", description: "Illustrates the condition of communication infrastructure", definition: "Operational indicates fully functioning communication networks, Limited means partial communication capabilities with restrictions, and Down represents complete failure of communication infrastructure requiring alternative methods", source_file: "disaster_kb.jsonl", source_line: 6, source_id: 5, search_text: "impactMetrics.communication value_illustration Illustrates the condition of communication infrastructure Operational indicates fully functioning communication networks, Limited means partial communication capabilities with restrictions, and Down represents complete failure of communication infrastructure requiring alternative methods"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:6"}) SET n = {id: "disaster:6", name: "resourceallocstate", type: "value_illustration", description: "Illustrates the adequacy of resource distribution", definition: "Sufficient means resources meet current operational needs, Limited indicates resources are stretched and prioritization is necessary, and Critical represents severe shortages requiring immediate supplementation", source_file: "disaster_kb.jsonl", source_line: 7, source_id: 6, search_text: "resourceallocstate value_illustration Illustrates the adequacy of resource distribution Sufficient means resources meet current operational needs, Limited indicates resources are stretched and prioritization is necessary, and Critical represents severe shortages requiring immediate supplementation"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:7"}) SET n = {id: "disaster:7", name: "impactMetrics.damage_level", type: "value_illustration", description: "Illustrates the extent of destruction caused by disasters", definition: "Minor represents limited structural damage with most systems functional, Moderate indicates significant damage with some systems compromised, Severe shows extensive damage with most systems affected, and Catastrophic represents complete devastation with total system failures", source_file: "disaster_kb.jsonl", source_line: 8, source_id: 7, search_text: "impactMetrics.damage_level value_illustration Illustrates the extent of destruction caused by disasters Minor represents limited structural damage with most systems functional, Moderate indicates significant damage with some systems compromised, Severe shows extensive damage with most systems affected, and Catastrophic represents complete devastation with total system failures"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:8"}) SET n = {id: "disaster:8", name: "staffingProfile.readiness.ppe_status", type: "value_illustration", description: "Illustrates the availability of Personal Protective Equipment", definition: "Adequate means sufficient PPE available for all personnel, Limited indicates restrictions in PPE distribution requiring prioritization, and Critical represents severe shortages threatening staff safety and operational continuity", source_file: "disaster_kb.jsonl", source_line: 9, source_id: 8, search_text: "staffingProfile.readiness.ppe_status value_illustration Illustrates the availability of Personal Protective Equipment Adequate means sufficient PPE available for all personnel, Limited indicates restrictions in PPE distribution requiring prioritization, and Critical represents severe shortages threatening staff safety and operational continuity"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:9"}) SET n = {id: "disaster:9", name: "coordeffectlvl", type: "value_illustration", description: "Illustrates the quality of coordination between responding agencies", definition: "High indicates seamless integration and information sharing across agencies, Medium represents adequate coordination with occasional communication gaps, and Low indicates significant coordination problems hindering effective response", source_file: "disaster_kb.jsonl", source_line: 10, source_id: 9, search_text: "coordeffectlvl value_illustration Illustrates the quality of coordination between responding agencies High indicates seamless integration and information sharing across agencies, Medium represents adequate coordination with occasional communication gaps, and Low indicates significant coordination problems hindering effective response"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:10"}) SET n = {id: "disaster:10", name: "Resource Utilization Ratio (RUR)", type: "calculation_knowledge", description: "Measures how effectively hub capacity is being used relative to available resources", definition: "RUR = \\frac{hubutilpct}{100} \\times \\frac{storecapm3}{storeavailm3 + 1}", source_file: "disaster_kb.jsonl", source_line: 11, source_id: 10, search_text: "Resource Utilization Ratio (RUR) calculation_knowledge Measures how effectively hub capacity is being used relative to available resources RUR = \\frac{hubutilpct}{100} \\times \\frac{storecapm3}{storeavailm3 + 1}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:11"}) SET n = {id: "disaster:11", name: "Operational Efficiency Index (OEI)", type: "calculation_knowledge", description: "Quantifies operational efficiency based on resource allocation and supply flow", definition: "OEI = \\frac{deliverysuccessrate}{100} \\times \\left(1 - \\frac{avgdeliveryhours}{24}\\right) \\times \\left(1 + \\frac{distributionpoints}{10}\\right)", source_file: "disaster_kb.jsonl", source_line: 12, source_id: 11, search_text: "Operational Efficiency Index (OEI) calculation_knowledge Quantifies operational efficiency based on resource allocation and supply flow OEI = \\frac{deliverysuccessrate}{100} \\times \\left(1 - \\frac{avgdeliveryhours}{24}\\right) \\times \\left(1 + \\frac{distributionpoints}{10}\\right)"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:12"}) SET n = {id: "disaster:12", name: "Communication Security Risk (CSR)", type: "calculation_knowledge", description: "Measures the security risk associated with communication systems during disaster response", definition: "CSR = secincidentcount \\times 5 + (100 - reportcompliance) + 90 - (dataqualityvalue \\times 3)", source_file: "disaster_kb.jsonl", source_line: 13, source_id: 12, search_text: "Communication Security Risk (CSR) calculation_knowledge Measures the security risk associated with communication systems during disaster response CSR = secincidentcount \\times 5 + (100 - reportcompliance) + 90 - (dataqualityvalue \\times 3)"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:13"}) SET n = {id: "disaster:13", name: "Personnel Effectiveness Ratio (PER)", type: "calculation_knowledge", description: "Evaluates how effectively human resources are utilized in operations", definition: "PER = \\frac{staffingprofile->>'personnel'->>'total'}{(personnelcostsusd / 10000)} \\times \\frac{staffingprofile->>'readiness'->>'availability_percent'}{100}", source_file: "disaster_kb.jsonl", source_line: 14, source_id: 13, search_text: "Personnel Effectiveness Ratio (PER) calculation_knowledge Evaluates how effectively human resources are utilized in operations PER = \\frac{staffingprofile->>'personnel'->>'total'}{(personnelcostsusd / 10000)} \\times \\frac{staffingprofile->>'readiness'->>'availability_percent'}{100}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:14"}) SET n = {id: "disaster:14", name: "Market Stability Index (MSI)", type: "calculation_knowledge", description: "Assesses the stability and reliability of disaster response operations over time", definition: "MSI = \\frac{estdurationdays}{365.0} \\times \\frac{deliverysuccessrate}{100.0} \\times \\left(1 - \\frac{secincidentcount}{partnerorgs::integer \\times 10 + 1}\\right) \\times 100, \\text{ where estdurationdays represents operation duration from operations table, deliverysuccessrate captures logistics reliability from transportation table, and secincidentcount/partnerorgs ratio approximates system disruptions per partner organization}", source_file: "disaster_kb.jsonl", source_line: 15, source_id: 14, search_text: "Market Stability Index (MSI) calculation_knowledge Assesses the stability and reliability of disaster response operations over time MSI = \\frac{estdurationdays}{365.0} \\times \\frac{deliverysuccessrate}{100.0} \\times \\left(1 - \\frac{secincidentcount}{partnerorgs::integer \\times 10 + 1}\\right) \\times 100, \\text{ where estdurationdays represents operation duration from operations table, deliverysuccessrate captures logistics reliability from transportation table, and secincidentcount/partnerorgs ratio approximates system disruptions per partner organization}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:15"}) SET n = {id: "disaster:15", name: "Logistics Performance Metric (LPM)", type: "calculation_knowledge", description: "Measures the overall performance of logistics operations", definition: "LPM = \\frac{totaldeliverytons}{hubcaptons} \\times deliverysuccessrate \\times \\left(1 - \\frac{vehiclebreakrate}{100}\\right) \\times 100", source_file: "disaster_kb.jsonl", source_line: 16, source_id: 15, search_text: "Logistics Performance Metric (LPM) calculation_knowledge Measures the overall performance of logistics operations LPM = \\frac{totaldeliverytons}{hubcaptons} \\times deliverysuccessrate \\times \\left(1 - \\frac{vehiclebreakrate}{100}\\right) \\times 100"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:16"}) SET n = {id: "disaster:16", name: "Environmental Impact Factor (EIF)", type: "calculation_knowledge", description: "Quantifies the environmental footprint of disaster response operations", definition: "EIF = carbontons \\times \\left(1 - \\frac{renewenergypct}{100}\\right) + (100 - recyclepct) \\times 0.5", source_file: "disaster_kb.jsonl", source_line: 17, source_id: 16, search_text: "Environmental Impact Factor (EIF) calculation_knowledge Quantifies the environmental footprint of disaster response operations EIF = carbontons \\times \\left(1 - \\frac{renewenergypct}{100}\\right) + (100 - recyclepct) \\times 0.5"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:17"}) SET n = {id: "disaster:17", name: "Public Health Resilience Score (PHRS)", type: "calculation_knowledge", description: "Evaluates the resilience of public health systems during disasters", definition: "PHRS = waterqualityindex \\times 0.4 + sanitationcoverage \\times 0.3 + vaccinationcoverage \\times 0.3", source_file: "disaster_kb.jsonl", source_line: 18, source_id: 17, search_text: "Public Health Resilience Score (PHRS) calculation_knowledge Evaluates the resilience of public health systems during disasters PHRS = waterqualityindex \\times 0.4 + sanitationcoverage \\times 0.3 + vaccinationcoverage \\times 0.3"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:18"}) SET n = {id: "disaster:18", name: "Financial Sustainability Ratio (FSR)", type: "calculation_knowledge", description: "Assesses the financial sustainability of disaster response operations", definition: "FSR = \\frac{donorcommitmentsusd}{budgetallotusd} \\times \\left(1 - \\frac{fundsutilpct}{100}\\right) - \\frac{resourcegapsusd}{budgetallotusd}", source_file: "disaster_kb.jsonl", source_line: 19, source_id: 18, search_text: "Financial Sustainability Ratio (FSR) calculation_knowledge Assesses the financial sustainability of disaster response operations FSR = \\frac{donorcommitmentsusd}{budgetallotusd} \\times \\left(1 - \\frac{fundsutilpct}{100}\\right) - \\frac{resourcegapsusd}{budgetallotusd}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:19"}) SET n = {id: "disaster:19", name: "Beneficiary Satisfaction Index (BSI)", type: "calculation_knowledge", description: "Measures the satisfaction level of aid recipients", definition: "BSI = benefeedbackscore \\times 10 + (commengage\\_numeric \\times 20) + distequityidx \\times 50, \\text{ where commengage\\_numeric maps Low=1, Medium=2, High=3}", source_file: "disaster_kb.jsonl", source_line: 20, source_id: 19, search_text: "Beneficiary Satisfaction Index (BSI) calculation_knowledge Measures the satisfaction level of aid recipients BSI = benefeedbackscore \\times 10 + (commengage\\_numeric \\times 20) + distequityidx \\times 50, \\text{ where commengage\\_numeric maps Low=1, Medium=2, High=3}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:20"}) SET n = {id: "disaster:20", name: "Critical Resource Shortage", type: "domain_knowledge", description: "Identifies situations where essential resources are dangerously depleted", definition: "A condition where storeavailm3 is less than 10% of storecapm3 AND supplyflowstate is 'Strained' or 'Disrupted', indicating severe logistical constraints that may compromise disaster response", source_file: "disaster_kb.jsonl", source_line: 21, source_id: 20, search_text: "Critical Resource Shortage domain_knowledge Identifies situations where essential resources are dangerously depleted A condition where storeavailm3 is less than 10% of storecapm3 AND supplyflowstate is 'Strained' or 'Disrupted', indicating severe logistical constraints that may compromise disaster response"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:21"}) SET n = {id: "disaster:21", name: "High-Risk Response Operation", type: "domain_knowledge", description: "Identifies disaster operations with elevated risk factors", definition: "Operations where emerglevel is 'Red' or 'Black' AND safetyranking is 'High Risk' AND secincidentcount > 50, indicating dangerous conditions requiring special safety protocols", source_file: "disaster_kb.jsonl", source_line: 22, source_id: 21, search_text: "High-Risk Response Operation domain_knowledge Identifies disaster operations with elevated risk factors Operations where emerglevel is 'Red' or 'Black' AND safetyranking is 'High Risk' AND secincidentcount > 50, indicating dangerous conditions requiring special safety protocols"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:22"}) SET n = {id: "disaster:22", name: "Resource Optimization Opportunity", type: "domain_knowledge", description: "Identifies situations where resource allocation could be optimized", definition: "A scenario where hubutilpct < 30 while simultaneously having distributionpoints > 20, suggesting potential for redistribution of resources to maximize efficiency", source_file: "disaster_kb.jsonl", source_line: 23, source_id: 22, search_text: "Resource Optimization Opportunity domain_knowledge Identifies situations where resource allocation could be optimized A scenario where hubutilpct < 30 while simultaneously having distributionpoints > 20, suggesting potential for redistribution of resources to maximize efficiency"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:23"}) SET n = {id: "disaster:23", name: "Vulnerable Population Hotspot", type: "domain_knowledge", description: "Identifies areas with highly vulnerable populations requiring priority attention", definition: "Areas where vulnerabilityreview is 'Complete' with distequityidx < 0.3 AND coordeffectlvl is 'Low', indicating populations with high vulnerability and inadequate coordination support", source_file: "disaster_kb.jsonl", source_line: 24, source_id: 23, search_text: "Vulnerable Population Hotspot domain_knowledge Identifies areas with highly vulnerable populations requiring priority attention Areas where vulnerabilityreview is 'Complete' with distequityidx < 0.3 AND coordeffectlvl is 'Low', indicating populations with high vulnerability and inadequate coordination support"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:24"}) SET n = {id: "disaster:24", name: "Operational Excellence", type: "domain_knowledge", description: "Identifies disaster response operations demonstrating superior performance", definition: "Operations with deliverysuccessrate > 90 AND invaccpct > 95 AND OEI > 3, representing highly effective logistics and resource management", source_file: "disaster_kb.jsonl", source_line: 25, source_id: 24, search_text: "Operational Excellence domain_knowledge Identifies disaster response operations demonstrating superior performance Operations with deliverysuccessrate > 90 AND invaccpct > 95 AND OEI > 3, representing highly effective logistics and resource management"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:25"}) SET n = {id: "disaster:25", name: "Sustainable Response Operation", type: "domain_knowledge", description: "Identifies disaster responses with strong sustainability practices", definition: "Operations where EIF < 50 AND renewenergypct > 30 AND recyclepct > 60, demonstrating environmental responsibility during emergency response", source_file: "disaster_kb.jsonl", source_line: 26, source_id: 25, search_text: "Sustainable Response Operation domain_knowledge Identifies disaster responses with strong sustainability practices Operations where EIF < 50 AND renewenergypct > 30 AND recyclepct > 60, demonstrating environmental responsibility during emergency response"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:26"}) SET n = {id: "disaster:26", name: "Public Health Emergency", type: "domain_knowledge", description: "Identifies situations with severe public health implications", definition: "Conditions where diseaserisk is 'High' AND waterqualityindex < 50 AND PHRS < 40, indicating critical threats to public health requiring immediate intervention", source_file: "disaster_kb.jsonl", source_line: 27, source_id: 26, search_text: "Public Health Emergency domain_knowledge Identifies situations with severe public health implications Conditions where diseaserisk is 'High' AND waterqualityindex < 50 AND PHRS < 40, indicating critical threats to public health requiring immediate intervention"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:27"}) SET n = {id: "disaster:27", name: "Financial Crisis Risk", type: "domain_knowledge", description: "Identifies operations at risk of financial collapse", definition: "Operations where fundsutilpct > 80 AND fundingstate is 'Critical' AND FSR < 0.2, indicating severe financial strain that threatens operational continuity", source_file: "disaster_kb.jsonl", source_line: 28, source_id: 27, search_text: "Financial Crisis Risk domain_knowledge Identifies operations at risk of financial collapse Operations where fundsutilpct > 80 AND fundingstate is 'Critical' AND FSR < 0.2, indicating severe financial strain that threatens operational continuity"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:28"}) SET n = {id: "disaster:28", name: "Community Resilience Builder", type: "domain_knowledge", description: "Identifies operations that strengthen local community capacity", definition: "Operations where localcapacitygrowth is 'Active' AND commengagelvl is 'High' AND BSI > 70, representing efforts that effectively build sustainable community resilience", source_file: "disaster_kb.jsonl", source_line: 29, source_id: 28, search_text: "Community Resilience Builder domain_knowledge Identifies operations that strengthen local community capacity Operations where localcapacitygrowth is 'Active' AND commengagelvl is 'High' AND BSI > 70, representing efforts that effectively build sustainable community resilience"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:29"}) SET n = {id: "disaster:29", name: "Logistics Breakdown", type: "domain_knowledge", description: "Identifies severe disruptions in the supply chain", definition: "Situations where LPM < 30 AND lastmilestatus is 'Suspended' AND vehiclebreakrate > 15, indicating critical failures in the logistics system requiring immediate intervention", source_file: "disaster_kb.jsonl", source_line: 30, source_id: 29, search_text: "Logistics Breakdown domain_knowledge Identifies severe disruptions in the supply chain Situations where LPM < 30 AND lastmilestatus is 'Suspended' AND vehiclebreakrate > 15, indicating critical failures in the logistics system requiring immediate intervention"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:30"}) SET n = {id: "disaster:30", name: "Response Time Effectiveness Ratio (RTER)", type: "calculation_knowledge", description: "Measures how quickly and effectively disaster response operations are deployed", definition: "RTER = \\frac{100}{estdurationdays + 1} \\times \\frac{deliverysuccessrate}{100} \\times \\left(\\frac{4 - respphase\\_numeric}{3}\\right), \\text{ where respphase\\_numeric maps Initial=1, Emergency=2, Recovery=3, Reconstruction=4, else=0, representing faster deployment relative to disaster phase}", source_file: "disaster_kb.jsonl", source_line: 31, source_id: 30, search_text: "Response Time Effectiveness Ratio (RTER) calculation_knowledge Measures how quickly and effectively disaster response operations are deployed RTER = \\frac{100}{estdurationdays + 1} \\times \\frac{deliverysuccessrate}{100} \\times \\left(\\frac{4 - respphase\\_numeric}{3}\\right), \\text{ where respphase\\_numeric maps Initial=1, Emergency=2, Recovery=3, Reconstruction=4, else=0, representing faster deployment relative to disaster phase}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:31"}) SET n = {id: "disaster:31", name: "Resource Distribution Equity (RDE)", type: "calculation_knowledge", description: "Evaluates the fairness of resource distribution across affected areas", definition: "RDE = distequityidx \\times \\left(1 + \\frac{distributionpoints}{20}\\right) \\times \\left(1 - \\frac{100 - deliverysuccessrate}{100}\\right) \\times coordeffect\\_factor, \\text{ where coordeffect\\_factor is 1.2 for High, 1.0 for Medium, 0.8 for Low coordination effectiveness level, and 0 for else}", source_file: "disaster_kb.jsonl", source_line: 32, source_id: 31, search_text: "Resource Distribution Equity (RDE) calculation_knowledge Evaluates the fairness of resource distribution across affected areas RDE = distequityidx \\times \\left(1 + \\frac{distributionpoints}{20}\\right) \\times \\left(1 - \\frac{100 - deliverysuccessrate}{100}\\right) \\times coordeffect\\_factor, \\text{ where coordeffect\\_factor is 1.2 for High, 1.0 for Medium, 0.8 for Low coordination effectiveness level, and 0 for else}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:32"}) SET n = {id: "disaster:32", name: "Communication Resilience Factor (CRF)", type: "calculation_knowledge", description: "Measures the resilience of communication systems during disasters", definition: "CRF = 100 - \\frac{CSR}{2} \\times communication\\_factor, \\text{ where communication\\_factor is 1.0 for Operational, 0.6 for Limited, and 0.3 for Down communication status from impactMetrics.communication}", source_file: "disaster_kb.jsonl", source_line: 33, source_id: 32, search_text: "Communication Resilience Factor (CRF) calculation_knowledge Measures the resilience of communication systems during disasters CRF = 100 - \\frac{CSR}{2} \\times communication\\_factor, \\text{ where communication\\_factor is 1.0 for Operational, 0.6 for Limited, and 0.3 for Down communication status from impactMetrics.communication}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:33"}) SET n = {id: "disaster:33", name: "Supply Chain Sustainability Index (SCSI)", type: "calculation_knowledge", description: "Assesses the environmental sustainability of the disaster supply chain", definition: "SCSI = 100 - EIF \\times \\frac{totaldeliverytons}{1000} \\times \\left(\\frac{fuelefficiencylpk}{20}\\right), \\text{ where EIF measures the environmental impact and higher scores represent more sustainable supply chains}", source_file: "disaster_kb.jsonl", source_line: 34, source_id: 33, search_text: "Supply Chain Sustainability Index (SCSI) calculation_knowledge Assesses the environmental sustainability of the disaster supply chain SCSI = 100 - EIF \\times \\frac{totaldeliverytons}{1000} \\times \\left(\\frac{fuelefficiencylpk}{20}\\right), \\text{ where EIF measures the environmental impact and higher scores represent more sustainable supply chains}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:34"}) SET n = {id: "disaster:34", name: "Staffing to Need Ratio (SNR)", type: "calculation_knowledge", description: "Evaluates whether staffing levels match operational requirements", definition: "SNR = \\frac{staffingprofile->>'personnel'->>'total'}{(impactMetrics->>'population'->>'affected'/10000)} \\times PER \\times ppe\\_factor, \\text{ where ppe\\_factor is 1.2 for Adequate, 0.8 for Limited, 0.5 for Critical PPE status, and 0 for else}", source_file: "disaster_kb.jsonl", source_line: 35, source_id: 34, search_text: "Staffing to Need Ratio (SNR) calculation_knowledge Evaluates whether staffing levels match operational requirements SNR = \\frac{staffingprofile->>'personnel'->>'total'}{(impactMetrics->>'population'->>'affected'/10000)} \\times PER \\times ppe\\_factor, \\text{ where ppe\\_factor is 1.2 for Adequate, 0.8 for Limited, 0.5 for Critical PPE status, and 0 for else}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:35"}) SET n = {id: "disaster:35", name: "Financial Efficiency Metric (FEM)", type: "calculation_knowledge", description: "Measures the cost-effectiveness of disaster operations", definition: "FEM = \\frac{benefeedbackscore}{costbeneusd} \\times FSR \\times \\left(1 + \\frac{OEI}{10}\\right), \\text{ where higher scores represent more efficient use of financial resources}", source_file: "disaster_kb.jsonl", source_line: 36, source_id: 35, search_text: "Financial Efficiency Metric (FEM) calculation_knowledge Measures the cost-effectiveness of disaster operations FEM = \\frac{benefeedbackscore}{costbeneusd} \\times FSR \\times \\left(1 + \\frac{OEI}{10}\\right), \\text{ where higher scores represent more efficient use of financial resources}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:36"}) SET n = {id: "disaster:36", name: "Logistics Network Resilience (LNR)", type: "calculation_knowledge", description: "Quantifies the ability of the logistics network to withstand disruption", definition: "LNR = LPM \\times \\frac{vehiclecount}{20} \\times lastmile\\_factor, \\text{ where lastmile\\_factor is 1.0 for On Track, 0.7 for Delayed, 0.4 for Suspended lastmilestatus, 0 for else}", source_file: "disaster_kb.jsonl", source_line: 37, source_id: 36, search_text: "Logistics Network Resilience (LNR) calculation_knowledge Quantifies the ability of the logistics network to withstand disruption LNR = LPM \\times \\frac{vehiclecount}{20} \\times lastmile\\_factor, \\text{ where lastmile\\_factor is 1.0 for On Track, 0.7 for Delayed, 0.4 for Suspended lastmilestatus, 0 for else}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:37"}) SET n = {id: "disaster:37", name: "Health System Capacity Index (HSCI)", type: "calculation_knowledge", description: "Measures the disaster area's health system ability to handle medical emergencies", definition: "HSCI = PHRS \\times medcap\\_numeric \\times \\left(1 - \\frac{hazlevel\\_numeric}{6}\\right), \\text{ where medcap\\_numeric maps Adequate=1.0, Limited=0.6, Critical=0.3, else=0 for medical emergency capacity, and hazlevel\\_numeric represents severity level from 1-5}", source_file: "disaster_kb.jsonl", source_line: 38, source_id: 37, search_text: "Health System Capacity Index (HSCI) calculation_knowledge Measures the disaster area's health system ability to handle medical emergencies HSCI = PHRS \\times medcap\\_numeric \\times \\left(1 - \\frac{hazlevel\\_numeric}{6}\\right), \\text{ where medcap\\_numeric maps Adequate=1.0, Limited=0.6, Critical=0.3, else=0 for medical emergency capacity, and hazlevel\\_numeric represents severity level from 1-5}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:38"}) SET n = {id: "disaster:38", name: "Community Engagement Effectiveness (CEE)", type: "calculation_knowledge", description: "Evaluates how effectively operations engage with affected communities", definition: "CEE = \\frac{BSI}{100} \\times commengage\\_numeric \\times \\left(\\frac{stakeholdersatisf + 1}{5}\\right), \\text{ where commengage\\_numeric maps Low=1, Medium=2, High=3, else=0 for community engagement level}", source_file: "disaster_kb.jsonl", source_line: 39, source_id: 38, search_text: "Community Engagement Effectiveness (CEE) calculation_knowledge Evaluates how effectively operations engage with affected communities CEE = \\frac{BSI}{100} \\times commengage\\_numeric \\times \\left(\\frac{stakeholdersatisf + 1}{5}\\right), \\text{ where commengage\\_numeric maps Low=1, Medium=2, High=3, else=0 for community engagement level}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:39"}) SET n = {id: "disaster:39", name: "Cross-Agency Coordination Index (CACI)", type: "calculation_knowledge", description: "Quantifies how effectively multiple agencies coordinate during disaster response", definition: "CACI = \\frac{partnerorgs}{10} \\times coordeffect\\_numeric \\times \\left(\\frac{infosharing\\_numeric + 1}{3}\\right), \\text{ where coordeffect\\_numeric maps Low=1, Medium=2, High=3, else=0 and infosharing\\_numeric maps Poor=1, Limited=2, Effective=3, else=0}", source_file: "disaster_kb.jsonl", source_line: 40, source_id: 39, search_text: "Cross-Agency Coordination Index (CACI) calculation_knowledge Quantifies how effectively multiple agencies coordinate during disaster response CACI = \\frac{partnerorgs}{10} \\times coordeffect\\_numeric \\times \\left(\\frac{infosharing\\_numeric + 1}{3}\\right), \\text{ where coordeffect\\_numeric maps Low=1, Medium=2, High=3, else=0 and infosharing\\_numeric maps Poor=1, Limited=2, Effective=3, else=0}"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:40"}) SET n = {id: "disaster:40", name: "Critical Resource Prioritization Need", type: "domain_knowledge", description: "Identifies operations requiring immediate resource redistribution", definition: "Operations experiencing Critical Resource Shortage where PER < 0.5 AND emerglevel is either 'Red' or 'Black', indicating a severe mismatch between available resources and critical operational needs", source_file: "disaster_kb.jsonl", source_line: 41, source_id: 40, search_text: "Critical Resource Prioritization Need domain_knowledge Identifies operations requiring immediate resource redistribution Operations experiencing Critical Resource Shortage where PER < 0.5 AND emerglevel is either 'Red' or 'Black', indicating a severe mismatch between available resources and critical operational needs"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:41"}) SET n = {id: "disaster:41", name: "High-Impact Communication Failure", type: "domain_knowledge", description: "Identifies disaster areas with severe communication infrastructure breakdown", definition: "Areas where impactMetrics.communication is 'Down' AND CRF < 40 AND coordeffectlvl is 'Low', representing critical communication failures that severely impede response coordination", source_file: "disaster_kb.jsonl", source_line: 42, source_id: 41, search_text: "High-Impact Communication Failure domain_knowledge Identifies disaster areas with severe communication infrastructure breakdown Areas where impactMetrics.communication is 'Down' AND CRF < 40 AND coordeffectlvl is 'Low', representing critical communication failures that severely impede response coordination"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:42"}) SET n = {id: "disaster:42", name: "Sustainable Operation Excellence", type: "domain_knowledge", description: "Identifies disaster operations that achieve high performance with minimal environmental impact", definition: "Operations qualifying as Operational Excellence while simultaneously meeting Sustainable Response Operation criteria, representing the gold standard for effective and environmentally responsible disaster management", source_file: "disaster_kb.jsonl", source_line: 43, source_id: 42, search_text: "Sustainable Operation Excellence domain_knowledge Identifies disaster operations that achieve high performance with minimal environmental impact Operations qualifying as Operational Excellence while simultaneously meeting Sustainable Response Operation criteria, representing the gold standard for effective and environmentally responsible disaster management"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:43"}) SET n = {id: "disaster:43", name: "Financial Vulnerability Zone", type: "domain_knowledge", description: "Identifies operations at severe risk due to both funding and resource constraints", definition: "Operations facing Financial Crisis Risk where RUR > 0.9 AND resourceallocstate is 'Critical', indicating dangerous convergence of financial instability and high resource utilization", source_file: "disaster_kb.jsonl", source_line: 44, source_id: 43, search_text: "Financial Vulnerability Zone domain_knowledge Identifies operations at severe risk due to both funding and resource constraints Operations facing Financial Crisis Risk where RUR > 0.9 AND resourceallocstate is 'Critical', indicating dangerous convergence of financial instability and high resource utilization"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:44"}) SET n = {id: "disaster:44", name: "Critical Health Response Requirement", type: "domain_knowledge", description: "Identifies areas needing urgent health system reinforcement", definition: "Areas experiencing Public Health Emergency where HSCI < 30 AND staffingProfile.readiness.ppe_status is 'Critical', indicating severely compromised health response capacity requiring immediate intervention", source_file: "disaster_kb.jsonl", source_line: 45, source_id: 44, search_text: "Critical Health Response Requirement domain_knowledge Identifies areas needing urgent health system reinforcement Areas experiencing Public Health Emergency where HSCI < 30 AND staffingProfile.readiness.ppe_status is 'Critical', indicating severely compromised health response capacity requiring immediate intervention"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:45"}) SET n = {id: "disaster:45", name: "Logistics System Collapse Risk", type: "domain_knowledge", description: "Identifies operations at imminent risk of complete logistics failure", definition: "Operations experiencing Logistics Breakdown where LNR < 20 AND vehiclebreakrate > 25, indicating a logistics system on the verge of complete collapse requiring immediate external support", source_file: "disaster_kb.jsonl", source_line: 46, source_id: 45, search_text: "Logistics System Collapse Risk domain_knowledge Identifies operations at imminent risk of complete logistics failure Operations experiencing Logistics Breakdown where LNR < 20 AND vehiclebreakrate > 25, indicating a logistics system on the verge of complete collapse requiring immediate external support"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:46"}) SET n = {id: "disaster:46", name: "Community Resilience Opportunity", type: "domain_knowledge", description: "Identifies high-potential areas for community resilience building", definition: "Areas where CEE > 2.5 AND vulnerabilityreview is 'Complete' BUT NOT qualifying as Community Resilience Builder, representing opportunities where community engagement is strong but resilience building efforts need strengthening", source_file: "disaster_kb.jsonl", source_line: 47, source_id: 46, search_text: "Community Resilience Opportunity domain_knowledge Identifies high-potential areas for community resilience building Areas where CEE > 2.5 AND vulnerabilityreview is 'Complete' BUT NOT qualifying as Community Resilience Builder, representing opportunities where community engagement is strong but resilience building efforts need strengthening"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:47"}) SET n = {id: "disaster:47", name: "Cross-Agency Coordination Crisis", type: "domain_knowledge", description: "Identifies critical failures in multi-agency coordination", definition: "Situations where CACI < 1.5 AND secincidentcount > 40 AND emerglevel is 'Black', indicating dangerous breakdowns in inter-agency coordination during critical emergency situations", source_file: "disaster_kb.jsonl", source_line: 48, source_id: 47, search_text: "Cross-Agency Coordination Crisis domain_knowledge Identifies critical failures in multi-agency coordination Situations where CACI < 1.5 AND secincidentcount > 40 AND emerglevel is 'Black', indicating dangerous breakdowns in inter-agency coordination during critical emergency situations"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:48"}) SET n = {id: "disaster:48", name: "Resource Distribution Inequity", type: "domain_knowledge", description: "Identifies operations with significant disparities in resource allocation", definition: "Operations where RDE < 0.4 AND distequityidx < 0.5 AND distributionpoints < 5, indicating serious inequities in how resources reach affected populations", source_file: "disaster_kb.jsonl", source_line: 49, source_id: 48, search_text: "Resource Distribution Inequity domain_knowledge Identifies operations with significant disparities in resource allocation Operations where RDE < 0.4 AND distequityidx < 0.5 AND distributionpoints < 5, indicating serious inequities in how resources reach affected populations"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:49"}) SET n = {id: "disaster:49", name: "Rapid Response Success Model", type: "domain_knowledge", description: "Identifies exemplary rapid deployment operations", definition: "Operations where RTER > 20 AND OEI > 2.5 AND deliverysuccessrate > 85, representing highly effective and rapidly deployed response operations that can serve as models for future disasters", source_file: "disaster_kb.jsonl", source_line: 50, source_id: 49, search_text: "Rapid Response Success Model domain_knowledge Identifies exemplary rapid deployment operations Operations where RTER > 20 AND OEI > 2.5 AND deliverysuccessrate > 85, representing highly effective and rapidly deployed response operations that can serve as models for future disasters"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:50"}) SET n = {id: "disaster:50", name: "Resource Utilization Classification", type: "domain_knowledge", description: "Categorizes distribution hubs based on their Resource Utilization Ratio (RUR) values", definition: "High Utilization (RUR > 5) indicates potentially overloaded hubs that may need resource expansion; Moderate Utilization (2 ≤ RUR ≤ 5) represents optimal resource usage balance; Low Utilization (RUR < 2) indicates underutilized hubs with potential efficiency gains through resource reallocation", source_file: "disaster_kb.jsonl", source_line: 51, source_id: 50, search_text: "Resource Utilization Classification domain_knowledge Categorizes distribution hubs based on their Resource Utilization Ratio (RUR) values High Utilization (RUR > 5) indicates potentially overloaded hubs that may need resource expansion; Moderate Utilization (2 ≤ RUR ≤ 5) represents optimal resource usage balance; Low Utilization (RUR < 2) indicates underutilized hubs with potential efficiency gains through resource reallocation"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:51"}) SET n = {id: "disaster:51", name: "Environmental Impact Classification", type: "domain_knowledge", description: "Categorizes operations based on their Environmental Impact Factor (EIF) values", definition: "Sustainable (EIF < 50) indicates operations with minimal environmental footprint and strong sustainability practices; Moderate Impact (50 ≤ EIF < 100) represents operations with reasonable environmental management; High Impact (EIF ≥ 100) indicates operations with significant environmental footprint requiring mitigation strategies", source_file: "disaster_kb.jsonl", source_line: 52, source_id: 51, search_text: "Environmental Impact Classification domain_knowledge Categorizes operations based on their Environmental Impact Factor (EIF) values Sustainable (EIF < 50) indicates operations with minimal environmental footprint and strong sustainability practices; Moderate Impact (50 ≤ EIF < 100) represents operations with reasonable environmental management; High Impact (EIF ≥ 100) indicates operations with significant environmental footprint requiring mitigation strategies"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:52"}) SET n = {id: "disaster:52", name: "Community Resilience Classification", type: "domain_knowledge", description: "Categorizes operations based on their community engagement and resilience-building effectiveness", definition: "Operations satisfying criteria from Community Resilience Builder are classified as Community Resilience Builder; operations meeting criteria from Community Resilience Opportunity are classified as Community Resilience Opportunity; all other operations are classified as Standard Operation", source_file: "disaster_kb.jsonl", source_line: 53, source_id: 52, search_text: "Community Resilience Classification domain_knowledge Categorizes operations based on their community engagement and resilience-building effectiveness Operations satisfying criteria from Community Resilience Builder are classified as Community Resilience Builder; operations meeting criteria from Community Resilience Opportunity are classified as Community Resilience Opportunity; all other operations are classified as Standard Operation"};
MERGE (n:Knowledge:SemanticSearch {id: "disaster:53"}) SET n = {id: "disaster:53", name: "available storage percentage", type: "calculation_knowledge", description: "Calculates what proportion of total storage capacity is currently available", definition: "The percentage calculated by dividing available storage (storeavailm3) by total storage capacity (storecapm3) and multiplying by 100", source_file: "disaster_kb.jsonl", source_line: 54, source_id: 53, search_text: "available storage percentage calculation_knowledge Calculates what proportion of total storage capacity is currently available The percentage calculated by dividing available storage (storeavailm3) by total storage capacity (storecapm3) and multiplying by 100"};
MATCH (d:Database {id: "fake"})-[r:HAS_KNOWLEDGE]->(:Knowledge) DELETE r;
MATCH (parent:Knowledge)-[r:DEPENDS_ON]->() WHERE parent.id STARTS WITH "fake:" DELETE r;
MATCH (k:Knowledge)-[r:REFERS_TO_COLUMN]->() WHERE k.id STARTS WITH "fake:" DELETE r;

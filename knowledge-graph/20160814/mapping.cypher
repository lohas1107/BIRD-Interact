MERGE (n:Knowledge:SemanticSearch {id: "insider:44"}) SET n = {id: "insider:44", name: "Chronic Compliance Violator", type: "domain_knowledge", description: "Identifies traders with a problematic history and a high recidivism score.", definition: "A trader identified as having a Problematic Compliance History  AND whose Compliance Recidivism Score (CRS)  is greater than 1.5.", source_file: "insider_kb.jsonl", source_line: 45, source_id: 44, search_text: "Chronic Compliance Violator domain_knowledge Identifies traders with a problematic history and a high recidivism score. A trader identified as having a Problematic Compliance History  AND whose Compliance Recidivism Score (CRS)  is greater than 1.5."};

MERGE (n:Knowledge:SemanticSearch {id: "fake:49"}) SET n = {id: "fake:49", name: "Advanced Persistent Threat", type: "domain_knowledge", description: "Identifies sophisticated, persistent security threats.", definition: "A High-Risk Bot Network with NMI > 0.9 and TEI > 0.8", source_file: "fake_kb.jsonl", source_line: 50, source_id: 49, search_text: "Advanced Persistent Threat domain_knowledge Identifies sophisticated, persistent security threats. A High-Risk Bot Network with NMI > 0.9 and TEI > 0.8"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:50"}) SET n = {id: "fake:50", name: "Temporal Pattern Deviation Score (TPDS)", type: "calculation_knowledge", description: "Measures deviation from established temporal activity patterns.", definition: "TPDS = \\sqrt{\\sum_{i=1}^{24} (\\frac{\\text{obsfreq}_i - \\text{expfreq}_i}{\\text{expfreq}_i})^2}", source_file: "fake_kb.jsonl", source_line: 51, source_id: 50, search_text: "Temporal Pattern Deviation Score (TPDS) calculation_knowledge Measures deviation from established temporal activity patterns. TPDS = \\sqrt{\\sum_{i=1}^{24} (\\frac{\\text{obsfreq}_i - \\text{expfreq}_i}{\\text{expfreq}_i})^2}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:51"}) SET n = {id: "fake:51", name: "Network Influence Centrality (NIC)", type: "calculation_knowledge", description: "Quantifies account's position and influence in interaction network.", definition: "NIC = 0.4 \\times \\text{connqualscore} + 0.3 \\times \\text{netinflscore} + 0.3 \\times \\text{interactdiv}", source_file: "fake_kb.jsonl", source_line: 52, source_id: 51, search_text: "Network Influence Centrality (NIC) calculation_knowledge Quantifies account's position and influence in interaction network. NIC = 0.4 \\times \\text{connqualscore} + 0.3 \\times \\text{netinflscore} + 0.3 \\times \\text{interactdiv}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:52"}) SET n = {id: "fake:52", name: "Multi-Account Correlation Index (MACI)", type: "calculation_knowledge", description: "Measures behavioral correlation across linked accounts.", definition: "MACI = \\frac{\\sum_{i=1}^{n} \\sum_{j=i+1}^{n} \\text{corr}(i,j)}{\\binom{n}{2}} where n is linked accounts", source_file: "fake_kb.jsonl", source_line: 53, source_id: 52, search_text: "Multi-Account Correlation Index (MACI) calculation_knowledge Measures behavioral correlation across linked accounts. MACI = \\frac{\\sum_{i=1}^{n} \\sum_{j=i+1}^{n} \\text{corr}(i,j)}{\\binom{n}{2}} where n is linked accounts"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:53"}) SET n = {id: "fake:53", name: "Reputation Volatility Index (RVI)", type: "calculation_knowledge", description: "Quantifies stability of account reputation over time.", definition: "RVI = \\frac{\\sigma_{\\text{reputscore}}}{\\mu_{\\text{reputscore}}} \\times (1 + \\frac{|\\Delta\\text{reputscore}|}{\\Delta t})", source_file: "fake_kb.jsonl", source_line: 54, source_id: 53, search_text: "Reputation Volatility Index (RVI) calculation_knowledge Quantifies stability of account reputation over time. RVI = \\frac{\\sigma_{\\text{reputscore}}}{\\mu_{\\text{reputscore}}} \\times (1 + \\frac{|\\Delta\\text{reputscore}|}{\\Delta t})"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:54"}) SET n = {id: "fake:54", name: "Content Distribution Pattern Score (CDPS)", type: "calculation_knowledge", description: "Analyzes patterns in content posting and sharing.", definition: "CDPS = 0.4 \\times \\text{entropy}(\\text{posttimes}) + 0.3 \\times \\text{burstiness} + 0.3 \\times (1 - \\text{periodicity})", source_file: "fake_kb.jsonl", source_line: 55, source_id: 54, search_text: "Content Distribution Pattern Score (CDPS) calculation_knowledge Analyzes patterns in content posting and sharing. CDPS = 0.4 \\times \\text{entropy}(\\text{posttimes}) + 0.3 \\times \\text{burstiness} + 0.3 \\times (1 - \\text{periodicity})"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:55"}) SET n = {id: "fake:55", name: "Behavioral Consistency Score (BCS)", type: "calculation_knowledge", description: "Measures consistency of account behavior patterns.", definition: "BCS = (1 - TPDS) \\times (1 - RVI) \\times (1 - \\frac{\\text{patterndev}}{100})", source_file: "fake_kb.jsonl", source_line: 56, source_id: 55, search_text: "Behavioral Consistency Score (BCS) calculation_knowledge Measures consistency of account behavior patterns. BCS = (1 - TPDS) \\times (1 - RVI) \\times (1 - \\frac{\\text{patterndev}}{100})"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:56"}) SET n = {id: "fake:56", name: "Network Synchronization Index (NSI)", type: "calculation_knowledge", description: "Quantifies synchronized activities across account clusters.", definition: "NSI = \\frac{\\sum_{i=1}^{n} \\sum_{j=i+1}^{n} \\text{sync}(i,j)}{\\text{clustsize}} \\times MACI", source_file: "fake_kb.jsonl", source_line: 57, source_id: 56, search_text: "Network Synchronization Index (NSI) calculation_knowledge Quantifies synchronized activities across account clusters. NSI = \\frac{\\sum_{i=1}^{n} \\sum_{j=i+1}^{n} \\text{sync}(i,j)}{\\text{clustsize}} \\times MACI"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:57"}) SET n = {id: "fake:57", name: "Content Amplification Effect (CAE)", type: "calculation_knowledge", description: "Measures the cascade effect of content sharing.", definition: "CAE = \\text{CIS} \\times NIC \\times \\log(1 + \\text{resharecount})", source_file: "fake_kb.jsonl", source_line: 58, source_id: 57, search_text: "Content Amplification Effect (CAE) calculation_knowledge Measures the cascade effect of content sharing. CAE = \\text{CIS} \\times NIC \\times \\log(1 + \\text{resharecount})"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:58"}) SET n = {id: "fake:58", name: "Authentication Pattern Score (APS)", type: "calculation_knowledge", description: "Evaluates consistency of authentication behaviors.", definition: "APS = (1 - TEI) \\times BCS \\times (1 - \\frac{\\text{authanom}}{100})", source_file: "fake_kb.jsonl", source_line: 59, source_id: 58, search_text: "Authentication Pattern Score (APS) calculation_knowledge Evaluates consistency of authentication behaviors. APS = (1 - TEI) \\times BCS \\times (1 - \\frac{\\text{authanom}}{100})"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:59"}) SET n = {id: "fake:59", name: "Cross-Platform Correlation Score (CPCS)", type: "calculation_knowledge", description: "Measures behavioral correlation across platforms.", definition: "CPCS = CPRI \\times MACI \\times (1 + \\frac{\\text{platformlinks}}{10})", source_file: "fake_kb.jsonl", source_line: 60, source_id: 59, search_text: "Cross-Platform Correlation Score (CPCS) calculation_knowledge Measures behavioral correlation across platforms. CPCS = CPRI \\times MACI \\times (1 + \\frac{\\text{platformlinks}}{10})"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:60"}) SET n = {id: "fake:60", name: "Coordinated Influence Operation", type: "domain_knowledge", description: "Identifies sophisticated influence campaigns.", definition: "A network where NSI > 0.8 and CAE > 0.7 and contains at least one Content Manipulation Ring", source_file: "fake_kb.jsonl", source_line: 61, source_id: 60, search_text: "Coordinated Influence Operation domain_knowledge Identifies sophisticated influence campaigns. A network where NSI > 0.8 and CAE > 0.7 and contains at least one Content Manipulation Ring"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:61"}) SET n = {id: "fake:61", name: "Behavioral Pattern Anomaly", type: "domain_knowledge", description: "Identifies accounts with inconsistent behavioral patterns.", definition: "An account with BCS < 0.3 and TPDS > 0.7 and is not a Trusted Account", source_file: "fake_kb.jsonl", source_line: 62, source_id: 61, search_text: "Behavioral Pattern Anomaly domain_knowledge Identifies accounts with inconsistent behavioral patterns. An account with BCS < 0.3 and TPDS > 0.7 and is not a Trusted Account"};

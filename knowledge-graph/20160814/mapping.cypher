CREATE (n:Column {database_name: "fake", table_name: "securitydetection", column_name: "detection_score_profile", ordinal: 7, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "fake:securitydetection:detection_score_profile", raw_text: "{\"column_meaning\": \"JSONB column. Aggregates all granular detection scores, risk indicators, and model‑reliability attributes so the full threat posture of a security event can be inspected with a single JSONB read.\", \"fields_meaning\": {\"behavior_scores\": {\"autobehavscore\": \"NUMERIC(5,3) rating how automated the user’s behavior is (e.g., '0.754').\", \"botlikscore\": \"NUMERIC(6,3) capturing the likelihood of bot behavior (e.g., '0.784').\", \"commintscore\": \"NUMERIC(6,4) rating commercial/spam intent (e.g., '0.1234').\", \"spambehavscore\": \"NUMERIC(4,2) measuring spam-related behavior (e.g., '0.87').\"}, \"detection_reliability\": {\"detmethrel\": \"NUMERIC(4,3) detection method reliability (e.g., '0.855').\", \"featver\": \"A VARCHAR(12) labeling the detection feature set version (e.g., 'feat_set2').\", \"modelver\": \"A VARCHAR(12) labeling the detection model version (e.g., 'mdl_v1.3').\"}, \"overall\": {\"confval\": \"NUMERIC(6,5) confidence in the final detection verdict (e.g., '0.98765').\", \"detectconf\": \"A NUMERIC(3,2) confidence level (e.g., '0.93').\", \"fposprob\": \"NUMERIC(5,4) false positive probability (e.g., '0.0345').\", \"riskval\": \"NUMERIC(4,2) overall risk rating (e.g., '0.93').\", \"threatlvl\": \"An enum (ThreatLevel_enum) describing threat priority (Critical, High, Low, Medium).\"}, \"pattern_scores\": {\"behavpatscore\": \"NUMERIC(5,2) capturing overall suspicious patterns (e.g., '0.75').\", \"contpatscore\": \"NUMERIC(5,3) capturing suspicious content patterns (e.g., '0.642').\", \"netpatscore\": \"NUMERIC(4,2) capturing suspicious network-level patterns (e.g., '0.85').\", \"profpatscore\": \"NUMERIC(4,3) suspicious profile patterns (e.g., '0.632').\", \"techpatscore\": \"NUMERIC(4,3) suspicious technical patterns (e.g., '0.872').\", \"temppatscore\": \"NUMERIC(6,3) measuring irregularities in temporal patterns (e.g., '1.234').\"}}}", description: "JSONB column. Aggregates all granular detection scores, risk indicators, and model‑reliability attributes so the full threat posture of a security event can be inspected with a single JSONB read.", declared_type: "JSONB", examples: ["0.93", "0.98765", "0.0345", "0.754", "0.784", "0.87", "0.1234", "0.75", "1.234", "0.85", "0.642", "0.632", "0.872", "0.855", "mdl_v1.3", "feat_set2"]});

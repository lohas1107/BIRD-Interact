CREATE (n:Column {database_name: "disaster", table_name: "disasterevents", column_name: "impactmetrics", ordinal: 9, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "disaster:disasterevents:impactmetrics", raw_text: "{\"column_meaning\": \"JSONB column. Consolidates impact-related metrics of the disaster including population effects, infrastructure damage, and communication status.\", \"fields_meaning\": {\"communication\": \"An enum (CommNetState_enum) for communication network status; possible values: 'Limited', 'Operational', 'Down'.\", \"damage_level\": \"An enum (DamageReport_enum) labeling the damage severity; possible values: 'Severe', 'Moderate', 'Minor', 'Catastrophic'.\", \"infrastructure\": {\"damage_percent\": \"A DECIMAL(5,2) measuring infrastructure damage as a percentage (e.g., 45.30).\", \"power_outage_percent\": \"A DECIMAL(7,3) capturing the percentage of power outages (e.g., 75.200).\", \"water_damage_percent\": \"An INT indicating the water system damage percentage (e.g., 60).\"}, \"population\": {\"affected\": \"An INTEGER counting how many people are affected (e.g., 150000).\", \"casualties\": \"An INTEGER representing the total number of fatalities (e.g., 50).\", \"displaced\": \"An INTEGER indicating the number of displaced individuals (e.g., 10000).\", \"injured\": \"An INT logging how many were injured (e.g., 200).\", \"missing\": \"An INT showing how many persons are missing (e.g., 25).\"}, \"transportation\": \"An enum (TransportAccess_enum) describing transportation accessibility; possible values: 'Full', 'Limited', 'Minimal'.\"}}", description: "JSONB column. Consolidates impact-related metrics of the disaster including population effects, infrastructure damage, and communication status.", declared_type: "JSONB", examples: ["150000", "10000", "50", "200", "25", "45.30", "75.200", "60"]});

CREATE (n:Column {database_name: "crypto", table_name: "riskandmargin", column_name: "risk_margin_profile", ordinal: 3, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "crypto:riskandmargin:risk_margin_profile", raw_text: "{\"column_meaning\": \"JSONB column. Bundles leverage settings, margin thresholds, liquidation levels, iceberg layout, multifaceted risk labels, position sizing, margin‑call figures, and collateral details into one field for rapid risk evaluation.\", \"fields_meaning\": {\"collateral\": {\"collcoin\": \"An enum (CollCoin_enum) referencing collateral currency (USDT, USDC, BTC, ETH).\", \"collrate\": \"A DECIMAL(5,3) collateral ratio (e.g., '0.600').\", \"collsum\": \"A DECIMAL(12,3) collateral amount posted (e.g., '5000.000').\", \"insfundshare\": \"A DECIMAL(12,3) portion allocated from the insurance fund (e.g., '50.000').\"}, \"iceberg\": {\"icebcount\": \"A DOUBLE PRECISION iceberg hidden portion (e.g., 3.25).\", \"viscount\": \"A DOUBLE PRECISION visible portion (e.g., 1.75).\"}, \"leverage\": {\"levscale\": \"An enum (LevScale_enum) for leverage (1, 2, 3, 5, 10, 20, 50, 100).\", \"margform\": \"An enum (MargForm_enum) for margin mode (Isolated, Cross).\"}, \"margin_rates\": {\"bkptquote\": \"A DECIMAL(12,3) bankruptcy or forced liquidation price (e.g., '25000.000').\", \"margcallquote\": \"A DECIMAL(12,3) margin-call trigger price (e.g., '25500.250').\", \"margrate\": \"A DECIMAL(5,3) margin ratio (e.g., '0.300').\"}, \"margin_thresholds\": {\"inithold\": \"A DECIMAL(12,3) initial margin required (e.g., '500.250').\", \"mainthold\": \"A DECIMAL(12,3) maintenance margin threshold (e.g., '300.125').\"}, \"position\": {\"poscount\": \"A DECIMAL(12,3) position size in base units (e.g., '0.300').\", \"posedge\": \"An enum (PosEdge_enum) for position direction (Short, Long).\", \"posmagn\": \"An enum (PosMagn_enum) representing position leverage (1, 2, 3, 5, 10, 20, 50, 100).\", \"posriskrate\": \"A DECIMAL(5,3) position risk ratio (e.g., '0.455').\", \"possum\": \"A DECIMAL(12,3) notional value of position (e.g., '8100.000').\"}, \"price_levels\": {\"liqquote\": \"A NUMERIC(12,3) liquidation price estimate (e.g., '25000.750').\", \"stopquote\": \"A NUMERIC(12,3) stop price (e.g., '27000.000').\", \"traildiff\": \"A DECIMAL(12,3) trailing delta (e.g., '150.500').\", \"trigquote\": \"A DECIMAL(12,3) advanced trigger price (e.g., '26950.250').\"}, \"risk_factors\": {\"cpfactor\": \"A VARCHAR(30) label for counterparty risk (e.g., 'Tier2Counterparty').\", \"custfactor\": \"A VARCHAR(30) custody risk label (e.g., 'ColdStorage').\", \"liqfactor\": \"A VARCHAR(20) label for liquidation risk (e.g., 'HighRisk').\", \"netfactor\": \"A VARCHAR(30) network risk label (e.g., 'ChainCongestion').\", \"regfactor\": \"A VARCHAR(30) regulatory risk label (e.g., 'RestrictedRegion').\", \"setfactor\": \"A VARCHAR(30) settlement risk label (e.g., 'DailySettle').\"}}}", description: "JSONB column. Bundles leverage settings, margin thresholds, liquidation levels, iceberg layout, multifaceted risk labels, position sizing, margin‑call figures, and collateral details into one field for rapid risk evaluation.", declared_type: "JSONB", examples: ["500.250", "300.125", "25000.750", "27000.000", "26950.250", "150.500", "3.25", "1.75", "HighRisk", "Tier2Counterparty", "DailySettle", "ColdStorage", "ChainCongestion", "RestrictedRegion", "0.300", "8100.000", "0.455", "25500.250", "25000.000", "0.600", "5000.000", "50.000"]});

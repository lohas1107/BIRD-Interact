MERGE (n:Knowledge:SemanticSearch {id: "fake:0"}) SET n = {id: "fake:0", name: "Account Activity Frequency (AAF)", type: "calculation_knowledge", description: "Measures how frequently an account engages in platform activities relative to its age.", definition: "AAF = \\frac{\\text{sesscount}}{\\text{acctagespan}}", source_file: "fake_kb.jsonl", source_line: 1, source_id: 0, search_text: "Account Activity Frequency (AAF) calculation_knowledge Measures how frequently an account engages in platform activities relative to its age. AAF = \\frac{\\text{sesscount}}{\\text{acctagespan}}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:1"}) SET n = {id: "fake:1", name: "Content Authenticity Score (CAS)", type: "calculation_knowledge", description: "Aggregates multiple authenticity indicators into a single score.", definition: "CAS = 0.3 \\times \\text{authenscore} + 0.3 \\times \\text{cntuniqscore} + 0.4 \\times \\text{convnatval} where values are normalized to [0,1]", source_file: "fake_kb.jsonl", source_line: 2, source_id: 1, search_text: "Content Authenticity Score (CAS) calculation_knowledge Aggregates multiple authenticity indicators into a single score. CAS = 0.3 \\times \\text{authenscore} + 0.3 \\times \\text{cntuniqscore} + 0.4 \\times \\text{convnatval} where values are normalized to [0,1]"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:2"}) SET n = {id: "fake:2", name: "Network Growth Velocity (NGV)", type: "calculation_knowledge", description: "Measures the rate of network growth considering both followers and following.", definition: "NGV = \\sqrt{\\text{followgrowrate}^2 + \\text{followinggrowrate}^2}", source_file: "fake_kb.jsonl", source_line: 3, source_id: 2, search_text: "Network Growth Velocity (NGV) calculation_knowledge Measures the rate of network growth considering both followers and following. NGV = \\sqrt{\\text{followgrowrate}^2 + \\text{followinggrowrate}^2}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:3"}) SET n = {id: "fake:3", name: "Bot Behavior Index (BBI)", type: "calculation_knowledge", description: "Combines multiple bot-detection metrics into a single score.", definition: "BBI = 0.4 \\times \\text{botlikscore} + 0.3 \\times \\text{autobehavscore} + 0.3 \\times (1 - \\text{convnatval})", source_file: "fake_kb.jsonl", source_line: 4, source_id: 3, search_text: "Bot Behavior Index (BBI) calculation_knowledge Combines multiple bot-detection metrics into a single score. BBI = 0.4 \\times \\text{botlikscore} + 0.3 \\times \\text{autobehavscore} + 0.3 \\times (1 - \\text{convnatval})"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:4"}) SET n = {id: "fake:4", name: "Security Risk Score (SRS)", type: "calculation_knowledge", description: "Calculates overall security risk based on multiple factors.", definition: "SRS = 0.4 \\times \\text{riskval} + 0.3 \\times (1 - \\text{trustval}) + 0.3 \\times \\text{impactval}", source_file: "fake_kb.jsonl", source_line: 5, source_id: 4, search_text: "Security Risk Score (SRS) calculation_knowledge Calculates overall security risk based on multiple factors. SRS = 0.4 \\times \\text{riskval} + 0.3 \\times (1 - \\text{trustval}) + 0.3 \\times \\text{impactval}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:5"}) SET n = {id: "fake:5", name: "Profile Credibility Index (PCI)", type: "calculation_knowledge", description: "Evaluates overall profile credibility.", definition: "PCI = 0.3 \\times \\text{credscore} + 0.3 \\times \\text{reputscore} + 0.4 \\times \\text{completeness}", source_file: "fake_kb.jsonl", source_line: 6, source_id: 5, search_text: "Profile Credibility Index (PCI) calculation_knowledge Evaluates overall profile credibility. PCI = 0.3 \\times \\text{credscore} + 0.3 \\times \\text{reputscore} + 0.4 \\times \\text{completeness}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:6"}) SET n = {id: "fake:6", name: "Coordinated Activity Score (CAS)", type: "calculation_knowledge", description: "Measures likelihood of coordinated behavior across accounts.", definition: "CAS = 0.5 \\times \\text{coordscore} + 0.3 \\times \\text{netinflscore} + 0.2 \\times \\frac{\\text{clustsize}}{100}", source_file: "fake_kb.jsonl", source_line: 7, source_id: 6, search_text: "Coordinated Activity Score (CAS) calculation_knowledge Measures likelihood of coordinated behavior across accounts. CAS = 0.5 \\times \\text{coordscore} + 0.3 \\times \\text{netinflscore} + 0.2 \\times \\frac{\\text{clustsize}}{100}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:7"}) SET n = {id: "fake:7", name: "Technical Evasion Index (TEI)", type: "calculation_knowledge", description: "Quantifies attempts to evade detection.", definition: "TEI = 0.4 \\times \\text{vpnratio} + 0.3 \\times \\frac{\\text{proxycount}}{10} + 0.3 \\times \\frac{\\text{ipcountrynum}}{20}", source_file: "fake_kb.jsonl", source_line: 8, source_id: 7, search_text: "Technical Evasion Index (TEI) calculation_knowledge Quantifies attempts to evade detection. TEI = 0.4 \\times \\text{vpnratio} + 0.3 \\times \\frac{\\text{proxycount}}{10} + 0.3 \\times \\frac{\\text{ipcountrynum}}{20}"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:8"}) SET n = {id: "fake:8", name: "Content Manipulation Score (CMS)", type: "calculation_knowledge", description: "Evaluates content manipulation patterns.", definition: "CMS = 0.4 \\times (1 - \\text{cntuniqscore}) + 0.3 \\times \\text{mediareratio} + 0.3 \\times (1 - \\text{txtuniq})", source_file: "fake_kb.jsonl", source_line: 9, source_id: 8, search_text: "Content Manipulation Score (CMS) calculation_knowledge Evaluates content manipulation patterns. CMS = 0.4 \\times (1 - \\text{cntuniqscore}) + 0.3 \\times \\text{mediareratio} + 0.3 \\times (1 - \\text{txtuniq})"};

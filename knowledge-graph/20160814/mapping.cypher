CREATE (n:Column {database_name: "credit", table_name: "expenses_and_assets", column_name: "propfinancialdata", ordinal: 16, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "credit:expenses_and_assets:propfinancialdata", raw_text: "{\"column_meaning\": \"JSONB column. Bundles all housing‑related facts (ownership, value, and pay history) so risk or marketing rules need only one JSONB lookup.\", \"fields_meaning\": {\"mortgagebits\": {\"mortbalance\": \"A DECIMAL(15,2) storing current mortgage balance (e.g., '150000.00').\", \"mortpayhist\": \"An enum (PaymentHistory_enum) for mortgage payment history. Possible values: Poor, Fair, Good, Excellent, Current, Past.\"}, \"propown\": \"An enum (PropertyOwnership_enum) describing property ownership (Rent, Living with Parents, Own).\", \"proptype\": \"An enum (PropertyType_enum) for property classification (Apartment, House, Condo).\", \"propvalue\": \"A DECIMAL(15,2) property value (e.g., '250000.00').\", \"rentpayhist\": \"An enum (PaymentHistory_enum) for rent payment history. Possible values: Poor, Fair, Good, Excellent, Current, Past.\"}}", description: "JSONB column. Bundles all housing‑related facts (ownership, value, and pay history) so risk or marketing rules need only one JSONB lookup.", declared_type: "JSONB", examples: ["250000.00", "150000.00"]});

CREATE (n:Column {database_name: "disaster", table_name: "supplies", column_name: "resourceinventory", ordinal: 4, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "disaster:supplies:resourceinventory", raw_text: "{\"column_meaning\": \"JSONB column. Provides a comprehensive view of all supply resources available for disaster response, including food, water, shelter, medical, and power-related supplies.\", \"fields_meaning\": {\"essentials\": {\"food_tons\": \"A DECIMAL(11,3) denoting the quantity of food in tons (e.g., 12.500).\", \"water_liters\": \"A NUMERIC(12,3) specifying the water supply in liters (e.g., 25000.000).\"}, \"hygiene_kits\": \"An INT measuring the quantity of hygiene kits (e.g., 300).\", \"medical\": \"An INT counting medical supply units (e.g., 500).\", \"power\": {\"fuel_liters\": \"A DECIMAL(9,1) specifying the liters of fuel reserve (e.g., 5000.0).\", \"generators\": \"An INT for how many power generators are available (e.g., 10).\"}, \"shelter\": {\"blankets\": \"An INTEGER storing the total number of blankets (e.g., 1000).\", \"units\": \"An INT showing how many shelter kits or tents (e.g., 200).\"}}}", description: "JSONB column. Provides a comprehensive view of all supply resources available for disaster response, including food, water, shelter, medical, and power-related supplies.", declared_type: "JSONB", examples: ["12.500", "25000.000", "500", "200", "1000", "300", "10", "5000.0"]});

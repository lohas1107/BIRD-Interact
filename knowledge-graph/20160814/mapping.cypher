MERGE (n:Knowledge:SemanticSearch {id: "cross_db:50"}) SET n = {id: "cross_db:50", name: "Data Flow Stability Index (DFSI)", type: "calculation_knowledge", description: "Quantifies the stability of data flows by balancing reliability and error recovery.", definition: "DFSI = \\text{DFRS} \\times \\frac{\\text{SuccessPct}}{\\text{ErrTally} + 1}", source_file: "cross_db_kb.jsonl", source_line: 51, source_id: 50, search_text: "Data Flow Stability Index (DFSI) calculation_knowledge Quantifies the stability of data flows by balancing reliability and error recovery. DFSI = \\text{DFRS} \\times \\frac{\\text{SuccessPct}}{\\text{ErrTally} + 1}"};

CREATE (n:Column {database_name: "cybermarket", table_name: "markets", column_name: "market_status_reputation", ordinal: 13, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "cybermarket:markets:market_status_reputation", raw_text: "{\"column_meaning\": \"JSONB column. Consolidated information regarding the market's operational status, community reputation, trust level, and compliance/enforcement metrics.\", \"fields_meaning\": {\"community_trust_score\": \"A NUMERIC(4,2) (0–99.99) representing community trust (e.g., 85.40).\", \"compliance_metrics\": {\"penalty_count\": \"A SMALLINT for how many penalties or bans were enforced (e.g., 10).\", \"restriction_level\": \"An enum (AccountRestrictionLevel_enum) stating the restriction extent (Full, Partial).\", \"rule_break_count\": \"A SMALLINT counting known rule or TOS violations (e.g., 27).\", \"warning_count\": \"A SMALLINT tallying warnings issued to market participants (e.g., 53).\"}, \"dispute_resolution_score\": \"A NUMERIC(4,1) (0–99.9) describing effectiveness of dispute resolution (e.g., 8.7).\", \"reputation_score\": \"A NUMERIC(6,3) reputation or community rating (0.000–999.999).\", \"status\": \"An enum (MarketStatus_enum) capturing the market's status (Active, Under Investigation, Suspended, Closed).\", \"trust_level\": \"An enum (RiskLevel_enum) describing overall trust/risk level (Low, Medium, High, Unknown).\"}}", description: "JSONB column. Consolidated information regarding the market's operational status, community reputation, trust level, and compliance/enforcement metrics.", declared_type: "JSONB", examples: ["85.40", "8.7", "27", "53", "10"]});

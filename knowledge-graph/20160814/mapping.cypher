CREATE (n:Column {database_name: "crypto", table_name: "analyticsindicators", column_name: "market_sentiment_indicators", ordinal: 4, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "crypto:analyticsindicators:market_sentiment_indicators", raw_text: "{\"column_meaning\": \"JSONB column. Aggregates order‑book walls, momentum gauges, technical oscillators, flow imbalances, large‑player activity, and arbitrage signals to streamline advanced analytics and back‑testing.\", \"fields_meaning\": {\"arbitrage\": {\"arbpotential\": \"A NUMERIC(10,4) arbitrage potential (e.g., '0.0575').\", \"basisgap\": \"A NUMERIC(10,4) basis spread (futures vs spot) (e.g., '0.0300').\", \"fundgap\": \"A NUMERIC(10,4) funding arbitrage difference (e.g., '0.0050').\", \"xexchband\": \"A NUMERIC(10,4) cross-exchange spread (e.g., '0.0125').\"}, \"big_players\": {\"makermotion\": \"An enum (MakerMotion_enum) for market maker activity (Low, Medium, High).\", \"whalemotion\": \"An enum (WhaleMotion_enum) for large trader activity (Low, Medium, High).\"}, \"flow\": {\"flowimbal\": \"A DOUBLE PRECISION for order-flow imbalance (e.g., 12.5).\", \"instflow\": \"A REAL capturing institutional flows (e.g., 7.9).\", \"largeflowrate\": \"A DECIMAL(12,3) fraction of large orders (e.g., '0.125').\", \"retailflow\": \"A REAL capturing retail flows (e.g., 5.3).\", \"smartforce\": \"A REAL capturing 'smart money' flows (e.g., 10.2).\", \"tradeimbal\": \"A DOUBLE PRECISION for trade-flow imbalance (e.g., -8.75).\"}, \"momentum\": {\"buyforce\": \"A REAL indicating buy momentum (e.g., 35.7).\", \"mktfeel\": \"An enum (MktFeel_enum) for overall sentiment (Bearish, Bullish, Neutral).\", \"sellforce\": \"A REAL indicating sell momentum (e.g., 25.4).\", \"techmeter\": \"An enum (TechMeter_enum) summarizing technical signals (Buy, Sell, Hold).\"}, \"oscillators\": {\"bbandspan\": \"A NUMERIC(12,3) Bollinger Band width (e.g., '150.250').\", \"macdtrail\": \"A NUMERIC(12,3) capturing MACD line (e.g., '1.234').\", \"rsi14spot\": \"A NUMERIC(13,3) storing RSI(14) (e.g., '45.123').\"}, \"walls\": {\"buywallband\": \"A DECIMAL(10,3) measuring buy wall distance (e.g., '450.500').\", \"sellwallband\": \"A DECIMAL(10,3) measuring sell wall distance (e.g., '480.250').\"}}}", description: "JSONB column. Aggregates order‑book walls, momentum gauges, technical oscillators, flow imbalances, large‑player activity, and arbitrage signals to streamline advanced analytics and back‑testing.", declared_type: "JSONB", examples: ["450.500", "480.250", "35.7", "25.4", "45.123", "1.234", "150.250", "12.5", "-8.75", "0.125", "10.2", "5.3", "7.9", "0.0575", "0.0125", "0.0050", "0.0300"]});

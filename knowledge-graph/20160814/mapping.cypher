MERGE (n:Knowledge:SemanticSearch {id: "fake:70"}) SET n = {id: "fake:70", name: "TEI quartile", type: "calculation_knowledge", description: "Categorizes accounts into four groups based on their TEI values.", definition: "Q_{TEI} = \begin{cases} 1 & \text{if TEI} in [0, P_{25}] \\ 2 & \text{if TEI} in (P_{25}, P_{50}] \\ 3 & \text{if TEI} in (P_{50}, P_{75}] \\ 4 & \text{if TEI} in (P_{75}, P_{100}] \\end{cases} where P_n represents the nth percentile of TEI values", source_file: "fake_kb.jsonl", source_line: 71, source_id: 70, search_text: "TEI quartile calculation_knowledge Categorizes accounts into four groups based on their TEI values. Q_{TEI} = \begin{cases} 1 & \text{if TEI} in [0, P_{25}] \\ 2 & \text{if TEI} in (P_{25}, P_{50}] \\ 3 & \text{if TEI} in (P_{50}, P_{75}] \\ 4 & \text{if TEI} in (P_{75}, P_{100}] \\end{cases} where P_n represents the nth percentile of TEI values"};
MERGE (n:Knowledge:SemanticSearch {id: "fake:71"}) SET n = {id: "fake:71", name: "Latest Bot Likelihood Score (LBS)", type: "calculation_knowledge", description: "The most recent bot likelihood score for an account based on security detection timestamps.", definition: "LBS_a = \\text{botlikscore}(\\max_{t \\in T_a} \\text{detecttime}_t) where T_a is the set of all detection timestamps for account a", source_file: "fake_kb.jsonl", source_line: 72, source_id: 71, search_text: "Latest Bot Likelihood Score (LBS) calculation_knowledge The most recent bot likelihood score for an account based on security detection timestamps. LBS_a = \\text{botlikscore}(\\max_{t \\in T_a} \\text{detecttime}_t) where T_a is the set of all detection timestamps for account a"};

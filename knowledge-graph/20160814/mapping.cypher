CREATE (n:Column {database_name: "fake", table_name: "profile", column_name: "profile_composition", ordinal: 3, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "fake:profile:profile_composition", raw_text: "{\"column_meaning\": \"JSONB column. Consolidates username, picture, bio, location, and contact‑credibility attributes to streamline profile‑quality checks and downstream ML feature extraction.\", \"fields_meaning\": {\"bio\": {\"biokeycheck\": \"An enum (BioKeywordMatch_enum) flagging suspicious or notable keywords (Suspicious, Normal, Spam, Promo).\", \"biolang\": \"An enum (BioLanguage_enum) for the bio’s language code (en, multiple, mixed, unknown).\", \"biolinknum\": \"An enum (BioLinkCount_enum) for the number of links (0 through 5).\", \"biospan\": \"A SMALLINT measuring bio length in characters (e.g., '160').\"}, \"completeness\": \"NUMERIC(3,2) reflecting how complete the profile is (e.g., '0.85').\", \"contact\": {\"maildomainfmt\": \"An enum (EmailDomainType_enum) describing the email domain (Free, Unknown, Custom, Disposable).\", \"phnumstate\": \"An enum (PhoneNumberStatus_enum) describing phone number status (Invalid, VOIP, Valid).\"}, \"display_name\": {\"dispnameshift\": \"A SMALLINT counting how many times the display name changed (e.g., '3').\"}, \"location\": {\"locgiven\": \"An enum (LocationProvided_enum) describing location provisioning (Fake, No, Yes, Multiple).\", \"locshiftnum\": \"A SMALLINT showing how many times the stated location changed (e.g., '2').\"}, \"picture\": {\"picformat\": \"An enum (ProfilePictureType_enum) describing the profile picture type (Stock, AI Generated, Real, Celebrity).\", \"picscval\": \"NUMERIC(4,1) scoring the authenticity/quality of the picture (e.g., '7.5').\"}, \"username\": {\"profnametag\": \"An enum (ProfileNamePattern_enum) describing the profile’s name style (Sequential, Template, Random, Natural).\", \"usrentval\": \"NUMERIC(5,4) capturing username entropy (e.g., '0.2549').\", \"usrlen\": \"A SMALLINT indicating how many characters are in the username (e.g., '12').\", \"usrpatn\": \"An enum (UsernamePattern_enum) storing the username pattern (Random, Generated, Meaningful, AlphaNum).\"}}}", description: "JSONB column. Consolidates username, picture, bio, location, and contact‑credibility attributes to streamline profile‑quality checks and downstream ML feature extraction.", declared_type: "JSONB", examples: ["0.85", "0.2549", "12", "3", "7.5", "160", "2"]});

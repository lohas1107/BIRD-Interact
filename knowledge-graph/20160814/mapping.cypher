CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "telescref", ordinal: 3, data_type: "character", nullable: false, is_primary_key: false, entity_key: "alien:signals:telescref", raw_text: "Full name: 'Telescope Reference'. Explanation: Foreign key to the telescope used for detection. Data type: CHAR(20). Example: 'TELESC_0001'.", description: "Foreign key to the telescope used for detection.", declared_type: "CHAR(20)", examples: ["TELESC_0001"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "detectinstr", ordinal: 4, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:signals:detectinstr", raw_text: "Full name: 'Detection Instrument'. Explanation: The instrument type employed for detecting the signal. Data type: VARCHAR(50). Possible categories: Infrared Array, Optical Telescope, Quantum Detector, Radio Telescope.", description: "The instrument type employed for detecting the signal.", declared_type: "VARCHAR(50)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "signalclass", ordinal: 5, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:signals:signalclass", raw_text: "Full name: 'Signal Type'. Explanation: Broad classification of the detected signal. Data type: VARCHAR(50). Possible categories: Broadband, Continuous, Modulated, Narrowband, Pulsed.", description: "Broad classification of the detected signal.", declared_type: "VARCHAR(50)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "sigstrdb", ordinal: 6, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:sigstrdb", raw_text: "Full name: 'Signal Strength (dB)'. Explanation: Measured strength of the signal in decibels. Data type: NUMERIC(7,2). Example: '12.35'.", description: "Measured strength of the signal in decibels.", declared_type: "NUMERIC(7,2)", examples: ["12.35"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "freqmhz", ordinal: 7, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:freqmhz", raw_text: "Full name: 'Frequency (MHz)'. Explanation: Signal’s nominal frequency in MHz. Data type: DECIMAL(9,3). Example: '1420.405'.", description: "Signal’s nominal frequency in MHz.", declared_type: "DECIMAL(9,3)", examples: ["1420.405"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "bwhz", ordinal: 8, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:bwhz", raw_text: "Full name: 'Bandwidth (Hz)'. Explanation: Signal’s bandwidth in Hertz. Data type: DECIMAL(10,3). Example: '500000.000'.", description: "Signal’s bandwidth in Hertz.", declared_type: "DECIMAL(10,3)", examples: ["500000.000"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "centerfreqmhz", ordinal: 9, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:centerfreqmhz", raw_text: "Full name: 'Center Frequency (MHz)'. Explanation: Center frequency of the detected signal in MHz. Data type: NUMERIC(8,3). Example: '1420.500'.", description: "Center frequency of the detected signal in MHz.", declared_type: "NUMERIC(8,3)", examples: ["1420.500"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "freqdrifthzs", ordinal: 10, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:freqdrifthzs", raw_text: "Full name: 'Frequency Drift (Hz/s)'. Explanation: How fast the signal drifts in frequency over time. Data type: NUMERIC(9,3). Example: '0.123'.", description: "How fast the signal drifts in frequency over time.", declared_type: "NUMERIC(9,3)", examples: ["0.123"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "doppshifthz", ordinal: 11, data_type: "double precision", nullable: true, is_primary_key: false, entity_key: "alien:signals:doppshifthz", raw_text: "Full name: 'Doppler Shift (Hz)'. Explanation: Measured Doppler shift of the signal in Hertz. Data type: DOUBLE PRECISION. Example: '142.75'.", description: "Measured Doppler shift of the signal in Hertz.", declared_type: "DOUBLE PRECISION", examples: ["142.75"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "sigdursec", ordinal: 12, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:sigdursec", raw_text: "Full name: 'Signal Duration (s)'. Explanation: Total duration of the signal in seconds. Data type: NUMERIC(6,2). Example: '12.50'.", description: "Total duration of the signal in seconds.", declared_type: "NUMERIC(6,2)", examples: ["12.50"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "pulsepersec", ordinal: 13, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:pulsepersec", raw_text: "Full name: 'Pulse Rate (pulses/sec)'. Explanation: Rate of pulse repetition in the signal. Data type: NUMERIC(6,3). Example: '4.500'.", description: "Rate of pulse repetition in the signal.", declared_type: "NUMERIC(6,3)", examples: ["4.500"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "pulsewidms", ordinal: 14, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:pulsewidms", raw_text: "Full name: 'Pulse Width (ms)'. Explanation: Duration of each pulse in milliseconds. Data type: NUMERIC(6,3). Example: '2.300'.", description: "Duration of each pulse in milliseconds.", declared_type: "NUMERIC(6,3)", examples: ["2.300"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "modtype", ordinal: 15, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:signals:modtype", raw_text: "Full name: 'Modulation Type'. Explanation: The method of signal modulation. Data type: VARCHAR(30). Possible categories: AM, FM, PM, QAM, Unknown.", description: "The method of signal modulation.", declared_type: "VARCHAR(30)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "modindex", ordinal: 16, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:modindex", raw_text: "Full name: 'Modulation Index'. Explanation: Numerical index describing modulation depth. Data type: DECIMAL(6,4). Example: '0.2875'.", description: "Numerical index describing modulation depth.", declared_type: "DECIMAL(6,4)", examples: ["0.2875"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "carrierfreqmhz", ordinal: 17, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:carrierfreqmhz", raw_text: "Full name: 'Carrier Frequency (MHz)'. Explanation: Frequency of the carrier wave in MHz. Data type: DECIMAL(9,3). Example: '1000.000'.", description: "Frequency of the carrier wave in MHz.", declared_type: "DECIMAL(9,3)", examples: ["1000.000"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "phaseshiftdeg", ordinal: 18, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:phaseshiftdeg", raw_text: "Full name: 'Phase Shift (°)'. Explanation: Phase shift in degrees for the signal. Data type: NUMERIC(6,2). Example: '45.00'.", description: "Phase shift in degrees for the signal.", declared_type: "NUMERIC(6,2)", examples: ["45.00"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "polarmode", ordinal: 19, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:signals:polarmode", raw_text: "Full name: 'Polarization Mode'. Explanation: Type of signal polarization. Data type: VARCHAR(30). Possible categories: Circular, Elliptical, Linear, Unknown.", description: "Type of signal polarization.", declared_type: "VARCHAR(30)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "polarangledeg", ordinal: 20, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:polarangledeg", raw_text: "Full name: 'Polarization Angle (°)'. Explanation: Angle of polarization in degrees. Data type: DECIMAL(5,1). Example: '90.0'.", description: "Angle of polarization in degrees.", declared_type: "DECIMAL(5,1)", examples: ["90.0"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "snrratio", ordinal: 21, data_type: "numeric", nullable: true, is_primary_key: false, entity_key: "alien:signals:snrratio", raw_text: "Full name: 'Signal-to-Noise Ratio'. Explanation: SNR measured for the signal. Data type: DECIMAL(6,2). Example: '18.75'.", description: "SNR measured for the signal.", declared_type: "DECIMAL(6,2)", examples: ["18.75"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "noisefloordbm", ordinal: 22, data_type: "double precision", nullable: true, is_primary_key: false, entity_key: "alien:signals:noisefloordbm", raw_text: "Full name: 'Noise Floor (dBm)'. Explanation: Measured noise floor in dBm. Data type: DOUBLE PRECISION. Example: '-85.3'.", description: "Measured noise floor in dBm.", declared_type: "DOUBLE PRECISION", examples: ["-85.3"]});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "interflvl", ordinal: 23, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:signals:interflvl", raw_text: "Full name: 'Interference Level'. Explanation: Degree of interference around the signal. Data type: VARCHAR(30). Possible categories: High, Low, Medium, None.", description: "Degree of interference around the signal.", declared_type: "VARCHAR(30)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "rfistat", ordinal: 24, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:signals:rfistat", raw_text: "Full name: 'RFI Status'. Explanation: Radio Frequency Interference status. Data type: VARCHAR(30). Possible categories: Clean, Contaminated, Unknown.", description: "Radio Frequency Interference status.", declared_type: "VARCHAR(30)", examples: []});
CREATE (n:Column {database_name: "alien", table_name: "signals", column_name: "atmointerf", ordinal: 25, data_type: "character varying", nullable: true, is_primary_key: false, entity_key: "alien:signals:atmointerf", raw_text: "Full name: 'Atmospheric Interference'. Explanation: Impact of atmospheric conditions on signal. Data type: VARCHAR(30). Possible categories: Minimal, Moderate, Severe.", description: "Impact of atmospheric conditions on signal.", declared_type: "VARCHAR(30)", examples: []});
CREATE (n:Table {database_name: "alien", table_name: "observationalconditions", description: "", entity_key: "alien:observationalconditions"});

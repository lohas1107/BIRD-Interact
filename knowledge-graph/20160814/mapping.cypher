CREATE (n:Column {database_name: "mental", table_name: "assessmentsymptomsandrisk", column_name: "mental_health_scores", ordinal: 9, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "mental:assessmentsymptomsandrisk:mental_health_scores", raw_text: "{\"column_meaning\": \"JSONB column. Aggregates scores related to mental health symptoms and risk factors, such as depression, anxiety, and other symptom metrics.\", \"fields_meaning\": {\"anxiety\": {\"gad7_score\": \"A SMALLINT for GAD-7 score (0–21).\", \"gad7_severity\": \"An enum (gad7severity_enum) for anxiety severity (Mild, Moderate, Severe).\"}, \"depression\": {\"phq9_score\": \"A SMALLINT for PHQ-9 score (0–27).\", \"phq9_severity\": \"An enum (phq9severity_enum) for depression severity (Moderately Severe, Mild, Severe, Moderate).\"}, \"symptom_scores\": [\"A NUMERIC(3,1) measuring mood status (e.g., 5.0).\", \"A NUMERIC(3,1) measuring anxiety level (e.g., 4.5).\", \"A NUMERIC(3,1) measuring sleep quality (e.g., 3.0).\", \"A NUMERIC(3,1) measuring appetite (e.g., 2.5).\", \"A NUMERIC(3,1) measuring energy (e.g., 6.0).\", \"A NUMERIC(3,1) measuring concentration (e.g., 5.5).\", \"A NUMERIC(3,1) measuring interest/enjoyment (e.g., 4.0).\", \"A NUMERIC(3,1) measuring hopelessness (e.g., 2.0).\"]}}", description: "JSONB column. Aggregates scores related to mental health symptoms and risk factors, such as depression, anxiety, and other symptom metrics.", declared_type: "JSONB", examples: ["5.0", "4.5", "3.0", "2.5", "6.0", "5.5", "4.0", "2.0"]});

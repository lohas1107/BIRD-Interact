CREATE (n:Column {database_name: "fake", table_name: "networkmetrics", column_name: "network_engagement_metrics", ordinal: 3, data_type: "jsonb", nullable: true, is_primary_key: false, entity_key: "fake:networkmetrics:network_engagement_metrics", raw_text: "{\"column_meaning\": \"JSONB column. Groups connection‑growth, engagement‑quality, and interaction‑diversity measures into one JSONB field for quick network‑level behaviour profiling.\", \"fields_meaning\": {\"connection_metrics\": {\"conngrowpat\": \"An enum (ConnectionGrowthPattern_enum) describing connection growth (Suspicious, Burst, Bot-like, Organic).\", \"connqualscore\": \"NUMERIC(4,1) rating connection quality (e.g., '7.5').\", \"followgrowrate\": \"NUMERIC(4,3) how quickly follower count grows (e.g., '1.234').\", \"followinggrowrate\": \"NUMERIC(5,4) how quickly following count grows (e.g., '2.5678').\", \"followingnum\": \"A BIGINT for how many accounts the user follows (e.g., '6789').\", \"follownum\": \"A BIGINT for how many followers the user has (e.g., '12345').\", \"followratio\": \"NUMERIC(6,2) ratio of followers to following (e.g., '1.50').\", \"mutualconnratio\": \"NUMERIC(3,1) ratio of mutual connections (e.g., '0.8').\"}, \"engagement_metrics\": {\"cmtratio\": \"NUMERIC(3,2) portion of interactions that are comments (e.g., '0.30').\", \"engauth\": \"NUMERIC(5,4) measuring authenticity of engagement (e.g., '0.8524').\", \"engrate\": \"NUMERIC(4,3) user’s engagement rate (e.g., '0.123').\", \"likeratio\": \"NUMERIC(3,2) portion of interactions that are likes (e.g., '0.25').\", \"sharerate\": \"NUMERIC(4,3) portion of interactions that are shares (e.g., '0.456').\"}, \"interaction_metrics\": {\"interactdiv\": \"NUMERIC(4,2) diversity of interactions (e.g., '1.25').\", \"interactreci\": \"NUMERIC(5,3) reciprocity measure (e.g., '0.789').\", \"tempinteractpat\": \"An enum (TemporalInteractionPattern_enum) describing interaction timing (Natural, Periodic, Random, Automated).\"}}}", description: "JSONB column. Groups connection‑growth, engagement‑quality, and interaction‑diversity measures into one JSONB field for quick network‑level behaviour profiling.", declared_type: "JSONB", examples: ["12345", "6789", "1.234", "2.5678", "1.50", "0.8", "7.5", "0.123", "0.8524", "0.25", "0.30", "0.456", "0.789", "1.25"]});

MERGE (k:KGNode:Knowledge:Rule:ThresholdRule {id: "knowledge:virtual:53"}) SET k.name="Fan Value Segmentation", k.description="Classifies fans into value tiers based on their Fan Lifetime Value (FLV) relative to platform-wide percentiles", k.raw_definition="Segments fans into four distinct value categories using percentile thresholds: 'Top Tier' identifies fans with FLV above the 90th percentile (p90), representing the platform's most valuable users; 'High Value' identifies fans with FLV between the 75th and 90th percentiles (p75 to p90); 'Medium Value' identifies fans with FLV between the 50th and 75th percentiles (median to p75); 'Low Value' applies to all fans with FLV below the median (p50). This segmentation enables targeted retention strategies, premium service offerings, and resource allocation based on projected economic contribution.", k.knowledge_type="domain_knowledge", k.database="virtual", k.source_line=54;
MATCH (k:KGNode {id:"knowledge:virtual:53"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);
MERGE (x:KGNode:Assertion {id: "assertion:kb:virtual:53"}) SET x.assertion_kind="knowledge_definition", x.raw_text="Segments fans into four distinct value categories using percentile thresholds: 'Top Tier' identifies fans with FLV above the 90th percentile (p90), representing the platform's most valuable users; 'High Value' identifies fans with FLV between the 75th and 90th percentiles (p75 to p90); 'Medium Value' identifies fans with FLV between the 50th and 75th percentiles (median to p75); 'Low Value' applies to all fans with FLV below the median (p50). This segmentation enables targeted retention strategies, premium service offerings, and resource allocation based on projected economic contribution.", x.status="asserted", x.confidence=0.90, x.source_line=54;
MATCH (x:KGNode {id:"assertion:kb:virtual:53"}), (k:KGNode {id:"knowledge:virtual:53"}) MERGE (x)-[:ASSERTS_ABOUT]->(k);

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:solar:30"}) SET k.name="Temperature Adjusted Performance Ratio (TAPR)", k.description="Enhances the Panel Performance Ratio by accounting for temperature effects.", k.raw_definition="TAPR = PPR + (TPCI / PowerRatedW), where PPR is the Panel Performance Ratio and TPCI is the Temperature Performance Coefficient Impact.", k.knowledge_type="calculation_knowledge", k.database="solar", k.source_line=30;

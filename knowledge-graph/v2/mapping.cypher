MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:polar:2"}) SET k.name="Energy Sustainability Index (ESI)", k.description="Measures the sustainability of an equipment's energy usage by evaluating energy efficiency and renewable sources.", k.raw_definition="ESI = energyefficiencypercent \\times \\begin{cases} 1.5 & \\text{if powersource IN ('Solar', 'Wind')} \\\\ 1.2 & \\text{if powersource = 'Hybrid'} \\\\ 1.0 & \\text{if powersource = 'Battery'} \\\\ 0.7 & \\text{if powersource = 'Diesel'} \\\\ 0 & \\text{otherwise} \\end{cases}, \\text{ providing higher ratings for renewable energy and lower ratings for fossil fuels.}", k.knowledge_type="calculation_knowledge", k.database="polar", k.source_line=3;

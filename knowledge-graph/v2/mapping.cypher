MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:alien:31"}) SET k.name="Artificial Intelligence Detection Probability (AIDP)", k.description="Calculates likelihood of artificial intelligence origin based on encoding complexity and technosignature indicators.", k.raw_definition="$\\text{AIDP} = \\frac{\\text{ECI} \\times \\text{TOLS}}{1 + \\text{NatSrcProb}}$, where ECI (Encoding Complexity Index) and TOLS (Technological Origin Likelihood Score) are weighted against natural source probability.", k.knowledge_type="calculation_knowledge", k.database="alien", k.source_line=32;

MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:insider:20"}) SET k.name="Trader Position Holding Style", k.description="Illustrates the typical duration traders hold their positions, based on their strategy.", k.raw_definition="`posspan`: 'Intraday' implies positions are typically opened and closed within the same trading day. 'Swing' suggests holding for a few days to weeks, capturing short-term price moves. 'Position' implies holding for weeks to months, based on broader trends. 'Long-term' indicates holding for months or years, often based on fundamental analysis.", k.knowledge_type="value_illustration", k.database="insider", k.source_line=21;

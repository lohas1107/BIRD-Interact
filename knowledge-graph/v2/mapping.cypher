MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:virtual:0"}) SET k.name="fans.statustag", k.description="Explains the meaning of fan account status and its impact on platform interactions", k.raw_definition="Fan status typically falls into four categories: 'Active' indicates normal users with full access to all features; 'VIP' represents premium users with privileged services; 'Inactive' refers to dormant accounts with no login for over 30 days, with some features restricted; 'Blocked' means accounts temporarily or permanently banned due to violations, with no access to platform features.", k.knowledge_type="value_illustration", k.database="virtual", k.source_line=1;
MATCH (k:KGNode {id:"knowledge:virtual:0"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

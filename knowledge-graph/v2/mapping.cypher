MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:robot:39"}) SET k.name="Payload Utilization Ratio (PUR)", k.description="Measures how close the robot operates to its payload capacity.", k.raw_definition="For a given robot R, PUR = \\frac{\\sum_{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}} payloadwval}{\\text{(robot_details.payloadcapkg where botdetref = R)} \\cdot \\text{|}\\{ad \\in \\text{actuation_data} \\mid \\text{actdetref = R}\\}|}, \\text{where RAY adjusts for age-related capacity changes if applicable.}", k.knowledge_type="calculation_knowledge", k.database="robot", k.source_line=40;

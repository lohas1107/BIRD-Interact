MERGE (e:KGNode:Expression:Formula {id: "expression:cybermarket:34"}) SET e.raw_expression="TVM = \\frac{COUNT(txregistry)}{(MAX(eventstamp) - MIN(eventstamp))} \\times \\frac{payamtusd}{500} \\times (1 + (paymethod\\_weight \\times 0.1)), \\text{where paymethod\\_weight assigns Crypto\\_A=1, Crypto\\_B=3, Crypto\\_C=2, Token=2 based on the payment method classifications defined in cybermarket|transactions|paymethod, and higher values indicate potentially suspicious transaction velocity.}", e.parse_status="raw", e.language="natural-language-and-latex";

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:mental:4"}) SET k.name="Therapy Engagement Score (TES)", k.description="Computes an average engagement score across therapy sessions.", k.raw_definition="TES = \\frac{\\sum_{i \\in treatmentbasics} (therapy\\_details_i['engagement\\_score'])} {|treatmentbasics|}, \\text{where } engagement\\_score = \\begin{cases} 3 & \\text{if } therapy\\_details['engagement'] = High \\\\ 2 & \\text{if } therapy\\_details['engagement'] = Medium \\\\ 1 & \\text{if } therapy\\_details['engagement'] = Low \\\\ 0 & \\text{if } therapy\\_details['engagement'] = Non-compliant \\end{cases}, \\text{and } therapy\\_details \\text{ is the JSONB column in the treatmentbasics table}", k.knowledge_type="calculation_knowledge", k.database="mental", k.source_line=5;

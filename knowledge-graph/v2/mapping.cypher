MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:virtual:14"}) SET k.name="Social Influence Multiplier (SIM)", k.description="Calculates how much a fan amplifies content through their social network", k.raw_definition="SIM = \\left(\\frac{follcount}{100}\\right) \\times (engrate \\times 2) \\times (viralcont + 1) \\times 0.5, \\text{ reflecting the fan's ability to spread content through their network based on their following, engagement level, and history of creating viral content.}", k.knowledge_type="calculation_knowledge", k.database="virtual", k.source_line=15;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:31"}) SET k.name="Environmental Impact Factor (EIF)", k.description="Quantifies how environmental conditions affected scan quality using statistical correlation analysis.", k.raw_definition="EIF = \\frac{SQS}{\\text{ESI} + 10} \\times 100, \\text{ where SQS is the Scan Quality Score and ESI is the Environmental Suitability Index. Values closer to 100 indicate minimal environmental interference with data acquisition.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=32;

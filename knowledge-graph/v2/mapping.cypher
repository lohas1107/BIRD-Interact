MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:insider:21"}) SET k.name="Dark Pool Usage Venues", k.description="Explains the nature of dark pool usage indicated in transaction records.", k.raw_definition="`darkusage`: This field lists Alternative Trading Systems (ATS) or other dark pools used. 'ATS-X', 'ATS-Y' are anonymized identifiers for specific dark pools, which are private exchanges where large orders can be executed without revealing intent to the public market, potentially reducing market impact. Usage patterns can be analyzed for regulatory compliance (e.g., ensuring best execution) or signs of avoiding market transparency.", k.knowledge_type="value_illustration", k.database="insider", k.source_line=22;

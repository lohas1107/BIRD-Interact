MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:virtual:10"}) SET k.name="Fan Engagement Index (FEI)", k.description="A comprehensive metric measuring fan activity level with platform and virtual idols", k.raw_definition="FEI = (engrate \\times 0.4) + (\\frac{socintscore}{100} \\times 0.3) + (\\frac{actdayswk}{7} \\times 0.2) + (\\frac{avgsesscount}{10} \\times 0.1), \\text{ where weights reflect each factor's different contribution to engagement, with results ranging from 0-1. Higher values indicate more engaged fans.}", k.knowledge_type="calculation_knowledge", k.database="virtual", k.source_line=11;
MATCH (k:KGNode {id:"knowledge:virtual:10"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

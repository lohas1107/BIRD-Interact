MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:archeology:25"}) SET k.name="PhaseFactor (Cultural Period)", k.description="Illustrates the significance of cultural period classification in archaeological sites.", k.raw_definition="Classifies archaeological sites into standardized chronological/cultural periods. Values like 'Neolithic' (10,000-4,500 BCE), 'Bronze Age' (3,300-1,200 BCE), 'Roman' (27 BCE-476 CE), or 'Medieval' (476-1453 CE) determine applicable research methodologies, conservation approaches, and contextual interpretation frameworks.", k.knowledge_type="value_illustration", k.database="archeology", k.source_line=26;

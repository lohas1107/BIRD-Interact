MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:archeology:22"}) SET k.name="NoiseDb (Noise Level)", k.description="Illustrates the impact of noise levels in point cloud data on feature recognition accuracy.", k.raw_definition="Measured in decibels, representing signal-to-noise ratio in scan data. Values below 1.0 indicate clean data suitable for detailed analysis, while values above 3.0 suggest significant noise that may obscure small features and introduce measurement uncertainty.", k.knowledge_type="value_illustration", k.database="archeology", k.source_line=23;

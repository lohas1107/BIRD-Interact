MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:gaming:32"}) SET k.name="Ergonomic Sustainability Factor (ESF)", k.description="Evaluates how suitable a device is for extended gaming sessions based on ergonomic design and comfort metrics.", k.raw_definition="ESF = CI \\times \\left(1 + \\frac{ErgoRate - 5}{10}\\right) \\times \\left(1 - \\frac{|PalmAngle - 15|}{30}\\right) \\times \\left(1 + \\frac{ErgoRate \\times WristFlag}{50}\\right)", k.knowledge_type="calculation_knowledge", k.database="gaming", k.source_line=33;

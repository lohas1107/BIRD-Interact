MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:38"}) SET k.name="Digital Preservation Quality (DPQ)", k.description="Comprehensive metric for evaluating digital preservation quality for archaeological sites with weighted quality factors.", k.raw_definition="DPQ = (0.3 \\times ADC) + (0.3 \\times MFS) + (0.2 \\times RAR) + (0.2 \\times SCE) - 2 \\times \\sqrt{\\frac{ErrValMm}{ScanResolMm}}, \\text{ where ADC is Archaeological Documentation Completeness, MFS is Model Fidelity Score, RAR is Registration Accuracy Ratio, and SCE is Scan Coverage Effectiveness.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=39;

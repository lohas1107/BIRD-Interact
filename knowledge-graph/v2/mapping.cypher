MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:crypto:0"}) SET k.name="Spread Percentage", k.description="Calculates the spread as a percentage of the midpoint price.", k.raw_definition="Spread Percentage = \\frac{askquote - bidquote}{midquote} \\times 100, \\text{where } askquote \\text{ is the best ask price, } bidquote \\text{ is the best bid price, and } midquote \\text{ is the midpoint price.}", k.knowledge_type="calculation_knowledge", k.database="crypto", k.source_line=1;

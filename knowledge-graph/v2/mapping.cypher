MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:cybermarket:39"}) SET k.name="Money Flow Complexity (MFC)", k.description="Quantifies the complexity of money flows in transaction chains", k.raw_definition="MFC = (txchainlen \\times 5) + (linkedtxcount \\times 3) + (moneyrisk_numeric \\times 15) + (TCR \\times 0.2) - (profilecomplete \\times 10), \\text{where moneyrisk_numeric maps Low=1, Medium=2, High=3, Unknown=2 according to the money laundering risk classification, and higher scores indicate more complex money flows.}", k.knowledge_type="calculation_knowledge", k.database="cybermarket", k.source_line=40;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:0"}) SET k.name="Scan Resolution Index (SRI)", k.description="A sophisticated compound index measuring the overall resolution quality of a scan based on resolution and point density.", k.raw_definition="SRI = \\frac{\\log_{10}(ScanResolMm \\times 10^3)}{\\log_{10}(PointDense)} \\times 5, \\text{ where lower values indicate higher quality resolution and more balanced scanning parameters.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=1;

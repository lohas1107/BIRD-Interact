MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:solar:32"}) SET k.name="Maintenance Return on Investment (MROI)", k.description="Evaluates the financial return of maintenance activities.", k.raw_definition="MROI = RLR / MCE, where RLR is the Revenue Loss Rate and MCE is the Maintenance Cost Efficiency. Higher values indicate better return on maintenance investments.", k.knowledge_type="calculation_knowledge", k.database="solar", k.source_line=32;

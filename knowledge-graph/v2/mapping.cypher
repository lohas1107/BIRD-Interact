MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:insider:24"}) SET k.name="Momentum Ignition Signals", k.description="Explains the signals related to attempting to artificially create price momentum.", k.raw_definition="`risk_indicators.momentignit`: 'Strong' indicates patterns consistent with attempts to trigger momentum algorithms or attract other traders by creating a false sense of rapid price movement (e.g., through rapid successive trades). 'Weak' suggests such patterns are less evident or absent. This is a potential indicator of manipulative behavior.", k.knowledge_type="value_illustration", k.database="insider", k.source_line=25;

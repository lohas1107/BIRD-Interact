MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:30"}) SET k.name="Scan Time Efficiency (STE)", k.description="Measures how efficiently scanning time was used relative to data quality and completeness metrics.", k.raw_definition="STE = \\frac{SQS \\times \\sqrt{CoverPct}}{SpanMin \\times \\sqrt{ScanCount}}, \\text{ where SQS is the Scan Quality Score and higher STE values indicate more efficient use of scanning time relative to coverage achieved.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=31;

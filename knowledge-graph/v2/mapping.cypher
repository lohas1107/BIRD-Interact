MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:6"}) SET k.name="Model Fidelity Score (MFS)", k.description="Combines mesh complexity, texture quality, and geometric accuracy to assess overall 3D model fidelity for archaeological analysis.", k.raw_definition="MFS = MCR \\times \\left(\\frac{TDI}{10}\\right) \\times \\left(1 + \\exp\\left(-GeomDeltaMm\\right)\\right), \\text{ where higher values indicate more accurate and detailed models with appropriate complexity.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=7;

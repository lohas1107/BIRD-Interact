MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:polar:24"}) SET k.name="powerconsumptionw", k.description="Illustrates the significance of power consumption measurements in energy management.", k.raw_definition="Power consumption measured in watts varies by equipment type. Small scientific instruments typically consume 5-50W, communication equipment 20-200W, heating systems 500-5000W, and vehicle systems 1000-10000W. Understanding consumption patterns is crucial for power budgeting and determining appropriate power source sizing in isolated polar environments.", k.knowledge_type="value_illustration", k.database="polar", k.source_line=25;
MATCH (k:KGNode {id:"knowledge:polar:24"}), (d:KGNode {id:"concept:domain:polar"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

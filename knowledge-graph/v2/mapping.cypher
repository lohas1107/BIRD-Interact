MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:crypto:20"}) SET k.name="dealedge", k.description="Illustrates the meaning of different values for the dealedge enum.", k.raw_definition="An enum with values 'Buy' or 'Sell'. 'Buy' indicates the order is to purchase the base asset using the quote asset (e.g., buying BTC with USDT). 'Sell' indicates the order is to sell the base asset for the quote asset (e.g., selling BTC for USDT).", k.knowledge_type="value_illustration", k.database="crypto", k.source_line=21;

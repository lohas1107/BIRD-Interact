MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:crypto:32"}) SET k.name="Order Book Imbalance Ratio", k.description="Quantifies the imbalance between bid and ask sides of the order book.", k.raw_definition="Order Book Imbalance Ratio = \\frac{biddepth - askdepth}{biddepth + askdepth}, \\text{where } biddepth \\text{ is the deeper bid liquidity and } askdepth \\text{ is the deeper ask liquidity. A positive Imbalance Ratio indicates stronger buying pressure, while negative indicates stronger selling pressure.", k.knowledge_type="calculation_knowledge", k.database="crypto", k.source_line=33;

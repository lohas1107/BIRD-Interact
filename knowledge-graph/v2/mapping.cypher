MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:34"}) SET k.name="Spatial Density Index (SDI)", k.description="Assesses point cloud density relative to site dimensions for spatial sampling adequacy.", k.raw_definition="SDI = \\frac{TotalPts}{AreaM2 \\times 10^4} \\times \\left(\\frac{PointDense}{CloudDense}\\right)^{0.5}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=35;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:cybermarket:36"}) SET k.name="Operational Security Index (OSI)", k.description="Quantifies an entity's operational security practices", k.raw_definition="OSI = (APL \\times 0.5) + (SPS \\times 0.2) + (tornodecount \\times 2) + (CASE WHEN encryptmethod = 'Standard' THEN 1 WHEN encryptmethod = 'Enhanced' THEN 2 WHEN encryptmethod = 'Custom' THEN 3 ELSE 0 END \\times 5) - (iptally \\times 0.5), \\text{where APL and SPS are defined by the Anonymity Protection Level and Security Posture Score respectively, and higher scores indicate stronger operational security.}", k.knowledge_type="calculation_knowledge", k.database="cybermarket", k.source_line=37;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:solar:31"}) SET k.name="Total System Loss (TSL)", k.description="Calculates the combined power losses from all major sources.", k.raw_definition="TSL = (PowerRatedW × CumDegPct/100) + (MeasuredPowerW × SoilingLossPct/100) + IEL, where IEL is the Inverter Efficiency Loss and CumDegPct is from efficiency_profile.degradation.cumdegpct.", k.knowledge_type="calculation_knowledge", k.database="solar", k.source_line=31;

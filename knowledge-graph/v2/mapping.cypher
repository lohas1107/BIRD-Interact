MERGE (k:KGNode:Knowledge:Rule:ThresholdRule {id: "knowledge:vaccine:10"}) SET k.name="Container Health Status", k.description="Classifies containers based on overall risk and temperature stability to prioritize immediate action and monitor operational trends.", k.raw_definition="Four-level classification based on CRI, TSS, and TBS:\n- Critical: CRI > 0.6 OR current TSS < 0.4\n- Unstable: Average TSS < 0.4 OR maximum TBS > 1.5 over the past 1 year, and not Critical\n- Moderate: Average TSS >= 0.4 AND maximum TBS <= 1.5 over the past 1 year, and not Critical\n- Stable: Average TSS >= 0.7 AND maximum TBS <= 1.0 over the past 1 year, and not Critical", k.knowledge_type="domain_knowledge", k.database="vaccine", k.source_line=11;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:news:0"}) SET k.name="User Engagement Rate (UER)", k.description="Calculates the engagement rate of a user during a session by combining engagement score, page views, and session duration.", k.raw_definition="UER = \\frac{\\text{seshviews} \\times \\text{engscore}}{\\text{seshdur}}, \\text{ where seshviews is the number of articles viewed and seshdur is the duration in seconds.}", k.knowledge_type="calculation_knowledge", k.database="news", k.source_line=1;

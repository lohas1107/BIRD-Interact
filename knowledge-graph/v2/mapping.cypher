MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:polar:20"}) SET k.name="reliabilityindex", k.description="Illustrates the significance of reliability index measurements in equipment durability.", k.raw_definition="The reliability index typically ranges from 0 to 1, where values below 0.5 indicate equipment that fails frequently and requires constant maintenance, values between 0.5-0.8 represent equipment with occasional failures that require regular maintenance, and values above 0.8 indicate highly reliable equipment with minimal downtime.", k.knowledge_type="value_illustration", k.database="polar", k.source_line=21;

MERGE (a:KGNode:LogicalAttribute {id: "attribute:news:interactionmetrics:interaction_behavior"}) SET a.name="interaction_behavior", a.database="news", a.table="interactionmetrics", a.description="{\"column_meaning\": \"JSONB column. Captures user interaction behavior metrics, including scroll depth, time spent, and conversion details.\", \"fields_meaning\": {\"bounce_status\": \"An enum (bouncestatus_enum) indicating if this was a bounce (Yes, No).\", \"click_seconds\": \"A NUMERIC(6,2) time to first click in seconds (e.g., 10.50).\", \"conversion\": {\"status\": \"An enum (conversionstatus_enum) describing a conversion event (Share, Newsletter, Subscription).\", \"value\": \"A NUMERIC(10,2) capturing any monetary or point value of the conversion (e.g., 5.00).\"}, \"exit_type\": \"An enum (exittype_enum) describing exit type (Timeout, Natural, Bounce, External).\", \"next_action\": \"An enum (nextaction_enum) referencing the next action the user took (Exit, Another Article, Share, Search).\", \"scroll\": {\"depth\": \"An INT measuring how deep the user scrolled or engaged (e.g., 2 screen lengths).\", \"percentage\": \"A NUMERIC(5,2) capturing scroll depth percentage (e.g., 75.50).\", \"speed\": \"A NUMERIC(6,2) measuring scroll speed in px/sec (e.g., 50.25).\"}, \"time_spent\": {\"attention_time\": \"A NUMERIC(6,2) capturing user’s attention time (e.g., 18.50).\", \"duration_seconds\": \"An INT measuring the total seconds spent in this interaction (e.g., 30).\", \"reading_seconds\": \"A NUMERIC(6,2) how many seconds the user spent actually reading (e.g., 15.00).\", \"viewport_time\": \"A NUMERIC(6,2) time the content was in the viewport (e.g., 20.00).\"}}}";

MERGE (k:KGNode:Knowledge:Rule:ClassificationRule {id: "knowledge:polar:25"}) SET k.name="Water Quality Classification System (WQCS)", k.description="A standardized system that categorizes water quality for health, safety, and operational purposes in polar environments.", k.raw_definition="Water is classified into five quality categories based on its quality index: 'High-Quality' WHEN (waterqualityindex >= 91), suitable for all purposes including direct consumption; 'Good' WHEN (waterqualityindex >= 71 AND waterqualityindex < 91), safe for consumption after standard treatment; 'Moderate' WHEN (waterqualityindex >= 51 AND waterqualityindex < 71), acceptable for washing but not consumption; 'Poor' WHEN (waterqualityindex >= 26 AND waterqualityindex < 51), suitable only for limited non-contact uses; 'Unsafe' WHEN (waterqualityindex < 26), unsuitable for any use and requiring immediate remediation.", k.knowledge_type="domain_knowledge", k.database="polar", k.source_line=26;
MATCH (k:KGNode {id:"knowledge:polar:25"}), (d:KGNode {id:"concept:domain:polar"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);
MERGE (x:KGNode:Assertion {id: "assertion:kb:polar:25"}) SET x.assertion_kind="knowledge_definition", x.raw_text="Water is classified into five quality categories based on its quality index: 'High-Quality' WHEN (waterqualityindex >= 91), suitable for all purposes including direct consumption; 'Good' WHEN (waterqualityindex >= 71 AND waterqualityindex < 91), safe for consumption after standard treatment; 'Moderate' WHEN (waterqualityindex >= 51 AND waterqualityindex < 71), acceptable for washing but not consumption; 'Poor' WHEN (waterqualityindex >= 26 AND waterqualityindex < 51), suitable only for limited non-contact uses; 'Unsafe' WHEN (waterqualityindex < 26), unsuitable for any use and requiring immediate remediation.", x.status="asserted", x.confidence=0.90, x.source_line=26;

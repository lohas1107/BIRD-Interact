MERGE (k:KGNode:Knowledge:Rule:ClassificationRule {id: "knowledge:crypto:50"}) SET k.name="Flow Dominance", k.description="Categorizes market flow based on which group (smart money, retail, or institutional) has the highest trading volume.", k.raw_definition="Categorized as 'Smart Money Dominant' when smartforce > retail_flow * 1.2 AND smartforce > inst_flow * 1.2; 'Retail Dominant' when retail_flow > smartforce * 1.2 AND retail_flow > inst_flow * 1.2; 'Institutional Dominant' when inst_flow > smartforce * 1.2 AND inst_flow > retail_flow * 1.2; otherwise 'Mixed'.", k.knowledge_type="domain_knowledge", k.database="crypto", k.source_line=51;

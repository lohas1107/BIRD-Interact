MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:insider:25"}) SET k.name="Marking the Close Patterns", k.description="Explains the patterns associated with influencing the closing price of a security.", k.raw_definition="`risk_indicators.markclosepat`: 'Frequent' indicates repeated trading activity near the market close, potentially intended to manipulate the closing price (e.g., to affect margin calls, NAV calculations, or settlement prices). 'Occasional' suggests such activity is infrequent or less patterned. Marking the close is a prohibited manipulative practice.", k.knowledge_type="value_illustration", k.database="insider", k.source_line=26;

MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:gaming:25"}) SET k.name="WlSignal (Wireless Signal Strength)", k.description="Illustrates the importance of wireless signal strength measurements for stable connectivity.", k.raw_definition="Typically measured in dBm, with values ranging from -30 (excellent) to -90 (poor). Signal strength above -50dBm indicates optimal performance with minimal interference, -50 to -70dBm represents good connectivity suitable for most gaming, while below -70dBm may experience occasional disconnections or increased latency in challenging environments.", k.knowledge_type="value_illustration", k.database="gaming", k.source_line=26;

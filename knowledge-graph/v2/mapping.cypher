MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:cybermarket:38"}) SET k.name="Cross-Platform Risk Amplification (CPRA)", k.description="Measures how risk increases when an entity operates across multiple platforms", k.raw_definition="CPRA = (keymatchcount \\times 3) + (COUNT(DISTINCT mktref) \\times 10) + (WRI \\times 0.2) + (\\frac{mktspan}{365} \\times 5) - (\\frac{compliancescore}{20}), \\text{where WRI is defined by the Wallet Risk Index, platformcount is the count of distinct markets an entity operates on, and higher values indicate greater cross-platform risk.}", k.knowledge_type="calculation_knowledge", k.database="cybermarket", k.source_line=39;

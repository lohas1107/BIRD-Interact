MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:alien:30"}) SET k.name="Modulation Complexity Score (MCS)", k.description="Quantifies the sophistication of signal modulation based on type and stability.", k.raw_definition="$\\text{MCS} = \\text{ModIndex} \\times (1 + \\text{SSM}) \\times M_{\\text{factor}}$, where $M_{\\text{factor}}$ is 2 for $\\text{ModType} = \\text{'AM'}$, 1.5 for 'FM', and 1 for other types. Incorporates Signal Stability Metric (SSM) to weight stable modulations higher.", k.knowledge_type="calculation_knowledge", k.database="alien", k.source_line=31;

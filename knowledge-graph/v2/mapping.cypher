MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:3"}) SET k.name="Scan Quality Score (SQS)", k.description="Comprehensive quality metric combining resolution, coverage, and noise factors with weighted importance.", k.raw_definition="SQS = \\left(\\frac{10}{SRI}\\right)^{1.5} \\times \\left(\\frac{SCE}{100}\\right) \\times \\left(1 - \\frac{NoiseDb}{30}\\right)^2, \\text{ where higher values indicate exponentially better overall scan quality with emphasis on resolution.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=4;

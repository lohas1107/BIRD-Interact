MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:virtual:4"}) SET k.name="engagement.actfreq", k.description="Analyzes the significance of interaction frequency for fan classification", k.raw_definition="'Daily' users log into the platform at least once per day on average; 'Weekly' users log in 3-5 times per week; 'Monthly' users log in 1-2 times per month; 'Occasional' users have login intervals exceeding one month. Interaction frequency affects platform push priority, content recommendations, and event invitations, with Daily users considered the platform's core active group.", k.knowledge_type="value_illustration", k.database="virtual", k.source_line=5;
MATCH (k:KGNode {id:"knowledge:virtual:4"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

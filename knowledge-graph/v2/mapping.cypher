MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:cybermarket:30"}) SET k.name="Market Vulnerability Index (MVI)", k.description="Evaluates a market's susceptibility to disruption or shutdown", k.raw_definition="MVI = (100 - MSI) + (COUNT(CASE WHEN alertsev IS NOT NULL THEN 1 END) / 10) \\times (alertsev_numeric \\times 2) - (vendcount \\times 0.05) + (COUNT(CASE WHEN lawinterest = 'High' THEN 1 END) / 5), \\text{where alertsev_numeric maps Low=1, Medium=2, High=3, Critical=4 as defined in the alert severity system, and higher scores indicate greater vulnerability to disruption.}", k.knowledge_type="calculation_knowledge", k.database="cybermarket", k.source_line=31;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:virtual:13"}) SET k.name="Retention Risk Factor (RRF)", k.description="Quantifies the risk of fan churn based on multiple behavioral indicators", k.raw_definition="RRF = (1 - intconsist) \\times 2 + \\left(\\frac{CURRENT\\_DATE - lastlogdt}{30}\\right) \\times 0.5 + \\left(\\frac{churnflag\\_numeric}{3}\\right) \\times 2, \\text{ where churnflag\\_numeric maps churnflag enum: None=0, Low=1, Medium=2, High=3.}", k.knowledge_type="calculation_knowledge", k.database="virtual", k.source_line=14;

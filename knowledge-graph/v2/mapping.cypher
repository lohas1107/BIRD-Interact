MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:cybermarket:34"}) SET k.name="Transaction Velocity Metric (TVM)", k.description="Measures the rapidity and volume of transactions from a single source", k.raw_definition="TVM = \\frac{COUNT(txregistry)}{(MAX(eventstamp) - MIN(eventstamp))} \\times \\frac{payamtusd}{500} \\times (1 + (paymethod\\_weight \\times 0.1)), \\text{where paymethod\\_weight assigns Crypto\\_A=1, Crypto\\_B=3, Crypto\\_C=2, Token=2 based on the payment method classifications defined in cybermarket|transactions|paymethod, and higher values indicate potentially suspicious transaction velocity.}", k.knowledge_type="calculation_knowledge", k.database="cybermarket", k.source_line=35;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:virtual:11"}) SET k.name="Monetization Value (MV)", k.description="Calculates the monetary value a fan brings to the platform over time", k.raw_definition="MV = spendusd \\times \\left(1 + \\frac{membdays}{365} \\times 0.5\\right) \\times \\left(1 + \\frac{gifttot}{10} \\times 0.2\\right), \\text{ where the formula adjusts spending based on membership duration and gift activity to reflect long-term value.}", k.knowledge_type="calculation_knowledge", k.database="virtual", k.source_line=12;

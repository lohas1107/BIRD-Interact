MERGE (a:KGNode:LogicalAttribute {id: "attribute:crypto:marketdata:quote_depth_snapshot"}) SET a.name="quote_depth_snapshot", a.database="crypto", a.table="marketdata", a.description="{\"column_meaning\": \"JSONB column. Captures a full market‑microstructure snapshot—best quotes, size, depth, spreads, and derived mid/mark/index prices—inside a single JSONB column.\", \"fields_meaning\": {\"depth\": {\"askdepth\": \"A REAL summarizing deeper ask liquidity (e.g., 42.1).\", \"askunits\": \"A NUMERIC(12,4) quantity at best ask (e.g., '8.0000').\", \"biddepth\": \"A REAL summarizing deeper bid liquidity (e.g., 56.7).\", \"bidunits\": \"A NUMERIC(12,4) quantity at best bid (e.g., '12.5000').\"}, \"metadata\": {\"exchnote\": \"A CHAR(10) for exchange code (e.g., 'FTX').\", \"mktcombo\": \"A VARCHAR(30) naming the trading pair (e.g., 'ETH/USDT').\", \"timetrack\": \"A TIMESTAMP noting when data was recorded (e.g., '2025-05-10 13:45:30').\"}, \"quotes\": {\"askquote\": \"A DECIMAL(12,3) best ask price (e.g., '27555.100').\", \"bidquote\": \"A DECIMAL(12,3) best bid price (e.g., '27550.250').\", \"indexquote\": \"A DECIMAL(12,3) index price if used (e.g., '27560.125').\", \"markquote\": \"A DECIMAL(12,3) reference 'mark' price for derivatives (e.g., '27553.000').\", \"midquote\": \"A DECIMAL(12,3) midpoint price (e.g., '27552.675').\"}, \"spread\": {\"spreadband\": \"A DOUBLE PRECISION for raw spread (e.g., 4.850).\", \"spreadrate\": \"A DECIMAL(8,4) spread as a ratio or percentage (e.g., '0.0175').\"}}}";
MERGE (p:KGNode:PhysicalSchemaItem:PhysicalColumn {id: "physical:crypto:column:marketdata:quote_depth_snapshot"}) SET p.name="quote_depth_snapshot", p.database="crypto", p.table="marketdata", p.data_type="jsonb", p.nullable=true, p.primary_key=false;

MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:32"}) SET k.name="Feature Extraction Efficiency (FEE)", k.description="Measures the efficiency of feature identification in scan data relative to point cloud density and complexity.", k.raw_definition="FEE = \\frac{TraitCount + ArtiCount}{PCDR \\times \\sqrt{CloudDense}} \\times 10^3, \\text{ where PCDR is the Point Cloud Density Ratio and higher values indicate more effective feature extraction from point cloud data relative to spatial distribution efficiency.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=33;

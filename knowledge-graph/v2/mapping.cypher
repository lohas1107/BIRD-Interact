MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:robot:50"}) SET k.name="JDI-TOH Regression Slope", k.description="Measures the linear relationship between Joint Degradation Index and Total Operating Hours using regression.", k.raw_definition="For a set of robots meeting JDI > 1.5, MJT > 65, and TOH > 5000, the JDI-TOH Regression Slope is given by \\[ \\text{slope} = \\frac{n \\sum (x_i y_i) - \\sum x_i \\sum y_i}{n \\sum x_i^2 - (\\sum x_i)^2} \\] where \\( y_i = \\text{JDI} \\) (Joint Degradation Index for robot \\( i \\)), \\( x_i = \\text{TOH} \\) (Total Operating Hours for robot \\( i \\)), \\( n \\) is the number of qualifying robots, and sums are over all qualifying robots.", k.knowledge_type="calculation_knowledge", k.database="robot", k.source_line=51;

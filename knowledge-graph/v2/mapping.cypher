MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:cybermarket:3"}) SET k.name="cybermarket|transactions|txstatus", k.description="Explains the transaction lifecycle stages and their implications", k.raw_definition="'Pending' represents initiated but incomplete transactions awaiting verification or escrow conditions; 'Completed' indicates successfully executed transactions with all parties satisfied; 'Cancelled' denotes transactions terminated before completion, often requiring refund processing; 'Disputed' represents contested transactions requiring arbitration, indicating potential fraud or service failure.", k.knowledge_type="value_illustration", k.database="cybermarket", k.source_line=4;
MATCH (k:KGNode {id:"knowledge:cybermarket:3"}), (d:KGNode {id:"concept:domain:cybermarket"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

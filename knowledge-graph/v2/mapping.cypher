MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:robot:38"}) SET k.name="Joint Torque Variance (JTV)", k.description="Calculates the variance of joint torques to assess operational stability.", k.raw_definition="For a given robot R, JTV = \\frac{\\sum_{jp \\in \\text{joint_performance} \\mid \\text{jperfdetref = R}} \\sum_{i=1}^6 ((joint_metrics->>'jointi'->>'torque'::float - \\mu_i)^2)}{\\text{|}\\{jp \\in \\text{joint_performance} \\mid \\text{jperfdetref = R}\\}| \\cdot 6}, \\text{where } \\mu_i = \\frac{\\sum_{jp} joint_metrics->>'jointi'->>'torque'::float}{\\text{|}\\{jp\\}|}, \\text{and jointi is joint i's metrics.}", k.knowledge_type="calculation_knowledge", k.database="robot", k.source_line=39;

MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:cybermarket:1"}) SET k.name="cybermarket|markets|sizecluster", k.description="Illustrates the significance of market size classification", k.raw_definition="Size clusters represent market scale and reach: 'Small' markets typically have under 10,000 monthly users and limited vendor presence; 'Medium' markets host 10,000-50,000 monthly users with moderate vendor diversity; 'Large' markets serve 50,000-100,000 users with extensive product catalogs; 'Mega' markets exceed 100,000 monthly users with comprehensive vendor networks and represent the highest-risk monitoring targets.", k.knowledge_type="value_illustration", k.database="cybermarket", k.source_line=2;

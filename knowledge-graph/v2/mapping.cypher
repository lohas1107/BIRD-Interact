MATCH (x:KGNode {id:"assertion:kb:virtual:0"}), (k:KGNode {id:"knowledge:virtual:0"}) MERGE (x)-[:ASSERTS_ABOUT]->(k);
MATCH (x:KGNode {id:"assertion:kb:virtual:0"}), (s:KGNode {id:"source:virtual/virtual_kb.jsonl"}) MERGE (x)-[:SUPPORTED_BY]->(s);
MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:virtual:1"}) SET k.name="fans.tierstep", k.description="Explains the practical significance of fan tier levels", k.raw_definition="Fan tiers (tierstep) start at 1 and increase progressively, representing different loyalty levels and privileges: Tiers 1-3 are 'Entry-level' fans (newly joined), tiers 4-7 represent 'Mid-level' fans (stable supporters), tiers 8-10 are 'High-level fans (long-term loyal followers), and tiers above 10 are 'Core' fans (foundational idol supporters). Any accounts with missing or invalid tier values are classified as 'Undefined' and require administrative review. Each tier level grants new privileges and increases platform visibility.", k.knowledge_type="value_illustration", k.database="virtual", k.source_line=2;
MATCH (k:KGNode {id:"knowledge:virtual:1"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);
MERGE (x:KGNode:Assertion {id: "assertion:kb:virtual:1"}) SET x.assertion_kind="knowledge_definition", x.raw_text="Fan tiers (tierstep) start at 1 and increase progressively, representing different loyalty levels and privileges: Tiers 1-3 are 'Entry-level' fans (newly joined), tiers 4-7 represent 'Mid-level' fans (stable supporters), tiers 8-10 are 'High-level fans (long-term loyal followers), and tiers above 10 are 'Core' fans (foundational idol supporters). Any accounts with missing or invalid tier values are classified as 'Undefined' and require administrative review. Each tier level grants new privileges and increases platform visibility.", x.status="asserted", x.confidence=0.90, x.source_line=2;
MATCH (x:KGNode {id:"assertion:kb:virtual:1"}), (k:KGNode {id:"knowledge:virtual:1"}) MERGE (x)-[:ASSERTS_ABOUT]->(k);
MATCH (x:KGNode {id:"assertion:kb:virtual:1"}), (s:KGNode {id:"source:virtual/virtual_kb.jsonl"}) MERGE (x)-[:SUPPORTED_BY]->(s);
MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:virtual:2"}) SET k.name="virtualidols.kindtag", k.description="Explains technical and performance characteristics of different virtual idol types", k.raw_definition="'2D' represents two-dimensional animated characters, suitable for anime-style performances with limited interactivity; '3D' refers to three-dimensional modeled characters with more natural movements capable of complex performances; 'AI Generated' indicates characters created using AI technology with high uniqueness but requiring consistency monitoring; 'Mixed Reality' describes characters that can interact with real-world elements, requiring the highest technical threshold.", k.knowledge_type="value_illustration", k.database="virtual", k.source_line=3;
MATCH (k:KGNode {id:"knowledge:virtual:2"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

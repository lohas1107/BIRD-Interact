MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:archeology:33"}) SET k.name="Registration Accuracy Ratio (RAR)", k.description="Evaluates registration accuracy relative to scan resolution using propagation of uncertainty principles.", k.raw_definition="RAR = \\frac{ScanResolMm}{LogAccuMm \\times \\sqrt{1 + \\frac{ErrValMm}{LogAccuMm}}}, \\text{ where values > 1 indicate registration accuracy exceeds scan resolution, a desirable outcome for precise spatial analysis.}", k.knowledge_type="calculation_knowledge", k.database="archeology", k.source_line=34;

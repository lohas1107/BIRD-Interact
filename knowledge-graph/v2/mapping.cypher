MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:alien:35"}) SET k.name="Celestial Location Significance Factor (CLSF)", k.description="Calculates significance of signal source location based on astronomical targets of interest.", k.raw_definition="$\\text{CLSF} = (\\text{CelestObj} ? 2 : 1) \\times (\\text{ObjType} == \\text{'Giant'} \\&\\& \\text{ObjMassSol} \\text{ between } 0.8 \\text{ and } 1.2 ? 1.5 : 1) \\times (\\text{ObjMetal} > 0 ? \\text{ObjMetal} + 1 : 0.5)$, where higher values indicate source locations more likely to harbor intelligent life.", k.knowledge_type="calculation_knowledge", k.database="alien", k.source_line=36;

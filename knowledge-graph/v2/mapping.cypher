MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:solar:20"}) SET k.name="PowerRatedW (Panel Rated Power)", k.description="Illustrates the rated power output of solar panels.", k.raw_definition="Measured in watts (W), representing the maximum power output a panel can produce under Standard Test Conditions (STC). Values typically range from 250W for older models to 650W for newer high-efficiency panels.", k.knowledge_type="value_illustration", k.database="solar", k.source_line=20;

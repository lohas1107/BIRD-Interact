MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:virtual:8"}) SET k.name="retentionandinfluence.churnflag", k.description="Explains the judgment basis for churn risk rating", k.raw_definition="'None' indicates extremely low churn risk, with users maintaining high-frequency interaction and recent consumption; 'Low' represents slight churn risk with slightly decreased login frequency; 'Medium' indicates moderate churn risk with significantly decreased interaction and consumption frequency and increased login intervals; 'High' represents severe churn risk with no logins or interactions in the past 14-30 days, requiring immediate intervention.", k.knowledge_type="value_illustration", k.database="virtual", k.source_line=9;
MATCH (k:KGNode {id:"knowledge:virtual:8"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

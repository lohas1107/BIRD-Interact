MERGE (a:KGNode:LogicalAttribute {id: "attribute:virtual:socialcommunity:community_engagement"}) SET a.name="community_engagement", a.database="virtual", a.table="socialcommunity", a.description="{\"column_meaning\": \"JSONB column. Groups metrics related to the fan’s social network and community contributions, including network size, roles, and content creation activities.\", \"fields_meaning\": {\"content_creation\": {\"artsubs\": \"An INT counting art submissions by the fan (e.g., 4).\", \"commcontrib\": \"An enum (CommunityContribution_enum) indicating how much the fan contributes (Low, High, Medium).\", \"contcreatestat\": \"An enum (ContentCreationStatus_enum) capturing the fan’s creation level (Active, Occasional).\", \"contqualrate\": \"A DECIMAL(3,1) rating the overall quality of the fan’s content (e.g., '8.5').\", \"coverperfcnt\": \"An INT number of cover performances (e.g., 1).\", \"ficsubs\": \"An INT counting fan fiction submissions (e.g., 2).\", \"ugcval\": \"An INT measuring user-generated content volume (e.g., 30 posts).\"}, \"group_involvement\": {\"grpmemb\": \"A SMALLINT counting group memberships (e.g., 2).\", \"grprole\": \"An enum (GroupRole_enum) showing the fan's role (Member, Leader, Moderator).\"}, \"network\": {\"fingcount\": \"An INT indicating how many accounts the fan follows (e.g., 250).\", \"follcount\": \"An INT indicating how many followers the fan has (e.g., 300).\", \"friendcon\": \"An INT number of direct friend connections (e.g., 75).\", \"socnetsz\": \"An INT capturing the size of the fan's social network (e.g., 500).\"}}}";

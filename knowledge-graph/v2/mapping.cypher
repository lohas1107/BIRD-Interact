MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:crypto:21"}) SET k.name="orderflow", k.description="Illustrates the meaning of different values for the orderflow enum.", k.raw_definition="An enum with values 'New', 'PartiallyFilled', 'Cancelled', or 'Filled'. 'New' indicates a newly placed order that hasn't been matched. 'PartiallyFilled' means some portion has been executed but not all. 'Cancelled' means the order was cancelled before full execution. 'Filled' means the order has been completely executed.", k.knowledge_type="value_illustration", k.database="crypto", k.source_line=22;

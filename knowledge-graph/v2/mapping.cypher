MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:crypto:36"}) SET k.name="Market Depth Ratio", k.description="Measures the ratio of order book depth to position size to assess market liquidity for position exit.", k.raw_definition="Market Depth Ratio = \\frac{biddepth \\text{ or } askdepth}{dealcount} \\times Liquidity Ratio, \\text{where } biddepth/askdepth \\text{ is used depending on position direction (posedge), } dealcount \\text{ is the order quantity, and } Liquidity Ratio \\text{ measures available liquidity to total market volume.}", k.knowledge_type="calculation_knowledge", k.database="crypto", k.source_line=37;

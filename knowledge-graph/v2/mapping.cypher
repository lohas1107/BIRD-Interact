MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:robot:30"}) SET k.name="Weighted Fault Prediction Score (WFPS)", k.description="Calculates a weighted average fault prediction score, prioritizing recent records.", k.raw_definition="For a given robot R, WFPS = \\frac{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} (faultpredscore \\cdot w(mf))}{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} w(mf)}, \\text{where } w(mf) = 1 / (1 + \\text{upkeepduedays})", k.knowledge_type="calculation_knowledge", k.database="robot", k.source_line=31;

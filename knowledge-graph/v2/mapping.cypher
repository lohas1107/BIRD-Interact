MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:virtual:5"}) SET k.name="engagement.engrate", k.description="Explains the calculation basis and business significance of fan engagement rate", k.raw_definition="Engagement rate (engrate) typically ranges from 0 to 1.000, with higher values indicating more active fans. 0-0.200 represents low engagement (viewing only without participation), 0.201-0.500 indicates moderate engagement (occasional comments and likes), 0.501-0.800 shows high engagement (frequent comments and sharing), and 0.801-1.000 represents ultra-high engagement (comprehensive deep participation in content co-creation). Platforms generally consider rates above 0.500 as quality fans.", k.knowledge_type="value_illustration", k.database="virtual", k.source_line=6;
MATCH (k:KGNode {id:"knowledge:virtual:5"}), (d:KGNode {id:"concept:domain:virtual"}) MERGE (k)-[:VALID_IN_DOMAIN]->(d);

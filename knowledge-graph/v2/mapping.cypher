MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:gaming:31"}) SET k.name="Response Accuracy Index (RAI)", k.description="Measures the accuracy and consistency of input response in gaming devices, accounting for both sensor precision and control stability.", k.raw_definition="RAI = \\left(\\frac{JoyPrec + DpadAcc}{20}\\right) \\times \\left(1 - \\frac{InpLagMs}{10}\\right) \\times 10", k.knowledge_type="calculation_knowledge", k.database="gaming", k.source_line=32;

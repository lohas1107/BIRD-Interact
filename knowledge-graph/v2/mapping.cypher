MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:robot:0"}) SET k.name="Robot Age in Years (RAY)", k.description="Calculates the age of the robot in years based on installation date and record timestamp.", k.raw_definition="For a given robot R, let D be the instdateval from robot_details where botdetreg = R, and T be the rects from robot_record where recreg = R. Then, RAY = \\frac{(T - D).days}{365.25}", k.knowledge_type="calculation_knowledge", k.database="robot", k.source_line=1;

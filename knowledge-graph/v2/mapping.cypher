MERGE (k:KGNode:Knowledge:Concept {id: "knowledge:archeology:21"}) SET k.name="PointDense (Point Density)", k.description="Illustrates the significance of point density in archaeological point clouds for information richness.", k.raw_definition="Measured as points per square meter. Values around 100 capture basic site topography, 1,000 can document structural details, while 10,000+ enables analysis of surface textures and fine engravings across multiple scales of inquiry.", k.knowledge_type="value_illustration", k.database="archeology", k.source_line=22;

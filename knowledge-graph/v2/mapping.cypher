MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:mental:52"}) SET k.name="Therapeutic Alliance & Engagement Score (TAES)", k.description="Computes a combined score reflecting both the average clinician-reported therapeutic alliance and the calculated therapy engagement score for a facility.", k.raw_definition="TAES = \\frac{Average(theralliance\\_score) + TES}{2}, \\text{where } theralliance\\_score = \\begin{cases} 3 & \\text{if } theralliance = Strong \\\\ 2 & \\text{if } theralliance = Moderate \\\\ 1 & \\text{if } theralliance = Weak \\\\ 0 & \\text{if } theralliance = Poor \\end{cases}, \\text{averaged across treatmentoutcomes, combined with Therapy Engagement Score (TES)}.", k.knowledge_type="calculation_knowledge", k.database="mental", k.source_line=53;

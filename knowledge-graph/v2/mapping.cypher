MERGE (k:KGNode:Knowledge:Metric {id: "knowledge:cybermarket:35"}) SET k.name="Market Diversification Score (MDS)", k.description="Evaluates the diversity of products and vendors within a market", k.raw_definition="MDS = \\frac{COUNT(DISTINCT prodsubcat)}{5} + \\frac{vendcount}{50} + \\frac{COUNT(txregistry)}{vendcount} \\times 0.5 - \\frac{mktclass\\_weight}{10}, \\text{where mktclass\\_weight assigns Forum=1, Service=2, Marketplace=4, Exchange=3 as per the market classification system defined in cybermarket|markets|mktclass, and higher scores represent greater market diversification.}", k.knowledge_type="calculation_knowledge", k.database="cybermarket", k.source_line=36;

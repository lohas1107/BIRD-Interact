MERGE (n:Metric {id:'metric:virtual:kb:10'}) SET n += {name: 'Fan Engagement Index (FEI)', description: 'A comprehensive metric measuring fan activity level with platform and virtual idols', raw_definition: 'FEI = (engrate \\times 0.4) + (\\frac{socintscore}{100} \\times 0.3) + (\\frac{actdayswk}{7} \\times 0.2) + (\\frac{avgsesscount}{10} \\times 0.1), \\text{ where weights reflect each factor\'s different contribution to engagement, with results ranging from 0-1. Higher values indicate more engaged fans.}', knowledge_type: 'calculation_knowledge', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 11, source_knowledge_id: 10, mapping_status: 'unresolved', pattern: 'composite_metric'};

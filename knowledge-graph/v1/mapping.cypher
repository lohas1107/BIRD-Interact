MERGE (n:Concept {id:'concept:archeology:kb:21'}) SET n += {name: 'PointDense (Point Density)', description: 'Illustrates the significance of point density in archaeological point clouds for information richness.', raw_definition: 'Measured as points per square meter. Values around 100 capture basic site topography, 1,000 can document structural details, while 10,000+ enables analysis of surface textures and fine engravings across multiple scales of inquiry.', knowledge_type: 'value_illustration', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 22, source_knowledge_id: 21, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

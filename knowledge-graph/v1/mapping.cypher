MERGE (n:Metric {id:'metric:archeology:kb:35'}) SET n += {name: 'Conservation Priority Index (CPI)', description: 'Quantifies the urgency of conservation efforts based on site condition, historical significance and structural stability.', raw_definition: 'CPI = \\begin{cases} 100 - PS + AF \\times \\left(1 + \\frac{TS}{10}\\right), & \\text{if in a Degradation Risk Zone} \\\\ 50 - PS + AF \\times \\left(1 + \\frac{TS}{20}\\right), & \\text{otherwise} \\end{cases}, \\text{ where PS is 0-100 based on PresStat condition (\'Excellent\'=10, \'Good\'=30, \'Fair\'=50, \'Poor\'=70, \'Critical\'=90), AF is approximate age in millennia derived from GuessDate, and TS is 0-10 based on TypeSite rarity.}', knowledge_type: 'calculation_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 36, source_knowledge_id: 35, mapping_status: 'unresolved', pattern: 'composite_metric'};

MERGE (n:Metric {id:'metric:archeology:kb:30'}) SET n += {name: 'Scan Time Efficiency (STE)', description: 'Measures how efficiently scanning time was used relative to data quality and completeness metrics.', raw_definition: 'STE = \\frac{SQS \\times \\sqrt{CoverPct}}{SpanMin \\times \\sqrt{ScanCount}}, \\text{ where SQS is the Scan Quality Score and higher STE values indicate more efficient use of scanning time relative to coverage achieved.}', knowledge_type: 'calculation_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 31, source_knowledge_id: 30, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};

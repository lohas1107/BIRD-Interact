MERGE (n:Metric {id:'metric:cybermarket:kb:34'}) SET n += {name: 'Transaction Velocity Metric (TVM)', description: 'Measures the rapidity and volume of transactions from a single source', raw_definition: 'TVM = \\frac{COUNT(txregistry)}{(MAX(eventstamp) - MIN(eventstamp))} \\times \\frac{payamtusd}{500} \\times (1 + (paymethod\\_weight \\times 0.1)), \\text{where paymethod\\_weight assigns Crypto\\_A=1, Crypto\\_B=3, Crypto\\_C=2, Token=2 based on the payment method classifications defined in cybermarket|transactions|paymethod, and higher values indicate potentially suspicious transaction velocity.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 35, source_knowledge_id: 34, mapping_status: 'unresolved', pattern: 'ratio_metric'};

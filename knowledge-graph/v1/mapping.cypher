MATCH (n:Concept {id:'concept:insider:kb:24'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:insider:kb:24->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:insider:kb:25'}) SET n += {name: 'Marking the Close Patterns', description: 'Explains the patterns associated with influencing the closing price of a security.', raw_definition: '`risk_indicators.markclosepat`: \'Frequent\' indicates repeated trading activity near the market close, potentially intended to manipulate the closing price (e.g., to affect margin calls, NAV calculations, or settlement prices). \'Occasional\' suggests such activity is infrequent or less patterned. Marking the close is a prohibited manipulative practice.', knowledge_type: 'value_illustration', domain: 'insider', source_file: 'insider/insider_kb.jsonl', source_line: 26, source_knowledge_id: 25, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

MATCH (n:Concept {id:'concept:polar:kb:21'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:polar:kb:21->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:polar:kb:22'}) SET n += {name: 'externaltemperaturec', description: 'Illustrates the significance of external temperature readings in polar environments.', raw_definition: 'External temperature in polar regions typically ranges from -70°C to 10°C. Temperatures below -40°C represent extreme cold requiring special equipment protection measures, -20°C to -40°C require standard cold weather protocols, while temperatures above -20°C are considered relatively mild for polar operations but still require normal cold weather precautions.', knowledge_type: 'value_illustration', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 23, source_knowledge_id: 22, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

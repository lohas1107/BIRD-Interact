MERGE (n:Concept {id:'concept:cybermarket:kb:3'}) SET n += {name: 'cybermarket|transactions|txstatus', description: 'Explains the transaction lifecycle stages and their implications', raw_definition: '\'Pending\' represents initiated but incomplete transactions awaiting verification or escrow conditions; \'Completed\' indicates successfully executed transactions with all parties satisfied; \'Cancelled\' denotes transactions terminated before completion, often requiring refund processing; \'Disputed\' represents contested transactions requiring arbitration, indicating potential fraud or service failure.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 4, source_knowledge_id: 3, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

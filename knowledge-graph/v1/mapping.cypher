MERGE (n:Metric {id:'metric:crypto:kb:30'}) SET n += {name: 'Risk-Adjusted Return', description: 'Calculates return on position adjusted for risk exposure.', raw_definition: 'Risk-Adjusted Return = \\frac{realline}{PVaR \\times posriskrate}, \\text{where } realline \\text{ is the realized PnL, } PVaR \\text{ is the Position Value at Risk, and } posriskrate \\text{ is the position risk ratio.}', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 31, source_knowledge_id: 30, mapping_status: 'unresolved', pattern: 'ratio_metric'};

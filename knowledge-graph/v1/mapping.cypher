MERGE (n:Rule {id:'rule:cybermarket:kb:22'}) SET n += {name: 'Suspicious Transaction Pattern', description: 'Identifies transactions with characteristics suggesting potential illegal activity', raw_definition: 'A transaction with TAS > 75, payment in privacy-focused cryptocurrencies (Crypto_B), escrow disabled or minimized (escrowused = \'No\' or escrowhrs < 24), and unusual routing complexity (routecomplexity = \'Complex\'). These transactions often represent high-risk activities requiring further investigation.', knowledge_type: 'domain_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 23, source_knowledge_id: 22, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

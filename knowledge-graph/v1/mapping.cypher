MERGE (n:Concept {id:'concept:archeology:kb:29'}) SET n += {name: 'GuessDate (Estimated Dating)', description: 'Illustrates dating conventions in archaeological classification for chronological placement.', raw_definition: 'Values like \'3500-3000 BCE\', \'1st c. CE\', or \'ca. 1450 CE\' represent estimated chronological placement based on excavation findings. Precision varies from specific years to century-level estimates depending on available evidence and dating methodologies employed.', knowledge_type: 'value_illustration', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 30, source_knowledge_id: 29, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

MERGE (p:Concept {id:'pattern:categorical_value_or_concept'}) SET p.name='Categorical Value Or Concept', p.concept_kind='pattern';
MATCH (n:Concept {id:'concept:insider:kb:21'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:insider:kb:21->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:insider:kb:22'}) SET n += {name: 'Off-Market Trading Activity', description: 'Illustrates types of trading activity occurring outside public exchanges.', raw_definition: '`offmkt`: Describes trades not executed on lit exchanges. \'Internal crosses\' specifically refer to a broker matching buy and sell orders from their own clients internally, without routing them to a public exchange. This can be efficient but requires monitoring to ensure fairness and prevent potential conflicts of interest.', knowledge_type: 'value_illustration', domain: 'insider', source_file: 'insider/insider_kb.jsonl', source_line: 23, source_knowledge_id: 22, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

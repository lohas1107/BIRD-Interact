MERGE (n:Concept {id:'concept:gaming:kb:26'}) SET n += {name: 'ThdPct (Total Harmonic Distortion)', description: 'Illustrates the impact of harmonic distortion measurements on audio quality in gaming headsets.', raw_definition: 'Measured as a percentage, representing audio signal distortion at high volumes. Values below 0.1% indicate audiophile-grade reproduction with imperceptible distortion, 0.1-0.5% represents excellent gaming audio quality, 0.5-1.0% is acceptable for most gaming scenarios, while values above 1.0% may produce noticeable distortion during intense gaming sequences.', knowledge_type: 'value_illustration', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 27, source_knowledge_id: 26, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

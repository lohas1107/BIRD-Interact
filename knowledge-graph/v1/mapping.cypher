MERGE (n:Metric {id:'metric:cybermarket:kb:10'}) SET n += {name: 'Market Risk Score (MRS)', description: 'Calculates overall risk level of a market based on multiple factors', raw_definition: 'MRS = \\frac{dlyflow}{1000} + (esccomprate \\times 0.2) + (interscore \\times 0.3) + (vendcount \\times 0.1) - \\frac{mktspan}{100}, \\text{where higher scores indicate greater risk exposure requiring enhanced monitoring.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 11, source_knowledge_id: 10, mapping_status: 'unresolved', pattern: 'composite_metric'};

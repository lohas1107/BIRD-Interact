MERGE (n:Metric {id:'metric:alien:kb:30'}) SET n += {name: 'Modulation Complexity Score (MCS)', description: 'Quantifies the sophistication of signal modulation based on type and stability.', raw_definition: '$\\text{MCS} = \\text{ModIndex} \\times (1 + \\text{SSM}) \\times M_{\\text{factor}}$, where $M_{\\text{factor}}$ is 2 for $\\text{ModType} = \\text{\'AM\'}$, 1.5 for \'FM\', and 1 for other types. Incorporates Signal Stability Metric (SSM) to weight stable modulations higher.', knowledge_type: 'calculation_knowledge', domain: 'alien', source_file: 'alien/alien_kb.jsonl', source_line: 31, source_knowledge_id: 30, mapping_status: 'exact_identifier', pattern: 'composite_metric'};

MERGE (n:Metric {id:'metric:insider:kb:73'}) SET n += {name: 'Peer Correlation Z-Score', description: 'A normalized score indicating how many standard deviations an individual record\'s peer correlation (\'peercorr\') is away from the average peer correlation of all traders within the same trader kind (\'tradekind\'). Used for standardized comparison across different peer groups.', raw_definition: 'Z = (peercorr - AVG(peercorr) OVER (PARTITION BY tradekind)) / STDDEV_SAMP(peercorr) OVER (PARTITION BY tradekind), with Z=0 if STDDEV_SAMP is 0 or NULL.', knowledge_type: 'calculation_knowledge', domain: 'insider', source_file: 'insider/insider_kb.jsonl', source_line: 74, source_knowledge_id: 73, mapping_status: 'unresolved', pattern: 'composite_metric'};

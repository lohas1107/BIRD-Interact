MERGE (n:Metric {id:'metric:archeology:kb:33'}) SET n += {name: 'Registration Accuracy Ratio (RAR)', description: 'Evaluates registration accuracy relative to scan resolution using propagation of uncertainty principles.', raw_definition: 'RAR = \\frac{ScanResolMm}{LogAccuMm \\times \\sqrt{1 + \\frac{ErrValMm}{LogAccuMm}}}, \\text{ where values > 1 indicate registration accuracy exceeds scan resolution, a desirable outcome for precise spatial analysis.}', knowledge_type: 'calculation_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 34, source_knowledge_id: 33, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};

MERGE (n:Concept {id:'concept:solar:kb:27'}) SET n += {name: 'CumDegPct (Cumulative Degradation Percentage)', description: 'Illustrates the total performance loss over a panel\'s lifetime.', raw_definition: 'Expressed as a percentage, representing total performance degradation since installation. New panels start at 0%, while panels approaching end-of-life may have values of 15-20% or higher, with manufacturer warranties typically covering degradation up to 20% over 25 years.', knowledge_type: 'value_illustration', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 27, source_knowledge_id: 27, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

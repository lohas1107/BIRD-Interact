MERGE (n:Metric {id:'metric:polar:kb:5'}) SET n += {name: 'Vehicle Performance Coefficient (VPC)', description: 'A metric that evaluates vehicle performance based on mechanical condition and operational efficiency.', raw_definition: 'VPC = (1 - \\frac{brakepadwearpercent + trackwearpercent}{200}) \\times \\frac{vehiclespeedkmh}{50} \\times \\frac{engineloadpercent}{100}, \\text{ where lower wear percentages and optimal engine load contribute to better performance.}', knowledge_type: 'calculation_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 6, source_knowledge_id: 5, mapping_status: 'unresolved', pattern: 'ratio_metric'};

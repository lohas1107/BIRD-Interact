MERGE (n:Rule {id:'rule:gaming:kb:47'}) SET n += {name: 'Ultra-Durable Tournament Device', description: 'Defines devices with exceptional physical durability designed to withstand the rigors of frequent tournament travel and intensive competition use.', raw_definition: 'A device with PER > 9.0, DS > 8.5, UsbConnDur > 20000, and at least one premium durability feature (DropHtM > 2.0 or WaterRes containing \'IPX7\' or higher), engineered to maintain performance integrity despite frequent transportation, setup/teardown cycles, and competition intensity.', knowledge_type: 'domain_knowledge', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 48, source_knowledge_id: 47, mapping_status: 'exact_identifier', pattern: 'threshold_or_classification'};

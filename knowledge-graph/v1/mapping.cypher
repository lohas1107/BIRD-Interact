MATCH (n:Metric {id:'metric:solar:kb:33'}), (a:LogicalAttribute {id:'attribute:solar:panel:paneeffpct'}) MERGE (n)-[:USES_ATTRIBUTE {id:'metric:solar:kb:33->attribute:solar:panel:paneeffpct'}]->(a);
MATCH (m:Metric {id:'metric:solar:kb:33'}), (e:LogicalEntity {id:'entity:solar:panel'}) MERGE (m)-[:APPLIES_TO {id:'metric:solar:kb:33->entity:solar:panel'}]->(e);
MERGE (n:Metric {id:'metric:solar:kb:34'}) SET n += {name: 'Normalized Degradation Index (NDI)', description: 'Compares panel degradation to expected rates based on panel type and age.', raw_definition: 'NDI = PELR / AnnDegRate, where PELR is the Panel Efficiency Loss Rate and AnnDegRate is from efficiency_profile.degradation.anndegrate. Values above 1.0 indicate faster than expected degradation.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 34, source_knowledge_id: 34, mapping_status: 'unresolved', pattern: 'composite_metric'};
MATCH (n:Metric {id:'metric:solar:kb:34'}), (d:Concept {id:'domain:solar'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:solar:kb:34->domain:solar'}]->(d);

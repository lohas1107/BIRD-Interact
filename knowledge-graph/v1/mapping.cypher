MERGE (n:Rule {id:'rule:polar:kb:47'}) SET n += {name: 'Long-term Scientific Mission Viability (LSMV)', description: 'Assesses the viability of long-term scientific missions under polar conditions', raw_definition: 'Scientific missions are assessed as \'long-term viable\' when all involved scientific equipment maintains SMSP > 0.8 and overall site operations maintain CORI > 0.75, with calibrationstatus = \'Valid\' and dataloggingstatus = \'Active\'.', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 48, source_knowledge_id: 47, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

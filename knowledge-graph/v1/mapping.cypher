MATCH (n:Metric {id:'metric:solar:kb:37'}), (a:LogicalAttribute {id:'attribute:solar:inverter:pwrqualidx'}) MERGE (n)-[:USES_ATTRIBUTE {id:'metric:solar:kb:37->attribute:solar:inverter:pwrqualidx'}]->(a);

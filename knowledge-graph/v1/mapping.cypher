MERGE (n:Concept {id:'concept:solar:kb:28'}) SET n += {name: 'POAIrradianceWM2 (Plane-of-Array Irradiance)', description: 'Illustrates the solar energy available to panels in their installed orientation.', raw_definition: 'Measured in watts per square meter (W/m²), representing the solar energy reaching the panel surface. Typical daytime values range from 200 W/m² on heavily overcast days to 1000+ W/m² under clear sky conditions at solar noon.', knowledge_type: 'value_illustration', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 28, source_knowledge_id: 28, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

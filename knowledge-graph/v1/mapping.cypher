MERGE (n:Metric {id:'metric:solar:kb:36'}) SET n += {name: 'Expected Energy Yield (EEY)', description: 'Calculates the expected energy production considering current conditions.', raw_definition: 'EEY = PowerRatedW × EPE × SIF × POAIrradianceWM2 / 1000, where EPE is the Energy Production Efficiency and SIF is the Soiling Impact Factor.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 36, source_knowledge_id: 36, mapping_status: 'unresolved', pattern: 'ratio_metric'};
MATCH (n:Metric {id:'metric:solar:kb:36'}), (d:Concept {id:'domain:solar'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:solar:kb:36->domain:solar'}]->(d);

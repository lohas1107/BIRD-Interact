MERGE (n:Concept {id:'concept:museum:kb:27'}) SET n += {name: 'EnvironmentalReadingsCore.TempC', description: 'Illustrates temperature readings and their conservation implications.', raw_definition: 'Values typically range from 15-25°C, with 18-22°C being ideal for most collections. Fluctuations greater than 2°C within 24 hours can stress materials. Values outside 10-30°C indicate environmental control failure requiring immediate attention.', knowledge_type: 'value_illustration', domain: 'museum', source_file: 'museum/museum_kb.jsonl', source_line: 28, source_knowledge_id: 27, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

MERGE (n:Concept {id:'concept:solar:kb:29'}) SET n += {name: 'InvertEffPct (Inverter Efficiency Percentage)', description: 'Illustrates the efficiency of inverters in converting DC to AC power.', raw_definition: 'Expressed as a percentage, representing how much DC power from panels is successfully converted to AC power. Modern string inverters typically operate at 96-98% efficiency, while microinverters may range from 94-97% efficiency.', knowledge_type: 'value_illustration', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 29, source_knowledge_id: 29, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

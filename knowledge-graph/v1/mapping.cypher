MERGE (n:Metric {id:'metric:cybermarket:kb:39'}) SET n += {name: 'Money Flow Complexity (MFC)', description: 'Quantifies the complexity of money flows in transaction chains', raw_definition: 'MFC = (txchainlen \\times 5) + (linkedtxcount \\times 3) + (moneyrisk_numeric \\times 15) + (TCR \\times 0.2) - (profilecomplete \\times 10), \\text{where moneyrisk_numeric maps Low=1, Medium=2, High=3, Unknown=2 according to the money laundering risk classification, and higher scores indicate more complex money flows.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 40, source_knowledge_id: 39, mapping_status: 'unresolved', pattern: 'metric'};

MERGE (n:Rule {id:'rule:polar:kb:15'}) SET n += {name: 'Vehicle Operational Safety Threshold', description: 'Defines the safety threshold for vehicle operations based on multiple safety factors.', raw_definition: 'A vehicle is considered \'Safe for Operation\' when it maintains a VPC > 0.6, has brake fluid levels above 50%, brake pad wear below 70%, adequate tire pressure (tiremetrics.pressure_kpa > 200), and is operated within recommended load limits (vehicleloadkg within manufacturer specifications).', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 16, source_knowledge_id: 15, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

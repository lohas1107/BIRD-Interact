MERGE (n:Concept {id:'concept:cybermarket:kb:6'}) SET n += {name: 'cybermarket|communication|langpattern', description: 'Explains the significance of language pattern classification', raw_definition: '\'Consistent\' indicates uniform linguistic patterns suggesting single-user accounts with established communication habits; \'Variable\' indicates significant linguistic variations that may signal multiple users sharing an account or automated translation tools; \'Suspicious\' denotes deliberate attempts to mask writing style through syntax switching or unnatural language patterns often associated with deception attempts.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 7, source_knowledge_id: 6, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

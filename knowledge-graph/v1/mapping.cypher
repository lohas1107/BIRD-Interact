MERGE (n:Metric {id:'metric:solar:kb:37'}) SET n += {name: 'Grid Integration Quality (GIQ)', description: 'Measures the overall quality of power delivered to the grid.', raw_definition: 'GIQ = PWRQualIDX × (1 - power_metrics.harmdistpct/100) × power_metrics.invertpowfac, using PWRQualIDX from the inverter table.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 37, source_knowledge_id: 37, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};

MERGE (n:Metric {id:'metric:robot:kb:32'}) SET n += {name: 'Joint Degradation Index (JDI)', description: 'Computes a composite index of joint health based on temperature and vibration.', raw_definition: 'For a given robot R, JDI = \\frac{\\sum_{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}} \\sum_{i=1}^6 (jitempval_i / \\text{MJT} + jivibval_i)}{\\text{|}\\{jc \\in \\text{joint_condition} \\mid \\text{jcdetref = R}\\}| \\cdot 6}, \\text{where MJT normalizes temperatures, and jitempval_i, jivibval_i are joint i\'s temperature and vibration.}', knowledge_type: 'calculation_knowledge', domain: 'robot', source_file: 'robot/robot_kb.jsonl', source_line: 33, source_knowledge_id: 32, mapping_status: 'unresolved', pattern: 'composite_metric'};

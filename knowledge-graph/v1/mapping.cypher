MERGE (n:Rule {id:'rule:cybermarket:kb:41'}) SET n += {name: 'Market Kingpin', description: 'Identifies vendors with exceptional influence and reach across multiple markets', raw_definition: 'A vendor with VNC > 85, operating on at least 3 different markets (COUNT(DISTINCT mktref) >= 3), with \'Premium\' verification level (vendchecklvl = \'Premium\'), and displaying the characteristics of a Trusted Vendor. These operators represent significant intelligence targets due to their wide-reaching influence.', knowledge_type: 'domain_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 42, source_knowledge_id: 41, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

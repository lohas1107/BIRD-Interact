MERGE (n:Rule {id:'rule:polar:kb:51'}) SET n += {name: 'Life Support Reliability Classification (LSRC)', description: 'Categorizes life support systems into reliability classes based on their LSSR score for operational decision-making.', raw_definition: 'Life support systems are classified into three reliability categories: \'High Reliability\' WHEN (LSSR >= 0.8), \'Moderate Reliability\' WHEN (LSSR >= 0.6 AND LSSR < 0.8), and \'Low Reliability\' WHEN (LSSR < 0.6).', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 52, source_knowledge_id: 51, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

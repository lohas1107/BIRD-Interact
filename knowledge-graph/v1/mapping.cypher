MERGE (n:Metric {id:'metric:credit:kb:6'}) SET n += {name: 'Financial Stability Index (FSI)', description: 'Measures a customer\'s overall financial stability combining income, savings, and debt factors.', raw_definition: 'FSI = 0.3 × (1 - debincratio) + 0.3 × \\frac{liqassets}{mthincome × 6} + 0.2 × \\frac{bankaccbal}{mthincome × 3} + 0.2 × \\frac{savamount}{mthincome × 12}, \\text{where each component is capped at 1.0}', knowledge_type: 'calculation_knowledge', domain: 'credit', source_file: 'credit/credit_kb.jsonl', source_line: 7, source_knowledge_id: 6, mapping_status: 'unresolved', pattern: 'composite_metric'};

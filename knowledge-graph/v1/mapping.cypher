MERGE (n:Metric {id:'metric:museum:kb:35'}) SET n += {name: 'Exhibition Safety Quotient (ESQ)', description: 'Comprehensive safety rating for an exhibition based on artifacts, showcases, and visitor factors.', raw_definition: 'ESQ = ((10 - AVS) + AEC + (10 - VIR)) ÷ 3, where AVS is the Artifact Vulnerability Score, AEC is the Artifact Exhibition Compatibility, and VIR is the Visitor Impact Risk. Higher values indicate safer exhibitions.', knowledge_type: 'calculation_knowledge', domain: 'museum', source_file: 'museum/museum_kb.jsonl', source_line: 36, source_knowledge_id: 35, mapping_status: 'unresolved', pattern: 'metric'};

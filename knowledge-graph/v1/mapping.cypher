MERGE (n:Rule {id:'rule:cybermarket:kb:46'}) SET n += {name: 'OpSec Specialist', description: 'Identifies entities employing exceptionally sophisticated operational security', raw_definition: 'An entity with OSI > 85, demonstrating Sophisticated Operational Security characteristics, with exceptionally high APL scores (APL > 120), and using either \'Enhanced\' or \'Custom\' encryption methods (encryptmethod IN (\'Enhanced\', \'Custom\')). These entities represent high-value intelligence targets requiring specialized investigation techniques.', knowledge_type: 'domain_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 47, source_knowledge_id: 46, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

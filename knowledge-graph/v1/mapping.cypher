MERGE (n:Metric {id:'metric:cybermarket:kb:36'}) SET n += {name: 'Operational Security Index (OSI)', description: 'Quantifies an entity\'s operational security practices', raw_definition: 'OSI = (APL \\times 0.5) + (SPS \\times 0.2) + (tornodecount \\times 2) + (CASE WHEN encryptmethod = \'Standard\' THEN 1 WHEN encryptmethod = \'Enhanced\' THEN 2 WHEN encryptmethod = \'Custom\' THEN 3 ELSE 0 END \\times 5) - (iptally \\times 0.5), \\text{where APL and SPS are defined by the Anonymity Protection Level and Security Posture Score respectively, and higher scores indicate stronger operational security.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 37, source_knowledge_id: 36, mapping_status: 'unresolved', pattern: 'composite_metric'};
MATCH (n:Metric {id:'metric:cybermarket:kb:36'}), (d:Concept {id:'domain:cybermarket'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:cybermarket:kb:36->domain:cybermarket'}]->(d);

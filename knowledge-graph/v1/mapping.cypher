MERGE (n:Concept {id:'concept:crypto:kb:23'}) SET n += {name: 'posedge', description: 'Illustrates the meaning of different values for the posedge enum.', raw_definition: 'An enum with values \'Long\' or \'Short\'. \'Long\' indicates a position that profits from price increases of the underlying asset. \'Short\' indicates a position that profits from price decreases of the underlying asset.', knowledge_type: 'value_illustration', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 24, source_knowledge_id: 23, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

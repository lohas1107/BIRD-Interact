MERGE (n:Metric {id:'metric:robot:kb:35'}) SET n += {name: 'Maintenance Cost Trend (MCT)', description: 'Estimates the trend in maintenance costs over time.', raw_definition: 'For a given robot R, MCT = \\frac{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} \\text{upkeepcostest} \\cdot w(mf)}{\\text{|}\\{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}\\}|}, \\text{where } w(mf) = \\frac{1}{1 + \\text{upkeepduedays}}', knowledge_type: 'calculation_knowledge', domain: 'robot', source_file: 'robot/robot_kb.jsonl', source_line: 36, source_knowledge_id: 35, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};
MATCH (n:Metric {id:'metric:robot:kb:35'}), (d:Concept {id:'domain:robot'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:robot:kb:35->domain:robot'}]->(d);

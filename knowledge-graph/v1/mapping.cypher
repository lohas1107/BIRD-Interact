MERGE (n:Metric {id:'metric:cybermarket:kb:35'}) SET n += {name: 'Market Diversification Score (MDS)', description: 'Evaluates the diversity of products and vendors within a market', raw_definition: 'MDS = \\frac{COUNT(DISTINCT prodsubcat)}{5} + \\frac{vendcount}{50} + \\frac{COUNT(txregistry)}{vendcount} \\times 0.5 - \\frac{mktclass\\_weight}{10}, \\text{where mktclass\\_weight assigns Forum=1, Service=2, Marketplace=4, Exchange=3 as per the market classification system defined in cybermarket|markets|mktclass, and higher scores represent greater market diversification.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 36, source_knowledge_id: 35, mapping_status: 'unresolved', pattern: 'composite_metric'};

MERGE (n:Concept {id:'concept:virtual:kb:0'}) SET n += {name: 'fans.statustag', description: 'Explains the meaning of fan account status and its impact on platform interactions', raw_definition: 'Fan status typically falls into four categories: \'Active\' indicates normal users with full access to all features; \'VIP\' represents premium users with privileged services; \'Inactive\' refers to dormant accounts with no login for over 30 days, with some features restricted; \'Blocked\' means accounts temporarily or permanently banned due to violations, with no access to platform features.', knowledge_type: 'value_illustration', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 1, source_knowledge_id: 0, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

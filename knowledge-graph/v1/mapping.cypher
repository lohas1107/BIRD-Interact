MERGE (n:Metric {id:'metric:archeology:kb:6'}) SET n += {name: 'Model Fidelity Score (MFS)', description: 'Combines mesh complexity, texture quality, and geometric accuracy to assess overall 3D model fidelity for archaeological analysis.', raw_definition: 'MFS = MCR \\times \\left(\\frac{TDI}{10}\\right) \\times \\left(1 + \\exp\\left(-GeomDeltaMm\\right)\\right), \\text{ where higher values indicate more accurate and detailed models with appropriate complexity.}', knowledge_type: 'calculation_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 7, source_knowledge_id: 6, mapping_status: 'exact_identifier', pattern: 'composite_metric'};

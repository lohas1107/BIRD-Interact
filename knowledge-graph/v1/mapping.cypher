MERGE (n:Rule {id:'rule:crypto:kb:50'}) SET n += {name: 'Flow Dominance', description: 'Categorizes market flow based on which group (smart money, retail, or institutional) has the highest trading volume.', raw_definition: 'Categorized as \'Smart Money Dominant\' when smartforce > retail_flow * 1.2 AND smartforce > inst_flow * 1.2; \'Retail Dominant\' when retail_flow > smartforce * 1.2 AND retail_flow > inst_flow * 1.2; \'Institutional Dominant\' when inst_flow > smartforce * 1.2 AND inst_flow > retail_flow * 1.2; otherwise \'Mixed\'.', knowledge_type: 'domain_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 51, source_knowledge_id: 50, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

MERGE (n:Rule {id:'rule:polar:kb:48'}) SET n += {name: 'Polar Base Energy Security Status (PBESS)', description: 'Determines the security status of energy supply for polar bases', raw_definition: 'A polar base is assessed as being in an \'energy secure\' state when it maintains REC > 65%, ESI > 0.7, and RSSI > 0.75, with batterystatus.level_percent > 75 and hydrogenlevelpercent > 70.', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 49, source_knowledge_id: 48, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

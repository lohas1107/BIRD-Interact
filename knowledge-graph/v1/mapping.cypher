MERGE (n:Concept {id:'concept:archeology:kb:22'}) SET n += {name: 'NoiseDb (Noise Level)', description: 'Illustrates the impact of noise levels in point cloud data on feature recognition accuracy.', raw_definition: 'Measured in decibels, representing signal-to-noise ratio in scan data. Values below 1.0 indicate clean data suitable for detailed analysis, while values above 3.0 suggest significant noise that may obscure small features and introduce measurement uncertainty.', knowledge_type: 'value_illustration', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 23, source_knowledge_id: 22, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

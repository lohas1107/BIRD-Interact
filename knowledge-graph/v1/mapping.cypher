MERGE (n:Concept {id:'concept:alien:kb:28'}) SET n += {name: 'EncodeType: Frequency Hopping', description: 'Illustrates a sophisticated encoding method used in telecommunications.', raw_definition: 'Describes a transmission technique where the signal rapidly switches frequencies according to a predetermined sequence. Detection would be characterized by discontinuous spectral features that follow a pattern. This technique is used on Earth to secure communications and reduce interference.', knowledge_type: 'value_illustration', domain: 'alien', source_file: 'alien/alien_kb.jsonl', source_line: 29, source_knowledge_id: 28, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

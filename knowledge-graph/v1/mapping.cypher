MATCH (n:Concept {id:'concept:solar:kb:20'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:solar:kb:20->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:solar:kb:21'}) SET n += {name: 'PaneEffPct (Panel Efficiency Percentage)', description: 'Illustrates the efficiency of solar panels in converting sunlight to electricity.', raw_definition: 'Expressed as a percentage, representing how much of the sun\'s energy hitting the panel is converted to electricity. Modern panels typically range from 15% to 23%, with premium models reaching up to 25%.', knowledge_type: 'value_illustration', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 21, source_knowledge_id: 21, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

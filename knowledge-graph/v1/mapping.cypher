MERGE (n:Metric {id:'metric:archeology:kb:36'}) SET n += {name: 'Mesh-to-Point Ratio (MPR)', description: 'Evaluates the efficiency of mesh generation from point cloud data for optimal decimation determination.', raw_definition: 'MPR = \\frac{FacetVerts}{TotalPts} \\times 100 \\times \\left(\\frac{MCR}{10}\\right)^{0.3}, \\text{ where MCR is the Mesh Complexity Ratio and values around 25-30 indicate optimal decimation for archaeological purposes with appropriate feature preservation.}', knowledge_type: 'calculation_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 37, source_knowledge_id: 36, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};

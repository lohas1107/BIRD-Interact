MATCH (n:Concept {id:'concept:solar:kb:22'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:solar:kb:22->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:solar:kb:23'}) SET n += {name: 'CellTempC (Cell Temperature)', description: 'Illustrates the operating temperature of solar cells.', raw_definition: 'Measured in degrees Celsius, representing the actual temperature of the solar cells during operation. Typically ranges from 40°C to 70°C depending on ambient conditions and panel design, with temperatures above 80°C potentially causing accelerated degradation.', knowledge_type: 'value_illustration', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 23, source_knowledge_id: 23, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

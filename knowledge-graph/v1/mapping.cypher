MERGE (n:Metric {id:'metric:cybermarket:kb:14'}) SET n += {name: 'Wallet Risk Index (WRI)', description: 'Assesses the risk level of cryptocurrency wallets', raw_definition: 'WRI = (fraudprob \\times 100) + (wallrisksc \\times 0.5) - \\frac{wallage}{30} + (wallturnrt \\times 10) + \\frac{txvel}{10}, \\text{where higher scores indicate potentially suspicious wallet activity.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 15, source_knowledge_id: 14, mapping_status: 'unresolved', pattern: 'composite_metric'};

MERGE (n:Concept {id:'concept:cybermarket:kb:1'}) SET n += {name: 'cybermarket|markets|sizecluster', description: 'Illustrates the significance of market size classification', raw_definition: 'Size clusters represent market scale and reach: \'Small\' markets typically have under 10,000 monthly users and limited vendor presence; \'Medium\' markets host 10,000-50,000 monthly users with moderate vendor diversity; \'Large\' markets serve 50,000-100,000 users with extensive product catalogs; \'Mega\' markets exceed 100,000 monthly users with comprehensive vendor networks and represent the highest-risk monitoring targets.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 2, source_knowledge_id: 1, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

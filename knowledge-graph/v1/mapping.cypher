MERGE (n:Metric {id:'metric:cybermarket:kb:15'}) SET n += {name: 'Market Stability Index (MSI)', description: 'Measures the operational stability of a market', raw_definition: 'MSI = \\frac{mktspan}{365} \\times \\frac{esccomprate}{100} \\times \\left(1 - \\frac{\\sum venddisputecount}{\\sum vendtxcount} \\right) \\times 100, \\text{where higher scores indicate more stable markets less likely to disappear suddenly.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 16, source_knowledge_id: 15, mapping_status: 'unresolved', pattern: 'composite_metric'};

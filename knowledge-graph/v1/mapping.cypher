MERGE (n:Metric {id:'metric:solar:kb:33'}) SET n += {name: 'Effective Performance Index (EPI)', description: 'Comprehensive metric that accounts for all factors affecting panel performance.', raw_definition: 'EPI = PPR × (1 - TSL/PowerRatedW) × (IUR/PaneEffPct), where PPR is the Panel Performance Ratio, TSL is the Total System Loss, and IUR is the Irradiance Utilization Ratio.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 33, source_knowledge_id: 33, mapping_status: 'exact_identifier', pattern: 'composite_metric'};

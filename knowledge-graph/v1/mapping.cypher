MERGE (n:Rule {id:'rule:polar:kb:17'}) SET n += {name: 'Cabin Habitability Standard', description: 'Defines the minimum standards for habitable cabin conditions in polar environments.', raw_definition: 'A cabin meets \'Habitability Standards\' when it maintains internal temperature (cabinclimate.temperature_c) between 18-24°C, oxygen levels (cabinclimate.o2_percent) above 19.5%, CO2 levels (cabinclimate.co2_ppm) below 1000 ppm, functioning ventilation systems, and operational heating systems.', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 18, source_knowledge_id: 17, mapping_status: 'unresolved', pattern: 'opaque_rule'};

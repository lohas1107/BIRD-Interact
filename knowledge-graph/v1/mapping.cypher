MATCH (n:Concept {id:'concept:gaming:kb:21'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:gaming:kb:21->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:gaming:kb:22'}) SET n += {name: 'DpiRes (DPI Resolution)', description: 'Illustrates the impact of DPI resolution settings on mouse sensitivity and precision.', raw_definition: 'Measured in dots per inch, representing sensor tracking precision. Values around 800-1600 are typically used by professional FPS players for precision, while 12000+ allows for extremely fast cursor movement with minimal physical motion, beneficial for MOBAs and strategy games that require covering large screen areas quickly.', knowledge_type: 'value_illustration', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 23, source_knowledge_id: 22, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

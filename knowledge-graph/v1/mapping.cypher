MERGE (n:Concept {id:'concept:cybermarket:kb:2'}) SET n += {name: 'cybermarket|transactions|paymethod', description: 'Explains the significance of different payment methods', raw_definition: 'Payment methods represent varying degrees of anonymity and traceability: \'Crypto_A\' typically refers to Bitcoin, offering pseudonymous transactions with public ledgers; \'Crypto_B\' often indicates Monero or similar privacy coins with enhanced transaction obfuscation; \'Crypto_C\' represents emerging or niche cryptocurrencies; \'Token\' indicates platform-specific value exchange systems that operate outside traditional blockchain networks.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 3, source_knowledge_id: 2, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

MATCH (n:Metric {id:'metric:cybermarket:kb:32'}), (p:Concept {id:'pattern:ratio_metric'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'metric:cybermarket:kb:32->pattern:ratio_metric'}]->(p);
MERGE (n:Metric {id:'metric:cybermarket:kb:33'}) SET n += {name: 'Communication Pattern Risk (CPR)', description: 'Evaluates how suspicious a communication pattern is based on multiple factors', raw_definition: 'CPR = (langpattern_numeric \\times 15) + (CSR \\times 0.2) + (msgtally \\times 0.5) - (1 - vpnflag_numeric) \\times 20, \\text{where langpattern_numeric maps Consistent=1, Variable=2, Suspicious=3 as explained in the language pattern classification, and higher scores represent more suspicious communication behavior.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 34, source_knowledge_id: 33, mapping_status: 'unresolved', pattern: 'metric'};
MATCH (n:Metric {id:'metric:cybermarket:kb:33'}), (d:Concept {id:'domain:cybermarket'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:cybermarket:kb:33->domain:cybermarket'}]->(d);

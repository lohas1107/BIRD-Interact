MERGE (n:Rule {id:'rule:cybermarket:kb:20'}) SET n += {name: 'High-Risk Market', description: 'Identifies markets with significant operational risk factors', raw_definition: 'A market with MRS > 500, having more than 100 vendors, a daily flow exceeding 5000 transactions, and at least one \'High\' security alert. These markets typically have the highest potential for illicit activity and represent priority monitoring targets for investigators.', knowledge_type: 'domain_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 21, source_knowledge_id: 20, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

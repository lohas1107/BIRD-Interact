MERGE (n:Metric {id:'metric:polar:kb:2'}) SET n += {name: 'Energy Sustainability Index (ESI)', description: 'Measures the sustainability of an equipment\'s energy usage by evaluating energy efficiency and renewable sources.', raw_definition: 'ESI = energyefficiencypercent \\times \\begin{cases} 1.5 & \\text{if powersource IN (\'Solar\', \'Wind\')} \\\\ 1.2 & \\text{if powersource = \'Hybrid\'} \\\\ 1.0 & \\text{if powersource = \'Battery\'} \\\\ 0.7 & \\text{if powersource = \'Diesel\'} \\\\ 0 & \\text{otherwise} \\end{cases}, \\text{ providing higher ratings for renewable energy and lower ratings for fossil fuels.}', knowledge_type: 'calculation_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 3, source_knowledge_id: 2, mapping_status: 'unresolved', pattern: 'composite_metric'};

MERGE (n:Rule {id:'rule:polar:kb:12'}) SET n += {name: 'Maintenance Priority Level', description: 'Classifies equipment based on the urgency of required maintenance.', raw_definition: 'Equipment is categorized into maintenance priority levels: \'Immediate Attention\' (operationhours > maintenancecyclehours OR operationalstatus = \'Repair\'), \'Scheduled Service\' (operationhours > 0.8 * maintenancecyclehours), and \'Routine Maintenance\' (all other cases), helping prioritize resource allocation.', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 13, source_knowledge_id: 12, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

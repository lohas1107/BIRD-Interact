MERGE (n:Rule {id:'rule:cybermarket:kb:23'}) SET n += {name: 'Money Laundering Indicator', description: 'Identifies transaction patterns consistent with money laundering', raw_definition: 'A transaction chain with TCR > 150, involving wallets less than 30 days old (wallage < 30), high turnover rates (wallturnrt > 5), and at least 3 linked transactions (linkedtxcount >= 3). These patterns often indicate attempts to obscure the source or destination of funds.', knowledge_type: 'domain_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 24, source_knowledge_id: 23, mapping_status: 'unresolved', pattern: 'temporal_rule'};

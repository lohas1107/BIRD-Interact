MERGE (n:Metric {id:'metric:solar:kb:38'}) SET n += {name: 'Electrical Degradation Index (EDI)', description: 'Measures the combined degradation of electrical parameters.', raw_definition: 'EDI = (FillFactorInitial - FillFactorCurrent)/FillFactorInitial + (VocInitialV - VocCurrV)/VocInitialV + (IscInitialA - IscCurrA)/IscInitialA, where higher values indicate more severe degradation.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 38, source_knowledge_id: 38, mapping_status: 'exact_identifier', pattern: 'composite_metric'};

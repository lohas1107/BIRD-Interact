MERGE (n:Concept {id:'concept:solar:kb:20'}) SET n += {name: 'PowerRatedW (Panel Rated Power)', description: 'Illustrates the rated power output of solar panels.', raw_definition: 'Measured in watts (W), representing the maximum power output a panel can produce under Standard Test Conditions (STC). Values typically range from 250W for older models to 650W for newer high-efficiency panels.', knowledge_type: 'value_illustration', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 20, source_knowledge_id: 20, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

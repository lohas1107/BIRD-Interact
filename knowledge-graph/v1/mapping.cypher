MERGE (n:Metric {id:'metric:gaming:kb:33'}) SET n += {name: 'Immersion Enhancement Coefficient (IEC)', description: 'Quantifies how well a device contributes to gaming immersion through audio quality, haptic feedback, and visual elements.', raw_definition: 'IEC = \\left(AQI \\times 0.5\\right) + \\left(HFQ \\times 0.3\\right) + \\left(RIQ \\times 0.2\\right)', knowledge_type: 'calculation_knowledge', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 34, source_knowledge_id: 33, mapping_status: 'unresolved', pattern: 'metric'};

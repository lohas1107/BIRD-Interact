MERGE (n:Metric {id:'metric:cybermarket:kb:38'}) SET n += {name: 'Cross-Platform Risk Amplification (CPRA)', description: 'Measures how risk increases when an entity operates across multiple platforms', raw_definition: 'CPRA = (keymatchcount \\times 3) + (COUNT(DISTINCT mktref) \\times 10) + (WRI \\times 0.2) + (\\frac{mktspan}{365} \\times 5) - (\\frac{compliancescore}{20}), \\text{where WRI is defined by the Wallet Risk Index, platformcount is the count of distinct markets an entity operates on, and higher values indicate greater cross-platform risk.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 39, source_knowledge_id: 38, mapping_status: 'unresolved', pattern: 'ratio_metric'};

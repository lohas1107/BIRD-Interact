MERGE (n:Concept {id:'concept:cybermarket:kb:0'}) SET n += {name: 'cybermarket|markets|mktclass', description: 'Explains the market classification system and its business implications', raw_definition: 'Market classes define the primary business model: \'Forum\' platforms focus on information exchange and community interactions with minimal direct transactions; \'Service\' markets specialize in offering digital services rather than goods; \'Marketplace\' denotes traditional product-focused platforms with diverse inventory; \'Exchange\' indicates financial transaction services predominantly featuring cryptocurrency trading.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 1, source_knowledge_id: 0, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

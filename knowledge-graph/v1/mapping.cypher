MERGE (n:Concept {id:'concept:polar:kb:27'}) SET n += {name: 'energyefficiencypercent', description: 'Illustrates the meaning and importance of energy efficiency percentages.', raw_definition: 'Energy efficiency percentage typically ranges from 10% to 99%. Values below 30% indicate inefficient systems typical of older equipment, 30-60% represent standard efficiency for conventional equipment, 60-80% indicate high-efficiency modern systems, while values above 80% represent cutting-edge technology with optimal efficiency that minimizes energy waste and operational costs.', knowledge_type: 'value_illustration', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 28, source_knowledge_id: 27, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

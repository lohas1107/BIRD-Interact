MERGE (n:Metric {id:'metric:crypto:kb:35'}) SET n += {name: 'Arbitrage ROI', description: 'Calculates the potential return on investment for an arbitrage opportunity.', raw_definition: 'Arbitrage ROI = \\frac{AOS \\times dealquote}{feetotal \\times 2}, \\text{where } AOS \\text{ is the Arbitrage Opportunity Score and } feetotal \\text{ is multiplied by 2 to account for fees on both transactions involved in arbitrage.}', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 36, source_knowledge_id: 35, mapping_status: 'unresolved', pattern: 'ratio_metric'};

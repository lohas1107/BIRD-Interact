MERGE (n:Rule {id:'rule:polar:kb:49'}) SET n += {name: 'Comprehensive Environmental Adaptability Rating (CEAR)', description: 'Assesses the overall adaptability of equipment and systems to the polar environment', raw_definition: 'Equipment and systems are rated as having \'Excellent Adaptability\' (ECAC > 0.85 and SSF > 0.8 and thermalsolarwindandgrid.insulationstatus = \'Good\'), \'Good Adaptability\' (ECAC > 0.7 and SSF > 0.65 and thermalsolarwindandgrid.insulationstatus != \'Poor\'), or \'Limited Adaptability\' (other cases).', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 50, source_knowledge_id: 49, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

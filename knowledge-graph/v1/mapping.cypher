MERGE (n:Concept {id:'concept:virtual:kb:52'}) SET n += {name: 'Churn Risk Numeric Mapping', description: 'Converts the churn risk enum values to numeric form for analytical calculations', raw_definition: 'Transforms the churnflag enum values into numeric equivalents for use in calculations and risk models: \'None\' maps to 0 (representing minimal risk), \'Low\' maps to 1 (representing slight risk), \'Medium\' maps to 2 (representing moderate risk), and \'High\' maps to 3 (representing severe risk). This numeric mapping enables mathematical operations in retention analysis formulas, especially for the Retention Risk Factor (RRF) calculation.', knowledge_type: 'value_illustration', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 53, source_knowledge_id: 52, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};
MATCH (n:Concept {id:'concept:virtual:kb:52'}), (d:Concept {id:'domain:virtual'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'concept:virtual:kb:52->domain:virtual'}]->(d);
MERGE (p:Concept {id:'pattern:categorical_value_or_concept'}) SET p.name='Categorical Value Or Concept', p.concept_kind='pattern';
MATCH (n:Concept {id:'concept:virtual:kb:52'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:virtual:kb:52->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Rule {id:'rule:virtual:kb:53'}) SET n += {name: 'Fan Value Segmentation', description: 'Classifies fans into value tiers based on their Fan Lifetime Value (FLV) relative to platform-wide percentiles', raw_definition: 'Segments fans into four distinct value categories using percentile thresholds: \'Top Tier\' identifies fans with FLV above the 90th percentile (p90), representing the platform\'s most valuable users; \'High Value\' identifies fans with FLV between the 75th and 90th percentiles (p75 to p90); \'Medium Value\' identifies fans with FLV between the 50th and 75th percentiles (median to p75); \'Low Value\' applies to all fans with FLV below the median (p50). This segmentation enables targeted retention strategies, premium service offerings, and resource allocation based on projected economic contribution.', knowledge_type: 'domain_knowledge', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 54, source_knowledge_id: 53, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};
MATCH (n:Rule {id:'rule:virtual:kb:53'}), (d:Concept {id:'domain:virtual'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'rule:virtual:kb:53->domain:virtual'}]->(d);

MERGE (n:Concept {id:'concept:cybermarket:kb:9'}) SET n += {name: 'cybermarket|securitymonitoring|alertsev', description: 'Explains the alert severity classification system', raw_definition: '\'Low\' alerts indicate minor anomalies requiring minimal attention and posing limited security risk; \'Medium\' alerts signal notable deviations from baseline behavior requiring investigation within standard timeframes; \'High\' alerts denote significant security concerns demanding prompt attention and intervention; \'Critical\' alerts represent severe and immediate security threats requiring urgent action and potential emergency response protocols.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 10, source_knowledge_id: 9, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

MERGE (n:Concept {id:'concept:virtual:kb:4'}) SET n += {name: 'engagement.actfreq', description: 'Analyzes the significance of interaction frequency for fan classification', raw_definition: '\'Daily\' users log into the platform at least once per day on average; \'Weekly\' users log in 3-5 times per week; \'Monthly\' users log in 1-2 times per month; \'Occasional\' users have login intervals exceeding one month. Interaction frequency affects platform push priority, content recommendations, and event invitations, with Daily users considered the platform\'s core active group.', knowledge_type: 'value_illustration', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 5, source_knowledge_id: 4, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

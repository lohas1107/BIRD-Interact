MERGE (n:Metric {id:'metric:virtual:kb:12'}) SET n += {name: 'Content Creation Impact Score (CCIS)', description: 'Measures the impact of fan-created content on the community', raw_definition: 'CCIS = contqualrate \\times \\left(\\frac{ugcval}{10}\\right) \\times \\left(1 + \\frac{follcount}{100} \\times 0.5\\right), \\text{ where content quality is multiplied by normalized content volume and amplified by follower reach.}', knowledge_type: 'calculation_knowledge', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 13, source_knowledge_id: 12, mapping_status: 'unresolved', pattern: 'composite_metric'};

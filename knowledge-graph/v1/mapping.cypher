MERGE (n:Concept {id:'concept:crypto:kb:21'}) SET n += {name: 'orderflow', description: 'Illustrates the meaning of different values for the orderflow enum.', raw_definition: 'An enum with values \'New\', \'PartiallyFilled\', \'Cancelled\', or \'Filled\'. \'New\' indicates a newly placed order that hasn\'t been matched. \'PartiallyFilled\' means some portion has been executed but not all. \'Cancelled\' means the order was cancelled before full execution. \'Filled\' means the order has been completely executed.', knowledge_type: 'value_illustration', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 22, source_knowledge_id: 21, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

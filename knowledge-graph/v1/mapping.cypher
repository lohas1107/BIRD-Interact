MATCH (n:Metric {id:'metric:virtual:kb:10'}), (p:Concept {id:'pattern:composite_metric'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'metric:virtual:kb:10->pattern:composite_metric'}]->(p);
MERGE (n:Metric {id:'metric:virtual:kb:11'}) SET n += {name: 'Monetization Value (MV)', description: 'Calculates the monetary value a fan brings to the platform over time', raw_definition: 'MV = spendusd \\times \\left(1 + \\frac{membdays}{365} \\times 0.5\\right) \\times \\left(1 + \\frac{gifttot}{10} \\times 0.2\\right), \\text{ where the formula adjusts spending based on membership duration and gift activity to reflect long-term value.}', knowledge_type: 'calculation_knowledge', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 12, source_knowledge_id: 11, mapping_status: 'unresolved', pattern: 'ratio_metric'};

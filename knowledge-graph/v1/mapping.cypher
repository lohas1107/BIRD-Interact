MERGE (n:Concept {id:'concept:museum:kb:28'}) SET n += {name: 'EnvironmentalReadingsCore.RelHumidity', description: 'Illustrates relative humidity readings and their conservation implications.', raw_definition: 'Values typically range from 30-65%, with 45-55% being ideal for mixed collections. Fluctuations greater than 5% within 24 hours can cause dimensional changes in organic materials. Values below 30% risk embrittlement, while above 65% risk mold growth.', knowledge_type: 'value_illustration', domain: 'museum', source_file: 'museum/museum_kb.jsonl', source_line: 29, source_knowledge_id: 28, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

MERGE (n:Metric {id:'metric:archeology:kb:31'}) SET n += {name: 'Environmental Impact Factor (EIF)', description: 'Quantifies how environmental conditions affected scan quality using statistical correlation analysis.', raw_definition: 'EIF = \\frac{SQS}{\\text{ESI} + 10} \\times 100, \\text{ where SQS is the Scan Quality Score and ESI is the Environmental Suitability Index. Values closer to 100 indicate minimal environmental interference with data acquisition.}', knowledge_type: 'calculation_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 32, source_knowledge_id: 31, mapping_status: 'unresolved', pattern: 'ratio_metric'};

MATCH (n:Concept {id:'concept:insider:kb:22'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:insider:kb:22->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:insider:kb:23'}) SET n += {name: 'Order Type Distribution', description: 'Illustrates the mix of primary order types used by a trader.', raw_definition: '`ordertypedist`: \'Market\' indicates primarily using market orders (execute immediately at the best available price, prioritizing speed over price). \'Limit\' indicates primarily using limit orders (execute only at a specified price or better, prioritizing price over speed). \'Mixed\' suggests a combination of order types, reflecting varied trading strategies or objectives.', knowledge_type: 'value_illustration', domain: 'insider', source_file: 'insider/insider_kb.jsonl', source_line: 24, source_knowledge_id: 23, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

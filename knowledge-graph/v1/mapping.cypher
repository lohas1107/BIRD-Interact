MERGE (n:Concept {id:'concept:gaming:kb:23'}) SET n += {name: 'SwtchDur (Switch Durability)', description: 'Illustrates the significance of switch durability ratings in keyboard longevity.', raw_definition: 'Measured in actuation cycles before failure. Values around 20 million indicate consumer-grade mechanical switches, 50 million represent premium mechanical switches for enthusiasts, and 100+ million typically denote optical or magnetic switches designed for extended competitive use with minimal degradation over time.', knowledge_type: 'value_illustration', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 24, source_knowledge_id: 23, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

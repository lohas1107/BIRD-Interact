MERGE (n:Concept {id:'concept:gaming:kb:25'}) SET n += {name: 'WlSignal (Wireless Signal Strength)', description: 'Illustrates the importance of wireless signal strength measurements for stable connectivity.', raw_definition: 'Typically measured in dBm, with values ranging from -30 (excellent) to -90 (poor). Signal strength above -50dBm indicates optimal performance with minimal interference, -50 to -70dBm represents good connectivity suitable for most gaming, while below -70dBm may experience occasional disconnections or increased latency in challenging environments.', knowledge_type: 'value_illustration', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 26, source_knowledge_id: 25, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

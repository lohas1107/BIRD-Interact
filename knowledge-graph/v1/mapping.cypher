MATCH (n:Metric {id:'metric:solar:kb:34'}), (p:Concept {id:'pattern:composite_metric'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'metric:solar:kb:34->pattern:composite_metric'}]->(p);
MERGE (n:Metric {id:'metric:solar:kb:35'}) SET n += {name: 'Weather Corrected Efficiency (WCE)', description: 'Adjusts panel efficiency measurements to account for weather conditions.', raw_definition: 'WCE = CurrentEfficiencyPercent × (1 + TempCoef × (25 - CellTempC) / 100) × (1000 / POAIrradianceWM2), where CurrentEfficiencyPercent is from efficiency_profile.current_efficiency.curreffpct.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 35, source_knowledge_id: 35, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};

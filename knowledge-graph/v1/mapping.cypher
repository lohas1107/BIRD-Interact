MERGE (n:Metric {id:'metric:polar:kb:7'}) SET n += {name: 'Water Resource Management Index (WRMI)', description: 'Evaluates the efficiency of water resource management based on water levels, quality, and waste levels.', raw_definition: 'WRMI = waterlevelpercent \\times \\frac{waterqualityindex}{100} \\times (1 - \\frac{wastetanklevelpercent}{100}), \\text{ where higher water quality and appropriate water/waste levels indicate better management.}', knowledge_type: 'calculation_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 8, source_knowledge_id: 7, mapping_status: 'unresolved', pattern: 'composite_metric'};

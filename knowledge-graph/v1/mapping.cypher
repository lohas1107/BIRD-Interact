MERGE (n:Metric {id:'metric:polar:kb:6'}) SET n += {name: 'Thermal Insulation Efficiency (TIE)', description: 'Measures how effectively a structure retains heat based on insulation status and heat loss rate.', raw_definition: 'TIE = \\begin{cases} 0.9 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = \'Good\'} \\\\ 0.6 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = \'Fair\'} \\\\ 0.3 - \\frac{heatlossratekwh}{10} & \\text{if insulationstatus = \'Poor\'} \\end{cases}, \\text{ where lower heat loss and better insulation result in higher efficiency.}', knowledge_type: 'calculation_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 7, source_knowledge_id: 6, mapping_status: 'unresolved', pattern: 'ratio_metric'};

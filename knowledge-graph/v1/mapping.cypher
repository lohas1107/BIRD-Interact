MERGE (n:Metric {id:'metric:cybermarket:kb:17'}) SET n += {name: 'Security Posture Score (SPS)', description: 'Evaluates the overall security posture of an entity', raw_definition: 'SPS = (100 - (vulntally \\times 5)) + (securitymeasurecount \\times 2) + (sessionsecurityscore \\times 0.5) + (privprotscore \\times 0.3) - (fpprob \\times 100), \\text{where higher scores indicate stronger security postures.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 18, source_knowledge_id: 17, mapping_status: 'unresolved', pattern: 'composite_metric'};

MERGE (n:Metric {id:'metric:solar:kb:30'}) SET n += {name: 'Temperature Adjusted Performance Ratio (TAPR)', description: 'Enhances the Panel Performance Ratio by accounting for temperature effects.', raw_definition: 'TAPR = PPR + (TPCI / PowerRatedW), where PPR is the Panel Performance Ratio and TPCI is the Temperature Performance Coefficient Impact.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 30, source_knowledge_id: 30, mapping_status: 'unresolved', pattern: 'ratio_metric'};
MATCH (n:Metric {id:'metric:solar:kb:30'}), (d:Concept {id:'domain:solar'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:solar:kb:30->domain:solar'}]->(d);

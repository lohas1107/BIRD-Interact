MERGE (n:Metric {id:'metric:gaming:kb:30'}) SET n += {name: 'Competitive Gaming Performance Index (CGPI)', description: 'A comprehensive metric evaluating a device\'s suitability for competitive gaming based on response time, accuracy, and durability.', raw_definition: 'CGPI = \\left(IRS \\times 0.4\\right) + \\left(SPI \\times 0.3\\right) + \\left(SPR \\times 0.2\\right) + \\left(RAI \\times 0.1\\right)', knowledge_type: 'calculation_knowledge', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 31, source_knowledge_id: 30, mapping_status: 'unresolved', pattern: 'composite_metric'};

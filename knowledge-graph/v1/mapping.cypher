MERGE (n:Concept {id:'concept:credit:kb:23'}) SET n += {name: 'Credit Utilization Impact', description: 'Illustrates how credit utilization affects credit scores.', raw_definition: 'Credit Utilization (credutil) ranges from 0-1 (or above). Utilization under 0.30 is optimal for credit scores, 0.30-0.50 has moderate negative impact, 0.50-0.70 has significant negative impact, and above 0.70 severely impacts credit scores.', knowledge_type: 'value_illustration', domain: 'credit', source_file: 'credit/credit_kb.jsonl', source_line: 24, source_knowledge_id: 23, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

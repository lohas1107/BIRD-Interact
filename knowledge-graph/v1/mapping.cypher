MERGE (n:Metric {id:'metric:alien:kb:37'}) SET n += {name: 'Habitable Zone Signal Relevance (HZSR)', description: 'Assesses signal relevance based on source\'s position in habitable zone.', raw_definition: '$\\text{HZSR} = \\text{TOLS} \\times (\\text{ObjType} == \\text{\'Dwarf\'} ? (0.7 \\leq \\text{ObjMassSol} \\leq 1.4 ? (0.8 \\leq \\frac{\\text{SourceDistLy}}{\\sqrt{\\text{ObjMassSol}}} \\leq 1.7 ? 2 : 0.5) : 0.3) : 0.1)$, where TOLS (Technological Origin Likelihood Score) is weighted by stellar habitability factors.', knowledge_type: 'calculation_knowledge', domain: 'alien', source_file: 'alien/alien_kb.jsonl', source_line: 38, source_knowledge_id: 37, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};

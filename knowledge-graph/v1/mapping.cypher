MERGE (n:Rule {id:'rule:cybermarket:kb:42'}) SET n += {name: 'High-Exposure Product', description: 'Identifies products with elevated regulatory risk factors', raw_definition: 'A product with PRE > 60, in the \'Physical\' theme category as defined in the product theme classification, without escrow protection (escrowused = \'No\'), and transacted with privacy-focused cryptocurrency (paymethod = \'Crypto_B\'). These products require immediate monitoring due to their heightened risk profile.', knowledge_type: 'domain_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 43, source_knowledge_id: 42, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

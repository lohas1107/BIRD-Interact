MERGE (n:Metric {id:'metric:crypto:kb:31'}) SET n += {name: 'True Cost of Execution', description: 'Calculates the total cost of order execution including fees and slippage.', raw_definition: 'True Cost of Execution = feetotal + (dealcount \\times dealquote \\times Slippage Impact \\times 0.01), \\text{where } feetotal \\text{ is the total fee charged and } Slippage Impact \\text{ is the expected price slippage impact for the order size.}', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 32, source_knowledge_id: 31, mapping_status: 'unresolved', pattern: 'metric'};

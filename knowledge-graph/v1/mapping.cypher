MERGE (n:Metric {id:'metric:crypto:kb:32'}) SET n += {name: 'Order Book Imbalance Ratio', description: 'Quantifies the imbalance between bid and ask sides of the order book.', raw_definition: 'Order Book Imbalance Ratio = \\frac{biddepth - askdepth}{biddepth + askdepth}, \\text{where } biddepth \\text{ is the deeper bid liquidity and } askdepth \\text{ is the deeper ask liquidity. A positive Imbalance Ratio indicates stronger buying pressure, while negative indicates stronger selling pressure.', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 33, source_knowledge_id: 32, mapping_status: 'unresolved', pattern: 'ratio_metric'};

MERGE (n:Concept {id:'concept:crypto:kb:25'}) SET n += {name: 'mktfeel', description: 'Illustrates the meaning of different values for the mktfeel enum.', raw_definition: 'An enum with values \'Bearish\', \'Bullish\', or \'Neutral\'. \'Bearish\' indicates negative market sentiment with expectations of price decreases. \'Bullish\' indicates positive market sentiment with expectations of price increases. \'Neutral\' indicates balanced market sentiment with no strong directional bias.', knowledge_type: 'value_illustration', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 26, source_knowledge_id: 25, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

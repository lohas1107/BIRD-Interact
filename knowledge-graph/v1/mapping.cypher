MERGE (p:Concept {id:'pattern:composite_metric'}) SET p.name='Composite Metric', p.concept_kind='pattern';
MATCH (n:Metric {id:'metric:gaming:kb:30'}), (p:Concept {id:'pattern:composite_metric'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'metric:gaming:kb:30->pattern:composite_metric'}]->(p);
MERGE (n:Metric {id:'metric:gaming:kb:31'}) SET n += {name: 'Response Accuracy Index (RAI)', description: 'Measures the accuracy and consistency of input response in gaming devices, accounting for both sensor precision and control stability.', raw_definition: 'RAI = \\left(\\frac{JoyPrec + DpadAcc}{20}\\right) \\times \\left(1 - \\frac{InpLagMs}{10}\\right) \\times 10', knowledge_type: 'calculation_knowledge', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 32, source_knowledge_id: 31, mapping_status: 'exact_identifier', pattern: 'composite_metric'};

MERGE (n:Concept {id:'concept:virtual:kb:8'}) SET n += {name: 'retentionandinfluence.churnflag', description: 'Explains the judgment basis for churn risk rating', raw_definition: '\'None\' indicates extremely low churn risk, with users maintaining high-frequency interaction and recent consumption; \'Low\' represents slight churn risk with slightly decreased login frequency; \'Medium\' indicates moderate churn risk with significantly decreased interaction and consumption frequency and increased login intervals; \'High\' represents severe churn risk with no logins or interactions in the past 14-30 days, requiring immediate intervention.', knowledge_type: 'value_illustration', domain: 'virtual', source_file: 'virtual/virtual_kb.jsonl', source_line: 9, source_knowledge_id: 8, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

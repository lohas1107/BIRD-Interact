MERGE (n:Concept {id:'concept:polar:kb:20'}) SET n += {name: 'reliabilityindex', description: 'Illustrates the significance of reliability index measurements in equipment durability.', raw_definition: 'The reliability index typically ranges from 0 to 1, where values below 0.5 indicate equipment that fails frequently and requires constant maintenance, values between 0.5-0.8 represent equipment with occasional failures that require regular maintenance, and values above 0.8 indicate highly reliable equipment with minimal downtime.', knowledge_type: 'value_illustration', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 21, source_knowledge_id: 20, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

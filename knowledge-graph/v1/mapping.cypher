MERGE (n:Metric {id:'metric:cybermarket:kb:16'}) SET n += {name: 'Transaction Chain Risk (TCR)', description: 'Evaluates the risk level of a transaction chain', raw_definition: 'TCR = (txchainlen \\times 10) + (linkedtxcount \\times 5) + (fraudprob \\times 100) - (profilecomplete \\times 0.5) - (idverifyscore \\times 0.5), \\text{where higher scores indicate higher risk transaction chains.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 17, source_knowledge_id: 16, mapping_status: 'unresolved', pattern: 'metric'};

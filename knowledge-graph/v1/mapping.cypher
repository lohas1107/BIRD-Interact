MERGE (p:Concept {id:'pattern:categorical_value_or_concept'}) SET p.name='Categorical Value Or Concept', p.concept_kind='pattern';
MATCH (n:Concept {id:'concept:insider:kb:23'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:insider:kb:23->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:insider:kb:24'}) SET n += {name: 'Momentum Ignition Signals', description: 'Explains the signals related to attempting to artificially create price momentum.', raw_definition: '`risk_indicators.momentignit`: \'Strong\' indicates patterns consistent with attempts to trigger momentum algorithms or attract other traders by creating a false sense of rapid price movement (e.g., through rapid successive trades). \'Weak\' suggests such patterns are less evident or absent. This is a potential indicator of manipulative behavior.', knowledge_type: 'value_illustration', domain: 'insider', source_file: 'insider/insider_kb.jsonl', source_line: 25, source_knowledge_id: 24, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

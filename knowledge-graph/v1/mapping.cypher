MERGE (n:Metric {id:'metric:cybermarket:kb:18'}) SET n += {name: 'Investigation Priority Score (IPS)', description: 'Determines how urgently an investigation should be handled', raw_definition: 'IPS = (lawinterest\\_numeric \\times 30) + (regrisklvl\\_numeric \\times 20) + (fraudprob \\times 100) - (compliancescore \\times 0.5) + (notescount \\times 2), \\text{where lawinterest\\_numeric and regrisklvl\\_numeric map Low=1, Medium=2, High=3, Unknown=2, and higher scores indicate higher priority.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 19, source_knowledge_id: 18, mapping_status: 'unresolved', pattern: 'composite_metric'};

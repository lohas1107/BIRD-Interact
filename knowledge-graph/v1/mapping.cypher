MATCH (n:Concept {id:'concept:solar:kb:21'}), (p:Concept {id:'pattern:categorical_value_or_concept'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'concept:solar:kb:21->pattern:categorical_value_or_concept'}]->(p);
MERGE (n:Concept {id:'concept:solar:kb:22'}) SET n += {name: 'TempCoef (Temperature Coefficient)', description: 'Illustrates how panel performance changes with temperature.', raw_definition: 'Expressed as a percentage per degree Celsius (usually negative), indicating how much a panel\'s power output decreases for each degree above 25°C. Typical values range from -0.25% to -0.50% per °C, with lower absolute values indicating better high-temperature performance.', knowledge_type: 'value_illustration', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 22, source_knowledge_id: 22, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

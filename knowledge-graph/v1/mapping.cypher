MERGE (n:Metric {id:'metric:crypto:kb:1'}) SET n += {name: 'Slippage Impact', description: 'Calculates the expected price slippage impact for a given order size.', raw_definition: 'Slippage Impact = \\frac{dealcount}{bidunits \\text{ or } askunits} \\times spreadband, \\text{where } dealcount \\text{ is the order quantity, } bidunits/askunits \\text{ is the quantity available at best bid/ask, and } spreadband \\text{ is the raw spread.}', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 2, source_knowledge_id: 1, mapping_status: 'unresolved', pattern: 'ratio_metric'};

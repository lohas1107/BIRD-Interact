MERGE (n:Metric {id:'metric:cybermarket:kb:30'}) SET n += {name: 'Market Vulnerability Index (MVI)', description: 'Evaluates a market\'s susceptibility to disruption or shutdown', raw_definition: 'MVI = (100 - MSI) + (COUNT(CASE WHEN alertsev IS NOT NULL THEN 1 END) / 10) \\times (alertsev_numeric \\times 2) - (vendcount \\times 0.05) + (COUNT(CASE WHEN lawinterest = \'High\' THEN 1 END) / 5), \\text{where alertsev_numeric maps Low=1, Medium=2, High=3, Critical=4 as defined in the alert severity system, and higher scores indicate greater vulnerability to disruption.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 31, source_knowledge_id: 30, mapping_status: 'unresolved', pattern: 'composite_metric'};
MATCH (n:Metric {id:'metric:cybermarket:kb:30'}), (d:Concept {id:'domain:cybermarket'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:cybermarket:kb:30->domain:cybermarket'}]->(d);
MERGE (p:Concept {id:'pattern:composite_metric'}) SET p.name='Composite Metric', p.concept_kind='pattern';
MATCH (n:Metric {id:'metric:cybermarket:kb:30'}), (p:Concept {id:'pattern:composite_metric'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'metric:cybermarket:kb:30->pattern:composite_metric'}]->(p);
MERGE (n:Metric {id:'metric:cybermarket:kb:31'}) SET n += {name: 'Vendor Network Centrality (VNC)', description: 'Measures a vendor\'s connectedness within the market ecosystem', raw_definition: 'VNC = (COUNT(DISTINCT mktref) \\times 5) + \\frac{vendtxcount}{50} + (VTI \\times 0.1) - (1 - sizecluster_numeric) \\times 10, \\text{where sizecluster_numeric maps Small=1, Medium=2, Large=3, Mega=4 as described in the market size classification, and higher scores indicate more central market positioning.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 32, source_knowledge_id: 31, mapping_status: 'unresolved', pattern: 'ratio_metric'};
MATCH (n:Metric {id:'metric:cybermarket:kb:31'}), (d:Concept {id:'domain:cybermarket'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:cybermarket:kb:31->domain:cybermarket'}]->(d);

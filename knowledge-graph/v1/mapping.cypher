MERGE (n:Metric {id:'metric:polar:kb:4'}) SET n += {name: 'Communication Reliability Index (CRI)', description: 'Assesses the reliability of communication systems based on signal metrics and antenna status.', raw_definition: 'CRI = \\begin{cases} 0 & \\text{if antennastatus = \'Error\'} \\\\ 5 & \\text{if antennastatus = \'Warning\'} \\\\ 10 & \\text{if antennastatus = \'Normal\'} \\\\ 0 & \\text{otherwise} \\end{cases} \\times (1 - \\frac{signalmetrics.latency\\_ms}{1000}), \\text{ where lower latency and better antenna status result in higher reliability.}', knowledge_type: 'calculation_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 5, source_knowledge_id: 4, mapping_status: 'unresolved', pattern: 'composite_metric'};

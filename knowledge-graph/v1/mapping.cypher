MERGE (n:Concept {id:'concept:insider:kb:28'}) SET n += {name: 'Pattern Similarity Score Context', description: 'Provides context for the pattern similarity score, comparing trading to known illicit behaviors.', raw_definition: '`patsim`: A score typically ranging from 0 to 1. Values close to 1 indicate a high similarity to known illicit trading patterns cataloged by the surveillance system (e.g., layering, spoofing, wash trading). Values close to 0 indicate the observed trading patterns do not strongly match known manipulative techniques.', knowledge_type: 'value_illustration', domain: 'insider', source_file: 'insider/insider_kb.jsonl', source_line: 29, source_knowledge_id: 28, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

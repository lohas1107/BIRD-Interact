MERGE (n:Metric {id:'metric:crypto:kb:2'}) SET n += {name: 'Position Value at Risk (PVaR)', description: 'Calculates the value at risk for a position based on current market conditions.', raw_definition: 'PVaR = possum \\times volmeter \\times 0.01, \\text{where } possum \\text{ is the notional value of position and } volmeter \\text{ is the volatility or fluctuation rating.}', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 3, source_knowledge_id: 2, mapping_status: 'unresolved', pattern: 'metric'};

MERGE (n:Rule {id:'rule:archeology:kb:51'}) SET n += {name: 'Workflow Efficiency Classification', description: 'A standardized categorization system for assessing processing workflow efficiency based on Processing Resource Utilization (PRU) values.', raw_definition: 'A three-tier classification where \'Optimized\' workflows have PRU < 5.0 (highly efficient resource usage), \'Acceptable\' workflows have PRU between 5.0-10.0 (reasonable efficiency), and \'Needs Optimization\' workflows have PRU > 10.0 (inefficient resource usage requiring intervention). This classification guides processing workflow improvements and resource allocation decisions.', knowledge_type: 'domain_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 52, source_knowledge_id: 51, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

MERGE (n:Metric {id:'metric:cybermarket:kb:37'}) SET n += {name: 'Vendor Relationship Strength (VRS)', description: 'Measures the strength of relationships between a vendor and their customers', raw_definition: 'VRS = (vendrate \\times 10) + \\frac{vendsucccount}{vendtxcount} \\times 50 + (vendchecklvl_numeric \\times 15) - \\frac{venddisputecount}{vendtxcount} \\times 100, \\text{where vendchecklvl_numeric maps Basic=1, Advanced=2, Premium=3, else=0 according to the vendor verification system, and higher scores represent stronger vendor-customer relationships.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 38, source_knowledge_id: 37, mapping_status: 'unresolved', pattern: 'ratio_metric'};

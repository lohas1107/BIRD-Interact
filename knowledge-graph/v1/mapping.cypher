MERGE (n:Rule {id:'rule:polar:kb:18'}) SET n += {name: 'Water Conservation Requirement', description: 'Specifies the conditions under which water conservation measures must be implemented.', raw_definition: 'Water conservation measures must be implemented when the WRMI falls below 0.5, indicating either low water levels, poor water quality, or high waste tank levels that require immediate attention to maintain sustainable water usage.', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 19, source_knowledge_id: 18, mapping_status: 'unresolved', pattern: 'opaque_rule'};

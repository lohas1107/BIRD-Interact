MERGE (n:Rule {id:'rule:cybermarket:kb:43'}) SET n += {name: 'Deceptive Communication Pattern', description: 'Identifies communication exhibiting signs of deliberate deception', raw_definition: 'A communication with CPR > 70, \'Suspicious\' language patterns as defined in the language pattern classification, high CSR values (CSR > 80), and frequently changing connection parameters. These patterns suggest deliberate attempts to obfuscate identity and intentions.', knowledge_type: 'domain_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 44, source_knowledge_id: 43, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};

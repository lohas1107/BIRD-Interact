MERGE (n:Concept {id:'concept:archeology:kb:27'}) SET n += {name: 'FlowStage (Processing Stage)', description: 'Illustrates the progression of data processing in archaeological scanning workflows.', raw_definition: 'A sequential classification system with defined stages: \'Raw\' (unprocessed scan data), \'Aligned\' (multiple scans registered together), \'Cleaned\' (noise and artifacts removed), \'Meshed\' (point cloud converted to polygon mesh), and \'Textured\' (surface textures applied to mesh). Each stage represents a discrete processing milestone.', knowledge_type: 'value_illustration', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 28, source_knowledge_id: 27, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

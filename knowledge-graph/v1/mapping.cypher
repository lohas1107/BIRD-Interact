MERGE (n:Metric {id:'metric:cybermarket:kb:13'}) SET n += {name: 'Communication Security Risk (CSR)', description: 'Evaluates the security risk of a communication channel', raw_definition: 'CSR = (iptally \\times 5) + (tornodecount \\times 2) + (vpnflag\\_numeric \\times 30) + \\frac{brwsrunique}{10} + (susppatscore \\times 3) + (riskindiccount \\times 4), \\text{where vpnflag\\_numeric maps Yes=1, Suspected=0.5, No=0, and higher scores indicate greater security concerns.}', knowledge_type: 'calculation_knowledge', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 14, source_knowledge_id: 13, mapping_status: 'unresolved', pattern: 'ratio_metric'};

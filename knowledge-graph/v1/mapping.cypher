MERGE (n:Metric {id:'metric:robot:kb:30'}) SET n += {name: 'Weighted Fault Prediction Score (WFPS)', description: 'Calculates a weighted average fault prediction score, prioritizing recent records.', raw_definition: 'For a given robot R, WFPS = \\frac{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} (faultpredscore \\cdot w(mf))}{\\sum_{mf \\in \\text{maintenance_and_fault} \\mid \\text{upkeeprobot = R}} w(mf)}, \\text{where } w(mf) = 1 / (1 + \\text{upkeepduedays})', knowledge_type: 'calculation_knowledge', domain: 'robot', source_file: 'robot/robot_kb.jsonl', source_line: 31, source_knowledge_id: 30, mapping_status: 'exact_identifier', pattern: 'composite_metric'};

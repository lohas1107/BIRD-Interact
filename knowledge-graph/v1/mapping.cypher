MERGE (n:Metric {id:'metric:crypto:kb:36'}) SET n += {name: 'Market Depth Ratio', description: 'Measures the ratio of order book depth to position size to assess market liquidity for position exit.', raw_definition: 'Market Depth Ratio = \\frac{biddepth \\text{ or } askdepth}{dealcount} \\times Liquidity Ratio, \\text{where } biddepth/askdepth \\text{ is used depending on position direction (posedge), } dealcount \\text{ is the order quantity, and } Liquidity Ratio \\text{ measures available liquidity to total market volume.}', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 37, source_knowledge_id: 36, mapping_status: 'unresolved', pattern: 'ratio_metric'};

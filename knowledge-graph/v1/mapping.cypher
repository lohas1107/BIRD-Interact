MERGE (n:Concept {id:'concept:cybermarket:kb:7'}) SET n += {name: 'cybermarket|vendors|vendchecklvl', description: 'Illustrates the vendor verification system and trustworthiness indicators', raw_definition: '\'Basic\' vendors have completed minimal verification steps, typically only email and captcha verification with limited platform history; \'Advanced\' vendors have undergone additional verification including identification consistency checks and longer positive platform history; \'Premium\' vendors represent the highest verification tier, having submitted verifiable identity elements and maintained extended positive transaction records with minimal disputes.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 8, source_knowledge_id: 7, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

MATCH (m:Metric {id:'metric:robot:kb:30'}), (e:LogicalEntity {id:'entity:robot:maintenance_and_fault'}) MERGE (m)-[:APPLIES_TO {id:'metric:robot:kb:30->entity:robot:maintenance_and_fault'}]->(e);
MERGE (n:Metric {id:'metric:robot:kb:31'}) SET n += {name: 'Energy Efficiency Ratio (EER)', description: 'Measures energy efficiency by comparing energy usage to operating hours.', raw_definition: 'For a given robot R, EER = \\frac{\\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} energyusekwhval}{\\text{TOH}}, \\text{where TOH is used to normalize energy consumption.}', knowledge_type: 'calculation_knowledge', domain: 'robot', source_file: 'robot/robot_kb.jsonl', source_line: 32, source_knowledge_id: 31, mapping_status: 'unresolved', pattern: 'ratio_metric'};

MERGE (n:Metric {id:'metric:crypto:kb:51'}) SET n += {name: 'Smart Money Accuracy', description: 'Measures the success rate of smart money flow in predicting the 4-hour price movement direction.', raw_definition: 'The proportion of times the Smart Money Flow direction matches the 4-hour price movement direction, calculated as: $$ \\frac{\\text{COUNT(CASE WHEN (smartforce > retailflow AND smartforce > instflow AND next\\_price\\_4h > mid\\_price) OR (smartforce < retailflow AND smartforce < instflow AND next\\_price\\_4h < mid\\_price) THEN 1 ELSE 0 END)}}{\\text{COUNT(*)}} $$', knowledge_type: 'calculation_knowledge', domain: 'crypto', source_file: 'crypto/crypto_kb.jsonl', source_line: 52, source_knowledge_id: 51, mapping_status: 'unresolved', pattern: 'ratio_metric'};

MERGE (n:Rule {id:'rule:polar:kb:25'}) SET n += {name: 'Water Quality Classification System (WQCS)', description: 'A standardized system that categorizes water quality for health, safety, and operational purposes in polar environments.', raw_definition: 'Water is classified into five quality categories based on its quality index: \'High-Quality\' WHEN (waterqualityindex >= 91), suitable for all purposes including direct consumption; \'Good\' WHEN (waterqualityindex >= 71 AND waterqualityindex < 91), safe for consumption after standard treatment; \'Moderate\' WHEN (waterqualityindex >= 51 AND waterqualityindex < 71), acceptable for washing but not consumption; \'Poor\' WHEN (waterqualityindex >= 26 AND waterqualityindex < 51), suitable only for limited non-contact uses; \'Unsafe\' WHEN (waterqualityindex < 26), unsuitable for any use and requiring immediate remediation.', knowledge_type: 'domain_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 26, source_knowledge_id: 25, mapping_status: 'unresolved', pattern: 'threshold_or_classification'};
MATCH (n:Rule {id:'rule:polar:kb:25'}), (d:Concept {id:'domain:polar'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'rule:polar:kb:25->domain:polar'}]->(d);

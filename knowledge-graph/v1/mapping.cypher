MERGE (n:Concept {id:'concept:gaming:kb:24'}) SET n += {name: 'ErgoRate (Ergonomic Rating)', description: 'Illustrates the significance of ergonomic ratings in gaming peripherals for comfort during extended use.', raw_definition: 'Rated on a scale of 1-10, where 1-3 indicates basic designs prioritizing aesthetics over comfort, 4-6 represents good ergonomics for average gaming sessions, 7-8 denotes devices designed for extended comfort, and 9-10 indicates specialized ergonomic designs preventing repetitive strain injuries during marathon sessions.', knowledge_type: 'value_illustration', domain: 'gaming', source_file: 'gaming/gaming_kb.jsonl', source_line: 25, source_knowledge_id: 24, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

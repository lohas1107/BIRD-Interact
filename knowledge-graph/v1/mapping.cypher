MERGE (n:Metric {id:'metric:archeology:kb:32'}) SET n += {name: 'Feature Extraction Efficiency (FEE)', description: 'Measures the efficiency of feature identification in scan data relative to point cloud density and complexity.', raw_definition: 'FEE = \\frac{TraitCount + ArtiCount}{PCDR \\times \\sqrt{CloudDense}} \\times 10^3, \\text{ where PCDR is the Point Cloud Density Ratio and higher values indicate more effective feature extraction from point cloud data relative to spatial distribution efficiency.}', knowledge_type: 'calculation_knowledge', domain: 'archeology', source_file: 'archeology/archeology_kb.jsonl', source_line: 33, source_knowledge_id: 32, mapping_status: 'exact_identifier', pattern: 'ratio_metric'};

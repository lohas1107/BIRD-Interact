MERGE (n:Metric {id:'metric:polar:kb:0'}) SET n += {name: 'Equipment Efficiency Rating (EER)', description: 'A composite metric that evaluates the overall efficiency of equipment based on performance, reliability, and environmental impact.', raw_definition: 'EER = \\frac{performanceindex + reliabilityindex}{2} \\times (1 - \\frac{environmentalimpactindex}{10}), \\text{ where higher values indicate more efficient equipment with better performance and lower environmental impact.}', knowledge_type: 'calculation_knowledge', domain: 'polar', source_file: 'polar/polar_kb.jsonl', source_line: 1, source_knowledge_id: 0, mapping_status: 'unresolved', pattern: 'ratio_metric'};
MATCH (n:Metric {id:'metric:polar:kb:0'}), (d:Concept {id:'domain:polar'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:polar:kb:0->domain:polar'}]->(d);

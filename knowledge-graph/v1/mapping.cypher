MERGE (n:Metric {id:'metric:robot:kb:37'}) SET n += {name: 'Tool Wear Rate (TWR)', description: 'Estimates the rate of tool wear relative to program cycles.', raw_definition: 'For a given robot R, TWR = \\frac{\\sum_{ps \\in \\text{performance_and_safety} \\mid \\text{effectivenessrobot = R}} toolwearpct}{\\text{TPC}}, \\text{where TPC normalizes tool wear percentage.}', knowledge_type: 'calculation_knowledge', domain: 'robot', source_file: 'robot/robot_kb.jsonl', source_line: 38, source_knowledge_id: 37, mapping_status: 'unresolved', pattern: 'ratio_metric'};

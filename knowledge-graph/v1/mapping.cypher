MERGE (n:Metric {id:'metric:robot:kb:33'}) SET n += {name: 'Operation Cycle Efficiency (OCE)', description: 'Calculates the efficiency of program cycles relative to cycle time.', raw_definition: 'For a given robot R, OCE = \\frac{\\text{TPC}}{\\sum_{o \\in \\text{operation} \\mid \\text{operbotdetref = R}} cycletimesecval}', knowledge_type: 'calculation_knowledge', domain: 'robot', source_file: 'robot/robot_kb.jsonl', source_line: 34, source_knowledge_id: 33, mapping_status: 'unresolved', pattern: 'ratio_metric'};
MATCH (n:Metric {id:'metric:robot:kb:33'}), (d:Concept {id:'domain:robot'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:robot:kb:33->domain:robot'}]->(d);

MERGE (n:Metric {id:'metric:museum:kb:34'}) SET n += {name: 'Visitor Capacity Safety Factor (VCSF)', description: 'Determines the safe visitor capacity for exhibition halls containing sensitive artifacts.', raw_definition: 'VCSF = VIR ÷ (AVS × 0.1), where VIR is the Visitor Impact Risk and AVS is the Artifact Vulnerability Score. Lower values indicate safer visitor capacities.', knowledge_type: 'calculation_knowledge', domain: 'museum', source_file: 'museum/museum_kb.jsonl', source_line: 35, source_knowledge_id: 34, mapping_status: 'unresolved', pattern: 'metric'};

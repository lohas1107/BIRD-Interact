MERGE (n:Concept {id:'concept:cybermarket:kb:8'}) SET n += {name: 'cybermarket|riskanalysis|moneyrisk', description: 'Explains the significance of money laundering risk classification', raw_definition: '\'Low\' indicates minimal risk patterns with transparent transaction flows and consistent monetary behavior; \'Medium\' suggests some unusual patterns warranting monitoring but insufficient evidence for immediate action; \'High\' represents significant red flags such as rapid fund transfers, unusual transaction chains, or known high-risk wallet associations; \'Unknown\' indicates insufficient data to properly assess risk, itself often considered a risk indicator due to potential deliberate obfuscation.', knowledge_type: 'value_illustration', domain: 'cybermarket', source_file: 'cybermarket/cybermarket_kb.jsonl', source_line: 9, source_knowledge_id: 8, mapping_status: 'unresolved', pattern: 'categorical_value_or_concept'};

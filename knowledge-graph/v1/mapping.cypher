MATCH (n:Metric {id:'metric:solar:kb:31'}), (p:Concept {id:'pattern:ratio_metric'}) MERGE (n)-[:INSTANCE_OF_PATTERN {id:'metric:solar:kb:31->pattern:ratio_metric'}]->(p);
MERGE (n:Metric {id:'metric:solar:kb:32'}) SET n += {name: 'Maintenance Return on Investment (MROI)', description: 'Evaluates the financial return of maintenance activities.', raw_definition: 'MROI = RLR / MCE, where RLR is the Revenue Loss Rate and MCE is the Maintenance Cost Efficiency. Higher values indicate better return on maintenance investments.', knowledge_type: 'calculation_knowledge', domain: 'solar', source_file: 'solar/solar_kb.jsonl', source_line: 32, source_knowledge_id: 32, mapping_status: 'unresolved', pattern: 'ratio_metric'};
MATCH (n:Metric {id:'metric:solar:kb:32'}), (d:Concept {id:'domain:solar'}) MERGE (n)-[:VALID_IN_DOMAIN {id:'metric:solar:kb:32->domain:solar'}]->(d);

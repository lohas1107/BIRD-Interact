# BIRD-Interact Open WebUI Configuration
# Copy this to .env and fill in your values

# ── Open WebUI backend ──
OPEN_WEBUI_BASE_URL=http://127.0.0.1:3000
# Internal Open WebUI Bearer token; no model-provider API key is required.
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_TIMEOUT=180
OPEN_WEBUI_MAX_TOKENS=32768
OPENAI_API_BASE_URLS=http://192.168.1.233:8000/v1
OPENAI_API_KEYS=

# ── Models ──
SYSTEM_AGENT_MODEL=google/gemma-4-31B-it
USER_SIMULATOR_MODEL=google/gemma-4-31B-it

# ── embedding gateway ──
# These credentials are intentionally independent from the chat-model
# Open WebUI settings above.  Use an OpenAI-compatible embedding endpoint.
KG_ENABLED=0
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT=60

# ── Dataset ──
# Options: "lite" (300 tasks, 18 DBs) or "full" (600 tasks, 26 DBs)
DATASET=lite

# ── PostgreSQL ──
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=root
PG_PASSWORD=123123

# ── Neo4j backend ──
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bird-interact-dev
NEO4J_DATABASE=neo4j

# ── Service Ports ──
SYSTEM_AGENT_PORT=6000
USER_SIM_PORT=6001
DB_ENV_PORT=6002
EMBEDDING_SERVICE_PORT=6003
EMBEDDING_SERVICE_URL=http://127.0.0.1:6003

# ── Budget / Turns ──
# a-interact: budget = 6 + 2*ambiguities + 2*patience (per task)
# c-interact: max_turns = ambiguities + patience (per task)
PATIENCE=3
